---
import { Image } from 'astro:assets';
import BrandMark from '../components/BrandMark.astro';
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import { formatDateKo } from '../utils/date';
import { coverTone } from '../utils/cover-tone';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/blog.css';

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author?: string;
  /** 글의 종류(인사이트 · 가이드 · 소식). 목록 카드와 같은 값을 메타 줄에 적는다. */
  category?: string;
  ogImage?: string;
  /** 표지 이미지(src/assets). 목록 카드와 같은 파일을 쓴다. */
  image?: ImageMetadata;
  /** 표지 오른쪽 아래 아이콘(public 경로). */
  coverIcon?: string;
  /** 표지 밑색(hex). 사진이 없는 글에서 표지 면에 깔린다. */
  coverColor?: string;
  /** 표지 글자색(hex). 지정하면 자동 판정(잉크/흰색)보다 우선한다. */
  coverTextColor?: string;
  /** 표지 왼쪽 아래 글(목록 카드와 같은 자리). */
  coverFoot?: string;
  /** 표지 왼쪽 위 태그라인(첫 태그)을 감춘다. */
  hideCoverKind?: boolean;
  /** 태그. 첫 값이 표지 왼쪽 위 태그라인이 된다. */
  tags?: string[];
  /** 표지 안 대제목의 줄바꿈 지점. 값이 있을 때만 표지에 제목이 들어간다. */
  titleBreakAfter?: string;
  slug: string;
  lang?: 'ko' | 'en';
}

const {
  title, description, pubDate, updatedDate, author = 'Refinery', category, ogImage, image, coverIcon, coverTexture, coverIconAt = 'corner', coverColor, coverTextColor, coverFoot,
  hideCoverKind = false, tags = [], titleBreakAfter, slug,
  lang = 'ko',
} = Astro.props;

// 글 UI 문구·날짜 형식·경로를 로케일별로.
const T = {
  ko: { locale: 'ko-KR', base: '/blog', suffix: 'Refinery 블로그' },
  en: { locale: 'en-US', base: '/en/blog', suffix: 'Refinery Blog' },
}[lang];

// 한국어는 '2026. 07. 31', 영어는 'July 31, 2026'. 목록 카드와 같은 함수를 쓴다.
const fmt = (d: Date) =>
  lang === 'ko'
    ? formatDateKo(d)
    : new Intl.DateTimeFormat(T.locale, { year: 'numeric', month: 'long', day: 'numeric' }).format(d);

// canonical/sitemap 정합: 클린 URL 사용(Vercel이 .html도 동일 경로로 서빙)
// 표지 안 대제목을 두 줄로 끊는다. 끊을 지점은 글 원본의 titleBreakAfter에 있고,
// 그 말 바로 뒤에서 나눈다. 목록 카드가 소제목을 끊는 방식과 같다.
const coverTitle = titleBreakAfter
  ? (() => {
      const i = title.indexOf(titleBreakAfter);
      if (i < 0) return null;
      const cut = i + titleBreakAfter.length;
      return [title.slice(0, cut), title.slice(cut).trimStart()];
    })()
  : null;

const canonical = `${T.base}/${slug}`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Organization', name: author },
  publisher: {
    '@type': 'Organization',
    name: 'Refinery',
    logo: {
      '@type': 'ImageObject',
      url: 'https://refinery.kr/logo_Refinery_symbol.svg',
    },
  },
  image: new URL(ogImage ?? '/og-image.png', 'https://refinery.kr/').href,
  mainEntityOfPage: `https://refinery.kr${canonical}`,
};
---
<BaseLayout
  title={`${title} | ${T.suffix}`}
  ogTitle={title}
  description={description}
  canonical={canonical}
  ogType="article"
  ogImage={ogImage}
  jsonLd={jsonLd}
>
  <Nav />
  <main class="blog-main blog-main--post">
    <div class="post-shell">

      <article class="post">
        {/* 표지. 칸이 먼저 자리를 잡고 이미지가 그 안을 cover로 채운다 —
            이미지가 없는 글은 빈 면으로 남고 배치는 그대로다.
            목록 카드(.res-thumb)와 같은 파일을 쓰고, 크기만 여기서 더 크다.
            widths/sizes를 주면 빌드가 폭별 파일을 만들어 각 화면이 제 크기만
            내려받는다. 접힘선 위라 lazy는 걸지 않는다(LCP). */}
        <div
          class="post-thumb"
          data-tone={coverTone(coverColor)}
          style={[
            coverColor && `--cover-bg: ${coverColor}`,
            coverTextColor && `--cover-fg: ${coverTextColor}`,
          ].filter(Boolean).join('; ') || undefined}
        >
          {image && (
            <Image
              src={image}
              alt=""
              widths={[432, 720, 820, 1440, 1640]}
              sizes="(max-width: 868px) calc(100vw - 48px), 820px"
              loading="eager"
              fetchpriority="high"
            />
          )}
          {image && <BrandMark class="thumb-mark" />}
          {coverTexture && (
            <img class="thumb-texture" src={coverTexture} alt="" aria-hidden="true" loading="lazy" decoding="async" />
          )}
          {coverIcon && <img class:list={['thumb-icon', coverIconAt === 'center' && 'is-center']} src={coverIcon} alt="" loading="lazy" decoding="async" />}
          {/* 표지 안 구성은 목록 카드(.res-cover)와 같다 — 왼쪽 위 태그라인, 대제목,
              왼쪽 아래 글. 칸이 커진 만큼 글자와 안여백을 1.5배로 키웠다. */}
          {(coverTitle || coverFoot || (tags[0] && !hideCoverKind)) && (
            <div class="post-cover">
              {tags[0] && !hideCoverKind && <span class="post-cover-kind">#{tags[0]}</span>}
              {coverTitle && (
                <strong class="post-cover-line">{coverTitle[0]}{coverTitle[1] && <><br />{coverTitle[1]}</>}</strong>
              )}
              {coverFoot && <span class="post-cover-foot">{coverFoot}</span>}
            </div>
          )}
        </div>
        <header class="post-header">
          {/* 목록 카드와 같은 순서다 — 대제목 · 소제목 · 날짜. */}
          {/* 표지에 제목이 올라간 글에서는 여기 제목을 화면에서만 감춘다 —
              같은 글이 두 번 보이지 않게 하되, 검색·스크린리더에는 남긴다. */}
          <h1 class={coverTitle ? 'is-in-cover' : undefined}>{title}</h1>
          <p class="post-desc">{description}</p>
          <div class="post-meta">
            <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
            {category && <><span class="post-bar" aria-hidden="true"></span><span>{category}</span></>}
          </div>
        </header>
        <div class="post-body">
          <slot />
        </div>

      </article>
    </div>
  </main>

  <Footer />
</BaseLayout>
