---
import BaseLayout from './BaseLayout.astro';
import { formatDateKo } from '../utils/date';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/blog.css';

type NavLink = { slug: string; title: string } | null;

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author?: string;
  tags?: string[];
  /** 글의 종류(인사이트 · 가이드 · 소식). 목록 카드와 같은 값을 메타 줄에 적는다. */
  category?: string;
  ogImage?: string;
  slug: string;
  nav?: { newer: NavLink; older: NavLink };
  readingTime?: number;
  lang?: 'ko' | 'en';
}

const {
  title, description, pubDate, updatedDate, author = 'Refinery', tags = [], category, ogImage, slug,
  nav = { newer: null, older: null }, readingTime, lang = 'ko',
} = Astro.props;

// 글 UI 문구·날짜 형식·경로를 로케일별로.
const T = {
  ko: { locale: 'ko-KR', base: '/blog', suffix: 'Refinery 블로그', back: '← 블로그',
        reading: (m: number) => `약 ${m}분 읽기`, navAria: '다른 글',
        older: '← 이전 글', newer: '다음 글 →' },
  en: { locale: 'en-US', base: '/en/blog', suffix: 'Refinery Blog', back: '← Blog',
        reading: (m: number) => `${m} min read`, navAria: 'More posts',
        older: '← Previous', newer: 'Next →' },
}[lang];

// 한국어는 '2026. 07. 31', 영어는 'July 31, 2026'. 목록 카드와 같은 함수를 쓴다.
const fmt = (d: Date) =>
  lang === 'ko'
    ? formatDateKo(d)
    : new Intl.DateTimeFormat(T.locale, { year: 'numeric', month: 'long', day: 'numeric' }).format(d);

// canonical/sitemap 정합: 클린 URL 사용(Vercel이 .html도 동일 경로로 서빙)
const canonical = `${T.base}/${slug}`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Organization', name: author },
  publisher: {
    '@type': 'Organization',
    name: 'Refinery',
    logo: {
      '@type': 'ImageObject',
      url: 'https://refinery.kr/logo_Refinery_symbol.svg',
    },
  },
  image: new URL(ogImage ?? '/og-image.png', 'https://refinery.kr/').href,
  mainEntityOfPage: `https://refinery.kr${canonical}`,
};
---
<BaseLayout
  title={`${title} | ${T.suffix}`}
  ogTitle={title}
  description={description}
  canonical={canonical}
  ogType="article"
  ogImage={ogImage}
  jsonLd={jsonLd}
>
  <Nav />
  <main class="blog-main blog-main--post">
    <div class="post-shell">

      <article class="post">
        {/* 표지 자리. 이미지가 들어오기 전까지 빈 면으로 남는다 — 자리를 늘
            차지하므로 나중에 넣어도 배치가 흔들리지 않는다.
            비율(16:10)과 면은 목록 카드의 표지 칸(.res-thumb)과 같다.
            같은 파일 하나로 목록과 글 양쪽을 덮을 수 있다. */}
        <div class="post-thumb"></div>
        <header class="post-header">
          <div class="post-meta">
            <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
            {category && <><span class="post-bar" aria-hidden="true"></span><span>{category}</span></>}
            <span class="post-bar" aria-hidden="true"></span>
            <span>{author}</span>
            {readingTime && <><span class="post-bar" aria-hidden="true"></span><span>{T.reading(readingTime)}</span></>}
          </div>
          <h1>{title}</h1>
          <p class="post-desc">{description}</p>
          {tags.length > 0 && (
            <ul class="post-tags">
              {tags.map((t) => <li>{t}</li>)}
            </ul>
          )}
        </header>
        <div class="post-body">
          <slot />
        </div>

        {(nav.older || nav.newer) && (
          <nav class="post-nav" aria-label={T.navAria}>
            {nav.older
              ? (
                <a class="post-nav-item post-nav-prev" href={`${T.base}/${nav.older.slug}`}>
                  <span class="post-nav-dir">{T.older}</span>
                  <strong class="post-nav-title">{nav.older.title}</strong>
                </a>
              )
              : <span class="post-nav-item is-empty" aria-hidden="true"></span>}
            {nav.newer
              ? (
                <a class="post-nav-item post-nav-next" href={`${T.base}/${nav.newer.slug}`}>
                  <span class="post-nav-dir">{T.newer}</span>
                  <strong class="post-nav-title">{nav.newer.title}</strong>
                </a>
              )
              : <span class="post-nav-item is-empty" aria-hidden="true"></span>}
          </nav>
        )}
      </article>
    </div>
  </main>

  <Footer />
</BaseLayout>
