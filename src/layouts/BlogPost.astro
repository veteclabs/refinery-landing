---
import { Image } from 'astro:assets';
import BrandMark from '../components/BrandMark.astro';
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import { formatDateKo } from '../utils/date';
import { coverTone } from '../utils/cover-tone';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import BlogCard from '../components/BlogCard.astro';
import { blogBase, categorySlug, type Post } from '../utils/blog';
import type { MarkdownHeading } from 'astro';
import '../styles/res-card.css';
import '../styles/blog-card.css';
import '../styles/blog.css';

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author?: string;
  /** 글의 종류(인사이트 · 가이드 · 소식). 목록 카드와 같은 값을 메타 줄에 적는다. */
  category?: string;
  ogImage?: string;
  /** 표지 이미지(src/assets). 목록 카드와 같은 파일을 쓴다. */
  image?: ImageMetadata;
  /** 표지 오른쪽 아래 아이콘(public 경로). */
  coverIcon?: string;
  /** 표지 밑색(hex). 사진이 없는 글에서 표지 면에 깔린다. */
  coverColor?: string;
  /** 표지 글자색(hex). 지정하면 자동 판정(잉크/흰색)보다 우선한다. */
  coverTextColor?: string;
  /** 표지 왼쪽 아래 글(목록 카드와 같은 자리). */
  coverFoot?: string;
  /** 표지 왼쪽 위 태그라인(첫 태그)을 감춘다. */
  hideCoverKind?: boolean;
  /** 태그. 첫 값이 표지 왼쪽 위 태그라인이 된다. */
  tags?: string[];
  /** 표지 안 대제목의 줄바꿈 지점. 값이 있을 때만 표지에 제목이 들어간다. */
  titleBreakAfter?: string | string[];
  slug: string;
  lang?: 'ko' | 'en';
  /** 본문 제목들(render()가 준다). 목차에 h2만 쓴다. */
  headings?: MarkdownHeading[];
  /** 글 끝 「다른 글」(utils/blog.ts의 relatedPosts). */
  related?: Post[];
}

const {
  title, description, pubDate, updatedDate, author = 'Refinery', category, ogImage, image, coverIcon, coverTexture, coverIconAt = 'corner', coverColor, coverTextColor, coverFoot,
  hideCoverKind = false, tags = [], titleBreakAfter, coverKindBreakAfter, slug,
  lang = 'ko', headings = [], related = [],
} = Astro.props;

// 글 UI 문구·날짜 형식·경로를 로케일별로.
const T = {
  ko: { locale: 'ko-KR', base: '/blog', suffix: 'Refinery 블로그', blog: '블로그', toc: '목차', related: '다른 글', all: '전체 글 보기' },
  en: { locale: 'en-US', base: '/en/blog', suffix: 'Refinery Blog', blog: 'Blog', toc: 'On this page', related: 'More posts', all: 'View all posts' },
}[lang];
const catSlug = categorySlug(category);
// 목차는 h2만 쓴다. 절이 셋보다 적은 글은 목차가 하는 일이 없어 달지 않는다.
const toc = headings.filter((h) => h.depth === 2);
const hasToc = toc.length >= 3;

// 한국어는 '2026. 07. 31', 영어는 'July 31, 2026'. 목록 카드와 같은 함수를 쓴다.
const fmt = (d: Date) =>
  lang === 'ko'
    ? formatDateKo(d)
    : new Intl.DateTimeFormat(T.locale, { year: 'numeric', month: 'long', day: 'numeric' }).format(d);

// canonical/sitemap 정합: 클린 URL 사용(Vercel이 .html도 동일 경로로 서빙)
// 표지 안 대제목을 끊는다. 끊을 지점은 글 원본의 titleBreakAfter에 있고, 그 말
// 바로 뒤에서 나눈다. 목록 카드가 소제목을 끊는 방식과 같다.
// 배열을 주면 지점 수 + 1 줄이 된다(두 지점 → 세 줄). 앞에서부터 차례로 자르므로
// 같은 말이 제목에 두 번 나와도 뒤엣것이 먼저 잘리는 일은 없다.
const coverTitle = titleBreakAfter
  ? (() => {
      const marks = Array.isArray(titleBreakAfter) ? titleBreakAfter : [titleBreakAfter];
      const lines: string[] = [];
      let rest = title;
      for (const m of marks) {
        const i = rest.indexOf(m);
        if (i < 0) return null;   // 한 곳이라도 못 찾으면 표지 제목을 넣지 않는다
        const cut = i + m.length;
        lines.push(rest.slice(0, cut));
        rest = rest.slice(cut).trimStart();
      }
      lines.push(rest);
      return lines;
    })()
  : null;

const canonical = `${T.base}/${slug}`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Organization', name: author },
  publisher: {
    '@type': 'Organization',
    name: 'Refinery',
    logo: {
      '@type': 'ImageObject',
      url: 'https://refinery.kr/logo_Refinery_symbol.svg',
    },
  },
  image: new URL(ogImage ?? '/og-image.png', 'https://refinery.kr/').href,
  mainEntityOfPage: `https://refinery.kr${canonical}`,
};
---
<BaseLayout
  title={`${title} | ${T.suffix}`}
  ogTitle={title}
  description={description}
  canonical={canonical}
  ogType="article"
  ogImage={ogImage}
  jsonLd={jsonLd}
>
  <Nav />
  <main class="blog-main blog-main--post">
    <div class:list={['post-shell', hasToc && 'has-toc']}>

      <article class="post">
        {/* 표지. 칸이 먼저 자리를 잡고 이미지가 그 안을 cover로 채운다 —
            이미지가 없는 글은 빈 면으로 남고 배치는 그대로다.
            목록 카드(.res-thumb)와 같은 파일을 쓰고, 크기만 여기서 더 크다.
            widths/sizes를 주면 빌드가 폭별 파일을 만들어 각 화면이 제 크기만
            내려받는다. 접힘선 위라 lazy는 걸지 않는다(LCP). */}
        <div
          class="post-thumb"
          data-tone={coverTone(coverColor)}
          style={[
            coverColor && `--cover-bg: ${coverColor}`,
            coverTextColor && `--cover-fg: ${coverTextColor}`,
          ].filter(Boolean).join('; ') || undefined}
        >
          {image && (
            <Image
              src={image}
              alt=""
              widths={[432, 720, 820, 1440, 1640]}
              sizes="(max-width: 868px) calc(100vw - 48px), 820px"
              loading="eager"
              fetchpriority="high"
            />
          )}
          {image && <BrandMark class="thumb-mark" />}
          {coverTexture && (
            <img class="thumb-texture" src={coverTexture} alt="" aria-hidden="true" loading="lazy" decoding="async" />
          )}
          {coverIcon && <img class:list={['thumb-icon', coverIconAt === 'center' && 'is-center']} src={coverIcon} alt="" loading="lazy" decoding="async" />}
          {/* 표지 안 구성은 목록 카드(.res-cover)와 같다 — 왼쪽 위 태그라인, 대제목,
              왼쪽 아래 글. 칸이 커진 만큼 글자와 안여백을 1.5배로 키웠다. */}
          {(coverTitle || coverFoot || (tags[0] && !hideCoverKind)) && (
            <div class="post-cover">
              {tags[0] && !hideCoverKind && (() => {
                const [a, b] = coverKindBreakAfter
                  ? (() => { const i = tags[0].indexOf(coverKindBreakAfter);
                             if (i < 0) return [tags[0], ''];
                             const cut = i + coverKindBreakAfter.length;
                             return [tags[0].slice(0, cut), tags[0].slice(cut).trimStart()]; })()
                  : [tags[0], ''];
                return <span class="post-cover-kind">#{a}{b && <><br />{b}</>}</span>;
              })()}
              {coverTitle && (
                <strong class="post-cover-line">
                  {coverTitle.map((l, i) => <>{i > 0 && <br />}{l}</>)}
                </strong>
              )}
              {coverFoot && <span class="post-cover-foot">{coverFoot}</span>}
            </div>
          )}
        </div>
        <header class="post-header">
          {/* 목록 카드와 같은 순서다 — 대제목 · 소제목 · 날짜. */}
          {/* 표지에 제목이 올라간 글도 여기 제목을 그대로 보인다. 표지의 글자는
              그림에 가깝고, 글의 대제목은 본문이 시작되는 자리를 알리는 역할이라
              둘은 하는 일이 다르다. (한때 중복으로 보고 감췄다가 되살렸다.) */}
          {/* 위치 표시 — 블로그 / 글 종류. 종류는 목록의 그 탭으로 바로 간다(#insight 등). */}
          <nav class="post-crumb" aria-label={lang === 'ko' ? '위치' : 'Breadcrumb'}>
            <a href={T.base}>{T.blog}</a>
            {category && <><span aria-hidden="true">/</span>{catSlug ? <a href={`${T.base}#${catSlug}`}>{category}</a> : <span>{category}</span>}</>}
          </nav>
          <h1>{title}</h1>
          <p class="post-desc">{description}</p>
          <div class="post-meta">
            <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
            {category && <><span class="post-bar" aria-hidden="true"></span><span>{category}</span></>}
            {author && <><span class="post-bar" aria-hidden="true"></span><span>{author}</span></>}
          </div>
          {/* 태그는 목록의 검색으로 이어진다(#q=태그). */}
          {tags.length > 0 && (
            <ul class="post-tags">
              {tags.map((tag) => <li><a href={`${T.base}#q=${encodeURIComponent(tag)}`}>#{tag}</a></li>)}
            </ul>
          )}
        </header>
        <div class="post-body">
          <slot />
        </div>

      </article>

      {/* 목차 — 넓은 화면에서만 본문 오른쪽 여백에 붙는다. 본문 기둥(820px)은 가운데 그대로다.
          예전 왼쪽 목차는 본문을 오른쪽으로 밀어 걷었다(blog.css .post-shell 주석). */}
      {hasToc && (
        <aside class="post-toc" aria-label={T.toc}>
          <div class="post-toc-inner">
            <p class="post-toc-title">{T.toc}</p>
            <ol>
              {toc.map((h) => <li><a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a></li>)}
            </ol>
          </div>
        </aside>
      )}
    </div>

    {/* 다른 글 — 같은 종류 먼저, 나머지는 최신순. 카드는 목록과 같은 컴포넌트다. */}
    {related.length > 0 && (
      <section class="post-related res-page blog-list">
        <div class="post-related-head">
          <h2>{T.related}</h2>
          <a href={T.base}>{T.all}<span aria-hidden="true"> →</span></a>
        </div>
        <div class="post-related-grid">
          {related.map((p) => <BlogCard post={p} />)}
        </div>
      </section>
    )}
  </main>

  <Footer />
</BaseLayout>

<script>
  // 목차에서 지금 읽고 있는 절을 표시한다. 화면 위쪽 1/3을 지난 마지막 제목이 지금 절이다.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.post-toc a[data-toc]'));
  if (links.length) {
    const targets = links
      .map((a) => document.getElementById(a.dataset.toc || ''))
      .filter((el): el is HTMLElement => !!el);
    const update = () => {
      const line = window.innerHeight / 3;
      let current = targets[0]?.id;
      for (const el of targets) if (el.getBoundingClientRect().top <= line) current = el.id;
      links.forEach((a) => a.classList.toggle('is-active', a.dataset.toc === current));
    };
    let ticking = false;
    window.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => { update(); ticking = false; });
    }, { passive: true });
    update();
  }
</script>
