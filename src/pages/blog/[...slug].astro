---
import { render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getPosts, postSlug, readingMinutes, relatedPosts } from '../../utils/blog';

export async function getStaticPaths() {
  const posts = await getPosts('ko');
  return posts.map((post) => ({
    params: { slug: postSlug(post) },
    props: { post, related: relatedPosts(post, posts) },
  }));
}

const { post, related } = Astro.props;
const { Content, headings } = await render(post);
---
<BlogPost {...post.data} slug={postSlug(post)} headings={headings} related={related} minutes={readingMinutes(post.body, post.data.lang)}>
  <Content />
</BlogPost>
