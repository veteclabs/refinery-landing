---
// 블로그 목록. 자료실(/resources)과 같은 카드 목록 구조를 쓴다 —
// 히어로(h1만) + 3열 그리드 + 표지 칸이 위에 붙은 카드.
// 공통 스타일은 res-card.css에 있고 자료실과 함께 쓴다(<main class="ind res-page">).
// 표지 이미지는 아직 없다. 칸(.res-thumb)만 자리를 잡아 두고, 파일이 준비되면
// 그 안에 <img>를 넣으면 된다 — 자료실 카드와 같은 방식이다.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { readingMinutesForSlug } from '../../utils/readingTime';
import '../../styles/industry.css';
import '../../styles/res-card.css';

const posts = (await getCollection('blog', ({ data }) => !data.draft && data.lang === 'ko')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const fmt = (d: Date) =>
  new Intl.DateTimeFormat('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' }).format(d);

// 카드 소제목을 두 줄로 끊는다. 끊을 지점은 글 원본의 cardBreakAfter에 있고,
// 그 말 바로 뒤에서 나눈다. description 자체에 <br>을 넣지 않는 이유는
// 같은 값이 meta description과 RSS에도 쓰이기 때문이다.
// 지점을 못 찾으면 끊지 않고 한 덩어리로 둔다.
const splitDesc = (desc: string, at?: string): [string, string] => {
  if (!at) return [desc, ''];
  const i = desc.indexOf(at);
  if (i < 0) return [desc, ''];
  const cut = i + at.length;
  return [desc.slice(0, cut), desc.slice(cut).trimStart()];
};
---
<BaseLayout
  title="블로그 | Refinery"
  description="산업 데이터 · AI 에이전트 · 현장 운영에 대한 Refinery의 인사이트와 제품 소식."
  canonical="/blog"
>
  <Nav />
  <main class="ind res-page blog-list">
    <!-- HERO -->
    <section class="ind-hero">
      <div class="ind-container">
        <h1>블로그</h1>
      </div>
    </section>

    <!-- GRID -->
    <section class="ind-section">
      <div class="ind-container">
        <div class="ind-grid ind-grid-3">
          {posts.map((post) => {
            const [head, tail] = splitDesc(post.data.description, post.data.cardBreakAfter);
            return (
            <a class="ind-card res-card is-link" href={`/blog/${post.id}`}>
              {/* 표지 자리. 이미지가 들어오기 전까지 빈 면으로 남는다 —
                  자리를 늘 차지하므로 나중에 넣어도 배치가 흔들리지 않는다.
                  자료실의 '준비중' 그림·배지는 두지 않는다. 글은 이미 공개된
                  것이라 준비 중이 아니다. */}
              <div class="res-thumb is-empty"></div>
              <h3>{post.data.title}</h3>
              <p>{head}{tail && <><br />{tail}</>}</p>
              <div class="blog-meta">
                <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
                <span class="blog-meta-dot">·</span>
                <span>약 {readingMinutesForSlug(post.id)}분 읽기</span>
                {post.data.tags[0] && <span class="blog-meta-tag">#{post.data.tags[0]}</span>}
              </div>
            </a>
            );
          })}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  /* 날짜·읽는 시간·태그. 자료실 카드에는 없는 줄이라 여기서만 둔다.
     대제목·소제목 아래에 놓고, 크기는 카드 설명(15px)보다 한 단계 작다.
     위 여백 10px은 소제목 행간(15x1.5=22.5px)의 아랫부분과 겹쳐 보이지 않도록
     띄운 값이다. */
  .blog-list .blog-meta {
    display: flex; align-items: center; flex-wrap: wrap; gap: 6px;
    margin: 10px 0 0;
    font-size: 13px; line-height: 1.4; color: var(--text-muted, #7e8a98);
  }
  .blog-list .blog-meta-dot { opacity: .6; }
  /* 태그는 앞의 두 값과 갈라 보이게 하늘색으로 둔다 —
     자료실 표지의 종류(.res-cover-kind)와 같은 색이다. */
  .blog-list .blog-meta-tag { color: #76A6D7; font-weight: 600; }
  /* 한국어가 어절 중간에서 잘리지 않게 한다(사이트 공통 규칙과 같은 값).
     아주 긴 낱말만 예외로 넘겨 상자 밖으로 나가지 않게 한다. */
  .blog-list .res-card h3,
  .blog-list .res-card p { word-break: keep-all; overflow-wrap: break-word; }
  /* 손으로 넣은 줄바꿈은 칸이 설계 폭(382px = 1280 컨테이너 기준 3열)일 때만
     맞는다. 컨테이너가 1280을 못 채우기 시작하면 칸이 좁아져 끊어 둔 두 도막이
     각각 다시 감기고, 카드마다 3~4줄로 들쭉날쭉해진다(실측 1100px에서 3줄,
     900px에서 한 장만 4줄). 그 아래로는 풀어 자연스럽게 감기게 둔다. */
  @media (max-width: 1279px) {
    .blog-list .res-card p br { display: none; }
  }
</style>
