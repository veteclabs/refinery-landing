---
// 블로그 목록. 자료실(/resources)과 같은 카드 목록 구조를 쓴다 —
// 히어로(h1만) + 3열 그리드 + 표지 칸이 위에 붙은 카드.
// 공통 스타일은 res-card.css에 있고 자료실과 함께 쓴다(<main class="ind res-page">).
// 표지 이미지는 아직 없다. 칸(.res-thumb)만 자리를 잡아 두고, 파일이 준비되면
// 그 안에 <img>를 넣으면 된다 — 자료실 카드와 같은 방식이다.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BrandMark from '../../components/BrandMark.astro';
import { formatDateKo } from '../../utils/date';
import '../../styles/industry.css';
import '../../styles/res-card.css';

const posts = (await getCollection('blog', ({ data }) => !data.draft && data.lang === 'ko')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);


// 카드 소제목을 두 줄로 끊는다. 끊을 지점은 글 원본의 cardBreakAfter에 있고,
// 그 말 바로 뒤에서 나눈다. description 자체에 <br>을 넣지 않는 이유는
// 같은 값이 meta description과 RSS에도 쓰이기 때문이다.
// 지점을 못 찾으면 끊지 않고 한 덩어리로 둔다.
const splitDesc = (desc: string, at?: string): [string, string] => {
  if (!at) return [desc, ''];
  const i = desc.indexOf(at);
  if (i < 0) return [desc, ''];
  const cut = i + at.length;
  return [desc.slice(0, cut), desc.slice(cut).trimStart()];
};
---
<BaseLayout
  title="블로그 | Refinery"
  description="산업 데이터 · AI 에이전트 · 현장 운영에 대한 Refinery의 인사이트와 제품 소식."
  canonical="/blog"
>
  <Nav />
  <main class="ind res-page blog-list">
    <!-- HERO -->
    <section class="ind-hero">
      <div class="ind-container">
        <h1>블로그</h1>
      </div>
    </section>

    <!-- GRID -->
    <section class="ind-section">
      <div class="ind-container">
        <div class="ind-grid ind-grid-3">
          {posts.map((post) => {
            const [head, tail] = splitDesc(post.data.description, post.data.cardBreakAfter);
            return (
            <a class="ind-card res-card is-link" href={`/blog/${post.id}`}>
              {/* 표지. 이미지가 없는 글은 빈 면으로 남는다 — 자리를 늘 차지하므로
                  나중에 넣어도 배치가 흔들리지 않는다. 자료실의 '준비중' 그림·배지는
                  두지 않는다. 글은 이미 공개된 것이라 준비 중이 아니다.
                  표지가 있으면 글의 종류(태그)는 그 위에 얹힌다 — 자료실과 같다. */}
              <div class={post.data.image ? 'res-thumb' : 'res-thumb is-empty'}>
                {post.data.image && (
                  <Image
                    src={post.data.image}
                    alt=""
                    widths={[383, 560, 766, 1104, 1440]}
                    sizes="(max-width: 860px) calc(100vw - 48px), (max-width: 1279px) calc((100vw - 132px) / 3), 383px"
                    loading="lazy"
                    decoding="async"
                  />
                )}
                {post.data.image && <BrandMark class="thumb-mark" />}
                {post.data.tags[0] && (
                  <div class="res-cover">
                    <span class="res-cover-kind">{post.data.tags[0]}</span>
                  </div>
                )}
              </div>
              <h3>{post.data.title}</h3>
              <p>{head}{tail && <><br />{' '}{tail}</>}</p>
              <div class="blog-meta">
                <time datetime={post.data.pubDate.toISOString()}>{formatDateKo(post.data.pubDate)}</time>
                {post.data.category && (
                  <>
                    <span class="blog-meta-bar" aria-hidden="true"></span>
                    <span>{post.data.category}</span>
                  </>
                )}
              </div>
            </a>
            );
          })}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  /* 날짜 · 종류 · 태그. 자료실 카드에는 없는 줄이라 여기서만 둔다.
     읽는 시간(약 N분)은 카드에서 뺐다 — 분량보다 글의 종류를 알려 주는 편이
     고르는 데 도움이 된다. 글 상세에는 그대로 있다.
     대제목·소제목 아래에 놓고, 크기는 카드 설명(15px)보다 한 단계 작다.
     위 여백 10px은 소제목 행간(15x1.5=22.5px)의 아랫부분과 겹쳐 보이지 않도록
     띄운 값이다. */
  .blog-list .blog-meta {
    display: flex; align-items: center; flex-wrap: wrap; gap: 6px;
    margin: 10px 0 0;
    font-size: 13px; line-height: 1.4; color: var(--text-muted, #7e8a98);
  }
  /* 날짜와 종류 사이 구분선. 글자 '|'는 폰트에 따라 굵기와 높이가 달라져,
     글자 색으로 그린 1px 선을 쓴다. 높이 11px은 이 줄 글자 크기(13px)의
     대문자 높이쯤이라 글자 사이에 자연스럽게 선다. */
  .blog-list .blog-meta-bar {
    width: 1px; height: 11px; background: currentColor; opacity: .35;
    display: inline-block; flex: none;
  }
  /* 표지 글자(태그). 자료실과 같은 자리·같은 규격이고, 표지 이미지가 들어오면
     색까지 그대로 같아진다(#76A6D7).
     다만 표지가 아직 빈 동안에는 그 하늘색이 밑판(#F6F8FA) 위에서 2.40:1까지밖에
     안 나와 읽히지 않는다 — 자료실이 빈 표지에 글자를 두지 않기로 한 이유다.
     여기서는 태그가 카드의 유일한 분류라 비울 수 없어, 비어 있는 동안만
     본문 보조색(7.39:1)으로 둔다. 하늘색의 톤을 새로 만들지는 않는다. */
  .blog-list .res-thumb.is-empty .res-cover-kind { color: #47535f; }
  /* 한국어가 어절 중간에서 잘리지 않게 한다(사이트 공통 규칙과 같은 값).
     아주 긴 낱말만 예외로 넘겨 상자 밖으로 나가지 않게 한다. */
  .blog-list .res-card h3,
  .blog-list .res-card p { word-break: keep-all; overflow-wrap: break-word; }
  /* 손으로 넣은 줄바꿈은 칸이 설계 폭(382px = 1280 컨테이너 기준 3열)일 때만
     맞는다. 컨테이너가 1280을 못 채우기 시작하면 칸이 좁아져 끊어 둔 두 도막이
     각각 다시 감기고, 카드마다 3~4줄로 들쭉날쭉해진다(실측 1100px에서 3줄,
     900px에서 한 장만 4줄). 그 아래로는 풀어 자연스럽게 감기게 둔다. */
  /* <br> 뒤에는 띄어쓰기 한 칸을 같이 넣어 둔다(마크업의 {' '}). 줄바꿈이 보일 때
     그 칸은 줄 첫머리라 지워지고, 여기서 <br>을 감추면 두 도막을 이어 주는 칸으로
     남는다. 이게 없으면 '…샙니다.데이터로'처럼 문장이 붙어 버린다. */
  @media (max-width: 1279px) {
    .blog-list .res-card p br { display: none; }
  }
</style>
