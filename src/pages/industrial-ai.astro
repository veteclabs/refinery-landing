---
// 산업 AI 개념 필러 페이지 — AEO(답변엔진 최적화)용.
// 산업 AI·제조 AI·에너지 AI·산업 AI 에이전트·AI 시스템을 정의형 Q&A로 답하고 FAQPage 스키마로도 출력한다.
// 모든 답변은 실제 사실(온톨로지·온프레미스·30년/100+ 현장·기존 위 통합)만 쓴다. 창작 수치 금지.
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/industry.css';

// 본문 Q&A와 FAQPage 스키마는 같은 배열에서 나온다(항상 동기화).
const faqItems = [
  {
    q: '산업 AI란 무엇인가요?',
    a: '산업 AI는 제조·에너지·플랜트 등 산업 현장의 설비·공정·센서 데이터를 수집·통합·분석해 판단과 조치를 돕는 인공지능입니다. 범용 챗봇과 달리 실제 현장 데이터와 도메인 맥락에 근거해 답합니다.',
  },
  {
    q: '제조 AI란 무엇인가요?',
    a: '제조 AI는 생산·품질·설비 운영에 적용되는 산업 AI입니다. 대표적인 활용은 설비 고장을 미리 예측하는 예지보전, 불량을 사전에 잡는 품질 예측, 에너지 사용을 줄이는 에너지 최적화입니다.',
  },
  {
    q: '제조업 AI란 무엇인가요?',
    a: '제조업 AI는 생산·품질·설비·에너지 운영에 인공지능을 적용해 예측과 자동화를 돕는 기술로, 제조 AI와 같은 의미로 쓰입니다. 흩어진 현장 데이터를 통합해 근거 있는 판단을 만드는 것이 핵심입니다.',
  },
  {
    q: '스마트팩토리 AI란 무엇인가요?',
    a: '스마트팩토리 AI는 공장의 설비·공정·품질·에너지 데이터를 하나로 연결해 스스로 감지·예측·최적화하는 지능형 공장을 만드는 AI입니다. 단순 자동화를 넘어 데이터에 근거해 판단하고 다음 조치를 제안합니다.',
  },
  {
    q: '에너지 AI란 무엇인가요?',
    a: '에너지 AI는 전력·에너지 데이터를 분석해 소비·품질·효율을 관리하는 산업 AI입니다. 에너지관리시스템(EMS)과 결합해 전력 피크와 이상을 감지하고 절감 기회를 찾습니다.',
  },
  {
    q: '산업 AI 에이전트란 무엇인가요?',
    a: '산업 AI 에이전트는 질문에 근거(출처)를 들어 답하고, 원인을 추론해 다음 조치까지 제안하는 대화형 AI입니다. Refinery는 흩어진 데이터를 온톨로지로 엮어 의미를 부여함으로써 이를 구현합니다.',
  },
  {
    q: 'AI 시스템을 도입하려면 무엇이 필요한가요?',
    a: '먼저 SCADA·MES·ERP·센서·문서에 흩어진 데이터를 하나로 통합해야 합니다. Refinery는 기존 시스템 위에 통합 지능 레이어로 얹거나, 시스템이 없는 현장은 새로 구축해 데이터에 의미를 부여하고 AI가 근거를 들어 판단하게 합니다.',
  },
  {
    q: 'Refinery의 산업 AI는 무엇이 다른가요?',
    a: 'Refinery는 흩어진 SCADA·MES·ERP·센서·문서를 온톨로지로 엮어 근거 있는 판단을 만듭니다. 기존 시스템 위에 얹거나 없으면 새로 구축하며, 데이터가 사내를 벗어나지 않는 온프레미스 배포를 지원합니다. 30년 현장 경험과 100곳이 넘는 산업 현장에서 검증됐습니다.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// 관련 활용 — 실제 존재하는 use-case 페이지로 내부 링크(키워드 앵커).
const uses = [
  { label: '예지보전', desc: '설비 고장을 미리 예측 · 무선 진동센서와 모터 예지보전까지', href: '/use-cases/predictive-maintenance' },
  { label: '전력관리 솔루션', desc: '전력 데이터로 피크 · 이상 · 절감 기회를 찾는 에너지 AI', href: '/use-cases/power-management' },
  { label: '품질 예측', desc: '공정 데이터로 불량을 사전에 잡는 제조 AI', href: '/use-cases/quality-prediction' },
  { label: '에너지관리시스템(EMS)', desc: 'EMS·전력관리·전력감시·정전감시 개념 한눈에', href: '/energy-management' },
];
---
<BaseLayout
  title="산업 AI란? 제조·에너지 현장의 AI 에이전트 | Refinery"
  description="산업 AI·제조 AI·에너지 AI·산업 AI 에이전트가 무엇인지, 흩어진 현장 데이터를 어떻게 판단으로 잇는지 정리했습니다. Refinery는 온톨로지로 근거 있는 AI 판단을 제공합니다."
  canonical="/industrial-ai"
  jsonLd={faqSchema}
>
  <Nav />
  <main class="ind ind-page">
    <!-- HERO -->
    <section class="ind-hero">
      <div class="ind-container">
        <nav class="ind-crumb" aria-label="위치"><a href="/">Home</a><span>›</span><span>산업 AI</span></nav>
        <p class="ind-eyebrow">INDUSTRIAL AI</p>
        <h1>산업 AI란?</h1>
        <p class="ind-lede">제조·에너지 현장의 데이터를 판단으로 잇는 산업 AI와 AI 에이전트를 정리했습니다. Refinery는 흩어진 현장 데이터를 온톨로지로 엮어 근거 있는 판단을 만듭니다.</p>
      </div>
    </section>

    <!-- 정의형 Q&A -->
    <section class="ind-section">
      <div class="ind-container">
        <div class="qa-list">
          {faqItems.map((f) => (
            <div class="qa-item">
              <h2>{f.q}</h2>
              <p>{f.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 관련 활용 -->
    <section class="ind-section ind-soft">
      <div class="ind-container">
        <header class="ind-head">
          <h2>현장에서 바로 쓰는 활용</h2>
          <p>산업 AI가 실제 현장에서 어떻게 쓰이는지 살펴보세요.</p>
        </header>
        <div class="ind-grid ind-grid-3">
          {uses.map((u) => (
            <a class="ind-card" href={u.href}><h3>{u.label}</h3><p>{u.desc}</p><span class="ind-card-go">보기 →</span></a>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="ind-cta">
      <div class="ind-container">
        <h2>산업 AI, 우리 현장에<br>어떻게 적용할까요?</h2>
        <a href="/contact" class="ind-btn-primary ind-btn-lg">문의하기</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  /* 블록 폭을 컨테이너 하나로 맞춘다. 전에는 Q&A만 760px이라 구분선이 화면 중간에서
     끊기고, 아래 카드 그리드(1072px)와 오른쪽 끝이 어긋나 페이지가 두 축으로 보였다.
     글줄이 길어지는 것은 문단에만 읽기 폭(72ch)을 걸어 막는다 — 제목과 구분선은
     전체 폭을 쓰고 본문만 짧게 끊긴다. */
  .qa-list { max-width: none; }
  .qa-item + .qa-item { margin-top: 32px; padding-top: 32px; border-top: 1px solid #e6eaef; }
  .qa-item h2 { font-size: clamp(20px, 2.6vw, 26px); font-weight: 650; letter-spacing: -0.02em; color: var(--text, #16202c); margin: 0 0 10px; }
  .qa-item p { font-size: 17px; line-height: 1.75; color: #2b3644; margin: 0; max-width: 72ch; }
  /* 히어로 소개글만 읽기 폭을 넓힌다(공통값 60ch → 72ch). 섹션 머리(.ind-head)는
     .ind-page 규칙이 이미 대제목 왼쪽·소제목 오른쪽으로 잡아 두므로 건드리지 않는다. */
  .ind-hero .ind-lede { max-width: 72ch; }
  .ind-card-go { display: inline-block; margin-top: 12px; font-size: 14px; font-weight: 600; color: #4b86bf; }
  a.ind-card { text-decoration: none; }
</style>
