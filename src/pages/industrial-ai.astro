---
// 산업 AI 개념 필러 페이지 — AEO(답변엔진 최적화)용.
// 산업 AI·제조 AI·에너지 AI·산업 AI 에이전트·AI 시스템을 정의형 Q&A로 답하고 FAQPage 스키마로도 출력한다.
// 모든 답변은 실제 사실(온톨로지·온프레미스·30년/100+ 현장·기존 위 통합)만 쓴다. 창작 수치 금지.
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/industry.css';

// 본문 Q&A와 FAQPage 스키마는 같은 배열에서 나온다(항상 동기화).
const faqItems = [
  {
    q: '산업 AI란 무엇인가요?',
    a: '산업 AI는 제조·에너지·플랜트 등 산업 현장의 설비·공정·센서 데이터를 수집·통합·분석해 판단과 조치를 돕는 인공지능입니다. 범용 챗봇과 달리 실제 현장 데이터와 도메인 맥락에 근거해 답합니다.',
  },
  {
    q: '제조 AI란 무엇인가요?',
    a: '제조 AI는 생산·품질·설비 운영에 적용되는 산업 AI입니다. 대표적인 활용은 설비 고장을 미리 예측하는 예지보전, 불량을 사전에 잡는 품질 예측, 에너지 사용을 줄이는 에너지 최적화입니다.',
  },
  {
    q: '제조업 AI란 무엇인가요?',
    a: '제조업 AI는 생산·품질·설비·에너지 운영에 인공지능을 적용해 예측과 자동화를 돕는 기술로, 제조 AI와 같은 의미로 쓰입니다. 흩어진 현장 데이터를 통합해 근거 있는 판단을 만드는 것이 핵심입니다.',
  },
  {
    q: '스마트팩토리 AI란 무엇인가요?',
    a: '스마트팩토리 AI는 공장의 설비·공정·품질·에너지 데이터를 하나로 연결해 스스로 감지·예측·최적화하는 지능형 공장을 만드는 AI입니다. 단순 자동화를 넘어 데이터에 근거해 판단하고 다음 조치를 제안합니다.',
  },
  {
    q: '에너지 AI란 무엇인가요?',
    a: '에너지 AI는 전력·에너지 데이터를 분석해 소비·품질·효율을 관리하는 산업 AI입니다. 에너지관리시스템(EMS)과 결합해 전력 피크와 이상을 감지하고 절감 기회를 찾습니다.',
  },
  {
    q: '산업 AI 에이전트란 무엇인가요?',
    a: '산업 AI 에이전트는 질문에 근거(출처)를 들어 답하고, 원인을 추론해 다음 조치까지 제안하는 대화형 AI입니다. Refinery는 흩어진 데이터를 온톨로지로 엮어 의미를 부여함으로써 이를 구현합니다.',
  },
  {
    q: 'AI 시스템을 도입하려면 무엇이 필요한가요?',
    a: '먼저 SCADA·MES·ERP·센서·문서에 흩어진 데이터를 하나로 통합해야 합니다. Refinery는 기존 시스템 위에 통합 지능 레이어로 얹거나, 시스템이 없는 현장은 새로 구축해 데이터에 의미를 부여하고 AI가 근거를 들어 판단하게 합니다.',
  },
  {
    q: 'Refinery의 산업 AI는 무엇이 다른가요?',
    a: 'Refinery는 흩어진 SCADA·MES·ERP·센서·문서를 온톨로지로 엮어 근거 있는 판단을 만듭니다. 기존 시스템 위에 얹거나 없으면 새로 구축하며, 데이터가 사내를 벗어나지 않는 온프레미스 배포를 지원합니다. 30년 현장 경험과 100곳이 넘는 산업 현장에서 검증됐습니다.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// 관련 활용 — 실제 존재하는 use-case 페이지로 내부 링크(키워드 앵커).
const uses = [
  { label: '예지보전', desc: '설비 고장을 미리 예측 · 무선 진동센서와 모터 예지보전까지', href: '/use-cases/predictive-maintenance' },
  { label: '전력관리', desc: '전력 데이터로 피크 · 이상 · 절감 기회를 찾는 에너지 AI', href: '/use-cases/power-management' },
  { label: '품질 예측', desc: '공정 데이터로 불량을 사전에 잡는 제조 AI', href: '/use-cases/quality-prediction' },
  { label: '에너지관리시스템(EMS)', desc: 'EMS·전력관리·전력감시·정전감시 개념 한눈에', href: '/energy-management' },
];
---
<BaseLayout
  title="산업 AI란? 제조·에너지 현장의 AI 에이전트 | Refinery"
  description="산업 AI·제조 AI·에너지 AI·산업 AI 에이전트가 무엇인지, 흩어진 현장 데이터를 어떻게 판단으로 잇는지 정리했습니다. Refinery는 온톨로지로 근거 있는 AI 판단을 제공합니다."
  canonical="/industrial-ai"
  jsonLd={faqSchema}
>
  <Nav />
  <main class="ind ind-page">
    <!-- HERO -->
    <section class="ind-hero">
      <div class="ind-container">
        <h1>흩어진 현장의 데이터를<br>근거 있는 판단으로 잇는 산업 AI</h1>
        <div class="ind-hero-actions">
          <a href="/contact" class="ind-btn-primary">문의하기</a>
          <a href="/why-refinery" class="ind-btn-ghost">플랫폼 개요</a>
        </div>

        {/* TODO(자리표시): 그래픽 이미지가 들어갈 자리. 실제 이미지가 준비되면
            이 div를 <img>로 바꾼다 — WebP로 커밋하고, 표시 크기로 리사이즈하고,
            CLS 방지를 위해 width/height를 지정한다. 히어로 최상단이므로 lazy는 붙이지 않는다. */}
        <div class="ai-hero-figure" role="img" aria-label="그래픽 이미지 자리">
          <span>그래픽 이미지 자리</span>
          <span class="ai-hero-figure-size">1184 × 444 · 16:6</span>
        </div>
      </div>
    </section>

    <!-- 정의형 Q&A -->
    <section class="ind-section">
      <div class="ind-container">
        <div class="qa-head">
        <header class="ind-head">
          <h2>자주 묻는 질문</h2>
        </header>
        {/* 아코디언은 <details>로 만든다. JS 없이 열리고 닫히며 키보드로도 조작되고,
            무엇보다 답변 글이 접힌 상태에서도 HTML에 그대로 남는다 —
            이 페이지는 검색·답변엔진에 읽히는 것이 목적이라 그 점이 중요하다.
            첫 항목만 열어 둬 어떻게 쓰는 것인지 바로 보이게 한다.

            name을 같이 주면 한 번에 하나만 열린다(브라우저 기본 동작, JS 불필요).
            이 속성을 모르는 옛 브라우저에서는 여러 개가 함께 열릴 뿐 깨지지 않는다. */}
        <div class="qa-list">
          {faqItems.map((f, i) => (
            <details class="qa-item" name="qa" open={i === 0}>
              <summary>
                <h3>{f.q}</h3>
                <i class="ph ph-caret-down qa-caret" aria-hidden="true"></i>
              </summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
        </div>
      </div>
    </section>

    <!-- 관련 활용 -->
    <section class="ind-section ind-soft">
      <div class="ind-container">
        <header class="ind-head">
          <h2>현장에서 바로 쓰는 활용</h2>
          <p>산업 AI가 실제 현장에서 어떻게 쓰이는지 살펴보세요.</p>
        </header>
        <div class="ind-grid ind-grid-4">
          {uses.map((u) => (
            <a class="ind-card" href={u.href}><h3>{u.label}</h3><p>{u.desc}</p><span class="ind-card-go">자세히보기</span></a>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="ind-cta ai-cta-bg">
      <img class="ai-cta-bg-img" src="/use-cases/cta-bg.webp" alt="" aria-hidden="true" loading="lazy" decoding="async" width="1920" height="1080" />
      <div class="ind-container">
        <h2>지금 바로<br>Refinery를 경험해보세요.</h2>
        <a href="/contact" class="ind-btn-primary ind-btn-lg">문의하기</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  /* 블록 폭을 컨테이너 하나로 맞춘다. 전에는 Q&A만 760px이라 구분선이 화면 중간에서
     끊기고, 아래 카드 그리드(1072px)와 오른쪽 끝이 어긋나 페이지가 두 축으로 보였다.
     글줄이 길어지는 것은 문단에만 읽기 폭(72ch)을 걸어 막는다 — 제목과 구분선은
     전체 폭을 쓰고 본문만 짧게 끊긴다. */
  /* 제목 왼쪽 · 문답 오른쪽으로 나눈다 — 예지보전 자주 묻는 질문(.uc-faq-head)과 같은 값.
     오른쪽 칸이 답변 줄 길이를 잡아 주므로 문단에 폭 제한을 따로 걸지 않는다. */
  .qa-head { display: grid; grid-template-columns: 1fr 2fr; gap: 64px; align-items: start; }
  .qa-head .ind-head { max-width: none; margin-bottom: 0; }
  @media (max-width: 900px) { .qa-head { grid-template-columns: 1fr; gap: 24px; } }

  /* 목록 위아래는 같은 색(ink-200)에 2px으로 묶고, 항목 사이는 1px으로 나눈다.
     색은 하나로 두고 굵기만 달리해 문답 여덟 개가 한 덩어리로 읽힌다. */
  .qa-list { max-width: none; border-top: 2px solid #E3E7EC; border-bottom: 2px solid #E3E7EC; }
  .qa-item { border-bottom: 1px solid #E3E7EC; }
  .qa-item:last-child { border-bottom: none; }

  /* 기본 삼각형 표식을 지우고 제목과 캐럿을 양 끝으로 벌린다. */
  .qa-item summary {
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    padding: 20px 0; cursor: pointer; list-style: none;
  }
  .qa-item summary::-webkit-details-marker { display: none; }
  /* 질문·답변·캐럿 값은 예지보전 '자주 묻는 질문'(.uc-faq-*)과 같다.
     질문은 h3다 — 섹션 제목(h2) 아래 항목이라 한 단 내려온다. */
  .qa-item h3 {
    font-size: 20px; font-weight: 600; letter-spacing: normal;
    line-height: 1.65; color: #16202C; margin: 0;
  }
  .qa-caret {
    flex: 0 0 auto; font-size: 14px; color: #8A94A3;
    transition: transform .2s ease;
  }
  .qa-item[open] .qa-caret { transform: rotate(180deg); }
  .qa-item p {
    font-size: 15px; line-height: 1.5; color: #7E8A98;
    margin: 0; padding: 0 0 24px;
  }
  /* 키보드로 짚었을 때 어디에 있는지 보이게 한다. */
  .qa-item summary:focus-visible { outline: 2px solid #76A6D7; outline-offset: 4px; border-radius: 4px; }
  /* 히어로를 자료실(.res-page .ind-hero)과 같은 값으로 맞춘다.
     면과 아래 구분선을 빼 다음 섹션과 한 흐름으로 잇고, 아래 여백은 0으로 둔다 —
     제목과 본문 사이는 섹션 위 여백이 잡는다. */
  .ind-hero {
    padding: 180px 0 0;
    background: none;
    border-bottom: none;
    text-align: center;
  }
  .ind-hero h1 {
    font-size: clamp(30px, 4.2vw, 48px);
    font-weight: 600;
    letter-spacing: -0.8px;
    line-height: 1.3;
  }
  @media (max-width: 900px) { .ind-hero { padding: 120px 0 0; } }
  /* 히어로 버튼 — 예지보전 히어로와 같은 형태다(9px 22px · 15px/400 · 반경 6px ·
     테두리 1px · 묶음 margin-top 48px · gap 16px).
     색은 그 페이지의 '밝은 배경용' 규칙을 따른다. 거기 히어로는 어두운 사진 위라
     보조 버튼이 흰 테두리인데, 이 히어로는 밝은 면이라 그대로 쓰면 보이지 않는다.
     주 버튼만 같은 accent 면(#76A6D7)을 유지해 시선이 먼저 닿는 자리를 지킨다. */
  .ind-hero-actions { margin-top: 48px; gap: 16px; justify-content: center; }
  .ind-hero-actions .ind-btn-primary,
  .ind-hero-actions .ind-btn-ghost {
    padding: 9px 22px; font-size: 15px; font-weight: 400;
    border-radius: 6px; border: 1px solid; transition: all .2s;
  }
  .ind-hero-actions .ind-btn-primary {
    background: #76A6D7; color: #fff; border-color: #76A6D7;
  }
  .ind-hero-actions .ind-btn-primary:hover {
    background: #5A8FC5; border-color: #5A8FC5; color: #fff; transform: none;
  }
  .ind-hero-actions .ind-btn-ghost {
    background: transparent; color: #111111; border-color: rgba(17, 17, 17, .6);
  }
  .ind-hero-actions .ind-btn-ghost:hover {
    background: #111111; border-color: #111111; color: #fff;
  }

  /* 그래픽 이미지 자리표시 — 실제 이미지로 교체할 자리다.
     비율(16:6)만 잡아 두면 이미지가 들어와도 아래 섹션이 밀리지 않는다. */
  .ai-hero-figure {
    margin-top: 64px;
    aspect-ratio: 16 / 6;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 6px;
    background: var(--ink-50, #F6F8FA);
    border: 1px dashed var(--ink-300, #C8CED5);
    border-radius: 14px;
    color: var(--ink-400, #A4ADB8);
    font-size: 15px;
  }
  .ai-hero-figure-size { font-size: 13px; color: var(--ink-300, #C8CED5); }

  /* CTA — 예지보전(.uc-cta-bg)과 같은 모습. 그 규칙은 UseCasePage.astro의 스코프
     스타일이라 클래스를 붙여도 여기까지 오지 않는다. 같은 값을 옮겨 적는다.
     사진은 그 페이지가 쓰는 것을 그대로 쓴다(/use-cases/cta-bg.webp). */
  .ind-cta.ai-cta-bg {
    position: relative; overflow: hidden;
    background: #0C1015; padding: 95px 0; text-align: left;
  }
  /* 사진이 납작해 폭이 줄면 object-fit이 세로까지 줄인다.
     min-width로 배율을 묶고 모자란 가로는 좌우 균등하게 잘리게 한다. */
  .ai-cta-bg-img {
    position: absolute; top: 0; left: 50%; transform: translateX(-50%);
    width: 100%; min-width: 1440px; height: 100%;
    object-fit: cover; object-position: center 65%;
    pointer-events: none; user-select: none;
  }
  /* 제목 왼쪽 · 버튼 오른쪽으로 한 줄에 나눈다. */
  .ai-cta-bg .ind-container {
    position: relative; z-index: 1;
    display: flex; align-items: center; justify-content: space-between;
    gap: 48px; flex-wrap: wrap;
  }
  .ai-cta-bg .ind-container > * { flex: none; }
  .ind-cta.ai-cta-bg h2 {
    font-size: clamp(26px, 3.6vw, 40px); font-weight: 500;
    letter-spacing: -0.8px; line-height: 1.35; color: #fff;
    margin-bottom: 0; text-wrap: initial;
  }
  .ind-cta.ai-cta-bg .ind-btn-primary {
    margin-top: 0; padding: 9px 22px;
    font-size: 15px; font-weight: 400;
    background: #76A6D7; color: #fff;
    border: 1px solid #76A6D7; border-radius: 6px;
    transition: all .2s;
  }
  .ind-cta.ai-cta-bg .ind-btn-primary:hover {
    background: #5A8FC5; border-color: #5A8FC5; color: #fff; transform: none;
  }
  /* 좁은 폭에서는 여백을 줄인다(사이트 공통 84 → 60px 규칙과 같은 값). */
  @media (max-width: 560px) { .ind-cta.ai-cta-bg { padding: 60px 0; } }

  /* 활용 카드는 4열 한 줄이다 — 항목이 정확히 4개라 3열이면 마지막 줄에 빈칸이 둘 남는다.
     (.ind-grid-4는 1100px에서 2열, 860px에서 1열로 접힌다 — 공통 규칙 그대로.)
     안 여백 24px은 다른 .ind-page 카드와 같은 값이다. 공통 .ind-card의 26px을 덮는데,
     그 24px 규칙이 .ind-grid-3에만 걸려 있어 4열로 오면서 빠졌다. */
  .ind-grid-4 .ind-card { padding: 24px; }

  /* 브랜드 하늘색 하나로 통일한다 — 밝은 배경용 #4B86BF를 따로 두지 않는다. */
  .ind-card-go { display: inline-block; margin-top: 12px; font-size: 14px; font-weight: 400; color: #76A6D7; }
  a.ind-card { text-decoration: none; }
</style>
