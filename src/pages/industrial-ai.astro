---
// 산업 AI 개념 필러 페이지 — AEO(답변엔진 최적화)용.
// 산업 AI·제조 AI·에너지 AI·산업 AI 에이전트·AI 시스템을 정의형 Q&A로 답하고 FAQPage 스키마로도 출력한다.
// 모든 답변은 실제 사실(온톨로지·온프레미스·30년/100+ 현장·기존 위 통합)만 쓴다. 창작 수치 금지.
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/industry.css';

// 본문 Q&A와 FAQPage 스키마는 같은 배열에서 나온다(항상 동기화).
const faqItems = [
  {
    q: '산업 AI란 무엇인가요?',
    a: '산업 AI는 제조 · 에너지 · 플랜트 등 산업 현장의 설비 · 공정 · 센서 데이터를 수집 · 통합 · 분석해 \n판단과 조치를 돕는 인공지능입니다. 범용 챗봇과 달리 실제 현장 데이터와 도메인 맥락에 근거해 답합니다.',
  },
  {
    q: '제조 AI란 무엇인가요?',
    a: '제조 AI는 생산 · 품질 · 설비 운영에 적용되는 산업 AI입니다. 대표적인 활용은 설비 고장을 미리 예측하는 \n예지보전, 불량을 사전에 잡는 품질 예측, 에너지 사용을 줄이는 에너지 최적화입니다.',
  },
  {
    q: '제조업 AI란 무엇인가요?',
    a: '제조업 AI는 생산 · 품질 · 설비 · 에너지 운영에 인공지능을 적용해 예측과 자동화를 돕는 기술로, \n제조 AI와 같은 의미로 쓰입니다. 흩어진 현장 데이터를 통합해 근거 있는 판단을 만드는 것이 핵심입니다.',
  },
  {
    q: '스마트팩토리 AI란 무엇인가요?',
    a: '스마트팩토리 AI는 공장의 설비 · 공정 · 품질 · 에너지 데이터를 하나로 연결해 스스로 감지 · 예측 · 최적화하는 \n지능형 공장을 만드는 AI입니다. 단순 자동화를 넘어 데이터에 근거해 판단하고 다음 조치를 제안합니다.',
  },
  {
    q: '에너지 AI란 무엇인가요?',
    a: '에너지 AI는 전력 · 에너지 데이터를 분석해 소비 · 품질 · 효율을 관리하는 산업 AI입니다. \n에너지관리시스템(EMS)과 결합해 전력 피크와 이상을 감지하고 절감 기회를 찾습니다.',
  },
  {
    q: '산업 AI 에이전트란 무엇인가요?',
    a: '산업 AI 에이전트는 질문에 근거(출처)를 들어 답하고, 원인을 추론해 다음 조치까지 제안하는 대화형 AI입니다. \nRefinery는 흩어진 데이터를 온톨로지로 엮어 의미를 부여함으로써 이를 구현합니다.',
  },
  {
    q: 'AI 시스템을 도입하려면 무엇이 필요한가요?',
    a: '먼저 SCADA · MES · ERP · 센서 · 문서에 흩어진 데이터를 하나로 통합해야 합니다. \nRefinery는 기존 시스템 위에 통합 지능 레이어로 얹거나, 시스템이 없는 현장은 새로 구축해 \n데이터에 의미를 부여하고 AI가 근거를 들어 판단하게 합니다.',
  },
  {
    q: 'Refinery의 산업 AI는 무엇이 다른가요?',
    a: 'Refinery는 흩어진 SCADA · MES · ERP · 센서 · 문서를 온톨로지로 엮어 근거 있는 판단을 만듭니다. \n기존 시스템 위에 얹거나 새로 구축하며, 데이터가 사내를 벗어나지 않는 온프레미스 배포를 지원합니다. \n30년 경험과 100곳이 넘는 산업 현장에서 검증됐습니다.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f) => ({
    '@type': 'Question',
    name: f.q,
    // 화면용 개행은 스키마에서 빼고 한 줄로 넘긴다.
    acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/\s*\n\s*/g, ' ') },
  })),
};

// 관련 활용 — 실제 존재하는 use-case 페이지로 내부 링크(키워드 앵커).
const uses = [
  { label: '예지보전', desc: '무선 진동센서로 설비 고장을 \n미리 예측하고 모터 예지보전까지', href: '/use-cases/predictive-maintenance' },
  { label: '전력관리', desc: '전력 데이터로 피크 · 이상 · \n절감 기회를 찾는 에너지 AI', href: '/use-cases/power-management' },
  { label: '품질 예측', desc: '공정 데이터로 불량을 \n사전에 잡는 제조 AI', href: '/use-cases/quality-prediction' },
  { label: '에너지관리시스템(EMS)', desc: 'EMS · 전력관리 · 전력감시 · \n정전감시 개념을 한눈에', href: '/energy-management' },
];
---
<BaseLayout
  title="산업 AI란? 제조·에너지 현장의 AI 에이전트 | Refinery"
  description="산업 AI·제조 AI·에너지 AI·산업 AI 에이전트가 무엇인지, 흩어진 현장 데이터를 어떻게 판단으로 잇는지 정리했습니다. Refinery는 온톨로지로 근거 있는 AI 판단을 제공합니다."
  canonical="/industrial-ai"
  jsonLd={faqSchema}
>
  <Nav />
  <main class="ind ind-page">
    <!-- HERO -->
    <section class="ind-hero">
      <div class="ind-container">
        <h1>흩어진 현장의 데이터를<br>근거 있는 판단으로 잇는 산업 AI</h1>
        <div class="ind-hero-actions">
          <a href="/contact" class="ind-btn-primary">문의하기</a>
          <a href="/why-refinery" class="ind-btn-ghost">플랫폼 개요</a>
        </div>

        <div class="ai-hero-figure">
          {/* 클릭 레이어. iframe의 pointer-events를 열면 사용자가 데모 내부 UI를
              조작하게 되므로, 칸 위에 투명 버튼을 덮고 postMessage로만 제어한다. */}
          <button type="button" id="ai-demo-toggle" class="ai-demo-toggle" aria-label="데모 재생 / 일시정지" aria-pressed="false">
            <span class="ai-demo-toggle-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor" width="26" height="26"><path d="M8 5v14l11-7z"/></svg>
            </span>
          </button>
          <iframe id="ai-demo-iframe" data-src="/agent-replay-demo" loading="lazy" scrolling="no" tabindex="-1" title="Refinery AI 에이전트 데모" style="display:block;border:none;position:absolute;top:0;left:0;transform-origin:top left;pointer-events:none;"></iframe>
        </div>
      </div>
    </section>

    <!-- 정의형 Q&A -->
    <section class="ind-section">
      <div class="ind-container">
        <div class="qa-head">
        <header class="ind-head">
          <h2>자주 묻는 질문</h2>
        </header>
        {/* 아코디언은 <details>로 만든다. JS 없이 열리고 닫히며 키보드로도 조작되고,
            무엇보다 답변 글이 접힌 상태에서도 HTML에 그대로 남는다 —
            이 페이지는 검색·답변엔진에 읽히는 것이 목적이라 그 점이 중요하다.
            첫 항목만 열어 둬 어떻게 쓰는 것인지 바로 보이게 한다.

            name을 같이 주면 한 번에 하나만 열린다(브라우저 기본 동작, JS 불필요).
            이 속성을 모르는 옛 브라우저에서는 여러 개가 함께 열릴 뿐 깨지지 않는다. */}
        <div class="qa-list">
          {faqItems.map((f, i) => (
            <details class="qa-item" name="qa" open={i === 0}>
              <summary>
                <h3>{f.q}</h3>
                <i class="ph ph-caret-down qa-caret" aria-hidden="true"></i>
              </summary>
              {/* 개행은 <br>로 낸다. 좁은 폭에서는 CSS가 br을 숨겨 단락을 푼다. */}
              <p>{f.a.split('\n').map((l, i) => (<>{i > 0 && <br />}{l}</>))}</p>
            </details>
          ))}
        </div>
        </div>
      </div>
    </section>

    <!-- 관련 활용 -->
    <section class="ind-section ind-soft">
      <div class="ind-container">
        <header class="ind-head">
          <h2>현장에서 바로 쓰는 활용</h2>
          <p>산업 AI가 실제 현장에서 어떻게 쓰이는지 살펴보세요.</p>
        </header>
        <div class="ind-grid ind-grid-4">
          {uses.map((u) => (
            <a class="ind-card" href={u.href}>
              <h3>{u.label}</h3>
              {/* 개행은 <br>로 낸다. 좁은 폭에서는 CSS가 br을 숨겨 단락을 푼다. */}
              <p>{u.desc.split('\n').map((l, i) => (<>{i > 0 && <br />}{l}</>))}</p>
              <span class="ind-card-go">자세히보기</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="ind-cta ai-cta-bg">
      <img class="ai-cta-bg-img" src="/use-cases/cta-bg.webp" alt="" aria-hidden="true" loading="lazy" decoding="async" width="1920" height="1080" />
      <div class="ind-container">
        <h2>지금 바로<br>Refinery를 경험해보세요.</h2>
        <a href="/contact" class="ind-btn-primary ind-btn-lg">문의하기</a>
      </div>
    </section>
  </main>

  <script is:inline>
    /* 히어로 아래 에이전트 데모. 랜딩(index.astro)의 같은 스크립트와 짝이지만
       ID가 달라 섞이지 않는다. 공용 컴포넌트로 뽑는 건 랜딩 히어로까지 건드리는
       일이라 여기서는 이 페이지에 필요한 만큼만 둔다. */
    (function () {
      /* 무대는 1320x840 고정이고 K = min(폭/1320, 높이/840)로 줄어든다.
         높이를 비율보다 2px 크게 잡아 K가 폭에서 정해지게 하면 무대가 폭을 정확히 채운다.
         (높이 쪽이 먼저 걸리면 좌우에 데모 페이지 배경 #E9ECEF가 남는다.) */
      var STAGE_W = 1320, STAGE_H = 840;
      var FRAME_W = 1440;
      var FRAME_H = Math.ceil(FRAME_W * STAGE_H / STAGE_W) + 2;
      /* 데모가 강조 중인 범위(무대 좌표). 없으면 전체를 보여주는 상태다. */
      var focusBox = null;
      /* 최대 확대. 넘기면 글씨가 과하게 커지고 화면이 튄다. */
      var MAX_ZOOM = 1.9;

      function render(animate) {
        var box = document.querySelector('.ai-hero-figure');
        var frame = document.getElementById('ai-demo-iframe');
        if (!box || !frame) return;
        var bw = box.offsetWidth, bh = box.offsetHeight;
        var stageToFrame = FRAME_W / STAGE_W;

        /* 기본 상태: 폭에 맞춰 전체를 담고 세로 자투리는 가운데를 기준으로 잘라 낸다. */
        var base = bw / FRAME_W;
        var s = base, cx = FRAME_W / 2, cy = FRAME_H / 2;

        if (focusBox) {
          /* 강조 범위를 여백과 함께 화면에 채운다. */
          var PAD = 28 * stageToFrame;
          var fx = focusBox.x * stageToFrame - PAD;
          var fy = focusBox.y * stageToFrame - PAD;
          var fw = focusBox.w * stageToFrame + PAD * 2;
          var fh = focusBox.h * stageToFrame + PAD * 2;
          s = Math.min(bw / fw, bh / fh);
          s = Math.max(base, Math.min(s, base * MAX_ZOOM));
          cx = fx + fw / 2; cy = fy + fh / 2;
        }

        /* 강조 범위 가운데를 칸 가운데로 당긴다. */
        var tx = bw / 2 - cx * s;
        var ty = bh / 2 - cy * s;
        /* 화면 밖으로 밀려 데모 페이지 배경이 보이지 않도록 가둔다. */
        tx = Math.min(0, Math.max(tx, bw - FRAME_W * s));
        ty = Math.min(0, Math.max(ty, bh - FRAME_H * s));
        /* 확대해도 세로가 칸보다 짧으면 가운데에 둔다(기본 상태가 그렇다). */
        if (FRAME_H * s < bh) ty = (bh - FRAME_H * s) / 2;

        frame.style.width = FRAME_W + 'px';
        frame.style.height = FRAME_H + 'px';
        frame.style.left = '0px';
        frame.style.top = '0px';
        frame.style.transition = animate ? 'transform .7s cubic-bezier(.22,.61,.36,1)' : 'none';
        frame.style.transform = 'translate(' + tx + 'px, ' + ty + 'px) scale(' + s + ')';
      }

      function resize() { render(false); }

      /* 데모가 알려주는 강조 범위를 따라 화면을 옮긴다. 랜딩과 달리 이 페이지는
         전체를 멀리서 보여주는 대신 지금 설명 중인 곳으로 당겨서 보여준다. */
      function initFocus() {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        window.addEventListener('message', function (e) {
          if (!e.data || e.data.type !== 'refinery-hero-focus') return;
          focusBox = e.data.box || null;
          render(true);
        });
      }

      /* 클릭으로 재생/일시정지. 상태는 데모가 refinery-hero-state로 돌려준다. */
      function initToggle() {
        var btn = document.getElementById('ai-demo-toggle');
        var frame = document.getElementById('ai-demo-iframe');
        if (!btn || !frame) return;
        btn.addEventListener('click', function () {
          if (!frame.getAttribute('src')) return;   /* 아직 안 불러왔으면 무시 */
          try { frame.contentWindow.postMessage({ type: 'refinery-hero-toggle' }, '*'); } catch (e) {}
        });
        window.addEventListener('message', function (e) {
          if (!e.data || e.data.type !== 'refinery-hero-state') return;
          btn.classList.toggle('is-paused', !!e.data.paused);
          btn.setAttribute('aria-pressed', e.data.paused ? 'true' : 'false');
        });
      }

      /* 성능: 무거운 데모 iframe은 페이지가 인터랙티브해진 뒤에 불러온다. */
      function load() {
        var f = document.getElementById('ai-demo-iframe');
        if (f && !f.src && f.getAttribute('data-src')) {
          f.addEventListener('load', function () {
            /* 따라가기 모드를 켜 캡션 카드가 강조 상자 위아래로 붙게 한다.
               옆에 붙으면 범위가 가로로 넓어져 확대가 거의 되지 않는다. */
            try { f.contentWindow.postMessage({ type: 'refinery-hero-follow' }, '*'); } catch (e) {}
            resize();
          });
          f.src = f.getAttribute('data-src');
        }
      }

      window.addEventListener('load', function () { initToggle(); initFocus(); resize(); load(); });
      window.addEventListener('resize', resize);
      document.addEventListener('DOMContentLoaded', resize);
    })();
  </script>
  <Footer />
</BaseLayout>

<style>
  /* 블록 폭을 컨테이너 하나로 맞춘다. 전에는 Q&A만 760px이라 구분선이 화면 중간에서
     끊기고, 아래 카드 그리드(1072px)와 오른쪽 끝이 어긋나 페이지가 두 축으로 보였다.
     글줄이 길어지는 것은 문단에만 읽기 폭(72ch)을 걸어 막는다 — 제목과 구분선은
     전체 폭을 쓰고 본문만 짧게 끊긴다. */
  /* 제목 왼쪽 · 문답 오른쪽으로 나눈다 — 예지보전 자주 묻는 질문(.uc-faq-head)과 같은 값.
     오른쪽 칸이 답변 줄 길이를 잡아 주므로 문단에 폭 제한을 따로 걸지 않는다. */
  .qa-head { display: grid; grid-template-columns: 1fr 2fr; gap: 64px; align-items: start; }
  .qa-head .ind-head { max-width: none; margin-bottom: 0; }
  @media (max-width: 900px) { .qa-head { grid-template-columns: 1fr; gap: 24px; } }

  /* 가로선은 항목 사이에만 긋는다 — 목록 위·아래 끝에는 두지 않는다(예지보전과 같다). */
  .qa-list { max-width: none; }
  .qa-item { border-bottom: 1px solid #E3E7EC; }
  .qa-item:last-child { border-bottom: none; }

  /* 기본 삼각형 표식을 지우고 제목과 캐럿을 양 끝으로 벌린다. */
  .qa-item summary {
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    padding: 20px 0; cursor: pointer; list-style: none;
  }
  .qa-item summary::-webkit-details-marker { display: none; }
  /* 질문·답변·캐럿 값은 예지보전 '자주 묻는 질문'(.uc-faq-*)과 같다.
     질문은 h3다 — 섹션 제목(h2) 아래 항목이라 한 단 내려온다. */
  .qa-item h3 {
    font-size: 20px; font-weight: 600; letter-spacing: normal;
    line-height: 1.65; color: #16202C; margin: 0;
  }
  .qa-caret {
    flex: 0 0 auto; font-size: 14px; color: #8A94A3;
    transition: transform .2s ease;
  }
  .qa-item[open] .qa-caret { transform: rotate(180deg); }
  /* 답변 칸이 747px일 때(창 1280px 이상) 맞춘 단락이라, 칸이 좁아지면 푼다.
     개행 앞에 공백을 둬 br이 사라져도 앞뒤 어절이 붙지 않는다.
     어절 중간에서 끊기지 않는 것은 .ind-page의 word-break: keep-all이 맡는다. */
  @media (max-width: 1279px) { .qa-item p br { display: none; } }
  .qa-item p {
    font-size: 15px; line-height: 1.5; color: #7E8A98;
    margin: 0; padding: 0 0 24px;
  }
