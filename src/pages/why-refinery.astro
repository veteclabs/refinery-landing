  .wr-value h3 { font-size: 20px; font-weight: 600; letter-spacing: -0.01em; line-height: 1.6; margin: 0 0 5px; }
  .wr-value p { font-size: 15px; line-height: 1.5; margin: 0; color: #47535f; }

  /* 셋을 한 줄에 카드로 둔다. 카드 위에는 이미지 자리를 비워 놓았다. */
  .wr-stories { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
  /* .ind-card의 안여백(26px)을 풀고 이미지가 카드 폭을 꽉 채우게 한다.
     안여백은 아래 .wr-story-body가 맡는다. */
  .wr-page .wr-story { padding: 0; overflow: hidden; display: flex; flex-direction: column; }
  /* 일러스트가 1920x1080(16:9)이라 칸도 같은 비율로 둔다 — 잘리거나 남는 곳이 없다.
     아래끝은 랜딩 보안 섹션 카드(.sec-card-img::after)와 같은 방식으로 흰색으로
     녹인다 — 구분선 대신 그라데이션이 이미지와 글을 잇는다. */
  .wr-story-media {
    aspect-ratio: 16 / 9; background: #fff;
    position: relative; overflow: hidden;
  }
  /* 그림이 화판(1920x1080) 가운데 가로 14~88% · 세로 18~82%에만 있고 바깥은
     옅은 격자 무늬다. 130%로 잡아 그 여백을 칸 밖으로 밀어내면 그림만 커진다.
     transform: scale()로 키우면 안 된다 — 레이아웃 크기로 한 번 그린 뒤 그 결과를
     늘리는 방식이라 흐려진다. 크기 자체를 키워야 그 크기로 다시 그려 선명하다.
     (SVG 자체는 벡터라 크기와 무관하게 깨지지 않는다) */
  .wr-story-media img {
    display: block; position: absolute; top: -15%; left: -15%;
    /* 전역 img{max-width:100%}가 130%를 칸 폭으로 잘라낸다 — 풀어준다. */
    max-width: none; width: 130%; height: 130%; object-fit: cover;
  }
  .wr-story-media::after {
    content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 20px;
    background: linear-gradient(to bottom, transparent 0%, rgba(255,255,255,.6) 50%, #fff 100%);
    pointer-events: none;
  }
  .wr-story-body { padding: 20px 24px 24px; }
  /* 랜딩 플랫폼 섹션 태그라인(.teams-preview-tagline)과 같은 값. */
  .wr-story-eyebrow {
    font-size: 12px; font-weight: 600; letter-spacing: 1.2px;
    color: var(--accent); margin-bottom: 8px;
  }
  /* 랜딩 보안 섹션 카드(.sec-card-body)와 같은 값 —
     안여백 20px 24px 24px, 제목 16px/700/1.4, 본문 14px/1.6. */
  .wr-story h3 { font-size: 16px; font-weight: 700; line-height: 1.4; margin: 0 0 6px; }
  .wr-story ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .wr-story li { position: relative; padding-left: 8px; font-size: 14px; line-height: 1.6; color: var(--text-muted); }
  /* 표식 색을 카드의 강조색(태그라인·아이콘)과 같은 하늘색으로 모은다.
     회색 #B7C1CC은 본문 글자색(#7E8A98)보다 밝아 표식이 글보다 먼저 흐려졌다.
     색이 진해진 만큼 6 → 4px으로 줄여 튀지 않게 한다. */
  /* 점 3px, 점과 글 사이 4px. 14px 본문에서 띄어쓰기 한 칸이 3.5px이라 딱 한 칸이다.
     이전(점 4px · 사이 11px)은 세 칸이 넘어 글이 점에서 떨어져 보였다. */
  .wr-story li::before { content: ''; position: absolute; left: 1px; top: 10px; width: 3px; height: 3px; border-radius: 50%; background: var(--accent); }

  /* 기능 — 주제별 그룹 리스트(박스 그리드 제거) */
  /* 예지보전 '푸는 방식' 카드(.uc-redesigned .ind-card)와 같은 형태·글자값.
     제목 아래 밑줄만 있던 목록을 카드로 감쌌다.
     hover 효과는 넣지 않는다 — 링크가 아닌 카드라 누를 수 있다는 신호를 주지 않는다. */
  .wr-caps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; }
  .wr-page .wr-cap-group { padding: 24px; }
  /* 아이콘과 제목을 한 줄에 나란히 둔다(예지보전은 아이콘을 위에 띄우고 제목을
     아래에 모으지만, 여기는 아래에 항목 칸이 여러 줄 붙어 그 구성이 헐거워진다).
     박스 30x30 · 라운드 8px, 글리프 17px. 제목(20px) 옆에 붙는 표식이라
     제목보다 크지 않게 잡았다. */
  /* 제목 묶음과 항목 사이를 선으로 나눈다. 항목 칸이 회색 면이라
     선이 없으면 제목과 첫 줄이 붙어 보인다.
     선은 카드 가로 끝까지 간다 — 카드 안여백(24px)만큼 좌우로 빼내고
     같은 값을 안여백으로 돌려줘 글자 위치는 그대로 둔다. */
  .wr-cap-head {
    display: flex; align-items: center; gap: 10px;
    /* 카드 안여백(24px)만큼 위·좌·우로 빼내 면이 카드 끝과 위끝까지 닿게 하고,
       같은 값을 안여백으로 돌려줘 글자 위치는 그대로 둔다.
       위 모서리는 카드 라운드와 같은 값으로 깎는다. */
    margin: -24px -24px 0; padding: 16px 24px;
    /* 면을 비우고 굵기를 700으로 올리는 것만 랜딩 눌린 탭에서 가져왔다.
       제목 색은 기본 글자색 그대로다 — 하늘색은 아이콘에만 남긴다.
       아래 선은 카드 테두리(#E3E7EC)보다 한 단계 연한 #EFF2F5 —
       같은 색이면 카드가 둘로 잘린 것처럼 읽힌다. 머리와 몸통을 나누는 선은
       테두리보다 뒤로 물러나야 한다. */
    background: transparent;
    border-bottom: 1px solid #eff2f5;
  }
  .wr-cap-icon {
    display: inline-flex; align-items: center; justify-content: center;
    /* 탭에는 아이콘 박스가 없다 — 글자와 같은 색의 글리프만 둔다.
       제목(20px)보다 조금 크게 둬 표식으로 읽히게 했다. */
    flex: none; color: var(--accent);
  }
  .wr-cap-icon i { font-size: 24px; line-height: 1; }
  .wr-page .wr-cap-group h3 {
    font-size: 20px; font-weight: 700; letter-spacing: -0.01em; line-height: 1.6; margin: 0;
  }
  /* 항목을 작은 칸으로 둔다. flex-wrap이라 글자 수에 따라 한 줄에 두 개가 오기도 하고
     긴 항목은 혼자 한 줄을 쓴다 — 줄마다 개수를 정하지 않는다.
     칸 색은 '이어지는 흐름' 섹션과 같은 면(var(--bg-soft) #f6f8fa)이다. */
  .wr-cap-group ul {
    list-style: none; padding: 0; margin: 10px 0 0;
    display: flex; flex-wrap: wrap; gap: 8px;
  }
  .wr-cap-group ul { margin-top: 20px; }
  .wr-cap-group li {
    background: var(--bg-soft); border-radius: 8px;
    /* 랜딩 솔루션 섹션 카드 소제목(.industry-desc)과 같은 var(--text-muted) #7E8A98. */
    padding: 7px 12px; font-size: 15px; line-height: 1.4; color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .wr-values { grid-template-columns: 1fr; gap: 30px; }
    .wr-caps { grid-template-columns: repeat(2, 1fr); gap: 28px 24px; }
    .wr-stories { grid-template-columns: 1fr; gap: 24px; }
  }
  @media (max-width: 520px) {
    .wr-caps { grid-template-columns: 1fr; }
  }
