---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/industry.css';
import RfIcon from '../components/RfIcon.astro';

const SITE = 'https://refinery.kr';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: '왜 Refinery인가 | Refinery',
  url: `${SITE}/why-refinery`,
  isPartOf: { '@type': 'WebSite', name: 'Refinery', url: `${SITE}/` },
};

// '현장이 먼저입니다' 3장은 회사 소개의 '일하는 세 가지 기준'과 같은 말이었다.
// 일하는 방식은 회사 이야기이므로 /company 에 두고, 여기서는 한 줄로만 짚고 넘긴다.
// 이 페이지는 제품 본문(왜 운영체제인가 → 흐름 → 기능)에 집중한다.

// 기능 스토리 3 — 통합 / AI 에이전트 / 자동화
// CTA 배경 그래픽 — public/cta/why-refinery 아래 세 벌 중 하나를 고른다.
// 'torus'(와이어 토러스) · 'cube'(중첩 큐브) · 'dome'(등고 돔). 이름만 바꾸면 된다.
const ctaGraphic = 'dome';

const stories = [
  {
    flow: 'story-01', layers: ['arc', 'up0', 'up1', 'up2', 'nodes'],
    eyebrow: '통합',
    title: '흩어진 데이터가 하나의 지식으로',
    points: [
      'SCADA ⁠· MES ⁠· ERP를 한곳에 모읍니다.',
      '온톨로지로 어떤 데이터인지 의미를 부여합니다.',
      '숫자와 기록이 맥락을 얻어 판단에 쓰입니다.',
    ],
  },
  {
    flow: 'story-02', layers: ['arc', 'up0', 's0'],
    eyebrow: 'AI 에이전트',
    title: '물으면 답하는 현장',
    points: [
      '궁금한 점을 물어보면 데이터를 근거로 답합니다.',
      '원인을 추론하고 다음 조치까지 제안합니다.',
      '답변의 근거가 된 데이터 출처를 함께 제시합니다.',
    ],
  },
  {
    flow: 'story-03', layers: ['arc', 'up0', 'up1', 'up2', 's0', 's1', 's2'],
    eyebrow: '자동화',
    title: '사람 없이 돌아가는 운영',
    points: [
      '무엇을 자동으로 할지 대화로 정합니다.',
      '분석이 보고서 ⁠· 워크플로우 실행까지 이어집니다.',
      '반복 업무는 사람 손 없이 자동으로 처리됩니다.',
    ],
  },
];

// 왜 운영체제인가 — 연결부터 판단까지 네 개의 층. 아래 기능 카드와 같은 틀에 칩 대신 설명을 둔다.
// 아이콘은 기능 카드(capabilityGroups)와 겹치지 않게 골랐다.
/* 아이콘은 이 섹션만의 한 벌이다(src/icons/light/os-*.svg) — 호버하면
   도는 인라인 SVG 라 RfIcon 으로 넣는다. 기능 카드의 Phosphor 글꼴과는
   다른 것이니 섞지 말 것. */
const layers = [
  { title: '연결', icon: 'os-connect', desc: '설비 ⁠· 센서와 SCADA ⁠· MES ⁠· ERP를 <br>게이트웨이와 커넥터로 잇습니다. <br>쓰던 시스템은 그대로 둡니다.' },
  { title: '온톨로지', icon: 'os-ontology', desc: '설비 ⁠· 업무 ⁠· 문서를 하나의 모델로 정의합니다. <br>모든 앱과 AI 에이전트가 <br>이 모델 하나를 함께 씁니다.' },
  { title: '앱', icon: 'os-app', desc: '대시보드 ⁠· 분석 ⁠· 워크플로우가 같은 <br>모델 위에서 돌아갑니다. 새 앱이 더해져도 <br>데이터와 권한은 그대로 이어집니다.' },
  { title: 'AI 에이전트', icon: 'os-agent', desc: '사람이 묻고 AI가 근거를 들어 답합니다. <br>조치는 권한과 승인을 거쳐 실행되고, <br>한 건씩 기록으로 남습니다.' },
];

// 아이콘은 예지보전 '푸는 방식' 카드와 같은 Phosphor 폰트를 쓴다.
// 이 페이지 다른 곳에서 쓰는 것과 겹치지 않게 골랐다.
const capabilityGroups = [
  { title: '데이터', icon: 'cap-data', items: ['온톨로지', '통합 대시보드', '파이프라인', '시계열 분석', '문서 지식화', '기존 시스템 연동'] },
  { title: '지능', icon: 'cap-ai', items: ['AI 에이전트', '이상 감지', '알람', '예지보전', '품질 예측', '에너지 최적화'] },
  { title: '운영', icon: 'cap-ops', items: ['자동화', '워크플로우', '리포트 자동화', 'ESG 리포트'] },
  { title: '신뢰', icon: 'cap-trust', items: ['온프레미스 배포', '권한', '암호화'] },
];
---
<BaseLayout
  title="왜 Refinery인가 ⁠· 현장을 아는 팀이 만든 산업 AI 운영체제 | Refinery"
  description="흩어진 현장 데이터를 하나의 지식으로 잇고, AI가 근거를 들어 의사결정을 돕습니다. 기존 위에 얹거나 없으면 새로 구축해, 하나의 운영체제로 현장을 지능화합니다."
  canonical="/why-refinery"
  jsonLd={jsonLd}
>
  <Nav />
  {/* ind-page — 솔루션(산업별 · 과제별)과 같은 값을 쓰는 갈고리다. 섹션 여백 ·
      카드 · 머리글 · 솔루션 구조 카드가 이 클래스 아래에 정의돼 있다.
      ⚠️ ind-industry 는 달지 않는다 — 그쪽은 산업 상세 전용이다. */}
  <main class="ind ind-page wr-page">
    <!-- HERO -->
    {/* 히어로는 솔루션(산업별 · 과제별)과 같은 구성이다 — 밝은 면에 태그라인 ·
        대제목 · 소제목을 한 줄로 세우고, 그림은 글 뒤가 아니라 글 아래에 둔다.
        값은 전부 industry.css 의 .ind-hero-bg 계열이 쥔다.
        ⚠️ 히어로에는 버튼을 두지 않는다 — 솔루션과 같다. 전환은 페이지 맨 아래
           CTA 가 받는다(같은 /contact).
        ⚠️ 어두운 전면 배경과 우측 대시보드 장식은 걷었다. */}
    <section class="ind-hero ind-hero-bg">
      <div class="ind-container">
        <div class="ind-hero-row">
          <p class="ind-eyebrow">제품 소개</p>
          <h1>하나의 운영체제로<br />{' '}현장을 지능화합니다</h1>
          <p class="ind-lede">데이터 수집부터 온톨로지, AI 분석, 예측, 자동 실행까지{' '}흩어진 현장을 하나의 통합 지능으로 잇습니다.</p>
        </div>
      </div>
      <div class="ind-hero-figure">
        {/* 띠 안의 모습은 옛 히어로 그대로다 — 어두운 면 위에 대시보드를 옅게
            얹고, 왼쪽으로 갈수록 사라지는 가로 그라데이션과 아래쪽 흐림을 건다.
            자리값(칸 56% · 이미지 1180px · -140px · -205px · 불투명도 .3)도
            옛 히어로에서 그대로 가져왔다. */}
        <div class="wr-figure-face">
          {/* 바탕 사진도 옛 히어로 그대로다 — 랜딩 CTA(#cta)와 같은 파일이고,
              #191F27 면 위에 .9 로 얹는 것이 전부다(어두운 막을 따로 덮지
              않는다). 사진 자체의 결이 질감을 맡는다. 그 위에 대시보드가
              옅게 올라간다. */}
          <img class="wr-figure-bg" src="/img_login-bg.webp" alt="" aria-hidden="true"
               width="3840" height="2160" decoding="async" fetchpriority="high" />
          <div class="wr-hero-fx" aria-hidden="true">
            <div class="wr-hero-fx-inner">
              <img src="/why-refinery-dash.webp" alt="" width="2586" height="3512" decoding="async" />
            </div>
          </div>
        </div>
      </div>
    </section>
    <script is:inline>
      {/* 히어로 사진 넓히기 — 솔루션(IndustryPage)과 같은 스크립트다.
          스크롤을 내린 만큼 --grow 를 0 → 1 로 올려 사진이 화면 폭을 꽉 채우며
          모서리가 펴진다.
          ⚠️ 쓰는 값은 scrollY 다. 사진의 화면 안 위치로 재면 첫 화면에서 이미
             절반쯤 자란 상태로 뜬다 — '기본 모습에서 스크롤할 때' 가 아니다.
          ⚠️ 360px 을 다 내리면 꽉 찬다. 내비(70px)가 사진 윗변에 닿을 즈음이다.
          ⚠️ 동작 줄이기를 켠 사람에게는 손대지 않는다 — 기본 모습 그대로다. */}
      (function () {
        var fig = document.querySelector('.ind-hero-figure');
        if (!fig) return;
        if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var D = 360, last = -1, ticking = false;
        function upd() {
          var p = Math.min(1, Math.max(0, (window.scrollY || window.pageYOffset) / D));
          p = Math.round(p * 1000) / 1000;
          if (p === last) return;
          last = p;
          fig.style.setProperty('--grow', p);
        }
        function onScroll() {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(function () { ticking = false; upd(); });
        }
        addEventListener('scroll', onScroll, { passive: true });
        addEventListener('resize', onScroll, { passive: true });
        upd();
      })();
    </script>


    <!-- WHY AN OS -->
    {/* ⚠️ wr-os 는 아래 등장 모션이 이 섹션의 머리만 집어내려고 쓰는 고리다.
        .wr-head-row 는 03 기능 섹션의 머리도 같이 달고 있어 그것만으로는
        둘이 함께 걸린다. */}
    <section class="ind-section wr-os">
      <div class="ind-container">
        <header class="ind-head wr-head-row">
          {/* 섹션 번호 — 산업별 페이지(.ind-sec-label, 과제 01 · 유즈케이스 02)와
              같은 배지다. 여기서는 본문 세 섹션이 01 · 02 · 03 을 이룬다. */}
          <span class="ind-sec-label">01</span>
          {/* ⚠️ 물음('왜 운영체제인가')이 아니라 이름씨다. 아래 두 섹션 제목
              ('이어지는 흐름' · '담긴 기능')과 꼴을 맞췄고, 아래 카드 넷이
              곧 그 '네 개의 층'이라 제목과 내용이 어긋나지 않는다. */}
          <h2>운영체제를 이루는 네 개의 층</h2>
          {/* ⚠️ 소제목은 화면에 내지 않는다 — 산업별 페이지와 같은 처리다.
              제목 오른쪽에 18px 한 줄만 떠 있어 머리글이 두 덩어리로 읽혔다. */}
        </header>
        {/* 카드는 회사 소개 '일하는 세 가지 기준'(.cmp-rule-card)과 같은 것이다 —
            옅은 면 · 두 겹 그림자 · 왼쪽 위 번호 배지 · 가운데 정렬 · 큰 아이콘.
            ⚠️ 저쪽은 카드가 셋이고 여기는 넷이다. 칸 수만 다르다. */}
        <div class="wr-layers">
        {/* ⚠️ rf-ic-host 를 카드에 함께 준다 — 아이콘 모션은 조상에 이 클래스가
            있을 때만 돈다. 빠뜨리면 영영 0% 자세로 서 있다.
            회사 소개 기준 카드(.cmp-rule-card)와 같은 처리다. */}
          {layers.map((l, i) => (
            <div class="wr-layer rf-ic-host">
              {/* ⚠️ 숫자를 한 겹 더 감싼다 — 가운데 정렬은 이 안쪽 span 의
                  transform 이 한다(아래 .wr-layer-num-d). 벗기지 말 것. */}
              <span class="wr-layer-num"><span class="wr-layer-num-d">{i + 1}</span></span>
              {/* 그래픽 — 160x160 이다(회사 소개 기준 카드와 같은 값).
                  이 섹션은 밝은 면(--bg-soft)이라 light 세트를 쓴다. */}
              <RfIcon name={l.icon} theme="light" class="wr-layer-fig" />
              <h3>{l.title}</h3>
              {/* ⚠️ set:html 이라야 desc 안의 <br> 가 태그로 들어간다. 그냥
                  {l.desc} 로 두면 글자 그대로 찍힌다. */}
              <p set:html={l.desc}></p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* 섹션 카드가 하나씩 떠오르는 등장 모션. 과제별 '읽는 데이터와 신호'
        섹션(.uc-signal)과 같은 값이다 — 16px 아래에서 올라오고, 0.55s
        cubic-bezier(.2,.7,.2,1), 한 줄에 놓인 형제끼리 차례로 늦춘다.
        화면 아래 12% 에 걸린 것은 두고 그 위로 올라온 것부터 켜는 것도 같다.
        ⚠️ 공용 ScrollReveal 을 쓰지 않는다. 그쪽은 선택자 목록이 한 벌로 묶여
           있어(.ind-head · .ind-uc-aside · .ind-uc-item 등) 이 페이지에서만
           카드를 빼낼 수 없다 — 들이면 섹션 머리와 흐름 항목까지 함께 뜬다.
           목록을 고치면 산업별 · 과제별 페이지가 같이 바뀐다.
        ⚠️ 숨기는 일을 CSS 가 아니라 이 스크립트가 맡는다. CSS 로 숨겨 두면
           JS 가 막혔을 때 카드가 영영 안 보인다 — 숨기는 쪽을 기본값으로
           두지 않는 까닭이다(공용 모션이 .rv-on 을 붙이는 것과 같다).
        ⚠️ 각 섹션 바로 뒤에서 부른다. 파싱이 그 자리에 닿는 순간 카드는 이미
           있고 아직 그려지기 전이라, 첫 페인트부터 숨은 채로 시작한다. 뒤로
           미루면 보였다가 사라지는 깜빡임이 난다 — 그래서 기능 섹션은 제
           자리에서 따로 부른다. */}
    <script is:inline>
      /* fixed 를 주면 지연을 형제 순서로 미리 박는다 — 공용 ScrollReveal 과
         같은 방식이다. 세로로 멀리 떨어져 혼자 선을 넘는 항목도 제 차례만큼
         기다린다. 안 주면 선에 걸리는 순간 함께 걸린 것끼리 차례를 매긴다. */
      window.wrReveal = function (rowSel, cardSel, step, fixed) {
        if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var row = document.querySelector(rowSel);
        if (!row) return;
        var cards = [].slice.call(row.querySelectorAll(cardSel));
        if (!cards.length) return;

        var STEP = step, DUR = 550, EASE = 'cubic-bezier(.2,.7,.2,1)';

        cards.forEach(function (n, i) {
          n.style.opacity = '0';
          n.style.transform = 'translateY(16px)';
          n.style.transition = 'opacity ' + DUR + 'ms ' + EASE + ', transform ' + DUR + 'ms ' + EASE;
          /* 저쪽과 같이 일곱 번째에서 멈춘다 — 긴 목록의 끝이 한참 기다리지
             않게 두는 제한이다. */
          if (fixed && i) n.style.transitionDelay = Math.min(i, 7) * STEP + 'ms';
        });

        /* 다 뜨고 나면 인라인 값을 통째로 걷는다. 남겨 두면 여기서 건 지연이
           카드 제 호버 효과까지 늦춘다(네 개의 층은 아이콘 호버가 걸려 있다). */
        function clean(n) {
          n.style.transition = ''; n.style.transitionDelay = '';
          n.style.opacity = ''; n.style.transform = '';
        }

        /* 끝내 한 장도 안 떴더라도 글은 보여야 한다. */
        var guard = setTimeout(function () { cards.forEach(clean); cards.length = 0; }, 6000);

        /* ⚠️ 지연은 처음에 박지 않고 선에 걸리는 순간에 준다. 한 번에 걸린
           것끼리만 차례를 매긴다 — 넓은 폭에서는 넉 장이 한 줄이라 같은
           순간에 걸려 0 · 60 · 120 · 180ms 로 뜨고, 좁은 폭에서 한 열로
           쌓이면 카드마다 제 차례에 혼자 걸려 지연 없이 뜬다.
           처음에 i * STEP 을 박아 두면 좁은 폭에서 아래 카드들이 화면 밖에
           있는 동안 다 떠 버려 모션이 사라진다. */
        function sweep() {
          if (!cards.length) return;
          var line = (window.innerHeight || 0) * 0.88, k = 0;
          for (var i = cards.length - 1; i >= 0; i--) {
            if (cards[i].getBoundingClientRect().top >= line) continue;
            cards[i].__k = k++;
            cards[i].__go = true;
          }
          if (!k) return;
          clearTimeout(guard);
          for (var j = cards.length - 1; j >= 0; j--) {
            var n = cards[j];
            if (!n.__go) continue;
            /* 뒤에서부터 훑어 위 카드가 큰 번호를 받았다 — 뒤집어 준다.
               fixed 면 위에서 이미 박아 두었으므로 건드리지 않는다. */
            if (!fixed) n.style.transitionDelay = (k - 1 - n.__k) * STEP + 'ms';
            n.addEventListener('transitionend', function () { clean(this); }, { once: true });
            n.style.opacity = ''; n.style.transform = '';
            cards.splice(j, 1);
          }
          if (!cards.length) {
            removeEventListener('scroll', onScroll);
            removeEventListener('resize', onScroll);
          }
        }

        var ticking = false;
        function onScroll() {
          if (ticking || !cards.length) return;
          ticking = true;
          requestAnimationFrame(function () { ticking = false; sweep(); });
        }
        addEventListener('scroll', onScroll, { passive: true });
        addEventListener('resize', onScroll, { passive: true });
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', sweep);
        else sweep();
      };
      /* 네 개의 층 — 늦추는 간격 60ms 는 과제별 신호 카드와 같은 값이다.
         머리(라벨 + 대제목)와 카드를 따로 부른다. 과제별도 .ind-head 와
         .uc-signal 이 각각 제 차례에 걸린다 — 머리가 카드보다 위에 있어
         먼저 선을 넘고, 그 뒤 카드 넷이 차례로 뜬다.
         ⚠️ 머리는 한 덩어리다. 라벨과 대제목을 따로 띄우지 않는다 — 저쪽도
            .ind-head 통째로 띄운다. */
      window.wrReveal('.wr-os .ind-container', '.ind-head', 60);
      window.wrReveal('.wr-layers', '.wr-layer', 60);
    </script>

    <!-- STORY BLOCKS -->
