      <video
        class="ind-cta-bg-img"
        autoplay muted loop playsinline preload="metadata"
        poster={`/cta/why-refinery/${ctaGraphic}/why-cta-${ctaGraphic}.webp`}
        aria-hidden="true"
      >
        <source src={`/cta/why-refinery/${ctaGraphic}/why-cta-${ctaGraphic}.webm`} type="video/webm" />
        <source src={`/cta/why-refinery/${ctaGraphic}/why-cta-${ctaGraphic}.mp4`} type="video/mp4" />
