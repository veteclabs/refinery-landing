         같은 값으로 뜬다. 저쪽은 공용 ScrollReveal 이 띄우는 자리라 16px ·
         0.55s · cubic-bezier(.2,.7,.2,1) · 지연 0 이다.
         ⚠️ 아래 따라오다 사라지는 처리와 같은 칸을 쓴다. 뜨는 동안에는 이쪽이
            인라인 opacity 를 쥐고 있어 .is-faded 가 먹지 않지만, 다 뜨면
            인라인 값을 통째로 걷으므로(clean) 그 뒤로는 저쪽이 쥔다.
            둘 중 하나를 고칠 때는 이 맞물림을 함께 본다. */
      window.wrReveal('.wr-flow .ind-uc-shell', '.ind-uc-aside', 60);
      /* 항목 셋 — 산업별 02번 섹션의 내용(.ind-uc-item)과 같은 값이다.
         16px · 0.55s · cubic-bezier(.2,.7,.2,1) · 간격 60ms.
         ⚠️ 네 번째 인자 fixed 를 준다 — 지연을 형제 순서로 미리 박는 저쪽
            방식이다. 항목이 세로로 멀리 떨어져 있어 저마다 혼자 선을 넘는데,
            그때도 둘째는 60ms · 셋째는 120ms 를 기다린다. */
      window.wrReveal('.wr-flow .ind-uc-list', '.ind-uc-item', 60, true);
    </script>
    <script is:inline>
      (function () {
        var aside = document.querySelector('.wr-flow .ind-uc-aside');
        var shell = aside && aside.closest('.ind-uc-shell');
        if (!aside || !shell) return;
        var ticking = false;
        function upd() {
          if (getComputedStyle(aside).position !== 'sticky') {
            aside.classList.remove('is-faded');
            return;
          }
          /* 통의 아랫변이 화면 절반 위로 올라오면 지운다 — 마지막 항목이 다
             보이고 그 아래로 다음 섹션이 올라오기 시작하는 자리다.
             ⚠️ 칸이 붙기를 그만두는 자리(a.bottom)보다 늦출 수는 없다. 둘 중
                늦은 쪽을 기준으로 잡아야 화면이 아주 낮을 때도 붙은 채로
                흘러 나가지 않는다 — Math.max 가 그 몫이다. */
          var vh = window.innerHeight || document.documentElement.clientHeight;
          var a = aside.getBoundingClientRect();
          var sh = shell.getBoundingClientRect();
          var done = sh.bottom <= Math.max(a.bottom + 8, vh * 0.5);
          aside.classList.toggle('is-faded', done);
        }
        function onScroll() {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(function () { ticking = false; upd(); });
        }
        addEventListener('scroll', onScroll, { passive: true });
        addEventListener('resize', onScroll, { passive: true });
        upd();
      })();
    </script>

