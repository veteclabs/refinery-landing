---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/industry.css';

const SITE = 'https://refinery.kr';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: '왜 Refinery인가 | Refinery',
  url: `${SITE}/why-refinery`,
  isPartOf: { '@type': 'WebSite', name: 'Refinery', url: `${SITE}/` },
};

// 선택 이유 3 — 전부 1차 사실(현장 엔지니어·도입 방식·통합 지능). 미확인 수치 없음.
const values = [
  { icon: 'ph-hard-hat', title: '현장을 아는 팀이 만듭니다', desc: '개발자뿐 아니라 발전·제조·에너지 현장을 직접 뛴 현장 엔지니어가 한 팀. 문제를 자료가 아니라 현장의 맥락에서 정의합니다.' },
  { icon: 'ph-stack', title: '얹거나, 템플릿으로 시작하거나', desc: '이미 SCADA·MES·ERP를 쓰고 있으면 걷어내지 않고 그 위에 통합 지능 레이어를 얹습니다. 시스템이 없는 현장은 30년 경험으로 다져진 템플릿(예: 에너지경영시스템)에서 바로 시작합니다.' },
  { icon: 'ph-brain', title: '시계열을 넘어, 하나의 지능', desc: '센서 시계열뿐 아니라 설비·문서·이력까지 온톨로지로 엮어, AI가 근거를 들어 의사결정을 돕습니다.' },
];

// 기능 스토리 3 — 통합 / AI 에이전트 / 자동화
const stories = [
  {
    icon: 'ph-graph',
    eyebrow: '통합 · 온톨로지',
    title: '흩어진 데이터를 하나의 지식으로',
    points: [
      'SCADA·MES·ERP·센서·문서에 흩어진 데이터를 한곳에 모읍니다.',
      '온톨로지로 "무엇에 대한 데이터인지" 의미를 부여합니다.',
      '숫자와 기록이 맥락을 얻어 판단에 쓰입니다.',
    ],
  },
  {
    icon: 'ph-chat-circle-dots',
    eyebrow: 'AI 에이전트',
    title: '묻고 답하는 현장',
    points: [
      '궁금한 점을 물어보면 데이터를 근거로 답합니다.',
      '원인을 추론하고 다음 조치까지 제안합니다.',
      '답변의 근거가 된 데이터 출처를 함께 제시합니다.',
    ],
  },
  {
    icon: 'ph-gear-six',
    eyebrow: '자동화 · 워크플로우',
    title: '사람 없이도 돌아가는 운영',
    points: [
      '승인이 필요한 상황과 자동 처리할 상황을 대화로 정합니다.',
      '분석 결과가 보고서·알람·워크플로우 실행까지 이어집니다.',
      '반복 업무는 사람 손 없이 자동으로 처리됩니다.',
    ],
  },
];

const capabilityGroups = [
  { title: '데이터', items: ['온톨로지', '통합 대시보드', '파이프라인', '시계열 분석', '문서 지식화', '기존 시스템 연동'] },
  { title: '지능', items: ['AI 에이전트', '이상 감지 · 알람', '예지보전', '품질 예측', '에너지 최적화'] },
  { title: '운영', items: ['자동화 · 워크플로우', '리포트 자동화', 'ESG 리포트'] },
  { title: '신뢰', items: ['온프레미스 배포', '권한 · 암호화'] },
];
---
<BaseLayout
  title="왜 Refinery인가 · 현장을 아는 팀이 만든 산업 AI | Refinery"
  description="흩어진 현장 데이터를 하나의 지식으로 잇고, AI가 근거를 들어 의사결정을 돕습니다. 기존 위에 얹거나 없으면 새로 구축해, 하나의 플랫폼으로 현장을 지능화합니다."
  canonical="/why-refinery"
  jsonLd={jsonLd}
>
  <Nav />
  <main class="ind wr-page">
    <!-- HERO -->
    <section class="ind-hero wr-hero-bg">
      {/* 랜딩 CTA(#cta)와 같은 파일이다. 소개서 표지가 이미 이 배경을 쓰고 있어,
          거기서 뽑은 이미지와 픽셀이 사실상 일치했다(평균 차이 0.05/255).
          따로 들고 있을 이유가 없어 한 파일로 합쳤다. */}
      <img
        class="wr-hero-bg-img"
        src="/img_login-bg.webp"
        alt=""
        aria-hidden="true"
        width="3840"
        height="2160"
        decoding="async"
        fetchpriority="high"
      />
      {/* 우측 대시보드 장식 — 소개서 표지와 같은 구성.
          바깥 칸이 좌우 마스크(왼쪽으로 갈수록 사라짐), 안쪽 칸이 상하 마스크를 맡는다.
          글이 놓이는 왼쪽으로는 번지지 않아 가독성을 해치지 않는다. */}
      <div class="wr-hero-fx" aria-hidden="true">
        <div class="wr-hero-fx-inner">
          <img src="/why-refinery-dash.webp" alt="" width="2586" height="3512" loading="lazy" decoding="async" />
        </div>
      </div>
      <div class="ind-container">
        <p class="wr-tag">Refinery</p>
        <h1>하나의 플랫폼으로<br>현장을 지능화합니다</h1>
        <p class="ind-lede">데이터 수집부터 온톨로지, AI 분석, 예측, 자동 실행까지<br>흩어진 현장을 하나의 통합 지능으로 잇습니다.</p>
        <div class="ind-hero-actions">
          <a href="/contact" class="ind-btn-primary">문의하기</a>
        </div>
      </div>
    </section>

    <!-- VALUES -->
    <section class="ind-section wr-dark">
      <div class="ind-container">
        <header class="ind-head">
          <span class="ind-badge">WHY</span>
          <h2>왜 Refinery를 선택하나</h2>
        </header>
        <div class="wr-values">
          {values.map((v, i) => (
            <div class="wr-value">
              <div class="wr-value-top">
                <span class="wr-value-n">{String(i + 1).padStart(2, '0')}</span>
                <i class={`ph ${v.icon} wr-value-ic`} aria-hidden="true"></i>
              </div>
              <h3>{v.title}</h3>
              <p>{v.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- STORY BLOCKS -->
    <section class="ind-section ind-soft">
      <div class="ind-container">
        <header class="ind-head">
          <h2>한 플랫폼 안에서 이어지는 흐름</h2>
          <p>모으고 → 의미를 붙이고 → 묻고 답하고 → 자동으로 실행합니다.</p>
        </header>
        <div class="wr-stories">
          {stories.map((s, i) => (
            <article class="wr-story">
              <div class="wr-story-step"><span>{String(i + 1).padStart(2, '0')}</span></div>
              <div class="wr-story-body">
                <p class="wr-story-eyebrow">{s.eyebrow}</p>
                <h3>{s.title}</h3>
                <ul>
                  {s.points.map((p) => <li>{p}</li>)}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- CAPABILITIES -->
    <section class="ind-section">
      <div class="ind-container">
        <header class="ind-head">
          <span class="ind-badge">ALL-IN-ONE</span>
          <h2>한 플랫폼에 담긴 기능</h2>
          <p>현장 운영에 필요한 기능이 하나의 플랫폼 안에 있습니다.</p>
        </header>
        <div class="wr-caps">
          {capabilityGroups.map((g) => (
            <div class="wr-cap-group">
              <h3 class="wr-cap-title">{g.title}</h3>
              <ul>
                {g.items.map((it) => <li><i class="ph ph-check" aria-hidden="true"></i>{it}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="ind-cta wr-cta-bg">
      <img class="wr-cta-bg-img" src="/use-cases/cta-bg.webp" alt="" aria-hidden="true" loading="lazy" decoding="async" />
      <div class="ind-container">
        <h2>현장의 문제를<br>Refinery 팀과 함께 풀어보세요.</h2>
        <a href="/contact" class="ind-btn-primary ind-btn-lg">문의하기</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  /* 본문 좌우를 헤더(.nav-inner)와 같은 선에 맞춘다 — 로고 왼쪽 = 문의하기 버튼 오른쪽.
     공통 .ind-container는 1120/24라 내용이 헤더보다 49px 안쪽에서 시작했다.
     예지보전 등 유즈케이스 페이지가 쓰는 값(1280/48)과 같다.
     .wr-page 스코프라 .ind-container를 쓰는 다른 페이지에는 영향이 없다. */
  .wr-page .ind-container { max-width: 1280px; padding: 0 48px; }
  @media (max-width: 900px) {
    .wr-page .ind-container { padding: 0 24px; }
  }

  /* ───────── 히어로 — 예지보전(.uc-hero-bg)과 같은 구성 ─────────
     절대배치 사진 + 어두운 스크림 + 흰 글자. 브레드크럼과 영문 eyebrow를 빼고
     페이지 이름을 하늘색 태그라인으로 올렸다. */
  /* 위아래 모두 예지보전(.uc-redesigned .ind-hero)과 같은 값이다.
     소제목이 돌아오면서 세로가 이미 충분해져, 아래를 180px으로 늘려둘 이유가 없어졌다. */
  /* .ind-hero 공통값의 아래 구분선은 밝은 배경끼리 나눌 때 쓰는 선이다.
     여기는 어두운 히어로 아래에 어두운 섹션이 붙어 밝은 실선만 도드라진다. */
  /* 바탕색·이미지 불투명도 모두 소개서 표지 값이다. 표지는 어두운 막을 덮지 않고
     #10141B 위에 이미지를 .9로 얹는 게 전부라, 그 구성을 그대로 쓴다. */
  .wr-hero-bg {
    position: relative; overflow: hidden;
    padding: 180px 0 100px; border-bottom: none; background: #10141B;
  }
  .wr-hero-bg-img {
    position: absolute; inset: 0; width: 100%; height: 100%; opacity: .9;
    /* 100% = 위로 올릴 수 있는 끝. 이미지가 16:9(3840x2160)이고 히어로는 그보다
       납작해서 cover가 가로에 맞춘다 — 세로 여유 284px이 전부 위로 빠진다. */
    object-fit: cover; object-position: center 100%;
    pointer-events: none; user-select: none;
  }
  /* 우측 대시보드 장식 — 소개서 표지의 값을 그대로 가져왔다
     (폭 56% · 이미지 128% · 불투명도 .3 · 좌우/상하 마스크). */
  .wr-hero-fx {
    position: absolute; right: 0; top: 0; bottom: 0; width: 56%;
    overflow: hidden; pointer-events: none; user-select: none;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 36%);
    mask-image: linear-gradient(to right, transparent 0%, #000 36%);
  }
  /* 상단 페이드는 넣지 않는다 — 소개서 표지처럼 위쪽 대시보드(Sankey·소비량)까지
     보여야 해서, 이미지 위끝을 히어로 위끝에 붙이고 아래쪽만 흐린다. */
  .wr-hero-fx-inner {
    position: absolute; inset: 0; overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 78%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 78%, transparent 100%);
  }
  .wr-hero-fx-inner img {
    position: absolute; left: 0; top: 0;
    /* 오른쪽으로 넘치는 폭을 화면 크기와 무관하게 120px으로 고정한다.
       넘침 = (폭 - 칸) + 오른쪽 이동 = 60 + 60. %로만 잡으면 넓은 화면일수록
       넘침이 함께 커져 트리맵 오른쪽 열이 점점 더 잘렸다.
       전역 img{max-width:100%}가 칸보다 넓은 폭을 잘라내므로 풀어준다. */
    max-width: none; width: calc(100% + 60px); height: auto;
    transform: translate(60px, -165px);
    opacity: .3;
  }
  /* 좁은 화면에서는 글과 겹쳐 읽기를 방해한다. */
  @media (max-width: 900px) { .wr-hero-fx { display: none; } }

  .wr-hero-bg > .ind-container { position: relative; z-index: 1; }
  /* 랜딩 .section-header p와 같은 값(18px / 1.7 / 600px)으로 맞춘다.
     .ind-lede의 공통값은 line-height 1.6 · max-width 60ch(=643px)이라 미세하게 어긋났다.
     색만 다르다 — 여기는 어두운 배경 위다. */
  .wr-hero-bg .ind-lede {
    color: rgba(255,255,255,.82);
    line-height: 1.7; max-width: 600px;
  }
  @media (max-width: 900px) { .wr-hero-bg .ind-lede { font-size: 16px; } }
  /* 하늘색은 배경 밝기와 무관하게 브랜드 값 #76A6D7 하나로 통일한다. */
  .wr-tag {
    font-size: 18px; font-weight: 600; letter-spacing: -0.2px;
    color: #76a6d7; margin-bottom: 14px;
  }
  .wr-hero-bg h1 {
    font-size: clamp(28px, 4vw, 45px); font-weight: 600;
    letter-spacing: -0.8px; line-height: 1.3; color: #fff;
    word-break: keep-all;
  }
  .wr-hero-bg .ind-hero-actions { margin-top: 48px; gap: 16px; }
  /* 버튼 2개 — 형태는 랜딩 CTA와 같고, 주 버튼만 accent 면으로 채운다. */
  .wr-hero-bg .ind-hero-actions .ind-btn-primary {
    padding: 9px 22px; font-size: 15px; font-weight: 400;
    border-radius: 6px; transition: all .2s;
  }
  .wr-hero-bg .ind-hero-actions .ind-btn-primary {
    background: #76a6d7; color: #fff; border: 1px solid #76a6d7;
  }
  .wr-hero-bg .ind-hero-actions .ind-btn-primary:hover {
    background: #5a8fc5; border-color: #5a8fc5; color: #fff; transform: none;
  }

  /* ───────── CTA — 예지보전(.uc-cta-bg)과 같은 구성 ─────────
     사진 위 좌측 정렬 제목 + 우측 버튼. 이미지가 lazy라 도착 전 흰 배경이면
     글자가 잠깐 보이지 않으므로 어두운 면을 미리 깔아둔다. */
  .wr-cta-bg {
    position: relative; overflow: hidden;
    padding: 95px 0; text-align: left; background: #0c1015;
  }
  .wr-cta-bg-img {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover; object-position: center 65%;
    pointer-events: none; user-select: none;
  }
  .wr-cta-bg .ind-container {
    position: relative; z-index: 1;
    display: flex; align-items: center; justify-content: space-between;
    gap: 48px; flex-wrap: wrap;
  }
  .wr-cta-bg .ind-container > * { flex: none; }
  /* CTA만 500 — 랜딩 #cta가 섹션 대제목(600)과 다르게 500을 쓰는 것을 따른다. */
  .wr-page .ind-cta.wr-cta-bg h2 {
    font-size: clamp(26px, 3.6vw, 40px); font-weight: 500;
    letter-spacing: -0.8px; line-height: 1.35;
    color: #fff; margin-bottom: 0; text-wrap: initial;
  }
  .ind-cta.wr-cta-bg .ind-btn-primary {
    margin-top: 0; padding: 9px 22px;
    font-size: 15px; font-weight: 400;
    background: #76a6d7; color: #fff;
    border: 1px solid #76a6d7; border-radius: 6px; transition: all .2s;
  }
  .ind-cta.wr-cta-bg .ind-btn-primary:hover {
    background: #5a8fc5; border-color: #5a8fc5; color: #fff; transform: none;
  }
  /* 좁아지면 버튼이 아래로 내려온다. 제목과 붙지 않게 여백을 되살린다. */
  @media (max-width: 860px) {
    .ind-cta.wr-cta-bg .ind-btn-primary { margin-top: 32px; }
    .wr-hero-bg { padding: 120px 0 72px; }
  }

  /* ───────── '왜 Refinery를 선택하나' — 예지보전 '푸는 방식' 섹션과 같은 어두운 면
     실측값: 면 #111316, 제목 #EDEEF0, 설명 #959CA5, 구분선 #272B32, 아이콘 accent. */
  .wr-dark { background: #111316; }
  .wr-dark .ind-badge { color: #9cc4e8; background: rgba(118,166,215,.14); }
  .wr-dark .ind-head h2 { color: #edeef0; }
  .wr-dark .ind-head p { color: #959ca5; }
  .wr-dark .wr-value { border-top-color: #272b32; }
  .wr-dark .wr-value-n { color: #edeef0; }
  .wr-dark .wr-value-ic { color: #76a6d7; }
  .wr-dark .wr-value h3 { color: #edeef0; }
  .wr-dark .wr-value p { color: #959ca5; }

  /* 선택 이유 3 — 상단 룰 + 번호(카드 박스 없이 편집형) */
  .wr-values { display: grid; grid-template-columns: repeat(3, 1fr); gap: 44px; }
  .wr-value { padding-top: 20px; border-top: 2px solid #16202c; }
  .wr-value-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; }
  .wr-value-n { font-size: 13px; font-weight: 800; letter-spacing: .1em; color: #16202c; }
  .wr-value-ic { font-size: 22px; color: #aab4c0; }
  .wr-value h3 { font-size: 19px; font-weight: 700; letter-spacing: -0.02em; }
  .wr-value p { margin-top: 11px; font-size: 15px; line-height: 1.72; color: #47535f; }

  /* 기능 스토리 — 번호 흐름(카드 대신 구분선) */
  .wr-stories { display: grid; gap: 0; }
  .wr-story { display: flex; gap: 30px; align-items: flex-start; padding: 32px 0; border-top: 1px solid var(--border); }
  .wr-story:last-child { border-bottom: 1px solid var(--border); }
  .wr-story-step { flex: none; width: 60px; }
  .wr-story-step span { font-size: 32px; font-weight: 800; letter-spacing: -0.03em; color: #c9d5e0; line-height: 1; }
  .wr-story-eyebrow { font-size: 12px; font-weight: 700; letter-spacing: .08em; color: #4b86bf; text-transform: uppercase; }
  .wr-story h3 { font-size: 20px; font-weight: 700; letter-spacing: -0.02em; margin: 7px 0 13px; }
  .wr-story ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
