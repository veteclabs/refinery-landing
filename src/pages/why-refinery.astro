  /* 랜딩 .section-header-row와 같은 배치 — 대제목 오른쪽 끝에 소제목을 두고
     아랫선을 맞춘다(align-items: flex-end). 소제목 폭 360px도 같은 값이다.
     .ind-head의 max-width 640px은 두 칸을 나란히 두기엔 좁아 푼다. */
  .wr-head-row {
    max-width: none;
    display: flex; justify-content: space-between; align-items: flex-end;
    gap: 32px; flex-wrap: wrap;
  }
  .wr-head-row h2 { margin-bottom: 0; }
  .wr-page .wr-head-row p { max-width: 360px; margin: 0; }
  /* 좁은 화면에서는 줄바꿈되어 제목 아래로 내려간다 — 그때는 간격을 준다. */
  @media (max-width: 900px) { .wr-page .wr-head-row p { margin-top: 12px; } }

  .wr-values { display: grid; grid-template-columns: repeat(3, 1fr); gap: 44px; }
