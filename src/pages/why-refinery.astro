---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/industry.css';

const SITE = 'https://refinery.kr';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: '왜 Refinery인가 | Refinery',
  url: `${SITE}/why-refinery`,
  isPartOf: { '@type': 'WebSite', name: 'Refinery', url: `${SITE}/` },
};

// 선택 이유 3 — 전부 1차 사실(현장 엔지니어·도입 방식·통합 지능). 미확인 수치 없음.
// 아이콘은 디자인에서 받은 2색 SVG(흰색 + #76A6D7)를 순서대로 쓴다.
// 색이 그림 안에 박혀 있어 currentColor로 물들일 수 없다 — 어두운 면 전용이다.
const values = [
  { icon: '/why-refinery/icon-01.svg', title: '현장을 아는 팀', desc: '현장을 직접 뛴 엔지니어가 함께합니다.<br>문제를 자료가 아닌 맥락에서 봅니다.' },
  { icon: '/why-refinery/icon-02.svg', title: '걷어내지 않는 도입', desc: '쓰던 시스템 위에 얹습니다.<br>없으면 30년 경험의 템플릿에서 시작합니다.' },
  { icon: '/why-refinery/icon-03.svg', title: '숫자를 넘어, 지식으로', desc: '설비 · 문서 · 이력까지 온톨로지로 엮습니다.<br>AI가 근거를 들어 답합니다.' },
];

// 기능 스토리 3 — 통합 / AI 에이전트 / 자동화
const stories = [
  {
    image: '/why-refinery/story-01.svg',
    eyebrow: '통합 · 온톨로지',
    title: '흩어진 데이터를 하나의 지식으로',
    points: [
      'SCADA·MES·ERP·센서·문서에 흩어진 데이터를 한곳에 모읍니다.',
      '온톨로지로 "무엇에 대한 데이터인지" 의미를 부여합니다.',
      '숫자와 기록이 맥락을 얻어 판단에 쓰입니다.',
    ],
  },
  {
    image: '/why-refinery/story-02.svg',
    eyebrow: 'AI 에이전트',
    title: '묻고 답하는 현장',
    points: [
      '궁금한 점을 물어보면 데이터를 근거로 답합니다.',
      '원인을 추론하고 다음 조치까지 제안합니다.',
      '답변의 근거가 된 데이터 출처를 함께 제시합니다.',
    ],
  },
  {
    image: '/why-refinery/story-03.svg',
    eyebrow: '자동화 · 워크플로우',
    title: '사람 없이도 돌아가는 운영',
    points: [
      '승인이 필요한 상황과 자동 처리할 상황을 대화로 정합니다.',
      '분석 결과가 보고서·알람·워크플로우 실행까지 이어집니다.',
      '반복 업무는 사람 손 없이 자동으로 처리됩니다.',
    ],
  },
];

// 아이콘은 예지보전 '푸는 방식' 카드와 같은 Phosphor 폰트를 쓴다.
// 이 페이지 다른 곳에서 쓰는 것과 겹치지 않게 골랐다.
const capabilityGroups = [
  { title: '데이터', icon: 'ph-database', items: ['온톨로지', '통합 대시보드', '파이프라인', '시계열 분석', '문서 지식화', '기존 시스템 연동'] },
  { title: '지능', icon: 'ph-sparkle', items: ['AI 에이전트', '이상 감지 · 알람', '예지보전', '품질 예측', '에너지 최적화'] },
  { title: '운영', icon: 'ph-gear-six', items: ['자동화 · 워크플로우', '리포트 자동화', 'ESG 리포트'] },
  { title: '신뢰', icon: 'ph-shield-check', items: ['온프레미스 배포', '권한 · 암호화'] },
];
---
<BaseLayout
  title="왜 Refinery인가 · 현장을 아는 팀이 만든 산업 AI | Refinery"
  description="흩어진 현장 데이터를 하나의 지식으로 잇고, AI가 근거를 들어 의사결정을 돕습니다. 기존 위에 얹거나 없으면 새로 구축해, 하나의 플랫폼으로 현장을 지능화합니다."
  canonical="/why-refinery"
  jsonLd={jsonLd}
>
  <Nav />
  <main class="ind wr-page">
    <!-- HERO -->
    <section class="ind-hero wr-hero-bg">
      {/* 랜딩 CTA(#cta)와 같은 파일이다. 소개서 표지가 이미 이 배경을 쓰고 있어,
          거기서 뽑은 이미지와 픽셀이 사실상 일치했다(평균 차이 0.05/255).
          따로 들고 있을 이유가 없어 한 파일로 합쳤다. */}
      <img
        class="wr-hero-bg-img"
        src="/img_login-bg.webp"
        alt=""
        aria-hidden="true"
        width="3840"
        height="2160"
        decoding="async"
        fetchpriority="high"
      />
      {/* 우측 대시보드 장식 — 소개서 표지와 같은 구성.
          바깥 칸이 좌우 마스크(왼쪽으로 갈수록 사라짐), 안쪽 칸이 상하 마스크를 맡는다.
          글이 놓이는 왼쪽으로는 번지지 않아 가독성을 해치지 않는다. */}
      <div class="wr-hero-fx" aria-hidden="true">
        <div class="wr-hero-fx-inner">
          <img src="/why-refinery-dash.webp" alt="" width="2586" height="3512" loading="lazy" decoding="async" />
        </div>
      </div>
      <div class="ind-container">
        <p class="wr-tag">Refinery</p>
        <h1>하나의 플랫폼으로<br>현장을 지능화합니다</h1>
        <p class="ind-lede">데이터 수집부터 온톨로지, AI 분석, 예측, 자동 실행까지<br class="wr-lede-br">{' '}흩어진 현장을 하나의 통합 지능으로 잇습니다.</p>
        <div class="ind-hero-actions">
          <a href="/contact" class="ind-btn-primary">문의하기</a>
        </div>
      </div>
    </section>

    <!-- VALUES -->
    <section class="ind-section wr-dark">
      <div class="ind-container">
        <header class="ind-head wr-head-row">
          <h2>현장이 먼저입니다</h2>
          <p>팀도 도입도 데이터도 현장 기준으로</p>
        </header>
        <div class="wr-values">
          {values.map((v) => (
            <div class="wr-value">
              <img class="wr-value-ic" src={v.icon} alt="" aria-hidden="true" width="124" height="124" loading="lazy" decoding="async" />
              <h3>{v.title}</h3>
              <p set:html={v.desc}></p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- STORY BLOCKS -->
    <section class="ind-section ind-soft">
      <div class="ind-container">
        <header class="ind-head wr-head-row">
          <h2>한 플랫폼 안에서 이어지는 흐름</h2>
          <p>모아서 붙이고 묻고 실행하기까지</p>
        </header>
        <div class="wr-stories">
          {stories.map((s, i) => (
            <article class="ind-card wr-story">
              <div class="wr-story-media">
                <img src={s.image} alt="" aria-hidden="true" width="1920" height="1080" loading="lazy" decoding="async" />
              </div>
              <div class="wr-story-body">
                <p class="wr-story-eyebrow">{s.eyebrow}</p>
                <h3>{s.title}</h3>
                <ul>
                  {s.points.map((p) => <li>{p}</li>)}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- CAPABILITIES -->
    <section class="ind-section">
      <div class="ind-container">
        <header class="ind-head wr-head-row">
          <h2>한 플랫폼에 담긴 기능</h2>
          <p>현장 운영에 필요한 기능이 한곳에</p>
        </header>
        <div class="wr-caps">
          {capabilityGroups.map((g) => (
            <div class="ind-card wr-cap-group">
              <div class="wr-cap-head">
                <span class="wr-cap-icon" aria-hidden="true"><i class={`ph ${g.icon}`}></i></span>
                <h3>{g.title}</h3>
              </div>
              <ul>
                {g.items.map((it) => <li>{it}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="ind-cta wr-cta-bg">
      <img class="wr-cta-bg-img" src="/use-cases/cta-bg.webp" alt="" aria-hidden="true" loading="lazy" decoding="async" />
      <div class="ind-container">
        <h2>현장의 문제를<br>Refinery 팀과 함께 풀어보세요.</h2>
        <a href="/contact" class="ind-btn-primary ind-btn-lg">문의하기</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  /* 본문 좌우를 헤더(.nav-inner)와 같은 선에 맞춘다 — 로고 왼쪽 = 문의하기 버튼 오른쪽.
     공통 .ind-container는 1120/24라 내용이 헤더보다 49px 안쪽에서 시작했다.
     예지보전 등 유즈케이스 페이지가 쓰는 값(1280/48)과 같다.
     .wr-page 스코프라 .ind-container를 쓰는 다른 페이지에는 영향이 없다. */
  .wr-page .ind-container { max-width: 1280px; padding: 0 48px; }
  @media (max-width: 900px) {
    .wr-page .ind-container { padding: 0 24px; }
  }

  /* ───────── 섹션 공통값을 예지보전(.uc-redesigned)과 맞춘다 ─────────
     industry.css의 공통값은 이 페이지들보다 촘촘하다. 유즈케이스가 이미
     랜딩 본문에 맞춰 늘려 쓰고 있으므로 같은 값을 그대로 가져온다.
       섹션 위아래 여백  84px  → 130px (좁은 화면 60px은 공통값과 같다)
       제목 아래 여백    44px  → 64px
       섹션 대제목  clamp(26,3.4vw,38) / 650 / -0.02em / 1.25
                  → clamp(28,4vw,45)  / 600 / -0.8px  / 1.3   (랜딩 대제목과 같은 값) */
  .wr-page .ind-section { padding: 130px 0; }
  @media (max-width: 900px) {
    .wr-page .ind-section { padding: 60px 0; }
  }
  .wr-page .ind-head { margin-bottom: 64px; }
  .wr-page .ind-head h2 {
    font-size: clamp(28px, 4vw, 45px); font-weight: 600;
    letter-spacing: -0.8px; line-height: 1.3;
  }
  /* 섹션 소제목은 예지보전에 대응하는 요소가 없다(거기는 태그라인을 쓴다).
     대신 랜딩 .section-header p(18px / 1.7)에 맞춘다 — 이 페이지 히어로
     소제목도 이미 그 값이라, 16px로 두면 한 페이지 안에서 두 크기가 섞인다. */
  .wr-page .ind-head p { font-size: 18px; line-height: 1.7; }
  @media (max-width: 900px) { .wr-page .ind-head p { font-size: 16px; } }

  /* ───────── 히어로 — 예지보전(.uc-hero-bg)과 같은 구성 ─────────
     절대배치 사진 + 어두운 스크림 + 흰 글자. 브레드크럼과 영문 eyebrow를 빼고
     페이지 이름을 하늘색 태그라인으로 올렸다. */
  /* 위아래 모두 예지보전(.uc-redesigned .ind-hero)과 같은 값이다.
     소제목이 돌아오면서 세로가 이미 충분해져, 아래를 180px으로 늘려둘 이유가 없어졌다. */
  /* .ind-hero 공통값의 아래 구분선은 밝은 배경끼리 나눌 때 쓰는 선이다.
     여기는 어두운 히어로 아래에 어두운 섹션이 붙어 밝은 실선만 도드라진다. */
  /* 바탕색·이미지 불투명도 모두 소개서 표지 값이다. 표지는 어두운 막을 덮지 않고
     #10141B 위에 이미지를 .9로 얹는 게 전부라, 그 구성을 그대로 쓴다. */
  .wr-hero-bg {
    position: relative; overflow: hidden;
    padding: 180px 0 100px; border-bottom: none; background: #10141B;
  }
  .wr-hero-bg-img {
    position: absolute; inset: 0; width: 100%; height: 100%; opacity: .9;
    /* 100% = 위로 올릴 수 있는 끝. 이미지가 16:9(3840x2160)이고 히어로는 그보다
       납작해서 cover가 가로에 맞춘다 — 세로 여유 284px이 전부 위로 빠진다. */
    object-fit: cover; object-position: center 100%;
    pointer-events: none; user-select: none;
  }
  /* 우측 대시보드 장식 — 소개서 표지의 값을 그대로 가져왔다
     (폭 56% · 이미지 128% · 불투명도 .3 · 좌우/상하 마스크). */
  /* 왼쪽 페이드는 %가 아니라 px로 잡는다. %면 칸이 좁아질수록 페이드 구간도 같이
     좁아져, 글 끝에 닿는 자리에서 이미 또렷해졌다(1024px에서 실효 불투명도 .29).
     420px으로 못박으면 화면 폭과 무관하게 글 옆 완충 구간이 일정하다(.09 안팎). */
  .wr-hero-fx {
    position: absolute; right: 0; top: 0; bottom: 0; width: 56%;
    overflow: hidden; pointer-events: none; user-select: none;
    -webkit-mask-image: linear-gradient(to right, transparent 0px, #000 420px);
    mask-image: linear-gradient(to right, transparent 0px, #000 420px);
  }
  /* 상단 페이드는 넣지 않는다 — 소개서 표지처럼 위쪽 대시보드(Sankey·소비량)까지
     보여야 해서, 이미지 위끝을 히어로 위끝에 붙이고 아래쪽만 흐린다. */
  .wr-hero-fx-inner {
    position: absolute; inset: 0; overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 78%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 78%, transparent 100%);
  }
  /* 크기는 px로 못박고, 칸의 오른쪽 끝에 붙인다.
     칸(.wr-hero-fx)은 화면 폭의 56%라 창을 줄이면 같이 줄어든다. 이미지를 %로
     잡으면 그때마다 이미지도 같이 줄고, 히어로 세로는 616px로 고정이라
     보이는 부분이 매번 달라졌다 — 창 크기를 바꿀 때 그림이 달라 보이던 원인이다.
     오른쪽 기준(right)으로 붙였으므로 칸이 줄어도 넘침은 120px 그대로이고,
     남는 쪽은 왼쪽이다. 왼쪽은 어차피 마스크로 사라지는 자리라 티가 안 난다.
     전역 img{max-width:100%}가 칸보다 넓은 폭을 잘라내므로 풀어준다. */
  .wr-hero-fx-inner img {
    position: absolute; right: -140px; left: auto; top: 0;
    max-width: none; width: 1180px; height: auto;
    transform: translateY(-205px);
    opacity: .3;
  }
  /* 1200px 미만에서는 칸과 이미지를 함께 줄인 작은 판을 쓴다.
     넓은 화면 값(칸 56% · 이미지 1120px)을 그대로 두면 칸이 이미지보다 훨씬
     작아져 트리맵 한 조각만 확대돼 보이고(1024px에서 칸 573px — 이미지의 절반),
     칸 왼쪽 끝이 소제목 끝보다 안쪽으로 들어와 글 뒤에 무늬가 깔린다(실효 .29).
     칸을 40%로 좁히면 칸 시작점이 글 끝보다 바깥으로 밀려 겹침이 0이 된다. */
  @media (max-width: 1199px) {
    .wr-hero-fx { width: 40%; }
    .wr-hero-fx-inner img { width: 800px; right: -95px; }
  }
  /* 900px 미만에서는 본문이 화면 전체를 쓴다. 어디에 둬도 글 뒤에 깔려 감춘다. */
  @media (max-width: 900px) { .wr-hero-fx { display: none; } }

  .wr-hero-bg > .ind-container { position: relative; z-index: 1; }
  /* 랜딩 .section-header p와 같은 값(18px / 1.7 / 600px)으로 맞춘다.
     .ind-lede의 공통값은 line-height 1.6 · max-width 60ch(=643px)이라 미세하게 어긋났다.
     색만 다르다 — 여기는 어두운 배경 위다. */
  .wr-hero-bg .ind-lede {
    color: rgba(255,255,255,.82);
    line-height: 1.7; max-width: 600px;
  }
  @media (max-width: 900px) {
    .wr-hero-bg .ind-lede { font-size: 16px; }
    /* 좁은 화면에서는 첫 줄이 어차피 다시 감긴다. 여기에 <br>까지 걸리면
       '자동 실행 / 까지'처럼 한 어절만 남아 떨어진다. 자연스럽게 흐르게 둔다. */
    .wr-lede-br { display: none; }
  }
  /* 하늘색은 배경 밝기와 무관하게 브랜드 값 #76A6D7 하나로 통일한다. */
  .wr-tag {
    font-size: 18px; font-weight: 600; letter-spacing: -0.2px;
    color: #76a6d7; margin-bottom: 14px;
  }
  .wr-hero-bg h1 {
    font-size: clamp(28px, 4vw, 45px); font-weight: 600;
    letter-spacing: -0.8px; line-height: 1.3; color: #fff;
    word-break: keep-all;
  }
  .wr-hero-bg .ind-hero-actions { margin-top: 48px; gap: 16px; }
  /* 버튼 2개 — 형태는 랜딩 CTA와 같고, 주 버튼만 accent 면으로 채운다. */
  .wr-hero-bg .ind-hero-actions .ind-btn-primary {
    padding: 9px 22px; font-size: 15px; font-weight: 400;
    border-radius: 6px; transition: all .2s;
  }
  .wr-hero-bg .ind-hero-actions .ind-btn-primary {
    background: #76a6d7; color: #fff; border: 1px solid #76a6d7;
  }
  .wr-hero-bg .ind-hero-actions .ind-btn-primary:hover {
    background: #5a8fc5; border-color: #5a8fc5; color: #fff; transform: none;
  }

  /* ───────── CTA — 예지보전(.uc-cta-bg)과 같은 구성 ─────────
     사진 위 좌측 정렬 제목 + 우측 버튼. 이미지가 lazy라 도착 전 흰 배경이면
