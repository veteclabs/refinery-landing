  /* CTA만 500 — 랜딩 #cta가 섹션 대제목(600)과 다르게 500을 쓰는 것을 따른다.
     크기는 섹션 대제목(45px)보다 한 단계 작은 40px이다. 예지보전이 같은 이유로
     그렇게 쓴다 — 하위 페이지라 위계가 낮고, 버튼이 옆에 붙어 제목 폭이 좁다. */
  .wr-page .ind-cta.wr-cta-bg h2 {
    font-size: clamp(26px, 3.6vw, 40px); font-weight: 500;
    letter-spacing: -0.8px; line-height: 1.35;
    color: #fff; margin-bottom: 0; text-wrap: initial;
  }
  .ind-cta.wr-cta-bg .ind-btn-primary {
    margin-top: 0; padding: 9px 22px;
    font-size: 15px; font-weight: 400;
    background: #76a6d7; color: #fff;
    border: 1px solid #76a6d7; border-radius: 6px; transition: all .2s;
