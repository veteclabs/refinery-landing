---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Ph from '../components/Ph.astro';
import { company, effectiveDate, revisedDate, retention, processors, remedyAgencies, legalReviewed, revisions } from '../data/legal';
import '../styles/legal.css';

// 목차·항목 구성은 개인정보보호위원회 「개인정보 처리방침 작성지침(2025.4.)」을 따른다.
// 해당 사항이 없는 항목도 "해당 없음"을 명시한다(지침: 항목 자체를 빼면 누락으로 평가된다).
const isDraft = !legalReviewed || !effectiveDate || !company.ceo || !company.bizNo;

// 문서 맨 앞 목차. 라벨은 본문 <h2>와 같아야 한다 — 조문을 고치면 여기도 고친다.
// (본문이 손으로 쓴 마크업이라 빌드 때 자동 대조가 되지 않는다.)
const toc = [
  { id: 'sec-1', no: '1', label: '개인정보의 처리 목적' },
  { id: 'sec-2', no: '2', label: '처리하는 개인정보의 항목' },
  { id: 'sec-3', no: '3', label: '만 14세 미만 아동의 개인정보 처리' },
  { id: 'sec-4', no: '4', label: '개인정보의 처리 및 보유 기간' },
  { id: 'sec-5', no: '5', label: '개인정보의 파기 절차 및 방법' },
  { id: 'sec-6', no: '6', label: '개인정보의 제3자 제공' },
  { id: 'sec-7', no: '7', label: '추가적인 이용 · 제공의 판단 기준' },
  { id: 'sec-8', no: '8', label: '개인정보 처리업무의 위탁' },
  { id: 'sec-9', no: '9', label: '개인정보의 국외 이전' },
  { id: 'sec-customer-data', no: '10', label: '고객 데이터에 포함된 개인정보의 처리 (수탁자 지위)' },
  { id: 'sec-11', no: '11', label: '개인정보의 안전성 확보 조치' },
  { id: 'sec-12', no: '12', label: '민감정보의 공개 가능성 및 비공개 선택 방법' },
  { id: 'sec-13', no: '13', label: '가명정보 처리에 관한 사항' },
  { id: 'sec-14', no: '14', label: '개인정보 자동 수집 장치의 설치 · 운영 및 거부에 관한 사항' },
  { id: 'sec-15', no: '15', label: '행태정보의 수집 · 이용 및 거부 등에 관한 사항' },
  { id: 'sec-16', no: '16', label: '정보주체와 법정대리인의 권리 · 의무 및 행사방법' },
  { id: 'sec-17', no: '17', label: '자동화된 결정에 관한 사항' },
  { id: 'sec-18', no: '18', label: '개인정보 보호책임자 및 고충처리 담당부서' },
  { id: 'sec-19', no: '19', label: '개인정보 열람청구의 접수 · 처리 부서' },
  { id: 'sec-20', no: '20', label: '정보주체의 권익침해에 대한 구제방법' },
  { id: 'sec-21', no: '21', label: '영상정보처리기기의 운영 · 관리' },
  { id: 'sec-22', no: '22', label: '개인정보 처리방침의 변경' },
  { id: 'sec-company', no: '', label: '사업자 정보' },
];

/** '가·나' 꼴을 통째로 붙여 둔다 — 좁은 칸에서 점 뒤가 갈리는 것을 막는다.
 *  word-break: keep-all은 한글 낱자 사이만 막고 문장부호 자리는 막지 못한다. */
const keepDots = (t: string) =>
  t.replace(/([^\s\u2009·]+(?:\u2009·\u2009[^\s\u2009·]+)+)/g, '<span class="nb">$1</span>');
---
<BaseLayout
  title="개인정보처리방침 | Refinery"
  description="Refinery 웹사이트 및 서비스의 개인정보 수집 · 이용 · 제공 · 위탁 · 국외이전에 관한 처리방침입니다."
  canonical="/privacy"
  robots="index, follow"
>
  <Nav />
  {/* 이 문서만 글 기둥이 넓다 — 아래 .legal-main--wide 주석 참고. */}
  <main class="legal-main legal-main--wide">
    <h1>개인정보처리방침</h1>
    {/* 나머지 법적 고지 3종과 같이 시행일만 둔다. 개정일은 22항의 개정 이력 표에
        있고, 최초 제정 상태에서는 두 날짜가 같아 정보 없이 시선만 쓰게 했다. */}
    <p class="legal-updated">시행일 : <Ph value={effectiveDate} label="YYYY-MM-DD" /></p>

    {isDraft && (
      <div class="legal-draft">
        ⚠️ 본 문서는 <strong>초안</strong>입니다. 노란색으로 표시된 <span class="legal-ph">[항목]</span>은
        <code>src/data/legal.ts</code>에서 채운 뒤, 게시 전 <strong>법무 검토</strong>를 받으세요.
        수집 항목 · 수탁자 · 쿠키 내역은 현재 사이트 구현 기준의 사실입니다.
      </div>
    )}

    <div class="legal-body">
      <p>
        <Ph value={company.legalName} label="회사명" />(이하 "회사")는 「개인정보 보호법」 제30조에 따라
        정보주체의 개인정보를 보호하고 이와 관련한 고충을 신속하고 원활하게 처리할 수 있도록 다음과 같이
        개인정보 처리방침을 수립 · 공개합니다.
      </p>
      <p>
        본 방침은 회사가 운영하는 <strong>{company.serviceName} 웹사이트({company.siteUrl})</strong>와
        회사가 제공하는 <strong>{company.serviceName} 서비스</strong>에 적용됩니다.
        다만 고객사가 {company.serviceName} 서비스에 입력 · 연동한 데이터에 개인정보가 포함된 경우,
        해당 개인정보의 처리에 관하여는 <strong>고객사가 개인정보처리자</strong>이고 회사는 수탁자의 지위에 있으므로
        아래 <a href="#sec-customer-data">제10항</a>이 적용됩니다.
      </p>

      {/* 문서 맨 앞 목차. 조문이 22개라 원하는 항을 스크롤로 찾아야 했다.
          여기서 짚어 들어가고, 각 절의 앵커(sec-1 … sec-22)로 이동한다. */}
      <nav class="legal-toc" aria-labelledby="toc-title">
        <p class="legal-toc-title" id="toc-title">개인정보처리방침 목차</p>
        <ol>
          {toc.map((t) => (
            <li>
              {/* 조문 제목과 같은 꼴로 적는다 — '1. 개인정보의 처리 목적'.
                  번호 없는 항목(사업자 정보)은 번호 자리 없이 이름만 나온다. */}
              <a href={`#${t.id}`} set:html={keepDots((t.no ? t.no + '. ' : '') + t.label)} />
            </li>
          ))}
        </ol>
      </nav>

      <section id="sec-1">
        <h2>1. 개인정보의 처리 목적</h2>
        <p>회사는 다음의 목적으로 개인정보를 처리하며, 목적이 변경되는 경우에는 「개인정보 보호법」 제18조에 따라 별도의 동의를 받는 등 필요한 조치를 이행합니다.</p>
        <div class="legal-table-wrap">
          <table class="legal-table">
            <thead><tr><th>구분</th><th>처리 목적</th><th>동의 필요 여부</th></tr></thead>
            <tbody>
              <tr>
                <td>문의 · 데모 신청</td>
                <td>문의 내용의 확인과 회신, 상담 · 기술 검토, 데모 및 제안 일정 조율</td>
                <td>동의 필요<br /><span style="color:#7e8a98;font-size:13px;">(문의 폼 제출 시 수집 · 이용 동의)</span></td>
              </tr>
              <tr>
                <td>계약의 체결 · 이행</td>
                <td>견적 · 계약 협의, 계약 체결과 이행, 대금 청구 · 정산, 세금계산서 발행, 고객 지원</td>
                <td>동의 불필요<br /><span style="color:#7e8a98;font-size:13px;">(계약의 체결 · 이행에 필요, 법 제15조①4호)</span></td>
              </tr>
              <tr>
                <td>서비스 운영</td>
                <td>계정 생성 · 관리, 본인 확인, 권한 관리, 부정이용 방지, 장애 대응, 접속기록 보관</td>
                <td>동의 불필요<br /><span style="color:#7e8a98;font-size:13px;">(계약 이행 및 법령상 의무 이행)</span></td>
              </tr>
              <tr>
                <td>이용 분석 · 개선</td>
                <td>웹사이트 이용 통계 분석, 콘텐츠 · 사용성 개선</td>
                <td><strong>동의 필요</strong><br /><span style="color:#7e8a98;font-size:13px;">(쿠키 배너에서 동의한 경우에만)</span></td>
              </tr>
              <tr>
                <td>마케팅 · 뉴스레터</td>
                <td>자료 발송, 세미나 · 웨비나 안내 등 영리목적 광고성 정보 전송</td>
                <td><strong>동의 필요</strong><br /><span style="color:#7e8a98;font-size:13px;">(정보통신망법 제50조에 따른 사전 동의)</span></td>
              </tr>
              <tr>
                <td>법령상 의무 이행</td>
                <td>세법 · 전자금융거래법 등 관계 법령상 보존 의무 이행, 분쟁 대응</td>
                <td>동의 불필요</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <section id="sec-2">
        <h2>2. 처리하는 개인정보의 항목</h2>

        <h3>가. 문의 · 데모 신청 시 (이용자가 직접 입력)</h3>
        <ul>
          <li><strong>필수</strong> : 회사명, 성명, 이메일 주소, 연락처</li>
          <li><strong>선택</strong> : 직책, 산업 분야, 문의 내용</li>
        </ul>
        <p style="font-size:13.5px;color:#7e8a98;">
          문의 내용란에 주민등록번호 · 건강정보 등 민감정보나 고유식별정보를 입력하지 마시기 바랍니다.
          회사는 해당 정보를 수집하지 않으며, 입력된 경우 확인 즉시 파기합니다.
        </p>

        <h3>나. 계약 체결 및 서비스 이용 시</h3>
        <ul>
          <li>고객사 담당자 정보 : 소속 · 부서, 성명, 직위, 이메일 주소, 연락처</li>
          <li>계정 정보 : 계정 ID(이메일), 비밀번호(암호화 저장), 권한 등급</li>
          <li>계약 · 정산 정보 : 계약서 · 주문서 기재사항, 세금계산서 발행 정보(사업자등록번호, 담당자 연락처)</li>
        </ul>

        <h3>다. 서비스 이용 과정에서 자동으로 생성 · 수집되는 정보</h3>
        <ul>
          <li>접속 IP 주소, 접속 일시, 서비스 이용 기록, 요청 URL, 리퍼러(유입 경로)</li>
          <li>브라우저 종류 · 버전, 운영체제, 기기 유형, 화면 해상도, 언어 설정</li>
          <li>쿠키 및 유사 기술이 생성하는 임의 식별자</li>
          <li><strong>동의한 경우에 한하여</strong> : 페이지 이동 · 클릭 · 스크롤 등 상호작용 기록, 화면 조작 기록(세션 리플레이)</li>
        </ul>
        <p style="font-size:13.5px;color:#7e8a98;">
          분석 쿠키(Google Analytics · Mixpanel)는 최초 방문 시 표시되는 동의 배너에서
          <strong>'모두 허용'을 선택한 경우에만</strong> 활성화됩니다. 자세한 내용은 <a href="/cookie-policy">쿠키 정책</a>을 참고하세요.
        </p>

        <h3>라. 정보주체 이외로부터 수집하는 개인정보</h3>
        <p>
          회사는 전시회 · 세미나 등 오프라인 행사에서 참가자가 직접 제출한 명함 · 참가신청서를 통해
          소속 · 성명 · 직위 · 연락처 · 이메일 주소를 수집할 수 있습니다.
          이 경우 「개인정보 보호법」 제20조에 따라 정보주체의 요구가 있으면 수집 출처와 처리 목적을 지체 없이 알려드립니다.
        </p>
      </section>

      <section id="sec-3">
        <h2>3. 만 14세 미만 아동의 개인정보 처리</h2>
        <p>
          회사의 웹사이트와 서비스는 <strong>기업 간 거래(B2B)를 대상으로</strong> 하며, 만 14세 미만 아동을 대상으로 하지 않습니다.
          회사는 만 14세 미만 아동의 개인정보를 수집하지 않으며, 수집된 사실이 확인되는 경우 지체 없이 파기합니다.
        </p>
      </section>

      <section id="sec-4">
        <h2>4. 개인정보의 처리 및 보유 기간</h2>
        <p>회사는 법령에 따른 보유 · 이용기간 또는 정보주체로부터 동의받은 보유 · 이용기간 내에서 개인정보를 처리 · 보유합니다.</p>
        <div class="legal-table-wrap">
          <table class="legal-table">
            <thead><tr><th>구분</th><th>보유 기간</th><th>근거</th></tr></thead>
            <tbody>
              <tr><td>문의 · 데모 신청 기록</td><td>문의 처리 완료 후 <strong>3년</strong><br /><span style="color:#7e8a98;font-size:13px;">(사업상 문의 이력 관리 및 분쟁 대응 목적)</span></td><td>동의</td></tr>
              <tr><td>계약 · 거래 관련 기록</td><td>계약 종료 후 <strong>5년</strong></td><td>상법 제33조, 국세기본법 제85조의3</td></tr>
              <tr><td>대금 결제 · 재화 공급 기록</td><td><strong>5년</strong></td><td>전자상거래법 제6조</td></tr>
              <tr><td>소비자 불만 · 분쟁 처리 기록</td><td><strong>3년</strong></td><td>전자상거래법 제6조</td></tr>
              <tr><td>서비스 접속 기록(로그인 기록)</td><td><strong>1년 이상</strong>(고유식별정보 · 민감정보 처리 시 2년 이상)</td><td>「개인정보의 안전성 확보조치 기준」 제8조</td></tr>
              <tr><td>계정 정보</td><td>계약 종료 후 <strong>30일</strong> 이내 파기<br /><span style="color:#7e8a98;font-size:13px;">(데이터 반출을 위한 유예 기간)</span></td><td>계약</td></tr>
              <tr><td>마케팅 수신 동의 기록</td><td>수신 동의 철회 시까지</td><td>동의</td></tr>
              <tr><td>분석 도구 수집 정보</td><td>Google Analytics <Ph value={retention.ga} label="보관기간" /> · Mixpanel <Ph value={retention.mixpanel} label="보관기간" /> · 세션 리플레이 <Ph value={retention.mixpanelReplay} label="보관기간" /></td><td>동의</td></tr>
            </tbody>
          </table>
        </div>
        <p>회사는 별도의 휴면계정(미이용자 분리보관) 정책을 운영하지 않으며, 위 보유기간이 경과하면 지체 없이 파기합니다.</p>
      </section>

      <section id="sec-5">
        <h2>5. 개인정보의 파기 절차 및 방법</h2>
        <p>회사는 개인정보 보유기간의 경과, 처리목적 달성 등 개인정보가 불필요하게 되었을 때에는 지체 없이(정당한 사유가 없는 한 <strong>5일 이내</strong>) 해당 개인정보를 파기합니다.</p>
        <ul>
          <li><strong>파기 절차</strong> : 파기 사유가 발생한 개인정보를 선정하고, 개인정보 보호책임자의 승인을 받아 파기합니다.</li>
