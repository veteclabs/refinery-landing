---
// AI 데이터 처리 안내(한국어). 앱 리포(veteclabs/refinery)의 정적 페이지 /ai-data-notice
// (apps/web/app/ai-data-notice/page.tsx)를 옮긴 것이다. 앱은 이 주소로 링크만 건다.
//
// 문장은 앱과 같아야 한다 — 앱의 첫 사용 안내 · 입력창 안내 · 조직 AI 탭이 같은 문장
// (apps/web/lib/agent/ai-credit-path.ts 의 AI_NOTICE)을 쓴다. 문장을 다듬지 말고, 앱 문구가 바뀌면
// 아래 AI_NOTICE · PATH_ROWS · COMMON 을 앱 소스에서 다시 옮긴다. 영어판(en/ai-data.astro)도 함께 고친다.
// 예외는 앱 화면을 전제한 표현 둘뿐이다 — 공개 사이트에서는 「이 서버」가 refinery.kr 로 읽혀 「귀사 서버」로,
// 시스템 자격증명 화면용 「여기 등록한 AI 키는 …」 는 「귀사가 등록한 AI 키로 쓴 …」 로 바꿨다. 다시 옮길 때도 유지한다.
//
// 가운뎃점 · 괄호 뒤 조사의 줄바꿈 처리만 법적 고지 네 페이지의 관례를 따른다(typeset). 소스 문자열은
// 앱과 같은 일반 공백으로 두고 그릴 때만 바꾸므로, 앱과 대조할 때는 이 파일의 문자열을 그대로 비교하면 된다.
//
// 약관이 아니라 안내라 시행일 · 초안 경고 · 개정 이력이 없다.
// 푸터 · 내비에 노출하지 않고 앱의 링크로만 연다 → noindex, sitemap 에서도 뺀다(astro.config.mjs).
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/legal.css';

const alternates = [
  { lang: 'ko', href: '/ai-data' },
  { lang: 'en', href: '/en/ai-data' },
];

// 가운뎃점 앞 공백을 얇은 공백(U+2009) + WORD JOINER(U+2060)로, 뒤 공백을 얇은 공백으로 바꿔 줄이
// 가운뎃점으로 시작하지 않게 하고, 닫는 괄호 뒤 조사 앞에 WJ 를 넣어 조사가 줄 앞으로 떨어지지 않게 한다.
// 법적 고지 네 페이지가 글자로 적어 둔 것과 같은 결과다(커밋 b1f8d24 · b47b6e1).
const typeset = (s: string) =>
  s.replaceAll(' · ', ' ⁠· ').replace(/\)(?=[가-힣])/g, ')⁠');

// 앱 AI_NOTICE 중 이 페이지가 쓰는 값. 앱은 문자열 이어 붙이기로 적었고 여기서는 한 줄로 풀었다.
const AI_NOTICE = {
  vetecCreditFlow:
    '입력한 내용은 답변을 만들기 위해 베텍 AI 게이트웨이를 거쳐 AI 모델 제공사(Anthropic, 미국)에 전달됩니다. 베텍은 대화 내용을 저장하지 않으며 사용량(토큰 수 · 모델 · 시각)만 기록합니다.',
  customerKeyFlow:
    '입력한 내용은 귀사의 AI 모델 제공사 계정으로 직접 전달되며 베텍 서버를 거치지 않습니다. 베텍은 대화 내용을 받지 않습니다. 온라인 운영 방식이면 귀사 서버가 베텍에 보내는 상태 보고에 AI 호출 수와 토큰 수가 들어갑니다.',
  inputProhibition:
    '개인정보(이름 · 연락처 · 주민등록번호 등), 비밀값(비밀번호 · API 키), 계약 · 단가 정보는 입력하지 마세요. 설비 데이터는 답변에 필요한 범위만 자동으로 포함됩니다.',
  humanReview:
    '베텍 직원은 대화 내용을 볼 수 없습니다. 장애 진단을 위해 임시 기록이 필요하면 귀사 담당자의 동의를 받아 기간을 정해 수집하고, 끝나면 삭제합니다.',
  training:
    '베텍은 대화 내용을 AI 모델 학습에 쓰지 않습니다. 서비스 품질 분석은 조직 관리자가 동의한 경우에만 개인정보를 제거한 뒤 집계 형태로 수행합니다.',
  dataAccess:
    'AI 에이전트는 답변에 필요할 때만 귀사 서버의 설비 · 시계열 · 문서 데이터를 읽습니다. 상시 수집은 없습니다.',
  deletion:
    '대화 이력은 조직 관리자가 귀사 서버에서 삭제할 수 있습니다. 베텍에 기록된 사용량 정보의 열람 · 삭제는 계약 담당자를 통해 요청하세요.',
  systemCredential:
    '귀사가 등록한 AI 키로 쓴 사용량은 베텍 크레딧에서 차감되지 않습니다.',
  purchaseGuidance: '추가 크레딧이 필요하면 Refinery 운영팀에 문의해 주세요.',
};

const PATH_ROWS: { label: string; vetec: string; customer: string }[] = [
  {
    label: '입력한 내용이 가는 곳',
    vetec: '베텍 AI 게이트웨이를 거쳐 AI 모델 제공사(Anthropic, 미국)',
    customer: '귀사의 AI 모델 제공사 계정으로 직접 갑니다. 베텍 서버를 거치지 않습니다.',
  },
  {
    label: '베텍이 저장하는 것',
    vetec: '대화 내용은 저장하지 않습니다. 사용량(토큰 수 · 모델 · 시각 · 설치본 · 조직)과 접속 기록만 남깁니다.',
    customer: '대화 내용은 받지 않습니다. 온라인 운영 방식이면 상태 보고에 담긴 AI 호출 수와 토큰 수를 받습니다.',
  },
  {
    label: '보관 기간',
    vetec: '사용량 기록은 건별로 2년 보관한 뒤 조직 · 설치본별 월별 집계만 남깁니다.',
    customer: '상태 보고는 90일 보관합니다. 호출별 사용량 기록은 귀사 서버 안에만 남습니다.',
  },
  {
    label: '사용 금액',
    vetec: '베텍이 제공한 AI 크레딧에서 베텍 콘솔이 차감합니다. 다 쓰면 AI 실행이 멈춥니다.',
    customer: '귀사와 AI 모델 제공사 사이의 계약을 따릅니다. 베텍 크레딧에서 차감되지 않습니다.',
  },
];

const COMMON: { title: string; body: string }[] = [
  { title: '입력하지 말아야 할 정보', body: AI_NOTICE.inputProhibition },
  { title: '데이터 접근 범위', body: AI_NOTICE.dataAccess },
  { title: '사람의 열람', body: AI_NOTICE.humanReview },
  { title: '학습과 분석', body: AI_NOTICE.training },
  {
    title: '삭제와 열람 요청',
    body: AI_NOTICE.deletion + ' 실행 경로를 바꿔도 지금까지의 대화 이력은 자동으로 지워지지 않습니다.',
  },
  {
    title: '문제가 있는 답변',
    body: '답변 아래의 평가 버튼으로 알려 주세요. 평가 버튼이 보이지 않으면 조직 관리자나 Refinery 운영팀에 알려 주세요.',
  },
  {
    title: '이용 대상',
    body: '조직 계정으로 로그인한 업무용 기능입니다. 로그인하지 않은 사용과 대화 공유 기능은 없습니다.',
  },
];
---
<BaseLayout
  title="AI 데이터 처리 안내 | Refinery"
  description="리파이너리 온프레미스의 AI 기능이 입력 내용을 어디로 보내고 무엇을 기록하는지 알려 드립니다."
  canonical="/ai-data"
  robots="noindex, follow"
  alternates={alternates}
>
  <Nav />
  <main class="legal-main">
    <h1>AI 데이터 처리 안내</h1>

    <div class="legal-body">
      <p>
        리파이너리 온프레미스에서 AI 에이전트, 렌즈의 AI 요약 같은 AI 기능을 쓸 때 입력한 내용이 어디로 가고 무엇이
        기록되는지 알려 드립니다. AI 는 서버마다 정해진 두 경로 중 하나로 실행됩니다. 귀사 서버의 경로는 조직 설정의{' '}
        <strong>AI</strong> 탭에서 확인할 수 있습니다.
      </p>

      <section>
        <h2>실행 경로</h2>
        {/* 행 머리 표(처리방침 15항과 같은 꼴)에 열 머리를 더했다. 칸이 모두 문장이라 수식 클래스 없이
            기본 .legal-table 그대로 둔다(문장 칸은 왼쪽 · 위 정렬). */}
        <div class="legal-table-wrap">
          <table class="legal-table">
            <thead>
              <tr><th scope="col">항목</th><th scope="col">베텍 제공 크레딧</th><th scope="col">귀사의 AI 키</th></tr>
            </thead>
            <tbody>
              {PATH_ROWS.map((row) => (
                <tr><th scope="row">{row.label}</th><td>{typeset(row.vetec)}</td><td>{typeset(row.customer)}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="legal-note">
          조직이 자기 AI 키를 연결한 모델로 실행하는 대화는 서버의 경로와 관계없이 귀사의 AI 키 경로로 실행됩니다.
        </p>
      </section>

      <section>
        <h2>베텍 제공 크레딧으로 실행할 때</h2>
        <ul>
          <li>{typeset(AI_NOTICE.vetecCreditFlow)}</li>
          <li>
            AI 에이전트가 답변에 필요해 함께 보내는 설비 데이터도 같은 경로로 AI 모델 제공사에 전달됩니다. 전달 목적은
            답변 생성입니다.
          </li>
          <li>보안과 사용량 제한을 위해 귀사 서버의 공인 IP 주소를 접속 기록으로 남깁니다.</li>
          <li>AI 모델 제공사 쪽의 보관과 이용 조건은 계약 담당자를 통해 확인할 수 있습니다.</li>
          <li>크레딧을 모두 쓰면 AI 실행이 멈춥니다. {typeset(AI_NOTICE.purchaseGuidance)}</li>
        </ul>
      </section>

      <section>
        <h2>귀사의 AI 키로 실행할 때</h2>
        <ul>
          <li>{typeset(AI_NOTICE.customerKeyFlow)}</li>
          <li>{typeset(AI_NOTICE.systemCredential)}</li>
          <li>AI 모델 제공사와의 계약과 데이터 조건은 귀사와 제공사 사이에서 정해집니다.</li>
        </ul>
      </section>

      <section>
        <h2>두 경로 공통</h2>
        {/* 쿠키 정책 1항과 같은 '굵은 항목명 : 설명' 목록이다. */}
        <ul>
          {COMMON.map((item) => (
            <li><strong>{item.title}</strong> : {typeset(item.body)}</li>
          ))}
        </ul>
      </section>

      <section>
        <h2>함께 적용되는 정책</h2>
        <p>
          납품 계약과 처리 위탁 약정, 리파이너리 <a href="/terms">이용약관</a>과{' '}
          <a href="/privacy">개인정보 처리방침</a>이 함께 적용됩니다. 이 안내는 리파이너리 온프레미스 기준입니다.
        </p>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>
