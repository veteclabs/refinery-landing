---
// 영어판 플랫폼 개요. 한국어 /why-refinery.astro를 옮긴 것이다.
// ⚠️ 두 파일은 사전을 공유하지 않는 복제 관계다 — 카피를 고치면 양쪽을 함께 고쳐야 한다.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/industry.css';
import RfIcon from '../../components/RfIcon.astro';

const SITE = 'https://refinery.kr';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Why Refinery | Refinery',
  url: `${SITE}/en/why-refinery`,
  isPartOf: { '@type': 'WebSite', name: 'Refinery', url: `${SITE}/` },
};

// '현장이 먼저입니다' 3장은 회사 소개의 '일하는 세 가지 기준'과 같은 말이었다.
// 일하는 방식은 회사 이야기이므로 /en/company 에 두고, 여기서는 한 줄로만 짚고 넘긴다.
// 이 페이지는 제품 본문(왜 운영체제인가 → 흐름 → 기능)에 집중한다.

// 기능 스토리 3 — 통합 / AI 에이전트 / 자동화
const stories = [
  {
    image: '/why-refinery/story-01.svg',
    eyebrow: 'Integration',
    title: 'Scattered data into one<br>body of knowledge',
    points: [
      'SCADA, MES and ERP are gathered in one place.',
      'An ontology gives data the meaning of what it is.',
      'Numbers and records gain context and serve judgment.',
    ],
  },
  {
    image: '/why-refinery/story-02.svg',
    eyebrow: 'AI agent',
    title: 'A field that answers<br>when you ask',
    points: [
      'Ask what you want to know and it answers from the data.',
      'It infers causes and suggests the next action.',
      'The data sources behind the answer are given too.',
    ],
  },
  {
    image: '/why-refinery/story-03.svg',
    eyebrow: 'Automation',
    title: 'Operations that run<br>without people',
    points: [
      'You decide through conversation what runs automatically.',
      'Analysis flows into reports and workflow execution.',
      'Repeated work is handled automatically, with no manual steps.',
    ],
  },
];

// 왜 운영체제인가 — 연결부터 판단까지 네 개의 층. 아래 기능 카드와 같은 틀에 칩 대신 설명을 둔다.
// 아이콘은 기능 카드(capabilityGroups)와 겹치지 않게 골랐다.
/* 아이콘은 이 섹션만의 한 벌이다(src/icons/light/os-*.svg) — 호버하면
   도는 인라인 SVG 라 RfIcon 으로 넣는다. 기능 카드의 Phosphor 글꼴과는
   다른 것이니 섞지 말 것. */
const layers = [
  { title: 'Connection', icon: 'os-connect', desc: 'Gateways and connectors link equipment, sensors, SCADA, MES and ERP. Your systems stay put.' },
  { title: 'Ontology', icon: 'os-ontology', desc: 'Assets, tasks and documents are defined in one model. Every app and the AI agent share it.' },
  { title: 'Apps', icon: 'os-app', desc: 'Dashboards, analysis and workflows share one model. A new app inherits its data and rights.' },
  { title: 'AI agent', icon: 'os-agent', desc: 'People ask, and the AI answers with its evidence. Actions need approval and stay on record.' },
];

// 아이콘은 예지보전 '푸는 방식' 카드와 같은 Phosphor 폰트를 쓴다.
// 이 페이지 다른 곳에서 쓰는 것과 겹치지 않게 골랐다.
const capabilityGroups = [
  { title: 'Data', icon: 'cap-data', items: ['Ontology', 'Unified dashboard', 'Pipeline', 'Time-series analysis', 'Turning documents into knowledge', 'Connecting to existing systems'] },
  { title: 'Intelligence', icon: 'cap-ai', items: ['AI agent', 'Anomaly detection', 'Alarms', 'Predictive maintenance', 'Quality prediction', 'Energy optimization'] },
  { title: 'Operations', icon: 'cap-ops', items: ['Automation', 'Workflows', 'Report automation', 'ESG reports'] },
  { title: 'Trust', icon: 'cap-trust', items: ['On-premises deployment', 'Permissions', 'Encryption'] },
];
---
<BaseLayout
  title="Why Refinery ⁠· An industrial AI OS built by a team that knows the field | Refinery"
  description="Scattered field data is tied into one body of knowledge, and AI helps you decide with the evidence shown. Layer onto what you have or build new where there is none, and one operating system brings intelligence to the field."
  canonical="/en/why-refinery"
  jsonLd={jsonLd}
>
  <Nav />
  {/* ind-page — 솔루션(산업별 · 과제별)과 같은 값을 쓰는 갈고리다. 국문과 같다. */}
  <main class="ind ind-page wr-page">
    <!-- HERO -->
    {/* 히어로는 솔루션(산업별 · 과제별)과 같은 구성이다 — 국문과 같다.
        값은 전부 industry.css 의 .ind-hero-bg 계열이 쥔다.
        ⚠️ 히어로에는 버튼을 두지 않는다. 전환은 페이지 맨 아래 CTA 가 받는다. */}
    <section class="ind-hero ind-hero-bg">
      <div class="ind-container">
        <div class="ind-hero-row">
          <p class="ind-eyebrow">Product overview</p>
          <h1>One operating system that brings<br>intelligence to the field</h1>
          <p class="ind-lede">From data collection through ontology, AI analysis, prediction and automated execution, scattered field sites are tied into one unified intelligence.</p>
        </div>
      </div>
      <div class="ind-hero-figure">
        {/* 띠 안의 모습은 옛 히어로 그대로다 — 어두운 면 위에 대시보드를 옅게
            얹고, 왼쪽으로 갈수록 사라지는 가로 그라데이션과 아래쪽 흐림을 건다.
            자리값(칸 56% · 이미지 1180px · -140px · -205px · 불투명도 .3)도
            옛 히어로에서 그대로 가져왔다. */}
        <div class="wr-figure-face">
          {/* 바탕 사진도 옛 히어로 그대로다 — 랜딩 CTA(#cta)와 같은 파일이고,
              #191F27 면 위에 .9 로 얹는 것이 전부다(어두운 막을 따로 덮지
              않는다). 사진 자체의 결이 질감을 맡는다. 그 위에 대시보드가
              옅게 올라간다. */}
          <img class="wr-figure-bg" src="/img_login-bg.webp" alt="" aria-hidden="true"
               width="3840" height="2160" decoding="async" fetchpriority="high" />
          <div class="wr-hero-fx" aria-hidden="true">
            <div class="wr-hero-fx-inner">
              <img src="/why-refinery-dash.webp" alt="" width="2586" height="3512" decoding="async" />
            </div>
          </div>
        </div>
      </div>
    </section>
    <script is:inline>
      {/* 히어로 사진 넓히기 — 솔루션(IndustryPage)과 같은 스크립트다.
          스크롤을 내린 만큼 --grow 를 0 → 1 로 올려 사진이 화면 폭을 꽉 채우며
          모서리가 펴진다.
          ⚠️ 쓰는 값은 scrollY 다. 사진의 화면 안 위치로 재면 첫 화면에서 이미
             절반쯤 자란 상태로 뜬다 — '기본 모습에서 스크롤할 때' 가 아니다.
          ⚠️ 360px 을 다 내리면 꽉 찬다. 내비(70px)가 사진 윗변에 닿을 즈음이다.
          ⚠️ 동작 줄이기를 켠 사람에게는 손대지 않는다 — 기본 모습 그대로다. */}
      (function () {
        var fig = document.querySelector('.ind-hero-figure');
        if (!fig) return;
        if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var D = 360, last = -1, ticking = false;
        function upd() {
          var p = Math.min(1, Math.max(0, (window.scrollY || window.pageYOffset) / D));
          p = Math.round(p * 1000) / 1000;
          if (p === last) return;
          last = p;
          fig.style.setProperty('--grow', p);
        }
        function onScroll() {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(function () { ticking = false; upd(); });
        }
        addEventListener('scroll', onScroll, { passive: true });
        addEventListener('resize', onScroll, { passive: true });
        upd();
      })();
    </script>


    <!-- WHY AN OS -->
    <section class="ind-section">
      <div class="ind-container">
        <header class="ind-head wr-head-row">
          <h2>Why an operating system</h2>
          {/* ⚠️ 소제목은 화면에 내지 않는다 — 산업별 페이지와 같은 처리다.
              제목 오른쪽에 18px 한 줄만 떠 있어 머리글이 두 덩어리로 읽혔다. */}
        </header>
        {/* 카드는 회사 소개 '일하는 세 가지 기준'(.cmp-rule-card)과 같은 것이다 —
            옅은 면 · 두 겹 그림자 · 왼쪽 위 번호 배지 · 가운데 정렬 · 큰 아이콘.
            ⚠️ 저쪽은 카드가 셋이고 여기는 넷이다. 칸 수만 다르다. */}
        <div class="wr-layers">
        {/* ⚠️ rf-ic-host 를 카드에 함께 준다 — 아이콘 모션은 조상에 이 클래스가
            있을 때만 돈다. 빠뜨리면 영영 0% 자세로 서 있다.
            회사 소개 기준 카드(.cmp-rule-card)와 같은 처리다. */}
          {layers.map((l, i) => (
            <div class="wr-layer rf-ic-host">
              {/* ⚠️ 숫자를 한 겹 더 감싼다 — 국문과 같다. 글자를 원 한가운데로
                  내리는 데 0.35px 이 모자란데 패딩으로는 못 준다(크롬이 글줄의
                  세로 자리를 정수 픽셀에 붙인다). transform 만 듣는다. */}
              <span class="wr-layer-num"><span>{i + 1}</span></span>
              {/* 그래픽 — 160x160 이다(회사 소개 기준 카드와 같은 값).
                  이 섹션은 밝은 면(--bg-soft)이라 light 세트를 쓴다. */}
              <RfIcon name={l.icon} theme="light" class="wr-layer-fig" />
              <h3>{l.title}</h3>
              <p>{l.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- STORY BLOCKS -->
    {/* ⚠️ 섹션 머리글을 두지 않는다 — 제목은 왼쪽 칸이 들고 있다(국문과 같다). */}
    {/* ⚠️ 섹션에 ind-usecases 를 달지 않는다 — 그 클래스는 display: grid 라
        안의 .ind-container 가 격자 칸이 되어 폭이 1440 에서 1402px 으로
        줄었다(실측). 아래 .ind-uc-* 규칙들은 그 클래스를 필요로 하지 않는다. */}
    <section class="ind-section wr-flow">
      <div class="ind-container">
        <div class="ind-uc-shell">
          <div class="ind-uc-aside">
            <h2>One flow across<br>Refinery</h2>
          </div>
          <ol class="ind-uc-list">
            {stories.map((s) => (
              <li class="ind-uc-item">
                <div class="ind-uc-text">
                  <span class="ind-sec-label">{s.eyebrow}</span>
                  <h3 set:html={s.title}></h3>
                  <ul class="wr-flow-points">
                    {s.points.map((p) => <li>{p}</li>)}
                  </ul>
                </div>
                <div class="ind-uc-card">
                  <img class="ind-uc-img" src={s.image} alt="" width="1920" height="1080" loading="lazy" decoding="async" />
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- CAPABILITIES -->
    <section class="ind-section">
      <div class="ind-container">
        <header class="ind-head wr-head-row">
          <h2>All in one place</h2>
          {/* ⚠️ 소제목은 화면에 내지 않는다 — 위 '왜 운영체제인가' 와 같다. */}
        </header>
        {/* 카드는 산업별 '솔루션 구조'(.ind-flow)와 같다 — 국문과 같은 구성.
            하나씩 뜨는 모션은 섹션 바로 아래의 인라인 스크립트가 쥔다. */}
        <div class="ind-flow wr-caps">
          {capabilityGroups.map((g) => (
            <div class="ind-flow-step">
              <div class="ind-flow-head">
                <span class="ind-flow-label">{g.title}</span>
              </div>
              {/* 차례는 제목 · 그림 · 내용이다 — 산업별 '솔루션 구조' 카드와 같다.
                  ⚠️ RfIcon(인라인 SVG)이 아니라 그림 파일이다. 3D 아이소메트릭이라
                     SVG 로 그릴 수 있는 것이 아니다 — public/icons/capability 아래
                     512px webp 와 1024px @2x 를 둔다.
                  ⚠️ 원본은 src/icons/capability-3d 에 세 벌(어두운 면 · 흰 면 ·
                     선 없는 plain)이 있다. 카드 면이 흰색이라 저쪽 솔루션 구조와
                     같은 plain 을 골라 여기로 복사했다. */}
              <img
                class="ind-flow-img"
                src={`/icons/capability/${g.icon}.webp`}
                srcset={`/icons/capability/${g.icon}.webp 1x, /icons/capability/${g.icon}@2x.webp 2x`}
                width="200" height="200"
                alt="" aria-hidden="true" loading="lazy" decoding="async"
              />
              <ul class="ind-flow-detail">
                {g.items.map((it) => <li>{it}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>
    {/* 기능 카드만 하나씩 뜬다.
        ⚠️ 공용 ScrollReveal 을 쓰지 않는다. 그쪽은 선택자 목록이 한 벌로 묶여
           있어(.ind-head · .ind-uc-aside · .ind-uc-item 등) 이 페이지에서만
           카드를 빼낼 수 없다 — 들이면 섹션 머리와 흐름 항목까지 함께 뜬다.
           목록을 고치면 산업별 · 과제별 페이지가 같이 바뀐다.
        ⚠️ 숨기는 일을 CSS 가 아니라 이 스크립트가 맡는다. CSS 로 숨겨 두면
           JS 가 막혔을 때 카드가 영영 안 보인다 — 숨기는 쪽을 기본값으로
           두지 않는 까닭이다(공용 모션이 .rv-on 을 붙이는 것과 같다).
        ⚠️ 섹션 바로 뒤에 둔다. 파싱이 여기 닿는 순간 카드는 이미 있고 아직
           그려지기 전이라, 첫 페인트부터 숨은 채로 시작한다. 뒤로 미루면
           보였다가 사라지는 깜빡임이 난다. */}
    <script is:inline>
      (function () {
        if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var row = document.querySelector('.wr-caps');
        if (!row) return;
        var cards = [].slice.call(row.querySelectorAll('.ind-flow-step'));
        if (!cards.length) return;

        /* 한 장씩 뜨는 간격. 공용 모션의 기본 60ms 보다 한 박자 느리다 — 한
           장씩 뜨는 것이 읽혀야 한다. 산업별 솔루션 구조의 300ms 는 쓰지
           않는다. 그 값은 한 칸씩 짚어 가는 '차례' 를 보이려는 것이라,
           번호를 걷어 낸 이 카드에 없는 순서를 있는 것처럼 읽히게 한다. */
        var STEP = 120, DUR = 550, EASE = 'cubic-bezier(.2,.7,.2,1)';

        cards.forEach(function (n) {
          n.style.opacity = '0';
          n.style.transform = 'translateY(16px)';
          n.style.transition = 'opacity ' + DUR + 'ms ' + EASE + ', transform ' + DUR + 'ms ' + EASE;
        });

        /* 다 뜨고 나면 인라인 값을 통째로 걷는다. 남겨 두면 여기서 건 지연이
           카드 제 호버 효과까지 늦춘다. */
        function clean(n) {
          n.style.transition = ''; n.style.transitionDelay = '';
          n.style.opacity = ''; n.style.transform = '';
        }

        /* 끝내 한 장도 안 떴더라도 글은 보여야 한다. */
        var guard = setTimeout(function () { cards.forEach(clean); cards.length = 0; }, 6000);

        /* ⚠️ 지연은 처음에 박지 않고 선에 걸리는 순간에 준다. 한 번에 걸린
           것끼리만 차례를 매긴다 — 넓은 폭에서는 넉 장이 한 줄이라 같은
           순간에 걸려 0 · 120 · 240 · 360ms 로 뜨고, 좁은 폭에서 한 열로
           쌓이면 카드마다 제 차례에 혼자 걸려 지연 없이 뜬다.
           처음에 i * STEP 을 박아 두면 좁은 폭에서 아래 카드들이 화면 밖에
           있는 동안 다 떠 버려 모션이 사라진다. */
        function sweep() {
          if (!cards.length) return;
          var line = (window.innerHeight || 0) * 0.88, k = 0;
          for (var i = cards.length - 1; i >= 0; i--) {
            if (cards[i].getBoundingClientRect().top >= line) continue;
            cards[i].__k = k++;
            cards[i].__go = true;
          }
          if (!k) return;
          clearTimeout(guard);
          for (var j = cards.length - 1; j >= 0; j--) {
            var n = cards[j];
            if (!n.__go) continue;
            /* 뒤에서부터 훑어 위 카드가 큰 번호를 받았다 — 뒤집어 준다. */
            n.style.transitionDelay = (k - 1 - n.__k) * STEP + 'ms';
            n.addEventListener('transitionend', function () { clean(this); }, { once: true });
            n.style.opacity = ''; n.style.transform = '';
            cards.splice(j, 1);
          }
          if (!cards.length) {
            removeEventListener('scroll', onScroll);
            removeEventListener('resize', onScroll);
          }
        }

        var ticking = false;
        function onScroll() {
          if (ticking || !cards.length) return;
          ticking = true;
          requestAnimationFrame(function () { ticking = false; sweep(); });
        }
        addEventListener('scroll', onScroll, { passive: true });
        addEventListener('resize', onScroll, { passive: true });
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', sweep);
        else sweep();
      })();
    </script>

    <!-- CTA -->
    {/* 솔루션 CTA(.ind-cta-bg)와 같은 스타일이다 — 그래픽만 이 페이지 것을 쓴다. */}
    <section class="ind-cta ind-cta-bg">
      <img class="wr-cta-bg-img" src="/use-cases/cta-bg.webp" alt="" aria-hidden="true" loading="lazy" decoding="async" />
      <div class="ind-container">
        <h2>Solve what your field faces<br>with the <span translate="no">Refinery</span> team.</h2>
        <a href="/en/contact" class="ind-btn-primary ind-btn-lg">Contact</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  /* 본문 좌우를 헤더(.nav-inner)와 같은 선에 맞춘다 — 로고 왼쪽 = 문의하기 버튼 오른쪽.
     공통 .ind-container는 1120/24라 내용이 헤더보다 49px 안쪽에서 시작했다.
     예지보전 등 유즈케이스 페이지가 쓰는 값(1280/48)과 같다.
     .wr-page 스코프라 .ind-container를 쓰는 다른 페이지에는 영향이 없다. */
  /* 좁은 화면에서 '잇 / 습니다'처럼 어절 중간이 끊기지 않게 한다.
     한국어는 공백 없이도 어디서나 감기는 게 기본이라 명시해야 한다.
     URL·긴 영문은 감겨야 하므로 overflow-wrap은 열어둔다. */
  .wr-page, .wr-page * { word-break: keep-all; overflow-wrap: break-word; }

  .wr-page .ind-container { max-width: 1600px; padding: 0 48px; }
  @media (max-width: 900px) {
    .wr-page .ind-container { padding: 0 24px; }
  }

  /* ───────── 섹션 공통값을 예지보전(.uc-redesigned)과 맞춘다 ─────────
     industry.css의 공통값은 이 페이지들보다 촘촘하다. 유즈케이스가 이미
     랜딩 본문에 맞춰 늘려 쓰고 있으므로 같은 값을 그대로 가져온다.
       섹션 위아래 여백  84px  → 130px (좁은 화면 60px은 공통값과 같다)
       제목 아래 여백    44px  → 64px
       섹션 대제목  clamp(26,3.4vw,38) / 650 / -0.02em / 1.25
                  → clamp(28,4vw,45)  / 600 / -0.8px  / 1.3   (랜딩 대제목과 같은 값) */
  /* 섹션 위아래 여백은 산업별 페이지의 01번 섹션과 같은 값이다 — 넓은 폭
     180px · 900px 이하 84px. 한때 130 / 60 이었다. */
  .wr-page .ind-section { padding: 180px 0; }
  @media (max-width: 900px) {
    .wr-page .ind-section { padding: 84px 0; }
  }
  .wr-page .ind-head { margin-bottom: 64px; }
  .wr-page .ind-head h2 {
    font-size: clamp(28px, 4vw, 45px); font-weight: 600;
    letter-spacing: -0.8px; line-height: 1.3;
  }
  /* 섹션 소제목은 예지보전에 대응하는 요소가 없다(거기는 태그라인을 쓴다).
     대신 랜딩 .section-header p(18px / 1.7)에 맞춘다 — 이 페이지 히어로
     소제목도 이미 그 값이라, 16px로 두면 한 페이지 안에서 두 크기가 섞인다. */
  .wr-page .ind-head p { font-size: 18px; line-height: 1.7; }
  @media (max-width: 900px) { .wr-page .ind-head p { font-size: 16px; } }

  /* ───────── 히어로 — 예지보전(.uc-hero-bg)과 같은 구성 ─────────
     절대배치 사진 + 어두운 스크림 + 흰 글자. 브레드크럼과 영문 eyebrow를 빼고
     페이지 이름을 하늘색 태그라인으로 올렸다. */
  /* ───────── 히어로 — 솔루션(산업별 · 과제별)과 같은 구성 ─────────
     값은 전부 industry.css 의 .ind-hero-bg 계열이 쥔다. 국문과 같다.
     ⚠️ 어두운 전면 배경(.wr-hero-bg)·우측 대시보드 장식(.wr-hero-fx)·
        태그라인(.wr-tag)·히어로 버튼 규칙은 함께 걷었다. */
  /* 띠 안의 모습 — 옛 히어로 그대로다.
     ⚠️ 구도(글 아래 띠 · 스크롤에 따라 화면을 채움)는 솔루션 것이고, 띠 안의
        그림만 옛 히어로 값이다. 아래 세 규칙은 옛 .wr-hero-fx 계열을 그대로
        옮긴 것이다 — 칸 56% · 왼쪽 420px 그라데이션 · 아래 78% 흐림 ·
        이미지 1180px / right -140px / -205px / 불투명도 .3.
     ⚠️ 띠의 높이는 이제 이 면이 쥔다(옛 히어로의 min-height 615px 자리).
        값은 솔루션 사진과 같은 1920:720 이고, 좁은 폭에서는 16:10 이다. */
  .wr-page .wr-figure-face {
    position: relative; overflow: hidden;
    aspect-ratio: 1920 / 720;
    background: #191F27;
    /* 모서리는 띠와 함께 펴진다 — 솔루션 사진과 같은 식이다. */
    border-radius: calc(var(--radius) * (1 - var(--grow, 0)));
  }
  .wr-page .wr-figure-bg {
    /* 옛 .wr-hero-bg-img 와 같은 값이다. 100% = 위로 올릴 수 있는 끝 —
       이미지가 16:9 이고 띠는 그보다 납작해 cover 가 가로에 맞추므로,
       남는 세로가 전부 위로 빠진다. */
    position: absolute; inset: 0; width: 100%; height: 100%; opacity: .9;
    object-fit: cover; object-position: center 100%;
    pointer-events: none; user-select: none;
  }
  /* 칸은 띠 전체다. 56% 로 두었을 때는 왼쪽 420px 이 흐림으로 지워져
     띠의 왼쪽 절반 가까이가 빈 어두운 면이었다.
     흐림은 왼쪽 한쪽뿐이다 — 그림이 오른쪽 변에 붙어 있어 그쪽은 자를 것이
     없다. 길이는 띠 폭의 26% 로, 1600px 에서 416px 이라 옛 420px 과 같다.
     ⚠️ px 이 아니라 % 다. 띠는 다 펴지면 화면 폭만큼 넓어지는데, px 으로
        박으면 넓은 화면에서 흐림이 짧아져 그림이 툭 시작한다. */
  .wr-page .wr-hero-fx {
    position: absolute; right: 0; top: 0; bottom: 0; width: 100%;
    overflow: hidden; pointer-events: none; user-select: none;
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 26%);
            mask-image: linear-gradient(to right, transparent 0, #000 26%);
  }
  .wr-page .wr-hero-fx-inner {
    position: absolute; inset: 0; overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 78%, transparent 100%);
            mask-image: linear-gradient(to bottom, #000 0%, #000 78%, transparent 100%);
  }
  /* 그림을 띠 폭에 맞춘다.
     ⚠️ 폭을 px 으로 박으면 왼쪽 변이 띠 안에 들어와 칼선으로 드러난다 —
        흐림이 그 자리에서 이미 반쯤 진해져 있어 가려지지 않는다. 100% 면
        왼쪽 변이 띠 밖(또는 변 위)이라 흐림이 칼선이 아니라 내용을 녹인다.
     ⚠️ translateY 는 % 다. <img> 의 translateY % 는 제 높이 기준이고 높이는
        폭을 따라가므로, 폭이 달라져도 늘 같은 칸을 본다. 값은 옛 기준에서
        옮긴 것이다 — 1180px 에서 -205px 이고 그림이 2586x3512 라
        -205 / 1180 / (3512/2586) = -12.792%. */
  .wr-page .wr-hero-fx-inner img {
    position: absolute; right: 0; left: auto; top: 0;
    max-width: none; width: 100%; height: auto;
    transform: translateY(-12.792%);
    opacity: .3;
  }
  @media (max-width: 900px) {
    .wr-page .wr-figure-face { aspect-ratio: 16 / 10; }
    /* 좁은 폭의 값은 그대로 둔다 — 칸은 원래부터 띠 전체였고, 흐림 160px ·
       그림 820px / right -60px / -120px 도 손대지 않았다. 넓은 폭만 바뀐다. */
    .wr-page .wr-hero-fx {
      width: 100%;
      -webkit-mask-image: linear-gradient(to right, transparent 0px, #000 160px);
              mask-image: linear-gradient(to right, transparent 0px, #000 160px);
    }
    .wr-page .wr-hero-fx-inner img { right: -60px; width: 820px; transform: translateY(-120px); }
  }


  /* ───────── 네 개의 층 — 회사 소개 '일하는 세 가지 기준'과 같은 카드 ─────────
     값은 .cmp-rule-card 에서 그대로 가져왔다 — 옅은 면(--bg-soft) · 두 겹
     그림자 · 패딩 30 · 가운데 정렬 · 왼쪽 위 번호 배지(지름 30 · 글자 15) ·
     제목 26 / 1.3 · 본문 16 / 1.5 · 칸 사이 28px.
     ⚠️ 저쪽은 카드가 셋이고 여기는 넷이라 칸 수만 다르다.
     ⚠️ 저쪽 그래픽은 160px 짜리 3D 아이콘(RfIcon)이다. 네 층(연결 · 온톨로지 ·
        앱 · AI 에이전트)에 맞는 그림이 없어 글꼴 아이콘을 그 자리에 크게 둔다. */
  .wr-layers { display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; }
  .wr-layer {
    /* 테두리는 두르지 않는다 — 면과 바탕을 가르는 일은 첫 겹 그림자가 맡는다. */
    position: relative; overflow: hidden; text-align: center;
    background: var(--bg-soft); border-radius: var(--radius); padding: 30px;
    box-shadow:
      0 1px 2px rgba(22, 32, 44, 0.06),
      0 14px 30px -16px rgba(22, 32, 44, 0.16);
  }
  /* 번호는 흐름에서 빼 카드 왼쪽 위에 고정한다 — 흐름에 두면 아이콘을 아래로
     민다. 자리값 30px 은 카드 패딩과 같아 안쪽 내용과 같은 선에 선다. */
  .wr-layer-num {
    position: absolute; top: 30px; left: 30px; margin: 0;
    display: flex; align-items: center; justify-content: center;
    width: 30px; height: 30px; border-radius: 50%;
    background: var(--accent); border: 1px solid var(--accent);
    font-size: 15px; font-weight: 600; line-height: 1;
    letter-spacing: 0; color: #ffffff;
    font-variant-numeric: tabular-nums;
    /* 글리프를 원 한가운데로 내린다(회사 소개 배지와 같은 값). */
    padding-top: 0.09em;
  }
  /* '1' 만 따로 민다 — Roboto 의 '1' 은 제 폭 한가운데가 아니라 왼쪽에
     그려져 있다. 들여쓴 만큼 글줄 상자도 넓어져 글자는 절반만 움직인다. */
  .wr-layer:first-child .wr-layer-num { text-indent: 0.105em; }
  /* 패딩이 주지 못한 0.35px — 국문 주석에 까닭이 있다. */
  .wr-layer-num > span { display: block; transform: translateY(0.35px); }
  /* 그래픽 — 회사 소개 기준 카드(.cmp-rule-icon)와 같은 160x160 ·
     위 31 · 아래 32px 이다.
     ⚠️ :global 필수 — RfIcon 은 set:html 로 넣는 인라인 SVG라 Astro 스코프
        속성이 붙지 않는다. 평범한 선택자로 두면 규칙이 통째로 빗나간다. */
  :global(.wr-layer-fig) {
    display: block;
    width: 160px; height: 160px; margin: 31px auto 32px;
  }
  .wr-page .wr-layer h3 {
    margin: 0 0 12px; font-size: 26px; font-weight: 600; line-height: 1.3;
    color: var(--text); word-break: keep-all; text-wrap: balance;
  }
  .wr-page .wr-layer p {
    margin: 0; font-size: 16px; line-height: 1.5; color: var(--text-muted);
    text-wrap: pretty; word-break: keep-all;
  }
  /* 열이 줄어드는 기준은 기능 카드(.wr-caps)와 같다. */
  @media (max-width: 1023px) { .wr-layers { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 639px) { .wr-layers { grid-template-columns: 1fr; max-width: 420px; margin-inline: auto; } }

  /* 섹션 면 — 과제별 페이지 02번 섹션(.uc-redesigned .ind-soft)에서 그대로
     떠 왔다. 흰 면 위에 윗변 가운데에서 퍼지는 원형 빛 한 겹이다.
     ⚠️ 정지점 열셋은 smootherstep 으로 뽑은 값이다. 두 점짜리 radial 로
        줄이면 색이 사라지는 자리에 동그란 테가 보인다.
     ⚠️ --bg-soft 단색(#F6F8FA)이 아니다. 저쪽도 클래스 이름만 .ind-soft 이고
        면은 이 그라데이션으로 덮여 있다. */
  .wr-page .wr-flow {
    position: relative;
    background: #FFFFFF radial-gradient(62% 50% at 50% 0%,
      rgba(238, 244, 251, 1) 0%,
      rgba(238, 244, 251, 0.995) 8.33%,
      rgba(238, 244, 251, 0.965) 16.67%,
      rgba(238, 244, 251, 0.896) 25%,
      rgba(238, 244, 251, 0.79) 33.33%,
      rgba(238, 244, 251, 0.653) 41.67%,
      rgba(238, 244, 251, 0.5) 50%,
      rgba(238, 244, 251, 0.347) 58.33%,
      rgba(238, 244, 251, 0.21) 66.67%,
      rgba(238, 244, 251, 0.104) 75%,
      rgba(238, 244, 251, 0.035) 83.33%,
      rgba(238, 244, 251, 0.005) 91.67%,
      rgba(238, 244, 251, 0) 100%);
  }
  .wr-page .wr-flow > .ind-container { position: relative; z-index: 1; }

  /* 항목 안 배치 — 그림이 위, 글이 아래다.
     산업별 02번(글 왼쪽 · 그림 오른쪽, industry.css 의 .ind-uc-item)과
     다른 점이 여기뿐이다. 그림이 16:9 한 장짜리라 옆에 세우면 작아진다.
     ⚠️ 한 칸 두 줄이다. 칸을 둘로 두고 둘 다 1칸에 몰면 그림 칸의 상한
        (560px)이 그대로 남아 폭이 늘지 않는다. */
  .wr-page .wr-flow .ind-uc-item {
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto auto;
    row-gap: 28px;
  }
  .wr-page .wr-flow .ind-uc-item > .ind-uc-card { grid-area: 1 / 1; }
  .wr-page .wr-flow .ind-uc-item > .ind-uc-text { grid-area: 2 / 1; }

  /* 그림 카드 — 글 칸 폭을 꽉 채운다.
     ⚠️ max-width 를 풀어야 한다. industry.css 가 560px 을 박아 두어
        칸만 넓혀서는 그림이 따라 커지지 않는다.
     ⚠️ 비율은 그림 원본 그대로(1920:1080)다. 저쪽 560:320 은 잘라 낸
        판에 맞춘 값이라, 여기에 두면 위아래로 면이 남는다. */
  .wr-page .wr-flow .ind-uc-card {
    max-width: none;
    aspect-ratio: 1920 / 1080;
    /* 면은 흰색이다. 그림에 제 바탕이 없어(획과 점무늬만 그려져 있다)
       카드 면이 곧 그림 배경이 된다 — industry.css 의 #F6F8FA 를 덮는다. */
    background: #FFFFFF;
    /* ⚠️ 900px 이하에서 industry.css 가 카드를 글 아래로 내리며 margin-top: 20px
       을 준다. 여기서는 카드가 첫 줄이라 그 여백이 그림 위에 얹힌다. */
    margin-top: 0;
  }

  /* 항목 사이 가로선을 걷는다 — 그림이 이미 한 덩어리로 보여 선까지 두면
     칸막이가 둘이 된다. 산업별 02번은 글만 있어 선이 경계를 맡는다.
     ⚠️ 선을 걷으면 항목 사이가 위아래 44px 씩 88px 로 남는다. 그대로 둔다. */
  .wr-page .wr-flow .ind-uc-item { border-top: 0; }
  /* 첫 그림의 윗변을 왼쪽 제목(.ind-uc-aside h2)의 윗변에 맞춘다.
     industry.css 가 목록에 위 50px, 항목에 위아래 44px 을 주는데, 저쪽은 그
     50px 이 라벨 칩 높이를 받아 선이 곧 제목 윗변이었다. 여기서는 선을
     걷었으니 둘 다 0 으로 두어야 그림이 제목과 같은 선에서 시작한다. */
  .wr-page .wr-flow .ind-uc-list { margin-top: 0; }
  .wr-page .wr-flow .ind-uc-item:first-child { padding-top: 0; }
  /* 상자끼리 맞추면 글자는 그만큼 내려와 있다 — 줄높이 1.3 의 위쪽 반여백
     (0.15em)과 글리프 위 빈자리가 제목 잉크를 아래로 민다. 그만큼 제목을
     끌어올려 글자 윗변을 그림 윗변에 세운다.
     ⚠️ em 으로 적는다. 제목이 clamp(28px, 4vw, 45px) 이라 px 로 박으면
        폭이 바뀔 때 어긋난다(측정: 45px·44px 어느 쪽에서도 0.287em 이다).
     ⚠️ 값이 국·영문에서 다르다 — 한글 획이 라틴 대문자보다 위로 더 올라와
        같은 글꼴에서도 빈자리가 다르다(한글 0.287 · 라틴 0.323). */
  .wr-page .wr-flow .ind-uc-aside h2 { margin-top: -0.323em; }
  /* 그림은 카드를 변까지 채운다 — 좌우 28px 들여쓰기도, 아래로 사라지는
     마스크도 걷는다. 둘 다 잘라 낸 판(폭 464 고정)을 카드 가운데에 앉히려고
     있던 것이라, 제 비율로 꽉 차는 그림에는 쓸 데가 없다. */
  .wr-page .wr-flow .ind-uc-img {
    position: static;
    left: auto; top: auto;
    width: 100%; height: 100%;
    object-fit: cover;
    transform: none;
    -webkit-mask-image: none;
            mask-image: none;
  }

  /* 흐름 항목의 목록 — 산업별 02번 섹션의 내용 글과 같은 값이다(국문과 같다). */
  .wr-page .wr-flow-points {
    list-style: none; padding: 0; margin: 14px 0 0;
    display: flex; flex-direction: column; gap: 6px;
  }
  .wr-page .wr-flow-points li {
    font-size: 15.5px; line-height: 1.6; color: var(--text-muted);
  }

  /* ───────── CTA — 솔루션(.ind-cta-bg)과 같은 스타일 ─────────
     여백 · 면색 · 배치 · 어두운 겹 · 버튼은 industry.css 가 쥔다. 여기서는
     이 페이지 그래픽의 자리값만 들고 있는다(국문과 같다). */
  .wr-cta-bg-img {
    display: block;
    position: absolute; top: 0; left: 50%; transform: translateX(-50%);
    width: 100%; min-width: 1440px; height: 100%;
    object-fit: cover; object-position: center 65%;
    pointer-events: none; user-select: none;
  }
  /* 좁아지면 버튼이 아래로 내려온다. 제목과 붙지 않게 여백을 되살린다. */
  /* 좁은 화면 경계는 900px 하나로 통일한다. 860과 900이 섞여 있어서 그 사이
