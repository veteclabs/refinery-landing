---
// 영어 글 상세. 컬렉션 id가 'en/<slug>'라 접두사를 떼고 /en/blog/<slug>로 서빙한다(postSlug).
import { render } from 'astro:content';
import BlogPost from '../../../layouts/BlogPost.astro';
import { getPosts, postSlug, relatedPosts } from '../../../utils/blog';

export async function getStaticPaths() {
  const posts = await getPosts('en');
  return posts.map((post) => ({
    params: { slug: postSlug(post) },
    props: { post, related: relatedPosts(post, posts) },
  }));
}

const { post, related } = Astro.props;
const { Content, headings } = await render(post);
---
<BlogPost {...post.data} lang="en" slug={postSlug(post)} headings={headings} related={related}>
  <Content />
</BlogPost>
