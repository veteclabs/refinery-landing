<script is:inline>
  /* 솔루션 무대 — 제목 · 소제목 · 사진이 한 화면에 멈춰 선 채로, 스크롤이 지나는
     동안 글자에 색이 차고 소제목이 떠오르고 사진 띠가 옆으로 흐른다.
     ⚠️ 진행도는 핀 상자가 화면을 지나간 비율이다(무대가 붙어 있는 동안 0→1).
     ⚠️ 띠를 미는 거리는 띠 폭 − 칸 폭 + 내용 너비 오른쪽 여백이다 — 다 밀리면
        마지막 장의 오른쪽 변이 화면 끝이 아니라 내용 너비 끝에 선다.
     ⚠️ 동작 줄이기를 켠 환경에서는 손대지 않는다. CSS 기본값이 '다 보이는 상태'라
        제목도 소제목도 그대로 서고, 띠만 왼쪽 끝에 멈춘다.
     ⚠️ 901px 아래는 띠를 밀지 않는다 — 좁은 폭은 기존 격자다. */
  (function () {
    var sec = document.getElementById('industries');
    if (!sec) return;
    var pin = sec.querySelector('.ind-pin');
    var lines = sec.querySelectorAll('.sol-title .sol-line');
    var rails = [].slice.call(sec.querySelectorAll('.industries-grid'));
    if (!pin || !lines.length) return;
    if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var cont = sec.querySelector('.container');
    var PAD = cont ? (parseFloat(getComputedStyle(cont).paddingRight) || 0) : 0;
    function wide() { return window.matchMedia('(min-width: 901px)').matches; }
    function clamp(v) { return v < 0 ? 0 : v > 1 ? 1 : v; }
    function ease(t) { return t * t * (3 - 2 * t); }

    /* 제목만 있을 때 화면 가운데에 서도록 무대를 내릴 거리를 잰다.
       ⚠️ 재기 전에 --ind-lift 를 0 으로 돌린다. 제가 건 translate 가 남아 있으면
          그만큼 더해져 잴 때마다 값이 불어난다. */
    function measure() {
      var st = sec.querySelector('.ind-stage');
      var title = sec.querySelector('.sol-title');
      if (!st || !title) return;
      sec.style.setProperty('--ind-lift', '0px');
      var pad = parseFloat(getComputedStyle(st).paddingTop) || 0;
      var sr = st.getBoundingClientRect();
      var tr = title.getBoundingClientRect();
      sec.style.setProperty('--ind-lift',
        ((sr.top + pad + (sr.height - pad) / 2) - (tr.top + tr.height / 2)).toFixed(1) + 'px');
    }

    /* 핀 상자가 화면을 지나간 비율(0→1)과, 거기서 뽑은 사진 띠의 진행도. */
    function progress() {
      var span = pin.offsetHeight - (window.innerHeight || 800);
      return span > 0 ? clamp(-pin.getBoundingClientRect().top / span) : 1;
    }
    function railProgress(p) { return ease(clamp((p - 0.48) / 0.48)); }
    var railOrigin = rails.map(function () { return 0; });

    var ticking = false;
    function upd() {
      var p = progress();

      /* 0) 사진 카드 — 제목에 먹이 차는 동안 미리보기처럼 흩어져 떠 있다가,
         제자리로 모여 한 줄이 된다. 1 이 흩어진 상태, 0 이 줄을 선 상태다.
         ⚠️ 다 모이는 자리(0.38)는 띠가 옆으로 흐르기 시작하는 자리(0.48)보다
            앞이어야 한다. 겹치면 모이는 중에 띠가 밀려 어디를 보라는지 흐려진다. */
      sec.style.setProperty('--sol-pre', ease(clamp((p - 0.02) / 0.12)).toFixed(3));
      sec.style.setProperty('--sol-scatter', (1 - ease(clamp((p - 0.08) / 0.30))).toFixed(3));

      /* 1) 제목에 먹이 찬다. 줄마다 늦춰 윗줄이 먼저 찬다. */
      for (var i = 0; i < lines.length; i++) {
        var q = ease(clamp((p - 0.03 - i * 0.08) / 0.17));
        lines[i].style.setProperty('--sol-fill', (q * 100).toFixed(1) + '%');
        /* 제도 보조선은 먹이 올라오는 만큼 걷힌다 — 다 차면 글자만 남는다. */
        lines[i].style.setProperty('--sol-guide', (1 - q).toFixed(3));
      }

      /* 2) 소제목부터 아래가 떠오른다. */
      sec.style.setProperty('--ind-body', ease(clamp((p - 0.30) / 0.14)).toFixed(3));

      /* 3) 사진 띠가 옆으로 흐른다. */
      var rp = railProgress(p);
      for (var k = 0; k < rails.length; k++) {
        var rail = rails[k];
        if (!wide()) { rail.style.removeProperty('--sol-x'); rail.style.removeProperty('--sol-y'); rail.style.removeProperty('--sol-w'); continue; }
        var box = rail.parentElement.getBoundingClientRect();
        /* 칸에 카드가 정수 개로 딱 들어가게 폭을 잡는다 — 멈춰 있을 때 오른쪽
           끝에서 사진이 반 토막으로 잘리지 않는다. 400px 에 가장 가까운 장수를
           고른다. */
        var GAP = 16, TARGET = 400;
        var n = Math.max(2, Math.round((box.width + GAP) / (TARGET + GAP)));
        /* 폭은 정수로 끊는다 — 소수점이 남으면 카드마다 세로 모서리가 반픽셀 위에
           놓여, 사진과 흰 바탕이 섞인 회색 한 줄이 테두리처럼 보인다. */
        rail.style.setProperty('--sol-w', Math.round((box.width - (n - 1) * GAP) / n) + 'px');
        var travel = rail.scrollWidth - box.width + PAD;
        /* 띠마다 제 출발점이 있다. 탭을 바꾸기 전에는 0 이라 rp 를 그대로 쓰고,
           바꾼 뒤에는 그 순간부터 남은 스크롤로 제 폭을 다 흐른다. */
        if (rp <= 0) railOrigin[k] = 0;
        var o = railOrigin[k];
        var local = o >= 1 ? 0 : clamp((rp - o) / (1 - o));
        /* 미는 거리도 정수 자리에 붙인다. 칸의 왼쪽·위가 이미 소수점 위에 있으므로
           그만큼을 함께 덜어, 카드의 네 모서리가 픽셀 경계에 떨어지게 한다. */
        var baseX = travel > 0 ? -travel * local : 0;
        rail.style.setProperty('--sol-x', (Math.round(box.left + baseX) - box.left).toFixed(3) + 'px');
        rail.style.setProperty('--sol-y', (Math.round(box.top) - box.top).toFixed(3) + 'px');
        /* 4) 보이는 띠에 맞춰 앞뒤 버튼의 끝 상태와 한 장 몫을 잡는다. */
        if (rail.parentElement && !rail.parentElement.hasAttribute('data-off')) {
          setArrow(prevBtn, local <= 0.001);
          setArrow(nextBtn, local >= 0.999);
          lastStep = travel > 0 ? (parseFloat(getComputedStyle(rail).getPropertyValue('--sol-w')) + 16) / travel : 0;
          lastOrigin = o;
        }
      }
    }

    /* 앞뒤 버튼 — 띠를 직접 밀지 않고 페이지를 굴린다. 위치의 근거는 스크롤
       하나뿐이라, 버튼이 따로 밀면 둘이 어긋난다.
       한 장(--sol-w + 틈 16px)이 띠 전체에서 차지하는 비율 step 을 구하고,
       지금 자리에서 그만큼 더하거나 뺀 지점으로 간다.
       ⚠️ railProgress 가 ease(smoothstep)를 거치므로 그 역을 풀어야 한다.
          smoothstep 의 역: t = 0.5 - sin(asin(1 - 2y) / 3). */
    function unease(y) {
      if (y <= 0) return 0;
      if (y >= 1) return 1;
      return 0.5 - Math.sin(Math.asin(1 - 2 * y) / 3);
    }
    function setArrow(btn, off) {
      if (btn) btn.setAttribute('aria-disabled', off ? 'true' : 'false');
    }
    function step(dir) {
      if (!lastStep) return;
      var p = progress();
      var rp = railProgress(p);
      var o = lastOrigin;
      var local = o >= 1 ? 0 : clamp((rp - o) / (1 - o));
      var target = clamp(local + dir * lastStep);
      /* local 을 되돌려 rp 를 구하고, rp 에서 p 를 구한다. */
      var rpTarget = o + target * (1 - o);
      var pTarget = 0.48 + unease(clamp(rpTarget)) * 0.48;
      var span = pin.offsetHeight - (window.innerHeight || 800);
      if (span <= 0) return;
      var top = pin.getBoundingClientRect().top + window.scrollY;
      window.scrollTo({ top: Math.round(top + span * pTarget), behavior: 'smooth' });
    }
    var prevBtn = sec.querySelector('[data-sol-prev]');
    var nextBtn = sec.querySelector('[data-sol-next]');
    var lastStep = 0, lastOrigin = 0;
    if (prevBtn) prevBtn.addEventListener('click', function () { step(-1); });
    if (nextBtn) nextBtn.addEventListener('click', function () { step(1); });

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () { ticking = false; upd(); });
    }
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', function () { measure(); onScroll(); }, { passive: true });
    /* 탭을 바꾸면 새로 나온 띠는 첫 장부터 다시 흐른다 — 숨어 있던 띠가 이미
       절반쯤 밀린 채로 나타나면 앞쪽 사진을 못 보고 지나친다. 바꾼 순간의
       진행도를 띠마다 적어 두고, 그 뒤로는 남은 스크롤에 제 폭을 나눠 쓴다.
       두 띠에 모두 적는다 — 되돌아와도 똑같이 처음부터 보인다. */
    sec.addEventListener('click', function (e) {
      if (!e.target.closest('.sol-tab')) return;
      var rp = railProgress(progress());
      for (var k = 0; k < rails.length; k++) railOrigin[k] = rp;
      requestAnimationFrame(upd);
    });
    measure();
    upd();
    requestAnimationFrame(function () { measure(); upd(); });
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(function () { measure(); upd(); });
  })();
</script>

<script is:inline>
  /* 세로 스크롤바 폭을 px 로 재어 --sbw 에 넣는다. 바깥으로 빼는 자리
     (.teams-split 의 margin-right)가 이 값을 쓴다 — CSS 만으로는 못 구한다. */
  (function () {
    function measure() {
      document.documentElement.style.setProperty(
        '--sbw', (window.innerWidth - document.documentElement.clientWidth) + 'px');
    }
    measure();
    window.addEventListener('resize', measure, { passive: true });
  })();
</script>
