  .cd-select-trigger .cd-select-chevron{flex:none; transition:transform .2s ease; color:#7E8A98;}
  .cd-select-trigger.is-open .cd-select-chevron{transform:rotate(180deg);}
  .cd-select-options{
    position:absolute; top:calc(100% + 6px); left:0; right:0; z-index:20;
    background:#fff; border:1px solid var(--border,#E3E7EC); border-radius:8px;
    box-shadow:0 12px 28px rgba(10,14,20,0.14);
    max-height:240px; overflow-y:auto; padding:6px; margin:0; list-style:none;
  }
  .cd-select-options.is-open{display:block;}
  .cd-select-options li{padding:10px 12px; border-radius:6px; font-size:14px; color:#111; cursor:pointer;}
  .cd-select-options li.is-active{background:#EEF4FB; color:var(--accent,#76A6D7); font-weight:600;}
  .cd-select-options li:hover{background:#F3F6FA;}

  @media (max-width: 720px){
    #contactDrawerPanel{width:100vw;min-width:0;}
    .cd-inner{padding:56px 24px 40px;}
    .cd-form-row{grid-template-columns:1fr;}
    .cd-title{font-size:28px;}
