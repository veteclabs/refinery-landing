    <script is:inline>
    (function() {
      function draw() {
        var flowWrap = document.getElementById('intFlowWrap');
        var svg = document.getElementById('intFlowSvg');
        var pill = document.getElementById('intRefineryPill');
        var cards = document.querySelectorAll('#intNodeGrid .rfn-node');
        if (!flowWrap || !svg || !pill || !cards.length) return;
        var isMobile = window.innerWidth <= 1279 /* 카드가 280px 고정 + 가로 스크롤이 되는 경계 — CSS 와 같다 */;
        var scroller = document.getElementById('intNodeGrid');
        var wrapRect = flowWrap.getBoundingClientRect();
        var pillRect = pill.getBoundingClientRect();
        var targetY = (pillRect.top) - wrapRect.top;
        var pillLeft = pillRect.left - wrapRect.left;
        var pillW = pillRect.width;
        var n = cards.length;
        // 모바일: 카드 행이 좌우로 스크롤되므로, 현재 스크롤 위치상 실제로 보이는 카드에서만
        // 선을 그린다(화면 밖 카드까지 그리면 선이 옆으로 길게 가로질러 지저분해짐).
        var scrollerRect = scroller ? scroller.getBoundingClientRect() : null;
        var defs = '<defs>';
        var paths = '';
        var flows = '';
        var visibleIndices = [];
        cards.forEach(function(card, i) {
          var r = card.getBoundingClientRect();
          if (isMobile && scrollerRect) {
            var cardCenterX = r.left + r.width / 2;
            var visible = cardCenterX > scrollerRect.left && cardCenterX < scrollerRect.right;
            if (!visible) return;
          }
          visibleIndices.push(i);
          var startX = (r.left + r.width / 2) - wrapRect.left;
          var startY = (r.bottom - wrapRect.top) - 4;
          // spread endpoints across the pill's top edge instead of one shared point
          var targetX = pillLeft + pillW * ((i + 0.5) / n);
          var midY = startY + (targetY - startY) * 0.55;
          var d = 'M' + startX + ',' + startY + ' C' + startX + ',' + midY + ' ' + targetX + ',' + midY + ' ' + targetX + ',' + targetY;
          paths += '<path class="int-flow-edge" d="' + d + '"/>';
          var gradId = 'intFlowGrad' + i;
          var s1 = 'intFlowS1_' + i, s2 = 'intFlowS2_' + i, s3 = 'intFlowS3_' + i;
          defs += '<linearGradient id="' + gradId + '" gradientUnits="userSpaceOnUse" x1="' + startX + '" y1="' + startY + '" x2="' + targetX + '" y2="' + targetY + '">' +
            '<stop id="' + s1 + '" offset="-0.35" stop-color="#3F76AE" stop-opacity="0"><animate attributeName="offset" values="-0.35;1.35" dur="1.4s" begin="indefinite" fill="freeze"/></stop>' +
            '<stop id="' + s2 + '" offset="-0.2" stop-color="#76A6D7" stop-opacity="1"><animate attributeName="offset" values="-0.2;1.5" dur="1.4s" begin="indefinite" fill="freeze"/></stop>' +
            '<stop id="' + s3 + '" offset="-0.05" stop-color="#3F76AE" stop-opacity="0"><animate attributeName="offset" values="-0.05;1.65" dur="1.4s" begin="indefinite" fill="freeze"/></stop>' +
            '</linearGradient>';
          flows += '<path class="int-flow-glow" d="' + d + '" style="stroke:url(#' + gradId + ')"/>';
        });
        defs += '</defs>';
        svg.innerHTML = defs + paths + flows;
        svg.setAttribute('viewBox', '0 0 ' + wrapRect.width + ' ' + wrapRect.height);
        svg.setAttribute('preserveAspectRatio', 'none');

        // Trigger the flow animations in strict 1,2,3,4 order (one at a time, looping)
        // (모바일은 현재 화면에 실제로 그려진(=보이는) 카드들만 순서대로 순환한다.
        // 전체 카드 수(n) 기준으로 고정 순번을 매기면, 스크롤로 특정 카드만 보일 때
        // 그 카드의 순번이 돌아올 때까지 계속 기다려야 해서 모션이 거의 안 보이는
        // 문제가 있었다.)
        if (window.intFlowTimer) clearInterval(window.intFlowTimer);
        var stepMs = 1000;
        var step = 0;
        var cycleIndices = isMobile ? visibleIndices : null;
        function fireStep() {
          var idx;
          if (cycleIndices) {
            if (!cycleIndices.length) return;
            idx = cycleIndices[step % cycleIndices.length];
          } else {
            idx = step % n;
          }
          ['intFlowS1_', 'intFlowS2_', 'intFlowS3_'].forEach(function(prefix) {
            var stopEl = document.getElementById(prefix + idx);
            if (!stopEl) return;
            var animEl = stopEl.querySelector('animate');
            if (animEl && animEl.beginElement) {
              try { animEl.beginElement(); } catch (e) {}
            }
          });
          step++;
        }
        fireStep();
        window.intFlowTimer = setInterval(fireStep, stepMs);
      }
      window.addEventListener('load', draw);
      window.addEventListener('resize', draw);
      if (document.readyState === 'complete') draw();
      else document.addEventListener('DOMContentLoaded', function() { setTimeout(draw, 0); });

      // 모바일 가로 스크롤 중에도 연결선이 카드 위치를 따라오도록 스크롤 시 재계산한다.
      (function() {
        var scroller = document.getElementById('intNodeGrid');
        if (!scroller) return;
        var raf = null;
        scroller.addEventListener('scroll', function() {
          if (raf) return;
          raf = requestAnimationFrame(function() { raf = null; draw(); });
        }, { passive: true });
      })();
    })();
    </script>
 </div>
</section>

