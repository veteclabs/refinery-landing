  <!-- 솔루션 섹션 - 산업별 ⁠· 과제별 두 판을 옆으로 넘긴다.
       위치는 뷰포트의 가로 스크롤이 갖는다(스크롤 스냅). 버튼은 scrollTo만 부르고,
       현재 판은 스크롤 위치에서 되읽는다 — 스와이프로 넘겨도 탭 ⁠· 버튼이 따라온다. -->
  <script is:inline>
    (function () {
      // 이 스크립트는 섹션 마크업보다 먼저 놓여 있다(플랫폼 슬라이더 바로 뒤).
      // 바로 실행하면 .sol-viewport가 아직 없어 조용히 빠져나간다 - 문서가 다 그려진 뒤에 건다.
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
      function init() {
      var root = document.getElementById('industries');
      if (!root) return;
      var vp = root.querySelector('.sol-viewport');
      var tabs = root.querySelectorAll('[data-sol-tab]');
      if (!vp || !tabs.length) return;
      var last = 0;
      var fading = false, token = 0;

      function current() { return last; }
      function paint(i) {
        for (var t = 0; t < tabs.length; t++) {
          tabs[t].setAttribute('aria-selected', t === i ? 'true' : 'false');
        }
      }

      // 판 전환 - 두 판을 겹쳐 두고 서로 페이드로 교차시킨다(크로스페이드).
      // 옆으로 미는 방식은 카드 14장이 화면을 가로질러 지나가 산만했고,
      // 흐렸다가 다시 켜는 방식은 중간에 빈 순간이 생겼다. 교차는 둘 다 없다.
      function go(i) {
        if (i < 0) i = 0;
        if (i > tabs.length - 1) i = tabs.length - 1;
        if (i === last) return;
        var ps = root.querySelectorAll('.sol-panel');
        var out = ps[last], inn = ps[i];
        last = i;
        paint(i);
        if (!out || !inn) return;

        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) {
          out.setAttribute('data-off', '');
          inn.removeAttribute('data-off');
          return;
        }

        var mine = ++token;
        fading = true;
        // visibility에는 전환이 걸리지 않는다. 먼저 보이게만 만들고 투명도는 0에서 시작해
        // 다음 프레임에 올려야 첫 전환도 페이드로 보인다(바로 올리면 그냥 켜진다).
        inn.removeAttribute('data-off');
        inn.style.opacity = '0';
        out.style.opacity = '1';
        requestAnimationFrame(function () {
          if (mine !== token) return;
          inn.style.opacity = '1';
          out.style.opacity = '0';
          setTimeout(function () {
            if (mine !== token) return;
            out.setAttribute('data-off', '');
            out.style.opacity = '';
            inn.style.opacity = '';
            fading = false;
          }, 320);
        });
      }

      for (var t = 0; t < tabs.length; t++) {
        (function (n) {
          tabs[n].addEventListener('click', function () { go(n); });
        })(t);
      }

      // 모바일 스와이프 - 가로 스크롤러를 걷어냈으므로 제스처를 직접 받는다.
      // 손가락을 따라 밀지는 않고, 놓는 순간 같은 크로스페이드로 넘긴다.
      var sx = 0, sy = 0, tracking = false;
      vp.addEventListener('touchstart', function (e) {
        if (e.touches.length !== 1 || fading) { tracking = false; return; }
        tracking = true; sx = e.touches[0].clientX; sy = e.touches[0].clientY;
      }, { passive: true });
      vp.addEventListener('touchend', function (e) {
        if (!tracking) return;
        tracking = false;
        var c = e.changedTouches[0];
        var dx = c.clientX - sx, dy = c.clientY - sy;
        // 세로로 더 많이 움직였으면 페이지 스크롤이지 넘김이 아니다.
        if (Math.abs(dx) < 45 || Math.abs(dx) < Math.abs(dy)) return;
        go(current() + (dx < 0 ? 1 : -1));
      }, { passive: true });

      paint(0);
      }
    })();
  </script>
