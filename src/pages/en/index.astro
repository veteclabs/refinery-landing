</section>

<script is:inline>
  /* 보안 무대 — 제목 · 소제목 · 카드 두 장이 한 화면에 멈춰 선 채로, 스크롤이
     지나는 동안 제목 글자가 왼쪽부터 드러나고 이어서 아래가 떠오른다. 다 뜬 뒤
     스크롤이 더 지나면 카드 두 장이 옆으로 빠지고 그 자리에 다음 두 장이 든다 —
     틀은 그대로고 내용만 바뀐다.
     솔루션 섹션과 같은 구조지만 변수 이름이 따로다(--sec-*).
     ⚠️ 진행도는 핀 상자가 화면을 지나간 비율이다(무대가 붙어 있는 동안 0→1).
     ⚠️ 무대가 sticky 가 아니면(낮은 화면 · 동작 줄이기) 손을 떼고 다 드러난
        상태로 세운다. */
  (function () {
    var sec = document.getElementById('security');
    if (!sec) return;
    var pin = sec.querySelector('.sec-pin');
    var stage = sec.querySelector('.sec-stage');
    var lines = sec.querySelectorAll('.sec-title .sec-line');
    var pages = sec.querySelectorAll('.sec-deck > .security-grid');
    if (!pin || !stage || !lines.length) return;

    /* 한 장의 상태 — 틀 기준 자리(--pgx, 0% 가 제자리 · 100% 가 틀 바로 오른쪽),
       오른쪽 칸이 더 가는 거리(--cardx), 클릭을 받는지.
       투명도는 쓰지 않는다(CSS 쪽 설명 참고). */
    function setPage(el, x, cardx, live) {
      el.style.setProperty('--pgx', x.toFixed(2) + '%');
      el.style.setProperty('--cardx', cardx.toFixed(1) + 'px');
      el.style.setProperty('--pg-pe', live ? 'auto' : 'none');
    }

    function clamp(v) { return v < 0 ? 0 : v > 1 ? 1 : v; }
    function ease(t) { return t * t * (3 - 2 * t); }
    function pinned() { return getComputedStyle(stage).position === 'sticky'; }

    function settle() {
      for (var i = 0; i < lines.length; i++) {
        lines[i].style.setProperty('--sec-fill', '100%');
        lines[i].style.setProperty('--sec-guide', '0');
      }
      sec.style.setProperty('--sec-body', '1');
      sec.style.setProperty('--sec-lift', '0px');
      /* 넘길 거리가 없는 화면에서는 두 장을 다 세운다 — CSS 가 포개기를 풀어
         위아래로 놓으므로 넷이 그대로 보인다. */
      for (var k = 0; k < pages.length; k++) setPage(pages[k], 0, 0, true);
    }

    /* 제목만 있을 때 화면 가운데에 서도록 머리글을 내릴 거리를 잰다.
       ⚠️ 재기 전에 --sec-lift 를 0 으로 돌린다. 제가 건 translate 가 남아 있으면
          그만큼 더해져 잴 때마다 값이 불어난다. */
    function measure() {
      if (!pinned()) return;
      var hdr = sec.querySelector('.section-header');
      var title = sec.querySelector('.sec-title');
      if (!hdr || !title) return;
      sec.style.setProperty('--sec-lift', '0px');
      var pad = parseFloat(getComputedStyle(stage).paddingTop) || 0;
      var sr = stage.getBoundingClientRect();
      var tr = title.getBoundingClientRect();
      sec.style.setProperty('--sec-lift',
        ((sr.top + pad + (sr.height - pad) / 2) - (tr.top + tr.height / 2)).toFixed(1) + 'px');
    }

    function progress() {
      if (pinned()) {
        var span = pin.offsetHeight - (window.innerHeight || 800);
        return span > 0 ? clamp(-pin.getBoundingClientRect().top / span) : 1;
      }
      /* 붙이지 않는 화면 — 대제목이 화면을 올라오는 만큼을 진행도로 쓴다.
         아래 끝 가까이(92%)에 닿으면 0, 화면 높이의 40% 자리까지 오면 1 이다.
         그래서 모션은 섹션이 들어오는 동안 끝나고 그 뒤로는 그냥 스크롤된다. */
      var title = sec.querySelector('.sec-title');
      if (!title) return 1;
      var vh = window.innerHeight || 800;
      var from = vh * 1.00, to = vh * 0.35;
      return from > to ? clamp((from - title.getBoundingClientRect().top) / (from - to)) : 1;
    }

    var reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;

    function upd() {
      if (reduce) { settle(); return; }
      var stuck = pinned();
      var p = progress();
      /* 안 붙는 화면에서는 머리글을 내리지 않는다 — 무대가 화면을 꽉 채우지
         않으므로 가운데로 끌어올 자리가 없다. */
      if (!stuck) sec.style.setProperty('--sec-lift', '0px');
      /* 내릴 거리는 아래가 떠오르기 전까지만 쓰인다. 그 동안에는 매번 다시 잰다 —
         한 번만 재면 카드 그림이 아직 안 뜬 상태의 높이로 잡혀 제목이 가운데에
         서지 않는다(처음에 18px 이 나왔다, 맞는 값은 188px). */
      if (stuck && p < 0.5) measure();
      /* 1) 제목이 줄마다 늦춰 드러난다 — 윗줄이 먼저다. */
      /* ⚠️ 창은 '붙여 둘 때 쓰는 거리' 에 매여 있다. 붙이면 180vh 를 쓰고(핀
         280vh), 안 붙이면 제목이 화면을 올라오는 65vh 를 쓴다 — 같은 비율을
         두 쪽에 쓰면 한쪽은 금세 다 차고 한쪽은 끝나지 않는다. */
      var LEAD = 0, STEP = stuck ? 0.07 : 0.14, SPAN = stuck ? 0.18 : 0.36;
      for (var i = 0; i < lines.length; i++) {
        var q = ease(clamp((p - LEAD - i * STEP) / SPAN));
        lines[i].style.setProperty('--sec-fill', (q * 100).toFixed(1) + '%');
        /* 모서리 괄호는 글자가 드러나는 만큼 걷힌다. */
        lines[i].style.setProperty('--sec-guide', (1 - q).toFixed(3));
      }
      /* 2) 소제목부터 아래가 떠오른다. */
      sec.style.setProperty('--sec-body',
        ease(clamp((p - (stuck ? 0.28 : 0.62)) / (stuck ? 0.15 : 0.30))).toFixed(3));
      /* 3) 첫 장이 다 선 뒤, 그 자리에서 둘째 장으로 넘어간다.
         ⚠️ 안 붙는 화면에서는 넘기지 않는다 — 넘길 거리가 없고, CSS 가 이미
            두 장을 위아래로 풀어 놓았다. */
      if (pages.length > 1) {
        if (!stuck) { for (var j = 0; j < pages.length; j++) setPage(pages[j], 0, 0, true); }
        else {
          /* 나가는 장은 왼쪽으로 빠지고, 드는 장은 오른쪽에서 들어온다. 오른쪽
             칸은 제 장보다 조금 더 가 한 박자 늦게 자리를 잡는다. */
          var t = ease(clamp((p - 0.68) / 0.14));
          setPage(pages[0], -100 * t, -56 * t, t < 0.5);
          setPage(pages[1], 100 * (1 - t), 72 * (1 - t), t >= 0.5);
        }
      }
    }

    var ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () { ticking = false; upd(); });
    }
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', function () { measure(); onScroll(); }, { passive: true });
    measure();
    upd();
    requestAnimationFrame(function () { measure(); upd(); });
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(function () { measure(); upd(); });
  })();
</script>

