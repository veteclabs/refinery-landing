  plate: ['The field, right now,\nin numbers', 'Monitor key field metrics in real time.\nCheck per-department and per-zone status and anomaly signals on a single screen.', 'Plate'],
  tile: ['20 ways to\nvisualize your data', 'Number cards, gauges, time-series charts, heatmaps, spatial maps and more\npick the widget that fits your data.', 'Tile'],
  pipeline: ['Draw the flow,\nand it runs', 'Connect nodes from source to result.\nThe diagram is the pipeline that runs, so nothing has to be written out again.', 'Pipeline Builder'],
  ontology: ['From field language\nto data language', 'Define assets, tasks, documents and other field concepts as objects and relations.\nThis structure powers Plate and the AI agent.', 'Ontology'],
  calendar: ['Schedules and work,\nin one place', 'Manage processing schedules, inspection cycles and team tasks on one screen,\nso the operational rhythm never slips.', 'Calendar']
};

var NO_SCROLL_KEYS = ['llm','plate','tile','pipeline','ontology','calendar']; // 원래 스크롤이 없는 화면 - 우측 크롭 적용 안 함
var DASH_PAN_MAP = {};
// 2026-10-28 화면을 다시 찍으며 앱에서 메뉴 둘을 접고, 남은 아이콘 띠 28px 은
// 이미지에서 잘라 냈다. 그래서 캘린더 말고는 가릴 레일이 없다 — 아래 네 맵은
// 캘린더 몫만 남긴다. 다시 레일이 있는 캡처로 바꾸면 값을 되살려야 한다.
// // 화면별 좌측 크롭(px, 원본 1440 기준) - 데스크탑/모바일 공통, 콘텐츠를 우측으로 밀어 보여줌
var MOBILE_EXTRA_PAN_MAP = { calendar: 160 }; // 모바일 전용 추가 크롭(좌측 메뉴 잔상 가림) - 데스크탑에는 영향 없음

// 페이지 로드 시 기본으로 활성화된 탭(대시보드)도 위 설정이 바로 적용되도록 초기화
window.needsRightCrop = NO_SCROLL_KEYS.indexOf('llm') === -1;
window.dashPanContent = DASH_PAN_MAP['llm'] || 0;
window.dashKey = 'llm';
if (window.resizeDash) window.resizeDash();

/* 미리보기 본문은 폭에 따라 다르게 끊는다.
   1281px 이상(오버레이): 좁은 왼쪽 칸에 맞춘 teamsTextMap 의 \n 을 그대로 쓴다.
   1280px 이하(세로 분리): 글이 폭을 통째로 쓰므로 그 \n 은 문장 중간을 끊는 꼴이 된다.
   공백으로 풀고 문장 끝에서만 나눈다 — 마침표 뒤에 이어지는 글자가 있을 때만 끊어
   마지막 문장 뒤에 빈 줄이 생기지 않게 한다. */
function renderPreviewBody(el) {
  var raw = el.dataset.raw;
  if (raw == null) return;
  if (window.innerWidth > 1280) { el.textContent = raw; return; }
  // 세로 분리 폭: teamsTextMap 의 4번째 값이 있으면 그 줄 나눔을 쓰고,
  // 없으면 문장 끝에서 자동으로 나눈다(한 문장뿐인 탭은 나눌 자리가 없어 4번째를 둔다).
  var wide = el.dataset.wide;
  var src = wide ? wide
    : raw.replace(/\s*\n\s*/g, ' ').trim().replace(/([.!?])\s+(?=\S)/g, '$1\n');
  paintPreviewBody(el, src);
  var narrow = el.dataset.narrow;
  if (!narrow) return;
  var lh = parseFloat(getComputedStyle(el).lineHeight) || 0;
  if (!lh) return;
  var lines = function () { return Math.round(el.scrollHeight / lh); };
  // 그 줄이 감기기 시작하면 더 잘게 나눈 5번째 값으로 바꾼다.
  if (lines() <= src.split('\n').length) return;
  paintPreviewBody(el, narrow);
  // 그것마저 감기는 폭에서는 끊어 둔 자리가 오히려 낱말을 홀로 남긴다
  // (`… in the / ontology`). 줄 나눔을 풀어 문장 단위로 되돌린다 — 자연 줄바꿈은
  // 어절에서 끊으니 고아가 생기지 않는다.
  if (lines() > narrow.split('\n').length) paintPreviewBody(el, src);
}
function paintPreviewBody(el, src) {
  el.textContent = '';
  src.split('\n').forEach(function (line, i) {
    if (i) el.appendChild(document.createElement('br'));
    el.appendChild(document.createTextNode(line));
  });
}
function initPreviewBody() {
  var el = document.getElementById('teamsPreviewBody');
  if (!el) return;
  if (el.dataset.raw == null) {
    // 초기 렌더는 마크업의 <br> 로 줄이 잡혀 있다 — 그것을 \n 으로 되돌려 원본으로 삼는다
    el.dataset.raw = el.innerHTML.replace(/<br\s*\/?>/gi, '\n').replace(/<[^>]+>/g, '');
    // 첫 화면의 탭은 switchDash 를 거치지 않아 wide 가 비어 있었다. 그래서 세로 분리
    // 폭에서 기본 탭만 지정한 줄 나눔 대신 문장 끝 자동 분할로 그려졌다.
    // 활성 버튼의 onclick 에 적힌 키로 teamsTextMap 의 4번째 값을 찾아 채운다.
    var btn = document.querySelector('#teams .teams-tab-btn.active');
    var m = btn && (btn.getAttribute('onclick') || '').match(/,\s*'([^']+)'\s*\)/);
    var t = m && typeof teamsTextMap !== 'undefined' && teamsTextMap[m[1]];
    if (t && t[3]) { el.dataset.wide = t[3]; }
    if (t && t[4]) { el.dataset.narrow = t[4]; }
  }
  renderPreviewBody(el);
}
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initPreviewBody);
} else {
  initPreviewBody();
}
window.addEventListener('resize', function () {
  var el = document.getElementById('teamsPreviewBody');
  if (el) renderPreviewBody(el);
});

function switchDash(btn, src, key, silent) {
  // silent — 스크롤로 저절로 넘어간 경우다. 클릭으로 집계하지 않는다.
  if (!silent && typeof mixpanel !== "undefined") mixpanel.track("Solutions Tab Click", { tab: key });
  document.querySelectorAll('.teams-tab-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  /* 고른 칸의 이름을 줄 아래에 남긴다 — 섬네일에는 글자가 없다. */
  var nameEl = document.querySelector('[data-teams-name]');
  if (nameEl) nameEl.textContent = btn.getAttribute('aria-label') || btn.textContent.trim();
  var img = document.getElementById('dash-image');
  window.needsRightCrop = NO_SCROLL_KEYS.indexOf(key) === -1;
  window.dashPanContent = DASH_PAN_MAP[key] || 0;
  window.dashKey = key;

  if (img) img.src = src;
  if (window.resizeDash) window.resizeDash();
  var t = teamsTextMap[key];
  if (t) {
    var taglineEl = document.getElementById('teamsPreviewTagline');
    var titleEl = document.getElementById('teamsPreviewTitle');
    var bodyEl = document.getElementById('teamsPreviewBody');
    if (taglineEl) taglineEl.textContent = t[2];
    if (titleEl) titleEl.textContent = t[0];
    if (bodyEl) {
    bodyEl.dataset.raw = t[1];
    if (t[3]) { bodyEl.dataset.wide = t[3]; } else { delete bodyEl.dataset.wide; }
    if (t[4]) { bodyEl.dataset.narrow = t[4]; } else { delete bodyEl.dataset.narrow; }
    renderPreviewBody(bodyEl);
  }
  }
  if (window.placeTeamsFill) placeTeamsFill();
}

/* 탭 줄의 brand 막대를 고른 칸에 맞춘다. 글자 폭이 글꼴 · 언어에 따라
   달라져 CSS 로는 못 박는다 — 고른 칸의 상자를 재어 left/width 를 넣는다.
   줄이 두 줄로 나뉘어도 상자를 재므로 그대로 따라간다. */
function placeTeamsFill() {
  var rail = document.querySelector('#teams .teams-menu-vertical');
  if (!rail) return;
  var fill = rail.querySelector('.teams-rail-fill');
  var on = rail.querySelector('.teams-tab-btn.active');
  if (!fill || !on) return;
  var r = rail.getBoundingClientRect(), b = on.getBoundingClientRect();
  fill.style.left = (b.left - r.left).toFixed(1) + 'px';
  fill.style.width = b.width.toFixed(1) + 'px';
}
window.placeTeamsFill = placeTeamsFill;
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', placeTeamsFill);
} else {
  placeTeamsFill();
}
window.addEventListener('load', placeTeamsFill);
window.addEventListener('resize', placeTeamsFill);
if (document.fonts && document.fonts.ready) document.fonts.ready.then(placeTeamsFill);

/* 탭은 스크롤이 지나는 동안 넘어간다. 무대가 붙어 있는 거리를 칸 수로 나눠
   활성 탭을 정하고, 단추를 누르면 그 칸의 가운데로 스크롤을 옮긴다 —
   화면 상태의 근거를 스크롤 위치 하나로 두어 둘이 어긋나지 않게 한다.
   ⚠️ 1280px 이하에서는 무대를 붙이지 않는다(세로로 나뉜다). CSS 의 경계를
      다시 적지 않고 무대의 실제 position 을 보고 판단한다. */
(function () {
  var pin = document.querySelector('#teams .teams-pin');
  var stick = document.querySelector('#teams .teams-stage-sticky');
  var btns = Array.prototype.slice.call(document.querySelectorAll('#teams .teams-tab-btn'));
  if (!pin || !stick || btns.length < 2) return;

  // 그림 경로와 키는 단추의 onclick 에 이미 적혀 있다 — 한 번만 뽑아 둔다.
  var items = btns.map(function (b) {
    var m = (b.getAttribute('onclick') || '').match(/switchDash\(this,\s*'([^']*)',\s*'([^']*)'\)/);
    return { btn: b, src: m ? m[1] : '', key: m ? m[2] : '' };
  });
  var n = items.length;
  var cur = 0;

  function pinned() { return getComputedStyle(stick).position === 'sticky'; }
  function travel() { return pin.offsetHeight - window.innerHeight; }

  function update() {
    if (!pinned()) return;
    var t = travel();
    if (t <= 0) return;
    var p = -pin.getBoundingClientRect().top / t;
    var i = Math.max(0, Math.min(n - 1, Math.floor(p * n)));
    if (i === cur) return;
    cur = i;
    // 네 번째 인자 — 스크롤로 넘어간 것은 Mixpanel 에 클릭으로 적지 않는다.
    switchDash(items[i].btn, items[i].src, items[i].key, true);
  }

  var queued = false;
  window.addEventListener('scroll', function () {
    if (queued) return;
    queued = true;
    requestAnimationFrame(function () { queued = false; update(); });
  }, { passive: true });
  window.addEventListener('resize', update);
  update();

  items.forEach(function (it, i) {
    it.btn.addEventListener('click', function () {
      cur = i;  // 인라인 onclick 이 이미 화면을 바꿨다 — 다시 바꾸지 않는다
      if (!pinned()) return;
      var t = travel();
      if (t <= 0) return;
      var top = pin.getBoundingClientRect().top + window.scrollY;
      window.scrollTo({ top: top + (t / n) * (i + 0.5), behavior: 'smooth' });
    });
  });
})();

</script>
<script is:inline>
  (function() {
