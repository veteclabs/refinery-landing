<script is:inline>
function animateLayers() {
  const delays = [0, 600, 1200];
  ['layer-bg', 'layer-dashboard', 'layer-graph'].forEach((id, i) => {
    const el = document.getElementById(id);
    if (!el) return;
    setTimeout(() => {
      el.style.animation = 'layerFadeUp 0.9s cubic-bezier(0.22,1,0.36,1) forwards';
    }, delays[i]);
  });
}

function resetLayers() {
  ['layer-bg', 'layer-dashboard', 'layer-graph'].forEach(id => {
    const el = document.getElementById(id);
    if (!el) return;
    el.style.animation = 'none';
    el.style.opacity = '0';
  });
}

const plateCard = document.getElementById('card-plate');
let animated = false;

const plateObserver = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting && !animated) {
      animated = true;
      animateLayers();
    } else if (!entry.isIntersecting && animated) {
      animated = false;
      resetLayers();
    }
  });
}, { threshold: 0.2, rootMargin: '0px 0px -50px 0px' });

function animateOntLayers() {
  ['ont-layer-1','ont-layer-2','ont-layer-3','ont-layer-4'].forEach((id, i) => {
    const el = document.getElementById(id);
    if (!el) return;
    setTimeout(() => {
      el.style.animation = 'layerFadeUp 0.9s cubic-bezier(0.22,1,0.36,1) forwards';
    }, i * 600);
  });
}

function resetOntLayers() {
  ['ont-layer-1','ont-layer-2','ont-layer-3','ont-layer-4'].forEach(id => {
    const el = document.getElementById(id);
    if (!el) return;
    el.style.animation = 'none';
    el.style.opacity = '0';
  });
}

let ontAnimated = false;
const ontObserver = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting && !ontAnimated) {
      ontAnimated = true;
      animateOntLayers();
    } else if (!entry.isIntersecting && ontAnimated) {
      ontAnimated = false;
      resetOntLayers();
    }
  });
}, { threshold: 0.9 });

document.addEventListener('DOMContentLoaded', () => {
  if (plateCard) plateObserver.observe(plateCard);
  const ontCard = document.getElementById('card-ontology');
  if (ontCard) ontObserver.observe(ontCard);
});
</script>
