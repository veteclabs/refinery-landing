var NO_SCROLL_KEYS = ['calendar']; // 원래 스크롤이 없는 화면 - 우측 크롭 적용 안 함
var DASH_PAN_MAP = { llm: 70, plate: 180 }; // 화면별 좌측 크롭(px, 원본 1440 기준) - 데스크탑/모바일 공통, 콘텐츠를 우측으로 밀어 보여줌
var MOBILE_EXTRA_PAN_MAP = { tile: 160, ontology: 160, calendar: 160 }; // 모바일 전용 추가 크롭(좌측 메뉴 잔상 가림) - 데스크탑에는 영향 없음

