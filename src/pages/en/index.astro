    <script is:inline>
    (function() {
      var DASH_W = 1440; // 기본값(폴백) - 이미지 로드 전이거나 크기 정보를 못 가져올 때만 사용
      var DASH_H = 900;
      var RIGHT_CROP = 20; // 브라우저 기본 스크롤바가 우측 끝에 보이지 않도록 살짝 잘라냄 (스크롤 있는 화면만)

      // 캡처에서 이미 메뉴를 걷어 내 0 이다. 캘린더만 옛 캡처라 제 값을 쓴다.
      var MOBILE_RAIL_CROP_MAP = { calendar: 244 };  // // 좌측 세션 레일 폭(px, 원본 1440 기준) - 모바일에서는 실제로 잘라내 보여준다
      // 모바일 전용 - 이미지를 아래로 내려 보여줌(카드 크기는 불변), 데스크탑 미적용
      // 파이프라인만 음수다. 캡처 상단의 'Schema · Snapshot Diff | develop |
      // flux-energy > grid_ops | Last sync …' 툴바 줄과 그 아래 Export / Apply Migration
      // 줄을 래퍼 위로 밀어내고 ERD 탭 줄부터 보여준다. 이 구간은 좌측 레일을 244px
      // 잘라내는데, 파이프라인은 레일이 277px(원본 2000 기준) 뿐이라 본문 좌측까지 먹혀
      // 그 줄이 '…ema · Snapshot Diff' 처럼 글자 중간이 잘린 채 드러났다.
      // 다른 탭은 레일 옆에 패널이 하나 더 있어 같은 자리의 제목이 온전히 남는다.
      //   실측(카드 1155px · 배율 0.704) — 값별로 그 줄 하단이 래퍼 위 몇 px 에 오는지:
      //   40:43 · 0:4 · -20:-16 · -40:-35 · -60:-55 · -80:-74.
      //   0 이면 그 줄이 윗변에 걸려 사라지고 Export / Apply Migration 줄부터 보인다.
      //   값 1 당 화면 0.98px 이다(1440 기준 px × 2000/1440 × 배율).
      //   산업 AI 운영체제(llm)는 120. 40 에서는 창 머리가 전혀 안 보여 상단이 비었다.
      //   120 이면 우측 툴바 줄이 들어오고 가운데 AI 패널이 아직 중앙을 지킨다
      //   (130 은 '인터랙티브 데모' 줄까지, 160 은 창 머리 두 줄까지 들어온다).
      //   40 / 70 / 100 / 130 / 160 / 190 을 렌더해 비교한 뒤 그 사이로 잡았다.
      //   아래는 어느 값에서도 꽉 찬다(이미지가 래퍼보다 세로로 길다).
      var MOBILE_EXTRA_TOP_MAP = { calendar: 40 };
      // 1281px 이상(데스크탑)용 세로 보정. 거기는 원래 top 이 0 고정이라 캡처 윗변이
      // 카드 윗변에 붙어 패널이 위로 쏠리고 아래가 비었다. 양수면 아래로 내려간다.
      //   산업 AI 운영체제(llm) 80 — 우측 툴바 줄이 하나 들어오고 패널이 조금 내려온다.
      //   0 / 40 / 80 / 120 / 160 / 200 을 렌더해 비교했다. 아래 여유는 185px 에서
      //   시작해 값만큼 늘어나므로 어느 값에서도 빈 공간이 생기지 않는다.
      //   값 1 당 화면 0.83px 이다(1440 기준 px × 2000/1440 × 배율 0.597).
      //   모바일 맵과 배율이 달라 같은 숫자라도 움직이는 양이 다르다 — 함께 바꾸지 말 것.
      var DESKTOP_EXTRA_TOP_MAP = {};

      function resizeDash() {
        var wrapper = document.getElementById('iframe-wrapper');
        var img  = document.getElementById('dash-image');
        if (!wrapper || !img) return;
        // 캡처본마다 실제 원본 크기가 다를 수 있어 naturalWidth/Height를 우선 사용 (비율 왜곡 방지)
        var imgW = img.naturalWidth  || DASH_W;
        var imgH = img.naturalHeight || DASH_H;
        // naturalWidth가 1440 기준이 아닌 경우(레티나 2x 캡처 등)를 보정하는 배율
        var unitScale = imgW / DASH_W;

        var w = wrapper.offsetWidth;
        var crop = (window.needsRightCrop === false) ? 0 : RIGHT_CROP;
        var pan = window.dashPanContent || 0; // 콘텐츠를 우측으로 밀어 보여주기 위한 좌측 크롭(px, 원본 1440 기준)
        var isMobile = window.innerWidth <= 1280 /* 1280 이하는 세로 분리 레이아웃 — CSS와 같은 경계 */;

        if (isMobile) {
          // 모바일: 좌측 세션 레일을 실제로 잘라내고(pan + 모바일 전용 추가 크롭 포함) 본문 UI만 카드 폭에 꽉 차게 확대한다.
          var mobileExtraPan = MOBILE_EXTRA_PAN_MAP[window.dashKey] || 0;
          var leftCropNatural = ((MOBILE_RAIL_CROP_MAP[window.dashKey] || 0) + pan + mobileExtraPan) * unitScale;
          var scale = w / (imgW - crop - leftCropNatural);
          var renderedH = imgH * scale;
          var wrapperH = wrapper.offsetHeight;
          img.style.width  = imgW + 'px';
          img.style.height = imgH + 'px';
          img.style.left = (-leftCropNatural * scale) + 'px';
          img.style.transform = 'scale(' + scale + ')';
          img.style.transformOrigin = 'top left';
          var extraTopNatural = (MOBILE_EXTRA_TOP_MAP[window.dashKey] || 0) * unitScale;
          img.style.top = (((wrapperH - renderedH) / 2) + extraTopNatural * scale) + 'px';
        } else {
          // 데스크탑: 기존과 동일하게 폭 기준으로만 스케일링 (좌측 레일은 decor 오버레이로 가림)
          var scale = w / (imgW - crop);
          img.style.width  = imgW + 'px';
          img.style.height = imgH + 'px';
          img.style.left = (pan * scale) + 'px';
          img.style.transform = 'scale(' + scale + ')';
          img.style.transformOrigin = 'top left';
          var desktopExtraTop = (DESKTOP_EXTRA_TOP_MAP[window.dashKey] || 0) * unitScale;
          img.style.top = (desktopExtraTop * scale) + 'px';
        }
      }
      window.resizeDash = resizeDash;
      window.addEventListener('load', resizeDash);
      window.addEventListener('resize', resizeDash);
      document.addEventListener('DOMContentLoaded', resizeDash);
      var dashImageEl = document.getElementById('dash-image');
      if (dashImageEl) dashImageEl.addEventListener('load', resizeDash);

      // Solutions 탭 전환 시 큰 이미지(장당 400~650KB)를 그제서야 받아오느라
      // 탭을 눌러도 바로 안 보이고 잠깐 버벅이는 문제가 있었다 - 섹션이 화면에
      // 보이는 시점에 미리 나머지 이미지들을 백그라운드로 캐싱해둬서,
      // 실제로 탭을 누를 때는 이미 캐시된 이미지라 즉시 전환되도록 한다.
      var dashPreloadSrcs = [
        '/Solutions/Solutions-02-ai-agent.webp',
        '/Solutions/Solutions-01-dashboard.webp',
        '/Solutions/Solutions-04-tile.webp',
        '/Solutions/Solutions-05-pipeline.webp',
        '/Solutions/Solutions-06-ontology.webp',
        '/Solutions/Solutions-07-calendar-2.webp'
      ];
      var dashPreloadDone = false;
      function preloadDashImages() {
        if (dashPreloadDone) return;
        dashPreloadDone = true;
        dashPreloadSrcs.forEach(function(src) {
          var im = new Image();
          im.src = src;
        });
      }
      var teamsSectionEl = document.getElementById('teams');
      if (teamsSectionEl && 'IntersectionObserver' in window) {
        var dashPreloadObserver = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              preloadDashImages();
              dashPreloadObserver.disconnect();
            }
          });
        }, { rootMargin: '600px 0px' });
        dashPreloadObserver.observe(teamsSectionEl);
      } else {
        window.addEventListener('load', preloadDashImages);
      }
    })();
    </script>
 </div>
