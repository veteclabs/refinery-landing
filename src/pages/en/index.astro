        if (!grid) return;
        // 통합 격자는 1279px 까지 가로로 넘친다(CSS 와 같은 경계)
        enableDragScroll(grid, function() { return window.innerWidth <= 1279; });
        function updateFade() {
          var max = grid.scrollWidth - grid.clientWidth;
          var scrollable = max > 1 && window.innerWidth <= 1279;
          grid.classList.toggle('fade-left', scrollable && grid.scrollLeft > 1);
          grid.classList.toggle('fade-right', scrollable && grid.scrollLeft < max - 1);
