  .cd-select-wrap{position:relative;}
  .cd-select-trigger{display:none;}
  .cd-select-options{display:none;}

  /* 커스텀 드롭다운(트리거+목록) UI - 데스크탑/모바일 공통 적용 */
  .cd-select-wrap select{
    position:absolute; inset:0; width:100%; height:100%;
    opacity:0; pointer-events:none;
  }
  .cd-select-trigger{
    display:flex; align-items:center; justify-content:space-between; gap:8px;
    width:100%; font-family:inherit; font-size:14px; color:#111; text-align:left;
