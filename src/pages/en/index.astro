---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/global.css';
// 헤더·푸터는 한국어와 같은 공용 컴포넌트를 쓴다(라벨·IA는 src/i18n/nav.ts에서 로케일별로).
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

// hreflang: 존재하는 로케일만(ko·en). ja 페이지 생성 후 추가.
const alternates = [
  { lang: 'ko', href: '/' },
  { lang: 'en', href: '/en' },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Refinery",
  "url": "https://refinery.kr/",
  "logo": "https://refinery.kr/logo_Refinery_symbol.svg",
  "description": "Refine the complexity of industrial data into clear insight — from collection to AI analysis, prediction, and autonomous control. Build an organization that decides with data.",
  "sameAs": []
};
---
<BaseLayout
  title="Refinery — Refining complexity into pure insight"
  ogTitle="Refinery"
  description="Refine the complexity of industrial data into clear insight — from collection to AI analysis, prediction, and autonomous control. Build an organization that decides with data."
  ogDescription="Refining complexity into pure insight"
  canonical="/en"
  alternates={alternates}
  jsonLd={jsonLd}
>

<Nav />

<!-- HERO -->
<main id="main">
<section id="hero">
  <div class="container">
    <div class="hero-row">
      <div class="hero-text">
        <h1><span translate="no">Refinery</span> <span class="hero-title-accent">Industrial AI OS</span></h1>
        <p>Data and documents scattered across your operations are connected into a single body of industrial knowledge.<br>AI understands the field and supports every operational decision, from predictive maintenance to quality, energy, <span class="hero-nb">and autonomous</span> operation.</p>
     </div>
      <div class="hero-actions">
        <a href="/en/contact" class="hero-demo-link" onclick="if(window.openContactDrawer){openContactDrawer();return false;}">
          Request a demo
          <svg width="20" height="20" viewBox="0 -960 960 960" xmlns="http://www.w3.org/2000/svg" fill="currentColor"><path d="m553.85-253.85-42.16-43.38L664.46-450H180v-60h484.46L511.69-662.77l42.16-43.38L780-480 553.85-253.85Z"/></svg>
        </a>
     </div>
   </div>
    <div class="hero-motion-placeholder">
      {/* 클릭 레이어. iframe의 pointer-events를 열면 사용자가 데모 내부 UI를
          조작하게 되므로, 칸 위에 투명 버튼을 덮고 postMessage로만 제어한다. */}
      <button type="button" id="hero-demo-toggle" class="hero-demo-toggle" aria-label="Play / pause demo" aria-pressed="false">
        <span class="hero-demo-toggle-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor" width="26" height="26"><path d="M8 5v14l11-7z"/></svg>
       </span>
      </button>
      <iframe id="hero-agent-iframe" data-src="/agent-replay-demo-en" loading="lazy" title="Refinery Industrial AI OS demo" scrolling="no" tabindex="-1" style="display:block;border:none;position:absolute;top:0;left:0;transform-origin:top left;pointer-events:none;"></iframe>
       </div>

 </div>
  
  <script is:inline>
    (function() {
      // 데모 안의 무대(.stage)는 1320x840 고정이고 K = min(폭/1320, 높이/840)로 줄어든다.
      // 예전엔 iframe이 1440x900이라 높이 쪽이 먼저 걸려(900/840 < 1440/1320) 무대 폭이
      // 1414px에 그쳤고, 남는 13px씩이 데모 페이지 배경(#E9ECEF)으로 보였다.
      // 높이를 비율보다 살짝 크게 잡아 K가 폭에서 정해지게 하면 무대가 폭을 정확히 채운다.
      var STAGE_W = 1320, STAGE_H = 840;
      var HERO_AGENT_W = 1440;
      var HERO_AGENT_H = Math.ceil(HERO_AGENT_W * STAGE_H / STAGE_W) + 2;  // 918
      function resizeHeroAgent() {
        var wrapper = document.querySelector('.hero-motion-placeholder');
        if (!wrapper) return;
        var w = wrapper.offsetWidth;
        var h = wrapper.offsetHeight;
        // 폭 기준으로만 스케일링해 어느 폭에서나 데모 화면 전체가 그대로 보이게 한다.
        // 예전에는 900px 이하에서 좌측 세션 레일(무대 252px)을 잘라 본문을 키웠는데,
        // 화면이 잘려 보인다는 지적이 있어 걷었다. 대신 좁을수록 글씨가 작아진다.
        var scale = w / HERO_AGENT_W;
        var leftOffset = 0;
        var scaledH = HERO_AGENT_H * scale;
        // 세로로 남는 자투리는 가운데를 기준으로 잘라 낸다(칸에 overflow: hidden이 걸려 있다).
        // Math.max(0, ...)이면 자투리가 아래에 배경으로 남는다.
        var topOffset = (h - scaledH) / 2;
        var iframe = document.getElementById('hero-agent-iframe');
        if (iframe) {
          iframe.style.width = HERO_AGENT_W + 'px';
          iframe.style.height = HERO_AGENT_H + 'px';
          iframe.style.transform = 'scale(' + scale + ')';
          iframe.style.top = topOffset + 'px';
          iframe.style.left = leftOffset + 'px';
        }
      }
      /* 클릭으로 재생/일시정지. 상태는 데모가 refinery-hero-state로 돌려준다. */
      function initHeroToggle() {
        var btn = document.getElementById('hero-demo-toggle');
        var frame = document.getElementById('hero-agent-iframe');
        if (!btn || !frame) return;
        btn.addEventListener('click', function () {
          if (!frame.getAttribute('src')) return;   /* 아직 안 불러왔으면 무시 */
          try { frame.contentWindow.postMessage({ type: 'refinery-hero-toggle' }, '*'); } catch (e) {}
        });
        window.addEventListener('message', function (e) {
          if (!e.data || e.data.type !== 'refinery-hero-state') return;
          btn.classList.toggle('is-paused', !!e.data.paused);
          btn.setAttribute('aria-pressed', e.data.paused ? 'true' : 'false');
        });
      }
      window.addEventListener('load', initHeroToggle);

      window.resizeHeroAgent = resizeHeroAgent;
      window.addEventListener('load', resizeHeroAgent);
      window.addEventListener('resize', resizeHeroAgent);
      document.addEventListener('DOMContentLoaded', resizeHeroAgent);

      function loadHeroDemo() {
        var f = document.getElementById('hero-agent-iframe');
        if (f && !f.src && f.getAttribute('data-src')) {
          f.addEventListener('load', resizeHeroAgent);
          f.src = f.getAttribute('data-src');
        }
      }
      if ('requestIdleCallback' in window) {
        window.addEventListener('load', function () { requestIdleCallback(loadHeroDemo, { timeout: 1500 }); });
      } else {
        window.addEventListener('load', function () { setTimeout(loadHeroDemo, 200); });
      }

      /* 히어로 데모가 재생 완료된 뒤 화면 밖으로 나갔다가 다시 들어오면
         재생을 처음부터 다시 시작한다 (멈춰있는 화면처럼 보이지 않도록). */
      function initHeroReplay() {
        var heroSection = document.getElementById('hero');
        var iframe = document.getElementById('hero-agent-iframe');
        if (!heroSection || !iframe || !('IntersectionObserver' in window)) return;
        var hasLeft = false;
        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              if (hasLeft) {
                hasLeft = false;
                try {
                  iframe.contentWindow.postMessage({ type: 'refinery-hero-replay' }, '*');
                } catch (e) { /* 접근 불가 시 무시 */ }
              }
            } else {
              hasLeft = true;
            }
          });
        }, { threshold: 0.5 });
        observer.observe(heroSection);
      }
      window.addEventListener('load', initHeroReplay);
    })();
  </script>
  </section>

<!-- PLATFORM -->
<section id="platform" style="background:#111316;border-top:1px solid #E3E7EC;">
  <style is:global>
    #platform .section-header p {
      color: #959CA5;
    }
    /* 소제목을 <br> 기준 2줄로 유지한다. 공통값 360px에서는 긴 줄(391px)이
       다시 감겨 3줄이 됐다. 400px이면 2줄로 들어가고, 제목 옆 여유(1024px에서
       522px)가 충분해 우측 배치도 그대로다. */
    #platform .section-header-row p {
      max-width: 400px;
    }

    /* FAQ 4번 답변을 절 경계에서 끊는다. <br> 없이 두면 브라우저가
       'and / integrates'처럼 접속사만 줄 끝에 남긴다.
       1행 'Refinery tears nothing out … your existing systems'에 633px가 필요한데,
       FAQ가 2열인 구간에서는 답변 폭이 그보다 좁아(1100px에서 617px) 1행이 다시
       감겨 5줄이 된다 → 그 구간에서만 <br>를 걷는다.
       900px 이하는 FAQ가 1열로 바뀌며 폭이 되레 넓어져(900px에서 837px) 그대로 둔다.
       숨겨도 마크업에는 남아 번역기가 여기서 세그먼트를 끊지만, 절 경계라
       'and integrates bidirectionally with them.'만으로도 뜻이 온전하다. */
    @media (min-width: 901px) and (max-width: 1149px) {
      .faq-wide-br { display: none; }
    }

    /* FAQ 1번도 같은 이유로 절 경계에서 끊는다. <br> 없이 두면
       'the complexity of your / existing systems.'처럼 두 낱말만 남는다.
       1행 'From a PoC … the scale of your operation'에는 539px가 필요해
       4번(633px)보다 여유가 있다 → 걷는 구간도 그만큼 좁다.
       1024px 이상이면 답변 폭이 566px라 1행이 들어가고, 960px에서는 523px로
       모자라 'operation'만 홀로 남는다. */
    @media (min-width: 901px) and (max-width: 1023px) {
      .faq-mid-br { display: none; }
    }

    /* 보안 카드 본문의 낱말 고아는 <br>가 아니라 브라우저에 맡긴다.
       손으로 <br>를 박으면 그 폭에서만 맞고 다른 폭에서 어긋난다(위 FAQ가 그 예다 —
       <br> 하나에 브레이크포인트가 둘 붙었다). pretty는 앞줄을 최대한 채우고
       마지막 줄만 조정해, 폭이 변해도 마지막 줄에 한 낱말만 남지 않는다.
       1024px에서 'and AES-256 at / rest.'와 '(RBAC) enforces least / privilege.'가
       각각 한 낱말을 남겼는데 둘 다 사라진다.
       balance가 아니라 pretty다 — balance는 모든 줄을 고르게 나눠 짧은 제목용이고,
       여러 줄 본문에서는 각 줄이 덜 차 카드끼리 들쭉날쭉해진다.
       같은 판단이 src/styles/industry.css:1138 에 이미 적혀 있다.
       국문에는 걸지 않는다 — 수동 <br>가 자리를 잡고 있어 효과가 없다. */
    #security .sec-card-body p { text-wrap: pretty; }

    /* 통합 · 보안 대제목은 소제목을 오른쪽에 두려고 손으로 3줄로 쪼갠 것이다(a320fe6).
       .section-header-row 는 flex-wrap 이라, 대제목 폭 + gap 32px + 소제목 폭이
       컨테이너를 넘으면 소제목이 아래로 내려간다. 내려가고 나면 대제목이 한 행을
       통째로 쓰므로 쪼개 둘 이유가 없다 → 그 지점부터 <br>를 걷는다.

         통합  대제목 590px + 32 + 소제목 491px = 1113px  → 1221~1230px 사이에서 내려간다
         보안  대제목 458px + 32 + 소제목 556px = 1046px  → 1151~1160px 사이에서 내려간다

       경계가 달라 클래스를 나눴다. <br> 앞 공백은 필수다 —
       숨겼을 때 'have,or'처럼 낱말이 붙는다(같은 날 FAQ에서 겪었다). */
    /* 통합 섹션 제목의 줄 나눔은 어느 폭에서나 켜 둔다. 예전에는 1229px 아래에서
       꺼서 자연 줄바꿈에 맡겼는데, 그러면 폭마다 끊기는 자리가 달라졌다.
       세 행이 최장 390px(28px 글자)이라 제목 폭이 그만큼 되는 460px 까지 세 줄로
       선다. 그 아래는 행이 감겨 네 줄이 된다. */
    @media (max-width: 1159px) { .sec-hd-br { display: none; } }

    /* #teams 미리보기 — 901~1280px에서도 세로로 나눈다.
       원래는 이미지 위에 제목·본문을 얹고, 왼쪽 28.5% 페이드가 글 배경 노릇을 했다.
       그런데 텍스트 박스는 <br>로 줄이 고정돼 352px로 붙박이인데 페이드는 폭의 %라
       같이 줄어든다 → 좁아질수록 글이 배경을 벗어나 이미지 위로 올라온다.
       Plate 탭에서 본문이 막대 차트에 묻혔다(910px에서 배경 밖 125px).

       배경을 px로 고정해 봤지만 그만큼 이미지를 가려 접었다. 900px 이하에서 이미
       쓰는 세로 분리를 1280px까지 올리는 쪽이 탭·이미지와 무관하게 해결된다.

       900px 이하는 global.css 가 맡는다 — 거기 값은 화면 끝까지 붙이는 모바일용이라
       (margin-right:-24px 등) 여기서는 데스크톱 여백에 맞춘 값을 따로 쓴다.
       JS 쪽 resizeDash 의 모바일 판정도 같은 1280으로 맞춰야 이미지가 제자리에 온다.
       국문도 같은 문제를 안고 있지만 global.css 가 공용이라 국문 작업 때 함께 옮긴다. */
    /* #teams 탭 여섯 개는 이 섹션이 말하는 "everything"의 목록이다.
       900px 이하에서 가로 스크롤(scroll-snap)로 넘기게 되어 있었는데, 880px에서
       네 개 반만 보인다 — 다 갖췄다는 주장을 정작 화면이 가린다. 줄로 나눠 다 보인다.

       한 줄에 여섯 개가 온전히 들어가려면 칸이 152px는 되어야 한다 — 1024px까지는
       들어가고 그 아래부터 잘린다. 잘리기 전에 여유를 두어 1089px 이하에서 줄로 나눈다.
       3열은 바 폭 456px가 필요해 520px 아래에서는 2열로 내린다.
       테두리는 줄 끝에서 지우고 둘째 줄부터 위에 긋는데, 열 수가 바뀌면
       그 자리도 바뀌므로 nth-child 를 구간마다 다시 잡는다.
       국문도 같은 구조다 — global.css 가 공용이라 국문 작업 때 함께 옮긴다. */
    @media (max-width: 1089px) {
      #teams .teams-menu-horizontal {
        flex-wrap: wrap; overflow-x: hidden; margin-right: 0;
        border-radius: var(--radius) var(--radius) 0 0 !important;
        scroll-snap-type: none;
      }
      #teams .teams-tab-btn { flex: 1 1 33.333%; scroll-snap-align: none; padding: 16px 8px; }
      #teams .teams-tab-btn:nth-child(3n) { border-right: none; }
      #teams .teams-tab-btn:nth-child(n+4) { border-top: 1px solid var(--border); }
    }
    /* 카드 오른쪽 정렬은 900px 이하만 해당한다 — global.css 가 거기서만
       margin-right:-24px 로 화면 끝까지 흘리기 때문이다. 가로 스크롤 시절
       '더 있다'는 힌트였는데, 탭바가 줄바꿈으로 바뀌며 탭바만 컨테이너 안에서
       끝나 오른쪽이 어긋났다. 모서리도 왼쪽만 둥글던 것을 양쪽으로 되돌린다. */
    @media (max-width: 900px) {
      #teams .teams-preview {
        margin-right: 0;
        border-radius: 0 0 var(--radius) var(--radius) !important;
      }
    }
    @media (max-width: 520px) {
      #teams .teams-tab-btn { flex-basis: 50%; }
      #teams .teams-tab-btn:nth-child(3n) { border-right: 1px solid var(--border); }
      #teams .teams-tab-btn:nth-child(2n) { border-right: none; }
      #teams .teams-tab-btn:nth-child(n+3) { border-top: 1px solid var(--border); }
    }

    /* 세로로 나뉘면 글이 미리보기 폭을 통째로 쓴다 — 오버레이 시절 좁은 왼쪽 칸에
       맞춰 넣어 둔 줄바꿈은 여기서 짧은 줄만 만든다. 1280px 이하에서 본문만 걷는다.
       제목은 두 줄 구성이 그 자체로 의도된 것이라 그대로 둔다.
       탭을 바꾸면 JS가 teamsTextMap 의 \n 을 textContent 로 넣는데,
       white-space:normal 이면 그 \n 도 공백이 되어 함께 풀린다.
       <br> 앞 공백은 필수다 — Astro 가 <br> 뒤 개행을 지워서, 그냥 숨기면
       'historydata'처럼 붙는다(같은 날 FAQ에서 겪었다). */
    
    /* Industrial AI OS 캡처는 위쪽에 가로 실선이 들어 있다(원본 y≈136px).
       JS 가 이미지를 위로 밀어 자르면서 그 선이 미리보기 상단 10px 자리에 올라온다.
       기존 14px 페이드는 그 지점에서 이미 70% 투명해져 선을 못 가린다 —
       페이드를 키워도 대비만 줄 뿐이라, 앞 24px 을 불투명하게 덮고 나머지로 잇는다.
       높이는 px 이 아니라 미리보기 높이의 8%다. 좁아질수록 이미지가 작아져 선도 위로
       올라오는데(1000px 10px → 390px 4px), 40px 으로 고정하면 390px 에서 이미지의
       20%를 덮어 위쪽이 통째로 가린다. %로 두면 밴드도 같이 줄어든다.
       탭마다 선 위치가 달라(Pipeline 19·22px · Calendar 21px) 이 탭만 골라 건다.
       :has() 로 이미지 src 를 보므로 JS 는 그대로 둔다. */
    @media (max-width: 1280px) {
      #teams #iframe-wrapper:has(#dash-image[src*="Solutions-02-ai-agent"])::before {
        height: 8%;
        background: linear-gradient(to bottom, #F6F8FA 0%, #F6F8FA 60%, rgba(246,248,250,0) 100%);
      }
    }
@media (max-width: 1280px) {
      /* 줄 나눔은 renderPreviewBody 가 폭에 맞춰 <br> 로 다시 넣는다. 예전에는 여기서
         <br> 를 숨겨 데스크탑 줄 나눔을 풀었는데, 그러면 숨은 자리의 공백까지 사라져
         `conversationally.The` 처럼 붙었다(국문에는 없던 규칙). */
      #teams .teams-preview-text p { white-space: normal; }
    }

    /* 줄바꿈을 걷고 나니 이번엔 한 줄이 너무 길어졌다 — 1280px에서 본문이 1103px
