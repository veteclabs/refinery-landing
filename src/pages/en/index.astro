/* 미리보기 본문은 폭에 따라 다르게 끊는다.
   1281px 이상(오버레이): 좁은 왼쪽 칸에 맞춘 teamsTextMap 의 \n 을 그대로 쓴다.
   1280px 이하(세로 분리): 글이 폭을 통째로 쓰므로 그 \n 은 문장 중간을 끊는 꼴이 된다.
   공백으로 풀고 문장 끝에서만 나눈다 — 마침표 뒤에 이어지는 글자가 있을 때만 끊어
   마지막 문장 뒤에 빈 줄이 생기지 않게 한다. */
function renderPreviewBody(el) {
  var raw = el.dataset.raw;
  if (raw == null) return;
  if (window.innerWidth > 1280) { el.textContent = raw; return; }
  // 세로 분리 폭: teamsTextMap 의 4번째 값이 있으면 그 줄 나눔을 쓰고,
  // 없으면 문장 끝에서 자동으로 나눈다(한 문장뿐인 탭은 나눌 자리가 없어 4번째를 둔다).
  var wide = el.dataset.wide;
  var src = wide ? wide
    : raw.replace(/\s*\n\s*/g, ' ').trim().replace(/([.!?])\s+(?=\S)/g, '$1\n');
  paintPreviewBody(el, src);
  var narrow = el.dataset.narrow;
  if (!narrow) return;
  var lh = parseFloat(getComputedStyle(el).lineHeight) || 0;
  if (!lh) return;
  var lines = function () { return Math.round(el.scrollHeight / lh); };
  // 그 줄이 감기기 시작하면 더 잘게 나눈 5번째 값으로 바꾼다.
  if (lines() <= src.split('\n').length) return;
  paintPreviewBody(el, narrow);
  // 그것마저 감기는 폭에서는 끊어 둔 자리가 오히려 낱말을 홀로 남긴다
  // (`… in the / ontology`). 줄 나눔을 풀어 문장 단위로 되돌린다 — 자연 줄바꿈은
  // 어절에서 끊으니 고아가 생기지 않는다.
  if (lines() > narrow.split('\n').length) paintPreviewBody(el, src);
}
function paintPreviewBody(el, src) {
  el.textContent = '';
  src.split('\n').forEach(function (line, i) {
    if (i) el.appendChild(document.createElement('br'));
    el.appendChild(document.createTextNode(line));
  });
}
function initPreviewBody() {
  var el = document.getElementById('teamsPreviewBody');
  if (!el) return;
  if (el.dataset.raw == null) {
    // 초기 렌더는 마크업의 <br> 로 줄이 잡혀 있다 — 그것을 \n 으로 되돌려 원본으로 삼는다
    el.dataset.raw = el.innerHTML.replace(/<br\s*\/?>/gi, '\n').replace(/<[^>]+>/g, '');
    // 첫 화면의 탭은 switchDash 를 거치지 않아 wide 가 비어 있었다. 그래서 세로 분리
    // 폭에서 기본 탭만 지정한 줄 나눔 대신 문장 끝 자동 분할로 그려졌다.
    // 활성 버튼의 onclick 에 적힌 키로 teamsTextMap 의 4번째 값을 찾아 채운다.
    var btn = document.querySelector('#teams .teams-tab-btn.active');
    var m = btn && (btn.getAttribute('onclick') || '').match(/,\s*'([^']+)'\s*\)/);
    var t = m && typeof teamsTextMap !== 'undefined' && teamsTextMap[m[1]];
    if (t && t[3]) { el.dataset.wide = t[3]; }
    if (t && t[4]) { el.dataset.narrow = t[4]; }
  }
  renderPreviewBody(el);
}
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initPreviewBody);
} else {
  initPreviewBody();
}
window.addEventListener('resize', function () {
  var el = document.getElementById('teamsPreviewBody');
  if (el) renderPreviewBody(el);
});

function switchDash(btn, src, key) {
  if (typeof mixpanel !== "undefined") mixpanel.track("Solutions Tab Click", { tab: key });
  document.querySelectorAll('.teams-tab-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  var img = document.getElementById('dash-image');
  window.needsRightCrop = NO_SCROLL_KEYS.indexOf(key) === -1;
  window.dashPanContent = DASH_PAN_MAP[key] || 0;
  window.dashKey = key;

  if (img) img.src = src;
  if (window.resizeDash) window.resizeDash();
  var t = teamsTextMap[key];
  if (t) {
    var taglineEl = document.getElementById('teamsPreviewTagline');
    var titleEl = document.getElementById('teamsPreviewTitle');
    var bodyEl = document.getElementById('teamsPreviewBody');
    if (taglineEl) taglineEl.textContent = t[2];
    if (titleEl) titleEl.textContent = t[0];
    if (bodyEl) {
    bodyEl.dataset.raw = t[1];
    if (t[3]) { bodyEl.dataset.wide = t[3]; } else { delete bodyEl.dataset.wide; }
    if (t[4]) { bodyEl.dataset.narrow = t[4]; } else { delete bodyEl.dataset.narrow; }
    renderPreviewBody(bodyEl);
  }
  }
}
