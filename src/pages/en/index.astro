---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/global.css';
import '../../styles/vetec-hero.css';
// 헤더·푸터는 한국어와 같은 공용 컴포넌트를 쓴다(라벨·IA는 src/i18n/nav.ts에서 로케일별로).
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { legal } from '../../data/legal';
import { heroCards } from '../../data/heroMarkers';
import HeroPinArt from '../../components/HeroPinArt.astro';
import ScrollReveal from '../../components/ScrollReveal.astro';
import HeroZoom from '../../components/HeroZoom.astro';

// hreflang: 존재하는 로케일만(ko·en). ja 페이지 생성 후 추가.
const alternates = [
  { lang: 'ko', href: '/' },
  { lang: 'en', href: '/en' },
];

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Refinery",
  "url": "https://refinery.kr/",
  "logo": "https://refinery.kr/logo_Refinery_symbol.svg",
  "description": "Refinery is the industrial AI OS. It ties equipment, systems and documents in the field into one ontology, so people and AI decide and act on the same evidence.",
  "sameAs": []
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Refinery",
  "alternateName": ["Refinery Industrial AI OS"],
  "url": "https://refinery.kr/en",
  "inLanguage": "en",
  "description": "Refinery is the industrial AI OS. It ties equipment, systems and documents in the field into one ontology, so people and AI decide and act on the same evidence.",
  "publisher": { "@type": "Organization", "name": legal('en').company.legalName },
};

const jsonLd = [orgSchema, websiteSchema];
---
<BaseLayout
  title="Refinery — Industrial AI OS for manufacturing and energy operations"
  ogTitle="Refinery"
  description="Refinery is the industrial AI OS. It ties scattered manufacturing and energy field data (SCADA, MES, ERP, sensors) into one ontology, and AI agents help you decide with the evidence shown — from predictive maintenance to power management and quality prediction."
  ogDescription="Refining complexity into pure insight"
  canonical="/en"
  alternates={alternates}
  jsonLd={jsonLd}
>

<Nav />

<!-- HERO -->
<main id="main">
<section id="hero">
  <HeroZoom />
  <div class="hero-stage">
    <div class="container">
      <h1><span class="hero-title-lead">Scattered sites,</span><br><span class="hero-title-accent">one operating system</span></h1>
      <p class="hero-sub"><span class="hero-eyebrow" translate="no">Refinery Industrial AI OS</span>Data and documents scattered across your operations are connected into a single body of industrial knowledge.<br>AI understands the field and supports every operational decision, from predictive maintenance to quality, energy, <span class="hero-nb">and autonomous</span> operation.</p>
      {/* Pressing a pin puts that marker's text here — right under the sub-copy, on the
          same left edge. It takes the head grid's second row, right column, so the spot
          follows the sub-copy on its own.
          The cell is zero-height and the card is absolutely placed inside it: otherwise
          the head grows when the card opens and pushes the graphic down.
          The box is left empty: the script below fills it from <template data-hero-card>. */}
      <div class="hero-pin-layer">
        <div class="hero-pin-card" id="heroPinCard" role="region" aria-live="polite" hidden>
          <div class="hero-pin-card__art" aria-hidden="true"></div>
          <div class="hero-pin-card__body">
            <h3 class="hero-pin-card__title"></h3>
            <p class="hero-pin-card__desc"></p>
          </div>
        </div>
      </div>
     </div>
    <div class="hero-motion-placeholder">
      {/* VETEC hero graphic — usage and options live in public/hero/README.md.
          Marker copy and coordinates are in MARKERS at the top of public/hero/vetec-hero.js.
          .vh defaults to viewport height, so global.css hands it a --vh-height that fits
          the box. Without JS the static image shows instead. */}
      <section class="vh no-js" data-vetec-hero data-assets="/hero/assets-flat/"
        data-tilt-x="4.8" data-tilt-y="3.2" data-zoom="1" aria-label="VETEC industrial site digital twin">
        <img class="vh-static" src="/hero/assets-flat/static.webp" alt="Digital twin graphic: an air compressor, air receiver tank and pump-motor skid on a site set in mountain terrain">
      </section>
    </div>
  </div>
  
  <HeroPinArt />
  <script is:inline src="/hero/vetec-hero.js" defer></script>
  <script is:inline>
    /* 히어로 핀 — 누르면 무대 왼쪽 아래 카드에 그 마커의 글이 선다.
       ⚠️ 호버로는 열리지 않는다. 그래픽(public/hero/vetec-hero.js)에서 호버 · 포커스 ·
          탭으로 카드를 열던 손잡이를 뺐고, 핀마다 나던 카드(.vh-card)는 CSS 로 숨겼다.
       ⚠️ 핀은 그래픽이 나중에 만든다 — 지금 찾아 두면 늘 null 이다. document 에 한 번만
          듣고(이벤트 위임) 누른 자리에서 마커를 거슬러 올라간다.
       ⚠️ 열린 핀 표시는 그래픽의 is-pinned 를 그대로 쓴다(면이 차고 + 가 × 로 돈다).
          그 클래스를 건드리는 쪽은 이제 여기뿐이다. */
    (function () {
      var hero = document.getElementById('hero');
      var card = document.getElementById('heroPinCard');
      if (!hero || !card) return;
      var art = card.querySelector('.hero-pin-card__art');
      var tt = card.querySelector('.hero-pin-card__title');
      var ds = card.querySelector('.hero-pin-card__desc');
      var open = null;

      /* 핀을 처음 누르면 그래픽이 한 벌 바뀐다 — 도면 같은 판(assets-flat)에서
         빛을 계산한 판(assets)으로 간다. '들여다보니 현장이 켜진다' 는 뜻이다.
         ⚠️ 무거운 판은 미리 받아 둔다. 핀은 그래픽이 다 자란 뒤(#hero.is-grown)에만
            눌리므로, 그 클래스가 붙는 순간이 받아 둘 자리다 — 누를 때 받으면
            2.3MB 를 기다리는 동안 아무 일도 안 일어난다.
         ⚠️ 받아 둔 뒤 src 만 갈아 끼운다. 캐시에 있으므로 한 프레임에 바뀐다.
            층마다 제 등장 애니메이션(.vh-fade · .vh-glow · .vh-flow)이 걸려 있어
            겹쳐 띄우면 그 애니메이션이 서로 부딪힌다.
         ⚠️ 한 번 바뀌면 그대로 둔다. 핀을 닫아도 되돌리지 않는다. */
      var LIT = '/hero/assets/', FLAT = '/hero/assets-flat/';
      var litReady = false, lit = false;
      function preloadLit() {
        if (litReady) return;
        litReady = true;
        var names = ['near'];
        for (var i = 0; i < names.length; i++) { var im = new Image(); im.src = LIT + names[i] + '.webp'; }
      }
      /* 바뀌는 것은 가운데 설비 층(near.webp) 한 장뿐이다 — 산 · 능선 · 전경 지형과
         땅에 그려진 윤곽선 · 빛줄기(near-contour · near-glow)는 도면 판 그대로다.
         ⚠️ 밑장을 지우지 않고 그 위에 한 겹 얹는다. 두 겹이 겹쳐 있으므로 얹히는
            쪽의 투명도만 움직이면 건너감이 되고, 되돌릴 때도 걷어 내기만 하면 된다. */
      function litLayer() { return hero.querySelector('.vh-lit-near'); }
      function baseNear() {
        var imgs = hero.querySelectorAll('.vh-layer');
        for (var i = 0; i < imgs.length; i++) {
          var s = imgs[i].getAttribute('src') || '';
          if (s.indexOf(FLAT) === 0 && /\/near\.webp$/.test(s) && !imgs[i].classList.contains('vh-lit-near')) return imgs[i];
        }
        return null;
      }
      var dimT = 0;
      function light() {
        if (lit) return;
        clearTimeout(dimT);
        var old = litLayer();
        if (old && old.parentNode) old.parentNode.removeChild(old);
        var base = baseNear();
        if (!base) return;
        lit = true;
        var over = base.cloneNode(false);
        over.setAttribute('src', LIT + 'near.webp');
        over.setAttribute('aria-hidden', 'true');
        over.setAttribute('alt', '');
        over.classList.add('vh-lit-near');
        base.parentNode.insertBefore(over, base.nextSibling);
      }
      function dim() {
        if (!lit) return;
        lit = false;
        var over = litLayer();
        if (!over) return;
        over.classList.add('is-out');
        clearTimeout(dimT);
        dimT = setTimeout(function () {
          var o = litLayer();
          if (o && o.parentNode) o.parentNode.removeChild(o);
        }, 460);
      }

      /* is-grown 은 HeroZoom 이 진행도를 보고 붙인다 — 그때 미리 받아 둔다.
         ⚠️ 떨어질 때도 본다. 스크롤을 되올려 그래픽이 다시 작아지면 핀이 사라지는데,
            카드만 남으면 무엇에 붙은 글인지 알 수 없다 — 같이 닫는다.
         ⚠️ hide() 가 #hero 의 class 를 또 건드리지만(pin-open) 그때는 open 이 이미
            비어 있어 되돌이로 돌지 않는다. */
      if (window.MutationObserver) {
        var mo = new MutationObserver(function () {
          if (hero.classList.contains('is-grown')) preloadLit();
          else if (open) hide();
        });
        mo.observe(hero, { attributes: true, attributeFilter: ['class'] });
        if (hero.classList.contains('is-grown')) preloadLit();
      } else { preloadLit(); }

      function mark(id) {
        var ms = hero.querySelectorAll('.vh-marker');
        for (var i = 0; i < ms.length; i++) {
          ms[i].classList.toggle('is-pinned', ms[i].getAttribute('data-id') === id);
        }
        /* 하나를 고르면 나머지 핀은 물러선다(CSS 의 #hero.pin-open). */
        hero.classList.toggle('pin-open', !!id);
      }
      function hide() {
        card.hidden = true;
        /* 핀을 풀면 그래픽도 예전 판으로 돌아간다. */
        dim();
        mark(null); open = null;
      }
      function show(id) {
        var tpl = document.querySelector('template[data-hero-card="' + id + '"]');
        if (!tpl) return;
        var h = tpl.content.querySelector('.vh-card__title');
        var p = tpl.content.querySelector('.vh-card__desc');
        /* 윗자리 그래픽은 HeroPinArt 가 둔 <template data-hero-art> 에서 꺼낸다 —
           마커 id 로 찾는다. 없으면 그 자리를 비워 둔다(글만 선다). */
        var atpl = document.querySelector('template[data-hero-art="' + id + '"]');
        art.textContent = '';
        if (atpl) art.appendChild(atpl.content.cloneNode(true));
        art.hidden = !atpl;
        tt.textContent = h ? h.textContent : '';
        ds.textContent = p ? p.textContent : '';
        card.hidden = false;
        mark(id);
        open = id;
      }

      document.addEventListener('click', function (e) {
        var t = e.target;
        if (!t || !t.closest) return;
        var pin = t.closest('.vh-pin');
        if (pin && hero.contains(pin)) {
          var m = pin.closest('.vh-marker');
          var id = m && m.getAttribute('data-id');
          if (!id) return;
          light();
          if (open === id) hide(); else show(id);
          return;
        }
        /* 카드 안을 누르는 건 아무 일도 아니다 — 닫는 건 같은 핀을 다시 누르거나
           바깥을 누르거나 Esc 다. */
        if (t.closest('.hero-pin-card')) return;
        if (open) hide();
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && open) hide();
      });
    })();
  </script>

  {/* Marker card contents. The graphic (public/hero/vetec-hero.js) draws the pins and an
      empty card shell; this fills it — the script below matches them by data-id.
      Copy lives in src/data/heroMarkers.ts, styling in global.css. */}
  {heroCards.en.map((c) => (
    <template data-hero-card={c.id} data-hero-card-label={c.title}>
      <div class="vh-card__top"><i class={`ph ${c.icon} vh-card__ic`} aria-hidden="true"></i></div>
      <h3 class="vh-card__title">{c.title}</h3>
      <p class="vh-card__desc">{c.desc}</p>
    </template>
  ))}
  <script is:inline type="module">
    (function () {
      /* ⚠️ 그래픽 스크립트가 카드 껍데기를 만든 뒤에 돌아야 한다.
         vetec-hero.js 는 defer 라 파싱이 끝난 뒤 실행되는데, 보통의 인라인 스크립트는
         파싱 도중 즉시 실행된다 — 그때는 카드가 아직 없어 빈 상자만 남는다.
         type="module" 이면 defer 와 같은 큐에 들어가 문서 순서대로 실행되고,
         그래도 늦는 경우를 대비해 카드가 생길 때까지 DOM 을 지켜본다. */
      function fill() {
        var cards = document.querySelectorAll('#hero .vh-card');
        if (!cards.length) return false;
        var filled = 0;
        for (var i = 0; i < cards.length; i++) {
          var card = cards[i];
          if (card.childElementCount) { filled++; continue; }
          var marker = card.closest('.vh-marker');
          if (!marker) continue;
          var tpl = document.querySelector('template[data-hero-card="' + marker.getAttribute('data-id') + '"]');
          if (!tpl) continue;
          card.appendChild(tpl.content.cloneNode(true));
          /* 핀과 카드의 접근성 이름도 문구에서 가져온다 — 그래픽은 더 이상 문구를 모른다. */
          var label = tpl.getAttribute('data-hero-card-label') || '';
          card.setAttribute('aria-label', label);
          var pin = marker.querySelector('.vh-pin');
          if (pin) pin.setAttribute('aria-label', label);
          filled++;
        }
        return filled === cards.length;
      }
      if (fill()) return;
      var hero = document.getElementById('hero');
      if (!hero || !('MutationObserver' in window)) return;
      var obs = new MutationObserver(function () { if (fill()) obs.disconnect(); });
      obs.observe(hero, { childList: true, subtree: true });
      /* 그래픽이 끝내 안 뜨는 경우까지 지켜보지는 않는다. */
      setTimeout(function () { obs.disconnect(); }, 8000);
    })();
  </script>

  </section>

<ScrollReveal />

<!-- PLATFORM -->
<section id="platform">
  <style is:global>
    /* 섹션은 길이만 쥔다. 화면에 보이는 것은 그 안의 무대 하나다 —
       320vh 중 100vh 가 무대이고, 남는 220vh 가 스크롤로 쓰는 몫이다.
       (낱말 0~45% · 배경과 본문 45~72% · 그대로 멈춤 72~100%) */
    #platform { height: 320vh; padding: 0; background: #151B23; }

    #platform .pf-stage {
      position: sticky;
      top: 0;
      height: 100vh;
      /* 내비(fixed · 70px)가 무대 윗부분을 덮는다. 그만큼 위를 비워 두어야
         '보이는 화면' 의 위아래 여백이 같아진다 — box-sizing 이 border-box 라
         높이는 100vh 그대로다. */
      padding-top: 70px;
      /* ⚠️ 아래 여백은 그래픽이 줄 밖으로 흘러내린 만큼이다. 그림 상자는
         margin-bottom: -7% 로 줄 바닥을 제 안쪽으로 끌어올려 아코디언과 아랫변을
         맞추는데, 그 7% 가 줄 아래로 더 그려진다 — 줄만 가운데에 세우면 보이는
         잉크는 위 78 / 아래 25 로 어긋난다(1440×900 실측). 같은 값을 아래 여백으로
         돌려주면 51/51 로 맞는다. 7% 의 기준인 그림 폭은 아래 max-width 와 같은
         식이라 화면 높이만 따라간다. */
      padding-bottom: calc((100vh - 200px) * 0.0753);
      overflow: hidden;
      /* 제목과 본문이 같은 칸을 나눠 쓴다 — 제목이 빠지는 자리에 본문이 들어선다. */
      display: grid;
      grid-template-areas: "s";
      align-items: center;
      /* 흰 면에서 시작해 바닥에서 정확히 #151B23 에 닿는다 — 무대가 100vh 이고
         타원 세로 반지름이 150vh 라, 바닥(y=100vh)이 33.33% 정지점이다.
         스크롤하면 반지름이 커지며 먹색이 위로 번져 화면 전체를 덮는다.
         ⚠️ 정지점이 % 라 화면 높이가 바뀌어도 비율이 그대로 따라간다. */
      background: radial-gradient(ellipse var(--pf-rx, 180%) var(--pf-ry, 150vh) at 50% 150vh,#151B23 0%,#151B23 33.33%,#1D2A39 34.40%,#253547 35.47%,#2D4055 36.53%,#354C64 37.60%,#3E5772 38.67%,#466382 39.73%,#4F6F91 40.80%,#587CA1 41.87%,#6189B1 42.93%,#6A96C2 44.00%,#74A3D3 45.07%,#7EABDA 46.13%,#89B2DD 47.20%,#92B8E0 48.27%,#9BBEE3 49.33%,#A4C4E5 50.40%,#ABC9E8 51.47%,#B3CEEA 52.53%,#BAD2EC 53.60%,#C0D6EE 54.67%,#C6DAEF 55.73%,#CCDEF1 56.80%,#D1E1F2 57.87%,#D5E4F4 58.93%,#DAE7F5 60.00%,#DEE9F6 61.07%,#E1ECF7 62.13%,#E5EEF8 63.20%,#E8F0F9 64.27%,#EAF2FA 65.33%,#EDF3FA 66.40%,#EFF5FB 67.47%,#F1F6FB 68.53%,#F3F7FC 69.60%,#F5F8FC 70.67%,#F6F9FD 71.73%,#F8FAFD 72.80%,#F9FBFD 73.87%,#FAFCFE 74.93%,#FBFCFE 76.00%,#FBFDFE 77.07%,#FCFDFE 78.13%,#FDFDFE 79.20%,#FDFEFE 80.27%,#FDFEFF 81.33%,#FEFEFF 82.40%,#FEFFFF 84.53%,#FFFFFF 86.67%);
    }
    #platform .pf-stage > * { grid-area: s; min-width: 0; }

    #platform .section-header {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      margin-bottom: 0;
      /* 배경이 어두워지는 동안 같이 빠진다 — 먹색 글자라 그냥 두면 중간의
         회색 구간에서 뭉개진다. */
      opacity: var(--pf-title, 1);
    }
    #platform .section-lead-ko { margin-bottom: 0; }

    /* 대제목의 마지막 낱말이 스크롤을 따라 한 칸씩 바뀐다.
       패턴 → 맥락 → 지식 → 지능. 저절로 돌지 않고 스크롤한 만큼만 간다.
       ⚠️ 마크업에는 완성된 한 줄(데이터에서 지능으로)만 둔다. 스크립트가 못 돌면
          그 한 줄이 그대로 보여야 하고, 색인·번역도 원문을 읽어야 한다.
          바뀌는 낱말은 data-swap 에 둔다. */
    #platform .tw-swap {
      display: inline-block;
      position: relative;
      vertical-align: top;
      text-align: left;
    }
    #platform .tw-swap b {
      display: block;
      font-weight: inherit;
      opacity: 0;
      transform: translateY(70%);
      transition: opacity .3s ease, transform .34s cubic-bezier(.2, .8, .2, 1);
    }
    /* 첫 낱말만 흐름에 남아 줄 높이를 잡는다. 나머지는 그 위에 겹쳐 둔다 —
       흐름에 두면 네 줄이 되어 제목이 네 배로 높아진다. */
    #platform .tw-swap b + b { position: absolute; left: 0; top: 0; width: 100%; }
    #platform .tw-swap b.is-past { opacity: 0; transform: translateY(-70%); }
    #platform .tw-swap b.is-now { opacity: 1; transform: none; }
    @media (prefers-reduced-motion: reduce) {
      #platform .tw-swap b { transition: none; }
    }

    /* 제목 줄. 왼쪽 맞춤이고 아코디언 위에 선다.
       ⚠️ flex: none — 칸이 flex 라 기본값(shrink: 1)이면 줄 높이가 눌려 세 줄이
          한 줄 높이로 찌그러진다. 글자만 잘려 안 보인다. */
    #platform .pf-lead {
      flex: none;
      font-size: clamp(22px, 3vw, 30px);
      font-weight: 600;
      letter-spacing: -0.8px;
      line-height: 1.35;
      color: #F6F8FA;
      max-width: none;
      margin: 0 0 40px;
      text-align: left;
      word-break: keep-all;
    }

    /* 본문은 제목이 빠지는 자리에 떠오르고, 다 뜬 뒤에는 무대가 붙어 있는 동안
       그대로 멈춰 있다 — 아코디언은 그 상태에서 연다.
       두 단은 따로 뜬다. 그래픽이 먼저(--pf-in), 왼쪽 글이 뒤따른다(--pf-in2). */
    #platform .pf-body { pointer-events: var(--pf-pe, none); }
    #platform .platform-split__cards {
      opacity: var(--pf-in2, 0);
      transform: translateY(calc(36px * (1 - var(--pf-in2, 0))));
    }

    /* 왼쪽은 글(아코디언), 오른쪽은 그래픽. 그래픽이 이 섹션의 주인공이라
       더 넓게 가져간다 — 내용 너비 1600px 에서 글 582px · 그래픽 938px 이다.
       반반(625/625)으로 나눠 보니 그래픽이 글에 밀렸다. */
    #platform .platform-split {
      display: grid;
      grid-template-columns: minmax(0, 0.62fr) minmax(0, 1fr);
      gap: 80px;
      margin-top: 0;
      /* 기본값(stretch)으로 둔다. 왼쪽 단이 그래픽 높이만큼 늘어나야 아코디언을
         바닥에 붙일 수 있다 — start 로 두면 단 높이가 글 높이에 머문다.
         제목 줄은 단의 첫 아이라 늘어나도 윗변 맞춤은 그대로다. */
      align-items: stretch;
    }
    #platform .platform-split__cards {
      display: flex;
      flex-direction: column;
      min-width: 0;
      min-height: 0;
    }
    #platform .platform-graphic-img {
      margin-top: 0;
    }
    /* 무대가 화면 하나라 그래픽이 그 안에 들어가야 한다. 넓은 화면에서는 폭이,
       낮은 화면에서는 높이가 먼저 걸린다 — 둘 중 작은 쪽을 따른다. */
    /* 그림 상자의 아랫변과 그림이 '보이는' 아랫변이 다르다. SVG 아래쪽 7% 는
       바탕과 거의 구분되지 않는 옅은 그림자라, 상자를 그대로 두면 아코디언 마지막
       선이 그만큼 아래로 내려가 보인다 — 그 아래를 잘라 낸다.
       ⚠️ 자르는 선을 88.17% 로 잡았다가 그림이 잘려 보였다. 캔버스에 그려 행마다
          바탕색(#151B23)과의 차이를 재어 보니, 84~92% 구간에는 최대 차이 40~99 짜리
          실제 그림(받침판 아랫부분)이 있고 93% 부터가 최대 17 짜리 그림자다.
          93% 에서 끊어야 보이는 것을 자르지 않는다.
       ⚠️ 음수 % 마진은 '높이' 가 아니라 '폭' 을 기준으로 한다. 이 그림이 정사각
          (1200×1200)이고 width: 100% · height: auto 라 둘이 같아서 성립한다.
          정사각이 아닌 그림으로 바꾸면 이 값을 다시 잡아야 한다.
       ⚠️ align-self: end — 줄 높이를 글 칸이 정할 때(영문은 제목이 두 줄로 감기는
          줄이 있다) 그래픽을 줄 바닥에 붙여야 두 아랫변이 만난다. */
    /* ⚠️ overflow 를 자르지 않는다. 아래 margin-bottom: -7% 가 상자 바닥을 그림
       안쪽으로 끌어올리므로, 자르면 그 7% 가 통째로 잘려 받침판이 사라진다.
       상자는 아랫변을 맞추는 용도고, 그림은 그 아래로 넘쳐 그려져야 온전하다. */
    #platform .platform-graphic-wrap {
      position: relative;
      align-self: end;
      width: 100%;
      /* 보이는 높이가 폭의 93% 라, 무대 안에 들어갈 폭의 상한은 그 역수배다. */
      max-width: calc((100vh - 200px) * 1.075);
      margin-inline: auto;
    }
    #platform .platform-graphic-img {
      display: block;
      width: 100%;
      /* <object> 는 <img> 와 달리 내부 비율로 높이를 잡지 않는다 — 직접 준다.
         이 그림은 viewBox 가 1200×1200 인 정사각이다. */
      aspect-ratio: 1 / 1;
      height: auto;
      margin-bottom: -7%;
    }
    /* 이름표는 SVG 밖 HTML 글자다. 그림 안에 path 로 굳어 있을 때는 그림이 줄어드는
       만큼(1200 → 753, 0.627배) 글자도 줄어 화면에서 8.9px 밖에 안 됐다.
       밖으로 빼면 크기를 따로 줄 수 있고, 배율이 바뀌어도 또렷하다.
       ⚠️ 자리는 그림 상자(정사각) 기준의 % 다 — 그림이 커지고 작아져도 따라간다.
          세로 28.083% 는 알약이 서 있던 자리(viewBox y 337 / 1200)다.
       ⚠️ 알약도 SVG 에서 걷어 냈다. 글자만 키우면 원래 알약 폭을 넘친다. */
    #platform .pf-labels {
      position: absolute;
      left: 0;
      top: 0;
      width: 100%;
      aspect-ratio: 1 / 1;
      pointer-events: none;
      container-type: inline-size;
      /* 그림과 같은 박자로 뜬다. */
      opacity: var(--pf-in, 0);
      transform: translateY(calc(36px * (1 - var(--pf-in, 0))));
      /* 오림도 그림과 같이 받는다. 빠뜨리면 온톨로지 판이 드러나기 전에
         판 위에 눕는 이름표(Ontology · Unify · Refine · Collect · Data ·
         Work flow)만 빈 바탕에 먼저 떠 보인다.
         ⚠️ 이 상자는 그림과 같은 폭의 정사각형이라 같은 비율이 같은 자리를 자른다. */
      clip-path: inset(0 0 var(--pf-clip, 69%) 0);
    }
    #platform .pf-label {
      position: absolute;
      left: var(--x);
      top: 28.083%;
      transform: translate(-50%, -50%);
      white-space: nowrap;
      /* 알약 셋의 글자. 그림 폭을 따라가고 753px 에서 12px 다.
         판 위에 눕는 여섯은 아래 .pf-label--iso 에서 10px 로 따로 준다. */
      font-size: clamp(10px, 1.594cqw, 13px);
      font-weight: 600;
      letter-spacing: -0.1px;
      line-height: 1;
      color: #16202C;
      background: #76A6D7;
      border-radius: 999px;
      /* 알약은 원본 SVG 의 rect 치수를 그대로 쓴다(1200 기준 높이 45, 폭은 낱개로
         150.39 · 148.48 · 176.18 — cqw 로 옮겨 그림 폭을 따라간다).
         ⚠️ 글자에 여백을 붙여 키우는 방식이 아니다. 글자 크기를 바꿔도 알약은
            그대로 있어야 원본과 같은 자리를 차지한다. */
      display: flex;
      align-items: center;
      justify-content: center;
      width: var(--w);
      height: 3.75cqw;
      /* 글자를 1px 내린다. 상자 한가운데에 세우면 'Refinery' 의 y 꼬리가
         아래 여백을 먹어 글자가 올라가 보인다 — 위 여백만큼 밀어 내린다.
         ⚠️ 높이가 border-box 라 padding-top 은 속 상자를 그만큼 줄인다.
            가운데 정렬은 속 상자를 기준으로 하므로 실제로 내려가는 몫은 절반이다.
            12px 글자에서 .167em = 2px 이고, 그 절반인 1px 이 내려간다. */
      padding: .167em 0 0;
      transition: opacity .35s ease, filter .35s ease;
    }
    /* 고르면 그림과 같이 옅어지고, 고른 쪽만 남는다. */
    #platform .pf-labels.rf-sel .pf-label { opacity: .18; }
    #platform .pf-labels.rf-sel .pf-label.rf-on {
      opacity: 1;
      filter: drop-shadow(0 0 11px rgba(118, 166, 215, .45));
    }

    /* 판 위 · 판 가장자리의 이름표. 기울기는 두 가지다 — 원본 글자의 생김새를
       재어 갈랐다.
       ① 가장자리 이름표(Ontology · Unify · Refine · Collect · Data)는 세로획이
          화면에서 '정확히 수직'이다('l' 의 bbox 폭이 1.1 뿐이었다). 눕힌 투영이
          아니라 세로 전단이다 — skewY(-30deg). 밑줄은 −30° 로 눕고 글자는 선다.
       ② 'Work flow' 만 판 바닥에 눕힌 투영이다(글자가 가로로 늘고 높이가 반으로
          줄어 있다). 그쪽은 아래에서 행렬로 따로 준다.
       ⚠️ 선택자에 .pf-labels 를 한 겹 더 둔다. 기본 .pf-label 규칙과 특이도가 같으면
          뒤에 선언된 쪽이 이겨 top 과 transform 이 그대로 덮인다 — 이름표가 위쪽
          알약 줄에 가서 섰다. */
    #platform .pf-labels .pf-label--iso {
      top: var(--y);
      /* 알약 이름표와 같은 600 으로 맞춘다. 전단을 거치며 획이 흐려져 눈에는
         조금 가늘게 읽히지만, 한 벌의 굵기를 하나로 두는 쪽을 택했다.
         흰 글자인 Ontology · Data 만 아래에서 300 으로 따로 내린다. */
      font-weight: 600;
      /* 판 위에 눕는 여섯은 10px — 알약(12px)보다 한 단계 작다. */
      font-size: clamp(8px, 1.33cqw, 11px);
      background: none;
      /* 알약이 아니다 — 위에서 준 고정 치수를 글자 길이에 맡기는 쪽으로 되돌린다. */
      display: block;
      width: auto;
      height: auto;
      padding: 0;
      border-radius: 0;
      transform: translate(-50%, -50%) skewY(-30deg);
    }
    #platform .pf-labels .pf-label--ont {
      color: #F6F8FA;
      /* 흰 글자가 어두운 면 위에 있어 같은 굵기여도 번져 보인다 —
         기울인 다른 이름표(600)보다 세 단계 낮춰야 눈높이가 맞는다.
         ⚠️ 300 은 Roboto 가 들고 있는 가장 가는 굵기다 — 더 내릴 자리가 없다. */
      font-weight: 300;
      letter-spacing: 0.02em;
    }
    /* 판 바닥에 눕는 쪽 — x축은 오른쪽 위(−30°), 아래쪽 y축은 오른쪽 아래(+30°). */
    #platform .pf-labels .pf-label--wf {
      transform: translate(-50%, -50%) matrix(.866, -.5, .866, .5, 0, 0);
      color: #9DBBD9;
      /* 원본도 두 줄이다. 원본의 글자 중심 사이는 12 단위인데, HTML 로 빼면서
         글자가 원본보다 커져 같은 비율로는 두 줄이 벌어져 보였다 — 더 붙인다.
         ⚠️ 중앙 보정값(--x/--y)은 이 값에 매이지 않는다. 행간이 바뀌면 두 줄이
            중심을 사이에 두고 같은 만큼 멀어지므로 글자 덩어리의 중심은 그대로다. */
      line-height: 1.1;
      text-align: center;
      /* ⚠️ --x/--y 는 네모(칩 판) 한가운데가 아니다. 전단이 세로 거리를 가로로도
            옮기기 때문에, 두 줄을 담은 상자의 한가운데를 네모 한가운데에 맞추면
            정작 글자 덩어리는 왼쪽 위로 치우친다(윗줄은 왼쪽 위로, 아랫줄은
            오른쪽 아래로 끌린 결과 두 줄의 글자 폭이 서로 다른 만큼 어긋난다).
            그래서 상자를 네모 중심(600.03, 604.34)에서 오른쪽 아래로 그 어긋남만큼
            밀어 둔다 — 880px 폭 · 글자 11px 기준 가로 1.59 · 세로 1.01 단위다. */
    }

    /* 판 가장자리의 작은 이름표 넷. 같은 아이소메트릭 행렬을 쓴다.
       ⚠️ Unify · Refine · Collect 는 받치던 칩(#151B23)까지 SVG 에서 걷어 냈다.
          글자만 키우면 칩(48×45)을 넘친다 — 칩도 HTML 로 다시 그려 글자 길이를
          따라가게 했다. */
    #platform .pf-labels .pf-label--chip {
      color: #76A6D7;
      /* 칩도 글자와 같이 눕는다 — 받침만 반듯하면 글자가 떠 보인다. */
      background: #151B23;
      padding: 0.45em 0.9em;
      border-radius: 999px;
    }
    #platform .pf-labels .pf-label--data {
      color: #F6F8FA;
      /* 흰 글자가 어두운 면 위에 있어 같은 굵기여도 번져 보인다 —
         기울인 다른 이름표(600)보다 세 단계 낮춰야 눈높이가 맞는다.
         ⚠️ 300 은 Roboto 가 들고 있는 가장 가는 굵기다 — 더 내릴 자리가 없다. */
      font-weight: 300;
      letter-spacing: 0.02em;
    }

    /* 한 장을 두 번에 나눠 보여 준다. 처음에는 위 31% 만 보이고(카드 세 장과
       이름표), 그 뒤 오림이 아래로 자라 온톨로지 판이 드러난다.
       자르는 자리 31% 는 짐작이 아니다 — 캔버스에 그려 행마다 브랜드색 화소를
       세어 보니 이름표 알약이 29.7% 에서 끝난다. 그 한 뼘 아래다.
       ⚠️ 전에는 같은 그림을 두 장 겹쳐 썼다. 한 장이면 파일도 한 번만 받고,
          나중에 요소 단위로 켜는 방식으로 갈아탈 때도 그대로 쓸 수 있다. */
    #platform .pf-art {
      clip-path: inset(0 0 var(--pf-clip, 69%) 0);
      opacity: var(--pf-in, 0);
      transform: translateY(calc(36px * (1 - var(--pf-in, 0))));
      pointer-events: none;
    }

    /* 층을 하나씩 펼쳐 보는 글 목록. 카드로 쌓으면 일곱 장이 그래픽 높이를 넘겨
       따로 넘겨야 했는데, 접어 두면 한 화면에 들어온다. */
    /* 아코디언은 단 바닥에 붙는다 — 아랫변이 그래픽 아랫변과 같은 선에 선다.
       (단 높이는 그래픽이 정한다.) */
    /* 구분선은 두 단이다 — 쉴 때 #22303F, 손이 닿거나 열린 줄은 #3A4856.
       줄 하나하나가 누르는 자리라 그 둘을 나눠 쓴다. 제목 색이 일곱 줄 모두
       같아진 뒤로는 이 선이 열린 줄을 알리는 거의 유일한 표시다 — 두 값의
       차이를 좁히지 말 것. #22303F 는 그래픽 판 옆면과 같은 값이다. */
    /* ⚠️ flex: none — 칸이 flex 라 기본값(shrink: 1)이면 무대 높이에 눌려 줄들이
       겹쳐 찌그러진다. 제목 줄과 같은 이유다. */
    /* 선은 줄과 줄 사이에만 둔다 — 맨 위와 맨 아래는 긋지 않는다. */
    #platform .pf-acc { margin-top: auto; flex: none; }
    #platform .pf-item + .pf-item { border-top: 1px solid #16202C; transition: border-color .2s ease; }
    /* 손이 닿은 줄은 제 위 선과 아래 줄의 위 선을 함께 올린다. */
    #platform .pf-item:hover,
    #platform .pf-item.is-open { border-top-color: #22303F; }
    #platform .pf-item:hover + .pf-item,
    #platform .pf-item.is-open + .pf-item { border-top-color: #22303F; }
    #platform .pf-q {
      width: 100%;
      display: flex;
      align-items: center;
      gap: 14px;
      /* 선과 글, 글과 글 사이를 모두 20px 로 보이게 맞춘 값이다.
         ⚠️ 상자 간격이 아니라 '보이는' 간격을 맞춘다. 글 상자는 행간의 남는 몫을
            위아래로 반씩 품고 있어(제목 2.4px · 본문 3.5px), 상자 간격을 똑같이
            15px 로 두면 눈에는 17.4 · 20.9 · 18.5px 로 들쑥날쑥해진다.
            20 − 2.4 = 17.6 이 제목 위아래에 필요한 상자 간격이다. */
      padding: 17.6px 0;
      background: none;
      border: 0;
      cursor: pointer;
      font-family: inherit;
      text-align: left;
      color: #F6F8FA;
    }
    /* 접혀 있을 때 보이는 건 제목이다. 본문은 펼쳐야 나온다. */
    #platform .pf-t {
      flex: 1 1 auto;
      min-width: 0;
      font-size: 16px;
      font-weight: 500;
      /* 제목 행간은 1.25~1.35 가 기본이다. */
      line-height: 1.3;
      color: #F6F8FA;
      transition: color .2s ease;
      word-break: keep-all;
    }
    /* 열고 닫는 표시는 따로 두지 않는다 — 줄 사이 구분선만 남긴다.
       제목 색은 열린 줄과 닫힌 줄이 같다(#F6F8FA). 어느 줄이 열렸는지는
       아래 본문과 구분선(#3A4856), 그리고 그림에서 켜지는 조각이 알린다. */
    /* 펼친 줄은 제목 아래에 본문이 붙으므로 두 반 행간이 겹친다 —
       20 − 2.4 − 3.5 = 14.1 로 줄여야 그 사이도 20px 로 보인다. */
    #platform .pf-item.is-open .pf-q { padding-bottom: 14.1px; }
