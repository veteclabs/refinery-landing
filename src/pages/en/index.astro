---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/global.css';
// 헤더·푸터는 한국어와 같은 공용 컴포넌트를 쓴다(라벨·IA는 src/i18n/nav.ts에서 로케일별로).
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

// hreflang: 존재하는 로케일만(ko·en). ja 페이지 생성 후 추가.
const alternates = [
  { lang: 'ko', href: '/' },
  { lang: 'en', href: '/en' },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Refinery",
  "url": "https://refinery.kr/",
  "logo": "https://refinery.kr/logo_Refinery_symbol.svg",
  "description": "Refine the complexity of industrial data into clear insight - from collection to AI analysis, prediction, and autonomous control. Build an organization that decides with data.",
  "sameAs": []
};
---
<BaseLayout
  title="Refinery - Refining complexity into pure insight"
  ogTitle="Refinery"
  description="Refine the complexity of industrial data into clear insight - from collection to AI analysis, prediction, and autonomous control. Build an organization that decides with data."
  ogDescription="Refining complexity into pure insight"
  canonical="/en"
  alternates={alternates}
  jsonLd={jsonLd}
>

<Nav />

<!-- HERO -->
<main id="main">
<section id="hero">
  <div class="container">
    <div class="hero-row">
      <div class="hero-text">
        <h1>Refinery <span class="hero-title-accent">Agentic AI</span></h1>
        <p>Connect the data and documents scattered across your operations <br class="mobile-br">into a single body of industrial knowledge.<br>AI understands the field and supports every operational decision - <br class="mobile-br">from predictive maintenance to quality, energy, and autonomous operation.</p>
      </div>
      <div class="hero-actions">
        <a href="/contact" class="hero-demo-link" onclick="if(window.openContactDrawer){openContactDrawer();return false;}">
          Request a demo
          <svg width="20" height="20" viewBox="0 -960 960 960" xmlns="http://www.w3.org/2000/svg" fill="currentColor"><path d="m553.85-253.85-42.16-43.38L664.46-450H180v-60h484.46L511.69-662.77l42.16-43.38L780-480 553.85-253.85Z"/></svg>
        </a>
      </div>
    </div>
    <div class="hero-motion-placeholder">
      {/* 클릭 레이어. iframe의 pointer-events를 열면 사용자가 데모 내부 UI를
          조작하게 되므로, 칸 위에 투명 버튼을 덮고 postMessage로만 제어한다. */}
      <button type="button" id="hero-demo-toggle" class="hero-demo-toggle" aria-label="Play / pause demo" aria-pressed="false">
        <span class="hero-demo-toggle-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor" width="26" height="26"><path d="M8 5v14l11-7z"/></svg>
        </span>
      </button>
      <iframe id="hero-agent-iframe" data-src="/agent-replay-demo-en" loading="lazy" title="Refinery AI agent demo" scrolling="no" tabindex="-1" style="display:block;border:none;position:absolute;top:0;left:0;transform-origin:top left;pointer-events:none;"></iframe>
        </div>

  </div>
  
  <script is:inline>
    (function() {
      // 데모 안의 무대(.stage)는 1320x840 고정이고 K = min(폭/1320, 높이/840)로 줄어든다.
      // 예전엔 iframe이 1440x900이라 높이 쪽이 먼저 걸려(900/840 < 1440/1320) 무대 폭이
      // 1414px에 그쳤고, 남는 13px씩이 데모 페이지 배경(#E9ECEF)으로 보였다.
      // 높이를 비율보다 살짝 크게 잡아 K가 폭에서 정해지게 하면 무대가 폭을 정확히 채운다.
      var STAGE_W = 1320, STAGE_H = 840;
      var HERO_AGENT_W = 1440;
      var HERO_AGENT_H = Math.ceil(HERO_AGENT_W * STAGE_H / STAGE_W) + 2;  // 918
      /* 좌측 세션 레일(.rail)을 잘라 대화 본문만 확대한다. 값은 무대(1320px) 좌표계 기준 —
         예전엔 iframe 좌표(283/1427)로 적었는데, 무대가 폭을 꽉 채우도록 바뀌면서 기준이 옮겨졌다.
         무대 배율 1440/1320이 곱해지므로 무대 좌표로 두는 편이 폭이 바뀌어도 어긋나지 않는다. */
      var STAGE_CROP_LEFT = 252;   /* .rail 끝 = 252 (무대에서 실측) */
      var STAGE_CROP_RIGHT = 1320; /* .main 오른쪽 끝 = 무대 끝 */
      function resizeHeroAgent() {
        var wrapper = document.querySelector('.hero-motion-placeholder');
        if (!wrapper) return;
        var w = wrapper.offsetWidth;
        var h = wrapper.offsetHeight;
        var isMobile = window.innerWidth <= 900;
        // 데스크탑: 폭 기준으로만 스케일링해 좌우/우측이 잘리지 않고 전체 화면이 그대로 보이도록 한다.
        // 모바일: 화면이 좁아 전체를 다 보여주면 글씨가 너무 작아지므로,
        // 좌측 세션 레일과 우측 여백/툴바 아이콘을 잘라내고 대화 본문 위주로 확대해서 보여준다.
        // 무대는 iframe 폭을 정확히 채우므로 무대 좌표 x는 iframe 좌표 x * (HERO_AGENT_W / STAGE_W)다.
        var stageToFrame = HERO_AGENT_W / STAGE_W;
        var cropL = isMobile ? STAGE_CROP_LEFT * stageToFrame : 0;
        var cropR = isMobile ? STAGE_CROP_RIGHT * stageToFrame : HERO_AGENT_W;
        var scale = w / (cropR - cropL);
        var leftOffset = -(cropL * scale);
        var scaledH = HERO_AGENT_H * scale;
        // 세로로 남는 자투리는 가운데를 기준으로 잘라 낸다(칸에 overflow: hidden이 걸려 있다).
        // Math.max(0, ...)이면 자투리가 아래에 배경으로 남는다.
        var topOffset = (h - scaledH) / 2;
        var iframe = document.getElementById('hero-agent-iframe');
        if (iframe) {
          iframe.style.width = HERO_AGENT_W + 'px';
          iframe.style.height = HERO_AGENT_H + 'px';
          iframe.style.transform = 'scale(' + scale + ')';
          iframe.style.top = topOffset + 'px';
          iframe.style.left = leftOffset + 'px';
        }
      }
      /* 클릭으로 재생/일시정지. 상태는 데모가 refinery-hero-state로 돌려준다. */
      function initHeroToggle() {
        var btn = document.getElementById('hero-demo-toggle');
        var frame = document.getElementById('hero-agent-iframe');
        if (!btn || !frame) return;
        btn.addEventListener('click', function () {
          if (!frame.getAttribute('src')) return;   /* 아직 안 불러왔으면 무시 */
          try { frame.contentWindow.postMessage({ type: 'refinery-hero-toggle' }, '*'); } catch (e) {}
        });
        window.addEventListener('message', function (e) {
          if (!e.data || e.data.type !== 'refinery-hero-state') return;
          btn.classList.toggle('is-paused', !!e.data.paused);
          btn.setAttribute('aria-pressed', e.data.paused ? 'true' : 'false');
        });
      }
      window.addEventListener('load', initHeroToggle);

      window.resizeHeroAgent = resizeHeroAgent;
      window.addEventListener('load', resizeHeroAgent);
      window.addEventListener('resize', resizeHeroAgent);
      document.addEventListener('DOMContentLoaded', resizeHeroAgent);

      function loadHeroDemo() {
        var f = document.getElementById('hero-agent-iframe');
        if (f && !f.src && f.getAttribute('data-src')) {
          f.addEventListener('load', resizeHeroAgent);
          f.src = f.getAttribute('data-src');
        }
      }
      if ('requestIdleCallback' in window) {
        window.addEventListener('load', function () { requestIdleCallback(loadHeroDemo, { timeout: 1500 }); });
      } else {
        window.addEventListener('load', function () { setTimeout(loadHeroDemo, 200); });
      }

      /* 히어로 데모가 재생 완료된 뒤 화면 밖으로 나갔다가 다시 들어오면
         재생을 처음부터 다시 시작한다 (멈춰있는 화면처럼 보이지 않도록). */
      function initHeroReplay() {
        var heroSection = document.getElementById('hero');
        var iframe = document.getElementById('hero-agent-iframe');
        if (!heroSection || !iframe || !('IntersectionObserver' in window)) return;
        var hasLeft = false;
        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              if (hasLeft) {
                hasLeft = false;
                try {
                  iframe.contentWindow.postMessage({ type: 'refinery-hero-replay' }, '*');
                } catch (e) { /* 접근 불가 시 무시 */ }
              }
            } else {
              hasLeft = true;
            }
          });
        }, { threshold: 0.5 });
        observer.observe(heroSection);
      }
      window.addEventListener('load', initHeroReplay);
    })();
  </script>
  </section>

<!-- PLATFORM -->
<section id="platform" style="background:#111316;border-top:1px solid #E3E7EC;">
  <style is:global>
    #platform .section-header p {
      color: #959CA5;
    }
    /* 소제목을 <br> 기준 2줄로 유지한다. 공통값 360px에서는 긴 줄(391px)이
       다시 감겨 3줄이 됐다. 400px이면 2줄로 들어가고, 제목 옆 여유(1024px에서
       522px)가 충분해 우측 배치도 그대로다. */
    #platform .section-header-row p {
      max-width: 400px;
    }
    #platform .platform-graphic-img {
      margin-top: 64px;
    }
    #platform .series-nav-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-top: 48px;
    }
    #platform .series-progress {
      width: 120px;
      height: 3px;
      border-radius: 2px;
      background: #272B32;
      overflow: hidden;
    }
    #platform .series-progress-fill {
      height: 100%;
      width: 20%;
      background: var(--accent);
      border-radius: 2px;
      transition: width .35s cubic-bezier(0.22,1,0.36,1);
    }
    #platform .series-nav-btns {
      display: flex;
      gap: 10px;
    }
    #platform .series-nav-btn {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border: 1px solid #272B32;
      background: #111316;
      color: #EDEEF0;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: background 0.2s ease, border-color 0.2s ease, opacity 0.2s ease;
      padding: 0;
    }
    #platform .series-nav-btn:hover {
      background: var(--accent);
      border-color: var(--accent);
    }
    #platform .series-nav-btn:disabled {
      opacity: 0.35;
      cursor: default;
      background: #111316;
      border-color: #272B32;
    }
    /* 쉐브론 화살표는 기하학적으로는 중앙이지만, 뾰족한 끝과 벌어진 두 선의 무게중심이
       달라 눈으로 보면 한쪽으로 치우쳐 보인다 — 시각적으로 가운데처럼 보이도록 미세 보정 */
    #platform .series-prev svg {
      transform: translateX(-1px);
    }
    #platform .series-next svg {
      transform: translateX(1px);
    }
    #platform .series-viewport {
      overflow: hidden;
      margin: 16px 0 0;
      padding: 0 0 4px;
    }
    #platform .series-slider {
      display: flex;
      gap: 16px;
      transition: transform 0.45s cubic-bezier(0.22,1,0.36,1);
      will-change: transform;
    }
    #platform .series-card {
      flex: 0 0 300px;
      background: #111316;
      border: 1px solid #272B32;
      border-radius: var(--radius);
      padding: 24px;
    }
    #platform .series-icon {
      color: var(--accent);
      display: flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      margin-bottom: 80px;
    }
    #platform .series-icon svg {
      width: 26px;
      height: 26px;
    }
    #platform .series-icon i {
      font-size: 26px;
      line-height: 1;
    }
    #platform .series-card h3 {
      font-size: 16px;
      font-weight: 600;
      color: #EDEEF0;
      margin: 0 0 10px;
      line-height: 1.4;
    }
    #platform .series-tagline {
      font-size: 12px;
      font-weight: 600;
      color: var(--accent);
      letter-spacing: 1.2px;
      margin-bottom: 8px;
    }
    #platform .series-card:has(.series-tagline) .series-icon {
      margin-bottom: 52.8px;
    }
    #platform .series-en {
      color: #959CA5;
      font-weight: 400;
      font-size: 0.8em;
      display: block;
      margin-top: 2px;
    }
    #platform .series-quote {
      font-size: 13px;
      font-style: italic;
      color: var(--accent);
      margin: 0 0 10px;
      line-height: 1.55;
    }
    #platform .series-desc {
      font-size: 13px;
      color: #959CA5;
      line-height: 1.65;
      margin: 0;
    }
    @media (max-width: 900px) {
      #platform .platform-graphic-wrap {
        margin: 40px -24px 0;
        padding: 0 24px 6px;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        -ms-overflow-style: none;
      }
      #platform .platform-graphic-wrap::-webkit-scrollbar { display: none; }
      #platform .platform-graphic-img {
        margin-top: 0;
        width: auto;
        min-width: 680px;
        max-width: none;
      }
      #platform .series-viewport {
        margin: 16px 0 0;
        padding: 0 0 4px;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        -ms-overflow-style: none;
      }
      #platform .series-viewport::-webkit-scrollbar { display: none; }
      #platform .series-card {
        flex: 0 0 80vw;
        max-width: 300px;
        padding: 20px;
      }
      #platform .series-icon {
        margin-bottom: 56px;
      }
      #platform .series-card:has(.series-tagline) .series-icon {
        margin-bottom: 40px;
      }
    }
  </style>
  <script is:inline>
    (function() {
      function initSeriesSlider() {
        var viewport = document.querySelector('#platform .series-viewport');
        var slider = document.querySelector('#platform .series-slider');
        var prevBtn = document.querySelector('#platform .series-prev');
        var nextBtn = document.querySelector('#platform .series-next');
        if (!viewport || !slider || !prevBtn || !nextBtn) return;
        var index = 0;
        function cardStep() {
          var card = slider.querySelector('.series-card');
          if (!card) return 316;
          var gap = parseFloat(getComputedStyle(slider).columnGap || 16);
          return card.getBoundingClientRect().width + gap;
        }
        /* 좌우 잘리는 카드(peek)가 동일한 크기로 보이도록, 가운데 3장이 꽉 차고
           남는 여백만큼을 뷰포트 좌우 패딩(peek)으로 분배한다.
           단, 첫 카드는 좌측 끝에 정확히 붙고 마지막 카드는 우측 끝에 정확히 붙도록
           경계(처음/끝)에서는 해당 방향 패딩을 0으로 만든다. */
        function computePeek() {
          var card = slider.querySelector('.series-card');
          if (!card || window.innerWidth <= 900) return 0;
          var gap = parseFloat(getComputedStyle(slider).columnGap || 16);
          var cardWidth = card.getBoundingClientRect().width;
          var vpWidth = viewport.getBoundingClientRect().width;
          var targetCount = 3;
          var peek = (vpWidth - targetCount * cardWidth - (targetCount - 1) * gap) / 2;
          return peek < 16 ? 16 : peek;
        }
        function maxIndex(peek) {
          var step = cardStep();
          var maxScrollBase = Math.max(0, slider.scrollWidth - viewport.clientWidth);
          return Math.ceil((peek + maxScrollBase) / step);
        }
        function isMobile() { return window.innerWidth <= 900; }
        function updateMobileUI() {
          var maxScroll = Math.max(0, viewport.scrollWidth - viewport.clientWidth);
          var scrollLeft = viewport.scrollLeft;
          prevBtn.disabled = scrollLeft <= 2;
          nextBtn.disabled = scrollLeft >= maxScroll - 2;
          var fill = document.querySelector('#platform .series-progress-fill');
          if (fill) {
            var pct = maxScroll > 0 ? ((scrollLeft / maxScroll) * 80 + 20) : 100;
            fill.style.width = pct + '%';
          }
        }
        function update() {
          // 모바일: 네이티브 가로 스크롤(스와이프)로 카드가 움직이므로,
          // JS 트랜스폼 기반 위치 계산을 하지 않고 스크롤 위치 기준으로만 UI(진행바/버튼)를 갱신한다.
          if (isMobile()) {
            slider.style.transform = '';
            viewport.style.paddingLeft = '';
            viewport.style.paddingRight = '';
            updateMobileUI();
            return;
          }
          var peek = computePeek();
          var mi = maxIndex(peek);
          if (index > mi) index = mi;
          if (index < 0) index = 0;
          var padLeft = (index === 0) ? 0 : peek;
          viewport.style.paddingLeft = padLeft + 'px';
          viewport.style.paddingRight = peek + 'px';
          var maxScrollBase = Math.max(0, slider.scrollWidth - viewport.clientWidth);
          var offset = Math.min(index * cardStep(), padLeft + maxScrollBase);
          slider.style.transform = 'translateX(-' + offset + 'px)';
          prevBtn.disabled = index <= 0;
          nextBtn.disabled = index >= mi;
          var fill = document.querySelector('#platform .series-progress-fill');
          if (fill) { var pct = mi > 0 ? ((index / mi) * 80 + 20) : 100; fill.style.width = pct + '%'; }
        }
        prevBtn.addEventListener('click', function() {
          if (isMobile()) { viewport.scrollBy({ left: -cardStep(), behavior: 'smooth' }); return; }
          index -= 1; update();
        });
        nextBtn.addEventListener('click', function() {
          if (isMobile()) { viewport.scrollBy({ left: cardStep(), behavior: 'smooth' }); return; }
          index += 1; update();
        });
        window.addEventListener('resize', update);
        var mobileScrollRaf = null;
        viewport.addEventListener('scroll', function() {
          if (!isMobile()) return;
          if (mobileScrollRaf) return;
          mobileScrollRaf = requestAnimationFrame(function() { mobileScrollRaf = null; updateMobileUI(); });
        }, { passive: true });
        update();
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSeriesSlider);
      } else {
        initSeriesSlider();
      }
    })();
  </script>
  <!-- 솔루션 섹션 — 산업별·과제별 두 판을 옆으로 넘긴다.
       위치는 뷰포트의 가로 스크롤이 갖는다(스크롤 스냅). 버튼은 scrollTo만 부르고,
       현재 판은 스크롤 위치에서 되읽는다 — 스와이프로 넘겨도 탭·버튼이 따라온다. -->
  <script is:inline>
    (function () {
      // 이 스크립트는 섹션 마크업보다 먼저 놓여 있다(플랫폼 슬라이더 바로 뒤).
      // 바로 실행하면 .sol-viewport가 아직 없어 조용히 빠져나간다 — 문서가 다 그려진 뒤에 건다.
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
      function init() {
      var root = document.getElementById('industries');
      if (!root) return;
      var vp = root.querySelector('.sol-viewport');
      var tabs = root.querySelectorAll('[data-sol-tab]');
      var prev = root.querySelector('.sol-prev');
      var next = root.querySelector('.sol-next');
      if (!vp || !tabs.length || !prev || !next) return;
      var last = 0;

      function current() {
        var w = vp.clientWidth || 1;
        return Math.round(vp.scrollLeft / w);
      }
      function paint(i) {
        for (var t = 0; t < tabs.length; t++) {
          tabs[t].setAttribute('aria-selected', t === i ? 'true' : 'false');
        }
        prev.disabled = i <= 0;
        next.disabled = i >= tabs.length - 1;
      }
      function go(i) {
        if (i < 0) i = 0;
        if (i > tabs.length - 1) i = tabs.length - 1;
        vp.scrollTo({ left: i * vp.clientWidth, behavior: 'smooth' });
        paint(i);
      }

      for (var t = 0; t < tabs.length; t++) {
        (function (n) {
          tabs[n].addEventListener('click', function () { go(n); });
        })(t);
      }
      prev.addEventListener('click', function () { go(current() - 1); });
      next.addEventListener('click', function () { go(current() + 1); });

      var tick;
      vp.addEventListener('scroll', function () {
        clearTimeout(tick);
        tick = setTimeout(function () {
          var i = current();
          if (i !== last) { last = i; paint(i); }
        }, 80);
      }, { passive: true });

      // 폭이 바뀌면 스냅 위치가 어긋난다. 보고 있던 판으로 다시 맞춘다.
      window.addEventListener('resize', function () {
        vp.scrollLeft = last * vp.clientWidth;
      });

      paint(0);
      }
    })();
  </script>
  <div class="container">
    <div class="section-header">
      <div class="section-header-row">
