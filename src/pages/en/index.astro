<script is:inline>
  (function() {
    var slides = Array.prototype.slice.call(document.querySelectorAll('.ai-slide'));
    var delays = [0, 600, 1200];

    // 초기 상태: 모두 숨김
    slides.forEach(function(s) {
      s.style.opacity = '0';
      s.style.transform = 'translateY(16px)';
      s.style.transition = 'opacity 0.9s cubic-bezier(0.22,1,0.36,1), transform 0.9s cubic-bezier(0.22,1,0.36,1)';
    });

    function animateLayers() {
      slides.forEach(function(s, i) {
        setTimeout(function() {
          s.style.opacity = '1';
          s.style.transform = 'translateY(0)';
        }, delays[i]);
      });
    }

    function resetLayers() {
      slides.forEach(function(s) {
        s.style.transition = 'none';
        s.style.opacity = '0';
        s.style.transform = 'translateY(16px)';
      });
    }

    var card = document.getElementById('card-intelligence');
    var intAnimated = false;
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting && !intAnimated) {
          intAnimated = true;
          setTimeout(function() {
            slides.forEach(function(s) {
              s.style.transition = 'opacity 0.9s cubic-bezier(0.22,1,0.36,1), transform 0.9s cubic-bezier(0.22,1,0.36,1)';
            });
            animateLayers();
          }, 50);
        } else if (!entry.isIntersecting && intAnimated) {
          intAnimated = false;
          resetLayers();
        }
      });
    }, { threshold: 0.5 });
    if (card) { window.addEventListener('load', function() { observer.observe(card); }); }
  })();
</script>

