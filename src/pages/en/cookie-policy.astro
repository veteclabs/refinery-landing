---
// 쿠키 정책 영어판. 한국어 원문(src/pages/cookie-policy.astro)을 조 · 표 단위로 그대로 옮긴다.
// 용어 · 표기 기준은 docs/legal-en-glossary.md — 거기 없는 용어는 임의로 옮기지 않는다.
// 원문이 바뀌면 이 파일도 함께 고칠 것. 법적 효력은 한국어판에 있다(맨 앞 고지).
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Ph from '../../components/Ph.astro';
import { legal, effectiveDate, legalReviewed, formatDate } from '../../data/legal';
import '../../styles/legal.css';
const { company, retention, revisions } = legal('en');

// 아래 쿠키 · 저장소 목록은 실제 구현(CookieConsent.astro · LanguageSwitcher.astro · Analytics.astro)
// 기준의 사실이다. 추적 도구를 추가 · 제거하면 한국어판과 이 표를 함께 고칠 것.
const isDraft = !legalReviewed || !effectiveDate || !company.ceo;

// 처리방침 영어판(/en/privacy)이 생기기 전까지는 한국어 원문으로 연결한다.
const privacyHref = '/privacy';
---
<BaseLayout
  title="Cookie Policy | Refinery"
  description="The cookies and similar technologies used on the Refinery website — their types, purposes, and retention periods, as well as how to give or withdraw consent."
  canonical="/en/cookie-policy"
  robots="index, follow"
>
  <Nav />
  <main class="legal-main legal-main--wide">
    <h1>Cookie Policy</h1>
    <p class="legal-updated">Effective date: <Ph value={formatDate(effectiveDate, 'en')} label="Month D, YYYY" /></p>

    {/* 한국어판 우선 고지 — 용어집 §0-1. 문구를 바꾸지 않는다. */}
    <p class="legal-lang-notice">
      This English version is provided for reference only. In the event of any discrepancy
      between this translation and the <a href="/cookie-policy" hreflang="ko" lang="ko">Korean original</a>,
      the Korean version shall prevail.
    </p>

    {isDraft && (
      <div class="legal-draft">
        ⚠️ This document is a <strong>draft</strong>. Fill in the yellow <span class="legal-ph">[fields]</span> in{' '}
        <code>src/data/legal.ts</code> and obtain a <strong>legal review</strong> before publishing.
        The cookie list below reflects the current site implementation.
      </div>
    )}

    <div class="legal-body">
      <p>
        <Ph value={company.legalName} label="Company name" /> (the “Company”) uses cookies and similar technologies on the{' '}
        {company.serviceName} website ({company.siteUrl}). This policy describes their types, purposes,
        and retention periods, as well as how to give or refuse consent. For information on how personal information is processed more generally,
        please refer to the <a href={privacyHref}>Privacy Policy</a>.
      </p>

      <section>
        <h2>1. What are cookies and similar technologies?</h2>
        <p>
          A cookie is a small text file that a website stores in a user’s browser to remember past visits or settings.
          In addition to cookies, the Company uses the following similar technologies.
        </p>
        <ul>
          <li><strong>Local storage (localStorage)</strong>: A technology that stores data in the browser. Unlike cookies, it is not automatically sent to the server.</li>
          <li><strong>JavaScript SDK</strong>: A script run by an analytics tool to collect information on page usage.</li>
        </ul>
      </section>

      <section>
        <h2>2. The Company’s principles for using cookies</h2>
        <p>
          Article 30 (1) 7 of the Personal Information Protection Act (“PIPA”) requires matters concerning the installation
          and operation of automatic collection tools for personal information, and the denial thereof, to be{' '}
          <strong>disclosed</strong> in the Privacy Policy. Under Korean law, not all cookies require prior consent.
        </p>
        <p>
          However, to give users more choice, the Company <strong>installs all analytics cookies only
          when users consent</strong>. Users can access all features of
          the website without restriction even if they do not consent.
        </p>
        <p><strong>The Company does not provide personalized advertising and does not allow third-party advertising companies to collect behavioral information on this website.</strong></p>
        <p>That said, the behavioral information (records of on-screen interactions such as clicks and scrolls) that the Company collects through its analytics tool, Mixpanel, is used solely to analyze the usability of the service, and is neither used for advertising purposes nor provided to third parties.</p>
      </section>

      <section>
        <h2>3. Cookies and similar technologies in use</h2>

        <div class="legal-cards legal-cards--single">
          <div class="legal-card">
          <h3>A. Essential (used without consent)</h3>
          <div class="legal-table-wrap">
            <table class="legal-table legal-table--prose4 legal-table--chip">
              <thead><tr><th>Name</th><th>Provider</th><th>Type</th><th>Purpose</th><th>Retention</th></tr></thead>
              <tbody>
                <tr>
                  <td><code>cookie_consent</code></td>
                  <td>{company.domain}<br /><span class="legal-keep">(first party)</span></td>
                  <td>Cookie</td>
                  <td>Stores the user’s choice to accept or reject analytics cookies so that the banner is not shown repeatedly</td>
                  <td>1 year</td>
                </tr>
                <tr>
                  <td><code>lang</code></td>
                  <td>{company.domain}<br /><span class="legal-keep">(first party)</span></td>
                  <td>Cookie</td>
                  <td>Remembers the display language selected by the user (Korean or English)</td>
                  <td>1 year</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="legal-note">
            If essential cookies are blocked, the language selection and cookie consent status are not saved, and the consent banner is shown again on every visit.
          </p>

          </div>
          <div class="legal-card">
          <h3>B. Analytics (used only with consent)</h3>
          <div class="legal-table-wrap">
            <table class="legal-table legal-table--prose4 legal-table--chip">
              <thead><tr><th>Name</th><th>Provider</th><th>Type</th><th>Purpose</th><th>Retention</th></tr></thead>
              <tbody>
                <tr>
                  <td><code>_ga</code><br /><code>_ga_*</code></td>
                  <td>Google LLC <span class="legal-keep">(third party)</span></td>
                  <td>Cookie</td>
                  <td>Used by Google Analytics to distinguish visitors and maintain sessions in order to aggregate the number of visits, traffic sources, and usage by page</td>
                  <td>Up to 2 years<br /><span class="legal-note">(Collected data is kept for <Ph value={retention.ga} label="Retention period" />)</span></td>
                </tr>
                <tr>
                  <td><code>mp_*_mixpanel</code><br /><code>__mp*</code></td>
                  <td>Mixpanel, Inc. <span class="legal-keep">(third party)</span></td>
                  <td>Cookie, <span class="legal-keep">local storage</span></td>
                  <td>Stores random identifiers and event information for usage behavior analysis, session replay, and heatmap recording</td>
                  <td>Until browser storage is cleared<br /><span class="legal-note">(Collected data is kept for <Ph value={retention.mixpanel} label="Retention period" />, and session replays for <Ph value={retention.mixpanelReplay} label="Retention period" />)</span></td>
                </tr>
              </tbody>
            </table>
          </div>

          </div>
          <div class="legal-card">
          <h3>C. Measurement tools that do not use cookies</h3>
          <div class="legal-table-wrap">
            <table class="legal-table legal-table--prose3">
              <thead><tr><th>Tool</th><th>Provider</th><th>Purpose</th><th>Cookie use</th></tr></thead>
              <tbody>
                <tr>
                  <td>Vercel Web Analytics</td>
                  <td>Vercel Inc.</td>
                  <td>Aggregates traffic data such as page views and traffic sources</td>
                  <td>Not used</td>
                </tr>
                <tr>
                  <td>Vercel Speed Insights</td>
                  <td>Vercel Inc.</td>
                  <td>Measures page loading performance (Core Web Vitals)</td>
                  <td>Not used</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="legal-note">
            The two tools above collect only aggregate values without using cookies or storage that identify individual visitors, and are therefore not subject to consent.
            Web3Forms, which is used to process the contact form, is used only when a form is submitted and does not set cookies.
          </p>
          </div>
        </div>
      </section>

      <section>
        <h2>4. About session replay and heatmaps</h2>
        <p>
          If a user consents to analytics cookies, Mixpanel’s session replay feature collects{' '}
          <strong>records of on-screen interactions</strong> such as page navigation, clicks, and scrolls. The purpose is to identify where users encounter difficulties and to improve usability.
        </p>
        <ul>
          <li>The Company has configured session replay to <strong>mask all input values</strong>, so the name, email address, phone number, and inquiry details entered in the contact form are not recorded.</li>
          <li>The Company does not combine session replay records with account identifiers or information about inquirers, and processes them only on the basis of the random identifier stored in the browser.</li>
          <li>Users who do not want their sessions recorded can refuse analytics cookies using the methods in Section 5 below, in which case no recording takes place.</li>
        </ul>
      </section>

      <section>
        <h2>5. How to give and withdraw consent</h2>
        <ol class="legal-ol--hang">
          <li><strong>On their first visit</strong>, users can select <strong>“Accept all”</strong> or <strong>“Reject all”</strong> in the banner at the bottom of the screen.</li>
          <li>The choice is stored in the <code>cookie_consent</code> cookie, and users can change it at any time by clicking <strong>“Cookie Settings” in the page footer</strong> to reopen the banner.</li>
          <li>Deleting cookies and site data in the browser resets the choice, and the banner is shown again.</li>
          <li>If users choose to reject analytics cookies, the Google Analytics and Mixpanel scripts <strong>are not loaded</strong>, so those tools do not collect any information.</li>
        </ol>
      </section>

      <section>
        <h2>6. How to block or delete cookies in the browser</h2>
        {/* 설정 경로는 각 브라우저 영어 UI의 실제 메뉴 이름이다(용어집 §5). 한국어 메뉴를 직역하지 않는다. */}
        <div class="legal-table-wrap">
          <table class="legal-table legal-table--prose2">
            <thead><tr><th>Browser</th><th>Settings path</th></tr></thead>
            <tbody>
              <tr><td>Chrome</td><td>Settings <span class="path-sep">›</span> Privacy and security <span class="path-sep">›</span> Third-party cookies (or “Delete browsing data”)</td></tr>
              <tr><td>Edge</td><td>Settings <span class="path-sep">›</span> Cookies and site permissions <span class="path-sep">›</span> Manage and delete cookies and site data</td></tr>
              <tr><td>Safari (macOS)</td><td>Settings <span class="path-sep">›</span> Privacy <span class="path-sep">›</span> Prevent cross-site tracking; to delete, use “Manage Website Data”</td></tr>
              <tr><td>Safari (iOS)</td><td>Settings app <span class="path-sep">›</span> Safari <span class="path-sep">›</span> Advanced <span class="path-sep">›</span> Website Data</td></tr>
              <tr><td>Firefox</td><td>Settings <span class="path-sep">›</span> Privacy &amp; Security <span class="path-sep">›</span> Cookies and Site Data</td></tr>
              <tr><td>Whale</td><td>Settings <span class="path-sep">›</span> Privacy <span class="path-sep">›</span> Clear browsing data / Cookies and other site data</td></tr>
            </tbody>
          </table>
        </div>
        <p>
          To block only data collection by Google Analytics, users can install the{' '}
          <a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener noreferrer">Google Analytics Opt-out Browser Add-on</a>.
        </p>
        <p class="legal-note">
          Blocking all cookies in the browser settings may prevent some features, such as staying signed in or remembering language settings, from working properly on many websites, including this one.
        </p>
      </section>

      <section>
        <h2>7. Third-party cookies and providers’ policies</h2>
        <p>Analytics tools set cookies, use browser storage, and process information in accordance with their providers’ policies. For details, please refer to the links below.</p>
        <ul>
          <li><strong>Google LLC</strong>: <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">Privacy Policy</a>, <a href="https://policies.google.com/technologies/cookies" target="_blank" rel="noopener noreferrer">How Google uses cookies</a></li>
          <li><strong>Mixpanel, Inc.</strong>: <a href="https://mixpanel.com/legal/privacy-policy/" target="_blank" rel="noopener noreferrer">Privacy Policy</a></li>
          <li><strong>Vercel Inc.</strong>: <a href="https://vercel.com/legal/privacy-policy" target="_blank" rel="noopener noreferrer">Privacy Policy</a></li>
        </ul>
        <p>
          Details of the cross-border transfer of personal information through these tools (recipient, destination country, items transferred,
          purpose of use, retention period, and how to refuse) are disclosed in{' '}
          <a href={privacyHref}>Section 9 of the Privacy Policy</a>.
        </p>
      </section>

      <section>
        <h2>8. Changes to this policy</h2>
        <p>
          This Cookie Policy is effective as of <Ph value={formatDate(effectiveDate, 'en')} label="Month D, YYYY" />.
          If the tools or cookies in use change, the Company will revise this policy and provide notice on the website.
          The revision history is as follows.
        </p>
        <div class="legal-table-wrap">
          <table class="legal-table legal-table--center">
            <thead><tr><th style="width:200px;">Effective date</th><th>Summary of changes</th><th style="width:180px;">Full text</th></tr></thead>
            <tbody>
              {revisions.cookie.map((r) => (<tr><td>{formatDate(r.date, 'en')}</td><td>{r.summary}</td><td>{r.href ? <a href={r.href}>View full text</a> : 'Current'}</td></tr>))}
            </tbody>
          </table>
        </div>
        <p class="legal-note">
          For inquiries about cookies, please contact <Ph value={company.privacyEmail} label="Email" />.
        </p>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>
