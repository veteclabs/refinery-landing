      }
      /* 플랫폼 층 아코디언. 한 번에 하나만 연다. */
      function initPlatformAccordion() {
        var acc = document.querySelector('#platform .pf-acc');
        if (acc) {
          var items = acc.querySelectorAll('.pf-item');
          /* ⚠️ 높이를 px 로 직접 넣는다. max-height 로 어림잡으면 글 길이가 제각각이라
             닫히는 속도가 줄마다 달라지고, auto 는 애초에 전이가 걸리지 않는다. */
          function setOpen(it, open) {
