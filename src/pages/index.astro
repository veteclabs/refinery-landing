             ⚠️ 첫 측정만으로는 모자란다. 글꼴이 늦게 오거나 칸 폭이 레이아웃 뒤에
                정해지면 처음 잰 높이가 한 줄만큼 모자라 본문이 잘린다. */
          function remeasure() {
            for (var k = 0; k < items.length; k++) {
              if (items[k].classList.contains('is-open')) {
                var pn = items[k].querySelector('.pf-a');
                pn.style.height = 'auto';
                pn.style.height = pn.scrollHeight + 'px';
              }
            }
          }
          requestAnimationFrame(remeasure);
          if (document.fonts && document.fonts.ready) document.fonts.ready.then(remeasure);
          window.addEventListener('resize', remeasure, { passive: true });
        }

        var graphicWrap = document.querySelector('#platform .platform-graphic-wrap');
        if (graphicWrap) enableDragScroll(graphicWrap, isNarrow);
      }
      function initAll() { initPlatformAccordion(); initIntegrationsDrag(); }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAll);
      } else {
        initAll();
      }
    })();
  </script>

  <!-- 솔루션 섹션 — 산업별 ⁠· 과제별 두 판을 옆으로 넘긴다.
       위치는 뷰포트의 가로 스크롤이 갖는다(스크롤 스냅). 버튼은 scrollTo만 부르고,
       현재 판은 스크롤 위치에서 되읽는다 — 스와이프로 넘겨도 탭 ⁠· 버튼이 따라온다. -->
  <script is:inline>
    (function () {
      // 이 스크립트는 섹션 마크업보다 먼저 놓여 있다(플랫폼 슬라이더 바로 뒤).
      // 바로 실행하면 .sol-viewport가 아직 없어 조용히 빠져나간다 — 문서가 다 그려진 뒤에 건다.
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
      function init() {
      var root = document.getElementById('industries');
      if (!root) return;
      var vp = root.querySelector('.sol-viewport');
      var tabs = root.querySelectorAll('[data-sol-tab]');
      if (!vp || !tabs.length) return;
      var last = 0;
      var fading = false, token = 0;

      function current() { return last; }
      function paint(i) {
        for (var t = 0; t < tabs.length; t++) {
          tabs[t].setAttribute('aria-selected', t === i ? 'true' : 'false');
        }
      }

      // 판 전환 — 두 판을 겹쳐 두고 서로 페이드로 교차시킨다(크로스페이드).
      // 옆으로 미는 방식은 카드 14장이 화면을 가로질러 지나가 산만했고,
      // 흐렸다가 다시 켜는 방식은 중간에 빈 순간이 생겼다. 교차는 둘 다 없다.
      function go(i) {
        if (i < 0) i = 0;
        if (i > tabs.length - 1) i = tabs.length - 1;
        if (i === last) return;
        var ps = root.querySelectorAll('.sol-panel');
        var out = ps[last], inn = ps[i];
        last = i;
        paint(i);
        if (!out || !inn) return;

        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) {
          out.setAttribute('data-off', '');
          inn.removeAttribute('data-off');
          return;
        }

        var mine = ++token;
        fading = true;
        // visibility에는 전환이 걸리지 않는다. 먼저 보이게만 만들고 투명도는 0에서 시작해
        // 다음 프레임에 올려야 첫 전환도 페이드로 보인다(바로 올리면 그냥 켜진다).
        inn.removeAttribute('data-off');
        inn.style.opacity = '0';
        out.style.opacity = '1';
        requestAnimationFrame(function () {
          if (mine !== token) return;
          inn.style.opacity = '1';
          out.style.opacity = '0';
          setTimeout(function () {
            if (mine !== token) return;
            out.setAttribute('data-off', '');
            out.style.opacity = '';
            inn.style.opacity = '';
            fading = false;
          }, 320);
        });
      }

      for (var t = 0; t < tabs.length; t++) {
        (function (n) {
          tabs[n].addEventListener('click', function () { go(n); });
        })(t);
      }

      // 모바일 스와이프 — 가로 스크롤러를 걷어냈으므로 제스처를 직접 받는다.
      // 손가락을 따라 밀지는 않고, 놓는 순간 같은 크로스페이드로 넘긴다.
      var sx = 0, sy = 0, tracking = false;
      vp.addEventListener('touchstart', function (e) {
        if (e.touches.length !== 1 || fading) { tracking = false; return; }
        tracking = true; sx = e.touches[0].clientX; sy = e.touches[0].clientY;
      }, { passive: true });
      vp.addEventListener('touchend', function (e) {
        if (!tracking) return;
        tracking = false;
        var c = e.changedTouches[0];
        var dx = c.clientX - sx, dy = c.clientY - sy;
        // 세로로 더 많이 움직였으면 페이지 스크롤이지 넘김이 아니다.
        if (Math.abs(dx) < 45 || Math.abs(dx) < Math.abs(dy)) return;
        go(current() + (dx < 0 ? 1 : -1));
      }, { passive: true });

      paint(0);
      }
    })();
  </script>
  {/* 제목은 화면 하나를 통째로 쓰고 그 자리에 붙어 있는다(.section-header 가 sticky).
      .pf-pin 이 남겨 둔 길이만큼 스크롤하는 동안 낱말이 하나씩 바뀐다. */}
  {/* 무대 하나가 화면을 통째로 쓰고 섹션이 끝날 때까지 붙어 있는다.
      제목과 본문이 같은 칸에 겹쳐 있어, 배경이 어두워지는 동안 제목이 빠지고
      그 자리에 그래픽이 들어선다. 들어선 뒤에는 섹션이 끝날 때까지 그대로 멈춘다. */}
  <div class="pf-stage">
  <div class="section-header">
    <h2 class="section-lead-ko" data-swap="패턴으로,맥락으로,지식으로">데이터에서 지능으로</h2>
  </div>
  <div class="pf-body">
  <div class="container">
    <script is:inline>
      /* 대제목의 마지막 낱말을 스크롤에 묶는다. 저절로 돌지 않고, 고정 칸(.pf-pin)이
         화면 높이보다 긴 만큼을 낱말 수로 나눠 한 칸씩 넘긴다.
         ⚠️ 마크업의 한 줄은 그대로 둔다 — 스크립트가 못 돌면 그 줄이 보여야 하고,
            색인·번역도 원문을 읽는다. 여기서 마지막 낱말만 <b> 묶음으로 바꾼다.
         ⚠️ 칸 폭을 가장 긴 낱말에 맞춰 고정한다. 제목이 가운데 정렬이라 폭이
            낱말마다 달라지면 앞의 '데이터에서' 가 좌우로 흔들린다. */
      (function () {
        var h = document.querySelector('#platform .section-lead-ko');
        var sec = document.getElementById('platform');
        if (!h || !sec) return;

        var full = h.textContent;
        var sp = full.lastIndexOf(' ');
        if (sp < 0) return;
        var head = full.slice(0, sp + 1);
        var last = full.slice(sp + 1);
        var extra = (h.getAttribute('data-swap') || '').split(',').filter(Boolean);

        var swap = document.createElement('span');
        swap.className = 'tw-swap';
        var words = extra.concat([last]);
        var bs = [];
        for (var i = 0; i < words.length; i++) {
          var b = document.createElement('b');
          b.textContent = words[i];
          swap.appendChild(b);
          bs.push(b);
        }
        h.textContent = head;
        h.appendChild(swap);
        /* 읽기 보조기기에는 완성된 한 줄만 준다. */
        h.setAttribute('aria-label', full);
        swap.setAttribute('aria-hidden', 'true');

        function lockWidth() {
          swap.style.width = 'auto';
          var w = 0;
          for (var i = 0; i < bs.length; i++) {
            bs[i].style.position = 'static';
            var bw = bs[i].getBoundingClientRect().width;
            bs[i].style.position = '';
            if (bw > w) w = bw;
          }
          swap.style.width = Math.ceil(w) + 'px';
        }
        lockWidth();
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(lockWidth);

        var idx = -1;
        function show(n) {
          if (n === idx) return;
          idx = n;
          for (var i = 0; i < bs.length; i++) {
            bs[i].classList.toggle('is-now', i === n);
            bs[i].classList.toggle('is-past', i < n);
          }
        }
        /* 섹션 진행도 하나로 세 가지를 몬다.
             0 ~ 45%  낱말이 한 칸씩 바뀐다
            46 ~ 60%  배경이 어두워지고 제목이 빠진다
            54 ~ 72%  카드 세 장 · 온톨로지 판 · 왼쪽 글 순으로 떠오른다
            72 ~100%  그대로 멈춘다 — 아코디언을 여는 구간이다
           배경 구간은 짧게 둔다. 길게 끌면 흰 면과 먹색 사이의 회색이 오래 머물러
           화면이 바래 보인다 — 한 번에 넘어가는 편이 낫다. */
        var W_END = 0.45, D_START = 0.46, D_END = 0.60;
        /* 본문은 배경이 거의 다 어두워진 뒤에야 뜨기 시작한다.
           배경과 같은 구간에 묶으면, 아직 흰 면일 때 본문이 옅게 비쳐 보인다 —
           그래픽과 아코디언이 유령처럼 밑에 깔린 모습이 된다. */
        /* 셋의 구간 길이를 0.09 로 똑같이 두고 0.04 씩 어긋나게 출발시킨다 —
           뜨는 속도는 같고 순서만 생긴다. */
        var V_START = 0.545, V_END = 0.635;
        /* 아래 판은 카드 세 장보다 조금 늦는다. */
        var V3_START = 0.585, V3_END = 0.675;
        /* 왼쪽 글은 그래픽이 다 뜬 뒤에 따라온다 — 순서만 읽히면 되니 간격은 짧다. */
        var V2_START = 0.625, V2_END = 0.715;
        function ease(t) { return t * t * (3 - 2 * t); }
        /* 무대를 붙이지 않는 폭(900 이하)에서는 섹션 높이가 320vh 가 아니라
           내용만큼이다 — 그 거리로 진행도를 잡으면 모션이 순식간에 끝난다.
           대신 제목이 화면을 올라오는 만큼을 쓴다(보안 섹션과 같은 방식). */
        function stagePinned() {
          var st = sec.querySelector('.pf-stage');
          return !!st && getComputedStyle(st).position === 'sticky';
        }
        function progress() {
          if (stagePinned()) {
            var span = sec.offsetHeight - (window.innerHeight || 800);
            if (span <= 0) return 1;
            return clamp01(-sec.getBoundingClientRect().top / span);
          }
          /* 제목이 아래에서 올라와 화면 위로 0.35 화면만큼 지나갈 때까지를 쓴다 —
             1.4 화면(860 높이에서 1204px)이다. 0.8 화면으로 잡았더니 낱말 교대 ·
             배경 어두워짐 · 그래픽 · 본문 넷이 600px 안에 몰려 순식간에 끝났다. */
          var vh = window.innerHeight || 800;
          var from = vh * 1.05, to = vh * -0.35;
          if (from <= to) return 1;
          return clamp01((from - h.getBoundingClientRect().top) / (from - to));
        }
        function clamp01(v) { return v < 0 ? 0 : v > 1 ? 1 : v; }
        function upd() {
          if (!stagePinned() && (sec.offsetHeight - (window.innerHeight || 800)) <= 0) { show(bs.length - 1); }
          var p = progress();

          var w = p / W_END;
          if (w > 1) w = 1;
          var n = Math.floor(w * bs.length);
          if (n > bs.length - 1) n = bs.length - 1;
          show(n);

          var d = (p - D_START) / (D_END - D_START);
          if (d < 0) d = 0; else if (d > 1) d = 1;
          d = ease(d);
          /* 타원의 반지름을 키우면 먹색 구간이 위로 번져 화면 전체가 어두워진다.
             ⚠️ 중심을 위로 끌어올리는 방법은 안 된다. 방사형은 중심에서의 '거리' 로
                색을 고르므로, 중심이 무대 밖으로 나가면 그 아래가 도로 밝아진다.
             ⚠️ 가로 · 세로를 같은 배수로 키운다. 세로만 늘리면 타원이 길쭉해져
                좌우 모서리가 중심에서 멀어지며 또 밝아진다. */
          var k = 1 + 2.2 * d;
          sec.style.setProperty('--pf-ry', (150 * k).toFixed(1) + 'vh');
          sec.style.setProperty('--pf-rx', (180 * k).toFixed(0) + '%');
          sec.style.setProperty('--pf-title', (1 - d).toFixed(3));

          var v = (p - V_START) / (V_END - V_START);
          if (v < 0) v = 0; else if (v > 1) v = 1;
          v = ease(v);
          sec.style.setProperty('--pf-in', v.toFixed(3));

          var v3 = (p - V3_START) / (V3_END - V3_START);
          if (v3 < 0) v3 = 0; else if (v3 > 1) v3 = 1;
          /* 오림을 69% 에서 0% 로 줄이면 아래쪽이 드러난다. */
          sec.style.setProperty('--pf-clip', (69 * (1 - ease(v3))).toFixed(2) + '%');
          /* 무대가 가까워지면 그림을 받기 시작한다 — <object> 에는 lazy 가 없다. */
          /* ⚠️ 그림은 이 스크립트보다 뒤에 있다 — 미리 잡아 두면 늘 null 이다.
             필요해지는 시점에 그때 찾는다. */
          if (p > 0.2) {
            var art = sec.querySelector('.pf-art');
            if (art && !art.getAttribute('data')) art.setAttribute('data', art.getAttribute('data-src'));
          }

          var v2 = (p - V2_START) / (V2_END - V2_START);
          if (v2 < 0) v2 = 0; else if (v2 > 1) v2 = 1;
          v2 = ease(v2);
          sec.style.setProperty('--pf-in2', v2.toFixed(3));
          /* 다 뜨기 전에는 클릭을 받지 않는다 — 안 보이는 아코디언이 눌린다. */
          sec.style.setProperty('--pf-pe', v2 > 0.9 ? 'auto' : 'none');
        }
        var ticking = false;
        function onScroll() {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(function () { ticking = false; upd(); });
        }
        addEventListener('scroll', onScroll, { passive: true });
        addEventListener('resize', function () { lockWidth(); upd(); }, { passive: true });
        upd();
      })();
    </script>

