<aside id="contactDrawerPanel" aria-hidden="true" inert>
  <button type="button" class="cd-close" onclick="closeContactDrawer()" aria-label="닫기"><i class="ph ph-x"></i></button>
  <div class="cd-inner">
    <h2 class="cd-title" id="cdTitle"><span class="cd-title-desktop-only">간단한 정보만 <br class="mobile-br">입력하시면<br></span>맞춤 데모를 <br class="mobile-br">안내해드립니다.</h2>
    

    <form id="contactDrawerForm" class="mp-no-track">
      <input type="hidden" name="access_key" value="c719bd17-006a-44c6-8982-7d281c1f03a7">
      <input type="hidden" name="subject" value="Refinery 데모 신청">
      <input type="hidden" name="from_name" value="Refinery 데모 신청하기">
      <div class="cd-step" id="cdStep1">
        <div class="cd-form-row">
          <div class="cd-form-group">
            <label>회사명<span class="req">*</span></label>
            <input type="text" name="company" required>
          </div>
          <div class="cd-form-group">
            <label>성함<span class="req">*</span></label>
            <input type="text" name="name" required>
          </div>
        </div>
        <div class="cd-form-row">
          <div class="cd-form-group">
            <label>이메일<span class="req">*</span></label>
            <input type="email" name="email" required>
          </div>
          <div class="cd-form-group">
            <label>연락처<span class="req">*</span></label>
            <input type="tel" name="phone" required>
          </div>
        </div>
        <div class="cd-step-actions">
          <div class="cd-step-buttons">
            <button type="button" class="cd-submit" id="cdNextBtn" disabled>다음</button>
          </div>
          <div class="cd-progress-track"><div class="cd-progress-fill" style="width:50%;"></div></div>
        </div>
      </div>
      <div class="cd-step" id="cdStep2" style="display:none;">
        <div class="cd-form-row">
          <div class="cd-form-group">
            <label>직책</label>
            <input type="text" name="position">
          </div>
          <div class="cd-form-group">
            <label>산업 분야</label>
            <div class="cd-select-wrap">
              <select name="industry">
                <option value="">선택해주세요</option>
                <option>에너지 ⁠· 유틸리티</option>
                <option>정유 ⁠· 가스</option>
                <option>데이터센터</option>
                <option>철강</option>
                <option>화학 ⁠· 정밀화학</option>
                <option>물류</option>
                <option>환경</option>
                <option>기타</option>
              </select>
            </div>
          </div>
        </div>
        <div class="cd-form-group">
          <label>문의 내용</label>
          <textarea id="cdInquiryTextarea" name="message" placeholder="궁금하신 점이나 현재 겪고 계신 현장의 
어려움을 자유롭게 남겨주세요."></textarea>
        </div>
        <script is:inline>
          (function() {
            var ta = document.getElementById('cdInquiryTextarea');
            if (!ta) return;
            var mobileText = '궁금하신 점이나 현재 겪고 계신 현장의 ' + String.fromCharCode(10) + '어려움을 자유롭게 남겨주세요.';
            var desktopText = '궁금하신 점이나 현재 겪고 계신 현장의 어려움을 자유롭게 남겨주세요.';
            function updatePlaceholder() {
              ta.placeholder = window.innerWidth <= 900 ? mobileText : desktopText;
            }
            updatePlaceholder();
            window.addEventListener('resize', updatePlaceholder);
          })();
        </script>
        <div class="cd-step-actions">
          <div class="cd-step-buttons">
            <button type="button" class="cd-back" id="cdBackBtn">이전</button>
            <button type="submit" class="cd-submit" id="contactDrawerSubmitBtn">문의 보내기</button>
          </div>
          <div class="cd-progress-track"><div class="cd-progress-fill" style="width:100%;"></div></div>
        </div>
      </div>
    </form>
    <div class="cd-success" id="contactDrawerSuccess">
      <i class="ph ph-check-circle"></i>
      <h3>문의가 접수되었습니다</h3>
      <p>담당자가 확인 후 1~2 영업일 내 연락드리겠습니다.</p>
    </div>
  </div>
</aside>

<script is:inline>
  (function() {
    var overlay = document.getElementById('contactDrawerOverlay');
    var panel   = document.getElementById('contactDrawerPanel');
    var form    = document.getElementById('contactDrawerForm');
    var successEl = document.getElementById('contactDrawerSuccess');
    var step1 = document.getElementById('cdStep1');
    var step2 = document.getElementById('cdStep2');
    var progressFillEls = Array.prototype.slice.call(document.querySelectorAll('.cd-progress-fill'));
    var titleEl = document.getElementById('cdTitle');
    var STEP1_TITLE = '<span class="cd-title-desktop-only">간단한 정보만 <br class="mobile-br">입력하시면<br></span>맞춤 데모를 <br class="mobile-br">안내해드립니다.';
    var STEP2_TITLE = '귀사의 현장에 맞는 답을<br>Refinery팀이<br class="mobile-br"> 함께 찾아드립니다.';
    var nextBtn = document.getElementById('cdNextBtn');
    var backBtn = document.getElementById('cdBackBtn');
    var submitBtn = document.getElementById('contactDrawerSubmitBtn');
    var step1Inputs = step1 ? Array.prototype.slice.call(step1.querySelectorAll('input[required]')) : [];

    window.openContactDrawer = function() {
      if (typeof mixpanel !== 'undefined') mixpanel.track('Contact Drawer Open');
      var scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
      var navEl = document.querySelector('nav');
      if (scrollbarWidth > 0) {
        document.body.style.paddingRight = scrollbarWidth + 'px';
        if (navEl) navEl.style.right = scrollbarWidth + 'px';
      }
      overlay.classList.add('open');
      panel.classList.add('open');
      panel.setAttribute('aria-hidden', 'false');
      panel.removeAttribute('inert');
      document.body.style.overflow = 'hidden';
    };
    window.closeContactDrawer = function() {
      overlay.classList.remove('open');
      panel.classList.remove('open');
      panel.setAttribute('aria-hidden', 'true');
      panel.setAttribute('inert', '');
      document.body.style.overflow = '';
      document.body.style.paddingRight = '';
      var navEl = document.querySelector('nav');
      if (navEl) navEl.style.right = '';
    };
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && panel.classList.contains('open')) closeContactDrawer();
    });

    function step1Valid() {
      return step1Inputs.every(function(el) { return el.checkValidity(); });
    }
    function updateNextState() {
      if (nextBtn) nextBtn.disabled = !step1Valid();
    }
    function goToStep2() {
      if (!step1Valid()) { step1Inputs.forEach(function(el) { el.reportValidity && el.checkValidity(); }); return; }
      if (typeof mixpanel !== 'undefined') mixpanel.track('Contact Drawer Step2');
      step1.style.display = 'none';
      step2.style.display = '';
      progressFillEls.forEach(function(el) { el.style.width = '100%'; });
      if (titleEl) titleEl.innerHTML = STEP2_TITLE;
    }
    function goToStep1() {
      step2.style.display = 'none';
      step1.style.display = '';
      progressFillEls.forEach(function(el) { el.style.width = '50%'; });
      if (titleEl) titleEl.innerHTML = STEP1_TITLE;
    }

    if (form) {
      updateNextState();
      step1Inputs.forEach(function(el) {
        el.addEventListener('input', updateNextState);
        el.addEventListener('change', updateNextState);
      });
      if (nextBtn) nextBtn.addEventListener('click', goToStep2);
      if (backBtn) backBtn.addEventListener('click', goToStep1);

      form.addEventListener('submit', function(e) {
        e.preventDefault();
        if (!step1Valid()) { goToStep1(); return; }
        submitBtn.disabled = true;
        var formData = new FormData(form);
        fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Accept': 'application/json' },
          body: formData
        }).then(function(res) { return res.json(); }).then(function(data) {
          if (typeof mixpanel !== 'undefined') mixpanel.track('Contact Form Submitted', { source: 'drawer' });
          form.style.display = 'none';
          successEl.classList.add('show');
        }).catch(function() {
          submitBtn.disabled = false;
          alert('전송 중 문제가 발생했습니다. 잠시 후 다시 시도해주세요.');
        });
      });
    }
  })();
</script>
<script is:inline>
  (function() {
    function enhanceSelect(wrap) {
      var select = wrap.querySelector('select');
      if (!select || wrap.dataset.enhanced) return;
      wrap.dataset.enhanced = '1';

      var trigger = document.createElement('button');
      trigger.type = 'button';
      trigger.className = 'cd-select-trigger';
      trigger.setAttribute('aria-haspopup', 'listbox');
      trigger.setAttribute('aria-expanded', 'false');
      var labelSpan = document.createElement('span');
      labelSpan.className = 'cd-select-trigger-label';
      var chevron = document.createElement('i');
      chevron.className = 'ph-bold ph-caret-down cd-select-chevron';
      trigger.appendChild(labelSpan);
      trigger.appendChild(chevron);

      var list = document.createElement('ul');
      list.className = 'cd-select-options';
      list.setAttribute('role', 'listbox');

      function updateTriggerLabel() {
        var opt = select.options[select.selectedIndex];
        labelSpan.textContent = opt ? opt.textContent : '';
        trigger.classList.toggle('is-placeholder', !select.value);
      }
      function openList() {
        list.classList.add('is-open');
        trigger.classList.add('is-open');
        trigger.setAttribute('aria-expanded', 'true');
      }
      function closeList() {
        list.classList.remove('is-open');
        trigger.classList.remove('is-open');
        trigger.setAttribute('aria-expanded', 'false');
      }

      Array.prototype.slice.call(select.options).forEach(function(opt) {
        var li = document.createElement('li');
        li.setAttribute('role', 'option');
        li.dataset.value = opt.value;
        li.textContent = opt.textContent;
        if (opt.selected) li.classList.add('is-active');
        li.addEventListener('click', function() {
          select.value = opt.value;
          updateTriggerLabel();
          Array.prototype.slice.call(list.querySelectorAll('li')).forEach(function(el) { el.classList.remove('is-active'); });
          li.classList.add('is-active');
          closeList();
          select.dispatchEvent(new Event('change', { bubbles: true }));
        });
        list.appendChild(li);
      });

      trigger.addEventListener('click', function(e) {
        e.stopPropagation();
        if (list.classList.contains('is-open')) closeList(); else openList();
      });
      document.addEventListener('click', function(e) {
        if (!wrap.contains(e.target)) closeList();
      });

      updateTriggerLabel();
      wrap.appendChild(trigger);
      wrap.appendChild(list);
    }

    Array.prototype.slice.call(document.querySelectorAll('.cd-select-wrap')).forEach(enhanceSelect);
  })();
</script>

<script is:inline>
(function(){
  if (typeof gtag !== 'function') return;
  if (!('IntersectionObserver' in window)) return;
  document.addEventListener('DOMContentLoaded', function(){
    var sections = document.querySelectorAll('section[id]');
    var startTimes = {};
    var viewed = {};
    function sendView(id){
      if (viewed[id]) return;
      viewed[id] = true;
      gtag('event', 'section_view', { section_name: id });
    }
    function sendTime(id, ms){
      var sec = Math.round(ms / 1000);
      if (sec < 1) return;
      gtag('event', 'section_time', { section_name: id, engagement_seconds: sec });
    }
    var observer = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        var id = entry.target.id;
        if (entry.isIntersecting) {
          startTimes[id] = performance.now();
          sendView(id);
        } else if (startTimes[id]) {
          sendTime(id, performance.now() - startTimes[id]);
          delete startTimes[id];
        }
      });
    }, { threshold: 0.5 });
    sections.forEach(function(sec){ observer.observe(sec); });
    window.addEventListener('beforeunload', function(){
      Object.keys(startTimes).forEach(function(id){
        sendTime(id, performance.now() - startTimes[id]);
      });
    });
  });
})();
</script>

</BaseLayout>
