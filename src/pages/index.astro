---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
import '../styles/vetec-hero.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { legal } from '../data/legal';
import { heroCards } from '../data/heroMarkers';
import HeroPinArt from '../components/HeroPinArt.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import HeroZoom from '../components/HeroZoom.astro';

// hreflang: 존재하는 로케일만(ko·en). ja 페이지 생성 후 추가.
const alternates = [
  { lang: 'ko', href: '/' },
  { lang: 'en', href: '/en' },
];

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Refinery",
  "alternateName": ["리파이너리", "Refinery 리파이너리"],
  "url": "https://refinery.kr/",
  "logo": "https://refinery.kr/logo_Refinery_symbol.svg",
  "description": "Refinery는 산업 AI 운영체제입니다. 현장의 설비·시스템·문서를 온톨로지 하나로 엮어, 사람과 AI가 같은 근거로 판단하고 조치하게 합니다.",
  "sameAs": []
};

// FAQ 섹션과 동일한 Q&A → FAQPage 구조화 데이터(구글 리치 결과). 본문 FAQ와 함께 유지.
const faqItems = [
  { q: "도입까지 얼마나 걸리나요?", a: "PoC부터 전사 확장까지 현장 규모와 기존 시스템 복잡도에 따라 달라집니다. 정확한 일정은 상담을 통해 안내드립니다." },
  { q: "보안은 어떻게 보장되나요?", a: "전송 구간은 TLS 1.3, 저장 데이터는 AES-256으로 암호화하고, 조직별 데이터 격리(PostgreSQL RLS)와 RBAC ⁠· 감사 로그를 적용합니다. 온프레미스 배포 옵션도 제공하며, 이 경우 데이터가 사내를 벗어나지 않습니다." },
  { q: "현장 데이터를 AI 학습에 사용하나요?", a: "아니오. 고객 데이터는 AI 모델 학습에 사용되지 않습니다. 각 고객의 데이터는 완전히 격리되어 관리됩니다." },
  { q: "기존 SCADA/MES/ERP는 어떻게 되나요?", a: "기존 시스템이 있으면 걷어내지 않고 그 위에 통합 지능 레이어로 얹혀 양방향 연동합니다. 시스템이 없는 현장은 30년 경험으로 만든 템플릿(예: 에너지경영시스템)에서 새로 구축합니다. 두 방식 모두 지원합니다." },
  { q: "어떤 언어를 지원하나요?", a: "인터페이스와 AI 에이전트의 답변은 현재 한국어로 제공됩니다. 영어 지원은 추후 확대할 예정입니다." },
  { q: "클라우드와 온프레미스 중 선택할 수 있나요?", a: "클라우드, 온프레미스, 하이브리드 모두 지원합니다. 보안 정책에 따라 유연하게 선택 가능합니다." },
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Refinery",
  "alternateName": ["리파이너리", "Refinery 산업 AI 운영체제"],
  "url": "https://refinery.kr/",
  "inLanguage": "ko",
  "description": "Refinery는 산업 AI 운영체제입니다. 현장의 설비·시스템·문서를 온톨로지 하나로 엮어, 사람과 AI가 같은 근거로 판단하고 조치하게 합니다.",
  "publisher": { "@type": "Organization", "name": legal('ko').company.legalName },
};

const jsonLd = [orgSchema, websiteSchema, faqSchema];
---
<BaseLayout
  title="Refinery 산업 AI 운영체제 | 제조 ⁠· 에너지 현장을 근거 있는 판단으로"
  ogTitle="Refinery"
  description="산업 AI 운영체제 Refinery(리파이너리). 흩어진 제조 ⁠· 에너지 현장 데이터(SCADA ⁠· MES ⁠· ERP ⁠· 센서)를 온톨로지로 엮어, AI 에이전트가 근거를 들어 판단을 돕습니다. 예지보전 ⁠· 전력관리 ⁠· 품질 예측까지."
  ogDescription="현장의 설비 ⁠· 시스템 ⁠· 문서를 온톨로지 하나로 엮어, 사람과 AI가 같은 근거로 판단하고 조치하게 하는 산업 AI 운영체제"
  canonical="/"
  alternates={alternates}
  jsonLd={jsonLd}
>

<Nav />

<!-- HERO -->
<main id="main">
<section id="hero">
  <HeroZoom />
  <div class="hero-stage">
    <div class="container">
      <h1><span class="hero-title-lead">흩어진 현장을</span><br><span class="hero-title-accent">하나의 운영체제</span>로</h1>
      <p class="hero-sub"><span class="hero-eyebrow" translate="no">Refinery Industrial AI OS</span>현장 곳곳에 흩어진 데이터와 문서를 하나의 산업 지식으로 연결합니다.<br>AI는 현장을 이해하고 예지보전부터 품질, 에너지, 자율 운전까지 모든 운영 의사결정을 지원합니다.</p>
      {/* 핀을 누르면 그 마커의 글이 여기 선다 — 소제목 바로 아래, 같은 왼쪽 끝이다.
          머리 칸의 둘째 줄 · 오른쪽 칸을 쓰므로 자리가 소제목을 그대로 따라간다.
          ⚠️ 칸 높이는 0 이고 카드는 그 안에 절대 배치한다. 그냥 두면 카드가 뜰 때
             머리 칸이 커져 그래픽이 아래로 밀린다.
          ⚠️ 안은 비워 둔다. 아래 스크립트가 <template data-hero-card> 에서 꺼내 채운다. */}
      <div class="hero-pin-layer">
        <div class="hero-pin-card" id="heroPinCard" role="region" aria-live="polite" hidden>
          <div class="hero-pin-card__art" aria-hidden="true"></div>
          <div class="hero-pin-card__body">
            <h3 class="hero-pin-card__title"></h3>
            <p class="hero-pin-card__desc"></p>
          </div>
        </div>
      </div>
    </div>
    <div class="hero-motion-placeholder">
      {/* VETEC 히어로 그래픽. 쓰는 법·옵션은 public/hero/README.md 가 쥔다 —
          마커 문구·좌표는 public/hero/vetec-hero.js 맨 위 MARKERS 다.
          .vh 는 기본으로 화면 높이를 차지하므로, 칸에 맞게 --vh-height 를 넘겨 쓴다
          (src/styles/global.css). 스크립트가 안 돌면 static 이 대신 보인다. */}
      <section class="vh no-js" data-vetec-hero data-assets="/hero/assets-flat/"
        data-tilt-x="4.8" data-tilt-y="3.2" data-zoom="1" aria-label="베텍 산업현장 디지털 트윈">
        <img class="vh-static" src="/hero/assets-flat/static.webp" alt="공기압축기, 에어 리시버 탱크, 펌프·모터 스키드가 산악 지형 위 현장에 놓인 디지털 트윈 그래픽">
      </section>
    </div>
  </div>
  
  <HeroPinArt />
  <script is:inline src="/hero/vetec-hero.js" defer></script>
  <script is:inline>
    /* 히어로 핀 — 누르면 무대 왼쪽 아래 카드에 그 마커의 글이 선다.
       ⚠️ 호버로는 열리지 않는다. 그래픽(public/hero/vetec-hero.js)에서 호버 · 포커스 ·
          탭으로 카드를 열던 손잡이를 뺐고, 핀마다 나던 카드(.vh-card)는 CSS 로 숨겼다.
       ⚠️ 핀은 그래픽이 나중에 만든다 — 지금 찾아 두면 늘 null 이다. document 에 한 번만
          듣고(이벤트 위임) 누른 자리에서 마커를 거슬러 올라간다.
       ⚠️ 열린 핀 표시는 그래픽의 is-pinned 를 그대로 쓴다(면이 차고 + 가 × 로 돈다).
          그 클래스를 건드리는 쪽은 이제 여기뿐이다. */
    (function () {
      var hero = document.getElementById('hero');
      var card = document.getElementById('heroPinCard');
      if (!hero || !card) return;
      var art = card.querySelector('.hero-pin-card__art');
      var tt = card.querySelector('.hero-pin-card__title');
      var ds = card.querySelector('.hero-pin-card__desc');
      var open = null;

      /* 핀을 처음 누르면 그래픽이 한 벌 바뀐다 — 도면 같은 판(assets-flat)에서
         빛을 계산한 판(assets)으로 간다. '들여다보니 현장이 켜진다' 는 뜻이다.
         ⚠️ 무거운 판은 미리 받아 둔다. 핀은 그래픽이 다 자란 뒤(#hero.is-grown)에만
            눌리므로, 그 클래스가 붙는 순간이 받아 둘 자리다 — 누를 때 받으면
            2.3MB 를 기다리는 동안 아무 일도 안 일어난다.
         ⚠️ 받아 둔 뒤 src 만 갈아 끼운다. 캐시에 있으므로 한 프레임에 바뀐다.
            층마다 제 등장 애니메이션(.vh-fade · .vh-glow · .vh-flow)이 걸려 있어
            겹쳐 띄우면 그 애니메이션이 서로 부딪힌다.
         ⚠️ 한 번 바뀌면 그대로 둔다. 핀을 닫아도 되돌리지 않는다. */
      var LIT = '/hero/assets/', FLAT = '/hero/assets-flat/';
      var litReady = false, lit = false;
      function preloadLit() {
        if (litReady) return;
        litReady = true;
        var names = ['near'];
        for (var i = 0; i < names.length; i++) { var im = new Image(); im.src = LIT + names[i] + '.webp'; }
      }
      /* 바뀌는 것은 가운데 설비 층(near.webp) 한 장뿐이다 — 산 · 능선 · 전경 지형과
         땅에 그려진 윤곽선 · 빛줄기(near-contour · near-glow)는 도면 판 그대로다.
         ⚠️ 밑장을 지우지 않고 그 위에 한 겹 얹는다. 두 겹이 겹쳐 있으므로 얹히는
            쪽의 투명도만 움직이면 건너감이 되고, 되돌릴 때도 걷어 내기만 하면 된다. */
      function litLayer() { return hero.querySelector('.vh-lit-near'); }
      function baseNear() {
        var imgs = hero.querySelectorAll('.vh-layer');
        for (var i = 0; i < imgs.length; i++) {
          var s = imgs[i].getAttribute('src') || '';
          if (s.indexOf(FLAT) === 0 && /\/near\.webp$/.test(s) && !imgs[i].classList.contains('vh-lit-near')) return imgs[i];
        }
        return null;
      }
      var dimT = 0;
      function light(id) {
        /* 어느 핀을 눌러도 바뀌는 자리는 하나다 — 가운데 설비 띠.
           핀마다 제 지형을 바꾸게 해 봤더니 한 화면에서 바뀌는 자리가 셋이라
           어디를 보라는 건지 흐려졌다. */
        if (lit) return;
        clearTimeout(dimT);
        var old = litLayer();
        if (old && old.parentNode) old.parentNode.removeChild(old);
        var base = baseNear();
        if (!base) return;
        lit = true;
        var over = base.cloneNode(false);
        over.setAttribute('src', LIT + 'near.webp');
        over.setAttribute('aria-hidden', 'true');
        over.setAttribute('alt', '');
        over.classList.add('vh-lit-near');
        base.parentNode.insertBefore(over, base.nextSibling);
      }
      function dim() {
        if (!lit) return;
        lit = false;
        var over = litLayer();
        if (!over) return;
        over.classList.add('is-out');
        clearTimeout(dimT);
        dimT = setTimeout(function () {
          var o = litLayer();
          if (o && o.parentNode) o.parentNode.removeChild(o);
        }, 460);
      }

      /* is-grown 은 HeroZoom 이 진행도를 보고 붙인다 — 그때 미리 받아 둔다.
         ⚠️ 떨어질 때도 본다. 스크롤을 되올려 그래픽이 다시 작아지면 핀이 사라지는데,
            카드만 남으면 무엇에 붙은 글인지 알 수 없다 — 같이 닫는다.
         ⚠️ hide() 가 #hero 의 class 를 또 건드리지만(pin-open) 그때는 open 이 이미
            비어 있어 되돌이로 돌지 않는다. */
      if (window.MutationObserver) {
        var mo = new MutationObserver(function () {
          if (hero.classList.contains('is-grown')) preloadLit();
          else if (open) hide();
        });
        mo.observe(hero, { attributes: true, attributeFilter: ['class'] });
        if (hero.classList.contains('is-grown')) preloadLit();
      } else { preloadLit(); }

      function mark(id) {
        var ms = hero.querySelectorAll('.vh-marker');
        for (var i = 0; i < ms.length; i++) {
          ms[i].classList.toggle('is-pinned', ms[i].getAttribute('data-id') === id);
        }
        /* 하나를 고르면 나머지 핀은 물러선다(CSS 의 #hero.pin-open). */
        hero.classList.toggle('pin-open', !!id);
      }
      /* 카드가 덮는 자리에 선 핀은 감춘다. 카드는 머리글에 붙어 늘 같은 자리인데
         (1600 기준 453~676) 핀은 화면 높이를 따라 오르내린다 — 창이 낮을수록
         오른쪽 핀이 카드 안으로 들어와, 760 높이에서는 44×44 가 통째로 겹쳤다.
         ⚠️ 고른 핀은 감추지 않는다 — CSS 가 카드 위로 올려 통째로 보이게 한다.
         ⚠️ 창 크기와 스크롤에 따라 다시 재야 한다. 히어로가 자라는 동안에도
            핀이 움직인다. */
      function cover() {
        var ms = hero.querySelectorAll('.vh-marker');
        var cb = open ? card.getBoundingClientRect() : null;
        for (var i = 0; i < ms.length; i++) {
          var m = ms[i], pin = m.querySelector('.vh-pin');
          if (!cb || !pin || m.classList.contains('is-pinned')) { m.classList.remove('is-covered'); continue; }
          var b = pin.getBoundingClientRect();
          m.classList.toggle('is-covered',
            Math.min(cb.right, b.right) > Math.max(cb.left, b.left) &&
            Math.min(cb.bottom, b.bottom) > Math.max(cb.top, b.top));
        }
      }
      var coverT = false;
      function coverSoon() {
        if (coverT || !open) return;
        coverT = true;
        requestAnimationFrame(function () { coverT = false; cover(); });
      }
      addEventListener('scroll', coverSoon, { passive: true });
      addEventListener('resize', coverSoon, { passive: true });
      function hide() {
        card.hidden = true;
        /* 핀을 풀면 그래픽도 예전 판으로 돌아간다. */
        dim();
        mark(null); open = null;
        cover();
      }
      function show(id) {
        var tpl = document.querySelector('template[data-hero-card="' + id + '"]');
        if (!tpl) return;
        var h = tpl.content.querySelector('.vh-card__title');
        var p = tpl.content.querySelector('.vh-card__desc');
        /* 윗자리 그래픽은 HeroPinArt 가 둔 <template data-hero-art> 에서 꺼낸다 —
           마커 id 로 찾는다. 없으면 그 자리를 비워 둔다(글만 선다). */
        var atpl = document.querySelector('template[data-hero-art="' + id + '"]');
        art.textContent = '';
        if (atpl) art.appendChild(atpl.content.cloneNode(true));
        art.hidden = !atpl;
        tt.textContent = h ? h.textContent : '';
        ds.textContent = p ? p.textContent : '';
        card.hidden = false;
        mark(id);
        open = id;
        /* open 이 정해진 뒤에 잰다 — mark() 안에서는 아직 비어 있다. */
        cover();
      }

      document.addEventListener('click', function (e) {
        var t = e.target;
        if (!t || !t.closest) return;
        var pin = t.closest('.vh-pin');
        if (pin && hero.contains(pin)) {
          var m = pin.closest('.vh-marker');
          var id = m && m.getAttribute('data-id');
          if (!id) return;
          light(id);
          if (open === id) hide(); else show(id);
          return;
        }
        /* 카드 안을 누르는 건 아무 일도 아니다 — 닫는 건 같은 핀을 다시 누르거나
           바깥을 누르거나 Esc 다. */
        if (t.closest('.hero-pin-card')) return;
        if (open) hide();
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && open) hide();
      });
    })();
  </script>

  {/* 마커 카드의 내용. 그래픽(public/hero/vetec-hero.js)은 핀 위치와 빈 카드 껍데기까지
      만들고, 그 안은 여기서 채운다 — 아래 스크립트가 data-id 를 맞춰 꽂는다.
      문구는 src/data/heroMarkers.ts, 모양은 global.css 가 쥔다. */}
  {heroCards.ko.map((c) => (
    <template data-hero-card={c.id} data-hero-card-label={c.title}>
      <div class="vh-card__top"><i class={`ph ${c.icon} vh-card__ic`} aria-hidden="true"></i></div>
      <h3 class="vh-card__title">{c.title}</h3>
      <p class="vh-card__desc">{c.desc}</p>
    </template>
  ))}
  <script is:inline type="module">
    (function () {
      /* ⚠️ 그래픽 스크립트가 카드 껍데기를 만든 뒤에 돌아야 한다.
         vetec-hero.js 는 defer 라 파싱이 끝난 뒤 실행되는데, 보통의 인라인 스크립트는
         파싱 도중 즉시 실행된다 — 그때는 카드가 아직 없어 빈 상자만 남는다.
         type="module" 이면 defer 와 같은 큐에 들어가 문서 순서대로 실행되고,
         그래도 늦는 경우를 대비해 카드가 생길 때까지 DOM 을 지켜본다. */
      function fill() {
        var cards = document.querySelectorAll('#hero .vh-card');
        if (!cards.length) return false;
        var filled = 0;
        for (var i = 0; i < cards.length; i++) {
          var card = cards[i];
          if (card.childElementCount) { filled++; continue; }
          var marker = card.closest('.vh-marker');
          if (!marker) continue;
          var tpl = document.querySelector('template[data-hero-card="' + marker.getAttribute('data-id') + '"]');
          if (!tpl) continue;
          card.appendChild(tpl.content.cloneNode(true));
          /* 핀과 카드의 접근성 이름도 문구에서 가져온다 — 그래픽은 더 이상 문구를 모른다. */
          var label = tpl.getAttribute('data-hero-card-label') || '';
          card.setAttribute('aria-label', label);
          var pin = marker.querySelector('.vh-pin');
          if (pin) pin.setAttribute('aria-label', label);
          filled++;
        }
        return filled === cards.length;
      }
      if (fill()) return;
      var hero = document.getElementById('hero');
      if (!hero || !('MutationObserver' in window)) return;
      var obs = new MutationObserver(function () { if (fill()) obs.disconnect(); });
      obs.observe(hero, { childList: true, subtree: true });
      /* 그래픽이 끝내 안 뜨는 경우까지 지켜보지는 않는다. */
      setTimeout(function () { obs.disconnect(); }, 8000);
    })();
  </script>

  </section>

