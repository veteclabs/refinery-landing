      line-height: 1.1;
      text-align: center;
      /* ⚠️ --x/--y 는 네모(칩 판) 한가운데가 아니다. 전단이 세로 거리를 가로로도
            옮기기 때문에, 두 줄을 담은 상자의 한가운데를 네모 한가운데에 맞추면
            정작 글자 덩어리는 왼쪽 위로 치우친다(윗줄은 왼쪽 위로, 아랫줄은
            오른쪽 아래로 끌린 결과 두 줄의 글자 폭이 서로 다른 만큼 어긋난다).
            그래서 상자를 네모 중심(600.03, 604.34)에서 오른쪽 아래로 그 어긋남만큼
            밀어 둔다 — 880px 폭 · 글자 11px 기준 가로 1.59 · 세로 1.01 단위다. */
    }

    /* 판 가장자리의 작은 이름표 넷. 같은 아이소메트릭 행렬을 쓴다.
       ⚠️ Unify · Refine · Collect 는 받치던 칩(#151B23)까지 SVG 에서 걷어 냈다.
          글자만 키우면 칩(48×45)을 넘친다 — 칩도 HTML 로 다시 그려 글자 길이를
          따라가게 했다. */
    #platform .pf-labels .pf-label--chip {
      color: #76A6D7;
      /* 칩도 글자와 같이 눕는다 — 받침만 반듯하면 글자가 떠 보인다. */
      background: #151B23;
      padding: 0.45em 0.9em;
      border-radius: 999px;
    }
    #platform .pf-labels .pf-label--data {
      color: #F6F8FA;
      /* 흰 글자가 어두운 면 위에 있어 같은 굵기여도 번져 보인다 —
         기울인 다른 이름표(600)보다 세 단계 낮춰야 눈높이가 맞는다.
         ⚠️ 300 은 Roboto 가 들고 있는 가장 가는 굵기다 — 더 내릴 자리가 없다. */
      font-weight: 300;
      letter-spacing: 0.02em;
    }

    /* 한 장을 두 번에 나눠 보여 준다. 처음에는 위 31% 만 보이고(카드 세 장과
       이름표), 그 뒤 오림이 아래로 자라 온톨로지 판이 드러난다.
       자르는 자리 31% 는 짐작이 아니다 — 캔버스에 그려 행마다 브랜드색 화소를
       세어 보니 이름표 알약이 29.7% 에서 끝난다. 그 한 뼘 아래다.
       ⚠️ 전에는 같은 그림을 두 장 겹쳐 썼다. 한 장이면 파일도 한 번만 받고,
          나중에 요소 단위로 켜는 방식으로 갈아탈 때도 그대로 쓸 수 있다. */
    #platform .pf-art {
      clip-path: inset(0 0 var(--pf-clip, 69%) 0);
      opacity: var(--pf-in, 0);
      transform: translateY(calc(36px * (1 - var(--pf-in, 0))));
      pointer-events: none;
    }

    /* 층을 하나씩 펼쳐 보는 글 목록. 카드로 쌓으면 일곱 장이 그래픽 높이를 넘겨
       따로 넘겨야 했는데, 접어 두면 한 화면에 들어온다. */
    /* 아코디언은 단 바닥에 붙는다 — 아랫변이 그래픽 아랫변과 같은 선에 선다.
       (단 높이는 그래픽이 정한다.) */
    /* 구분선은 두 단이다 — 쉴 때 #22303F, 손이 닿거나 열린 줄은 #3A4856.
       줄 하나하나가 누르는 자리라 그 둘을 나눠 쓴다. 제목 색이 일곱 줄 모두
       같아진 뒤로는 이 선이 열린 줄을 알리는 거의 유일한 표시다 — 두 값의
       차이를 좁히지 말 것. #22303F 는 그래픽 판 옆면과 같은 값이다. */
    /* ⚠️ flex: none — 칸이 flex 라 기본값(shrink: 1)이면 무대 높이에 눌려 줄들이
       겹쳐 찌그러진다. 제목 줄과 같은 이유다. */
    /* 선은 줄과 줄 사이에만 둔다 — 맨 위와 맨 아래는 긋지 않는다. */
    #platform .pf-acc { margin-top: auto; flex: none; }
    #platform .pf-item + .pf-item { border-top: 1px solid #16202C; transition: border-color .2s ease; }
    /* 손이 닿은 줄은 제 위 선과 아래 줄의 위 선을 함께 올린다. */
    #platform .pf-item:hover,
    #platform .pf-item.is-open { border-top-color: #22303F; }
    #platform .pf-item:hover + .pf-item,
    #platform .pf-item.is-open + .pf-item { border-top-color: #22303F; }
    #platform .pf-q {
      width: 100%;
      display: flex;
      align-items: center;
      gap: 14px;
      /* 선과 글, 글과 글 사이를 모두 20px 로 보이게 맞춘 값이다.
         ⚠️ 상자 간격이 아니라 '보이는' 간격을 맞춘다. 글 상자는 행간의 남는 몫을
            위아래로 반씩 품고 있어(제목 2.4px · 본문 3.5px), 상자 간격을 똑같이
            15px 로 두면 눈에는 17.4 · 20.9 · 18.5px 로 들쑥날쑥해진다.
            20 − 2.4 = 17.6 이 제목 위아래에 필요한 상자 간격이다. */
      padding: 17.6px 0;
      background: none;
      border: 0;
      cursor: pointer;
      font-family: inherit;
      text-align: left;
      color: #F6F8FA;
    }
    /* 접혀 있을 때 보이는 건 제목이다. 본문은 펼쳐야 나온다. */
    #platform .pf-t {
      flex: 1 1 auto;
      min-width: 0;
      font-size: 16px;
      font-weight: 500;
      /* 제목 행간은 1.25~1.35 가 기본이다. */
      line-height: 1.3;
      color: #F6F8FA;
      transition: color .2s ease;
      word-break: keep-all;
    }
    /* 열고 닫는 표시는 따로 두지 않는다 — 줄 사이 구분선만 남긴다.
       제목 색은 열린 줄과 닫힌 줄이 같다(#F6F8FA). 어느 줄이 열렸는지는
       아래 본문과 구분선(#3A4856), 그리고 그림에서 켜지는 조각이 알린다. */
    /* 펼친 줄은 제목 아래에 본문이 붙으므로 두 반 행간이 겹친다 —
       20 − 2.4 − 3.5 = 14.1 로 줄여야 그 사이도 20px 로 보인다. */
    #platform .pf-item.is-open .pf-q { padding-bottom: 14.1px; }
    /* ⚠️ 높이는 스크립트가 px 로 넣는다. max-height 로 어림잡으면 글 길이가
       제각각이라 닫히는 속도가 줄마다 달라진다. */
    #platform .pf-a {
      height: 0;
      overflow: hidden;
      transition: height .35s cubic-bezier(.22, 1, .36, 1);
    }
    #platform .pf-a p {
      /* 20 − 3.5(본문 반 행간) = 16.5 */
      margin: 0 0 16.5px;
      font-size: 14px;
      /* 굵기는 히어로 소제목과 같은 300 이다. */
      font-weight: 300;
      /* 본문 행간은 1.5 가 기본이다. */
      line-height: 1.5;
      color: #A4ADB8;
      word-break: keep-all;
    }
    @media (max-width: 900px) {
      #platform .platform-graphic-wrap {
        margin: 40px 0 0;
        padding: 0 0 6px;
        /* 옆으로 끌어 보던 칸이었다 — 이제 그림이 폭에 맞춰 줄므로 넘칠 일이 없다. */
        overflow: visible;
        display: flex;
        justify-content: center;
      }
      #platform .platform-graphic-wrap::-webkit-scrollbar { display: none; }
      /* 폭에 맞춰 줄인다 — 예전에는 min-width: 680px 로 두고 칸을 옆으로 끌어
         보게 했는데, 끌 수 있다는 걸 모르면 그림이 잘린 것으로만 보인다.
         작아지더라도 한눈에 다 보이는 쪽을 택한다. */
      #platform .platform-graphic-img {
        margin-top: 0;
        width: 100%;
        min-width: 0;
        max-width: 680px;
        height: auto;
      }
      /* 두 단을 한 단으로 쌓는다. */
      #platform .platform-split {
        grid-template-columns: 1fr;
        gap: 40px;
        margin-top: 40px;
      }

      /* ⚠️ 끌어 보는 커서는 두지 않는다 — 넘치지 않으므로 끌 것이 없다. */
      /* 그래픽을 잡으면 브라우저 기본 이미지 끌기가 먼저 걸려 스크롤이 안 된다 */
      #platform .platform-graphic-wrap img { -webkit-user-drag: none; user-select: none; }
    }
    /* #teams 미리보기 — 901~1280px에서도 세로로 나눈다.
       원래는 이미지 위에 제목·본문을 얹고, 왼쪽 28.5% 페이드가 글 배경 노릇을 했다.
       그런데 텍스트 박스는 <br>로 줄이 고정돼 352px로 붙박이인데 페이드는 폭의 %라
       같이 줄어든다 → 좁아질수록 글이 배경을 벗어나 이미지 위로 올라온다.
       Plate 탭에서 본문이 막대 차트에 묻혔다(910px에서 배경 밖 125px).

       배경을 px로 고정해 봤지만 그만큼 이미지를 가려 접었다. 900px 이하에서 이미
       쓰는 세로 분리를 1280px까지 올리는 쪽이 탭·이미지와 무관하게 해결된다.

       900px 이하는 global.css 가 맡는다 — 거기 값은 화면 끝까지 붙이는 모바일용이라
       (margin-right:-24px 등) 여기서는 데스크톱 여백에 맞춘 값을 따로 쓴다.
       JS 쪽 resizeDash 의 모바일 판정도 같은 1280으로 맞춰야 이미지가 제자리에 온다.
       영문(en/index.astro)에도 같은 규칙이 있다 — global.css 가 공용이라 각 페이지에 따로 둔다. */
    @media (min-width: 901px) and (max-width: 1280px) {
      .teams-preview {
        aspect-ratio: unset !important;
        display: flex !important; flex-direction: column !important;
        background: #F6F8FA;
        border-radius: 0 0 var(--radius) var(--radius) !important;
      }
      .teams-preview-decor { display: none !important; }
      /* 좌우 32 → 20px. 이 구간에서 글 칸은 .teams-rail 의 min-width 300px 에
         묶이는데, 32px 씩 떼면 제목에 236px 밖에 안 남아 「질문하면 온톨로지가」
         237px · 「현장의 지금 이 순간을」 251px 이 두 줄로 쪼개졌다(「가」 한 글자가
         고아로 떨어졌다). 20px 이면 260px 이라 둘 다 한 줄로 선다.
         ⚠️ 제목과 본문을 같은 값으로 둔다 — 한쪽만 줄이면 왼쪽 끝이 어긋난다. */
      .teams-preview-title-wrap { position: static !important; padding: 28px 20px 0 !important; order: 1; margin-bottom: 14px; }
      .teams-preview-text { position: static !important; padding: 0 20px 24px !important; order: 2; }
      /* 30 → 28px. 20px 여백으로 칸이 260px 이 되어도 「현장의 지금 이 순간을」이
         251px 이라 9px 밖에 안 남는다 — 글꼴이 대체되면 그 자리에서 넘어간다.
         한 단 줄여 234px 으로 두고 26px 을 남긴다. */
      #teams .teams-preview-title-wrap h3 { font-size: 28px; }
      .teams-preview-text p { max-width: none; }
      #iframe-wrapper { position: relative !important; inset: auto !important; width: 100%; aspect-ratio: 17/10; order: 3; overflow: hidden !important; }
      #iframe-wrapper::before {
        content: ""; position: absolute; top: 0; left: 0; right: 0; height: 14px;
        background: linear-gradient(to bottom, #F6F8FA 0%, rgba(246,248,250,0) 100%);
        z-index: 2; pointer-events: none;
      }
      #iframe-wrapper::after {
        content: ""; position: absolute; inset: 0;
        background: linear-gradient(to right, #F6F8FA 0%, rgba(246,248,250,0.85) 8%, rgba(246,248,250,0) 24%, rgba(246,248,250,0) 76%, rgba(246,248,250,0.85) 92%, #F6F8FA 100%);
        z-index: 2; pointer-events: none;
      }
    }

    /* #teams 탭 여섯 개는 이 섹션이 말하는 "everything"의 목록이다.
       900px 이하에서 가로 스크롤(scroll-snap)로 넘기게 되어 있었는데, 880px에서
       네 개 반만 보인다 — 다 갖췄다는 주장을 정작 화면이 가린다. 줄로 나눠 다 보인다.

       한 줄에 여섯 개가 온전히 들어가려면 칸이 152px는 되어야 한다 — 1024px까지는
       들어가고 그 아래부터 잘린다. 잘리기 전에 여유를 두어 1089px 이하에서 줄로 나눈다.
       3열은 바 폭 456px가 필요해 520px 아래에서는 2열로 내린다.
       테두리는 줄 끝에서 지우고 둘째 줄부터 위에 긋는데, 열 수가 바뀌면
       그 자리도 바뀌므로 nth-child 를 구간마다 다시 잡는다.
       영문에도 같은 규칙이 있다 — global.css 가 공용이라 각 페이지에 따로 둔다. */
    @media (max-width: 1089px) {
      #teams .teams-menu-horizontal {
        flex-wrap: wrap; overflow-x: hidden; margin-right: 0;
        border-radius: var(--radius) var(--radius) 0 0 !important;
        scroll-snap-type: none;
      }
      #teams .teams-tab-btn { flex: 1 1 33.333%; scroll-snap-align: none; padding: 16px 8px; }
      #teams .teams-tab-btn:nth-child(3n) { border-right: none; }
      #teams .teams-tab-btn:nth-child(n+4) { border-top: 1px solid var(--border); }
    }
    /* 카드 오른쪽 정렬은 900px 이하만 해당한다 — global.css 가 거기서만
       margin-right:-24px 로 화면 끝까지 흘리기 때문이다. 가로 스크롤 시절
       '더 있다'는 힌트였는데, 탭바가 줄바꿈으로 바뀌며 탭바만 컨테이너 안에서
       끝나 오른쪽이 어긋났다. 모서리도 왼쪽만 둥글던 것을 양쪽으로 되돌린다. */
    @media (max-width: 900px) {
      #teams .teams-preview {
        margin-right: 0;
        border-radius: 0 0 var(--radius) var(--radius) !important;
      }
    }
    @media (max-width: 520px) {
      #teams .teams-tab-btn { flex-basis: 50%; }
      #teams .teams-tab-btn:nth-child(3n) { border-right: 1px solid var(--border); }
      #teams .teams-tab-btn:nth-child(2n) { border-right: none; }
      #teams .teams-tab-btn:nth-child(n+3) { border-top: 1px solid var(--border); }
    }

    /* AI Agent 탭 캡처는 위쪽에 가로 실선이 들어 있다(원본 y≈136px).
       JS 가 이미지를 위로 밀어 자르면서 그 선이 미리보기 상단 10px 자리에 올라온다.
       기존 14px 페이드는 그 지점에서 이미 70% 투명해져 선을 못 가린다 —
       페이드를 키워도 대비만 줄 뿐이라, 앞 24px 을 불투명하게 덮고 나머지로 잇는다.
       높이는 px 이 아니라 미리보기 높이의 8%다. 좁아질수록 이미지가 작아져 선도 위로
       올라오는데(1000px 10px → 390px 4px), 40px 으로 고정하면 390px 에서 이미지의
       20%를 덮어 위쪽이 통째로 가린다. %로 두면 밴드도 같이 줄어든다.
       탭마다 선 위치가 달라(Pipeline 19·22px · Calendar 21px) 이 탭만 골라 건다.
       :has() 로 이미지 src 를 보므로 JS 는 그대로 둔다. */
    @media (max-width: 1280px) {
      #teams #iframe-wrapper:has(#dash-image[src*="Solutions-02-ai-agent"])::before {
        height: 8%;
        background: linear-gradient(to bottom, #F6F8FA 0%, #F6F8FA 60%, rgba(246,248,250,0) 100%);
      }
    }
    /* 세로로 나뉘면 글이 미리보기 폭을 통째로 쓴다. 좁은 칸(352px)에 맞춰 넣어 둔
       teamsTextMap 의 \n 은 문장 중간을 끊으므로 공백으로 풀고(white-space:normal),
       대신 JS 가 문장 끝마다 <br> 을 넣어 문장별로 단락을 나눈다. */
    @media (max-width: 1280px) {
      #teams .teams-preview-text p { white-space: normal; }
    }

    /* 줄바꿈을 걷고 나니 이번엔 한 줄이 너무 길어졌다 — 1280px에서 본문이 1103px
       한 줄로 늘어진다. 오버레이 시절 데스크톱 값(640px)으로 다시 묶는다.
       15px 글자에서 70자 안팎이라 읽기 좋은 길이이고, 본문은 어느 폭에서나 2줄 위로 선다.
       (901~1280px 블록의 max-width:none 보다 #teams 를 붙인 이쪽이 이긴다) */
    @media (max-width: 1280px) {
      #teams .teams-preview-title-wrap h3,
      #teams .teams-preview-text p { max-width: 640px; }
    }
      /* ⚠️ 900px 아래에서는 무대를 붙이지 않는다. 무대가 100vh 인데 그 안의 내용이
       567px 넘쳐(900 실측), justify-content: center 가 넘친 만큼을 위아래로 똑같이
       밀어내 제목이 화면 아래로 내려갔다. 고정을 풀고 흐르게 두면 제자리에 선다.
       진행도는 스크립트가 '제목이 화면을 올라오는 만큼' 으로 바꿔 잡는다.
       ⚠️ 이 묶음은 스타일 블록 맨 끝에 둔다 — #platform .pf-stage 와 특정도가
          같아서 뒤에 와야 이긴다. */
    @media (max-width: 900px) {
      #platform { height: auto; padding: 96px 0; }
      #platform .pf-stage {
        position: static;
        height: auto;
        padding-top: 0;
        padding-bottom: 0;
        display: block;
      }
    }
</style>
  <script is:inline>
    (function() {
      /* 좁은 폭에서는 가로 스크롤이 위치를 갖는데, 터치는 스와이프로 넘겨도 마우스로는
         끌 수가 없었다(휠·화살표뿐). 포인터로 scrollLeft 를 직접 옮겨 끌게 한다.
         터치·펜은 네이티브가 이미 받으므로 마우스만 가로챈다.
         플랫폼 섹션의 카드·그래픽, 통합 섹션의 노드 격자가 모두 같은 방식이다. */
      function isNarrow() { return window.innerWidth <= 900; }
      function enableDragScroll(el, canDrag) {
        var drag = null;
        el.addEventListener('pointerdown', function(e) {
          if (!canDrag() || e.pointerType !== 'mouse' || e.button !== 0) return;
          drag = { x: e.clientX, left: el.scrollLeft, moved: false };
        });
        el.addEventListener('pointermove', function(e) {
          if (!drag) return;
          var dx = e.clientX - drag.x;
          // 3px 은 넘겨야 끌기로 본다 — 손떨림으로 글자 선택이 풀리지 않게 한다
          if (!drag.moved && Math.abs(dx) < 3) return;
          if (!drag.moved) {
            drag.moved = true;
            el.classList.add('is-dragging');
            try { if (el.setPointerCapture) el.setPointerCapture(e.pointerId); } catch (err) {}
          }
          el.scrollLeft = drag.left - dx;
          e.preventDefault();
        });
        function endDrag(e) {
          if (!drag) return;
          var moved = drag.moved;
          try {
            if (moved && el.hasPointerCapture && el.hasPointerCapture(e.pointerId)) {
