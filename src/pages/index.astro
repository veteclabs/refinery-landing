<script is:inline>
  /* 보안 무대 — 제목 · 소제목 · 카드 두 장이 한 화면에 멈춰 선 채로, 스크롤이
     지나는 동안 제목 글자가 왼쪽부터 드러나고 이어서 아래가 떠오른다. 다 뜬 뒤
     ⚠️ 무대를 화면에 붙이지 않는다 — 진행도는 제목이 화면을 올라오는 만큼이다.
        한 페이지에 고정 구간이 다섯이면 스크롤이 계속 붙잡힌다.
     솔루션 섹션과 같은 구조지만 변수 이름이 따로다(--sec-*).
     ⚠️ 진행도는 핀 상자가 화면을 지나간 비율이다(무대가 붙어 있는 동안 0→1).
     ⚠️ 무대가 sticky 가 아니면(낮은 화면 · 동작 줄이기) 손을 떼고 다 드러난
        상태로 세운다. */
  (function () {
    var sec = document.getElementById('security');
    if (!sec) return;
    var stage = sec.querySelector('.sec-stage');
    var lines = sec.querySelectorAll('.sec-title .sec-line');
    var cards = sec.querySelectorAll('.sec-card');
    if (!stage || !lines.length) return;

    function settle() {
      for (var i = 0; i < lines.length; i++) {
        lines[i].style.setProperty('--sec-o', '1');
      }
      for (var c = 0; c < cards.length; c++) cards[c].style.setProperty('--sec-c', '1');
      sec.style.setProperty('--sec-body', '1');
      sec.style.setProperty('--sec-lift', '0px');
    }

    /* ⚠️ 이 두 벌은 이 IIFE 안에 따로 둔다. 같은 이름이 솔루션 스크립트에도
       있지만 그쪽은 제 IIFE 안이라 여기서 못 쓴다 — 없이 두면 progress() 가
       ReferenceError 로 죽어 제목 모션이 통째로 멈춘다. */
    function clamp(v) { return v < 0 ? 0 : v > 1 ? 1 : v; }
    function ease(t) { return t * t * (3 - 2 * t); }

    function progress() {
      /* 무대를 붙이지 않으므로 대제목이 화면을 올라오는 만큼을 진행도로 쓴다.
         아래 끝 가까이(92%)에 닿으면 0, 화면 높이의 40% 자리까지 오면 1 이다.
         그래서 모션은 섹션이 들어오는 동안 끝나고 그 뒤로는 그냥 스크롤된다. */
      var title = sec.querySelector('.sec-title');
      if (!title) return 1;
      var vh = window.innerHeight || 800;
      var from = vh * 1.00, to = vh * 0.35;
      return from > to ? clamp((from - title.getBoundingClientRect().top) / (from - to)) : 1;
    }

    var reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;

    function upd() {
      if (reduce) { settle(); return; }
      var p = progress();
      /* 머리글은 내리지 않는다 — 무대가 화면을 꽉 채우지 않으므로 가운데로
         끌어올 자리가 없다. --sec-lift 는 CSS 기본값 0px 를 그대로 쓴다. */
      /* 1) 제목이 줄마다 늦춰 떠오른다 — 아래에서 올라오며 흐림이 걷힌다.
         윗줄이 먼저다. 창은 제목이 화면을 올라오는 65vh 에 맞춘 값이다. */
      var LEAD = 0, STEP = 0.14, SPAN = 0.36;
      for (var i = 0; i < lines.length; i++) {
        var q = ease(clamp((p - LEAD - i * STEP) / SPAN));
        lines[i].style.setProperty('--sec-o', q.toFixed(3));
      }
      /* 2) 소제목부터 아래가 떠오른다. */
      sec.style.setProperty('--sec-body', ease(clamp((p - 0.62) / 0.30)).toFixed(3));
      /* 3) 카드는 소제목 뒤를 이어 한 장씩 늦춰 떠오른다. */
      for (var c = 0; c < cards.length; c++) {
        cards[c].style.setProperty('--sec-c', ease(clamp((p - 0.66 - c * 0.05) / 0.24)).toFixed(3));
      }
    }

    var ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () { ticking = false; upd(); });
    }
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll, { passive: true });
    upd();
    requestAnimationFrame(upd);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(upd);
  })();
</script>

