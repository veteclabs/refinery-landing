          /* 고른 줄에 해당하는 그림 요소만 켠다.
             ⚠️ <object> 안은 별도 문서라 바깥 CSS·JS 가 그냥은 닿지 않는다. 같은
                도메인이라 contentDocument 로 들어갈 수 있고, 선택 규칙은 SVG 파일
                안에 미리 심어 뒀다(svg.rf-sel [data-part]).
             ⚠️ 그림이 늦게 오므로 load 를 기다린다. 이미 와 있으면 바로 쓴다. */
          var artDoc = null;
          function svgRoot() {
            var o = document.querySelector('#platform .pf-art');
            try { return o && o.contentDocument && o.contentDocument.querySelector('svg'); }
            catch (e) { return null; }
          }
          function lightUp(it) {
            var root = svgRoot();
            if (!root) return;
            var spec = it && it.getAttribute('data-part');
            /* 'all' 은 한 부분이 아니라 그림 전체다 — 흐리게 하는 규칙 자체를 걷는다.
               한 줄이 그림의 여러 덩어리를 가리킬 때는 쉼표로 적는다. */
            var want = spec && spec !== 'all' ? spec.split(',') : null;
            var all = root.querySelectorAll('[data-part]');
            for (var i = 0; i < all.length; i++) {
              var p = all[i].getAttribute('data-part');
              all[i].classList.toggle('rf-on', !!want && want.indexOf(p) >= 0);
            }
            root.classList.toggle('rf-sel', !!want);
            /* 이름표는 SVG 밖 HTML 이라 같은 규칙이 닿지 않는다 — 여기서 함께 켠다. */
            var labels = document.querySelectorAll('#platform .pf-label');
            for (var j = 0; j < labels.length; j++) {
              labels[j].classList.toggle('rf-on', !!want && want.indexOf(labels[j].getAttribute('data-part')) >= 0);
            }
            var box = document.querySelector('#platform .pf-labels');
            if (box) box.classList.toggle('rf-sel', !!want);
          }
          (function () {
            var o = document.querySelector('#platform .pf-art');
            if (!o) return;
            o.addEventListener('load', function () {
              var open = acc.querySelector('.pf-item.is-open');
              if (open) lightUp(open);
            });
          })();

          for (var i = 0; i < items.length; i++) {
            (function (it) {
              it.querySelector('.pf-q').addEventListener('click', function () {
                var willOpen = !it.classList.contains('is-open');
                for (var j = 0; j < items.length; j++) setOpen(items[j], false);
                if (willOpen) { setOpen(it, true); lightUp(it); }
