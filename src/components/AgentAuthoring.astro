---
/**
 * 「AI 에이전트로 화면 만들기」 샘플 UI — 정적 목업이다. 버튼은 눌러도 아무 일도 하지 않는다.
 *
 * 아직 출시 전 기능이라 문구는 미래형이고 「준비 중」 칩을 단다. 출시 일정은 쓰지 않는다.
 * 근거 계획서: 앱 리포 services/agent/docs/CLIENT_COMMAND_AUTHORING_PLAN.md (veteclabs/refinery#2962).
 *  - 편집은 초안(저장 안 됨), 저장만 승인 → 장면 A의 「초안 · 저장 안 됨」 칩과 「저장할까요?」 카드.
 *  - 병렬 저작은 서브가 쓰기를 제안하고 부모가 한 번에 승인 → 장면 B의 체크박스 승인 카드.
 *
 * 국문 · 영문 랜딩이 같은 컴포넌트를 쓴다(lang prop). 줄바꿈은 <br>로 명시한다(CLAUDE.md).
 */
interface Props { lang?: 'ko' | 'en' }
const { lang = 'ko' } = Astro.props;
const ko = lang === 'ko';

const t = ko
  ? {
      soon: '준비 중',
      title: ['말로 지시하면', '화면이 만들어집니다'],
      sub: ['AI 에이전트가 화면을 한 단계씩 만들어 갈 예정입니다.', '저장은 사람이 확인한 뒤에만 반영됩니다.'],
      tabA: '화면 하나 만들기',
      tabB: '여러 곳을 동시에',
      editor: '네비게이터 편집',
      nav: '본사 운영',
      draft: '초안 · 저장 안 됨',
      overview: '개요',
      energy: '에너지 현황',
      alarms: '알람 목록',
      equip: '설비',
      ahu: '공조기',
      comp: '압축기',
      agent: 'AI 에이전트',
      askA: '설비 섹션 만들고 공조기 · 압축기 화면 넣어줘',
      stepsA: ['붙일 수 있는 화면을 확인했습니다', '「설비」 섹션을 추가했습니다', '공조기 · 압축기 화면을 넣었습니다'],
      saveQ: '저장할까요?',
      saveA: ['「본사 운영」에 섹션 1개, 화면 2개를 더합니다.', '저장하면 프로젝트 멤버 모두에게 보입니다.'],
      cancel: '취소',
      save: '저장',
      askB: '공장 3곳 네비게이터를 같은 구성으로 만들어줘',
      sites: ['대전 공장', '울산 공장', '평택 공장'],
      worker: (n: number) => `AI 에이전트 ${n}`,
      parallel: 'AI 에이전트 3개가 동시에 만들고 있습니다',
      done: '완료',
      saveQB: '3건을 저장할까요?',
      saveB: '선택한 3건 저장',
      note: '화면은 예시입니다. 실제 화면과 다를 수 있습니다.',
    }
  : {
      soon: 'Coming soon',
      title: ['Say what you need,', 'and the screen is built'],
      sub: ['The AI Agent will build your screens one step at a time.', 'Nothing is saved until a person approves it.'],
      tabA: 'Build one screen',
      tabB: 'Build several at once',
      editor: 'Navigator editor',
      nav: 'HQ Operations',
      draft: 'Draft · Not saved',
      overview: 'Overview',
      energy: 'Energy status',
      alarms: 'Alarm list',
      equip: 'Equipment',
      ahu: 'Air handling units',
      comp: 'Compressors',
      agent: 'AI Agent',
      askA: 'Add an Equipment section with the AHU and compressor screens',
      stepsA: ['Checked which screens can be added', 'Added the “Equipment” section', 'Added the AHU and compressor screens'],
      saveQ: 'Save these changes?',
      saveA: ['Adds 1 section and 2 screens to “HQ Operations”.', 'Once saved, every project member will see them.'],
      cancel: 'Cancel',
      save: 'Save',
      askB: 'Build navigators for our 3 plants with the same layout',
      sites: ['Daejeon plant', 'Ulsan plant', 'Pyeongtaek plant'],
      worker: (n: number) => `AI Agent ${n}`,
      parallel: '3 AI Agents are building in parallel',
      done: 'Done',
      saveQB: 'Save all 3?',
      saveB: 'Save 3 selected',
      note: 'Illustrative screens. The actual product may differ.',
    };
---
<section id="agent-authoring" class="aa" style="background:#F6F8FA;border-top:1px solid #E3E7EC;">
  <div class="container">
    <div class="section-header">
      <div class="section-header-row">
        <div>
          <span class="aa-soon"><i class="ph ph-clock" aria-hidden="true"></i>{t.soon}</span>
          <h2>{t.title[0]}<br>{t.title[1]}</h2>
        </div>
        <p class="aa-sub">{t.sub[0]}<br>{t.sub[1]}</p>
      </div>
    </div>

    <div class="aa-tabs" role="tablist" aria-label={t.agent}>
      <button type="button" class="aa-tab active" role="tab" aria-selected="true" aria-controls="aa-scene-a" id="aa-tab-a" data-aa-tab="a"><i class="ph ph-sparkle" aria-hidden="true"></i>{t.tabA}</button>
      <button type="button" class="aa-tab" role="tab" aria-selected="false" aria-controls="aa-scene-b" id="aa-tab-b" data-aa-tab="b" tabindex="-1"><i class="ph ph-stack" aria-hidden="true"></i>{t.tabB}</button>
    </div>

    {/* 장면 A — 왼쪽 편집 화면, 오른쪽 AI 에이전트 패널 */}
    <div class="aa-frame" id="aa-scene-a" role="tabpanel" aria-labelledby="aa-tab-a">
      <div class="aa-editor" aria-hidden="true">
        <div class="aa-bar">
          <span class="aa-bar-title"><i class="ph ph-compass"></i>{t.editor}</span>
          <span class="aa-chip">{t.draft}</span>
        </div>
        <div class="aa-editor-body">
          <div class="aa-navname">{t.nav}</div>
          <div class="aa-group">
            <div class="aa-sec"><i class="ph ph-caret-down"></i>{t.overview}</div>
            <div class="aa-item"><i class="ph ph-presentation"></i>{t.energy}</div>
            <div class="aa-item"><i class="ph ph-bell"></i>{t.alarms}</div>
          </div>
          <div class="aa-group aa-new">
            <div class="aa-sec"><i class="ph ph-caret-down"></i>{t.equip}<span class="aa-tag">NEW</span></div>
            <div class="aa-item"><i class="ph ph-wind"></i>{t.ahu}<span class="aa-tag">NEW</span></div>
            <div class="aa-item"><i class="ph ph-gauge"></i>{t.comp}<span class="aa-tag">NEW</span></div>
          </div>
        </div>
      </div>

      <div class="aa-panel" aria-hidden="true">
        <div class="aa-bar"><span class="aa-bar-title"><i class="ph ph-sparkle"></i>{t.agent}</span></div>
        <div class="aa-panel-body">
          <div class="aa-ask">{t.askA}</div>
          <ol class="aa-steps">
            {t.stepsA.map((s) => <li><i class="ph ph-check-circle"></i>{s}</li>)}
          </ol>
          <div class="aa-approve">
            <div class="aa-approve-q"><i class="ph ph-shield-check"></i>{t.saveQ}</div>
            <p>{t.saveA[0]}<br>{t.saveA[1]}</p>
            <div class="aa-btns"><span class="aa-btn">{t.cancel}</span><span class="aa-btn aa-btn-primary">{t.save}</span></div>
          </div>
        </div>
      </div>
    </div>

    {/* 장면 B — AI 에이전트 3개가 동시에 만들고, 저장은 승인 카드 하나에서 */}
    <div class="aa-frame aa-frame-b" id="aa-scene-b" role="tabpanel" aria-labelledby="aa-tab-b" hidden>
      <div class="aa-editor" aria-hidden="true">
        <div class="aa-bar">
          <span class="aa-bar-title"><i class="ph ph-compass"></i>{t.editor}</span>
          <span class="aa-chip">{t.draft}</span>
        </div>
        <div class="aa-multi">
          {t.sites.map((site, i) => (
            <div class="aa-mini">
              <div class="aa-mini-head"><span class="aa-navname">{site}</span><span class="aa-worker">{t.worker(i + 1)}</span></div>
              <div class="aa-group">
                <div class="aa-sec"><i class="ph ph-caret-down"></i>{t.overview}</div>
                <div class="aa-item"><i class="ph ph-presentation"></i>{t.energy}</div>
              </div>
              <div class="aa-group aa-new">
                <div class="aa-sec"><i class="ph ph-caret-down"></i>{t.equip}<span class="aa-tag">NEW</span></div>
                <div class="aa-item"><i class="ph ph-wind"></i>{t.ahu}</div>
                <div class="aa-item"><i class="ph ph-gauge"></i>{t.comp}</div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="aa-panel" aria-hidden="true">
        <div class="aa-bar"><span class="aa-bar-title"><i class="ph ph-sparkle"></i>{t.agent}</span></div>
        <div class="aa-panel-body">
          <div class="aa-ask">{t.askB}</div>
          <div class="aa-parallel">{t.parallel}</div>
          <ol class="aa-steps">
            {t.sites.map((site, i) => <li><i class="ph ph-check-circle"></i><span class="aa-track">{t.worker(i + 1)}</span>{site}<span class="aa-done">{t.done}</span></li>)}
          </ol>
          <div class="aa-approve">
            <div class="aa-approve-q"><i class="ph ph-shield-check"></i>{t.saveQB}</div>
            <ul class="aa-checks">
              {t.sites.map((site) => <li><i class="ph ph-check-square"></i>{site}</li>)}
            </ul>
            <div class="aa-btns"><span class="aa-btn">{t.cancel}</span><span class="aa-btn aa-btn-primary">{t.saveB}</span></div>
          </div>
        </div>
      </div>
    </div>

    <p class="aa-note">{t.note}</p>
  </div>
</section>

<script>
  // 탭 두 개만 바꾼다. 목업 안의 버튼은 동작하지 않는다(aria-hidden 처리한 장식).
  const root = document.getElementById('agent-authoring');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-aa-tab]'));
    const select = (tab: HTMLButtonElement) => {
      for (const t of tabs) {
        const on = t === tab;
        t.classList.toggle('active', on);
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls') || '');
        if (panel) panel.hidden = !on;
      }
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
        select(next);
        next.focus();
      });
    });
  }
</script>

<style>
  .aa-soon { display: inline-flex; align-items: center; gap: 6px; margin-bottom: 16px; padding: 5px 12px; border-radius: 999px; border: 1px solid #D5DCE4; background: #fff; color: #4A5868; font-size: 13px; font-weight: 600; line-height: 1; }
  .aa-soon i { font-size: 14px; }
  .aa-sub { max-width: 460px; }

  .aa-tabs { display: flex; border: 1px solid var(--border); border-bottom: none; border-radius: var(--radius) var(--radius) 0 0; overflow: hidden; background: #fff; }
  .aa-tab { flex: 1; display: flex; align-items: center; justify-content: center; gap: 8px; padding: 18px 8px; border: none; border-right: 1px solid var(--border); background: transparent; font: inherit; font-size: 15px; font-weight: 500; line-height: 1; color: var(--text-muted); cursor: pointer; box-shadow: inset 0 -3px 0 0 transparent; transition: color .15s; }
  .aa-tab:last-child { border-right: none; }
  .aa-tab.active { color: var(--accent); font-weight: 700; box-shadow: inset 0 -3px 0 0 var(--accent); }
  .aa-tab:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }

  .aa-frame { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); border: 1px solid var(--border); border-radius: 0 0 var(--radius) var(--radius); overflow: hidden; background: #fff; }
  .aa-frame[hidden] { display: none; }
  .aa-editor { border-right: 1px solid var(--border); background: #FBFCFD; min-width: 0; }
  .aa-panel { min-width: 0; background: #fff; }
  .aa-bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; height: 52px; padding: 0 20px; border-bottom: 1px solid var(--border); }
  .aa-bar-title { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; color: var(--text); }
  .aa-bar-title i { font-size: 16px; color: var(--text-muted); }
  .aa-chip { padding: 5px 10px; border-radius: 999px; background: rgba(183,121,31,0.1); border: 1px solid rgba(183,121,31,0.3); color: #8a5a12; font-size: 12px; font-weight: 600; line-height: 1; white-space: nowrap; }

  .aa-editor-body { padding: 24px; }
  .aa-navname { font-size: 15px; font-weight: 700; color: var(--text); margin-bottom: 14px; }
  .aa-group { border-radius: 10px; padding: 6px; margin-bottom: 10px; }
  .aa-sec, .aa-item { display: flex; align-items: center; gap: 8px; padding: 8px 10px; font-size: 14px; color: var(--text); border-radius: 8px; }
  .aa-sec { font-weight: 600; }
  .aa-item { padding-left: 30px; color: #4A5868; }
  .aa-sec i, .aa-item i { font-size: 15px; color: var(--text-muted); flex: none; }
  .aa-new { background: rgba(118,166,215,0.1); box-shadow: inset 0 0 0 1px rgba(118,166,215,0.45); }
  .aa-new .aa-sec i, .aa-new .aa-item i { color: var(--accent); }
  .aa-tag { margin-left: auto; padding: 3px 6px; border-radius: 4px; background: var(--accent); color: #fff; font-size: 10px; font-weight: 700; letter-spacing: .3px; line-height: 1; }

  .aa-panel-body { padding: 20px; display: flex; flex-direction: column; gap: 14px; }
  .aa-ask { align-self: flex-end; max-width: 90%; padding: 10px 14px; border-radius: 12px 12px 2px 12px; background: #16202C; color: #fff; font-size: 14px; line-height: 1.5; }
  .aa-parallel { font-size: 13px; color: var(--text-muted); }
  .aa-steps { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .aa-steps li { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: #4A5868; line-height: 1.4; }
  .aa-steps i { color: #3F8F5F; font-size: 16px; flex: none; }
  .aa-track { padding: 2px 6px; border-radius: 4px; background: #EEF2F6; color: #4A5868; font-size: 11.5px; font-weight: 600; white-space: nowrap; }
  .aa-done { margin-left: auto; color: var(--text-muted); font-size: 12px; }

  .aa-approve { margin-top: 4px; padding: 16px; border: 1px solid var(--border); border-radius: 12px; background: #fff; box-shadow: 0 6px 18px rgba(22,32,44,0.06); }
  .aa-approve-q { display: flex; align-items: center; gap: 8px; font-size: 15px; font-weight: 700; color: var(--text); }
  .aa-approve-q i { color: var(--accent); font-size: 18px; }
  .aa-approve p { margin: 8px 0 0; font-size: 13px; line-height: 1.6; color: #4A5868; }
  .aa-checks { list-style: none; margin: 10px 0 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .aa-checks li { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--text); }
  .aa-checks i { color: var(--accent); font-size: 18px; }
  .aa-btns { display: flex; justify-content: flex-end; gap: 8px; margin-top: 14px; }
  .aa-btn { padding: 8px 14px; border-radius: 8px; border: 1px solid var(--border); font-size: 13px; font-weight: 600; color: #4A5868; background: #fff; line-height: 1; }
  .aa-btn-primary { background: #16202C; border-color: #16202C; color: #fff; }

  .aa-multi { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; padding: 20px; }
  .aa-mini { padding: 12px; border: 1px solid var(--border); border-radius: 10px; background: #fff; min-width: 0; }
  .aa-mini-head { display: flex; flex-direction: column; gap: 6px; margin-bottom: 8px; }
  .aa-mini-head .aa-navname { margin: 0; font-size: 14px; }
  .aa-worker { align-self: flex-start; padding: 2px 6px; border-radius: 4px; background: #EEF2F6; color: #4A5868; font-size: 11px; font-weight: 600; }
  .aa-mini .aa-group { padding: 4px; margin-bottom: 6px; }
  .aa-mini .aa-sec, .aa-mini .aa-item { font-size: 12.5px; padding: 6px 6px; }
  .aa-mini .aa-item { padding-left: 22px; }

  .aa-note { margin: 14px 0 0; font-size: 13px; color: var(--text-muted); }

  @media (max-width: 1100px) {
    .aa-multi { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 900px) {
    .aa-frame { grid-template-columns: minmax(0, 1fr); }
    .aa-editor { border-right: none; border-bottom: 1px solid var(--border); }
    .aa-tab { font-size: 14px; padding: 16px 6px; }
  }
</style>
