---
/**
 * 히어로 바탕 모션 (시안).
 *
 * 무대 바탕에 캔버스를 한 장 깔고, 커서를 따라오는 빛을 그린다. 가운데에 번지는
 * 빛무리가 있고 거기서 빛줄기 몇 가닥이 뻗어 천천히 돈다 — 흩어진 것을 한 점이
 * 비추는 몸짓이다.
 *
 * ⚠️ 바탕이 흰 면이라 'lighter'(가산) 합성을 쓰지 않는다. 더하면 흰색으로 빠져
 *    아무것도 안 보인다. 빛은 브랜드색을 옅게 칠해 만든 '물든 자리'다.
 * ⚠️ 커서를 즉시 따라가지 않는다. 감쇠 스프링으로 끌려와 조금 넘어섰다가 멎는다 —
 *    빛에 무게가 있는 것처럼 보이게 하려는 것이다.
 * ⚠️ 그래픽 칸보다 아래 층이다. .hero-stage > * 가 z-index 1 을 주므로 여기만 0 으로
 *    내린다 — 칸과 카피가 그 위에 그대로 얹힌다.
 */
---

<canvas class="hero-fx" aria-hidden="true"></canvas>

<style is:global>
  .hero-fx {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-fx { display: none; }
  }
</style>

<script is:inline>
  (function () {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var hero = document.getElementById('hero');
    var stage = hero && hero.querySelector('.hero-stage');
    var cv = hero && hero.querySelector('.hero-fx');
    if (!hero || !stage || !cv) return;

    var ctx = cv.getContext('2d');
    var w = 0, h = 0, dpr = Math.min(2, window.devicePixelRatio || 1);
    var mx = -9999, my = -9999, px = -9999, py = -9999, vx = 0, vy = 0;
    var inside = false, raf = 0, lit = 0;
    var TAU = Math.PI * 2;

    /* 커서 스프링. PULL 이 작을수록 무겁게 끌려오고, DAMP 가 남는 속도를 깎아 멎게 한다. */
    var C_PULL = 0.055, C_DAMP = 0.84;
    /* 빛무리 반지름. 줄기는 그 바깥까지 뻗는다. */
    var CORE = 290;

    /* 빛줄기. 각자 제 각도·길이·폭·도는 속도를 들고 있어, 다 같이 돌지 않는다.
       가닥 수를 늘리면 바퀴처럼 보인다 — 다섯이 성긴 쪽이 빛에 가깝다. */
    var RAYS = [
      { a: 0.00, len: 2.10, wide: 0.26, spin:  0.00021, alpha: 0.20 },
      { a: 1.32, len: 1.55, wide: 0.17, spin: -0.00014, alpha: 0.16 },
      { a: 2.55, len: 2.45, wide: 0.11, spin:  0.00009, alpha: 0.13 },
      { a: 3.90, len: 1.80, wide: 0.30, spin: -0.00024, alpha: 0.18 },
      { a: 5.20, len: 2.25, wide: 0.14, spin:  0.00016, alpha: 0.15 }
    ];

    function size() {
      var r = stage.getBoundingClientRect();
      w = r.width; h = r.height;
      cv.width = Math.round(w * dpr);
      cv.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    size();
    addEventListener('resize', size, { passive: true });

    hero.addEventListener('pointerenter', function () { inside = true; start(); });
    hero.addEventListener('pointerleave', function () { inside = false; });
    hero.addEventListener('pointermove', function (e) {
      var r = stage.getBoundingClientRect();
      mx = e.clientX - r.left;
      my = e.clientY - r.top;
      /* 처음 들어온 자리에서는 끌려올 거리가 없어야 한다 — 화면 밖에서 날아오지 않게. */
      if (px < -9000) { px = mx; py = my; }
      if (!inside) { inside = true; start(); }
    }, { passive: true });

    /* 빛줄기 한 가닥. 뿌리에서 폭이 좁고 끝으로 갈수록 벌어지는 쐐기를 그리고,
       그 안을 뿌리에서 끝으로 빠지는 그라데이션으로 칠한다. */
    function ray(r, t, fade) {
      var a = r.a + t * r.spin;
      var len = CORE * r.len;
      var ex = px + Math.cos(a) * len, ey = py + Math.sin(a) * len;
      var half = r.wide / 2;
      var g = ctx.createLinearGradient(px, py, ex, ey);
      var al = r.alpha * fade;
      g.addColorStop(0.00, 'rgba(118,166,215,' + (al * 0.95).toFixed(4) + ')');
      g.addColorStop(0.32, 'rgba(118,166,215,' + (al * 0.55).toFixed(4) + ')');
      g.addColorStop(0.70, 'rgba(150,186,225,' + (al * 0.20).toFixed(4) + ')');
      g.addColorStop(1.00, 'rgba(190,212,236,0)');
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.moveTo(px, py);
      /* arc 로 끝을 둥글게 닫는다 — 직선 두 개로 닫으면 끝이 각져 종이처럼 보인다. */
      ctx.arc(px, py, len, a - half, a + half);
      ctx.closePath();
      ctx.fill();
    }

    function paint(t, fade) {
      ctx.clearRect(0, 0, w, h);
      if (fade <= 0.001) return;

      /* 가운데 빛무리. 두 겹으로 둬야 중심이 단단하고 가장자리가 길게 빠진다. */
      var g = ctx.createRadialGradient(px, py, 0, px, py, CORE);
      g.addColorStop(0.00, 'rgba(118,166,215,' + (0.30 * fade).toFixed(4) + ')');
      g.addColorStop(0.28, 'rgba(118,166,215,' + (0.18 * fade).toFixed(4) + ')');
      g.addColorStop(0.62, 'rgba(150,186,225,' + (0.08 * fade).toFixed(4) + ')');
      g.addColorStop(1.00, 'rgba(190,212,236,0)');
      ctx.fillStyle = g;
      ctx.fillRect(px - CORE, py - CORE, CORE * 2, CORE * 2);

      for (var i = 0; i < RAYS.length; i++) ray(RAYS[i], t, fade);

      /* 심지. 아주 작고 진한 점 하나가 있어야 빛이 어디서 나오는지 읽힌다. */
      var c = ctx.createRadialGradient(px, py, 0, px, py, 46);
      c.addColorStop(0.00, 'rgba(63,118,174,' + (0.42 * fade).toFixed(4) + ')');
      c.addColorStop(1.00, 'rgba(63,118,174,0)');
      ctx.fillStyle = c;
      ctx.beginPath();
      ctx.arc(px, py, 46, 0, TAU);
      ctx.fill();
    }

    function frame(t) {
      if (inside) {
        vx += (mx - px) * C_PULL; vy += (my - py) * C_PULL;
        vx *= C_DAMP; vy *= C_DAMP;
        px += vx; py += vy;
      }
      /* 손을 떼면 꺼지듯 잦아든다 — 툭 사라지지 않게. */
      lit += ((inside ? 1 : 0) - lit) * 0.06;
      paint(t, lit);
      if (inside || lit > 0.004) raf = requestAnimationFrame(frame);
      else { raf = 0; lit = 0; ctx.clearRect(0, 0, w, h); }
    }
    function start() { if (!raf) raf = requestAnimationFrame(frame); }
  })();
</script>
