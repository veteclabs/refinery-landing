---
/**
 * 히어로 바탕 모션 (시안).
 *
 * 무대 바탕에 캔버스를 한 장 깔고 마우스를 따라 두 가지를 함께 그린다.
 *   A 등고선 파문 — 지나간 자리에서 타원 링이 퍼지며 옅어진다(받침대 등고선 모티프).
 *   B 점 격자 밀림 — 커서 둘레의 점이 바깥으로 밀리고 조금 커진다(통합 섹션 점 패턴).
 *
 * ⚠️ 그래픽 칸보다 아래 층이다. .hero-stage > * 가 z-index 1 을 주므로 여기만 0 으로
 *    내린다 — 칸과 카피가 그 위에 그대로 얹힌다.
 * ⚠️ 포인터가 히어로 밖으로 나가면 rAF 를 멈춘다. 남은 링이 다 사라진 뒤에 멈춘다.
 */
---

<canvas class="hero-fx" aria-hidden="true"></canvas>

<style is:global>
  .hero-fx {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-fx { display: none; }
  }
</style>

<script is:inline>
  (function () {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var hero = document.getElementById('hero');
    var stage = hero && hero.querySelector('.hero-stage');
    var cv = hero && hero.querySelector('.hero-fx');
    if (!hero || !stage || !cv) return;

    var ctx = cv.getContext('2d');
    var w = 0, h = 0, dpr = Math.min(2, window.devicePixelRatio || 1);
    var mx = -999, my = -999, px = -999, py = -999;
    var inside = false, raf = 0, tick = 0;
    var rings = [];

    function size() {
      var r = stage.getBoundingClientRect();
      w = r.width; h = r.height;
      cv.width = Math.round(w * dpr);
      cv.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    size();
    addEventListener('resize', size, { passive: true });

    hero.addEventListener('pointerenter', function () { inside = true; start(); });
    hero.addEventListener('pointerleave', function () { inside = false; });
    hero.addEventListener('pointermove', function (e) {
      var r = stage.getBoundingClientRect();
      mx = e.clientX - r.left;
      my = e.clientY - r.top;
      if (!inside) { inside = true; start(); }
    }, { passive: true });

    /* B — 점 격자. 커서에서 멀면 회색 점, 가까우면 밀려나며 브랜드색으로 밝아진다. */
    function dots() {
      var step = 26, R = 110;
      for (var y = step / 2; y < h; y += step) {
        for (var x = step / 2; x < w; x += step) {
          var dx = x - px, dy = y - py;
          var d = Math.sqrt(dx * dx + dy * dy);
          var k = inside && d < R ? 1 - d / R : 0;
          var ox = 0, oy = 0;
          if (k) { var u = d || 1; ox = (dx / u) * k * 15; oy = (dy / u) * k * 15; }
          ctx.beginPath();
          ctx.arc(x + ox, y + oy, 1 + k * 1.5, 0, Math.PI * 2);
          ctx.fillStyle = k
            ? 'rgba(118,166,215,' + (0.30 + k * 0.55).toFixed(3) + ')'
            : 'rgba(90,103,118,0.20)';
          ctx.fill();
        }
      }
    }

    /* A — 등고선 파문. 다섯 프레임마다 하나씩 남기고 퍼지며 사라진다. */
    function contour() {
      if (inside && tick % 5 === 0 && rings.length < 30) {
        rings.push({ x: mx, y: my, r: 2, a: 1 });
      }
      ctx.lineWidth = 1;
      for (var i = rings.length - 1; i >= 0; i--) {
        var g = rings[i];
        g.r += 0.9;
        g.a -= 0.009;
        if (g.a <= 0) { rings.splice(i, 1); continue; }
        ctx.beginPath();
        ctx.ellipse(g.x, g.y, g.r, g.r * 0.42, 0, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(118,166,215,' + (g.a * 0.60).toFixed(3) + ')';
        ctx.stroke();
      }
    }

    function frame() {
      tick++;
      px += (mx - px) * 0.12;
      py += (my - py) * 0.12;
      ctx.clearRect(0, 0, w, h);
      dots();
      contour();
      if (inside || rings.length) raf = requestAnimationFrame(frame);
      else { raf = 0; ctx.clearRect(0, 0, w, h); }
    }
    function start() { if (!raf) raf = requestAnimationFrame(frame); }
  })();
</script>
