---
/**
 * 히어로 바탕 모션 (시안).
 *
 * 무대 바탕에 캔버스를 한 장 깔고 점 격자를 그린다. 커서 둘레의 점이 커서 쪽으로
 * 모이며 조금 커지고 브랜드색으로 밝아진다 — '흩어진 현장을 하나로'와 같은 몸짓이다.
 * 점 패턴 자체는 통합 섹션의 모티프를 가져온 것이다.
 *
 * ⚠️ 그래픽 칸보다 아래 층이다. .hero-stage > * 가 z-index 1 을 주므로 여기만 0 으로
 *    내린다 — 칸과 카피가 그 위에 그대로 얹힌다.
 * ⚠️ 포인터가 히어로 밖으로 나가면 rAF 를 멈추고 캔버스를 비운다.
 */
---

<canvas class="hero-fx" aria-hidden="true"></canvas>

<style is:global>
  .hero-fx {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-fx { display: none; }
  }
</style>

<script is:inline>
  (function () {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var hero = document.getElementById('hero');
    var stage = hero && hero.querySelector('.hero-stage');
    var cv = hero && hero.querySelector('.hero-fx');
    if (!hero || !stage || !cv) return;

    var ctx = cv.getContext('2d');
    var w = 0, h = 0, dpr = Math.min(2, window.devicePixelRatio || 1);
    var mx = -999, my = -999, px = -999, py = -999;
    var inside = false, raf = 0;

    function size() {
      var r = stage.getBoundingClientRect();
      w = r.width; h = r.height;
      cv.width = Math.round(w * dpr);
      cv.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    size();
    addEventListener('resize', size, { passive: true });

    hero.addEventListener('pointerenter', function () { inside = true; start(); });
    hero.addEventListener('pointerleave', function () { inside = false; });
    hero.addEventListener('pointermove', function (e) {
      var r = stage.getBoundingClientRect();
      mx = e.clientX - r.left;
      my = e.clientY - r.top;
      if (!inside) { inside = true; start(); }
    }, { passive: true });

    /* 점 격자. 커서 둘레(R)에 드는 점만 그린다. 가까운 점일수록 커서 한 점으로
       바싹 모이고 크고 진해진다 — '흩어진 것이 하나로'를 몸짓으로 옮긴 것이다.
       그 바깥은 아무것도 그리지 않아 바탕은 비어 있다. */
    function dots() {
      /* R 은 점이 반응하는 반지름이다 — 넓힐수록 더 많은 점이 한꺼번에 끌려온다. */
      var step = 16, R = 190;
      /* 격자가 촘촘해 전부 훑으면 한 프레임에 수천 번을 돈다. 커서 둘레만 돈다. */
      var half = step / 2;
      var y0 = Math.max(half, Math.floor((py - R - half) / step) * step + half);
      var x0 = Math.max(half, Math.floor((px - R - half) / step) * step + half);
      var yEnd = Math.min(h, py + R), xEnd = Math.min(w, px + R);
      for (var y = y0; y < yEnd; y += step) {
        for (var x = x0; x < xEnd; x += step) {
          var dx = x - px, dy = y - py;
          var d = Math.sqrt(dx * dx + dy * dy);
          var k = inside && d < R ? 1 - d / R : 0;
          /* 커서가 닿는 점만 그린다 — 바탕 전체에 점을 깔지 않는다. */
          if (!k) continue;
          /* 커서 쪽으로 끌어당긴다. k 를 두 번 곱해 — 거리에 비례한 몫을 다시 k 로
             깎아 — 가까운 점일수록 급격히 붙고 가장자리는 거의 제자리에 남는다.
             0.92 는 다 붙지 않고 아주 조금 틈을 두는 값이다. */
          var pull = k * k * 0.92;
          ctx.beginPath();
          ctx.arc(x - dx * pull, y - dy * pull, 0.7 + k * 0.9, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(118,166,215,' + (0.30 + k * 0.55).toFixed(3) + ')';
          ctx.fill();
        }
      }
    }

    function frame() {
      px += (mx - px) * 0.12;
      py += (my - py) * 0.12;
      ctx.clearRect(0, 0, w, h);
      dots();
      if (inside) raf = requestAnimationFrame(frame);
      else { raf = 0; ctx.clearRect(0, 0, w, h); }
    }
    function start() { if (!raf) raf = requestAnimationFrame(frame); }
  })();
</script>
