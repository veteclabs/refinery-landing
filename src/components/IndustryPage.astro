---
// 산업 상세 페이지 본문. 한국어(/industries/[slug])와 영어(/en/industries/[slug])가
// 이 컴포넌트를 공유한다. 로케일별로 다른 것은 아래 T 사전과 데이터뿐이다.
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import '../styles/industry.css';
import type { IndustryData } from '../data/industries/types';
import ScrollReveal from './ScrollReveal.astro';

interface Props {
  ind: IndustryData;
  lang?: 'ko' | 'en';
}
const { ind, lang = 'ko' } = Astro.props;

const T = {
  ko: {
    crumbAria: '위치', industries: 'Industries', industriesHref: '/#industries',
    contactHref: '/contact',
    problem: '문제', approach: '접근', outcome: '성과',
    number: '번호', useCase: '하는 일',
    // 두 섹션 머리 위 작은 라벨. 차례를 나타내는 두 자리 숫자다.
    // ⚠️ 숫자라 ko/en 이 같다. 사전에 남겨 두는 건 자리를 한곳에서 쥐기 위해서다.
    diagnose: '01', act: '02',
  },
  en: {
    crumbAria: 'Breadcrumb', industries: 'Industries', industriesHref: '/en#industries',
    contactHref: '/en/contact',
    problem: 'Problem', approach: 'Approach', outcome: 'Outcome',
    number: 'No.', useCase: 'Use case',
    diagnose: '01', act: '02',
  },
}[lang];

// 연동 시스템 판 오른쪽 아래 장식. public/industries/systems-corner 에
// corner-rings · perspective-grid · halftone · orbit-hub · silk-ribbon 다섯 종이 있다.
// ⚠️ 고를 때는 이 한 줄만 바꾼다.
const sysDeco = 'perspective-grid';

const canonical = lang === 'en' ? `/en/industries/${ind.slug}` : `/industries/${ind.slug}`;

// 문제 섹션에는 배경 사진을 깔지 않는다. 전에는 모든 산업이 같은 사진
// (/industries/challenges-bg.webp)을 기본값으로 받았는데, 면이 밝아지면서
// 사진 위 어두운 스크림도 같이 빠졌다 — 기본값 없이 데이터가 지정한 경우에만 쓴다.
const challengesBg = ind.challenges.backgroundImage;


// 도입 효과 칸 수. 산업마다 항목 수가 달라(4개 또는 6개) 3칸으로 고정하면
// 4개일 때 마지막 줄에 한 칸만 남는다. 4개는 한 줄에 넷으로 세운다.
/* 도입 효과는 2열이다. 산업마다 항목이 4개 · 6개로 달라도 2 x n 으로 떨어져
   구도가 그대로다 — 칸 수를 세던 분기(4개면 4열, 아니면 3열)는 걷었다. */
const benefitCols = 2;
// ko/en 양쪽이 모두 존재하는 페이지라 hreflang을 출력한다.
const alternates = [
  { lang: 'ko', href: `/industries/${ind.slug}` },
  { lang: 'en', href: `/en/industries/${ind.slug}` },
];
const SITE = 'https://refinery.kr';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Industries', item: `${SITE}${T.industriesHref}` },
    { '@type': 'ListItem', position: 2, name: ind.name, item: `${SITE}${canonical}` },
  ],
};
const lines = (s: string) => s.split('\n');
/* 그림을 카드 세로 가운데에 세우는 값.

   원본 82장은 캔버스 안에서 내용이 늘 같은 자리에 있다(위 24 · 아래 48,
   82장을 알파로 재서 확인). 폭은 모두 464 이고 높이 h 만 184~312 로 다르다.
   그래서 내용의 가운데를 h 하나로 구할 수 있다.

     내용의 가운데 = (24 + (h - 48)) / 2 = (h - 24) / 2
     옮길 양       = -50 * (h - 24) / h      (그림 제 높이에 대한 %)

   아래 페이드는 셈에 넣지 않는다 — 지워진 부분까지 포함한 '그림 상자'를
   가운데에 둔다. 보이는 띠를 기준으로 삼아 봤지만 띠의 끝을 어디로 잡느냐에
   따라 답이 갈려, 다시 뽑을 때마다 재야 하는 값이 된다. 상자는 눈금이 하나라
   흔들리지 않는다.
   ⚠️ 24 · 48 은 원본의 생김새다. 다시 뽑아 내용 여백이 바뀌면 다시 잰다. */
const CONTENT_TOP = 24;
const CONTENT_BOTTOM = 48;
const ucShift = (h: number) =>
  (-50 * (CONTENT_TOP + (h - CONTENT_BOTTOM)) / h).toFixed(2);

---
<BaseLayout title={ind.pageTitle} description={ind.description} canonical={canonical} alternates={alternates} ogImage={ind.seo?.ogImage} ogTitle={ind.seo?.ogTitle} jsonLd={jsonLd}>
  <Nav />
  {/* ind-industry — 산업 페이지에만 거는 갈고리다. ind-page 는 필러 페이지
      (/why-refinery)도 함께 쓰므로 그 쪽을 건드리지 않으려면 따로 필요하다. */}
  <main class:list={['ind', 'ind-page', 'ind-industry', `ind-${ind.slug}`, lang === 'en' && 'ind-en']}>
    {/* ⚠️ 본문 맨 위에 둔다. 스크립트가 <html> 에 rv-on 을 붙이는 시점이 아래
        섹션들의 파싱보다 앞서야 첫 페인트부터 숨은 채로 그려진다. */}
    <ScrollReveal />
    <!-- HERO -->
    <section class={ind.hero.dark || ind.hero.image ? 'ind-hero ind-hero-bg' : 'ind-hero'}>
      {ind.hero.overlay && (
        <img
          class="ind-hero-overlay"
          src={ind.hero.overlay.src}
          alt=""
          aria-hidden="true"
          width={ind.hero.overlay.width}
          height={ind.hero.overlay.height}
          decoding="async"
        />
      )}
      <div class="ind-container">
        {(ind.hero.showBreadcrumb ?? true) && (
          <nav class="ind-crumb" aria-label={T.crumbAria}><a href={T.industriesHref}>{T.industries}</a><span>›</span><span>{ind.name}</span></nav>
        )}
        {/* 태그라인 · 대제목 · 소제목을 가로로 한 줄에 세운다. 버튼은 그 아래다. */}
        <div class="ind-hero-row">
          <p class={ind.hero.icon ? 'ind-eyebrow ind-eyebrow-icon' : 'ind-eyebrow'}>
            {ind.hero.icon && <img class="ind-hero-icon" src={ind.hero.icon} alt="" aria-hidden="true" width="65" height="65" decoding="async" />}
            {/* 태그라인도 개행을 <br>로 낸다 — 'A 및 / B' 두 줄이 기본이다. */}
            <span>{lines(ind.hero.eyebrow).map((l, i) => (<>{i > 0 && <br />}{l}</>))}</span>
          </p>
          <h1>{lines(ind.hero.title).map((l, i) => (<>{i > 0 && <br />}{l}</>))}</h1>
          {ind.hero.lede && <p class="ind-lede">{ind.hero.lede}</p>}
        </div>
        {/* 히어로에는 버튼을 두지 않는다. 전환은 페이지 맨 아래 CTA 섹션(ind-cta)이
            받는다 — 거기에 같은 /contact 링크가 큰 버튼으로 있다. */}
      </div>
      {/* 사진은 글 뒤가 아니라 글 아래에 선다. 글이 사진 위에 얹히지 않으므로
          스크림도 없다 — 사진은 제 색 그대로 보인다. */}
      {ind.hero.image && (
        <div class="ind-hero-figure">
          <img
            class="ind-hero-figure-img"
            src={ind.hero.image.src}
            alt={ind.hero.image.alt}
            aria-hidden={ind.hero.image.alt ? undefined : 'true'}
            width={ind.hero.image.width}
            height={ind.hero.image.height}
            decoding="async"
            fetchpriority="high"
            style={ind.hero.imagePosition ? `object-position: ${ind.hero.imagePosition};` : undefined}
          />
        </div>
      )}
    </section>
    {ind.hero.image && (
      <script is:inline>
        {/* 히어로 사진 넓히기 — 스크롤을 내린 만큼 --grow 를 0 → 1 로 올린다.
            ⚠️ 쓰는 값은 scrollY 다. 사진의 화면 안 위치로 재면 첫 화면에서
               이미 절반쯤 자란 상태로 뜬다 — '기본 모습에서 스크롤할 때'가 아니다.
            ⚠️ 360px 을 다 내리면 꽉 찬다. 내비(70px)가 사진 윗변에 닿을 즈음이다.
            ⚠️ 동작 줄이기를 켠 사람에게는 손대지 않는다 — 기본 모습 그대로다. */}
        (function () {
          var fig = document.querySelector('.ind-hero-figure');
          if (!fig) return;
          if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          var D = 360, last = -1, ticking = false;
          function upd() {
            var p = Math.min(1, Math.max(0, (window.scrollY || window.pageYOffset) / D));
            p = Math.round(p * 1000) / 1000;
            if (p === last) return;
            last = p;
            fig.style.setProperty('--grow', p);
          }
          function onScroll() {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(function () { ticking = false; upd(); });
          }
          addEventListener('scroll', onScroll, { passive: true });
          addEventListener('resize', onScroll, { passive: true });
          upd();
        })();
      </script>
    )}

    <!-- CHALLENGES -->
    <section class:list={['ind-section', 'ind-soft', 'ind-challenges', challengesBg && 'ind-section-bg', ind.challenges.dark && 'ind-soft-dark']}>
      {challengesBg && (
        <img
          class="ind-section-bg-img"
          src={challengesBg}
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
        />
      )}
      <div class="ind-container">
        <header class={ind.challenges.dark ? 'ind-head ind-head-light' : 'ind-head'}>
          <span class="ind-sec-label">{T.diagnose}</span>
          {/* 제목은 데이터의 개행을 <br>로 낸다. */}
          <h2>{lines(ind.challenges.title).map((l, i) => (<>{i > 0 && <br />}{l}</>))}</h2>
          {/* ⚠️ 소제목은 화면에 내지 않는다. 라벨 줄이 같은 말을 더 구체적으로
              하고 있어 한 번 더 쓸 자리가 아니다. 데이터(challenges.subtitle)는
              열네 파일에 그대로 두었다 — 되살릴 때 다시 쓰면 된다. */}
        </header>
        {/* 과제를 짧은 라벨로 묶어 두 줄로 흘린다. 윗줄은 오른쪽, 아랫줄은
            왼쪽으로 간다(윗줄이 같은 애니메이션을 reverse 로 되돌린 쪽이다).
            ⚠️ 문구는 challenges.labels 열두 개를 앞 절반 · 뒤 절반으로 나눠
               쓴다. 한 벌(여섯 개)이 줄 폭보다 넓어야 흐르는 동안 같은 말이
               두 번 보이지 않는다 — 라벨을 열두 개로 둔 까닭이다.
            ⚠️ 같은 벌을 세 번 깐다. 트랙을 제 폭의 1/3(= 한 벌)만큼 밀면 끝
               프레임이 첫 프레임과 같은 그림이라 이음매가 없다.
            ⚠️ 낭독기에는 각 줄의 첫 벌만 남긴다 — 나머지는 같은 말의 사본이다.
            labels 가 없으면 items 의 제목을 그대로 쓴다. */}
        {(() => {
          const labels = ind.challenges.labels ?? ind.challenges.items.map((c) => c.title);
          const half = Math.ceil(labels.length / 2);
          return (
            <div class="ind-chal-rows">
              {[0, 1].map((row) => (
                <div class="ind-chal-marquee">
                  <div class:list={['ind-chal-track', row === 0 && 'ind-chal-track-back']}>
                    {[0, 1, 2].map((dup) => (
                      <ul class="ind-chal-set" aria-hidden={dup > 0 ? 'true' : undefined}>
                        {(row === 0 ? labels.slice(0, half) : labels.slice(half)).map((t) => (
                          <li class="ind-chal-pill">{t}</li>
                        ))}
                      </ul>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          );
        })()}
      </div>
    </section>

    <!-- USE CASES -->
    <section class="ind-section ind-usecases">
      <div class="ind-container">
        {/* table 레이아웃은 제목 · 소제목을 왼쪽 고정 칸(.ind-uc-aside)에서 낸다 —
            같은 문장을 머리와 칸에 두 번 두지 않는다. */}
        {ind.useCases.layout !== 'table' && (
          <header class="ind-head">
            <h2>{ind.useCases.title}</h2>
            {ind.useCases.subtitle && <p>{ind.useCases.subtitle}</p>}
          </header>
        )}
        {ind.useCases.layout === 'table' ? (
          /* 표다 — 항목이 줄, 문제 · 접근 · 성과가 열이다. 진짜 <table>을 쓴다:
             내용이 실제로 2차원이라 화면 낭독기도 "3행 접근" 식으로 짚어 준다.
             ⚠️ 제목 칸은 <th scope="row">다. 그래야 각 줄의 값이 어느 항목 것인지
                낭독기가 잇는다. */
          <div class="ind-uc-shell">
          {/* 왼쪽 칸 — 스크롤해도 제자리에 남는다(sticky). 오른쪽 목록만 흐른다. */}
          <div class="ind-uc-aside">
            <span class="ind-sec-label">{T.act}</span>
            {/* 제목은 데이터의 개행을 <br>로 낸다 — 과제 섹션 제목과 같은 방식이다. */}
            <h2>{lines(ind.useCases.title).map((l, i) => (<>{i > 0 && <br />}{l}</>))}</h2>
            {/* ⚠️ 소제목은 화면에 내지 않는다. 제목이 이미 'Refinery가 문제를 푸는
                방법'이라 같은 말을 한 번 더 할 자리가 아니다. 데이터
                (useCases.subtitle)는 열네 파일에 그대로 두었다. */}
          </div>
          <ol class="ind-uc-list">
            {ind.useCases.items.map((u, i) => (
              <li class="ind-uc-item" id={`uc-${ind.slug}-${i + 1}`}>
                {/* 번호는 제 줄(1줄 1칸)에 둔다. 그래야 글과 그림이 둘째 줄에서
                    나란히 서고 그림 윗변이 제목 윗변과 맞는다 — 여백을 눈대중으로
                    맞추면 번호의 글자 크기가 바뀔 때마다 어긋난다. */}
                <div class="ind-uc-text">
                  {/* 제목의 개행은 lines() 가 <br> 로 낸다 — 섹션 제목과 같은 방식이다.
                      데이터에 \n 이 없는 제목은 그대로 한 덩어리로 흐른다. */}
                  <h3>{lines(u.title).map((l, i) => (<>{i > 0 && <br />}{l}</>))}</h3>
                  {/* 표가 아니라 한 덩어리 안의 정의 목록이다 — 라벨 한 칸, 문장 한 칸.
                      세 문장은 데이터 그대로다. */}
                  <dl class="ind-uc-dl">
                    <div><dt>{T.problem}</dt><dd>{u.problem}</dd></div>
                    <div><dt>{T.approach}</dt><dd>{u.approach}</dd></div>
                    <div><dt>{T.outcome}</dt><dd class="ind-uc-out">{u.outcome}</dd></div>
                  </dl>
                </div>
                {u.image ? (
                  /* 카드 면(.ind-uc-card)과 그림(.ind-uc-img)을 나눠 둔다 — 그림만
                     아래로 사라지게 하려면 마스크가 그림에만 걸려야 하고, 마스크는
                     요소 전체에 걸리므로 면을 같은 요소에 둘 수 없다.
                     alt 는 비운다 — 바로 옆이 같은 항목의 이름이라 낭독기가 같은
                     말을 두 번 읽을 까닭이 없다. */
                  <div class="ind-uc-card">
                    <img
                      class="ind-uc-img"
                      src={u.image.src}
                      alt=""
                      width={u.image.width}
                      height={u.image.height}
                      style={`--uc-shift:${ucShift(u.image.height)}%`}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                ) : (
                  /* 그림이 아직 없는 산업은 빈 카드를 그 자리에 둔다 — 상자 크기 ·
                     둥글기 · 격자 자리를 카드와 똑같이 쓰려고 .ind-uc-card 를 함께
                     단다(격자 분기도 :has(.ind-uc-card) 로 보므로 두 칸이 유지된다).
                     내용이 없으니 낭독기에서는 숨긴다. */
                  <div class="ind-uc-card ind-uc-card-ph" aria-hidden="true"></div>
                )}
              </li>
            ))}
          </ol>
          </div>
        ) : (
          <div class="ind-usecases">
            {ind.useCases.items.map((u, i) => (
              <article class="ind-usecase">
                <div class="ind-usecase-num">{String(i + 1).padStart(2, '0')}</div>
                <div class="ind-usecase-body">
                  <h3>{u.title}</h3>
                  <dl>
                    {/* 한국어 이름은 두 글자라 낱자로 쪼개 flex gap으로 벌린다
                        (letter-spacing은 마지막 글자 뒤에도 여백을 남겨 가운데 정렬이
                        어긋난다). 영어는 Problem · Approach · Outcome처럼 길어
                        낱자를 벌리면 알약을 넘치므로 그대로 둔다. */}
                    <div><dt>{lang === 'ko' ? [...T.problem].map((c) => <span>{c}</span>) : T.problem}</dt><dd>{u.problem}</dd></div>
                    <div><dt>{lang === 'ko' ? [...T.approach].map((c) => <span>{c}</span>) : T.approach}</dt><dd>{u.approach}</dd></div>
                    <div><dt>{lang === 'ko' ? [...T.outcome].map((c) => <span>{c}</span>) : T.outcome}</dt><dd class="ind-outcome">{u.outcome}</dd></div>
                  </dl>
                </div>
              </article>
            ))}
          </div>
        )}
      </div>
    </section>

    <!-- ARCHITECTURE -->
    <section class="ind-section ind-arch">
      <div class="ind-container">
        {/* ⚠️ ind-head-light 를 쓰지 않는다 — 그 규칙은 어두운 면용(#EFF2F5)이고
            과제 섹션과 함께 쓰므로, 여기만 밝게 하려면 기본 머리글을 쓴다. */}
        <header class="ind-head">
          <h2>{ind.architecture.title}</h2>
          {/* ⚠️ 소제목은 화면에 내지 않는다 — 유즈케이스 · 도입 효과와 같은
              처리다. 데이터(architecture.subtitle)는 열네 파일에 그대로 두었다. */}
        </header>
        {/* 네 단계가 차례로 뜬다. 뜨는 간격은 ScrollReveal 기본(60ms)보다 한참
            느리게 — 한 칸이 거의 다 뜬 뒤에 다음 칸이 시작하도록 300ms 로 둔다
            (뜨는 데 걸리는 시간 자체는 .55s 다). 현장 0 → 연동 300 →
            Refinery 600 → 활용 900ms 에 시작해 끝까지 1.45초다. */}
        <div class="ind-flow" data-rv-step="300">
          {ind.architecture.steps.map((s, i) => (
            <>
              {i > 0 && (
              <div class="ind-flow-arrow" aria-hidden="true"><i class="ph ph-arrow-right"></i></div>
            )}
              <div class:list={['ind-flow-step', s.highlight && 'is-on']}>
                {/* 이름만 둔다. 카드 안에 일러스트가 이미 그 단계가 무엇인지
                    말하고 있어 작은 배지 아이콘은 같은 말을 두 번 하는 셈이다.
                    순서는 카드가 놓인 차례와 사이의 화살표가 맡는다. */}
                <div class="ind-flow-head">
                  <span class="ind-flow-label">{s.label}</span>
                </div>
                {/* 차례는 제목 · 그림 · 내용이다. 그림이 가운데에 서고 그 위아래로
                    글이 붙는다 — 보이는 차례와 마크업 차례가 같다.
                    ⚠️ RfIcon(인라인 SVG) 이 아니라 그림 파일이다. 3D 아이소메트릭
                       아이콘이라 SVG 로 그릴 수 있는 것이 아니다 — public/icons/flow
                       아래 512px webp 와 1024px @2x 를 둔다. */}
                {s.icon && (
                  <img
                    class="ind-flow-img"
                    src={`/icons/flow/${s.icon}.webp`}
                    srcset={`/icons/flow/${s.icon}.webp 1x, /icons/flow/${s.icon}@2x.webp 2x`}
                    width="200" height="200"
                    alt="" aria-hidden="true" loading="lazy" decoding="async"
                  />
                )}
              {/* 본문은 가운뎃점으로 끊어 상자 하나씩 담는다 — 플랫폼 개요
                  '한 플랫폼 안에 담긴 기능' 카드의 목록과 같은 구성이다. */}
              <ul class="ind-flow-detail">
                {s.detail.split(' ⁠· ').map((d) => <li>{d}</li>)}
              </ul>
              </div>
            </>
          ))}
        </div>
        {ind.architecture.note && <p class="ind-flow-note" set:html={ind.architecture.note} />}

        {/* 연동 시스템 — 흐름 2단계(연동)가 실제로 무엇과 연결되는지다.
            따로 섹션을 두는 대신 흐름 바로 아래에 붙인다. */}
        <div class="ind-systems-block">
          {/* 제목과 소제목은 한 줄에 둔다 — 섹션 머리(.ind-head)와 같은 배치로,
              제목이 왼쪽 · 소제목이 오른쪽 끝이다. */}
          <div class="ind-systems-head">
            <h3>{ind.integrations.title}</h3>
            {ind.integrations.subtitle && <p class="ind-systems-sub" set:html={ind.integrations.subtitle} />}
          </div>
          <div class="ind-systems">
            {ind.integrations.systems.map((s) => <span class="ind-system">{s}</span>)}
          </div>
          {/* 오른쪽 아래 장식 — 배경이 투명한 움직이는 그림이다.
              ⚠️ webm 하나만 둔다(240KB). 같은 폴더의 mp4 는 배경이 검어 먹색
                 판 위에서 네모가 드러나므로 쓰지 않고, 애니메이션 WebP 는
                 1.19MB 이라 산업 페이지 일곱 장에 얹기에는 무겁다.
              ⚠️ Safari 는 알파 있는 webm 을 못 읽는다 — 거기서는 poster(정지
                 webp, 45KB)가 그대로 남는다. 모션이 없을 뿐 그림은 같다.
                 Safari 에서도 움직이게 하려면 -anim.webp 를 함께 두고
                 <picture> 로 바꾼다(그만큼 무거워진다).
              ⚠️ 움직임을 줄여 달라고 한 화면에서는 아래 스크립트가 세운다 —
                 autoplay 는 CSS 로 끌 수 없다. */}
          <video class="ind-sys-deco" autoplay muted loop playsinline
                 preload="metadata" aria-hidden="true"
                 poster={`/industries/systems-corner/systems-${sysDeco}.webp`}>
            <source src={`/industries/systems-corner/systems-${sysDeco}.webm`} type="video/webm" />
          </video>
        </div>
        {/* 노트는 카드 밖, 카드 아래에 둔다 — 흐름 노트와 같은 자리다. */}
        {ind.integrations.note && <p class="ind-systems-note" set:html={ind.integrations.note} />}
      </div>
    </section>

    <!-- BENEFITS -->
    {/* ⚠️ ind-soft(면 #F6F8FA)를 걷었다 — 위 솔루션 구조가 흰 면이 되면서 두
        섹션이 면색으로 갈리지 않아, 아래 CTA 까지 흰 면 한 판으로 이어진다.
        ⚠️ 구도는 유즈케이스 섹션(.ind-uc-shell)과 같다 — 왼쪽 칸에 제목 · 소제목,
           오른쪽에 목록. 다만 왼쪽 칸을 붙여 두지는(sticky) 않는다. */}
    <section class="ind-section ind-benefits">
      <div class="ind-container">
        <div class="ind-ben-shell">
          <div class="ind-ben-aside">
            <h2>{ind.benefits.title}</h2>
            {/* ⚠️ 소제목은 화면에 내지 않는다 — 유즈케이스 섹션과 같은 처리다.
                데이터(benefits.subtitle)는 열네 파일에 그대로 두었다. */}
          </div>
        <div class:list={['ind-grid', `ind-grid-${benefitCols}`]}>
          {ind.benefits.items.map((b) => (
            <div class="ind-card">
              {b.icon && <span class="ind-card-icon" aria-hidden="true"><i class={`ph ${b.icon}`}></i></span>}
              <h3>{b.title}</h3>
              {/* 개행은 <br>로 낸다. 좁은 폭에서는 CSS가 br을 숨겨 단락을 푼다. */}
              <p>{lines(b.description).map((l, i) => (<>{i > 0 && <br />}{l}</>))}</p>
            </div>
          ))}
        </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class={ind.cta.backgroundImage ? 'ind-cta ind-cta-bg' : 'ind-cta'}>
      {ind.cta.backgroundImage && (
        <img
          class="ind-cta-bg-img"
          src={ind.cta.backgroundImage}
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
        />
      )}
      <div class="ind-container">
        <h2>{lines(ind.cta.title).map((l, i) => (<>{i > 0 && <br />}{l}</>))}</h2>
        <a href={T.contactHref} class="ind-btn-primary ind-btn-lg">{ind.cta.buttonLabel}</a>
      </div>
    </section>
  </main>
  <script is:inline>
    {/* 끝없이 도는 애니메이션은 화면에 있을 때만 돌린다.
        지금 둘이다 — 과제 라벨 줄(.ind-chal-track, transform)과 솔루션 구조의
        흐름 띠(.ind-flow, background-position).
        ⚠️ 산업 페이지는 5,000px 가 넘는다. 그냥 두면 아래 섹션을 읽는 내내
           보이지도 않는 것이 돈다. 특히 .ind-flow 는 background-position 을
           움직여 합성기로 넘어가지 않고 프레임마다 다시 그린다.
        ⚠️ 못 믿을 때는 '도는 쪽' 으로 둔다 — IntersectionObserver 가 없거나
           콜백을 놓치면 지금처럼 계속 돌 뿐, 멈춘 채 굳지 않는다.
        ⚠️ animation-play-state 는 멈춘 프레임에서 그대로 이어진다. 다시
           보일 때 튀지 않는다.
        ⚠️ 각 요소를 제가 관찰한다. 섹션을 관찰하면 선택자 짝을 따로 들고
           있어야 하는데, 끝없이 도는 것이 늘어날 때마다 두 곳을 고치게 된다. */}
    /* 유즈케이스 왼쪽 칸(번호 + 대제목)은 붙어서 따라오다가, 마지막 사례가
       화면에 들어오면 사라진다.
       ⚠️ IntersectionObserver 를 쓰지 않는다. 빠르게 스크롤하면 상태 변화가
          한 프레임에 합쳐져 콜백을 놓치는 일이 있어, 프레임마다 제 위치를
          직접 재는 쪽으로 둔다(ScrollReveal 과 같은 까닭이다).
       ⚠️ 좁은 폭(1200px 이하)에서는 칸이 static 이라 따라오지 않는다 —
          그때는 지우지 않는다. 미디어 쿼리를 또 적지 않고 계산된 position 을
          그대로 본다. */
    (function () {
      var aside = document.querySelector('.ind-uc-aside');
      var shell = aside && aside.closest('.ind-uc-shell');
      if (!aside || !shell) return;
      var ticking = false;
      function upd() {
        if (getComputedStyle(aside).position !== 'sticky') {
          aside.classList.remove('is-faded');
          return;
        }
        /* 통(.ind-uc-shell)이 끝나 칸이 붙기를 그만두는 자리에서 지운다 —
           더 늦출 수 없는 지점이다. 그 뒤로는 칸이 어차피 내용과 함께 위로
           밀려 올라가므로, 지우지 않으면 제목이 화면 밖으로 흘러 나간다.
           ⚠️ 세 번 늦춘 끝이다. 마지막 사례의 윗변이 화면 아래 90% 선을 넘는
              때 -> 아랫변이 화면 안으로 들어오는 때 -> 아랫변이 화면 80% 선을
              넘는 때 -> 지금.
           ⚠️ 8px 은 붙기를 그만두기 직전에 지워지기 시작하도록 둔 여유다.
              0 으로 두면 칸이 이미 밀려 올라가기 시작한 뒤에 사라진다. */
        var a = aside.getBoundingClientRect();
        var sh = shell.getBoundingClientRect();
        var done = sh.bottom <= a.bottom + 8;
        aside.classList.toggle('is-faded', done);
      }
      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(function () { ticking = false; upd(); });
      }
      addEventListener('scroll', onScroll, { passive: true });
      addEventListener('resize', onScroll, { passive: true });
      upd();
    })();

    /* 움직임을 줄여 달라고 한 화면에서는 장식 영상을 세운다 — poster 만 남는다. */
    if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.querySelectorAll('video.ind-sys-deco').forEach(function (v) {
        v.removeAttribute('autoplay');
        v.pause();
      });
    }
    (function () {
      if (!('IntersectionObserver' in window)) return;
      var nodes = document.querySelectorAll('.ind-chal-track, .ind-flow');
      if (!nodes.length) return;
      var io = new IntersectionObserver(function (es) {
        for (var i = 0; i < es.length; i++) {
          var el = es[i].target, on = es[i].isIntersecting;
          /* .ind-flow 는 애니메이션이 ::after 에 있다 — 인라인 style 로는
             닿지 않아 클래스로 끈다. 나머지는 제 자신이 돈다. */
          if (el.classList.contains('ind-flow')) el.classList.toggle('is-paused', !on);
          else el.style.animationPlayState = on ? '' : 'paused';
        }
      }, { rootMargin: '200px' });
      for (var i = 0; i < nodes.length; i++) io.observe(nodes[i]);
    })();
  </script>
  <Footer />
</BaseLayout>
