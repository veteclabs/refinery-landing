---
// 법적 고지 문서용 플레이스홀더.
// src/data/legal.ts의 값이 비어 있으면 노란 칩으로 [항목명]을 보여준다.
// 게시 전에 노란 칩이 하나도 남지 않았는지 확인할 것.
// html — 값에 줄바꿈 자리(<wbr>)나 묶음(<span class="legal-keep">)을 담을 때만 켠다. 값은 legal.ts의 고정 문자열이다.
interface Props {
  value?: string;
  label: string;
  html?: boolean;
}
const { value, label, html = false } = Astro.props;
---
{value ? (html ? <Fragment set:html={value} /> : value) : <span class="legal-ph">[{label}]</span>}
