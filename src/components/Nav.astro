---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { navMenu, navUi, legalLinks } from '../i18n/nav';
import { navIcons } from './navIcons';
import '../styles/nav-footer.css';

// 메가메뉴 IA는 로케일별로 src/i18n/nav.ts에 있다. 라이브 항목은 실제 페이지로, 예정 항목은 badge 표시.
const lang = (Astro.currentLocale === 'en' ? 'en' : 'ko') as 'ko' | 'en';
const menu = navMenu[lang];
const ui = navUi[lang];
const legal = legalLinks[lang];
const home = lang === 'en' ? '/en' : '/';
---
<nav class="mm-nav">
  <div class="nav-inner">
    <div class="nav-left">
      <a href={home} class="nav-logo" aria-label={ui.home}><img src="/logo_Refinery_symbol-text.svg" alt="Refinery"></a>
    </div>
      <ul class="mm-menu">
        {menu.map((m) => (
          <li class={m.groups ? 'mm-item has-panel' : 'mm-item'}>
            {/* 패널이 있는 항목은 링크가 아니라 button이다 — 누르면 페이지가 넘어가는 대신
                제자리에 머문다. button이라 탭으로도 잡히고, :focus-within으로 패널이 열린다. */}
            {m.groups
              ? <button type="button" class="mm-top" aria-haspopup="true">{m.label}<i class="ph ph-caret-down mm-caret" aria-hidden="true"></i></button>
              : <a href={m.href} class="mm-top">{m.label}</a>}
            {m.groups && (
              <div class="mm-panel">
                <div class="mm-panel-inner">
                  {/* 카드로 펼지 목록으로 낼지는 항목에 아이콘이 있는지로 정한다.
                      리소스·회사는 항목이 4~5개뿐이라 한 열로 두면 넓은 띠에서 오른쪽이 크게 빈다.
                      (제목 유무와는 무관하다 — 세 메뉴 모두 묶음 제목을 갖는다.) */}
                  {m.groups.map((g) => (
                    !g.items.some((it) => it.icon) ? (
                      <div class={g.items.length >= 6 ? 'mm-col mm-col--split' : 'mm-col'}>
                        <div class="mm-col-title">{g.title}</div>
                        <ul>
                          {g.items.map((it) => (
                            <li>
                              {it.href
                                ? <a href={it.href}>{it.label}</a>
                                : <span class="mm-soon">{it.label}<span class="mm-badge">{it.badge}</span></span>}
                            </li>
                          ))}
                        </ul>
                      </div>
                    ) : (
                      <div class="mm-cardgroup">
                        {g.title && <div class="mm-col-title">{g.title}</div>}
                        <div class="mm-cards">
                        {g.items.map((it) => (
                          it.href
                            ? <a class="mm-card" href={it.href}>
                                {it.icon && navIcons[it.icon] && (
                                  <span class="mm-card-ico" aria-hidden="true">
                                    <svg viewBox={navIcons[it.icon].vb} width="24" height="24" fill="currentColor" focusable="false"><path d={navIcons[it.icon].d}/></svg>
                                  </span>
                                )}
                                <span class="mm-card-text">
                                  <span class="mm-card-head"><span class="mm-card-label">{it.label}</span></span>
                                  {it.desc && <span class="mm-card-desc">{it.desc}</span>}
                                </span>
                              </a>
                            : <span class="mm-card is-soon">
                                {it.icon && navIcons[it.icon] && (
                                  <span class="mm-card-ico" aria-hidden="true">
                                    <svg viewBox={navIcons[it.icon].vb} width="24" height="24" fill="currentColor" focusable="false"><path d={navIcons[it.icon].d}/></svg>
                                  </span>
                                )}
                                <span class="mm-card-text">
                                  <span class="mm-card-head"><span class="mm-card-label">{it.label}</span><span class="mm-badge">{it.badge}</span></span>
                                  {it.desc && <span class="mm-card-desc">{it.desc}</span>}
                                </span>
                              </span>
                        ))}
                        </div>
                      </div>
                    )
                  ))}
                </div>
                {/* 패널 아래 약관 띠 — 푸터와 같은 목록(legalLinks)을 한 줄로 편다. */}
                <div class="mm-panel-foot">
                  <ul>
                    {legal.map((it) => (
                      <li>
                        {it.href
                          ? <a href={it.href}>{it.label}</a>
                          : <button type="button" data-cookie-settings onclick="if(window.openCookieSettings){openCookieSettings();}">{it.label}</button>}
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            )}
          </li>
        ))}
      </ul>
    <div class="nav-actions">
      <LanguageSwitcher />
      <a href={ui.ctaHref} class="btn-primary">{ui.cta}</a>
      <button type="button" class="nav-hamburger" id="navHamburgerBtn" aria-label={ui.openMenu} aria-expanded="false">
        {/* ⚠️ 글꼴 아이콘(ph-list)이 아니라 인라인 SVG 다. 글리프는 em 상자 안에서
            엔진마다 다른 자리에 놓인다 — Chrome 은 KO/EN 보다 1px 아래, iPhone
            Safari 는 0.3px 위였다. 한 보정값으로 둘을 맞출 수 없어 모양을 직접
            그린다. 치수는 Phosphor regular 의 list 와 같다(256 격자 · 획 16 ·
            둥근 끝 · y 64/128/192 · x 40→216). */}
        <svg class="nav-burger-ic" viewBox="0 0 256 256" width="22" height="22" aria-hidden="true"
             fill="none" stroke="currentColor" stroke-width="16" stroke-linecap="round">
          <line x1="40" y1="64" x2="216" y2="64" />
          <line x1="40" y1="128" x2="216" y2="128" />
          <line x1="40" y1="192" x2="216" y2="192" />
        </svg>
      </button>
    </div>
  </div>

  <div class="mobile-nav-panel mm-mobile" id="mobileNavPanel">
    {menu.map((m) => (
      m.groups ? (
        <details class="mm-mobile-group">
          <summary class="mm-mobile-top">{m.label}</summary>
          <div class:list={['mm-mobile-sub', m.groups.length > 1 && 'is-split']}>
            {m.groups.map((g) => (
              <div class="mm-mobile-col">
                {m.groups!.length > 1 && g.title && <p class="mm-mobile-coltitle">{g.title}</p>}
                {g.items.map((it) => (
                  it.href
                    ? <a href={it.href}>{it.label}</a>
                    : <span class="mm-soon">{it.label}<span class="mm-badge">{it.badge}</span></span>
                ))}
              </div>
            ))}
          </div>
        </details>
      ) : (
        <div class="mm-mobile-group">
          <a href={m.href} class="mm-mobile-top">{m.label}</a>
        </div>
      )
    ))}
    <a href={ui.ctaHref} class="mobile-nav-cta">{ui.cta}</a>
  </div>
</nav>

{/* 메뉴가 열렸을 때 헤더 아래를 덮는 막. .mm-nav의 backdrop-filter가
    fixed의 기준을 헤더 상자로 바꾸므로 형제로 둔다. */}
<div class="mm-scrim" aria-hidden="true"></div>

<script is:inline>
  (function () {
    var btn = document.getElementById('navHamburgerBtn');
    var panel = document.getElementById('mobileNavPanel');
    if (!btn || !panel) return;
    /* 열고 닫을 때 바꿔 끼우는 두 모양. 마크업의 것과 같은 치수다(Phosphor
       regular 의 list · x — 256 격자 · 획 16 · 둥근 끝). */
    var SVG = '<svg class="nav-burger-ic" viewBox="0 0 256 256" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="16" stroke-linecap="round">';
    var ICON_LIST = SVG + '<line x1="40" y1="64" x2="216" y2="64"/><line x1="40" y1="128" x2="216" y2="128"/><line x1="40" y1="192" x2="216" y2="192"/></svg>';
    var ICON_X = SVG + '<line x1="200" y1="56" x2="56" y2="200"/><line x1="200" y1="200" x2="56" y2="56"/></svg>';
    function close() { panel.classList.remove('open'); btn.setAttribute('aria-expanded', 'false'); btn.innerHTML = ICON_LIST; }
    function open() { panel.classList.add('open'); btn.setAttribute('aria-expanded', 'true'); btn.innerHTML = ICON_X; }
    btn.addEventListener('click', function () { panel.classList.contains('open') ? close() : open(); });
    panel.querySelectorAll('a').forEach(function (a) { a.addEventListener('click', close); });
    window.addEventListener('resize', function () { if (window.innerWidth > 980) close(); });
  })();

  /* 메가메뉴가 열린 채로 스크롤하면 닫는다.
     패널은 CSS :hover로 열리므로 JS가 hover를 풀 수 없다 — 헤더에 클래스를 걸어
     눌러 두고, 마우스가 헤더를 벗어나면(또는 헤더 밖에서 움직이면) 다시 푼다. */
  (function () {
    var nav = document.querySelector('.mm-nav');
    if (!nav) return;
    /* 마우스로 누른 상위 항목에 포커스가 남으면 :focus-within 때문에 그 패널이 계속 열려 있고,
       다른 항목에 마우스를 올리면 패널 둘이 같은 자리에 겹친다.
       mousedown을 막아 마우스로는 포커스를 주지 않는다 — 탭 이동은 그대로 동작한다. */
    nav.addEventListener('mousedown', function (e) {
      if (e.target.closest && e.target.closest('button.mm-top')) e.preventDefault();
    });
    function shut() { nav.classList.add('is-shut'); }
    function release() { nav.classList.remove('is-shut'); }
    window.addEventListener('scroll', shut, { passive: true });
    nav.addEventListener('mouseleave', release);
    document.addEventListener('mousemove', function (e) {
      if (nav.classList.contains('is-shut') && !nav.contains(e.target)) release();
    }, { passive: true });
  })();

  /* 아래로 내려가는 동안 헤더를 걷고, 위로 올리면 돌려놓는다.
     메가메뉴는 위의 is-shut 이 스크롤과 함께 이미 닫으므로 따로 보지 않아도 된다. */
  /* 맨 위인지 아닌지만 본다 — 헤더 면이 흰색이냐 반투명이냐가 여기서 갈린다.
     ⚠️ 아래의 걷기 스크립트와 따로 둔다. 그쪽은 움직임을 줄이는 설정에서 통째로
        빠지는데, 면 색은 그 설정과 상관이 없다. */
  (function () {
    var nav = document.querySelector('.mm-nav');
    if (!nav) return;
    var t = false;
    function mark() {
      t = false;
      nav.classList.toggle('is-float', (window.scrollY || 0) > 4);
    }
    mark();
    window.addEventListener('scroll', function () {
      if (t) return;
      t = true;
      requestAnimationFrame(mark);
    }, { passive: true });
  })();

  (function () {
    if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var nav = document.querySelector('.mm-nav');
    if (!nav) return;
    var panel = document.getElementById('mobileNavPanel');
    var last = window.scrollY || 0, ticking = false;

    function step() {
      ticking = false;
      var y = window.scrollY || 0;
      if (y < 0) y = 0;                       // 위쪽 고무줄 구간에서 방향이 뒤집힌다
      var dy = y - last;
      if (Math.abs(dy) < 6) return;           // 손떨림 정도로는 움직이지 않는다
      last = y;
      // 모바일 메뉴가 열려 있거나 헤더 안에 포커스가 있으면 걷지 않는다.
      if ((panel && panel.classList.contains('open')) || nav.contains(document.activeElement)) {
        nav.classList.remove('is-away');
        return;
      }
      /* [data-nav-keep] 을 단 구역이 아직 화면에 걸쳐 있으면 헤더를 붙잡는다.
         홈 히어로가 그 구역이다 — 장면이 넘어가는 내내 헤더가 서 있어야 하고,
         히어로가 다 지나간 뒤부터 원래대로 걷힌다.
         ⚠️ 매번 다시 찾는다. 히어로가 없는 페이지도 이 스크립트를 함께 쓴다. */
      var keep = document.querySelector('[data-nav-keep]');
      if (keep && keep.getBoundingClientRect().bottom > 0) {
        nav.classList.remove('is-away');
        return;
      }
      if (dy > 0 && y > nav.offsetHeight) nav.classList.add('is-away');
      else if (dy < 0) nav.classList.remove('is-away');
    }

    window.addEventListener('scroll', function () {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(step);
    }, { passive: true });
  })();
</script>
