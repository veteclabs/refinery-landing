---
// 유즈케이스 상세 페이지 본문. 한국어(/use-cases/[slug])와 영어(/en/use-cases/[slug])가
// 이 컴포넌트를 공유한다. 로케일별로 다른 것은 아래 t 사전과 데이터뿐이다.
//
// 예지보전(한국어)에 적용한 새 디자인은 전부 데이터 플래그로 켜진다
// (heroImageAsBackground·heroTaglineAsTitle·signalsAsCards·showRelatedUseCases·
//  ctaBackgroundImage·cardImage·template.decoImage 등).
// 영어 데이터(en.ts)에는 이 필드들이 없으므로 영어 페이지는 기존 모습 그대로다.
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import '../styles/industry.css';
import ScrollReveal from './ScrollReveal.astro';
import type { UseCase } from '../data/usecases/types';
import { useCases } from '../data/usecases';
import { useCasesEn } from '../data/usecases/en';

interface Props {
  uc: UseCase;
  lang?: 'ko' | 'en';
}
const { uc, lang = 'ko' } = Astro.props;

// 관련 글 이름은 글 원본(마크다운 title)에서 읽는다. 데이터 파일에 적어 두면
// 제목을 고칠 때 두 곳이 어긋난다 — 실제로 부제를 뺄 때(2b1de98 · e507e68)
// 과제별 데이터까지 함께 고쳐야 했다.
// listHref가 없으면 브레드크럼의 목록 항목을 링크가 아닌 텍스트로 렌더한다.
// ko·en 모두 목록 페이지가 없다 — 메가메뉴가 개별 과제로 바로 보내면서
// 링크가 하나도 남지 않아 /use-cases를 지웠다. 브레드크럼을 다시 켜더라도
// 죽은 링크가 생기지 않도록 여기도 비워 둔다.
const T = {
  ko: {
    crumbAria: '위치', home: 'Home', list: '유즈케이스', listHref: undefined as string | undefined,
    eyebrow: 'USE CASE', contact: '문의하기', contactHref: '/contact',
    secondary: '플랫폼 개요 →', secondaryPlain: '플랫폼 개요', secondaryHref: '/why-refinery',
    why: '왜 필요한가요?', how: '리파이너리로 푸는 방식', tmplBadge: '템플릿으로 시작',
    howLede: '모은 값을 판단과 조치로 잇는 과정입니다.',
    signals: '읽는 데이터와 신호', related: '과제 더 살펴보기',
    signalsLede: '따로 보던 값을 한자리에 모아 함께 읽습니다.',
    faqTitle: '자주 묻는 질문',
    ctaTitle: '우리 현장에 어떻게 적용될지<br>함께 살펴봐요.',
  },
  en: {
    crumbAria: 'Breadcrumb', home: 'Home', list: 'Use cases', listHref: undefined as string | undefined,
    eyebrow: 'USE CASE', contact: 'Contact', contactHref: '/en/contact',
    secondary: 'Platform overview →', secondaryPlain: 'Platform overview', secondaryHref: '/en#teams',
    why: 'Why it matters', how: 'How Refinery solves it', tmplBadge: 'Start from a template',
    howLede: 'How those values turn into judgement and action.',
    signals: 'The data and signals we read', related: 'Explore more use cases',
    signalsLede: 'Values you used to read apart, brought together and read as one.',
    faqTitle: 'FAQ',
    ctaTitle: 'Let’s look at how this fits<br>your operation.',
  },
}[lang];

const base = lang === 'en' ? '/en/use-cases' : '/use-cases';
// '과제 더 살펴보기' 카드도 페이지 언어를 따른다. 한국어 목록을 그대로 쓰면
// 영문 페이지에 한글 카드가 섞여 나온다.
const siblings = lang === 'en' ? useCasesEn : useCases;
/* '과제 더 살펴보기' 카드 — 자기 다음 3개를 목록 순서대로 가져온다.
   끝에 닿으면 처음으로 돌아간다.

   '나 빼고 전부'(6장 · 2행)였다. 같은 7개가 메가메뉴 · 메인 솔루션 섹션의
   과제별 탭에도 그대로 있어, 여기서 또 전부 깔면 고른 것이 아니라 목록이 된다.

   ⚠️ 고정 3개가 아니라 순환이다. 고정이면 어느 과제를 봐도 같은 카드가 나와
      여전히 목록으로 읽힌다. 순환이면 쪽마다 다른 셋이 나오고, 7개가 저마다
      정확히 3번씩 등장해 링크가 한쪽으로 쏠리지 않는다.
   ⚠️ 목록 순서(index.ts)가 곧 이웃 관계다. 성격이 가까운 것끼리 붙여 둔
      순서라(전력관리 ↔ 전력품질, 공장 에너지관리 ↔ 에너지 최적화) 이웃이
      대체로 가까운 주제가 된다. 순서를 바꾸면 이 섹션의 짝도 같이 바뀐다. */
const RELATED_COUNT = 3;
const selfIdx = siblings.findIndex((u) => u.slug === uc.slug);
const relatedCases = selfIdx < 0
  ? siblings.filter((u) => u.slug !== uc.slug).slice(0, RELATED_COUNT)
  : Array.from(
      { length: Math.min(RELATED_COUNT, siblings.length - 1) },
      (_, i) => siblings[(selfIdx + 1 + i) % siblings.length],
    );
const path = `${base}/${uc.slug}`;
// 개편 디자인에서는 섹션 순서가 문제 → 신호 → 해법이고(입력을 먼저 보이고 처리를 뒤에),
// '왜 필요한가요?'가 배지 대신 태그라인 형태가 된다. 기존 구성은 문제 → 해법 → 신호.
// 신호를 카드로 그릴지(signalsAsCards)는 아이콘 준비 여부라 별개로 둔다.
const signalsFirst = !!uc.redesigned;
// 개편 디자인에서는 보조 버튼이 테두리 있는 버튼 형태가 되어 화살표가 어색하다 → 뺀다.
// 기존 디자인(텍스트 링크 형태)에서는 화살표가 방향을 알려주므로 그대로 둔다.
const secondaryLabel = uc.heroSecondaryAction?.label ?? (uc.redesigned ? T.secondaryPlain : T.secondary);
// ko/en 양쪽이 모두 존재하는 페이지라 hreflang을 출력한다.
const alternates = [
  { lang: 'ko', href: `/use-cases/${uc.slug}` },
  { lang: 'en', href: `/en/use-cases/${uc.slug}` },
];
const SITE = 'https://refinery.kr';
// 줄 끝에서 갈리면 안 되는 토큰을 nowrap으로 감싼다. keep-all은 어절만 다루고
// 하이픈 뒤·여는 괄호 앞의 줄바꿈은 막지 못한다(실측: 'WISE- / 6610',
// '에너지관리시스템 / (EMS)은'). 태그 밖 텍스트에만 적용한다.
//   1) 제품·규격 코드 — 영문 2자 이상 + 하이픈 + 숫자 (WISE-2410, ISO-20816)
//   2) 한글 + 괄호 약어 + 뒤따르는 조사 (에너지관리시스템(EMS)은)
//   3) 숫자로 시작하는 복합어 (3-axis, 2-year) — 숫자만 떨어지면 읽기 나쁘다.
//      power-factor 같은 낱말끼리의 하이픈은 영어에서 정상적인 줄바꿈이라 두었다.
const nb = (input) =>
  String(input ?? '')
    .split(/(<[^>]+>)/)
    .map((part, i) =>
      i % 2
        ? part
        : part
            .replace(/([A-Za-z]{2,}-\d[\w-]*)/g, '<span class="uc-nb">$1</span>')
            .replace(/([가-힣]+\([A-Za-z0-9]+\)[가-힣]*)/g, '<span class="uc-nb">$1</span>')
            .replace(/(\d+-[A-Za-z]+)/g, '<span class="uc-nb">$1</span>'))
    .join('');

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: uc.seo.title,
    url: `${SITE}${path}`,
    isPartOf: { '@type': 'WebSite', name: 'Refinery', url: `${SITE}/` },
  },
  // faq가 있으면 FAQPage 구조화 데이터도 함께 출력한다(답변엔진 최적화).
  ...(uc.faq && uc.faq.length
    ? [{
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: uc.faq.map((f) => ({
          '@type': 'Question',
          name: f.q,
          // 구조화 데이터에는 표시용 <br>를 빼고 순수 문장만 넣는다.
          // <br>만 공백으로, 나머지 태그는 흔적 없이 지운다.
          // 한 번에 공백 치환하면 '<span>WISE-2410</span>)는'이 'WISE-2410 )는'이 된다.
          acceptedAnswer: {
            '@type': 'Answer',
            text: f.a.replace(/<br\s*\/?>/gi, ' ').replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim(),
          },
        })),
      }]
    : []),
];
---
<BaseLayout title={uc.seo.title} description={uc.seo.description} canonical={path} alternates={alternates} jsonLd={jsonLd}>
  {/* 히어로 사진은 이 페이지의 LCP다. head에서 미리 받아 두면 본문 파싱을 기다리지
      않고 바로 내려받기 시작한다 — 회색 판이 보이던 시간이 그만큼 짧아진다. */}
  {uc.heroImageAsBackground && uc.heroImage && (
    <link slot="head" rel="preload" as="image" href={uc.heroImage.src} fetchpriority="high" />
  )}
  <Nav />
  {/* slug 클래스로 페이지별 스타일 스코프를 연다. 공통 .ind-* 규칙은 건드리지 않으므로
      이 클래스를 쓰지 않는 다른 유즈케이스는 기존 디자인 그대로다. */}
  <main class={`ind uc-page uc-${uc.slug}${uc.redesigned ? ' uc-redesigned' : ''}${lang === 'en' ? ' uc-en' : ''}`}>
    {/* ⚠️ 본문 맨 위에 둔다. 스크립트가 <html> 에 rv-on 을 붙이는 시점이 아래
        섹션들의 파싱보다 앞서야 첫 페인트부터 숨은 채로 그려진다. */}
    <ScrollReveal />
    <!-- HERO -->
    {/* ⚠️ heroImageAsBackground 는 이름만 옛것이다. 사진은 더 이상 글 뒤에 깔리지 않고
        글 아래 한 칸으로 선다 — 산업 상세(.ind-hero-bg)와 같은 구성이고, 규칙도
        industry.css 의 것을 그대로 쓴다. 플래그는 '그 구성을 쓴다'로 읽는다.
        ⚠️ 스크림이 없다. 글이 사진 위에 얹히지 않으니 대비를 만들 막이 필요 없고,
           사진은 제 색 그대로 보인다. */}
    {uc.heroImageAsBackground && uc.heroImage ? (
      <section class="ind-hero ind-hero-bg">
        <div class="ind-container">
          {(uc.showBreadcrumb ?? true) && (
            <nav class="ind-crumb" aria-label={T.crumbAria}>
              <a href={lang === 'en' ? '/en' : '/'}>{T.home}</a><span>›</span>
              {T.listHref ? <a href={T.listHref}>{T.list}</a> : <span>{T.list}</span>}
              <span>›</span><span>{uc.name}</span>
            </nav>
          )}
          {/* 산업 상세와 같은 한 줄 격자. 위계를 뒤집은 형태라 과제명이 라벨,
              tagline 문장이 대제목이다.
              오른쪽 칸은 heroLede — '왜 필요한가요?'의 문제 문단을 이 칸(520px)에
              맞게 줄인 판이다. 넣은 페이지에서는 아래 그 섹션을 렌더하지 않는다.
              ⚠️ 격자의 둘째 칸은 auto 라, heroLede 가 없으면 0 이 되어 대제목이
                 두 칸을 다 쓴다 — 옛 모습 그대로다. */}
          <div class="ind-hero-row">
            <p class="ind-eyebrow">{uc.name}</p>
            <h1 set:html={nb(uc.heroTitle ?? uc.tagline)}></h1>
            {uc.heroLede && <p class="ind-lede">{uc.heroLede}</p>}
          </div>
          {/* 히어로에는 버튼을 두지 않는다 — 산업 상세와 같다. 전환은 페이지 맨 아래
              CTA 섹션(.ind-cta)이 받는다. 거기에 같은 /contact 링크가 큰 버튼으로 있다. */}
        </div>
        {/* 사진은 글 뒤가 아니라 글 아래에 선다. 스크롤을 내리면 화면 폭으로 자란다. */}
        <div class="ind-hero-figure">
          {/* 히어로 최상단 이미지 → LCP 대상이므로 lazy 금지 */}
          <img
            class="ind-hero-figure-img"
            src={uc.heroImage.src}
            alt=""
            aria-hidden="true"
            width={uc.heroImage.width}
            height={uc.heroImage.height}
            decoding="async"
            fetchpriority="high"
          />
        </div>
        <script is:inline>
          {/* 히어로 사진 넓히기 — 스크롤을 내린 만큼 --grow 를 0 → 1 로 올린다.
              산업 상세(IndustryPage.astro)와 같은 스크립트다. 한쪽을 고치면 다른 쪽도 본다.
              ⚠️ 쓰는 값은 scrollY 다. 사진의 화면 안 위치로 재면 첫 화면에서
                 이미 절반쯤 자란 상태로 뜬다 — '기본 모습에서 스크롤할 때'가 아니다.
              ⚠️ 동작 줄이기를 켠 사람에게는 손대지 않는다 — 기본 모습 그대로다. */}
          (function () {
            var fig = document.querySelector('.ind-hero-figure');
            if (!fig) return;
            if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) return;
            var D = 360, last = -1, ticking = false;
            function upd() {
              var p = Math.min(1, Math.max(0, (window.scrollY || window.pageYOffset) / D));
              p = Math.round(p * 1000) / 1000;
              if (p === last) return;
              last = p;
              fig.style.setProperty('--grow', p);
            }
            function onScroll() {
              if (ticking) return;
              ticking = true;
              requestAnimationFrame(function () { ticking = false; upd(); });
            }
            addEventListener('scroll', onScroll, { passive: true });
            addEventListener('resize', onScroll, { passive: true });
            upd();
          })();
        </script>
      </section>
    ) : (
      <section class="ind-hero">
        <div class={uc.heroAlignsWithNav ? 'ind-container uc-container--nav' : 'ind-container'}>
          <div class={uc.heroImage ? 'uc-hero-row' : undefined}>
            <div class="uc-hero-text">
              {(uc.showBreadcrumb ?? true) && (
                <nav class="ind-crumb" aria-label={T.crumbAria}>
                  <a href={lang === 'en' ? '/en' : '/'}>{T.home}</a><span>›</span>
                  {T.listHref ? <a href={T.listHref}>{T.list}</a> : <span>{T.list}</span>}
                  <span>›</span><span>{uc.name}</span>
                </nav>
              )}
              {uc.heroTaglineAsTitle ? (
                <Fragment>
                  {/* 위계를 뒤집은 형태 — 과제명이 태그라인, tagline 문장이 대제목이다.
                      설명 문단은 그 문장과 겹치므로 렌더하지 않는다. */}
                  <p class="uc-tag">{uc.name}</p>
                  <h1 set:html={nb(uc.heroTitle ?? uc.tagline)}></h1>
                </Fragment>
              ) : (
                <Fragment>
                  {(uc.showEyebrow ?? true) && <p class="ind-eyebrow">{uc.eyebrow ?? T.eyebrow}</p>}
                  <h1>{uc.name}</h1>
                  <p class="ind-lede">{uc.tagline}</p>
                </Fragment>
              )}
              <div class="ind-hero-actions">
                <a href={T.contactHref} class="ind-btn-primary">{T.contact}</a>
                <a href={uc.heroSecondaryAction?.href ?? T.secondaryHref} class="ind-btn-ghost">{secondaryLabel}</a>
              </div>
            </div>
            {uc.heroImage && (
              <figure class="uc-hero-figure">
                {/* 히어로 최상단 이미지 → LCP 대상이므로 lazy 금지 */}
                <img
                  src={uc.heroImage.src}
                  alt={uc.heroImage.alt}
                  width={uc.heroImage.width}
                  height={uc.heroImage.height}
                  decoding="async"
                  fetchpriority="high"
                />
                {uc.heroImage.caption && <figcaption>{uc.heroImage.caption}</figcaption>}
              </figure>
            )}
          </div>
        </div>
      </section>
    )}

    {/* 문제 — heroLede 를 넣은 페이지에서는 그 문장이 히어로 소제목 자리로 올라가
        있으므로 이 섹션을 렌더하지 않는다. 같은 말이 두 번 나오기 때문이다.
        ⚠️ problem/problemHtml 자체는 데이터에 그대로 둔다 — 산업 상세
           (/industries/[slug])의 과제 목록이 problem 을 읽는다. */}
    {!uc.heroLede && (
      <section class={signalsFirst ? 'ind-section uc-problem-section' : 'ind-section'}>
        <div class="ind-container uc-narrow">
          <header class="ind-head">
            {signalsFirst ? <p class="uc-tag">{T.why}</p> : <span class="ind-badge">{T.why}</span>}
          </header>
          <p class="uc-problem" set:html={nb(uc.problemHtml ?? uc.problem)}></p>
        </div>
      </section>
    )}

    {/* 신호 섹션 — 새 구성은 문제 바로 아래(문제 → 입력 → 처리), 기존은 해법 다음.
        마크업을 별도 컴포넌트로 빼면 이 파일의 스코프 스타일(.uc-signal* 등)이
        적용되지 않으므로(Astro는 컴포넌트마다 다른 data-astro-cid를 붙인다)
        두 자리에 그대로 두 번 쓴다. 한쪽을 고치면 다른 쪽도 같이 고쳐야 한다. */}
    {signalsFirst && (
      <section class="ind-section uc-signal-section">
        <div class="ind-container uc-narrow">
          <header class="ind-head">
            <h2>{T.signals}</h2>
            <p>{T.signalsLede}</p>
          </header>
          {uc.signalsAsCards ? (
            <div class="uc-signal-cards">
              {uc.signals.map((s) => {
                const label = typeof s === 'string' ? s : s.label;
                const icon = typeof s === 'string' ? undefined : s.icon;
                return (
                  <div class="uc-signal">
                    <span class="uc-signal-icon" aria-hidden="true">
                      {icon && (icon.startsWith('ph-')
                        ? <i class={`ph ${icon}`}></i>
                        : <img src={`/icons/usecase/${icon}.webp`} width="88" height="88"
                               alt="" loading="lazy" decoding="async" />)}
                    </span>
                    <span class="uc-signal-label">{label}</span>
                  </div>
                );
              })}
            </div>
          ) : (
            <div class="uc-chips">
              {uc.signals.map((s) => <span class="uc-chip">{typeof s === 'string' ? s : s.label}</span>)}
            </div>
          )}
        </div>
      </section>
    )}

    <!-- 어떻게 -->
    <section class="ind-section ind-soft">
      <div class="ind-container">
        <header class="ind-head"><h2>{T.how}</h2><p>{T.howLede}</p></header>
        <div class="ind-grid ind-grid-3" style={uc.redesigned ? `--uc-cols:${Math.min(uc.how.length, 4)}` : undefined}>
          {uc.how.map((h) => (
            <div class="ind-card">
              {h.icon && <span class="uc-card-icon" aria-hidden="true"><i class={`ph ${h.icon}`}></i></span>}
              <h3>{h.title}</h3>
              <p set:html={h.desc}></p>
            </div>
          ))}
        </div>

        {uc.template && (
          <div class={uc.template.image ? 'uc-template uc-template--split' : 'uc-template'}>
            {uc.template.decoImage && (
              <img class="uc-template-deco" src={uc.template.decoImage} alt="" aria-hidden="true" loading="lazy" decoding="async" />
            )}
            <div class="uc-template-body">
              <span class="uc-template-badge"><i class="ph ph-blueprint" aria-hidden="true"></i> {uc.template.badge ?? T.tmplBadge}</span>
              <h3 set:html={nb(uc.template.title)}></h3>
              <p set:html={nb(uc.template.desc)}></p>
              {uc.template.includes && (
                <ul class="uc-template-list" style={uc.redesigned ? `--uc-tmpl-cols:${uc.template.includes.length % 3 === 0 ? 3 : 2}` : undefined}>
                  {uc.template.includes.map((it) => <li><i class="ph ph-check-circle" aria-hidden="true"></i><span set:html={nb(it)}></span></li>)}
                </ul>
              )}
            </div>
            {uc.template.image && (
              <figure class="uc-template-figure">
                <img
                  src={uc.template.image.src}
                  alt={uc.template.image.alt}
                  width={uc.template.image.width}
                  height={uc.template.image.height}
                  loading="lazy"
                  decoding="async"
                />
                {uc.template.image.caption && <figcaption>{uc.template.image.caption}</figcaption>}
              </figure>
            )}
          </div>
        )}
      </div>
    </section>

    {/* 위 신호 섹션과 같은 마크업 — 기존 구성(칩)에서는 해법 다음에 온다. */}
    {!signalsFirst && (
      <section class="ind-section uc-signal-section">
        <div class="ind-container uc-narrow">
          <header class="ind-head">
            <h2>{T.signals}</h2>
            <p>{T.signalsLede}</p>
          </header>
          {uc.signalsAsCards ? (
            <div class="uc-signal-cards">
              {uc.signals.map((s) => {
                const label = typeof s === 'string' ? s : s.label;
                const icon = typeof s === 'string' ? undefined : s.icon;
                return (
                  <div class="uc-signal">
                    <span class="uc-signal-icon" aria-hidden="true">
                      {icon && (icon.startsWith('ph-')
                        ? <i class={`ph ${icon}`}></i>
                        : <img src={`/icons/usecase/${icon}.webp`} width="88" height="88"
                               alt="" loading="lazy" decoding="async" />)}
                    </span>
                    <span class="uc-signal-label">{label}</span>
                  </div>
                );
              })}
            </div>
          ) : (
            <div class="uc-chips">
              {uc.signals.map((s) => <span class="uc-chip">{typeof s === 'string' ? s : s.label}</span>)}
            </div>
          )}
        </div>
      </section>
    )}

    {/* 다른 과제 — 데이터에서 showRelatedUseCases를 켠 유즈케이스에만 렌더된다.
        아래 CTA가 어두운 배경이라 이 구역은 흰 배경으로 두어 대비로 구분한다. */}
    {uc.showRelatedUseCases && (
      <section class="ind-section">
        <div class="ind-container uc-narrow">
          <header class="ind-head"><h2>{T.related}</h2></header>
          <div class="uc-cases">
            {relatedCases.map((u) => (
              <a class={u.cardImage ? 'uc-case uc-case--img' : 'uc-case'} href={`${base}/${u.slug}`}>
                {u.cardImage && (
                  <img
                    class="uc-case-img"
                    src={u.cardImage.src}
                    alt=""
                    aria-hidden="true"
                    width={u.cardImage.width}
                    height={u.cardImage.height}
                    style={u.cardImage.position ? `object-position:${u.cardImage.position}` : undefined}
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <div class="uc-case-body">
                  <span class="uc-case-label">{u.name}</span>
                  <p class="uc-case-desc" set:html={nb(u.cardDesc ?? u.tagline)}></p>
                  <span class="uc-case-go" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 -960 960 960" xmlns="http://www.w3.org/2000/svg" fill="currentColor"><path d="m553.85-253.85-42.16-43.38L664.46-450H180v-60h484.46L511.69-662.77l42.16-43.38L780-480 553.85-253.85Z"/></svg>
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    {uc.faq && uc.faq.length > 0 && (
      <section class="ind-section uc-faq-section">
        <div class="ind-container">
          {/* 랜딩 #faq와 같은 구성 — 제목 왼쪽, 아코디언 목록 오른쪽.
              질문은 h3를 유지한다. 랜딩은 div를 쓰지만 이 페이지는 FAQPage
              스키마와 함께 나가는 정의형 FAQ(AEO)라 제목 의미를 버릴 수 없다. */}
          <div class="uc-faq-head">
            <header class="ind-head"><h2>{T.faqTitle}</h2></header>
            <div class="uc-faq-list">
              {uc.faq.map((f) => (
                <div class="uc-faq-item">
                  <h3 class="uc-faq-q"><span set:html={nb(f.q)}></span><i class="ph-bold ph-caret-down uc-faq-icon" aria-hidden="true"></i></h3>
                  <div class="uc-faq-a" set:html={nb(f.a)}></div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- CTA -->
    <section class={uc.ctaBackgroundImage ? 'ind-cta uc-cta-bg' : 'ind-cta'}>
      {uc.ctaBackgroundImage && (
        <img
          class="uc-cta-bg-img"
          src={uc.ctaBackgroundImage}
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
        />
      )}
      <div class="ind-container">
        <h2 set:html={nb(uc.ctaTitle ?? T.ctaTitle)}></h2>
        <a href={T.contactHref} class="ind-btn-primary ind-btn-lg">{T.contact}</a>
      </div>
    </section>
  </main>
  <Footer />

<script is:inline>
  // 랜딩 #faq와 같은 동작 — 하나를 열면 나머지는 닫힌다.
  document.querySelectorAll('.uc-faq-q').forEach(function (q) {
    q.addEventListener('click', function () {
      var a = q.nextElementSibling;
      var isOpen = a.classList.contains('open');
      document.querySelectorAll('.uc-faq-a').forEach(function (el) { el.classList.remove('open'); });
      document.querySelectorAll('.uc-faq-item').forEach(function (el) { el.classList.remove('open'); });
      if (!isOpen) {
        a.classList.add('open');
        q.closest('.uc-faq-item').classList.add('open');
      }
    });
  });
</script>
</BaseLayout>

<style>
  /* 정의형 FAQ(AEO). 본문 Q&A + FAQPage 스키마와 함께 렌더된다.
     규격은 랜딩 #faq(global.css:560~571)를 그대로 따른다 —
     2열(1fr 2fr) · gap 64 · 질문 17/500 · 답 15/1.7 · 항목 아래선 1px. */
  /* 배경은 '왜 필요한가요?'(.uc-problem-section)와 같은 #f6f8fa.
     목록에는 따로 판을 깔지 않고 구분선만으로 질문을 나눈다.
     ⚠️ redesigned가 7개 과제 전부라 이 규칙도 7개 페이지에 걸린다. */
  .uc-redesigned .uc-faq-section { background: #f6f8fa; }

  .uc-faq-head { display: grid; grid-template-columns: 1fr 2fr; gap: 64px; align-items: start; }
  .uc-faq-head .ind-head { max-width: none; margin-bottom: 0; }
  /* 랜딩도 900px에서 한 칸으로 접고 간격을 24px로 줄인다. */
  @media (max-width: 900px) {
    .uc-faq-head { grid-template-columns: 1fr; gap: 24px; }
  }
  .uc-faq-item { border-bottom: 1px solid var(--border, #E3E7EC); overflow: hidden; }
  .uc-faq-item:last-child { border-bottom: none; }
  .uc-faq-q {
    margin: 0; padding: 20px 4px;
    /* '과제 더 살펴보기' 카드 대제목(.uc-case-label)과 같은 20px / 600. */
    font-size: 20px; font-weight: 600; letter-spacing: normal;
    color: var(--text, #16202c); cursor: pointer;
    display: flex; justify-content: space-between; align-items: center;
    word-break: keep-all;
  }
  .uc-faq-icon {
    font-size: 14px; color: var(--text-dim, #7E8A98);
    flex-shrink: 0; margin-left: 12px; transition: transform .2s;
    -webkit-text-stroke: 0.3px currentColor;
  }
  .uc-faq-item.open .uc-faq-icon { transform: rotate(180deg); }
  /* 접힘은 max-height로 만든다(랜딩과 같은 방식). display:none이 아니라
     DOM에 그대로 남아 FAQPage 스키마·크롤링에는 영향이 없다. */
  .uc-faq-a {
    /* 같은 카드의 소제목(.uc-case-desc)과 같은 15px / 1.5. */
    font-size: 15px; line-height: 1.5; color: var(--text-muted, #5A6776);
    overflow: hidden; max-height: 0; padding: 0 4px; opacity: 0;
    transition: max-height .4s cubic-bezier(.22,1,.36,1), padding .3s ease, opacity .3s ease;
    word-break: keep-all;
  }
  .uc-faq-a.open { max-height: 400px; padding: 0 4px 20px; opacity: 1; }
  /* 데이터의 <br>는 넓은 폭에서 문장을 끊어 읽히게 하려고 넣은 것이라,
     칸이 좁아져 구간이 다시 감기기 시작하면 오히려 줄이 들쭉날쭉해진다.
     1024px 이하에서는 풀고 자연 줄바꿈에 맡긴다. 어절 중간 끊김은
     .uc-page 전역 word-break: keep-all이 막는다. */
  /* ⚠️ :global 필수. 답변은 set:html로 주입돼 <br>에 Astro 스코프 속성이
     붙지 않는다. .uc-faq-a br로 쓰면 br[data-astro-…]가 되어 하나도 안 맞는다. */
  @media (max-width: 1024px) {
    .uc-faq-a :global(br) { display: none; }
  }
  /* 모델명처럼 하이픈이 든 토큰이 줄 끝에서 갈리는 것을 막는다.
     keep-all은 어절만 다루고 하이픈 뒤 줄바꿈은 막지 못한다
     (320px에서 'WISE- / 2410'으로 갈렸다). */
  .uc-page :global(.uc-nb) { white-space: nowrap; }

  .uc-narrow { max-width: 760px; }
  /* keep-all — 없으면 좁은 화면에서 한국어가 어절 중간에서 잘린다. */
  /* ⚠️ 페이지 전체에 keep-all을 건다. 요소별로 붙이다 보니 빠진 곳이 남아
     좁은 폭에서 한글이 어절 한가운데서 끊겼다 — 600px '정상인/지' '읽/어',
     375px '배선 없/이' '게이트웨/이가', 320px '부착식 설/치' '3축 가/속도계'.
     overflow-wrap: break-word는 한 어절이 줄보다 길 때만 쓰이는 안전장치다. */
  .uc-page, .uc-page * { word-break: keep-all; overflow-wrap: break-word; }

  .uc-problem { font-size: 18px; line-height: 1.8; color: #22303F; word-break: keep-all; }
  /* 데이터의 <br>는 넓은 폭에서 문단을 끊어 읽히게 하려고 넣은 것이다. 글 상자가
     좁아져 구간이 다시 감기기 시작하면 줄이 들쭉날쭉해지므로 그 아래에서는 푼다.
     실측 — 1200px(글 폭 829)까지는 구간이 [2+1]로 유지되고 1100px(729)부터 [3+2].
     ⚠️ :global 필수. problemHtml은 set:html로 주입돼 <br>에 스코프 속성이 없다. */
  @media (max-width: 1199px) {
    .uc-problem :global(br) { display: none; }
  }
  .uc-chips { display: flex; flex-wrap: wrap; gap: 10px; }
  .uc-chip {
    font-size: 14px; color: #16202c; background: #fff; border: 1px solid var(--border);
    border-radius: 999px; padding: 8px 16px;
  }
  /* 다른 과제 — 6개를 3열 2행 카드로 둔다. 규격은 위 '이렇게 풉니다' 카드와 같다
     (흰 배경 · 1px 테두리 · radius 12 · padding 24). 링크라 hover를 준다. */
  .uc-cases {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  /* 배경 이미지를 꽉 채울 예정이라 세로를 키우고 제목을 아래쪽에 둔다.
     이미지가 들어와도 제목 위치가 그대로라 레이아웃이 흔들리지 않는다.
     position/overflow는 나중에 넣을 이미지가 라운드 모서리 안에 잘리도록 미리 잡아둔 것. */
  .uc-case {
    position: relative; overflow: hidden;
    display: flex; align-items: flex-end;
    min-height: 320px;
    color: #16202c;
    background: var(--bg); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 24px;
    transition: border-color .2s, color .2s, box-shadow .2s;
  }
  /* keep-all — 없으면 한국어가 어절 중간에서 잘린다('흩어/진', '데/이터').
     띄어쓰기에서만 줄을 바꿔 읽는 단위가 유지된다. */
  /* 층 순서: 사진(0) → 어두운 막(1) → 하단 그라데이션(2) → 글(3) */
  .uc-case-body { position: relative; z-index: 3; word-break: keep-all; }
  /* 제목·설명 크기는 랜딩 산업 카드(.industry-name / .industry-desc)와 같은 값. */
  .uc-case-label { display: block; font-size: 20px; font-weight: 600; margin-bottom: 5px; }
  .uc-case-desc { font-size: 15px; line-height: 1.5; color: var(--text-muted); text-wrap: pretty; }
  /* 글자 없이 화살표 아이콘만. 카드 전체가 링크라 이름은 제목이 맡고,
     이 아이콘은 '넘어간다'는 신호만 준다(그래서 aria-hidden). */
  .uc-case-go {
    display: inline-flex; align-items: center; justify-content: center;
    /* 28px — WCAG 2.2 최소 타깃 크기(2.5.8) 하한은 24px이다.
       카드 전체가 링크라 이 아이콘 자체가 타깃은 아니지만,
       24px 아래로 내려가면 1px 테두리와 화살촉 사이 여백이 없어 뭉개진다. */
    width: 28px; height: 28px; margin-top: 20px;
    border: 1px solid currentColor; border-radius: 50%;
    color: #4b86bf;
    transition: transform .2s ease, background-color .2s ease, color .2s ease;
  }
  .uc-case-go svg { display: block; }
  /* hover 시 원이 채워지며 화살표가 뒤집힌 색이 된다. 카드 전체가 링크라
     이동 애니메이션은 그대로 두고 면 채움만 더한다. */
  .uc-case:hover .uc-case-go { transform: translateX(4px); }
  @media (max-width: 860px) {
    .uc-cases { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 520px) {
    .uc-cases { grid-template-columns: 1fr; }
  }
  .uc-case:hover { border-color: var(--accent); color: #4b86bf; box-shadow: 0 4px 14px rgba(16,32,44,.06); }

  /* 배경 이미지가 있는 카드(데이터에 cardImage를 넣은 것만).
     이미지 → 스크림 → 제목 순으로 쌓아 사진 위에서도 글자가 읽히게 한다.
     테두리를 없애야 이미지가 카드를 끝까지 채운다. 테두리를 두면
     inset:0이 패딩 박스 기준이라 사방 1px씩 흰 테가 남는다. */
  .uc-case-img {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; pointer-events: none; user-select: none;
    transition: transform .3s ease;
  }
  /* 1층 — 사진 전체를 고르게 덮는 어두운 막. 카드마다 밝기가 제각각인
     사진들의 톤을 한 단계 내려 6장이 같은 계열로 묶이게 한다.
     z-index 필수: ::before는 생성 순서상 .uc-case-img보다 앞이라
     지정하지 않으면 사진이 이 막을 덮어버린다(그리는 순서가 DOM 순서). */
  .uc-case--img::before {
    content: ''; position: absolute; inset: 0; z-index: 1;
    background: rgba(17,19,22,.25);
  }
  /* 2층 — 하단 그라데이션. 글 묶음이 카드의 52~93% 구간에 놓이므로,
     위쪽 절반은 1층 막만 걸리고 그 구간부터 빠르게 짙어지게 한다. */
  .uc-case--img::after {
    content: ''; position: absolute; inset: 0; z-index: 2;
    background: linear-gradient(180deg,
      rgba(17,19,22,0) 0%,
      rgba(17,19,22,.12) 28%,
      rgba(17,19,22,.82) 52%,
      rgba(17,19,22,1) 100%);
  }
  .uc-case--img { border: none; }
  .uc-case--img .uc-case-label { color: #fff; }
  .uc-case--img .uc-case-desc { color: rgba(255,255,255,.82); }
  .uc-case--img .uc-case-go { color: #fff; }
  /* 사진 위에서는 글자색을 바꾸지 않고 이미지를 살짝 확대해 반응을 준다. */
  .uc-case--img:hover .uc-case-label { color: #fff; }
  .uc-case--img:hover .uc-case-img { transform: scale(1.04); }


  /* 템플릿 강조 밴드 — 전력관리·전력품질·공장 에너지관리도 같이 쓰는 공용 스타일이다.
     페이지별로 바꿀 땐 아래 .uc-redesigned 스코프에서 덮을 것. */
  .uc-template {
    margin-top: 24px; background: #EFF2F5; border: 1px solid #E3E7EC; border-radius: 14px;
    padding: 24px 26px;
  }
  /* 알약 없이 아이콘 + 글자만. 면·테두리를 걷어내 밴드 위에 얹힌 라벨로 둔다. */
  .uc-template-badge {
    /* inline-flex면 부모 줄상자(16px·1.65)의 여유 공간이 배지 아래에 붙어
       h3의 margin-top이 화면 간격과 달라진다. flex + fit-content로 줄상자를
       벗어나게 해 선언한 값이 그대로 간격이 되게 한다. */
    display: flex; width: fit-content; align-items: center; gap: 6px;
    /* 크기는 아래 설명(.uc-template p)과 같은 15px. 아이콘도 font-size를 따라 커진다. */
    font-size: 15px; font-weight: 700; letter-spacing: .02em; color: #76a6d7;
    background: none; border: none; border-radius: 0; padding: 0;
  }
  /* 제목·설명 크기는 랜딩 산업 카드(.industry-name / .industry-desc)와 같은 값 —
     위 '이렇게 풉니다' 카드, 아래 '다른 과제' 카드와 한 규격으로 맞춘다.
     목록도 설명과 같은 15px으로 올려 밴드 안에서 글자 크기가 두 종류만 남게 한다. */
  .uc-template h3 { margin-top: 14px; font-size: 20px; font-weight: 600; line-height: 1.6; color: #16202c; }
  .uc-template p { margin-top: 5px; font-size: 15px; line-height: 1.5; color: var(--text-muted); }
  /* 목록은 설명과 성격이 다른 블록이라, 배지→제목(16px)·제목→설명(5px)보다
     넉넉히 띄워 문단이 끝났음을 보인다. */
  .uc-template-list { list-style: none; padding: 0; margin: 28px 0 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px 20px; }
  .uc-template-list li { display: flex; align-items: center; gap: 8px; font-size: 15px; color: #16202c; }
  .uc-template-list li i { color: #2f6ba3; font-size: 15px; flex: none; }
  /* 예지보전만 항목이 6개라 3열 2행이 딱 떨어진다.
     나머지(전력관리·전력품질·공장 에너지관리)는 4개여서 3열이면 3+1로 남으므로
     공용 2열 규칙을 그대로 둔다. */
  /* 항목 수로 열을 정한다 — 3의 배수면 3열, 아니면 2열. 6개는 3×2, 4개는 2×2로
     행이 고르게 차고, 4개를 3열에 두면 3+1로 한 칸이 남는다.
     --uc-tmpl-cols는 마크업에서 includes.length로 넣는다. */
  .uc-redesigned .uc-template-list { grid-template-columns: repeat(var(--uc-tmpl-cols, 2), 1fr); }
  @media (max-width: 860px) {
    .uc-redesigned .uc-template-list { grid-template-columns: repeat(2, 1fr); }
  }
  /* ⚠️ .uc-redesigned를 함께 적어야 한다. 위 860px 블록의
     '.uc-redesigned .uc-template-list'(특정도 0,2,0)가 이 규칙(0,1,0)을 이겨
     560px 아래에서도 2열이 유지됐고, 칸이 좁아 항목마다 글이 2줄로 감겼다. */
  @media (max-width: 560px) {
    .uc-template-list,
    .uc-redesigned .uc-template-list { grid-template-columns: 1fr; }
  }
  /* 영문은 항목 문자열이 길어 같은 칸에서 한국어보다 일찍 두 줄이 된다.
     실측(예지보전) — 3열은 1200px(항목 332px)까지, 2열은 800px(332px)까지
     한 줄로 버티고 그 아래부터 'Built-in 3-axis accelerometer + temperature'가
     감긴다. 그래서 영문만 열을 한 단계 일찍 줄인다.
     ⚠️ 위 860/560 블록보다 뒤에 와야 이긴다. */
  @media (max-width: 1199px) {
    .uc-en.uc-redesigned .uc-template-list { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 799px) {
    .uc-en.uc-redesigned .uc-template-list { grid-template-columns: 1fr; }
  }

  /* ───────────────────────────────────────────────────────────
     아래는 데이터에 해당 필드(heroImage·icon·template.image)를 넣은
     유즈케이스에서만 렌더되는 요소들이다. 넣지 않은 페이지에는 마크업 자체가
     생기지 않으므로 기존 6개 유즈케이스 디자인에는 영향이 없다.
     ─────────────────────────────────────────────────────────── */

  /* ⚠️ 배경 사진 히어로(.uc-hero-bg — 절대배치 사진 + 어두운 스크림 + 흰 글자)는
     없앴다. 사진이 글 뒤에서 빠져 글 아래 한 칸으로 내려오면서, 스크림도 흰 글자도
     어두운 면용 버튼도 쓸 데가 사라졌다. 지금은 산업 상세와 같은 .ind-hero-bg 를
     쓰고 규칙은 industry.css 한곳에 있다 — 여기서 다시 적지 않는다. */

  /* 제목이 문장이 되면서 히어로가 빽빽해져 위·사이 여백을 넓힌다
     (공통값은 margin-top 32px · gap 10px).
     ⚠️ 사진이 글 아래로 내려온 히어로에는 버튼이 없다. 이 값은 옛 구성(사진을
        글 옆에 두는 쪽)을 쓰는 페이지에만 닿는다. */
  .uc-redesigned .ind-hero-actions { margin-top: 48px; gap: 16px; }

  /* 히어로 2컬럼 (heroImage 있을 때만) */
  .uc-hero-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; align-items: center; }
  .uc-hero-figure { margin: 0; }
  .uc-hero-figure img {
    display: block; width: 100%; height: auto;
    border: 1px solid var(--border); border-radius: 14px;
    background: #fff; box-shadow: 0 18px 46px rgba(16, 32, 44, 0.10);
  }
  .uc-hero-figure figcaption,
  .uc-template-figure figcaption { margin-top: 10px; font-size: 13px; color: var(--text-muted); }
  @media (max-width: 900px) {
    .uc-hero-row { grid-template-columns: 1fr; gap: 34px; }
  }

  /* 헤더(.nav-inner)와 같은 박스 — 좌측이 로고 선에 정확히 맞는다.
     nav-footer.css의 .nav-inner: max-width 1280 / padding 0 48px, 900px 이하에서 24px. */
  .uc-container--nav { max-width: 1600px; padding: 0 48px; }
  @media (max-width: 900px) {
    .uc-container--nav { padding: 0 24px; }
  }

  /* 히어로를 문의하기 페이지(#contact-hero)와 동일한 크기·위치로 맞춘다.
     contact.css: .container = 1280/48(위 uc-container--nav와 동일),
                  #contact-hero padding-top 180px,
                  h2 = clamp(30px, 4.2vw, 48px) / 600 / -0.8px / 1.3 */
  /* 위 여백 180px은 문의하기 페이지 제목 위치에 맞춘 값이라 건드리지 않는다.
     세로를 키울 땐 아래 여백만 늘려야 제목 위치가 그대로 유지된다.
     ⚠️ 사진이 글 아래로 내려온 히어로(.ind-hero-bg)는 뺀다 — 아래 여백은 사진 칸
        (.ind-hero-figure)이 쥔다. 여기서 100px 을 주면 사진이 다 자란 뒤 그 밑에
        흰 띠가 남는다. 위 여백 180px 은 industry.css 쪽에 같은 값으로 있다. */
  .uc-redesigned .ind-hero:not(.ind-hero-bg) { padding-top: 180px; padding-bottom: 100px; }
  /* 제목이 문장이 되면서 어절이 잘린다('전조 / 를 읽어'). 띄어쓰기에서만 끊는다. */
  .uc-redesigned .ind-hero h1 { word-break: keep-all; }
  /* 태그라인 — 히어로의 과제명과 '왜 필요한가?' 배지가 같은 형태를 쓴다.
     ind-eyebrow/ind-badge처럼 대문자·자간 확대·알약 배경을 쓰지 않고
     한글 그대로 읽히게 둔다. */
  .uc-tag {
    font-size: 18px; font-weight: 600; letter-spacing: -0.2px;
    /* 하늘색은 배경 밝기와 무관하게 브랜드 값 #76A6D7 하나로 통일한다.
       밝은 배경용 --accent-ink(#4B86BF)·어두운 배경용 #9CC4E8을 쓰지 않는다. */
    color: #76a6d7; margin-bottom: 14px;
  }

  /* 'Refinery는 이렇게 풉니다' 카드를 랜딩 'From Data to Intelligence' 섹션의
     .series-card와 같은 규격으로 맞춘다(색은 이 페이지 것을 유지).
     아이콘을 상자 없이 위에 두고 제목까지 크게 띄우는 것이 그 카드의 특징이다. */
  /* 아이콘~제목 간격. 랜딩 .series-icon은 80px이지만 그 카드는 배경이 거의 검정
     (rgb 17,19,22)이라 빈 공간이 뒤로 물러난다. 이 카드는 흰 배경이라 같은 80px이
     더 넓게 보이므로 65px로 낮춰 보이는 인상을 맞춘다. */
  .uc-card-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: fit-content; height: auto;
    margin-bottom: 65px;
    color: #76a6d7;
  }
  /* 제목을 16 → 20px으로 올린 만큼 아이콘도 키운다(랜딩은 26 / 16). */
  .uc-card-icon i { font-size: 30px; line-height: 1; }
  .uc-redesigned .ind-card { padding: 24px; }
  /* 제목·설명 크기는 랜딩 산업 카드(.industry-name / .industry-desc)와 같은 값.
     아래 '다른 과제' 카드도 같은 값을 쓰므로 페이지 안 카드 두 묶음이 한 규격이 된다. */
  .uc-redesigned .ind-card h3 {
    font-size: 20px; font-weight: 600; line-height: 1.6; margin: 0 0 5px;
  }
  .uc-redesigned .ind-card p { font-size: 15px; line-height: 1.5; margin: 0; }
  /* 카드 제목·설명의 줄을 고르게 나눈다. 영문 제목이 두 줄이 될 때 마지막 줄에 낱말
     하나만 떨어지는 자리가 많았다 — 예지보전만 1440px에서 제목 4곳 · 설명 2곳이다
     ('Wireless vibration sensor / mounting', 'Assessment against ISO / 20816' 등).
     balance는 줄 수를 늘리지 않고 폭만 고르게 맞추므로 카드 높이가 그대로고,
     pretty는 마지막 줄만 손봐 앞 줄을 건드리지 않는다. 산업 페이지 카드와 같은 처방이다.
     일곱 유즈케이스 · 두 언어를 1440 · 1280 · 1100 · 960 · 768px 에서 재어
     낱말 혼자 남는 자리가 78곳 -> 33곳으로 줄었고 넘침은 양쪽 모두 0이다.
     .uc-redesigned 가 아니라 .uc-page 에 거는 것은 재단장하지 않은 유즈케이스가
     생겨도 같이 적용되게 하기 위해서다(지금은 일곱 개가 모두 redesigned 다).
     지원하지 않는 브라우저는 지금 모습 그대로다. */
  .uc-page .ind-card h3 { text-wrap: balance; }
  /* 해결 방법 카드의 제목 칸을 두 줄 높이로 잡고 글자를 아래에 붙인다. 영문은 제목
     길이가 카드마다 달라 한 페이지 안에서 한 줄과 두 줄이 섞이고, 두 줄인 카드만
     본문이 32px 내려앉아 가로로 늘어선 카드끼리 시작선이 어긋났다
     (전력관리 [1,1,1,2] · 전력품질 [1,2,1,1] · 공장에너지 [1,1,2,2]).
     아래 끝을 고정하는 쪽이라 한 줄 제목은 지금 자리를 그대로 지키고, 두 줄 제목만
     아이콘 쪽 여백(65px)을 한 줄만큼 먹으며 위로 자란다.
       한 줄  칸 위 -32 + 글자 아래 32  -> 아이콘에서 65px (그대로)
       두 줄  칸 위 -32 + 글자 가득 64  -> 아이콘에서 33px
     줄 높이 32px(20px * 1.6)에 맞춘 값이다. 산업 페이지 도입 효과 카드와 같은 규칙이다.
     제목이 모두 평문이라 flex 로 둬도 줄 나눔이 깨지지 않는다. */
  .uc-page .ind-grid-3 .ind-card h3 {
    min-height: 64px; margin-top: -32px;
    display: flex; align-items: flex-end;
  }
  /* 네 제목이 모두 두 줄인 페이지에는 걸지 않는다. 위 보정은 '한 줄 제목 옆에 선
     두 줄 제목'을 끌어올려 본문 시작선을 맞추는 것인데, 모두 두 줄이면 시작선이
     이미 맞아 있고 보정만 먹어 페이지가 통째로 32px 위로 당겨진다 — 아이콘과 제목
     사이가 69px -> 37px 이 되어 그 페이지만 다른 페이지보다 좁아 보인다.
     1440px 에서 그런 페이지는 영문 예지보전 하나뿐이다(국문은 네 제목이 모두 한 줄).
     줄 수가 섞인 전력관리 [1,1,1,2] · 전력품질 [1,2,1,1] · 공장에너지 [1,1,2,2] 는
     위 규칙을 그대로 쓴다. */
  .uc-predictive-maintenance.uc-en .ind-grid-3 .ind-card h3 {
    min-height: 0; margin-top: 0; display: block;
  }
  /* 카드가 넷인 영문 유즈케이스의 해결 방법 카드를 2열로 둔다
     (예지보전 · 전력관리 · 전력품질 · 공장에너지관리). 카드가 넷이라 4열(칸 233px)인데, 영문은
     한 줄에 네댓 낱말뿐이라 제목이 두 줄 · 설명이 다섯 줄이 되고 'in / real time' ·
     'at a / glance' · 'early / signs' 처럼 의미 덩어리가 갈렸다. 그 폭에서는 끊지 말아야 할
     자리를 모두 피하는 분할이 존재하지 않아 자연 감김으로 두었는데, 2열(칸 500px 남짓)
     에서는 제목이 모두 한 줄, 설명이 두세 줄이 되어 갈림이 사라진다.
       3열도 재 봤다. 글은 가장 알맞지만 카드가 넷이라 마지막 줄에 한 장만 남아 격자가
     깨진다. 2열은 2x2 로 떨어진다.
       국문은 네 제목이 모두 한 줄이라 4열이 잘 맞아 그대로 둔다.
       860px 이하 1열은 공통 규칙이 맡는데 이 선택자가 더 강해 같은 경계에서 되돌린다. */
  .uc-predictive-maintenance.uc-en .ind-grid-3,
  .uc-power-management.uc-en .ind-grid-3,
  .uc-power-quality.uc-en .ind-grid-3,
  .uc-factory-energy.uc-en .ind-grid-3 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (max-width: 860px) {
    .uc-predictive-maintenance.uc-en .ind-grid-3,
    .uc-power-management.uc-en .ind-grid-3,
    .uc-power-quality.uc-en .ind-grid-3,
    .uc-factory-energy.uc-en .ind-grid-3 { grid-template-columns: 1fr; }
  }
  .uc-page .ind-card p { text-wrap: pretty; }
  /* '다른 과제' 카드 설명도 같은 방식으로 둔다. 영문은 데이터에 <br>로 두 줄을
     잡아 뒀는데 1행이 칸(333px)보다 길어 세 카드가 실제로는 세 줄로 감겼다
     (전력품질 · 공장에너지관리 · 품질예측, 일곱 페이지 전부). 끊는 자리를 다시
     지정해도 줄 끝에 into · and 같은 기능어가 남아, <br>를 걷고 balance 에 맡긴다.
     폭이 바뀌어도 적응하고, <br>가 없으니 번역기가 문장을 쪼개지도 않는다.
     국문은 <br>를 그대로 둔다 — 칸 187~226px 에 여섯 개가 모두 두 줄로 들어간다. */
  .uc-case-desc { text-wrap: balance; }

  /* 템플릿 밴드 2컬럼 (template.image 있을 때만) */
  .uc-template--split { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 34px; align-items: center; }
  .uc-template--split .uc-template-list { grid-template-columns: 1fr; }
  .uc-template-figure { margin: 0; }
  .uc-template-figure img {
    display: block; width: 100%; height: auto;
    border: 1px solid #E3E7EC; border-radius: 12px; background: #fff;
  }
  @media (max-width: 900px) {
    .uc-template--split { grid-template-columns: 1fr; gap: 24px; }
  }

  /* ───────────────────────────────────────────────────────────
     예지보전 전용 — 이 slug 클래스 아래에서만 적용된다.
     ─────────────────────────────────────────────────────────── */

  /* 본문 섹션의 좌우 끝을 헤더(.nav-inner)와 같은 선에 맞춘다 — 로고 왼쪽 = 문의하기 버튼 오른쪽.
     .ind-section만 대상이라 히어로(.ind-hero, 이미 uc-container--nav)와 CTA(.ind-cta)는 제외된다.
     선택자가 .uc-narrow(2개)보다 구체적(3개)이라 좁은 폭 제약도 함께 풀린다. */
  .uc-redesigned .ind-section .ind-container {
    max-width: 1600px;
    padding: 0 48px;
  }
  /* 섹션 위아래 여백을 랜딩 본문 섹션과 같은 130px으로. (공통값은 84px)
     CTA는 랜딩 #cta와 같은 95px이라 여기서 제외된다(.ind-section이 아님). */
  .uc-redesigned .ind-section { padding: 130px 0; }
  @media (max-width: 900px) {
    .uc-redesigned .ind-section { padding: 60px 0; }
  }
  @media (max-width: 900px) {
    .uc-redesigned .ind-section .ind-container { padding: 0 24px; }
  }

  /* 카드 수만큼 한 줄에 둔다 — 3개면 3열, 4개면 4열. 고정 3컬럼이면 카드가
     4개일 때 마지막 하나가 혼자 떨어지고, 4컬럼이면 3개일 때 한 칸이 빈다.
     --uc-cols는 마크업에서 uc.how.length로 넣는다. */
  .uc-redesigned .ind-grid-3 { grid-template-columns: repeat(var(--uc-cols, 3), minmax(0, 1fr)); }
  @media (max-width: 1080px) {
    .uc-redesigned .ind-grid-3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .uc-redesigned .ind-grid-3 { grid-template-columns: 1fr; }
  }

  /* 히어로 버튼 2개를 메인 CTA의 '데모 신청하기'와 같은 형태로 통일한다.
     global.css: .btn-primary(밝은 배경용) + #cta .btn-primary(어두운 배경 override).
     CTA는 배경 이미지 위라 흰색 계열이지만 이 히어로는 밝은 배경(#f6f8fa)이므로,
     형태(투명 배경·1px 테두리·radius 6px·9px 22px·15px/400)만 가져오고
     색은 .btn-primary의 밝은 배경용 기본값을 쓴다. hover는 CTA와 동일. */
  .uc-redesigned .ind-hero-actions .ind-btn-primary,
  .uc-redesigned .ind-hero-actions .ind-btn-ghost {
    padding: 9px 22px;
    font-size: 15px;
    font-weight: 400;
    background: transparent;
    color: #191F27;
    border: 1px solid rgba(17, 17, 17, 0.6);
    border-radius: 6px;
    transition: all .2s;
  }
  .uc-redesigned .ind-hero-actions .ind-btn-primary:hover,
  .uc-redesigned .ind-hero-actions .ind-btn-ghost:hover {
    background: #76a6d7;
    border-color: #76a6d7;
    color: #fff;
    transform: none; /* .ind-btn-primary:hover의 translateY 상쇄 */
  }

  /* 큰 제목 3종(히어로·섹션·CTA)의 공통값. 랜딩 섹션 대제목과 같은 clamp 28~45px.
     굵기는 배경에 따라 갈리므로 여기서 정하지 않는다(아래 두 규칙).
     ⚠️ 사진이 글 아래로 내려온 히어로(.ind-hero-bg)는 뺀다 — 산업 상세와 같이
        한 단 큰 clamp(30px, 4.2vw, 54px) / -0.03em 을 쓴다(industry.css).
        히어로 대제목이 그 아래 섹션 제목(45px)과 같으면 계층이 눌린다. */
  .uc-redesigned .ind-hero:not(.ind-hero-bg) h1,
  .uc-redesigned .ind-head h2,
  .uc-redesigned .ind-cta h2 {
    font-size: clamp(28px, 4vw, 45px);
    letter-spacing: -0.8px;
    line-height: 1.3;
  }
  /* 히어로는 페이지의 첫 제목이라 섹션 제목과 같은 600으로 둔다.
     어두운 배경 위 흰 글자라 실제보다 굵게 보이지만, 그만큼 무게가 실리는 것을 택했다. */
  /* 히어로와 섹션 제목은 같은 600. 흰 글자가 어두운 사진 위에서 번져 보여
     히어로가 조금 더 굵게 읽히지만, 500으로 내리면 한 단계가 통째로 빠져
     최상위 제목이 가벼워진다. Pretendard가 100 단위 정적 웨이트라
     그 사이값(550)은 600으로 스냅돼 쓸 수 없다. */
  .uc-redesigned .ind-hero h1,
  .uc-redesigned .ind-head h2 { font-weight: 600; }
  /* CTA만 500 — 랜딩 #cta가 섹션 대제목(600)과 다르게 500을 쓰는 것을 따른다. */
  .uc-redesigned .ind-cta h2 { font-weight: 500; }

  /* '왜 필요한가요?' 섹션 배경. 흰색이던 것을 연회색으로 둬,
     히어로(사진) → 문제(연회색) → 해법(어두움)으로 면이 이어지게 한다. */
  .uc-redesigned .uc-problem-section { background: #f6f8fa; }

  /* 태그라인을 왼쪽, 본문을 그 오른쪽에 두고 윗선을 맞춘다.
     align-items: start — 두 칸의 높이가 달라도 첫 줄끼리 정렬된다.
     .ind-head의 아래 여백(64px)은 2열에서는 필요 없어 없앤다. */
  .uc-redesigned .uc-problem-section .ind-container {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 40px;
    align-items: start;
  }
  .uc-redesigned .uc-problem-section .ind-head { margin-bottom: 0; }
  /* margin: 0 — .ind-head p가 margin-top 12px를 걸어 태그라인만 12px 내려간다. */
  .uc-redesigned .uc-problem-section .uc-tag { margin: 0; }
  @media (max-width: 860px) {
    .uc-redesigned .uc-problem-section .ind-container {
      grid-template-columns: 1fr; gap: 16px;
    }
  }

  /* ───────────────────────────────────────────────────────────
     'Refinery는 이렇게 풉니다' 섹션을 랜딩 'From Data to Intelligence'(#platform)와
     같은 구성으로. 실측값: 섹션·카드 면 #191F27, 카드 테두리 #292F37,
     제목 #F6F8FA, 설명 #A0A8B3, 아이콘 accent.
     카드 면이 섹션 면과 같아서 테두리만으로 구분되는 것이 그 섹션의 특징이다.
     이 페이지에만 적용 — .ind-soft/.ind-card/.uc-template은 다른 유즈케이스도 함께 쓴다.
     ─────────────────────────────────────────────────────────── */
  .uc-redesigned .ind-soft { background: #191F27; }
  .uc-redesigned .ind-soft .ind-head h2 { color: #F6F8FA; }
  .uc-redesigned .ind-soft .ind-card {
    background: #191F27; border: 1px solid #292F37;
  }
  /* hover는 랜딩 #integrations의 .rfn-node와 같은 방식 —
     테두리 색을 바꾸지 않고 box-shadow로 2px 링을 덧대고 그림자를 한 단계 키운다.
     레이아웃이 흔들리지 않고, 링크가 아닌 카드에 '누를 수 있다'는 신호도 주지 않는다. */
  .uc-redesigned .ind-soft .ind-card,
  .uc-redesigned .uc-template {
    box-shadow: 0 1px 2px rgba(0,0,0,.35), 0 1px 1px rgba(0,0,0,.25);
    transition: box-shadow .15s;
  }
  .uc-redesigned .ind-soft .ind-card:hover,
  .uc-redesigned .uc-template:hover {
    box-shadow: 0 0 0 2px #292F37, 0 2px 4px rgba(0,0,0,.35), 0 1px 1px rgba(0,0,0,.25);
  }
  .uc-redesigned .ind-soft .ind-card h3 { color: #F6F8FA; }
  .uc-redesigned .ind-soft .ind-card p { color: #A0A8B3; }

  /* WISE 밴드도 같은 계열 — 면이 섹션과 같으므로 테두리로 구분한다. */
  /* 밴드가 섹션 배경(#191F27)과 같은 색이라 1px 테두리로만 구분됐다.
     오른쪽에서 배어 나오는 하늘색 글로우로 '여기부터 다른 이야기'를 표시한다.
     장식 이미지가 있는 쪽과 방향을 맞춰 빛이 한 곳에서 오는 것처럼 보이게 한다.
     글이 있는 왼쪽은 원래의 #111316이라 대비가 손상되지 않는다. */
  /* 우측 상단 장식 — 글 뒤에 깔린다(.uc-template-body가 z-index로 위). */
  .uc-template-deco {
    /* 링 중심을 밴드 밖(우상단)에 두고 바깥 호만 밴드에 걸치게 한다.
       크기와 오프셋을 같은 비율로 묶어 두면 구도는 그대로 두고 스케일만 바뀐다. */
    /* ⚠️ 고정 px이 아니라 밴드 폭에 대한 비율이다. 예전에는 700px/-212/-148로
       못 박아 두고 860px 아래에서는 통째로 감췄는데, 밴드가 좁아져도 링만 그대로라
       구도가 깨졌기 때문이다. 세 값을 같은 비율로 묶으면 어느 폭에서든 구도가 같다.
       1440px 기준값을 그대로 환산했다 — 700/1184 = 59.1%, -148/1184 = -12.5%,
       세로는 자기 높이 기준이다. 이미지가 2100x1224(0.583)라 1440px에서 높이가
       407px이므로 -212/407 = -52.1%. 정사각으로 잘못 보고 -30.3%을 넣었더니
       링이 밴드 위로 122px만 나가(원래 211px) 아래로 내려앉았다. */
    position: absolute; top: 0; right: -12.5%;
    width: 59.1%; height: auto;
    transform: translateY(-52.1%);
    /* screen — 어두운 픽셀은 배경을 그대로 통과시키고 밝은 부분만 더한다.
       일반 합성이면 링의 어두운 부분이 배경보다 더 어둡게 깔려 '얹힌 그림'이 된다.
       빛이라면 밝은 곳만 더해져야 하므로 이쪽이 맞다. */
    mix-blend-mode: screen;
    opacity: .25;
    /* 우상단에서 멀어질수록 사라진다. 단계를 여럿 두어 이징 곡선을 흉내 낸다 —
       두 점짜리 직선 램프는 사라지기 시작하는 지점(기존 55%)에 경계가 보였다. */
    -webkit-mask-image: radial-gradient(140% 140% at 100% 0%, #000 0%, rgba(0,0,0,.92) 35%, rgba(0,0,0,.68) 55%, rgba(0,0,0,.34) 72%, rgba(0,0,0,.10) 86%, transparent 100%);
    mask-image: radial-gradient(140% 140% at 100% 0%, #000 0%, rgba(0,0,0,.92) 35%, rgba(0,0,0,.68) 55%, rgba(0,0,0,.34) 72%, rgba(0,0,0,.10) 86%, transparent 100%);
    pointer-events: none; user-select: none;
  }
  .uc-template-body { position: relative; z-index: 1; }
  /* 860px 이하 display:none을 걷었다 — 이제 비율로 줄어들어 감출 이유가 없다. */

  /* 위 여백은 4개 카드(.ind-card, 24px)와 같게 둔다 — 배지가 카드의 아이콘과
     같은 자리에서 시작하므로 두 블록의 윗선이 맞는다. */
  .uc-redesigned .uc-template { padding-top: 24px; }
  /* 배지→제목 간격을 위 4개 카드의 아이콘→제목(65px)과 같게 맞춘다.
     배지가 카드의 아이콘과 같은 자리(묶음 맨 위)에 놓이므로 리듬이 이어진다. */
  .uc-redesigned .uc-template h3 { margin-top: 65px; }
  .uc-redesigned .uc-template {
    position: relative; overflow: hidden;
    /* 빛의 원점을 장식 이미지와 같은 우상단 모서리에 둔다. 직선 그라데이션은
       모든 높이에서 밝기가 같아 '오른쪽 벽이 빛난다'로 보였다 — 장식은 모서리에서
       퍼지는데 빛은 변에서 오니 광원이 둘로 읽혔다.
       단계는 감소폭을 줄여가며 놓아 이징 곡선을 흉내 낸다. 직선 램프는 끝나는
       지점(기존 55%)에 눈에 띄는 경계가 생기고, 어두운 면 위 낮은 알파라
       띠(밴딩)도 잘 보인다. */
    background:
      radial-gradient(100% 140% at 100% 0%,
        rgba(118,166,215,.20) 0%,
        rgba(118,166,215,.13) 20%,
        rgba(118,166,215,.06) 40%,
        rgba(118,166,215,.02) 58%,
        rgba(118,166,215,0) 74%),
      #191F27;
    border: 1px solid #292F37;
  }
  .uc-redesigned .uc-template h3 { color: #F6F8FA; }
  .uc-redesigned .uc-template p { color: #A0A8B3; }
  .uc-redesigned .uc-template-list li { color: #F6F8FA; }
  .uc-redesigned .uc-template-list li i { color: #76a6d7; }

  /* 대제목과 그 아래 내용 사이 간격. 공통값(.ind-head 44px)보다 넓혀
     섹션이 시작되는 지점을 또렷하게 한다. 페이지 안 세 섹션에 같이 적용해
     간격 리듬이 어긋나지 않게 한다. */
  .uc-redesigned .ind-head { margin-bottom: 64px; }

  /* '왜 필요한가' 본문을 리드 문단처럼 강조 */
  /* 제목(h2)이 생기면서 상자·왼쪽 선이 없어도 구간이 구분된다. 글만 둔다.
     크기·색은 랜딩 섹션 소제목(.section-header p)과 같은 값. */
  .uc-redesigned .uc-problem {
    font-size: 18px; line-height: 1.7; color: var(--text-muted);
  }
  .uc-redesigned .uc-narrow { max-width: 820px; }


  /* 신호 섹션 — 머리 칸부터 카드까지 가운데로 모은다.
     ⚠️ .ind-head 는 공통값이 max-width 640px 에 왼쪽 정렬이라 둘 다 푼다.
     소제목은 한 줄로 두고 싶어 폭을 따로 잡는다 — 640px 을 풀면 본문 폭(820px)
     까지 늘어나 두 줄이 되는 쪽이 없지만, 영문이 길어 나중을 위해 남겨 둔다. */
  .uc-signal-section .ind-head { max-width: none; text-align: center; }
  .uc-signal-section .ind-head p { max-width: 640px; margin-inline: auto; }

  /* 신호 카드 — signalsAsCards를 켠 유즈케이스에만 렌더된다.
     정사각형 카드를 가운데로 모은다. 칸을 늘려 본문 너비를 채우지 않는다 —
     양옆 여백이 커도 괜찮다. */
  /* ⚠️ 격자가 아니라 flex 다. 격자로 열 수를 정하면(옛 --uc-sig-cols) 신호가
     5개인 과제에서 3열 x 2행이 되어 오른쪽 아래 한 칸이 빈 채로 남았다.
     신호는 과제마다 3~6개다. 크기를 고정하고 가운데로 모으면 개수와 무관하게
     한 줄로 서고, 줄이 짧으면 양옆 여백이 넓어질 뿐이다.
     ⚠️ 200px + gap 16 이면 6개가 1280px 이다. 1440 화면의 본문 너비 1329px 안에
        49px 여유를 두고 들어간다 — 경계에 바짝 붙이지 않는다. */
  .uc-signal-cards {
    display: flex; flex-wrap: wrap; justify-content: center;
    gap: 16px;
    /* 카드마다 윗변을 어긋내므로 위로 맞춘다. stretch 로 두면 margin-top 이
       밀어낸 만큼 칸이 늘어나 정사각이 깨진다. */
    align-items: flex-start;
  }
  /* 윗변을 세 단으로 어긋낸다 — 0 · 44 · 22px 이 되풀이된다.
     두 단(짝수만 내리기)으로 하면 규칙적인 지그재그가 되어, 어긋났다기보다
     두 줄로 보인다. 세 단이면 되풀이 주기가 길어 들쑥날쑥하게 읽힌다.
     ⚠️ transform 이 아니라 margin-top 이다. 스크롤 등장 모션(ScrollReveal)이
        같은 요소의 transform 을 translateY(16px) → none 으로 쓰기 때문에,
        transform 으로 어긋내면 카드가 뜨는 순간 어긋남이 지워진다. */
  .uc-signal:nth-child(3n+2) { margin-top: 44px; }
  .uc-signal:nth-child(3n)   { margin-top: 22px; }
  /* 카드 상자 없이 원형 아이콘과 라벨만 세로로 쌓는다. */
  /* 카드 면색은 'Refinery는 이렇게 풉니다' 섹션 배경(.ind-soft)과 같은 --bg-soft.
     이 섹션은 흰 배경이라 별도 테두리 없이 면색만으로 카드가 구분된다. */
  /* ⚠️ 정사각형이다. width 와 height 를 같은 값으로 박는다 — aspect-ratio 는
     안쪽 내용이 넘칠 때 상자를 늘려 버려 정사각이 깨진다.
     내용은 세로 가운데로 모은다(justify-content). */
  .uc-signal {
    display: flex; flex-direction: column;
    align-items: center; justify-content: center; text-align: center;
    flex: 0 0 auto; width: 200px; height: 200px;
    gap: 14px; padding: 18px 14px;
    background: var(--bg-soft); border: none;
    border-radius: var(--radius);
  }
  /* 클레이 3D 아이콘(public/icons/usecase/*.webp) 자리.
     ⚠️ 파란 원 바탕을 걷었다. 전에는 흰 선 아이콘이라 원이 바탕을 맡았지만,
        새 한 벌은 제 안에 흰 면과 브랜드색을 다 가지고 있어 파란 원 위에 놓으면
        흰 몸통이 뜨고 브랜드색 디테일은 묻힌다.
     ⚠️ 88px 은 200px 정사각 안에서 아이콘 + 2줄 라벨이 들어가는 최대값이다
        (88 + 간격 14 + 두 줄 52 + 위아래 여백 36 = 190). 영문 라벨이 길어
        2줄이 되는 것이 다섯 쪽이라 여기서 더 키우면 카드 밖으로 넘친다. */
  .uc-signal-icon {
    width: 88px; height: 88px; flex: none;
    display: flex; align-items: center; justify-content: center;
  }
  .uc-signal-icon img { width: 88px; height: 88px; display: block; }
  /* Phosphor 로 넣은 신호가 있을 때만 보인다. 바탕이 밝으므로 브랜드색으로 그린다. */
  .uc-signal-icon i { font-size: 44px; line-height: 1; color: #76a6d7; }
  /* ⚠️ 20px 이던 것을 18px 로 줄였다. 200px 정사각 안에서 긴 라벨이 3줄로
     넘어가지 않게 하는 값이다 — 영문 'Consumption by time of day' 가 기준이다. */
  .uc-signal-label { font-size: 18px; font-weight: 600; color: var(--text); line-height: 1.45; }
  /* ⚠️ 좁은 폭용 열 수 분기가 없다. flex-wrap 이 알아서 한 줄에 들어갈 만큼만
     담고 나머지를 다음 줄로 넘긴다 — 카드 크기가 고정이라 열 수를 셀 까닭이 없다. */

  /* ───────────────────────────────────────────────────────────
     CTA — 랜딩 #cta와 같은 형태(배경 이미지 위 흰 글자·좌측 정렬).
     데이터에 ctaBackgroundImage를 넣은 유즈케이스에만 적용된다.
     h2에 .uc-page를 덧붙인 이유: Astro가 컴파운드마다 [data-astro-cid]를 붙이므로
