---
/**
 * 히어로 그래픽이 스크롤을 따라 자란다.
 *
 * 처음에는 카피 아래 칸에 담겨 있고, 히어로의 스크롤 구간을 내려가는 동안 위로
 * 자라 카피를 덮으며 한 화면을 가득 채운다.
 *
 * 진행도(0~1)를 --hero-p 로 넘기고, 칸을 얼마나 끌어올릴지는 CSS 가 정한다.
 * 레이아웃은 global.css 의 #hero · .hero-stage 가 쥔다.
 */
---

<style is:global>
  /* 칸을 카피 높이(--hero-copy-h)만큼 위로 끌어올린다. .hero-stage 가 flex 라
     칸은 margin 으로 줄어든 자리를 그대로 높이로 돌려받는다 — 위로 자라는 셈이다.
     --hero-copy-h 는 카피가 실제로 차지한 높이이고 JS 가 재어 넣는다. */
  .hero-motion-placeholder {
    /* 멈춰 있을 때는 카피와 --hero-slot-gap 만큼 떨어져 있다가, 자라면서 그 틈까지
       먹으며 카피 위로 올라선다. p 가 1 이면 -카피높이 로 전과 같은 자리다.
       35px 은 대제목과 소제목 사이와 같은 값이다(#hero h1 의 margin-bottom —
       소제목의 margin-top 18px 을 흡수한다). */
    --hero-slot-gap: 35px;
    margin-top: calc(
      var(--hero-slot-gap, 35px)
      - var(--hero-p, 0) * (var(--hero-slot-gap, 35px) + var(--hero-copy-h, 0px))
    );
    /* 상한은 화면 높이에 비례해 둔다. px 로 박으면 세로로 긴 화면에서만 남는 자리가
       상한을 크게 넘어 틈이 제멋대로 벌어진다(450px 일 때 1585×1200 에서 350px). */
    max-height: calc(62vh + 1600px * var(--hero-p, 0));
  }
  /* 낮아진 칸은 무대 바닥 쪽에 세운다 — 카피 바로 아래에 붙이면 그 아래가 통째로
     빈다. 자라면서 남는 자리가 줄면 이 여백도 함께 사라진다. */
  #hero .container { margin-bottom: auto; }
  /* 카피는 옅어지지 않는다 — 다 자란 모습이 '그래픽 위에 카피가 얹힌' 전의 히어로다. */

  /* 마커(+ 원과 기둥)는 자라면서 생긴다. 멈춰 있을 때는 그래픽만 보인다.
     p 0.25 까지는 음수라 0 으로 깎이고, 0.7 에서 다 보인다. */
  .hero-motion-placeholder .vh-marker {
    opacity: calc((var(--hero-p, 0) - 0.25) * 2.2);
  }
  /* ⚠️ .vh-head 를 포인터가 닿는 요소로 되살린다. 원본 CSS 는 마커 레이어를 통째로
     pointer-events: none 으로 두고 .vh-pin 만 auto 로 켜는데, 카드를 여는 리스너는
     vetec-hero.js 가 .vh-head 에 건다(pointerenter). none 인 요소에는 포인터가
     '들어왔다'는 판정 자체가 서지 않아 — 자식인 핀이 auto 라도 — 호버로 카드가
     열리지 않았다. 합성 이벤트로는 열리는데 실제 마우스로는 안 열리던 원인이다. */
  .hero-motion-placeholder .vh-head { pointer-events: auto; }
  /* 다 자라기 전에는 핀을 누르거나 올릴 수 없다 — 흐릿하게 비치는 동안 카드가 뜨면
     그래픽을 가린다. is-grown 은 JS 가 p 를 보고 붙인다. */
  #hero:not(.is-grown) .hero-motion-placeholder .vh-head,
  #hero:not(.is-grown) .hero-motion-placeholder .vh-pin { pointer-events: none; }
  @media (prefers-reduced-motion: reduce) {
    .hero-motion-placeholder .vh-marker { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-motion-placeholder { margin-top: 0; max-height: none; }
  }
</style>

<script is:inline>
  (function () {
    var d = document;
    if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    function start() {
      var hero = d.getElementById('hero');
      var stage = hero && hero.querySelector('.hero-stage');
      var copy = hero && hero.querySelector('.container');
      if (!hero || !stage || !copy) return;

      var ZOOM = 0.38;   // 구간 중 자라는 데 쓰는 몫. 나머지는 다 자란 채로 머문다.
      var run = 0, copyH = 0, ticking = false;

      /* 구간 길이는 '히어로 전체 높이 - 무대 한 화면'이다. 이 만큼을 내려가는 동안
         진행도가 0 에서 1 로 간다. 카피 높이는 margin 이 먹기 전의 값이라야 해서
         --hero-p 를 0 으로 되돌린 뒤 잰다. */
      function measure() {
        hero.style.setProperty('--hero-p', '0');
        copyH = copy.getBoundingClientRect().height;
        hero.style.setProperty('--hero-copy-h', copyH + 'px');
        var sr = stage.getBoundingClientRect();
        run = hero.getBoundingClientRect().height - sr.height;
        if (run < 1) run = 1;
        /* 다 자란 자리에서 칸이 갖게 될 높이. 그래픽을 늘 이 높이로 그려 두면 칸이
           낮은 동안에도 배율이 같아, 보이는 것이 다 자란 모습의 아랫부분이 된다.
           무대 높이에서 헤더와 아래 여백(--hero-edge)을 뺀 값이다. */
        var cs = getComputedStyle(hero);
        var headerH = parseFloat(cs.getPropertyValue('--header-h')) || 70;
        var edge = parseFloat(cs.getPropertyValue('--hero-edge')) || 16;
        hero.style.setProperty('--hero-full-h', (sr.height - headerH - edge).toFixed(0) + 'px');
      }

      function step() {
        ticking = false;
        /* 히어로 윗변이 화면 위로 올라간 거리 / 다 자라는 데 쓰는 길이.
           구간 전체가 아니라 앞쪽 ZOOM 만 쓴다 — 남는 뒤쪽이 '다 자란 모습'을
           잠시 머무르게 하는 자리다. 구간을 다 쓰면 p 가 1 이 되는 순간 무대가
           sticky 를 놓고 올라가 버려 꽉 찬 모습을 볼 틈이 없다. */
        var passed = -hero.getBoundingClientRect().top;
        var p = passed / (run * ZOOM);
        if (p < 0) p = 0;
        if (p > 1) p = 1;
        hero.style.setProperty('--hero-p', p.toFixed(4));
        // 다 자란 뒤에야 마커를 만질 수 있다.
        hero.classList.toggle('is-grown', p > 0.9);
      }

      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(step);
      }

      measure();
      step();
      addEventListener('scroll', onScroll, { passive: true });
      addEventListener('resize', function () { measure(); step(); }, { passive: true });
      // 글꼴이 늦게 와서 카피 높이가 바뀌면 다시 잰다.
      if (d.fonts && d.fonts.ready) d.fonts.ready.then(function () { measure(); step(); });
    }

    if (d.readyState === 'loading') d.addEventListener('DOMContentLoaded', start);
    else start();
  })();
</script>
