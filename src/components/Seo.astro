---
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogType?: string;
  robots?: string;
  jsonLd?: unknown;
  /** hreflang 대체 링크. 로케일별 페이지가 모두 존재할 때만 전달(없으면 미출력). */
  alternates?: { lang: string; href: string }[];
  ogLocale?: string;
}

const {
  title,
  description,
  canonical,
  ogTitle,
  ogDescription,
  ogImage = '/og-image.png',
  ogType = 'website',
  robots = 'index, follow',
  jsonLd,
  alternates,
  ogLocale = 'ko_KR',
} = Astro.props;

const canonicalURL = new URL(canonical ?? Astro.url.pathname, Astro.site);
// hreflang: x-default는 기본 로케일(ko)로.
const hreflangs = alternates?.map((a) => ({
  hreflang: a.lang,
  href: new URL(a.href, Astro.site).href,
}));
const ogImageURL = new URL(ogImage, Astro.site);
const _ogTitle = ogTitle ?? title;
const _ogDesc = ogDescription ?? description;
---
{/* translate="no" — 제목이 통째로 원문으로 남는다. 탭 제목은 번역되지 않지만
    브랜드가 번역되는 것을 막는다(2026-09-29 영어 백서 title의 Refinery가
    '정유소'로 나왔다. 검증 §6.1의 랜딩 '정유 산업용 AI OS'와 같은 뿌리다).
    <title> 안에는 태그를 못 넣어 <span translate="no">로 낱말만 막을 수 없다 —
    본문에서는 그 방식을 쓴다. */}
<title translate="no">{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonicalURL} />
{hreflangs && (
  <>
    {hreflangs.map((h) => <link rel="alternate" hreflang={h.hreflang} href={h.href} />)}
    <link rel="alternate" hreflang="x-default" href={hreflangs[0].href} />
  </>
)}

<meta property="og:title" content={_ogTitle} />
<meta property="og:description" content={_ogDesc} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content="Refinery" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={_ogTitle} />
<meta name="twitter:description" content={_ogDesc} />
<meta name="twitter:image" content={ogImageURL} />

{jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
