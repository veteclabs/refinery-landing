---
// 자료실 페이지. 한국어(/resources)와 영어(/en/resources)가 이 컴포넌트를 공유한다.
// ⚠️ 초안(준비중). 실제 자료가 준비되면 각 카드에 다운로드 링크(href)를 채우고 soon 상태를 해제한다.
// 고객 사례는 실제 확인된 내용만 게시(가공/창작 금지).
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import '../styles/industry.css';

interface Props {
  lang?: 'ko' | 'en';
}
const { lang = 'ko' } = Astro.props;

// cover: 이미지 위에 얹는 한 줄(명사구). 카드 아래 대제목은 문장으로 두고,
// 표지 역할을 하는 이 줄만 명사구로 짧게 쓴다.
type ResItem = { icon: string; label: string; desc: string; kind: string; href?: string; draft?: boolean; image?: string; cover?: string };

const T = {
  ko: {
    title: '자료실 | Refinery',
    description: 'Refinery 제품 소개서·백서·도입 가이드·웨비나 등 자료를 준비하고 있습니다. 필요한 자료는 문의로 요청해 주세요.',
    canonical: '/resources',
    h1: '자료실',
    lede: '플랫폼 개요와 백서, 리포트까지 Refinery를 더 깊이 살펴볼 수 있는 자료를 모았습니다.',
    noteBefore: '자료를 정리하는 중입니다. 지금 필요한 자료가 있으시면 ',
    noteAfter: '로 요청해 주세요. 준비되는 대로 우선 보내드립니다.',
    contactLabel: '문의하기', contactHref: '/contact',
    draftTag: '초안 미리보기', soon: '준비중',
    resources: [
      { icon: 'ph-file-text', label: '하나의 플랫폼으로 현장을 지능화합니다', desc: '핵심 기능과 도입 효과, 산업별 활용을 한 페이지로', kind: '플랫폼 개요', href: '/why-refinery', image: '/resources/platform-overview.webp', cover: '현장을 지능화하는<br>하나의 플랫폼' },
      { icon: 'ph-book-open', label: '흩어진 데이터를 하나의 지식으로', desc: '흩어진 현장 데이터를 하나의 지식으로 잇는 방법론', kind: '백서', href: '/whitepapers/data-integration' },
      { icon: 'ph-robot', label: '근거를 들어 판단을 돕는 AI', desc: '온톨로지 기반 AI가 근거를 들어 판단하는 구조', kind: '백서', href: '/whitepapers/ai-agent' },
      { icon: 'ph-chart-line-up', label: '2026 산업 데이터·AI 활용 리포트', desc: '데이터 활용 현황과 통합 지능·AI 에이전트 도입 흐름', kind: '리포트', href: '/reports/2026-industrial-data', draft: true },
      { icon: 'ph-projector-screen', label: '웨비나 · 데모 영상', desc: '제품 시연과 현장 적용 사례를 영상으로', kind: '비디오' },
      { icon: 'ph-buildings', label: '산업별 활용 자료', desc: '에너지·제조·물류·공공 등 산업별 적용 포인트', kind: '키트' },
    ] as ResItem[],
  },
  en: {
    title: 'Resources & whitepapers | Refinery',
    description: 'Product overviews, whitepapers, adoption guides and webinars are in preparation. Ask us for anything you need in the meantime.',
    canonical: '/en/resources',
    h1: 'Resources & whitepapers',
    lede: 'From product overviews to whitepapers, adoption guides and webinars — material to understand Refinery more deeply is in preparation.',
    noteBefore: 'Material is being put together. If there is something you need right now, ask us through ',
    noteAfter: ' and we will send it to you first.',
    contactLabel: 'Contact', contactHref: '/en/contact',
    draftTag: 'Draft preview', soon: 'Soon',
    // 영어판 자료가 아직 없어 링크 없이 Soon으로 둔다.
    // (한국어 백서·리포트로 보내면 영어 방문자가 한국어 문서를 받게 된다)
    resources: [
      { icon: 'ph-file-text', label: 'Product overview', desc: 'Core capabilities, what you gain, and use by industry — on one page', kind: 'Platform overview', image: '/resources/platform-overview.webp', cover: 'One platform for<br>an intelligent site' },
      { icon: 'ph-book-open', label: 'Whitepaper · Industrial data integration', desc: 'A method for connecting scattered site data into one body of knowledge', kind: 'Whitepaper' },
      { icon: 'ph-robot', label: 'Whitepaper · Industrial AI agents', desc: 'How ontology-based AI reasons with the evidence behind it', kind: 'Whitepaper' },
      { icon: 'ph-chart-line-up', label: '2026 Industrial Data & AI Report', desc: 'How data is being used, and where integrated intelligence and AI agents are heading', kind: 'Report' },
      { icon: 'ph-projector-screen', label: 'Webinars & demo videos', desc: 'Product walkthroughs and field applications on video', kind: 'Video' },
      { icon: 'ph-buildings', label: 'Industry kits', desc: 'Application points for energy, manufacturing, logistics, public sector and more', kind: 'Kit' },
    ] as ResItem[],
  },
}[lang];
---

<BaseLayout
  title={T.title}
  description={T.description}
  canonical={T.canonical}
  robots="noindex, follow"
>
  <Nav />
  <main class="ind res-page">
    <!-- HERO -->
    <section class="ind-hero">
      <div class="ind-container">
        <h1>{T.h1}</h1>
        <p class="ind-lede">{T.lede}</p>
        <div class="res-note">
          📄 {T.noteBefore}<a href={T.contactHref}>{T.contactLabel}</a>{T.noteAfter}
        </div>
      </div>
    </section>

    <!-- GRID -->
    <section class="ind-section">
      <div class="ind-container">
        <div class="ind-grid ind-grid-3">
          {T.resources.map((r) => {
            const inner = (
              <>
                <div class="res-thumb">
                  {r.image && <img src={r.image} alt="" width="1532" height="654" loading="lazy" decoding="async" />}
                  {/* 종류(태그라인)와 표지 한 줄은 이미지 위에 얹는다 — 카드 아래에는 두지 않는다.
                      이미지에 굽지 않고 HTML로 두는 이유: 한국어·영어가 같은 파일을 쓰므로
                      글자를 구우면 /en/resources에도 한글이 뜬다. 검색·스크린리더에도 잡힌다. */}
                  <div class="res-cover">
                    <span class="res-cover-kind">{r.kind}</span>
                    {r.cover && <strong class="res-cover-line" set:html={r.cover}></strong>}
                  </div>
                </div>
                <h3>{r.label}</h3>
                <p>{r.desc}</p>
                {r.draft && <span class="res-tag">{T.draftTag}</span>}
                {!r.href && <span class="res-soon">{T.soon}</span>}
              </>
            );
            return r.href
              ? <a class="ind-card res-card is-link mp-no-track" href={r.href} data-res={r.label} data-res-kind={r.kind}>{inner}</a>
              : <div class="ind-card res-card">{inner}</div>;
          })}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script is:inline>
  // 자료 카드 클릭을 명시 이벤트로 수집(Object-Action 규칙). 카드는 mp-no-track이라 autocapture와 중복되지 않는다.
  (function () {
    document.querySelectorAll('a.res-card[data-res]').forEach(function (el) {
      el.addEventListener('click', function () {
        if (typeof mixpanel !== 'undefined') {
          mixpanel.track('Resource Link Clicked', {
            resource: el.getAttribute('data-res'),
            kind: el.getAttribute('data-res-kind'),
          });
        }
      });
    });
  })();
</script>

<style>
  /* 본문 좌우를 헤더와 같은 선에 맞춘다. 공통 .ind-container는 1120/24라
     내용이 헤더 로고보다 49px 안쪽에서 시작했다(로고 48 vs 본문 97).
     헤더와 같은 1280/48 박스로 바꿔 세로선을 하나로 만든다.
     .res-page 스코프라 이 컴포넌트를 쓰지 않는 다른 페이지에는 영향이 없다. */
  .res-page .ind-container { max-width: 1280px; padding: 0 48px; }
  @media (max-width: 900px) {
    .res-page .ind-container { padding: 0 24px; }
  }

  /* 히어로 대제목을 사이트 제목 규격(45/600/-0.8)에 맞춘다.
     공통 .ind-hero h1은 52/700/-0.03em이라 랜딩 섹션 제목(45)보다 커서,
     홈보다 아래 계층인 페이지가 더 크게 외치는 모양이었다.
     자료실 카드로 들어가는 과제별 히어로도 같은 45/600이라, 제목 크기가
     그대로 이어지고 배경만 바뀐다. */
  .res-page .ind-hero h1 {
    font-size: clamp(30px, 4.2vw, 45px);
    font-weight: 600;
    letter-spacing: -0.8px;
    line-height: 1.3;
  }
  /* 소제목·설명의 폭 제한을 푼다. 공통 .ind-lede는 60ch(≈643px),
     안내 박스는 640px 고정이라 단위가 서로 달라 글꼴이 바뀌면 어긋난다.
     둘 다 섹션(컨테이너)과 같은 폭으로 두면 카드 그리드와 오른쪽 끝이 맞는다.
     문장이 짧아 실제로는 한 줄에 담기므로 줄이 길어지는 문제는 없다. */
  .res-page .ind-lede { max-width: none; }

  /* 과제별 히어로(.uc-redesigned .ind-hero)와 같은 값 —
     자료실 카드로 들어가도 세로 리듬이 그대로 이어진다. */
  .res-page .ind-hero { padding: 180px 0 100px; }
  @media (max-width: 900px) {
    .res-page .ind-hero { padding: 120px 0 72px; }
  }

  .res-note {
    margin-top: 22px;
    background: #f4f7fa; border: 1px solid #e3e7ec; border-radius: 12px;
    padding: 14px 18px; font-size: 14.5px; line-height: 1.6; color: #47535f;
  }
  .res-note a { color: #4b86bf; text-decoration: underline; text-underline-offset: 2px; font-weight: 600; }
  /* 카드 높이를 줄 단위로 맞춘다. 그리드 기본값(auto)이면 줄마다 내용 길이에
     따라 높이가 달라져, '보기 →'가 붙는 윗줄만 36px 컸다.
     1fr로 두면 모든 줄이 가장 높은 카드에 맞춰 같아진다.
     카드 안은 세로 flex — 상태 표시(보기 → · 준비중)를 아래로 밀어 바닥에 정렬한다. */
  .res-page .ind-grid {
    grid-auto-rows: 1fr;
    /* 줄 사이만 벌린다. 카드에 테두리가 없어 좌우는 18px로도 갈리지만,
       위아래는 이미지가 세로로 이어져 한 덩어리로 보였다.
       가로 간격(18px)은 그대로 두고 세로만 56px로 띄운다. */
    row-gap: 56px;
  }
  /* 카드에서 테두리·면·안쪽 여백을 없앤다. 글이 상자에 담기지 않고
     이미지 아래에 그대로 놓이는 형태다. 패딩이 0이라 글의 왼쪽 끝이
     이미지 왼쪽 끝과 정확히 맞는다. */
  .res-page .res-card {
    position: relative; opacity: 0.85;
    display: flex; flex-direction: column; height: 100%;
    background: none; border: none; border-radius: 0; padding: 0;
  }
  .res-card.is-link { opacity: 1; text-decoration: none; }

  /* 글자 규격을 예지보전 '함께 보면 좋은 과제' 카드(.uc-case-label/.uc-case-desc)에 맞춘다.
     공통 .ind-card는 제목 18/650/-0.01em·행간 1.65, 설명 15/행간 1.6이라 조금씩 달랐다.
     색은 맞추지 않는다 — 저쪽은 사진 위 흰 글자, 여기는 밝은 면 위 어두운 글자다. */
  .res-page .res-card h3 {
    font-size: 20px; font-weight: 600; letter-spacing: normal;
    line-height: 1.65; margin-bottom: 5px;
  }
  .res-page .res-card p { font-size: 15px; line-height: 1.5; }
  /* 상단 이미지 자리. 아직 이미지가 없는 카드는 빈 면으로 남고, 파일이 오면
     이 안에 <img>가 들어간다. 자리는 늘 차지하므로 레이아웃이 흔들리지 않는다.
     종류별 배경색은 쓰지 않는다 — 이미지가 들어갈 자리라 색이 이미지와 겹쳐 보였다. */
  .res-thumb {
    position: relative;
    margin: 0 0 18px; aspect-ratio: 16 / 10;
    background: #eef2f6; border-radius: var(--radius);
    overflow: hidden;
  }
  /* 원본이 히어로 그대로라 2.34:1인데 칸은 16:10이라, cover로 좌우를 잘라 채운다. */
  .res-thumb img {
    display: block; width: 100%; height: 100%;
    object-fit: cover; object-position: center;
  }
  /* 표지 글자 — 종류(태그라인)와 한 줄 요약을 이미지 왼쪽 위에 얹는다.
     이미지가 어두운 쪽이 왼쪽 위라 흰 글자가 가장 잘 읽히는 자리다.
     이미지가 없는 카드(#eef2f6)에서도 읽히도록 위쪽에 어두운 그라데이션을 깐다. */
  .res-cover {
    position: absolute; inset: 0; z-index: 1;
    padding: 20px 22px; display: flex; flex-direction: column; gap: 8px;
    background: linear-gradient(to bottom, rgba(16, 20, 27, .55) 0%, rgba(16, 20, 27, .18) 45%, rgba(16, 20, 27, 0) 75%);
    pointer-events: none;
  }
  /* 크기는 카드 소제목(.res-card p, 15px)과 같게 둔다. */
  .res-cover-kind {
    font-size: 15px; font-weight: 700; letter-spacing: .04em; color: #76A6D7;
  }
  /* 표지 줄은 카드 아래 대제목(20px)보다 크게 둔다 — 카드에서 먼저 읽히는 자리다.
     줄바꿈은 cover 값 안의 <br>로 명시한다(마크업 안의 개행은 공백으로 합쳐진다). */
  .res-cover-line {
    font-size: 24px; font-weight: 600; line-height: 1.4; color: #fff;
    letter-spacing: -0.02em;
  }
  /* 호버 반응은 두지 않는다. */
  .res-tag { position: absolute; top: 18px; right: 18px; font-size: 11px; font-weight: 700; color: #b4863c; background: #fbf1dd; border-radius: 999px; padding: 3px 9px; }
  .res-soon {
    position: absolute; top: 18px; right: 18px;
    font-size: 11px; font-weight: 700; color: #7e8a98;
    background: #eef1f4; border-radius: 999px; padding: 3px 9px;
  }
</style>
