---
// 자료실 페이지. 한국어(/resources)와 영어(/en/resources)가 이 컴포넌트를 공유한다.
// ⚠️ 초안(준비중). 실제 자료가 준비되면 각 카드에 다운로드 링크(href)를 채우고 soon 상태를 해제한다.
// 고객 사례는 실제 확인된 내용만 게시(가공/창작 금지).
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import '../styles/industry.css';
import '../styles/res-card.css';

interface Props {
  lang?: 'ko' | 'en';
}
const { lang = 'ko' } = Astro.props;

// cover: 이미지 위에 얹는 한 줄(명사구). 카드 아래 대제목은 문장으로 두고,
// 표지 역할을 하는 이 줄만 명사구로 짧게 쓴다.
type ResItem = { label: string; desc: string; kind: string; href?: string; image?: string; imageW?: number; imageH?: number; cover?: string };

const T = {
  // ⚠️ 리포트 카드는 초안 페이지(/reports/2026-industrial-data)가 있지만 href를 두지 않는다 —
  //    내용이 확정되기 전까지 자료실에서 눌러 들어가지 못하게 한다.
  //    페이지 자체는 그대로 있고 URL로는 열린다(그쪽은 noindex).
  ko: {
    title: '자료실 | Refinery',
    description: 'Refinery 제품 소개서 ⁠· 백서 ⁠· 도입 가이드 ⁠· 웨비나 등 자료를 준비하고 있습니다. 필요한 자료는 문의로 요청해 주세요.',
    canonical: '/resources',
    h1: '자료실',
    soon: '준비중',
    resources: [
      { label: '하나의 플랫폼으로 현장을 지능화합니다', desc: '핵심 기능 ⁠· 도입 효과 ⁠· 산업별 활용을 한 페이지로 정리', kind: '플랫폼 개요', href: '/why-refinery', image: '/resources/platform-overview.webp', cover: '현장을 지능화하는<br>하나의 플랫폼' },
      { label: '흩어진 데이터를 하나의 지식으로', desc: '파이프 연결과 온톨로지의 차이, 두 가지 도입 경로', kind: '백서', href: '/whitepapers/data-integration', image: '/resources/data-integration.webp', imageW: 1400, imageH: 875, cover: '데이터 통합' },
      { label: '근거를 들어 판단을 돕는 AI', desc: '출처 있는 답변과 온프레미스 배포, 도입 준비 순서', kind: '백서', href: '/whitepapers/ai-agent', image: '/resources/ai-agent.webp', imageW: 1400, imageH: 875, cover: 'AI 에이전트' },
      { label: '2026 산업 데이터와 AI 활용 리포트', desc: '현장의 데이터 활용 현황과 AI 에이전트 도입 흐름', kind: '리포트' },
      { label: '웨비나와 데모 영상', desc: '제품 시연과 현장 적용 사례 영상', kind: '비디오' },
      { label: '산업별 활용 자료', desc: '에너지 ⁠· 제조 ⁠· 물류 ⁠· 공공 등 산업별 적용 포인트', kind: '키트' },
    ] as ResItem[],
  },
  en: {
    title: 'Resource library | Refinery',
    description: 'Product overviews, whitepapers, adoption guides and webinars are in preparation. Ask us for anything you need in the meantime.',
    canonical: '/en/resources',
    h1: 'Resource library',
    soon: 'Soon',
    // 영어판 자료가 아직 없어 링크 없이 Soon으로 둔다.
    // (한국어 백서·리포트로 보내면 영어 방문자가 한국어 문서를 받게 된다)
    resources: [
      { label: 'One platform that brings intelligence to the field', desc: 'Core capabilities ⁠· outcomes ⁠· industry use, on one page', kind: 'Platform overview', image: '/resources/platform-overview.webp', cover: 'One platform for<br>an intelligent site' },
      { label: 'Scattered data into one body of knowledge', desc: 'Pipes versus ontology, and the two paths to adoption', kind: 'Whitepaper', image: '/resources/data-integration.webp', imageW: 1400, imageH: 875, cover: 'Data integration' },
      { label: 'AI that helps decide, with the evidence shown', desc: 'Sourced answers, on-premises deployment, adoption steps', kind: 'Whitepaper', image: '/resources/ai-agent.webp', imageW: 1400, imageH: 875, cover: 'AI agents' },
      { label: '2026 Industrial Data & AI Report', desc: 'Data use in the field today, and how AI agents are being adopted', kind: 'Report' },
      { label: 'Webinars & demo videos', desc: 'Product demos and field application case videos', kind: 'Video' },
      { label: 'Industry application materials', desc: 'Application points for energy, manufacturing, logistics and the public sector', kind: 'Kit' },
    ] as ResItem[],
  },
}[lang];
---

<BaseLayout
  title={T.title}
  description={T.description}
  canonical={T.canonical}
  robots="noindex, follow"
>
  <Nav />
  <main class="ind res-page">
    <!-- HERO -->
    <section class="ind-hero">
      <div class="ind-container">
        <h1>{T.h1}</h1>
      </div>
    </section>

    <!-- GRID -->
    <section class="ind-section">
      <div class="ind-container">
        <div class="ind-grid ind-grid-3">
          {T.resources.map((r) => {
            const inner = (
              <>
                <div class={r.image ? "res-thumb" : "res-thumb is-empty"}>
                  {r.image && (
                    /* 칸(.res-thumb)이 aspect-ratio 16/10으로 자리를 잡고 이미지는 그 안을
                       cover로 채운다. width/height는 원본 비율을 알려 주는 용도라
                       파일마다 실제 값을 넣는다(표지 원본은 히어로 캡처라 파일마다 다르다). */
                    <img src={r.image} alt="" width={r.imageW ?? 1532} height={r.imageH ?? 654} loading="lazy" decoding="async" />
                  )}
                  {/* 종류(태그라인)와 표지 한 줄은 이미지 위에 얹는다 — 카드 아래에는 두지 않는다.
                      이미지에 굽지 않고 HTML로 두는 이유: 한국어·영어가 같은 파일을 쓰므로
                      글자를 구우면 /en/resources에도 한글이 뜬다. 검색·스크린리더에도 잡힌다.
                      표지 이미지가 없으면 글자도 두지 않는다 — 밝은 밑판 위 하늘색이라
                      대비가 2.4:1까지밖에 안 나와 읽히지 않았다. 빈 칸으로 비워 둔다. */}
                  {/* 표지가 없는 카드에는 '준비중' 그림만 가운데 둔다.
                      글자는 밝은 밑판에서 읽히지 않아 뺐고, 빈 칸만 남으면
                      아래 세 장이 통째로 비어 보인다.
                      디자인 원본(이미지/icon_준비중.svg) 그대로다. 색을 건드리지 않는다. */}
                  {!r.image && (
                    <img class="res-empty-icon" src="/resources/icon-soon.svg" alt="" aria-hidden="true" width="110" height="80" loading="lazy" decoding="async" />
                  )}
                  {r.image && (
                    <div class="res-cover">
                      <span class="res-cover-kind">{r.kind}</span>
                      {r.cover && <strong class="res-cover-line" set:html={r.cover}></strong>}
                    </div>
                  )}
                </div>
                <h3>{r.label}</h3>
                <p>{r.desc}</p>
                {/* 표지가 없는 카드에는 '준비중'을 단다 — 리포트처럼 링크가 있어도
                    표지가 아직 없으면 같은 상태로 보이는 편이 덜 헷갈린다.
                    '초안 미리보기' 배지는 쓰지 않는다. */}
                {!r.image && <span class="res-soon">{T.soon}</span>}
              </>
            );
            return r.href
              ? <a class="ind-card res-card is-link mp-no-track" href={r.href} data-res={r.label} data-res-kind={r.kind}>{inner}</a>
              : <div class="ind-card res-card">{inner}</div>;
          })}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script is:inline>
  // 자료 카드 클릭을 명시 이벤트로 수집(Object-Action 규칙). 카드는 mp-no-track이라 autocapture와 중복되지 않는다.
  (function () {
    document.querySelectorAll('a.res-card[data-res]').forEach(function (el) {
      el.addEventListener('click', function () {
        if (typeof mixpanel !== 'undefined') {
          mixpanel.track('Resource Link Clicked', {
            resource: el.getAttribute('data-res'),
            kind: el.getAttribute('data-res-kind'),
          });
        }
      });
    });
  })();
</script>
