---
/**
 * 홈 전용 스크롤 등장.
 *
 * 섹션 헤더와 카드가 16px 아래에서 올라오며 나타난다. 한 줄에 놓인 카드는
 * 60ms 씩 차례로 뜬다.
 *
 * ⚠️ 마크업은 건드리지 않는다. 선택자로 대상을 찾으므로 카드가 늘거나 줄어도
 *    이 파일만 본다. 이 컴포넌트를 넣은 페이지에만 걸린다 — 지금은 홈(ko·en)과
 *    산업 페이지(IndustryPage)다. 선택자는 두 쪽 것이 한 줄에 섞여 있고, 서로
 *    없는 쪽은 그냥 안 걸린다.
 *
 * ⚠️ 본문 맨 위에 놓는다. 스크립트가 <html> 에 rv-on 을 붙이는 시점이 아래
 *    섹션들의 파싱보다 앞서야 첫 페인트부터 숨은 채로 그려진다. 늦으면 보였다가
 *    사라지는 깜빡임이 난다.
 */
---

<style is:global>
  /* rv-on 은 스크립트가 붙인다 — JS 가 없거나 막히면 이 규칙이 아예 걸리지 않아
     콘텐츠가 그냥 보인다. 숨기는 쪽을 기본값으로 두지 않는 이유다. */
  .rv-on .section-header:not(.rv-done),
  .rv-on .series-card:not(.rv-done),
  .rv-on .industry-card:not(.rv-done),
  .rv-on .sec-card:not(.rv-done),
  .rv-on .faq-item:not(.rv-done),
  /* ↓ 산업 페이지. ⚠️ 과제는 알약 하나하나가 아니라 두 줄 묶음(.ind-chal-rows)
     통째로 띄운다 — 알약은 흐르고 있어 하나씩 띄우면 뜨는 도중에 자리가 바뀐다.
     ⚠️ 유즈케이스는 통(.ind-uc-shell)이 아니라 머리 칸과 항목을 따로 띄운다.
        다섯 항목이 세로로 길어 통째로 띄우면 첫 항목이 보일 때 나머지가 이미
        다 떠 버린다. 지금은 각 항목이 제 차례에 뜬다.
     ⚠️ 지연은 CSS 가 아니라 아래 스크립트가 인라인으로 넣는다(형제 순서 x 60ms).
        CSS 로 또 주면 인라인에 져서 죽은 값이 된다 — 한 번 그렇게 넣었다 걷었다.
     ⚠️ 히어로는 넣지 않는다. 첫 화면이라 숨겼다 띄울 까닭이 없다. */
  .rv-on .ind-head:not(.rv-done),
  .rv-on .ind-chal-rows:not(.rv-done),
  .rv-on .ind-uc-aside:not(.rv-done),
  .rv-on .ind-uc-item:not(.rv-done),
  .rv-on .ind-flow-step:not(.rv-done),
  .rv-on .ind-benefits .ind-card:not(.rv-done),
  /* ↓ 과제별 페이지(UseCasePage). 머리 칸(.ind-head)은 산업 페이지와 같은 선택자로
     이미 걸려 있어 여기에 다시 적지 않는다.
     ⚠️ 해결방법 카드는 .ind-card 인데 산업 페이지의 도입 효과 카드와 이름이 같다.
        그쪽은 .ind-benefits 아래라 서로 닿지 않지만, 과제별은 격자가 여럿이라
        .uc-page .ind-grid 로 자리를 못박는다.
     ⚠️ 히어로는 넣지 않는다 — 첫 화면이라 숨겼다 띄울 까닭이 없다. 사진이 자라는
        모션(--grow)은 이것과 별개로 UseCasePage 안의 스크립트가 쥔다. */
  .rv-on .uc-problem:not(.rv-done),
  .rv-on .uc-signal:not(.rv-done),
  .rv-on .uc-page .ind-grid .ind-card:not(.rv-done),
  .rv-on .uc-template:not(.rv-done),
  .rv-on .uc-case:not(.rv-done),
  .rv-on .uc-faq-item:not(.rv-done) {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity .55s cubic-bezier(.2, .7, .2, 1),
                transform .55s cubic-bezier(.2, .7, .2, 1);
  }
  /* :not(.rv-done) 한 겹이 더 있어 .rv-in 쪽 특이도가 위를 이긴다. */
  .rv-on .section-header.rv-in:not(.rv-done),
  .rv-on .series-card.rv-in:not(.rv-done),
  .rv-on .industry-card.rv-in:not(.rv-done),
  .rv-on .sec-card.rv-in:not(.rv-done),
  .rv-on .faq-item.rv-in:not(.rv-done),
  .rv-on .ind-head.rv-in:not(.rv-done),
  .rv-on .ind-chal-rows.rv-in:not(.rv-done),
  .rv-on .ind-uc-aside.rv-in:not(.rv-done),
  .rv-on .ind-uc-item.rv-in:not(.rv-done),
  .rv-on .ind-flow-step.rv-in:not(.rv-done),
  .rv-on .ind-benefits .ind-card.rv-in:not(.rv-done),
  .rv-on .uc-problem.rv-in:not(.rv-done),
  .rv-on .uc-signal.rv-in:not(.rv-done),
  .rv-on .uc-page .ind-grid .ind-card.rv-in:not(.rv-done),
  .rv-on .uc-template.rv-in:not(.rv-done),
  .rv-on .uc-case.rv-in:not(.rv-done),
  .rv-on .uc-faq-item.rv-in:not(.rv-done) {
    opacity: 1;
    transform: none;
  }
</style>

<script is:inline>
  (function () {
    var d = document, root = d.documentElement;
    if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    root.classList.add('rv-on');
    // start() 가 끝내 돌지 않더라도 콘텐츠는 보여야 한다.
    var guard = setTimeout(function () { root.classList.remove('rv-on'); }, 4000);

    function start() {
      clearTimeout(guard);
      // ⚠️ 위 <style> 의 두 목록과 같은 대상을 가리켜야 한다 — 셋 중 하나만 고치면
      //    숨기기만 하고 영영 안 띄우거나, 띄우기만 하고 지연이 안 붙는다.
      var SEL = '.section-header, .series-card, .industry-card, .sec-card, .faq-item'
              + ', .ind-head, .ind-chal-rows, .ind-uc-aside, .ind-uc-item, .ind-flow-step'
              + ', .ind-benefits .ind-card'
              + ', .uc-problem, .uc-signal, .uc-page .ind-grid .ind-card, .uc-template'
              + ', .uc-case, .uc-faq-item';
      var nodes = d.querySelectorAll(SEL);
      if (!nodes.length) { root.classList.remove('rv-on'); return; }

      /* ⚠️ IntersectionObserver 를 쓰지 않는다. 두 가지가 걸렸다.
         1. overflow 가 걸린 조상은 교차 판정 자체를 자른다. #platform 의 카드 줄은
            .series-viewport(overflow hidden) 안에서 가로로 흐르는 캐러셀이라,
            오른쪽으로 넘어간 카드는 아무리 스크롤해도 교차하지 않는다. rootMargin 은
            root(뷰포트)에만 먹어서 이걸 못 푼다.
         2. 빠르게 스크롤하면 교차 상태 변화가 한 프레임에 합쳐져 콜백을 놓친다.
            실측에서 37개 중 4개가 그렇게 빠졌다.
         둘 다 '콘텐츠가 영영 안 보인다'로 끝나는 실패다. 프레임마다 제 위치를 직접
         재는 쪽이 빠뜨리지 않는다 — 목록이 수십 개뿐이라 비용도 눈에 띄지 않는다. */
      var pending = [];
      for (var i = 0; i < nodes.length; i++) {
        var n = nodes[i];
        // 같은 줄에 놓인 형제 중 몇 번째인지로 지연을 준다.
        var k = 0;
        for (var c = n.previousElementSibling; c; c = c.previousElementSibling) {
          if (c.matches && c.matches(SEL)) k++;
        }
        /* 늦추는 간격. 기본 60ms 이고, 묶음 쪽에 data-rv-step 이 있으면 그 값을
           쓴다 — 한 칸씩 짚어 가는 것이 읽혀야 하는 줄(산업 솔루션 구조)에만
           느리게 주려고 둔 문이다. 여기 숫자를 올리면 사이트 전체가 느려진다. */
        var host = n.closest && n.closest('[data-rv-step]');
        var step = host ? (parseInt(host.getAttribute('data-rv-step'), 10) || 60) : 60;
        if (k) n.style.transitionDelay = Math.min(k, 7) * step + 'ms';
        // 다 뜨고 나면 reveal 규칙을 통째로 벗는다 — 안 그러면 여기서 건 transition 과
        // 지연이 카드 제 호버 효과까지 늦춘다.
        n.addEventListener('transitionend', function () {
          this.style.transitionDelay = '';
          this.classList.add('rv-done');
        }, { once: true });
        pending.push(n);
      }

      // 화면 아래 12% 에 걸친 것은 아직 두고, 그 위로 올라온 것부터 켠다.
      function sweep() {
        var line = (window.innerHeight || root.clientHeight) * 0.88;
        for (var j = pending.length - 1; j >= 0; j--) {
          if (pending[j].getBoundingClientRect().top < line) {
            pending[j].classList.add('rv-in');
            pending.splice(j, 1);
          }
        }
        if (!pending.length) {
          removeEventListener('scroll', onScroll);
          removeEventListener('resize', onScroll);
        }
      }

      var ticking = false;
      function onScroll() {
        if (ticking || !pending.length) return;
        ticking = true;
        requestAnimationFrame(function () { ticking = false; sweep(); });
      }

      addEventListener('scroll', onScroll, { passive: true });
      addEventListener('resize', onScroll, { passive: true });
      sweep();
    }

    if (d.readyState === 'loading') d.addEventListener('DOMContentLoaded', start);
    else start();
  })();
</script>
