---
// 필러 페이지(개념 설명 + 정의형 Q&A) 본문. 내용은 content prop으로 받는다.
// AEO(답변엔진 최적화)용 — 본문 Q&A와 FAQPage 스키마가 같은 배열에서 나온다.
// 쓰는 곳: /industrial-ai · /en/industrial-ai · /energy-management
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import type { PillarContent } from '../data/pillars/industrial-ai';
import '../styles/industry.css';

interface Props {
  content: PillarContent;
  /** ko/en 양쪽이 있는 페이지만 넘긴다. 없으면 hreflang을 내보내지 않는다. */
  alternates?: { lang: string; href: string }[];
}
const { content: T, alternates } = Astro.props;

const faqItems = T.faq;
const uses = T.uses;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f) => ({
    '@type': 'Question',
    name: f.q,
    // 화면용 개행은 스키마에서 빼고 한 줄로 넘긴다.
    acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/\s*\n\s*/g, ' ') },
  })),
};
---
<BaseLayout
  title={T.title}
  description={T.description}
  canonical={T.canonical}
  alternates={alternates}
  jsonLd={faqSchema}
>
  <Nav />
  <main class="ind ind-page">
    <!-- HERO -->
    <section class="ind-hero">
      <div class="ind-container">
        <h1 set:html={T.heroTitle}></h1>
        <div class="ind-hero-actions">
          <a href={T.contactHref} class="ind-btn-primary">{T.ctaPrimary}</a>
          <a href={T.ghostHref} class="ind-btn-ghost">{T.ctaGhost}</a>
        </div>

        <div class="ai-hero-stage">
        {/* 설명 카드. 데모 안에 있던 것을 밖으로 빼 왔다 — 내용은 데모가
            refinery-hero-focus로 넘겨준다. 장면이 없는 동안에는 흐려진다. */}
        {/* 시작 화면 글은 스크립트가 data-open-title에서 읽는다.
            is:inline 스크립트라 Astro 변수를 직접 쓸 수 없다. */}
        <figcaption class="ai-demo-cap" id="ai-demo-cap" aria-live="polite" data-open-title={T.openTitle}>
          <span class="ai-demo-cap-eyebrow" id="ai-demo-cap-kicker"></span>
          <h3 class="ai-demo-cap-title" id="ai-demo-cap-title"></h3>
        </figcaption>
        <div class="ai-hero-figure">
          <iframe id="ai-demo-iframe" data-src={T.demoSrc} loading="lazy" scrolling="no" tabindex="-1" title={T.demoTitle} style="display:block;border:none;position:absolute;top:0;left:0;transform-origin:top left;pointer-events:none;"></iframe>
        </div>
        </div>
      </div>
    </section>

    <!-- 정의형 Q&A -->
    <section class="ind-section">
      <div class="ind-container">
        <div class="qa-head">
        <header class="ind-head">
          <h2>{T.faqHead}</h2>
        </header>
        {/* 아코디언은 <details>로 만든다. JS 없이 열리고 닫히며 키보드로도 조작되고,
            무엇보다 답변 글이 접힌 상태에서도 HTML에 그대로 남는다 —
            이 페이지는 검색·답변엔진에 읽히는 것이 목적이라 그 점이 중요하다.
            첫 항목만 열어 둬 어떻게 쓰는 것인지 바로 보이게 한다.

            name을 같이 주면 한 번에 하나만 열린다(브라우저 기본 동작, JS 불필요).
            이 속성을 모르는 옛 브라우저에서는 여러 개가 함께 열릴 뿐 깨지지 않는다. */}
        <div class="qa-list">
          {faqItems.map((f, i) => (
            <details class="qa-item" name="qa" open={i === 0}>
              <summary>
                <h3>{f.q}</h3>
                <i class="ph ph-caret-down qa-caret" aria-hidden="true"></i>
              </summary>
              {/* 개행은 <br>로 낸다. 좁은 폭에서는 CSS가 br을 숨겨 단락을 푼다. */}
              <p>{f.a.split('\n').map((l, i) => (<>{i > 0 && <br />}{l}</>))}</p>
            </details>
          ))}
        </div>
        </div>
      </div>
    </section>

    <!-- 관련 활용 -->
    <section class="ind-section ind-soft">
      <div class="ind-container">
        <header class="ind-head">
          <h2>{T.usesHead}</h2>
          <p>{T.usesLede}</p>
        </header>
        <div class="ind-grid ind-grid-4">
          {uses.map((u) => (
            <a class="ind-card" href={u.href}>
              <h3>{u.label}</h3>
              {/* 개행은 <br>로 낸다. 좁은 폭에서는 CSS가 br을 숨겨 단락을 푼다. */}
              <p>{u.desc.split('\n').map((l, i) => (<>{i > 0 && <br />}{l}</>))}</p>
              <span class="ind-card-go">{T.more}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="ind-cta ai-cta-bg">
      <img class="ai-cta-bg-img" src="/use-cases/cta-bg.webp" alt="" aria-hidden="true" loading="lazy" decoding="async" width="1920" height="1080" />
      <div class="ind-container">
        <h2 set:html={T.ctaTitle}></h2>
        <a href={T.contactHref} class="ind-btn-primary ind-btn-lg">{T.ctaPrimary}</a>
      </div>
    </section>
  </main>

  <script is:inline>
    /* 히어로 아래 에이전트 데모. 랜딩(index.astro)의 같은 스크립트와 짝이지만
       ID가 달라 섞이지 않는다. 공용 컴포넌트로 뽑는 건 랜딩 히어로까지 건드리는
       일이라 여기서는 이 페이지에 필요한 만큼만 둔다. */
    (function () {
      /* 무대는 1320x840 고정이고 K = min(폭/1320, 높이/840)로 줄어든다.
         높이를 비율보다 2px 크게 잡아 K가 폭에서 정해지게 하면 무대가 폭을 정확히 채운다.
         (높이 쪽이 먼저 걸리면 좌우에 데모 페이지 배경 #E9ECEF가 남는다.) */
      var STAGE_W = 1320, STAGE_H = 840;
      var FRAME_W = 1440;
      var FRAME_H = Math.ceil(FRAME_W * STAGE_H / STAGE_W) + 2;
      /* 데모가 강조 중인 범위(무대 좌표). 없으면 기본 자리를 보여준다. */
      var focusBox = null;
      /* 강조가 없을 때 보여줄 자리(무대 좌표). 무대 전체(1320x840)를 다 담으면
         데모 칸이 좁아 0.5배까지 줄고, 데모 안 13px 글자가 6px대가 되어 안 읽힌다.
         대화 영역 쪽으로 당겨 두고, 강조가 들어오면 거기로 옮긴다.
         위쪽 끝은 질문 말풍선(.user-bubble, 실측 y54..93)이 들어오도록 잡는다 —
         y를 120에서 시작하면 말풍선이 통째로 위로 잘려 안 보인다.
         상자 비율(882:560)을 칸 비율(718:457)에 맞춰 배율은 0.746 그대로다. */
      var REST_BOX = { x: 348, y: 44, w: 882, h: 560 };
      /* 첫 화면(무엇을 분석할까요?)이 있는 자리. 여기서 잠깐 멈췄다가 첫 장면으로
         넘어간다. 데모의 빈 화면 요소를 실측한 범위는 x551..1021, y250..529
         (아이콘·제목·소개글·추천 카드)이고 가운데는 (786, 390)이다.
         상자 가운데를 그 값에 맞춰야 칸 한가운데로 온다 — 어림잡으면 위아래로
         치우친다(가운데를 420으로 뒀을 때 내용이 35px 위로 붙었다).
         상자 크기로 배율이 정해진다. 590x400은 1.047배(여백 68/70px)로 위가
         허전했고, 540x340은 1.22배로 과했다. 580x380에서 1.10배(여백 60/61px)다. */
      var START_BOX = { x: 496, y: 200, w: 580, h: 380 };
      /* 첫 화면에 머무는 시간. 이 동안 데모를 세워 두고 장면 신호도 미뤄 둔다. */
      var HOLD_MS = 1600;
      /* 첫 화면에 함께 두는 좌측 글. 장면들과 같은 자리를 쓰고, 첫 장면이 오면
         그 내용으로 바뀐다. 여기만 태그라인 없이 제목 하나로 간다(.is-opening). */
      var OPENING = {
        kicker: '',
        title: (document.getElementById('ai-demo-cap') || {}).dataset
          ? document.getElementById('ai-demo-cap').dataset.openTitle
          : ''
      };
      var holding = true;
      var pendingFocus = null;
      var holdTimer = null;
      /* 데모가 한 바퀴를 시작했는지. 아래 '직접 시작' 신호를 중복으로 보내지 않는다. */
      var started = false;
      /* 배율 하한. 강조 대상이 이 배율에 다 안 들어오면 좌우가 잘린다 —
         다 보여주려다 못 읽는 것보다 잘리더라도 읽히는 편이 낫다. */
      var MIN_SCALE = 0.68;
      var MAX_ZOOM = 2.2;

      function render(animate) {
        var box = document.querySelector('.ai-hero-figure');
        var frame = document.getElementById('ai-demo-iframe');
        if (!box || !frame) return;
        var bw = box.offsetWidth, bh = box.offsetHeight;
        var stageToFrame = FRAME_W / STAGE_W;
        var fit = bw / FRAME_W;                    /* 무대 전체를 담는 배율 */
        /* 설명이 데모 위로 올라가는 폭에서는 데모가 칸을 넓게 쓰므로 당기지 않고
           전체를 보여준다. 좁은 화면에서 당기면 화면 대부분이 잘려 나간다. */
        var stacked = window.innerWidth <= 1024;

        var s, cx, cy;
        if (holding) {
          /* 첫 화면 자리. 좁은 화면에서는 전체를 보여준다. */
          if (stacked) { s = fit; cx = FRAME_W / 2; cy = FRAME_H / 2; }
          else {
            var sx = START_BOX.x * stageToFrame, sy = START_BOX.y * stageToFrame;
            var sw = START_BOX.w * stageToFrame, sh = START_BOX.h * stageToFrame;
            s = Math.max(MIN_SCALE, Math.min(bw / sw, bh / sh));
            cx = sx + sw / 2; cy = sy + sh / 2;
          }
        } else if (stacked && !focusBox) {
          s = fit; cx = FRAME_W / 2; cy = FRAME_H / 2;
        } else {
          var target = focusBox || REST_BOX;
          /* 강조 상자 둘레 여백(무대 좌표).
             강조 상자는 확장(레일)을 빼면 6개가 모두 폭 756으로 같고 높이만
             41~319로 다르다. 그래서 배율은 늘 폭에서 정해지고, 보이는 세로는
             폭이 정한 값(=756/칸비율)을 따라간다. 여백을 줄이면 배율이 올라
             그 756짜리 줄이 좌우로 잘려 나간다 — 강조된 줄이 잘리면 비율이
             어그러져 보인다. 40은 그 줄이 좌우 여유를 갖는 값이다.
             쉬는 자리(REST_BOX)에는 주지 않는다. 붙이면 위 끝이 43에서 16으로
             올라가 상단 바(y0..38)가 화면에 들어온다. */
          var pad = (focusBox ? 40 : 0) * stageToFrame;
          var fx = target.x * stageToFrame - pad;
          var fy = target.y * stageToFrame - pad;
          var fw = target.w * stageToFrame + pad * 2;
          var fh = target.h * stageToFrame + pad * 2;
          s = Math.min(bw / fw, bh / fh);
          var floor = stacked ? fit : MIN_SCALE;
          s = Math.max(floor, Math.min(s, floor * MAX_ZOOM));
          cx = fx + fw / 2; cy = fy + fh / 2;
        }

        /* 보고 있는 자리의 가운데를 칸 가운데로 당긴다. */
        var tx = bw / 2 - cx * s;
        var ty = bh / 2 - cy * s;
        /* 데모 페이지 배경이 비치지 않도록 가장자리를 넘지 않게 가둔다. */
        tx = Math.min(0, Math.max(tx, bw - FRAME_W * s));
        ty = Math.min(0, Math.max(ty, bh - FRAME_H * s));
        if (FRAME_W * s < bw) tx = (bw - FRAME_W * s) / 2;
        if (FRAME_H * s < bh) ty = (bh - FRAME_H * s) / 2;

        frame.style.width = FRAME_W + 'px';
        frame.style.height = FRAME_H + 'px';
        frame.style.left = '0px';
        frame.style.top = '0px';
        frame.style.transition = animate ? 'transform .7s cubic-bezier(.22,.61,.36,1)' : 'none';
        frame.style.transform = 'translate(' + tx + 'px, ' + ty + 'px) scale(' + s + ')';
      }

      function resize() { render(false); }

      /* 데모가 알려주는 강조 범위를 따라 화면을 옮기고, 설명 카드를 좌측에 그린다.
         랜딩과 달리 이 페이지는 전체를 멀리서 보여주는 대신 지금 설명 중인 곳으로
         당겨서 보여주고, 설명은 데모 밖 카드가 맡는다. */
      function initFocus() {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var card = document.getElementById('ai-demo-cap');
        window.addEventListener('message', function (e) {
          /* 아무 창이나 보낼 수 있는 메시지다. 우리 iframe에서 온 것만 받는다. */
          var frame = document.getElementById('ai-demo-iframe');
          if (e.origin !== window.location.origin) return;
          if (!frame || e.source !== frame.contentWindow) return;
          if (!e.data) return;

          /* 한 바퀴가 새로 시작한다는 신호. 매 바퀴 시작 화면에 다시 머문다. */
          if (e.data.type === 'refinery-hero-cycle') { started = true; beginHold(); return; }
          if (e.data.type !== 'refinery-hero-focus') return;

          if (holding) {
            /* 첫 화면에 머무는 동안은 장면을 반영하지 않는다. 마지막 것만 들고
               있다가 다시 풀릴 때 적용한다(데모도 세워 둔 상태라 장면은 안 넘어간다). */
            pendingFocus = e.data;
            return;
          }
          apply(e.data);
        });

        beginHold();

        /* 시작 화면에 머문다. 데모를 세워 두고 좌측에는 여는 글을 띄운 뒤,
           HOLD_MS가 지나면 다시 돌린다. 첫 로드와 매 바퀴 시작에 쓴다. */
        function beginHold() {
          var f = document.getElementById('ai-demo-iframe');
          /* 이미 머무는 중이면 그대로 둔다. 첫 로드에서는 데모가 스스로 시작한
             신호와 우리가 보낸 시작 신호가 겹칠 수 있는데, 그때마다 다시 걸면
             첫 머무름만 두 배로 길어진다. */
          if (holding && holdTimer) return;
          if (holdTimer) clearTimeout(holdTimer);
          holdTimer = null;
          holding = true;
          pendingFocus = null;
          focusBox = null;
          if (card) card.classList.add('is-opening');
          setCap(OPENING);
          render(true);
          /* 데모를 아직 안 불러왔으면 세울 대상이 없다. 여는 글만 띄워 두고,
             데모가 한 바퀴를 시작하며 보내는 신호(refinery-hero-cycle)를 기다린다.
             그때 이 함수가 다시 불려 제대로 머무른다. */
          if (!f || !f.src) return;
          try { f.contentWindow.postMessage({ type: 'refinery-hero-pause' }, '*'); } catch (e) {}
          holdTimer = setTimeout(function () {
            holding = false;
            holdTimer = null;
            try { f.contentWindow.postMessage({ type: 'refinery-hero-resume' }, '*'); } catch (e) {}
            if (pendingFocus) { apply(pendingFocus); pendingFocus = null; }
            else render(true);
          }, HOLD_MS);
        }

        function apply(d) {
          if (!reduce) { focusBox = d.box || null; render(true); }

          if (!card) return;
          if (d.cap) {
            /* 첫 화면 글은 '다른 글로 바뀔 때' 비로소 장면 크기로 넘긴다.
               머무름이 끝나는 시점에 떼면, 첫 장면 신호가 오기 전까지
               같은 문구가 40 -> 32px로 잠깐 줄었다가 바뀐다. */
            card.classList.remove('is-opening');
            setCap(d.cap);
          } else {
            card.classList.remove('is-on');
          }
        }
      }

      /* 좌측 글을 채운다. 제목은 카피에 넣어둔 \n에서 두 줄로 나눈다.
         데모 안 카드는 textContent라 \n이 공백으로 합쳐져 한 덩어리로 보인다. */
      function setCap(t) {
        var card = document.getElementById('ai-demo-cap');
        if (!card) return;
        document.getElementById('ai-demo-cap-kicker').textContent = t.kicker;
        var titleEl = document.getElementById('ai-demo-cap-title');
        titleEl.textContent = '';
        String(t.title).split('\n').forEach(function (line, i) {
          if (i) {
            /* <br> 앞에 공백을 함께 넣는다. 좁은 폭에서는 CSS가 <br>를 숨겨
               두 줄을 한 줄로 푸는데, 공백이 없으면 '권한은내가'처럼 붙는다.
               줄 끝의 공백은 그대로 두어도 보이지 않는다. */
            titleEl.appendChild(document.createTextNode(' '));
            titleEl.appendChild(document.createElement('br'));
          }
          titleEl.appendChild(document.createTextNode(line));
        });
        card.classList.add('is-on');
      }

      /* 성능: 무거운 데모 iframe은 페이지가 인터랙티브해진 뒤에 불러온다. */
      function load() {
        var f = document.getElementById('ai-demo-iframe');
        if (f && !f.src && f.getAttribute('data-src')) {
          f.addEventListener('load', function () {
            /* 설명 카드를 이 페이지가 직접 그린다. 데모 안 카드는 숨겨진다. */
            try { f.contentWindow.postMessage({ type: 'refinery-hero-extcap' }, '*'); } catch (e) {}
            /* 시작 화면 머무름(pause)은 beginHold가 맡는다. 데모는 첫 장면을
               로드 179ms에 띄우므로 세워 두지 않으면 첫 화면이 보이지 않는다. */
            /* 랜딩 기본값은 3배속이다. 이 페이지는 화면이 장면마다 움직이므로
               더 천천히 간다. 설명이 머무는 시간은 배속과 무관하다. */
            try { f.contentWindow.postMessage({ type: 'refinery-hero-speed', value: 2 }, '*'); } catch (e) {}
            /* 설명 체류는 배속과 별개다(실시간). 좌측에 32px 두 줄로 크게 띄우는
               페이지라 기본 2.36초로는 읽기 빠듯해 1.3배로 늘린다. */
            try { f.contentWindow.postMessage({ type: 'refinery-hero-dwell', value: 1.3 }, '*'); } catch (e) {}
            /* 데모는 자기 무대가 35% 이상 보일 때만 스스로 시작한다
               (IntersectionObserver). 이 페이지는 화면을 당겨서 보여주므로
               시작 화면(1.10배)에서는 20%만 보여 영영 시작하지 않는다.
               스스로 시작하지 못했을 때만 직접 시작시킨다 — 둘 다 걸리면
               한 바퀴가 두 번 시작해 첫 머무름만 길어진다. */
            setTimeout(function () {
              if (started) return;
              try { f.contentWindow.postMessage({ type: 'refinery-hero-replay' }, '*'); } catch (e) {}
            }, 400);
            resize();
          });
          f.src = f.getAttribute('data-src');
        }
      }

      window.addEventListener('load', function () { initFocus(); resize(); load(); });
      window.addEventListener('resize', resize);
      document.addEventListener('DOMContentLoaded', resize);
    })();
  </script>
  <Footer />
</BaseLayout>

<style>
  /* 블록 폭을 컨테이너 하나로 맞춘다. 전에는 Q&A만 760px이라 구분선이 화면 중간에서
