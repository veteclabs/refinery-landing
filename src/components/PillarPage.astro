---
// 필러 페이지(개념 설명 + 정의형 Q&A) 본문. 내용은 content prop으로 받는다.
// AEO(답변엔진 최적화)용 — 본문 Q&A와 FAQPage 스키마가 같은 배열에서 나온다.
// 쓰는 곳: /industrial-ai · /en/industrial-ai · /energy-management
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import ScrollReveal from './ScrollReveal.astro';
import type { PillarContent } from '../data/pillars/industrial-ai';
import { findUseCase } from '../data/usecases';
import { findUseCaseEn } from '../data/usecases/en';
import '../styles/industry.css';

interface Props {
  content: PillarContent;
  /** ko/en 양쪽이 있는 페이지만 넘긴다. 없으면 hreflang을 내보내지 않는다. */
  alternates?: { lang: string; href: string }[];
  /** 영문 전용 줄 모양 규칙을 거는 데 쓴다(산업 페이지의 ind-en과 같은 방식). */
  lang?: 'ko' | 'en';
}
const { content: T, alternates, lang = 'ko' } = Astro.props;

/* 히어로 데모를 넣을지. demoSrc가 비어 있으면 그래픽(heroGraphic)을 쓰고,
   그것도 없으면 판만 남기고 자리로 둔다. */
const hasDemo = Boolean(T.demoSrc);

/* 갈래 이름을 클래스로 단다(canonical 의 끝 조각). 같은 컴포넌트를 산업 AI 와
   에너지관리가 함께 쓰므로, 한쪽만 손보려면 가려 쓸 고리가 있어야 한다.
   /industrial-ai · /en/industrial-ai -> pillar-industrial-ai */
const pillarSlug = T.canonical.replace(/\/$/, '').split('/').pop();

const faqItems = T.faq;
const uses = T.uses;

/* 활용 카드에 쓸 사진. 과제 데이터(cardImage)에서 slug 로 찾아 온다 — 필러
   데이터에 경로를 또 적지 않는다. 과제 쪽 사진을 바꾸면 이 카드도 따라온다.
   ⚠️ 글(label · desc)은 필러 데이터 것을 그대로 쓴다. 과제의 이름 · 태그라인을
      끌어오면 이 페이지용으로 쓴 문구가 사라진다.
   ⚠️ 과제가 아닌 곳(다른 필러 페이지 등)으로 가는 카드는 사진이 없다 —
      그때는 사진 없는 카드로 선다. */
const useCards = uses.map((u) => {
  const slug = u.href.replace(/\/$/, '').split('/').pop() || '';
  const uc = lang === 'en' ? findUseCaseEn(slug) : findUseCase(slug);
  return { ...u, image: u.href.includes('/use-cases/') ? uc?.cardImage : undefined };
});

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f) => ({
    '@type': 'Question',
    name: f.q,
    // 화면용 개행은 스키마에서 빼고 한 줄로 넘긴다.
    acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/\s*\n\s*/g, ' ') },
  })),
};
---
<BaseLayout
  title={T.title}
  description={T.description}
  canonical={T.canonical}
  alternates={alternates}
  jsonLd={faqSchema}
>
  {/* 스크롤 등장. 과제별과 같은 모션이다 — 머리 칸 · 문답 · 활용 카드가 16px
      아래에서 올라오고, 한 줄에 놓인 것은 60ms 씩 차례로 뜬다.
      ⚠️ 본문보다 앞에 놓는다. 스크립트가 <html> 에 rv-on 을 붙이는 시점이 아래
         섹션의 파싱보다 앞서야 첫 페인트부터 숨은 채로 그려진다.
      ⚠️ 산업 AI 에만 넣는다. 에너지관리는 같은 컴포넌트를 쓰지만 모션을 요청받지
         않았고, ScrollReveal 의 .ind-head 선택자가 전역이라 넣는 순간 그쪽
         섹션 머리까지 같이 뜬다. */}
  {pillarSlug === 'industrial-ai' && <ScrollReveal />}
  <Nav />
  <main class:list={['ind', 'ind-page', `pillar-${pillarSlug}`, lang === 'en' && 'ind-en']}>
    <!-- HERO -->
    <section class="ind-hero">
      <div class="ind-container">
        <h1 set:html={T.heroTitle}></h1>
        {T.heroLede && <p class="ind-lede ai-hero-lede">{T.heroLede}</p>}
        <div class="ind-hero-actions">
          <a href={T.contactHref} class="ind-btn-primary">{T.ctaPrimary}</a>
          <a href={T.ghostHref} class="ind-btn-ghost">{T.ctaGhost}</a>
        </div>

        {/* 카드만 따로 감싼다 — 바깥이 스크롤 거리를 만드는 칸, 안이 화면에
            붙는 무대다. 대제목 · 버튼은 이 밖에 있어 평범하게 흐른다.
            ⚠️ 산업 AI 에만 규칙이 걸린다. 에너지관리에서는 그냥 겹친 <div> 둘이라
               보이는 것이 달라지지 않는다. */}
        <div class="ai-hero-pin"><div class="ai-hero-sticky">
        <div class={hasDemo ? 'ai-hero-stage' : (T.heroGraphic ? 'ai-hero-stage is-empty has-graphic' : 'ai-hero-stage is-empty')}>
        {hasDemo && (
          <figcaption class="ai-demo-cap" id="ai-demo-cap" aria-live="polite" data-open-title={T.openTitle}>
            {/* 앱의 AI 에이전트 아이콘. 글 묶음 맨 위에 서서 이 카드가 무엇을
                보여 주는지 한눈에 짚는다. 장면마다 글이 바뀌어도 그대로 있다 —
                장면에 따라 넣었다 뺐다 하면 깜빡인다.
                ⚠️ 뜻을 더하지 않는 장식이라 alt 는 비우고 화면 낭독기에서 뺀다.
                   바로 아래 제목이 같은 말을 한다. */}
            <span class="ai-demo-cap-icon" aria-hidden="true">
              <span class="ai-demo-cap-icon-in">
                <img
                  src="/industrial-ai/ai-agent.webp"
                  alt=""
                  width="38"
                  height="38"
                  decoding="async"
                />
              </span>
            </span>
            <span class="ai-demo-cap-eyebrow" id="ai-demo-cap-kicker"></span>
            <h3 class="ai-demo-cap-title" id="ai-demo-cap-title"></h3>
            {/* 구간 막대 — 칸은 스크립트가 장면 수만큼 만든다. 지금 장면이
                시간을 따라 차오르고, 누르면 그 장면으로 건너뛴다. */}
            <div class="ai-demo-bar" id="ai-demo-bar"></div>
          </figcaption>
        )}
        {/* 데모도 그래픽도 없으면 자리만 남긴다. 비율은 그대로라 나중에 넣어도 아래가 밀리지 않는다. */}
        <div class="ai-hero-figure">
          {hasDemo && (
            <iframe id="ai-demo-iframe" data-src={T.demoSrc} loading="lazy" scrolling="no" tabindex="-1" title={T.demoTitle} style="display:block;border:none;position:absolute;top:0;left:0;transform-origin:top left;pointer-events:none;"></iframe>
          )}
          {!hasDemo && T.heroGraphic && (
            /* <img>이 아니라 <object>인 이유: 그림 안쪽 그룹을 하나씩 나타나게 하려면
               스크립트가 SVG 문서에 닿아야 한다. <img>은 문서가 격리돼 닿지 않고,
               인라인하면 724KB가 HTML에 들어가 캐시가 안 먹는다. 같은 출처라
               <object>의 contentDocument는 열린다. 스크립트가 없어도 그림은 그대로 뜬다. */
            <object
              class="ai-hero-graphic"
              id="ai-hero-graphic"
              type="image/svg+xml"
              data={T.heroGraphic.src}
              aria-label={T.heroGraphic.alt}
            ></object>
          )}
        </div>
        </div></div>
        </div>
      </div>
    </section>

    <!-- 정의형 Q&A -->
    <section class="ind-section qa-section">
      <div class="ind-container">
        <div class="qa-head">
        <header class="ind-head">
          <h2>{T.faqHead}</h2>
        </header>
        {/* 아코디언은 <details>로 만든다. JS 없이 열리고 닫히며 키보드로도 조작되고,
            무엇보다 답변 글이 접힌 상태에서도 HTML에 그대로 남는다 —
            이 페이지는 검색·답변엔진에 읽히는 것이 목적이라 그 점이 중요하다.
            첫 항목만 열어 둬 어떻게 쓰는 것인지 바로 보이게 한다.

            name을 같이 주면 한 번에 하나만 열린다(브라우저 기본 동작, JS 불필요).
            이 속성을 모르는 옛 브라우저에서는 여러 개가 함께 열릴 뿐 깨지지 않는다. */}
        <div class="qa-list">
          {faqItems.map((f, i) => (
            <details class="qa-item" name="qa" open={i === 0}>
              <summary>
                <h3>{f.q}</h3>
                <i class="ph ph-caret-down qa-caret" aria-hidden="true"></i>
              </summary>
              {/* 개행은 <br>로 낸다. 좁은 폭에서는 CSS가 br을 숨겨 단락을 푼다. */}
              <p>{f.a.split('\n').map((l, i) => (<>{i > 0 && <br />}{l}</>))}</p>
            </details>
          ))}
        </div>
        </div>
      </div>
    </section>

    <!-- 관련 활용 -->
    {/* 산업 AI 는 흰 면이다 — 과제별 '과제 더 살펴보기' 와 같다. 에너지관리는
        요청받지 않아 옅은 면(.ind-soft) 그대로 둔다. */}
    <section class:list={['ind-section', pillarSlug !== 'industrial-ai' && 'ind-soft']}>
      <div class="ind-container">
        {/* 줄바꿈은 <br>로 명시한다. 대제목과 소제목은 한 줄에 좌우로 앉는데,
            영문처럼 문구가 길면 flex-wrap이 걸려 소제목이 아래로 떨어진다.
            그때 두 줄로 나눠 좌우 자리를 지킨다. */}
        <header class="ind-head">
          <h2 set:html={T.usesHead}></h2>
          {/* 소제목이 비어 있으면 <p> 자체를 내지 않는다 — 빈 칸이 남으면 머리
              아래 간격이 글 없이 벌어진다. 히어로 소제목과 같은 처리다. */}
          {T.usesLede && <p set:html={T.usesLede}></p>}
        </header>
        {/* 산업 AI 는 과제별 '과제 더 살펴보기'(.uc-case)와 같은 사진 카드로 낸다.
            에너지관리는 요청받지 않아 종전 글 카드 그대로 둔다. */}
        {pillarSlug === 'industrial-ai' ? (
        <div class="uc-cases">
          {useCards.map((u) => (
            <a class={u.image ? 'uc-case uc-case--img' : 'uc-case'} href={u.href}>
              {u.image && (
                <img
                  class="uc-case-img"
                  src={u.image.src}
                  alt=""
                  aria-hidden="true"
                  width={u.image.width}
                  height={u.image.height}
                  style={u.image.position ? `object-position:${u.image.position}` : undefined}
                  loading="lazy"
                  decoding="async"
                />
              )}
              <div class="uc-case-body">
                <div class="uc-case-text">
                  <span class="uc-case-label">{u.label}</span>
                  {/* 접히는 칸 — 평소에는 높이 0 이고 카드에 마우스를 올리면 펴진다. */}
                  <span class="uc-case-fold"><span>
                    <p class="uc-case-desc">{u.desc.split('\n').map((l, i) => (<>{i > 0 && <br />}{l}</>))}</p>
                  </span></span>
                </div>
                <span class="uc-case-go" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 -960 960 960" xmlns="http://www.w3.org/2000/svg" fill="currentColor"><path d="m553.85-253.85-42.16-43.38L664.46-450H180v-60h484.46L511.69-662.77l42.16-43.38L780-480 553.85-253.85Z"/></svg>
                </span>
              </div>
            </a>
          ))}
        </div>
        ) : (
        <div class="ind-grid ind-grid-4">
          {uses.map((u) => (
            <a class="ind-card" href={u.href}>
              <h3>{u.label}</h3>
              {/* 개행은 <br>로 낸다. 좁은 폭에서는 CSS가 br을 숨겨 단락을 푼다. */}
              <p>{u.desc.split('\n').map((l, i) => (<>{i > 0 && <br />}{l}</>))}</p>
              <span class="ind-card-go">{T.more}</span>
            </a>
          ))}
        </div>
        )}
      </div>
    </section>

    <!-- CTA -->
    {/* ⚠️ 산업 AI 에만 .ind-cta-bg 를 함께 건다. 그래야 여백 · 면색 · 어두운 겹 ·
        그래픽 자리값을 industry.css 의 공용 규칙이 그대로 맡는다(솔루션 ·
        과제별 · 제품소개와 한 벌이다). 에너지관리는 옛 사진이라 손대지 않는다. */}
    <section class:list={['ind-cta', 'ai-cta-bg', pillarSlug === 'industrial-ai' && 'ind-cta-bg']}>
      {/* 배경은 public/cta/industrial-ai 의 이 갈래 전용 그래픽이다(스파클 코어,
          1440x300 · 2880x600 · 4초 루프). 그림에 섹션 면색(#151B23)이 들어 있어
          섹션 전체 폭에 깔아도 변이 드러나지 않는다 — 제품소개(why-refinery)와
          같은 띠 그래픽이라 자리값도 공용 규칙(.ind-cta-bg-img)을 그대로 쓴다.
          ⚠️ 영상은 lazy 가 없다. preload="metadata" 로 첫 조각만 받고,
             포스터(webp)가 도착 전과 '움직임 줄이기' 를 켠 화면을 맡는다.
          ⚠️ webm 을 mp4 보다 먼저 적는다 — 브라우저는 처음 트는 것을 고르는데
             webm(182KB)이 mp4(657KB)보다 작다.
          ⚠️ 에너지관리는 그대로 사진을 쓴다 — 그 페이지는 따로 진행한다. */}
      {pillarSlug === 'industrial-ai' ? (
        <video
          class="ind-cta-bg-img"
          autoplay muted loop playsinline preload="metadata"
          poster="/cta/industrial-ai/sparkle/ai-cta-sparkle.webp"
          aria-hidden="true"
        >
          <source src="/cta/industrial-ai/sparkle/ai-cta-sparkle.webm" type="video/webm" />
          <source src="/cta/industrial-ai/sparkle/ai-cta-sparkle.mp4" type="video/mp4" />
        </video>
      ) : (
        <img class="ai-cta-bg-img" src="/use-cases/cta-bg.webp" alt="" aria-hidden="true" loading="lazy" decoding="async" width="1920" height="1080" />
      )}
      <div class="ind-container">
        <h2 set:html={T.ctaTitle}></h2>
        <a href={T.contactHref} class="ind-btn-primary ind-btn-lg">{T.ctaPrimary}</a>
      </div>
    </section>
  </main>

  <script is:inline>
    /* 움직임을 줄여 달라고 한 화면에서는 CTA 배경 영상을 세운다 — poster 만
       남는다. 그 밖에는 화면에 들어올 때와 첫 손짓에 재생을 청한다. iOS 는
       저전력 모드에서 autoplay 를 거절하는데, 손짓 뒤에는 대개 허락된다.
       거절당하면 조용히 넘어가 poster 가 그대로 남는다.
       ⚠️ 산업별 · 과제별 · 제품소개 페이지의 같은 자리와 똑같은 처리다.
       ⚠️ 영상이 없는 갈래(에너지관리는 사진이다)에서는 아무 일도 하지 않는다. */
    (function () {
      var v = document.querySelector('video.ind-cta-bg-img');
      if (!v) return;
      if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) {
        v.removeAttribute('autoplay'); v.pause(); return;
      }
      var ask = function () { if (v.paused) { var p = v.play(); if (p && p.catch) p.catch(function () {}); } };
      ask();
      addEventListener('touchstart', ask, { passive: true, once: true });
      addEventListener('click', ask, { once: true });
      if (window.IntersectionObserver) {
        new IntersectionObserver(function (es) {
          es.forEach(function (e) { if (e.isIntersecting) ask(); });
        }, { rootMargin: '200px' }).observe(v);
      }
    })();
  </script>

  {pillarSlug === 'industrial-ai' && (
  <script is:inline>
    {/* 히어로 카드 넓히기 — 솔루션(IndustryPage) · 제품소개와 같은 스크립트다.
        스크롤을 내린 만큼 --grow 를 0 -> 1 로 올려 카드가 오른쪽 화면 끝까지
        자라고 오른쪽 모서리가 펴진다.
        ⚠️ 쓰는 값은 scrollY 다. 카드의 화면 안 위치로 재면 첫 화면에서 이미
           절반쯤 자란 상태로 뜬다 — '기본 모습에서 스크롤할 때' 가 아니다.
        ⚠️ 360px 을 다 내리면 꽉 찬다 — 저쪽과 같은 거리다.
        ⚠️ 동작 줄이기를 켠 사람에게는 손대지 않는다 — 기본 모습 그대로다. */}
    (function () {
      var box = document.querySelector('.pillar-industrial-ai .ind-hero .ind-container');
      var pin = document.querySelector('.pillar-industrial-ai .ai-hero-pin');
      if (!box || !pin) return;
      if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var last = -1, ticking = false, wasCovering = false;
      var stageEl = document.querySelector('.pillar-industrial-ai .ai-hero-stage');
      /* ⚠️ 창 스크롤이 아니라 카드 칸의 자리로 잰다. 윗변이 화면 아래에 있으면 0,
         화면 맨 위에 닿으면 1 이다 — 무대가 붙는 바로 그 순간에 다 자라 있다.
         scrollY 로 재던 때는 360px 에서 다 자랐는데 무대는 700px 에서야 붙어,
         자란 카드가 화면 밖으로 삐져나오는 구간이 있었다. */
      /* 쉬는 카드와 다 자란 카드의 안쪽 폭 비. 데모 폭에 곱해 두면 쉬는 모습이
         다 자란 모습을 그대로 줄인 꼴이 된다.
           쉬는 안쪽  = min(창, 1600) - 칸 좌우 96 - 카드 좌우 112
           자란 안쪽  = 창 - 왼쪽 48 - 바깥 여백(out)
         ⚠️ clientWidth 를 쓴다. 100vw 는 스크롤 막대 폭까지 센다. */
      function updK() {
        var vw = document.documentElement.clientWidth;
        var out = Math.max(0, (vw - 1600) / 2);
