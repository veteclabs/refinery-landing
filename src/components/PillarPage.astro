---
// 필러 페이지(개념 설명 + 정의형 Q&A) 본문. 내용은 content prop으로 받는다.
// AEO(답변엔진 최적화)용 — 본문 Q&A와 FAQPage 스키마가 같은 배열에서 나온다.
// 쓰는 곳: /industrial-ai · /en/industrial-ai · /energy-management
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import type { PillarContent } from '../data/pillars/industrial-ai';
import '../styles/industry.css';

interface Props {
  content: PillarContent;
  /** ko/en 양쪽이 있는 페이지만 넘긴다. 없으면 hreflang을 내보내지 않는다. */
  alternates?: { lang: string; href: string }[];
}
const { content: T, alternates } = Astro.props;

/* 히어로 데모를 넣을지. demoSrc가 비어 있으면 그래픽(heroGraphic)을 쓰고,
   그것도 없으면 판만 남기고 자리로 둔다. */
const hasDemo = Boolean(T.demoSrc);

const faqItems = T.faq;
const uses = T.uses;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f) => ({
    '@type': 'Question',
    name: f.q,
    // 화면용 개행은 스키마에서 빼고 한 줄로 넘긴다.
    acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/\s*\n\s*/g, ' ') },
  })),
};
---
<BaseLayout
  title={T.title}
  description={T.description}
  canonical={T.canonical}
  alternates={alternates}
  jsonLd={faqSchema}
>
  <Nav />
  <main class="ind ind-page">
    <!-- HERO -->
    <section class="ind-hero">
      <div class="ind-container">
        <h1 set:html={T.heroTitle}></h1>
        {T.heroLede && <p class="ind-lede ai-hero-lede">{T.heroLede}</p>}
        <div class="ind-hero-actions">
          <a href={T.contactHref} class="ind-btn-primary">{T.ctaPrimary}</a>
          <a href={T.ghostHref} class="ind-btn-ghost">{T.ctaGhost}</a>
        </div>

        <div class={hasDemo ? 'ai-hero-stage' : (T.heroGraphic ? 'ai-hero-stage is-empty has-graphic' : 'ai-hero-stage is-empty')}>
        {hasDemo && (
          <figcaption class="ai-demo-cap" id="ai-demo-cap" aria-live="polite" data-open-title={T.openTitle}>
            <span class="ai-demo-cap-eyebrow" id="ai-demo-cap-kicker"></span>
            <h3 class="ai-demo-cap-title" id="ai-demo-cap-title"></h3>
          </figcaption>
        )}
        {/* 데모도 그래픽도 없으면 자리만 남긴다. 비율은 그대로라 나중에 넣어도 아래가 밀리지 않는다. */}
        <div class="ai-hero-figure">
          {hasDemo && (
            <iframe id="ai-demo-iframe" data-src={T.demoSrc} loading="lazy" scrolling="no" tabindex="-1" title={T.demoTitle} style="display:block;border:none;position:absolute;top:0;left:0;transform-origin:top left;pointer-events:none;"></iframe>
          )}
          {!hasDemo && T.heroGraphic && (
            /* <img>이 아니라 <object>인 이유: 그림 안쪽 그룹을 하나씩 나타나게 하려면
               스크립트가 SVG 문서에 닿아야 한다. <img>은 문서가 격리돼 닿지 않고,
               인라인하면 724KB가 HTML에 들어가 캐시가 안 먹는다. 같은 출처라
               <object>의 contentDocument는 열린다. 스크립트가 없어도 그림은 그대로 뜬다. */
            <object
              class="ai-hero-graphic"
              id="ai-hero-graphic"
              type="image/svg+xml"
              data={T.heroGraphic.src}
              aria-label={T.heroGraphic.alt}
            ></object>
          )}
        </div>
        </div>
      </div>
    </section>

    <!-- 정의형 Q&A -->
    <section class="ind-section">
      <div class="ind-container">
        <div class="qa-head">
        <header class="ind-head">
          <h2>{T.faqHead}</h2>
        </header>
        {/* 아코디언은 <details>로 만든다. JS 없이 열리고 닫히며 키보드로도 조작되고,
            무엇보다 답변 글이 접힌 상태에서도 HTML에 그대로 남는다 —
            이 페이지는 검색·답변엔진에 읽히는 것이 목적이라 그 점이 중요하다.
            첫 항목만 열어 둬 어떻게 쓰는 것인지 바로 보이게 한다.

            name을 같이 주면 한 번에 하나만 열린다(브라우저 기본 동작, JS 불필요).
            이 속성을 모르는 옛 브라우저에서는 여러 개가 함께 열릴 뿐 깨지지 않는다. */}
        <div class="qa-list">
          {faqItems.map((f, i) => (
            <details class="qa-item" name="qa" open={i === 0}>
              <summary>
                <h3>{f.q}</h3>
                <i class="ph ph-caret-down qa-caret" aria-hidden="true"></i>
              </summary>
              {/* 개행은 <br>로 낸다. 좁은 폭에서는 CSS가 br을 숨겨 단락을 푼다. */}
              <p>{f.a.split('\n').map((l, i) => (<>{i > 0 && <br />}{l}</>))}</p>
            </details>
          ))}
        </div>
        </div>
      </div>
    </section>

    <!-- 관련 활용 -->
    <section class="ind-section ind-soft">
      <div class="ind-container">
        {/* 줄바꿈은 <br>로 명시한다. 대제목과 소제목은 한 줄에 좌우로 앉는데,
            영문처럼 문구가 길면 flex-wrap이 걸려 소제목이 아래로 떨어진다.
            그때 두 줄로 나눠 좌우 자리를 지킨다. */}
        <header class="ind-head">
          <h2 set:html={T.usesHead}></h2>
          <p set:html={T.usesLede}></p>
        </header>
        <div class="ind-grid ind-grid-4">
          {uses.map((u) => (
            <a class="ind-card" href={u.href}>
              <h3>{u.label}</h3>
              {/* 개행은 <br>로 낸다. 좁은 폭에서는 CSS가 br을 숨겨 단락을 푼다. */}
              <p>{u.desc.split('\n').map((l, i) => (<>{i > 0 && <br />}{l}</>))}</p>
              <span class="ind-card-go">{T.more}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="ind-cta ai-cta-bg">
      <img class="ai-cta-bg-img" src="/use-cases/cta-bg.webp" alt="" aria-hidden="true" loading="lazy" decoding="async" width="1920" height="1080" />
      <div class="ind-container">
        <h2 set:html={T.ctaTitle}></h2>
        <a href={T.contactHref} class="ind-btn-primary ind-btn-lg">{T.ctaPrimary}</a>
      </div>
    </section>
  </main>

  {!hasDemo && T.heroGraphic && (
  <script is:inline>
    /* 히어로 그래픽을 순서대로 보여준다. 칸 크기는 고정이고, 안에서 화면이
       확대·이동한다(SVG viewBox를 옮긴다 — 산업 AI 데모의 화면 따라가기와 같은 생각).

         아래 판이 아래에서부터 하나씩 쌓인다
         -> 회선이 그려지고 그 끝의 모듈로 확대해 들어간다 (Plate · Lens · AI Agent)
         -> 전체로 물러난다

       그림에 의미 있는 id가 없어 부분은 경계 상자로 갈랐다. 회선 세 다발만
       최상위 그룹 번호로 잡는다(26 왼쪽 · 27 가운데 · 25 오른쪽). */
    (function () {
      var obj = document.getElementById('ai-hero-graphic');
      if (!obj) return;

      var LINES = [26, 27, 25];
      var TOP_BAND = 380;          /* 아랫변이 이보다 위면 위쪽 모듈이다 */
      var VB = 1200;               /* 원본 viewBox는 0 0 1200 1200 */
      /* 카메라가 잡을 자리(원본 좌표). 실측한 경계 상자에서 왔다. */
      var SHOTS = {
        /* pad는 상자 둘레 여유(긴 변 대비 비율).
           판은 크게 보여야 해서 좁게, 회선 다발은 좌우가 잘리지 않게 넉넉히 준다. */
        /* 판 다섯의 실측 경계는 x196..1004 · y396..1180이다. 여유를 0.01로 두면
           위 여백이 4밖에 남지 않아, 경계 상자 밖으로 번지는 맨 위 판의 그림자가
           프레임에 잘렸다(그림자는 흐림 효과라 getBBox에 잡히지 않는다).
           경계에 맞추고 여유를 올려 위아래로 여백을 남긴다.
           0.055 — 그림자를 살리는 데는 0.03이면 됐지만, 칸이 테두리까지 넓어지며
           그림 높이가 682에서 762로 커져 판이 그만큼 크게 보인다. 조금 눅인 값. */
        stack: { x: 196, y: 396, w: 808, h: 784, pad: 0.055 },
        /* 그림 내용의 실측 경계(x34..1166 · y20..1180)다. 0 0 1200 1200으로 잡으면
           위아래 빈 자리까지 프레임에 넣느라 배율이 0.61로 깎인다. 경계에 맞추면
           0.644 — 판 높이(762)와 내용 높이(1160)로 가능한, 잘리지 않는 최대다. */
        whole: { x: 34, y: 20, w: 1132, h: 1160, pad: 0.01 }
      };

      var SVGNS = 'http://www.w3.org/2000/svg';

      function run() {
        var doc = obj.contentDocument;
        if (!doc) return;
        var svg = doc.querySelector('svg');
        var root = doc.querySelector('#_레이어_1') || (svg && svg.querySelector('g'));
        if (!svg || !root) return;

        var REDUCE = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        /* 섞기(mix-blend-mode)를 걷는다. 섞으려면 브라우저가 뒤 배경을 버퍼로
           읽어야 하고, 그 버퍼가 표시 배율로 잡혀 배경 전체가 흐려진다 — 맨 위 판이
           뜰 때 아래 판 넷이 흐려지던 원인이다. 되돌리지 않는다.

           하늘색 빛무리(outer-glow)는 그대로 둔다. 판5가 뜰 때 흐려지는 원인으로
           의심해 걷어 봤지만, 켜고 끄며 재니 선명도가 22.98 대 22.64로 사실상
           같았다 — 원인은 섞기였다. */
        [].slice.call(doc.querySelectorAll('[class]')).forEach(function (el) {
          var cs = doc.defaultView.getComputedStyle(el);
          if (cs.mixBlendMode && cs.mixBlendMode !== 'normal') el.style.mixBlendMode = 'normal';

        });

        var kids = [];
        for (var i = 0; i < root.children.length; i++) kids.push(root.children[i]);
        var gNo = [], n = 0;
        kids.forEach(function (el) { gNo.push(el.tagName === 'g' ? ++n : 0); });
        if (n < 27) return;

        /* 모듈 세 판이 놓인 가로 구간(실측). 그 사이 빈 구간에 있는 것은
           API 알약과 이음선이다 — 어느 한 모듈에 속하지 않으므로 따로 둔다.
           모듈로 확대해 들어갔을 때 옆에 API가 걸쳐 보이지 않게 하려는 것이고,
           전체로 물러날 때 함께 나온다. */
        var COLS = [[20, 355], [430, 765], [840, 1180]];
        var lineEls = [], modules = [[], [], []], betweens = [[], []], base = [], edges = [];
        kids.forEach(function (el, i) {
          var b;
          try { b = el.getBBox(); } catch (e) { return; }
          /* 폭이 0인 <line>도 있다(가운데 점선 기둥). 둘 다 0일 때만 건너뛴다 —
             폭만 보고 거르면 그 기둥이 감춰지지 않아 처음부터 보인다. */
          if (!b || (!b.width && !b.height)) return;
          var li = LINES.indexOf(gNo[i]);
          if (li >= 0) { lineEls[li] = el; return; }
          if (b.y + b.height <= TOP_BAND) {
            var cx = b.x + b.width / 2, col = -1;
            for (var k = 0; k < 3; k++) if (cx >= COLS[k][0] && cx <= COLS[k][1]) col = k;
            /* 어느 모듈도 아니면 사이 구간의 API다. 왼쪽 틈(플레이트–렌즈)과
               오른쪽 틈(렌즈–AI 에이전트)으로 나눠, 각각 그 오른쪽 판이 나올 때
               함께 나오게 한다 — 판보다 먼저 떠 있으면 순서가 어긋나 보인다. */
            if (col < 0) betweens[cx < COLS[1][0] ? 0 : 1].push(el);
            else modules[col].push(el);
          } else if (b.height > Math.max(b.width, 1) * 1.6 && b.height > 120) {
            /* 좌·우·가운데 점선 기둥. 층을 가로지르므로 겹이 다 쌓인 뒤에 나온다.
               흐름 규칙이 클래스 대신 이 표시를 보고 걸린다. */
            el.classList.add('flow-edge');
            edges.push(el);
          } else {
            base.push({ el: el, bottom: b.y + b.height });
          }
        });
        base.sort(function (a, b) { return b.bottom - a.bottom; });

        /* 그룹마다 원래 투명도가 다르다(옅은 층이 있다). CSS로 덮으면 끝나고 나서
           그 층까지 진해지므로, 원래 값을 기억했다가 되돌린다. */
        var all = base.map(function (b) { return b.el; })
          .concat(modules[0], modules[1], modules[2], betweens[0], betweens[1], edges);
        /* 감출 때는 전환을 끈다. .seq에 걸린 0.5초 전환이 그대로 먹으면 원래 상태에서
           서서히 사라지느라 그 사이가 보인다 — 회선이 먼저 스쳐 보이던 원인이다.
           숨긴 뒤 한 프레임 지나서 전환을 되살려, 나타날 때만 부드럽게 한다. */
        var hide = function (el) {
          var o = doc.defaultView.getComputedStyle(el).opacity;
          el.__o = (o === '' || o == null) ? '1' : o;
          el.classList.add('seq');
          el.style.transition = 'none';
          el.style.opacity = '0';
        };
        all.forEach(hide);

        /* 그림 속 글자는 모두 도형으로 떠 있다(<text>가 하나도 없다). 작은 크기에서
           획이 1픽셀에 못 미쳐 뭉개지므로, 같은 색 획을 얹어 굵기만 보탠다 —
           자리도 크기도 그대로다. 실측한 글자 뭉치의 왼위 좌표로 찾는다:
           모듈 라벨 셋 · API 둘 · Refinery Ontology(글자와 로고) · Data ·
           Work flow(두 낱말). 알약 셋은 아래에서 따로 집는다. */
        var TEXTS = [[144, 330], [552, 330], [944, 330], [387, 185], [794, 185],
                     [861, 682], [936, 647], [963, 939], [758, 706], [774, 715]];
        /* 여기서는 모아만 두고, 마지막 전체 모습에서(buildFlow) 굵힌다.
           확대 구간에서는 글자가 이미 크고, 거기서 걸면 배율이 곱해져 획이
           0.38px로 설계보다 굵어진다. */
        var glyphs = [];
        function thicken(p) { glyphs.push(p); }
        function applyThicken() {
          glyphs.forEach(function (p) {
            var f = doc.defaultView.getComputedStyle(p).fill;
            if (!f || f === 'none') return;
            p.style.stroke = f;
            p.style.strokeWidth = '0.2px';
            p.style.paintOrder = 'stroke fill';
          });
        }
        doc.querySelectorAll('g').forEach(function (g) {
          var gb;
          try { gb = g.getBBox(); } catch (e) { return; }
          for (var i = 0; i < TEXTS.length; i++) {
            if (Math.abs(gb.x - TEXTS[i][0]) < 3 && Math.abs(gb.y - TEXTS[i][1]) < 3) {
              g.querySelectorAll('path,polygon').forEach(thicken);
              return;
            }
          }
        });
        /* Collect · Refine · Unify 알약 안 글자. 알약 자체(면)는 두고 글자만 굵힌다. */
        kids.forEach(function (el) {
          var b;
          try { b = el.getBBox(); } catch (e) { return; }
          if (!b) return;
          if (b.x > 700 && b.width >= 40 && b.width <= 80 && b.height >= 35
              && b.height <= 70 && b.y + b.height >= 780 && b.y + b.height <= 1000) {
            el.querySelectorAll('path,polygon').forEach(function (p) {
              var pb;
              try { pb = p.getBBox(); } catch (e) { return; }
              if (pb.height > 1 && pb.height < 20) thicken(p);
            });
          }
        });

        var style = doc.createElementNS(SVGNS, 'style');
        style.textContent =
          /* 확대·축소가 오가므로 속도보다 기하 정확도를 우선한다. */
          'svg{shape-rendering:geometricPrecision}' +
          '.seq{transition:opacity .5s ease}' +
          '.line path{transition:stroke-dashoffset 1.3s ease,opacity .35s ease}' +
          /* --- 아래는 메인 랜딩 SVG의 규칙을 값까지 그대로 옮긴 것이다.
                 .flow-on이 걸린 뒤에만 돈다(그 전에는 회선을 그려 보여야 한다). --- */
          /* 회선은 랜딩 값 그대로다 — 6/9 점선이 1.6초에 한 번, 홀짝 그룹이
             서로 반대 방향으로 흐른다. 이동량 30은 주기(6+9=15)의 두 배라
             한 바퀴가 매끄럽다. */
          '.flow-on path.cls-2{stroke-dasharray:6 9;animation-duration:1.6s;' +
            'animation-timing-function:linear;animation-iteration-count:infinite}' +
          '.flow-on g:nth-of-type(odd)>path.cls-2{animation-name:connector-dot-up}' +
          '.flow-on g:nth-of-type(even)>path.cls-2{animation-name:connector-dot-down}' +
          /* 기둥은 클래스가 아니라 스크립트가 찾아 표시한 것(.flow-edge)에 건다.
             랜딩은 .cls-4 · .cls-6 · line.cls-9로 집었지만, 이 그림은 원본을
             내보낼 때마다 클래스 번호가 다른 도형에 재사용된다 — 실제로 cls-6이
             하나에서 다섯으로 늘며 맨 위 판 안쪽 도형까지 점선이 됐다. */
          '.flow-on .flow-edge line,.flow-on line.flow-edge{' +
            'stroke-dasharray:2 8;animation:connector-line-flow-up-slow 2.6s linear infinite}' +
          /* 겹 띠는 굵기와 간격을 건드리지 않는다. 랜딩 값(1.5px · 0.5/6)은 어두운
             면 위에서 번지는 띠로 읽히지만, 밝은 면에서는 두 배로 굵어진 점이
             자글자글하게 부서져 보인다. 원본이 그린 대로 두고 밝기만 숨쉰다. */
          '.flow-on polygon.cls-9{animation:layer-band-breathe 2.8s ease-in-out infinite}' +
          '.flow-on line.cls-3[y1="185.58"],.flow-on line.cls-3[y1="193.58"]{' +
