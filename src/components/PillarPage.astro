        tx = Math.min(0, Math.max(tx, bw - FRAME_W * s));
        ty = Math.min(0, Math.max(ty, bh - FRAME_H * s));
        if (FRAME_W * s < bw) tx = (bw - FRAME_W * s) / 2;
        if (FRAME_H * s < bh) ty = (bh - FRAME_H * s) / 2;

        frame.style.width = FRAME_W + 'px';
        frame.style.height = FRAME_H + 'px';
        frame.style.left = '0px';
        frame.style.top = '0px';
        frame.style.transition = animate ? 'transform .7s cubic-bezier(.22,.61,.36,1)' : 'none';
        frame.style.transform = 'translate(' + tx + 'px, ' + ty + 'px) scale(' + s + ')';
      }

      function resize() { render(false); }

      /* 데모가 알려주는 강조 범위를 따라 화면을 옮기고, 설명 카드를 좌측에 그린다.
         랜딩과 달리 이 페이지는 전체를 멀리서 보여주는 대신 지금 설명 중인 곳으로
         당겨서 보여주고, 설명은 데모 밖 카드가 맡는다. */
      function initFocus() {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var card = document.getElementById('ai-demo-cap');
        window.addEventListener('message', function (e) {
          /* 아무 창이나 보낼 수 있는 메시지다. 우리 iframe에서 온 것만 받는다. */
          var frame = document.getElementById('ai-demo-iframe');
          if (e.origin !== window.location.origin) return;
          if (!frame || e.source !== frame.contentWindow) return;
          if (!e.data) return;

          /* 한 바퀴가 새로 시작한다는 신호. 매 바퀴 시작 화면에 다시 머문다. */
          if (e.data.type === 'refinery-hero-cycle') { started = true; beginHold(); return; }
          if (e.data.type !== 'refinery-hero-focus') return;

          if (holding) {
            /* 첫 화면에 머무는 동안은 장면을 반영하지 않는다. 마지막 것만 들고
               있다가 다시 풀릴 때 적용한다(데모도 세워 둔 상태라 장면은 안 넘어간다). */
            pendingFocus = e.data;
            return;
          }
          apply(e.data);
        });

        beginHold();

        /* 시작 화면에 머문다. 데모를 세워 두고 좌측에는 여는 글을 띄운 뒤,
           HOLD_MS가 지나면 다시 돌린다. 첫 로드와 매 바퀴 시작에 쓴다. */
        function beginHold() {
          var f = document.getElementById('ai-demo-iframe');
          /* 이미 머무는 중이면 그대로 둔다. 첫 로드에서는 데모가 스스로 시작한
             신호와 우리가 보낸 시작 신호가 겹칠 수 있는데, 그때마다 다시 걸면
             첫 머무름만 두 배로 길어진다. */
          if (holding && holdTimer) return;
          if (holdTimer) clearTimeout(holdTimer);
          holdTimer = null;
          holding = true;
          pendingFocus = null;
          focusBox = null;
          if (card) card.classList.add('is-opening');
          setCap(OPENING);
          render(true);
          /* 데모를 아직 안 불러왔으면 세울 대상이 없다. 여는 글만 띄워 두고,
             데모가 한 바퀴를 시작하며 보내는 신호(refinery-hero-cycle)를 기다린다.
             그때 이 함수가 다시 불려 제대로 머무른다. */
          if (!f || !f.src) return;
          try { f.contentWindow.postMessage({ type: 'refinery-hero-pause' }, '*'); } catch (e) {}
          holdTimer = setTimeout(function () {
            holding = false;
            holdTimer = null;
            try { f.contentWindow.postMessage({ type: 'refinery-hero-resume' }, '*'); } catch (e) {}
            if (pendingFocus) { apply(pendingFocus); pendingFocus = null; }
            else render(true);
          }, HOLD_MS);
        }

        function apply(d) {
          if (!reduce) { focusBox = d.box || null; render(true); }

          if (!card) return;
          if (d.cap) {
            /* 첫 화면 글은 '다른 글로 바뀔 때' 비로소 장면 크기로 넘긴다.
               머무름이 끝나는 시점에 떼면, 첫 장면 신호가 오기 전까지
               같은 문구가 40 -> 32px로 잠깐 줄었다가 바뀐다. */
            card.classList.remove('is-opening');
            setCap(d.cap);
          } else {
            card.classList.remove('is-on');
          }
        }
      }

      /* 좌측 글을 채운다. 제목은 카피에 넣어둔 \n에서 두 줄로 나눈다.
         데모 안 카드는 textContent라 \n이 공백으로 합쳐져 한 덩어리로 보인다. */
      function setCap(t) {
        var card = document.getElementById('ai-demo-cap');
        if (!card) return;
        document.getElementById('ai-demo-cap-kicker').textContent = t.kicker;
        var titleEl = document.getElementById('ai-demo-cap-title');
        titleEl.textContent = '';
        String(t.title).split('\n').forEach(function (line, i) {
          if (i) {
            /* <br> 앞에 공백을 함께 넣는다. 좁은 폭에서는 CSS가 <br>를 숨겨
               두 줄을 한 줄로 푸는데, 공백이 없으면 '권한은내가'처럼 붙는다.
               줄 끝의 공백은 그대로 두어도 보이지 않는다. */
            titleEl.appendChild(document.createTextNode(' '));
            titleEl.appendChild(document.createElement('br'));
          }
          titleEl.appendChild(document.createTextNode(line));
        });
        card.classList.add('is-on');
      }

      /* 성능: 무거운 데모 iframe은 페이지가 인터랙티브해진 뒤에 불러온다. */
      function load() {
        var f = document.getElementById('ai-demo-iframe');
        if (f && !f.src && f.getAttribute('data-src')) {
          f.addEventListener('load', function () {
            /* 설명 카드를 이 페이지가 직접 그린다. 데모 안 카드는 숨겨진다. */
            try { f.contentWindow.postMessage({ type: 'refinery-hero-extcap' }, '*'); } catch (e) {}
            /* 시작 화면 머무름(pause)은 beginHold가 맡는다. 데모는 첫 장면을
               로드 179ms에 띄우므로 세워 두지 않으면 첫 화면이 보이지 않는다. */
            /* 랜딩 기본값은 3배속이다. 이 페이지는 화면이 장면마다 움직이므로
               더 천천히 간다. 설명이 머무는 시간은 배속과 무관하다. */
            try { f.contentWindow.postMessage({ type: 'refinery-hero-speed', value: 2 }, '*'); } catch (e) {}
            /* 설명 체류는 배속과 별개다(실시간). 좌측에 32px 두 줄로 크게 띄우는
               페이지라 기본 2.36초로는 읽기 빠듯해 1.3배로 늘린다. */
            try { f.contentWindow.postMessage({ type: 'refinery-hero-dwell', value: 1.3 }, '*'); } catch (e) {}
            /* 데모는 자기 무대가 35% 이상 보일 때만 스스로 시작한다
               (IntersectionObserver). 이 페이지는 화면을 당겨서 보여주므로
               시작 화면(1.10배)에서는 20%만 보여 영영 시작하지 않는다.
               스스로 시작하지 못했을 때만 직접 시작시킨다 — 둘 다 걸리면
               한 바퀴가 두 번 시작해 첫 머무름만 길어진다. */
            setTimeout(function () {
              if (started) return;
              try { f.contentWindow.postMessage({ type: 'refinery-hero-replay' }, '*'); } catch (e) {}
            }, 400);
            resize();
          });
          f.src = f.getAttribute('data-src');
        }
      }

      window.addEventListener('load', function () { initFocus(); resize(); load(); });
      window.addEventListener('resize', resize);
      document.addEventListener('DOMContentLoaded', resize);
    })();
  </script>
  )}
  <Footer />
</BaseLayout>

<style>
  /* 블록 폭을 컨테이너 하나로 맞춘다. 전에는 Q&A만 760px이라 구분선이 화면 중간에서
     끊기고, 아래 카드 그리드(1072px)와 오른쪽 끝이 어긋나 페이지가 두 축으로 보였다.
     글줄이 길어지는 것은 문단에만 읽기 폭(72ch)을 걸어 막는다 — 제목과 구분선은
     전체 폭을 쓰고 본문만 짧게 끊긴다. */
  /* 제목 왼쪽 · 문답 오른쪽으로 나눈다 — 예지보전 자주 묻는 질문(.uc-faq-head)과 같은 값.
     오른쪽 칸이 답변 줄 길이를 잡아 주므로 문단에 폭 제한을 따로 걸지 않는다. */
  .qa-head { display: grid; grid-template-columns: 1fr 2fr; gap: 64px; align-items: start; }
  .qa-head .ind-head { max-width: none; margin-bottom: 0; }
  @media (max-width: 900px) { .qa-head { grid-template-columns: 1fr; gap: 24px; } }

  /* 가로선은 항목 사이에만 긋는다 — 목록 위·아래 끝에는 두지 않는다(예지보전과 같다). */
  .qa-list { max-width: none; }
  .qa-item { border-bottom: 1px solid #E3E7EC; }
  .qa-item:last-child { border-bottom: none; }

  /* 기본 삼각형 표식을 지우고 제목과 캐럿을 양 끝으로 벌린다. */
  .qa-item summary {
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    padding: 20px 0; cursor: pointer; list-style: none;
  }
  .qa-item summary::-webkit-details-marker { display: none; }
  /* 질문·답변·캐럿 값은 예지보전 '자주 묻는 질문'(.uc-faq-*)과 같다.
     질문은 h3다 — 섹션 제목(h2) 아래 항목이라 한 단 내려온다. */
  .qa-item h3 {
    font-size: 20px; font-weight: 600; letter-spacing: normal;
    line-height: 1.65; color: #16202C; margin: 0;
  }
  .qa-caret {
    flex: 0 0 auto; font-size: 14px; color: #8A94A3;
    transition: transform .2s ease;
  }
  .qa-item[open] .qa-caret { transform: rotate(180deg); }
  /* 답변 칸이 747px일 때(창 1280px 이상) 맞춘 단락이라, 칸이 좁아지면 푼다.
     개행 앞에 공백을 둬 br이 사라져도 앞뒤 어절이 붙지 않는다.
     어절 중간에서 끊기지 않는 것은 .ind-page의 word-break: keep-all이 맡는다. */
  @media (max-width: 1279px) { .qa-item p br { display: none; } }
  .qa-item p {
    font-size: 15px; line-height: 1.5; color: #7E8A98;
    margin: 0; padding: 0 0 24px;
  }
  /* 키보드로 짚었을 때 어디에 있는지 보이게 한다. */
  .qa-item summary:focus-visible { outline: 2px solid #76A6D7; outline-offset: 4px; border-radius: 4px; }
  /* 히어로를 자료실(.res-page .ind-hero)과 같은 값으로 맞춘다.
     면과 아래 구분선을 빼 다음 섹션과 한 흐름으로 잇고, 아래 여백은 0으로 둔다 —
     제목과 본문 사이는 섹션 위 여백이 잡는다. */
  .ind-hero {
    padding: 180px 0 0;
    background: none;
    border-bottom: none;
    text-align: center;
  }
  .ind-hero h1 {
    font-size: clamp(30px, 4.2vw, 48px);
    font-weight: 600;
    letter-spacing: -0.8px;
    line-height: 1.3;
  }
  @media (max-width: 900px) { .ind-hero { padding: 120px 0 0; } }
  /* 히어로 버튼 — 예지보전 히어로와 같은 형태다(9px 22px · 15px/400 · 반경 6px ·
     테두리 1px · 묶음 margin-top 48px · gap 16px).
     색은 그 페이지의 '밝은 배경용' 규칙을 따른다. 거기 히어로는 어두운 사진 위라
     보조 버튼이 흰 테두리인데, 이 히어로는 밝은 면이라 그대로 쓰면 보이지 않는다.
     주 버튼만 같은 accent 면(#76A6D7)을 유지해 시선이 먼저 닿는 자리를 지킨다. */
  .ind-hero-actions { margin-top: 48px; gap: 16px; justify-content: center; }
  .ind-hero-actions .ind-btn-primary,
  .ind-hero-actions .ind-btn-ghost {
    padding: 9px 22px; font-size: 15px; font-weight: 400;
    border-radius: 6px; border: 1px solid; transition: all .2s;
  }
  .ind-hero-actions .ind-btn-primary {
