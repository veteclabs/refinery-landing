    /* 히어로 아래 에이전트 데모. 랜딩(index.astro)의 같은 스크립트와 짝이지만
       ID가 달라 섞이지 않는다. 공용 컴포넌트로 뽑는 건 랜딩 히어로까지 건드리는
       일이라 여기서는 이 페이지에 필요한 만큼만 둔다. */
    (function () {
      /* 무대는 1320x840 고정이고 K = min(폭/1320, 높이/840)로 줄어든다.
         높이를 비율보다 2px 크게 잡아 K가 폭에서 정해지게 하면 무대가 폭을 정확히 채운다.
         (높이 쪽이 먼저 걸리면 좌우에 데모 페이지 배경 #E9ECEF가 남는다.) */
      var STAGE_W = 1320, STAGE_H = 840;
      var FRAME_W = 1440;
      var FRAME_H = Math.ceil(FRAME_W * STAGE_H / STAGE_W) + 2;
      /* 데모가 강조 중인 범위(무대 좌표). 없으면 기본 자리를 보여준다. */
      var focusBox = null;
      /* 강조가 없을 때 보여줄 자리(무대 좌표). 무대 전체(1320x840)를 다 담으면
         데모 칸이 좁아 0.5배까지 줄고, 데모 안 13px 글자가 6px대가 되어 안 읽힌다.
         대화 영역 쪽으로 당겨 두고, 강조가 들어오면 거기로 옮긴다.
         위쪽 끝은 질문 말풍선(.user-bubble, 실측 y54..93)이 들어오도록 잡는다 —
         y를 120에서 시작하면 말풍선이 통째로 위로 잘려 안 보인다.
         상자 비율(882:560)을 칸 비율(718:457)에 맞춰 배율은 0.746 그대로다. */
      var REST_BOX = { x: 348, y: 44, w: 882, h: 560 };
      /* 첫 화면(무엇을 분석할까요?)이 있는 자리. 여기서 잠깐 멈췄다가 첫 장면으로
         넘어간다. 데모의 빈 화면 요소를 실측한 범위는 x551..1021, y250..529
         (아이콘·제목·소개글·추천 카드)이고 가운데는 (786, 390)이다.
         상자 가운데를 그 값에 맞춰야 칸 한가운데로 온다 — 어림잡으면 위아래로
         치우친다(가운데를 420으로 뒀을 때 내용이 35px 위로 붙었다).
         상자 크기로 배율이 정해진다. 590x400은 1.047배(여백 68/70px)로 위가
         허전했고, 540x340은 1.22배로 과했다. 580x380에서 1.10배(여백 60/61px)다. */
      var START_BOX = { x: 496, y: 200, w: 580, h: 380 };
      /* 첫 화면에 머무는 시간. 이 동안 데모를 세워 두고 장면 신호도 미뤄 둔다. */
      /* 여는 글이 머무는 시간(1초). 1600 은 꽉 찬 뒤로도 한참 멈춰 있는 것처럼
         보였고 아예 건너뛰니 너무 급했다 — 700 을 거쳐 1000 으로 맞췄다.
         바퀴마다의 머무름도 같은 값이다. */
      var HOLD_MS = 1000;
      /* 첫 화면에 함께 두는 좌측 글. 장면들과 같은 자리를 쓰고, 첫 장면이 오면
         그 내용으로 바뀐다. 여기만 태그라인 없이 제목 하나로 간다(.is-opening). */
      var OPENING = {
        kicker: '',
        title: (document.getElementById('ai-demo-cap') || {}).dataset
          ? document.getElementById('ai-demo-cap').dataset.openTitle
          : ''
      };
      var holding = true;
      /* 데모를 돌리기 시작했는지. 기본 모습에서는 첫 장면에 세워 둔다. */
      var demoStarted = false;
      /* 칸을 눌러 건너뛴 직후 한 번은 여는 글에 머물지 않는다 — 누른 장면이
         곧바로 보여야 한다. */
      var skipHold = false;
      var pendingFocus = null;
      var holdTimer = null;
      /* 데모가 한 바퀴를 시작했는지. 아래 '직접 시작' 신호를 중복으로 보내지 않는다. */
      var started = false;
      /* 배율 하한. 강조 대상이 이 배율에 다 안 들어오면 좌우가 잘린다 —
         다 보여주려다 못 읽는 것보다 잘리더라도 읽히는 편이 낫다. */
      var MIN_SCALE = 0.68;
      var MAX_ZOOM = 2.2;

      function render(animate) {
        var box = document.querySelector('.ai-hero-figure');
        var frame = document.getElementById('ai-demo-iframe');
        if (!box || !frame) return;
        var bw = box.offsetWidth, bh = box.offsetHeight;
        var stageToFrame = FRAME_W / STAGE_W;
        var fit = bw / FRAME_W;                    /* 무대 전체를 담는 배율 */
        /* 설명이 데모 위로 올라가는 폭에서는 데모가 칸을 넓게 쓰므로 당기지 않고
           전체를 보여준다. 좁은 화면에서 당기면 화면 대부분이 잘려 나간다. */
        /* ⚠️ 늘 true 다. 데모 화면을 원본 그대로 보여준다 — 당겨서 자르거나
           따라다니지 않고, 한 배율로 화면 전체를 담는다.
           ⚠️ 데모 안의 설명 카드는 그대로 숨긴다(extcap). 설명은 왼쪽 글과
              구간 막대가 맡는다. */
        var stacked = true;

        var s, cx, cy;
        if (holding) {
          /* 첫 화면 자리. 좁은 화면에서는 전체를 보여준다. */
          if (stacked) { s = fit; cx = FRAME_W / 2; cy = FRAME_H / 2; }
          else {
            var sx = START_BOX.x * stageToFrame, sy = START_BOX.y * stageToFrame;
            var sw = START_BOX.w * stageToFrame, sh = START_BOX.h * stageToFrame;
            s = Math.max(MIN_SCALE, Math.min(bw / sw, bh / sh));
            cx = sx + sw / 2; cy = sy + sh / 2;
          }
        } else if (stacked && !focusBox) {
          s = fit; cx = FRAME_W / 2; cy = FRAME_H / 2;
        } else {
          var target = focusBox || REST_BOX;
          /* 강조 상자 둘레 여백(무대 좌표).
             강조 상자는 확장(레일)을 빼면 6개가 모두 폭 756으로 같고 높이만
             41~319로 다르다. 그래서 배율은 늘 폭에서 정해지고, 보이는 세로는
             폭이 정한 값(=756/칸비율)을 따라간다. 여백을 줄이면 배율이 올라
             그 756짜리 줄이 좌우로 잘려 나간다 — 강조된 줄이 잘리면 비율이
             어그러져 보인다. 40은 그 줄이 좌우 여유를 갖는 값이다.
             쉬는 자리(REST_BOX)에는 주지 않는다. 붙이면 위 끝이 43에서 16으로
             올라가 상단 바(y0..38)가 화면에 들어온다. */
          var pad = (focusBox ? 40 : 0) * stageToFrame;
          var fx = target.x * stageToFrame - pad;
          var fy = target.y * stageToFrame - pad;
          var fw = target.w * stageToFrame + pad * 2;
          var fh = target.h * stageToFrame + pad * 2;
          s = Math.min(bw / fw, bh / fh);
          var floor = stacked ? fit : MIN_SCALE;
          s = Math.max(floor, Math.min(s, floor * MAX_ZOOM));
          cx = fx + fw / 2; cy = fy + fh / 2;
        }

        /* 보고 있는 자리의 가운데를 칸 가운데로 당긴다. */
        var tx = bw / 2 - cx * s;
        var ty = bh / 2 - cy * s;
        /* 데모 페이지 배경이 비치지 않도록 가장자리를 넘지 않게 가둔다. */
        tx = Math.min(0, Math.max(tx, bw - FRAME_W * s));
        ty = Math.min(0, Math.max(ty, bh - FRAME_H * s));
        if (FRAME_W * s < bw) tx = (bw - FRAME_W * s) / 2;
        if (FRAME_H * s < bh) ty = (bh - FRAME_H * s) / 2;

        frame.style.width = FRAME_W + 'px';
        frame.style.height = FRAME_H + 'px';
        frame.style.left = '0px';
        frame.style.top = '0px';
        frame.style.transition = animate ? 'transform .7s cubic-bezier(.22,.61,.36,1)' : 'none';
        frame.style.transform = 'translate(' + tx + 'px, ' + ty + 'px) scale(' + s + ')';
      }

      function resize() { render(false); }

      /* 데모가 알려주는 강조 범위를 따라 화면을 옮기고, 설명 카드를 좌측에 그린다.
         랜딩과 달리 이 페이지는 전체를 멀리서 보여주는 대신 지금 설명 중인 곳으로
         당겨서 보여주고, 설명은 데모 밖 카드가 맡는다. */
      function initFocus() {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var card = document.getElementById('ai-demo-cap');
        window.addEventListener('message', function (e) {
          /* 아무 창이나 보낼 수 있는 메시지다. 우리 iframe에서 온 것만 받는다. */
          var frame = document.getElementById('ai-demo-iframe');
          if (e.origin !== window.location.origin) return;
          if (!frame || e.source !== frame.contentWindow) return;
          if (!e.data) return;

          /* 한 바퀴가 새로 시작한다는 신호. 매 바퀴 시작 화면에 다시 머문다. */
          if (e.data.type === 'refinery-hero-chapters') { barNames(e.data.names); return; }
          if (e.data.type === 'refinery-hero-chapter') { barChapter(e.data.i, e.data.total); return; }
          if (e.data.type === 'refinery-hero-progress') { barProgress(e.data.i, e.data.p); return; }
          if (e.data.type === 'refinery-hero-cycle') {
            started = true;
            /* ⚠️ 건너뛴 직후에는 여는 글로 되돌아가지 않는다. 그대로 두면 누른
               장면 대신 '묻는 것으로 시작하는' 이 1.6초 동안 떠 있고, 그동안
               장면 신호도 묶여 글이 안 바뀐다. */
            if (skipHold) { skipHold = false; return; }
            beginHold();
            return;
          }
          if (e.data.type !== 'refinery-hero-focus') return;

          if (holding) {
            /* 첫 화면에 머무는 동안은 장면을 반영하지 않는다. 마지막 것만 들고
               있다가 다시 풀릴 때 적용한다(데모도 세워 둔 상태라 장면은 안 넘어간다). */
            pendingFocus = e.data;
            return;
          }
          apply(e.data);
        });

        beginHold();

        /* 시작 화면에 머문다. 데모를 세워 두고 좌측에는 여는 글을 띄운 뒤,
           HOLD_MS가 지나면 다시 돌린다. 첫 로드와 매 바퀴 시작에 쓴다. */
        function beginHold() {
          var f = document.getElementById('ai-demo-iframe');
          /* 이미 머무는 중이면 그대로 둔다. 첫 로드에서는 데모가 스스로 시작한
             신호와 우리가 보낸 시작 신호가 겹칠 수 있는데, 그때마다 다시 걸면
             첫 머무름만 두 배로 길어진다. */
          if (holding && holdTimer) return;
          if (holdTimer) clearTimeout(holdTimer);
          holdTimer = null;
          holding = true;
          pendingFocus = null;
          focusBox = null;
          if (card) card.classList.add('is-opening');
          setCap(OPENING);
          render(true);
          /* 데모를 아직 안 불러왔으면 세울 대상이 없다. 여는 글만 띄워 두고,
             데모가 한 바퀴를 시작하며 보내는 신호(refinery-hero-cycle)를 기다린다.
             그때 이 함수가 다시 불려 제대로 머무른다. */
          if (!f || !f.src) return;
          try { f.contentWindow.postMessage({ type: 'refinery-hero-pause' }, '*'); } catch (e) {}
          /* ⚠️ 아직 시작 전이면 푸는 타이머를 걸지 않는다. 세우는 신호만으로는
             모자라다 — 데모가 한 바퀴를 시작하며 보내는 신호에 이 함수가 다시
             불리고, 그때 걸린 타이머가 HOLD_MS 뒤에 풀어 버려 기본 모습에서도
             데모가 돌았다. 카드가 화면을 꽉 채울 때 __aiHeroStartDemo 가
             demoStarted 를 켜고 이 함수를 다시 부른다. */
          if (!demoStarted) return;
          holdTimer = setTimeout(function () {
            holding = false;
            holdTimer = null;
            try { f.contentWindow.postMessage({ type: 'refinery-hero-resume' }, '*'); } catch (e) {}
            if (pendingFocus) { apply(pendingFocus); pendingFocus = null; }
            else render(true);
          }, HOLD_MS);
        }

        function apply(d) {
          /* ⚠️ 장면이 가리키는 상자(focusBox)를 받지 않는다. 받으면 그 자리로
             확대 · 이동해 화면 일부만 보인다 — 데모 화면은 원본 그대로, 한
             배율로 전체를 보여준다. 글과 구간 막대는 그대로 바뀐다. */
          if (!reduce) { focusBox = null; render(true); }

          if (!card) return;
          if (d.cap) {
            /* 첫 화면 글은 '다른 글로 바뀔 때' 비로소 장면 크기로 넘긴다.
               머무름이 끝나는 시점에 떼면, 첫 장면 신호가 오기 전까지
               같은 문구가 40 -> 32px로 잠깐 줄었다가 바뀐다. */
            card.classList.remove('is-opening');
            setCap(d.cap);
          } else {
            card.classList.remove('is-on');
          }
        }
      }

      /* 좌측 글을 채운다. 제목은 카피에 넣어둔 \n에서 두 줄로 나눈다.
         데모 안 카드는 textContent라 \n이 공백으로 합쳐져 한 덩어리로 보인다. */
      function setCap(t) {
        var card = document.getElementById('ai-demo-cap');
        if (!card) return;
        document.getElementById('ai-demo-cap-kicker').textContent = t.kicker;
        var titleEl = document.getElementById('ai-demo-cap-title');
        titleEl.textContent = '';
        String(t.title).split('\n').forEach(function (line, i) {
          if (i) {
            /* <br> 앞에 공백을 함께 넣는다. 좁은 폭에서는 CSS가 <br>를 숨겨
               두 줄을 한 줄로 푸는데, 공백이 없으면 '권한은내가'처럼 붙는다.
               줄 끝의 공백은 그대로 두어도 보이지 않는다. */
            titleEl.appendChild(document.createTextNode(' '));
            titleEl.appendChild(document.createElement('br'));
          }
          titleEl.appendChild(document.createTextNode(line));
        });
        card.classList.add('is-on');
      }

      /* 성능: 무거운 데모 iframe은 페이지가 인터랙티브해진 뒤에 불러온다. */
      function load() {
        var f = document.getElementById('ai-demo-iframe');
        if (f && !f.src && f.getAttribute('data-src')) {
          f.addEventListener('load', function () {
            /* 설명 카드를 이 페이지가 직접 그린다. 데모 안 카드는 숨겨진다. */
            try { f.contentWindow.postMessage({ type: 'refinery-hero-extcap' }, '*'); } catch (e) {}
            /* 시작 화면 머무름(pause)은 beginHold가 맡는다. 데모는 첫 장면을
               로드 179ms에 띄우므로 세워 두지 않으면 첫 화면이 보이지 않는다. */
            /* 랜딩 기본값은 3배속이다. 이 페이지는 화면이 장면마다 움직이므로
               더 천천히 간다. 설명이 머무는 시간은 배속과 무관하다. */
            /* 데모 안의 동작(생각 · 도구 실행 · 표가 차는 것)만 빠르게 돌린다.
               2 로는 사이사이가 늘어져 보였다. 읽는 시간은 아래 dwell 이 따로
               쥐고 있어 여기 배속에 끌려가지 않는다. */
            try { f.contentWindow.postMessage({ type: 'refinery-hero-speed', value: 3 }, '*'); } catch (e) {}
            /* 설명 체류는 배속과 별개다(실시간). 좌측에 32px 두 줄로 크게 띄우는
               페이지라 기본 2.36초로는 읽기 빠듯해 1.3배로 늘린다. */
            try { f.contentWindow.postMessage({ type: 'refinery-hero-dwell', value: 1.3 }, '*'); } catch (e) {}
            /* 기본 모습에서는 첫 장면에 세워 둔다. 카드가 스크롤로 화면을 꽉
               채울 때 비로소 돌기 시작한다(아래 __aiHeroStartDemo).
               ⚠️ 데모는 제 무대가 35% 이상 보이면 스스로 시작한다
                  (IntersectionObserver). 카드가 커지면 그 선을 넘으므로, 세우는
                  신호를 로드 직후와 400ms 뒤 두 번 보낸다 — 사이에 스스로
                  출발해 버리는 프레임을 막는다. */
            try { f.contentWindow.postMessage({ type: 'refinery-hero-pause' }, '*'); } catch (e) {}
            setTimeout(function () {
              if (demoStarted) return;
              try { f.contentWindow.postMessage({ type: 'refinery-hero-pause' }, '*'); } catch (e) {}
            }, 400);
            resize();
          });
          f.src = f.getAttribute('data-src');
        }
      }

      /* 카드가 화면을 꽉 채운 순간 한 번만 불린다(아래 --grow 스크립트가 부른다).
         그때부터 데모가 돌고, 이후 머무름 · 따라가기는 종전 흐름이 맡는다. */
      /* 카드가 자라는 동안 칸 크기가 계속 바뀐다 — 그때마다 데모 배율을 다시
         잡아야 한다. 이 스크립트는 load 와 resize 에서만 재는데, --grow 는
         창 크기를 바꾸지 않으므로 resize 가 불리지 않는다.
         ⚠️ 이게 없으면 데모가 쉬는 크기(760px)의 배율 그대로 남아, 카드가
            1045px 로 커져도 안쪽이 작게 그려진다. */
      /* ───────── 구간 막대 ───────── */
      var bar = document.getElementById('ai-demo-bar');
      var barTotal = 7, barNo = null, barFill = null, barHits = null;
      function barBuild(total) {
        total = total || 7;
        if (!bar) return;
        if (barHits && barHits.children.length === total) { barTotal = total; barNum(); return; }
        barTotal = total;
        bar.innerHTML = '';
        var head = document.createElement('span');
        head.className = 'ai-demo-c-head';
        head.innerHTML = '<span class="ai-demo-c-no"></span>';
        bar.appendChild(head);
        barNo = head.querySelector('.ai-demo-c-no');
        /* 보이는 것은 한 줄이다. 그 위에 투명한 칸 일곱을 덮어 누르는 자리만
           나눈다 — 폭이 꼭 같아야 해서 flex-basis 0 에 grow 1 로 둔다. */
        var wrap = document.createElement('span');
        wrap.className = 'ai-demo-c-bar';
        wrap.innerHTML = '<span class="ai-demo-c-track"><span class="ai-demo-c-fill"></span></span>';
        var hits = document.createElement('span');
        hits.className = 'ai-demo-c-hits';
        for (var i = 0; i < total; i++) {
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'ai-demo-chit';
          btn.setAttribute('aria-label', (i + 1) + ' / ' + total);
          (function (k, el) {
            el.addEventListener('click', function () {
              demoStarted = true;
              if (holdTimer) { clearTimeout(holdTimer); holdTimer = null; }
              holding = false;
              pendingFocus = null;
              skipHold = true;
              /* 여는 글 상태를 벗는다 — 누른 장면의 글이 바로 올라온다. */
              var cc = document.getElementById('ai-demo-cap');
              if (cc) cc.classList.remove('is-opening');
              var fr = document.getElementById('ai-demo-iframe');
              if (!fr || !fr.src) return;
              try { fr.contentWindow.postMessage({ type: 'refinery-hero-goto', i: k }, '*'); } catch (e) {}
            });
          })(i, btn);
          hits.appendChild(btn);
        }
        wrap.appendChild(hits);
        bar.appendChild(wrap);
        barFill = wrap.querySelector('.ai-demo-c-fill');
        barHits = hits;
        barNum();
      }
      function pad2(n) { return (n < 10 ? '0' : '') + n; }
      var barIdx = 0;
      function barNum() {
        if (barNo) barNo.textContent = pad2(barIdx + 1) + ' / ' + pad2(barTotal);
      }
      function barSet(f) {
        if (barFill) barFill.style.width = Math.round(Math.max(0, Math.min(1, f)) * 1000) / 10 + '%';
      }
      /* 장면 이름 — 데모가 보내 준다. 지금은 칸 수만 쓴다. */
      var chapterNames = [];
      function barNames(names) {
        chapterNames = names || [];
        barBuild(chapterNames.length || 7);
        alignBar();
      }

      function barChapter(i, total) {
        barBuild(total || 7);
        barIdx = i;
        barNum();
        barSet(i / barTotal);
        alignBar();
      }
      function barProgress(i, p) {
        /* 세워 둔 상태에서 들어오는 늦은 신호는 버린다. */
        if (!demoStarted) return;
        barSet((i + p) / barTotal);
      }
      function barReset() {
        barIdx = 0;
        barNum();
        barSet(0);
      }

      /* 쉬는 모습에서도 막대는 보여야 한다 — 장면 수(7)만큼 빈 칸을 미리 만든다.
         첫 장면 신호가 오면 같은 수라 다시 만들지 않는다. */
      barBuild(7);
      alignBar();
      addEventListener('resize', alignBar);
      /* 데모가 자리를 잡은 뒤 한 번 더 맞춘다 — 처음 잴 때는 칸 크기가 아직
         바뀌는 중이라 17px 쯤 어긋난 채로 남았다. */
      setTimeout(alignBar, 800);
      setTimeout(alignBar, 2500);

      /* 막대 아랫변을 데모 아랫변에 맞춘다. 글은 세로 가운데에 서고 데모는
         그보다 길어, 그냥 두면 막대가 데모보다 한참 위에 뜬다.
         ⚠️ 두 칸 배치(901px 위)에서만 민다. 그 아래에서는 글이 데모 위로
            올라가므로 맞출 아랫변이 없다. */
      function alignBar() {
        if (!bar) return;
        bar.style.transform = '';
        if (!window.matchMedia || !matchMedia('(min-width: 901px)').matches) return;
        var fg = document.querySelector('.ai-hero-figure');
        if (!fg) return;
        /* ⚠️ 음수도 민다. 막대가 데모보다 아래에 있을 때 그냥 두었더니 17px
           내려간 채로 남았다. */
        var d = fg.getBoundingClientRect().bottom - bar.getBoundingClientRect().bottom;
        bar.style.transform = 'translateY(' + Math.round(d) + 'px)';
      }

      window.__aiHeroResize = function () { resize(); alignBar(); };

      /* 위로 다시 올려 카드가 쉬는 모습으로 돌아가면 데모를 첫 장면에 되돌려
         세운다. 그대로 두면 작아진 카드 안에서 영상만 계속 돌았다.
         ⚠️ replay 로 첫 장면으로 되감고 곧바로 pause 로 세운다. pause 만 보내면
            돌던 자리에 멈출 뿐 첫 장면으로 돌아가지 않는다.
         ⚠️ 세우는 신호를 한 번 더 보낸다. 되감기가 한 박자 뒤에 끝나 그 사이에
            다시 흘러가는 프레임이 있다. */
      window.__aiHeroStopDemo = function () {
        if (!demoStarted) return;
        demoStarted = false;
        if (holdTimer) { clearTimeout(holdTimer); holdTimer = null; }
        holding = true;
        pendingFocus = null;
        focusBox = null;
        /* ⚠️ card 는 이 바깥에 없다 — 다른 함수들이 저마다 제 안에서 찾아 쓴다.
           그냥 쓰면 ReferenceError 가 나고, 그 뒤 setCap 도 안 돌아 왼쪽 글이
           장면 글에 머문다(한참 그 꼴이었다). */
        var card = document.getElementById('ai-demo-cap');
        if (card) card.classList.add('is-opening');
        setCap(OPENING);
        render(true);
        var f = document.getElementById('ai-demo-iframe');
        if (!f || !f.src) return;
        /* 데모 쪽에 둔 신호 하나로 끝낸다 — 첫 화면으로 되감고 멈춘 채로 둔다.
           ⚠️ replay + pause 로는 안 됐다. replay 가 paused 를 풀고 한 바퀴를
              시작하므로, 곧바로 pause 를 보내도 그 사이에 장면이 흘러간다.
              260ms 를 띄워 봐도 마찬가지였다 — 그래서 받는 쪽에 신호를 더했다. */
        barReset();
        try { f.contentWindow.postMessage({ type: 'refinery-hero-rewind' }, '*'); } catch (e) {}
      };

      window.__aiHeroStartDemo = function () {
        if (demoStarted) return;
        demoStarted = true;
        var f = document.getElementById('ai-demo-iframe');
        if (!f || !f.src) return;
        /* ⚠️ 한 바퀴를 '시작' 시켜야 한다. 세워 두는 동안 데모는 한 바퀴를
           시작조차 하지 않은 상태라, resume 만 보내면 아무 일도 안 일어난다.
           replay 를 보내면 데모가 한 바퀴를 열며 cycle 신호를 보내고, 그때
           beginHold 가 불려 여는 글이 HOLD_MS 동안 머문 뒤 이어진다. */
        holding = false;
        if (holdTimer) { clearTimeout(holdTimer); holdTimer = null; }
        try { f.contentWindow.postMessage({ type: 'refinery-hero-replay' }, '*'); } catch (e) {}
      };

      window.addEventListener('load', function () { initFocus(); resize(); load(); });
      window.addEventListener('resize', resize);
      document.addEventListener('DOMContentLoaded', resize);
    })();
  </script>
  )}
  <Footer />
</BaseLayout>

<style>
  /* 블록 폭을 컨테이너 하나로 맞춘다. 전에는 Q&A만 760px이라 구분선이 화면 중간에서
     끊기고, 아래 카드 그리드(1072px)와 오른쪽 끝이 어긋나 페이지가 두 축으로 보였다.
     글줄이 길어지는 것은 문단에만 읽기 폭(72ch)을 걸어 막는다 — 제목과 구분선은
     전체 폭을 쓰고 본문만 짧게 끊긴다. */
  /* 제목 왼쪽 · 문답 오른쪽으로 나눈다 — 예지보전 자주 묻는 질문(.uc-faq-head)과 같은 값.
     오른쪽 칸이 답변 줄 길이를 잡아 주므로 문단에 폭 제한을 따로 걸지 않는다. */
  .qa-head { display: grid; grid-template-columns: 1fr 2fr; gap: 64px; align-items: start; }
  .qa-head .ind-head { max-width: none; margin-bottom: 0; }
  @media (max-width: 900px) { .qa-head { grid-template-columns: 1fr; gap: 24px; } }

  /* 가로선은 항목 사이에만 긋는다 — 목록 위·아래 끝에는 두지 않는다(예지보전과 같다). */
  .qa-list { max-width: none; }
  .qa-item { border-bottom: 1px solid #E3E7EC; }
  .qa-item:last-child { border-bottom: none; }

  /* 기본 삼각형 표식을 지우고 제목과 캐럿을 양 끝으로 벌린다. */
  .qa-item summary {
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    padding: 20px 0; cursor: pointer; list-style: none;
  }
  .qa-item summary::-webkit-details-marker { display: none; }
  /* 질문·답변·캐럿 값은 예지보전 '자주 묻는 질문'(.uc-faq-*)과 같다.
     질문은 h3다 — 섹션 제목(h2) 아래 항목이라 한 단 내려온다. */
  .qa-item h3 {
    font-size: 20px; font-weight: 600; letter-spacing: normal;
    line-height: 1.65; color: #16202C; margin: 0;
  }
  .qa-caret {
    flex: 0 0 auto; font-size: 14px; color: #7E8A98;
    transition: transform .2s ease;
  }
  .qa-item[open] .qa-caret { transform: rotate(180deg); }
  /* 답변 칸이 747px일 때(창 1280px 이상) 맞춘 단락이라, 칸이 좁아지면 푼다.
     개행 앞에 공백을 둬 br이 사라져도 앞뒤 어절이 붙지 않는다.
     어절 중간에서 끊기지 않는 것은 .ind-page의 word-break: keep-all이 맡는다. */
  @media (max-width: 1279px) { .qa-item p br { display: none; } }
  .qa-item p {
    font-size: 15px; line-height: 1.5; color: #7E8A98;
    margin: 0; padding: 0 0 24px;
  }
  /* 키보드로 짚었을 때 어디에 있는지 보이게 한다. */
  .qa-item summary:focus-visible { outline: 2px solid #76A6D7; outline-offset: 4px; border-radius: 4px; }
  /* 히어로를 자료실(.res-page .ind-hero)과 같은 값으로 맞춘다.
     면과 아래 구분선을 빼 다음 섹션과 한 흐름으로 잇고, 아래 여백은 0으로 둔다 —
     제목과 본문 사이는 섹션 위 여백이 잡는다. */
  .ind-hero {
    padding: 180px 0 0;
    background: none;
    border-bottom: none;
    text-align: center;
  }
  .ind-hero h1 {
    font-size: clamp(30px, 4.2vw, 48px);
    font-weight: 600;
    letter-spacing: -0.8px;
    line-height: 1.3;
  }
  @media (max-width: 900px) { .ind-hero { padding: 120px 0 0; } }

  /* ───────── 산업 AI 히어로 — 글자값을 제품소개(.ind-hero-bg)와 맞춘다
     제품소개 대제목은 clamp(30px, 4.2vw, 54px) · 자간 -0.03em 이고, 위 여백은
     어느 폭에서나 180px 이다. 여기는 48px · -0.8px · 좁은 폭 120px 이었다.
     ⚠️ 가운데 맞춤은 그대로 둔다. 제품소개는 왼쪽 맞춤이지만 이 페이지는
        대제목 · 버튼 모두 가운데에 세우기로 했다(2026-11-19).
     ⚠️ 자간은 px 가 아니라 em 이다. 크기를 따라 조여져야 한다 — px 로 박으면
        좁은 폭에서 글자가 작아져도 조임이 그대로라 과하게 붙는다.
     ⚠️ 에너지관리(.pillar-energy-management)는 그대로 둔다. 같은 컴포넌트를
        쓰므로 갈래 클래스로 가려 건다. */
  .pillar-industrial-ai .ind-hero h1 {
    font-size: clamp(30px, 4.2vw, 54px);
    letter-spacing: -0.03em;
  }
  /* 대제목이 시작하는 자리를 제품소개와 맞춘다. 저쪽은 대제목 위에 태그라인이
     한 줄 있어, 대제목 윗변이 180px 이 아니라 '180 + 태그라인 상자 + 그 아래
     여백' 에서 시작한다(1440px 에서 243px · 390px 에서 209px).
     여기는 태그라인이 없으므로 그 두 값을 위 여백에 더해 같은 자리에 세운다.
     ⚠️ 태그라인은 clamp(15px, 1.4vw, 20px) 에 행간 1 이라 상자 높이가 곧 글자
        크기다. 그래서 같은 clamp 를 그대로 더하면 폭을 따라 함께 움직인다.
     ⚠️ 아래 여백은 1100px 을 경계로 43px / 14px 로 갈린다 — 저쪽이 그 폭에서
        한 줄 배치를 풀고 세로로 쌓기 때문이다. 같은 경계를 쓴다.
     ⚠️ padding 이 아니라 padding-top 만 준다. 900px 이하의 padding 줄임
        (120px)도 이 선택자가 자릿수로 이겨 함께 덮인다. */
  .pillar-industrial-ai .ind-hero {
    padding-top: calc(180px + clamp(15px, 1.4vw, 20px) + 14px);
  }
  @media (min-width: 1101px) {
    .pillar-industrial-ai .ind-hero {
      padding-top: calc(180px + clamp(15px, 1.4vw, 20px) + 43px);
    }
  }

  /* 섹션 사이 구분선을 걷는다. 면색(ind-soft)과 여백만으로 섹션이 갈린다.
     ⚠️ 문답 줄 사이 선(.qa-item)과 카드 테는 그대로 둔다 — 섹션 구분선이
        아니라 목록과 카드의 제 모양이다. */
  .pillar-industrial-ai .ind-section { border-bottom: 0; }

  /* ───────── 히어로 무대 — 바깥 테를 걷고 둥글기를 메인과 맞춘다
     점 격자 면(#F6F8FA)과 흰 페이지가 밝기로 이미 갈려 테가 할 일이 없다.
     둥글기는 메인이 쓰는 --radius(12px) 하나로 둔다 — 20px(좁은 폭 16px)은
     이 페이지만 쓰던 값이라 메인의 카드 · 상자와 어긋났다.
     ⚠️ 안쪽 데모 칸(.ai-hero-figure)의 테는 그대로 둔다. 그것은 무대 위에 놓인
        화면의 테두리라 섞어 걷으면 데모가 면에 녹는다. */
  /* ───────── 카드가 아래로 자라며 화면을 꽉 채우고, 그동안 화면에 붙는다
     메인 운영체제 섹션(.teams-pin + .teams-stage-sticky)과 같은 구조다.
     대제목 · 버튼은 이 밖에 있어 평범하게 흐르고 위로 지나간다 — 카드만 제
     화면을 갖는다.
       .ai-hero-pin     스크롤 거리를 만드는 키(한 화면 + 자라는 거리)
       .ai-hero-sticky  화면 위에 붙는 무대(창 높이)
       .ai-hero-stage   그 안에서 아래로 자라는 카드
     ⚠️ 카드는 위를 붙들고 아래로만 자란다(align-items: flex-start). 가운데
        정렬로 두면 자라는 만큼 위로도 밀려 올라가 글과 겹친다.
     ⚠️ 높이는 min-height 로 올린다. --grow 가 0 이면 0 이라 제 높이(비율)가
        그대로 쓰이고, 1 이면 창 높이가 된다 — 두 값 사이를 매끄럽게 지난다.
     ⚠️ overflow: hidden 이 무대에 있어야 한다. 카드가 창보다 커지는 순간을
        잘라 주지 않으면 스크롤이 한 번 더 생긴다.
     ⚠️ 901px 아래에서는 걸지 않는다 — 폰에서는 종전대로 흐른다.
     ⚠️ 에너지관리에서는 겹친 <div> 둘이 아무 규칙도 받지 않아 보이는 것이
        달라지지 않는다. */
  /* 카드가 다 자라면 고정 내비의 흰 면을 걷는다. 내비가 z-index 100 짜리
     불투명 흰 띠라, 그대로 두면 카드 맨 위 70px 이 가려져 '헤더 자리가 남은'
     모습이 된다. 글자는 어두운 색이고 카드는 밝은 면이라 그대로 읽힌다.
     ⚠️ :global 이 필요하다. 내비는 다른 컴포넌트라 이 파일의 스코프가 닿지
        않는다.
     ⚠️ 클래스는 아래 스크립트가 <html> 에 건다 — 다 자란 구간에서만이다. */
  :global(html.ai-hero-full) :global(.mm-nav) {
    background: transparent;
  }

  @media (min-width: 901px) {
    .pillar-industrial-ai .ai-hero-pin {
      /* 한 화면 + 자라는 거리 360 + 다 자란 채로 머무는 거리 360.
         ⚠️ 머무는 거리가 없으면 다 자라는 순간 곧바로 고정이 풀려, 꽉 찬 모습이
            한 프레임만 스치고 지나간다. */
      height: calc(100vh + 720px);
    }
    /* ⚠️ 카드 위 여백은 카드가 아니라 칸이 갖는다. 카드에 두고 --grow 로
       닫으면, 닫히는 만큼 윗변이 스크롤보다 빨리 올라가 '위로도 자라는' 것으로
       보인다(실측 — 스크롤 480px 에 윗변은 543px 올라갔다). 칸이 가지면 윗변이
       스크롤과 꼭 같이 올라가고, 화면 맨 위에 닿는 자리에서 고정된다. */
    .pillar-industrial-ai .ai-hero-pin { margin-top: 64px; }
    .pillar-industrial-ai .ai-hero-pin > .ai-hero-sticky > .ai-hero-stage {
      margin-top: 0;
    }
    .pillar-industrial-ai .ai-hero-sticky {
      position: sticky; top: 0;
      height: 100vh;
      overflow: hidden;
      display: flex; align-items: flex-start;
    }
    /* 다 자랐을 때 안쪽을 메인 운영체제 섹션(.teams-split)과 같은 치수로 둔다.
       저쪽은 1440px 에서 글 칸 341px · 사이 32px · 상자가 나머지(1019px)를
       쓰며 화면 오른쪽 끝에 닿고, 글은 왼쪽 48px 선에서 시작한다(실측).
       ⚠️ 안여백은 네 면이 다르게 간다 — 왼쪽은 48px 로 남아 글이 컨테이너 선에
          서고, 나머지 셋은 0 이 되어 데모가 화면 변에 닿는다. */
    .pillar-industrial-ai .ai-hero-stage {
      width: 100%;
      /* 데모가 1045px 에서 멈추므로 카드 높이는 여기서 잡는다. 다 자라면
         창 높이다. */
      min-height: calc(100vh * var(--grow, 0));
      /* 저쪽은 상자 폭이 1045px 에서 멈추고 남는 폭을 글 칸이 가져간다(실측 —
         1920 · 1820 · 1600px 에서 상자가 모두 1045px). 같은 셈을 쓴다:
         글 칸 = 안쪽 폭 - 1045 - 사이 32. 1820px 에서 585px 로 저쪽과 같다. */
      /* 데모 폭을 먼저 잡고 글이 나머지를 쓴다. 쉬는 모습은 다 자란 모습을
         쉴 때는 글이 없으므로 데모가 위 · 좌 · 우 여백(56px)만 남기고 칸을 다
         쓴다(--demo-rest). 자라면서 1045px 로 간다 — 그 폭에서 안쪽 앱 화면이
         저쪽과 같은 배율(0.725배)이 된다. 예전에는 쉬는 폭도 축소비(--demo-k)로
         냈는데, 글이 사라진 뒤로는 그 비율을 지킬 이유가 없다. 글 칸도
         같은 비율로 따라 줄어든다.
         ⚠️ 글 칸에 바닥 300px 을 둔다. 좁은 폭에서 데모만 남고 글이 뭉개지는
            것을 막는다(저쪽도 그 언저리에서 받친다). */
      /* ⚠️ 칸은 둘로 둔다. 가운데 맞춤을 셋째 빈 칸으로 내면 격자 사이 간격이
         하나 더 생겨, 다 자란 데모가 오른쪽 변에서 15px 밀린다(한 번 그렇게 났다).
         가운데 맞춤은 아래 오른쪽 안여백(--rest-gap)이 맡는다.
         ⚠️ 왼칸의 바닥(300px)도 --grow 에 묶는다. 쉴 때까지 받치면 데모가
            가운데가 아니라 오른쪽으로 밀린다(1440px 에서 왼칸이 153px 뿐이다). */
      grid-template-columns:
        minmax(calc(300px * var(--grow, 0)), 1fr)
        calc(var(--demo-rest, 925px) * (1 - var(--grow, 0)) + 1045px * var(--grow, 0));
      /* ⚠️ 칸 사이 간격도 --grow 에 묶는다. 쉴 때는 왼칸이 비어 있어 간격만
         남는데, 그 32px 이 데모를 오른쪽으로 밀어 좌우 여백이 88 / 24 로
         어긋났다(한 번 그렇게 났다). */
      column-gap: calc(32px * var(--grow, 0));
      /* 왼쪽은 내용 너비 선에 맞춘다 — 창이 1600px 보다 넓으면 그 바깥 여백
         (--out)만큼 더 들어와, 글이 다른 섹션과 같은 선에서 시작한다.
         나머지 세 면은 0 으로 닫혀 데모가 화면 변에 닿는다. */
      /* ⚠️ 오른쪽은 늘 0 이다. 쉬는 모습에서도 데모가 카드 오른쪽 변에 닿아야
         다 자란 모습과 같은 배치가 된다(56px 을 남기면 쉴 때만 안쪽으로
         들어와 보인다). */
      /* ⚠️ 위아래 안여백은 56px 그대로 둔다. 자라는 동안 함께 줄이면 카드
         높이가 701 -> 686 으로 한 번 '줄었다가' 다시 커진다 — 안여백이 데모보다
         빨리 닫히기 때문이다. 고정해 두면 높이가 내내 늘기만 한다.
         데모는 세로 가운데에 서므로 다 자란 카드(900)에서는 이 여백이 보이지도
         않는다. */
      /* 쉴 때는 네 면이 모두 --rest-gap 이다 — 스크롤 고리가 재서 넘기는 값으로,
         데모를 카드 한가운데에 세우는 폭(= (카드폭 - 데모폭) / 2)이자 위·좌·우가
         같아지는 값이다. 자라면 위아래는 56px, 왼쪽은 내용 너비 선(48px + 바깥
         여백), 오른쪽은 0 이 되어 데모가 화면 변에 닿는다.
         ⚠️ 다 자란 값은 건드리지 않는다. 위아래 56px 은 데모가 세로 가운데에
            서는 자리를 받치고, 왼쪽 48px + --out 은 글을 다른 섹션과 같은 선에
            세운다. */
      padding:
        calc(var(--rest-gap, 56px) * (1 - var(--grow, 0)) + 56px * var(--grow, 0))
        calc(var(--rest-gap, 0px) * (1 - var(--grow, 0)))
        calc(var(--rest-gap, 56px) * (1 - var(--grow, 0)) + 56px * var(--grow, 0))
        calc(var(--rest-gap, 56px) * (1 - var(--grow, 0)) + (48px + var(--out, 0px)) * var(--grow, 0));
    }
    /* 카드 높이는 데모가 끌고 간다. 데모는 제 비율(1320:840)을 지킨 채 폭이
       자라고, 다 자라면 높이가 창 높이와 같아진다 — 그 폭(창높이 x 1320/840)은
       칸보다 넓어 오른쪽이 잘린다. 저쪽에서 화면 캡처가 상자를 가득 채우고
       변에서 잘리는 그 모습이다.
       ⚠️ min-height 로 카드를 늘이지 않는다. 그러면 데모는 제자리에 있고 점
          격자만 길어져 빈 면이 생긴다.
       ⚠️ 비율(aspect-ratio)을 풀지 않는다. 풀면 쉬는 상태에서 높이를 끌고 갈
          것이 없어 카드가 234px 로 주저앉는다(한 번 그렇게 났다). */
    .pillar-industrial-ai .ai-hero-figure {
      /* 폭은 칸이 쥔다(위 grid-template-columns). 다 자라면 1045px 이라 안쪽
         앱 화면이 저쪽과 같은 배율(0.725배)로 그려진다. */
      width: 100%;
      max-width: none;
      /* 글과 함께 세로 가운데에 선다. 저쪽 상자는 아랫변이 화면에 닿지만
         여기 카드는 창 높이를 통째로 쓰므로, 둘을 가운데에 모은다. */
      align-self: center;
    }
    /* 왼쪽 글은 세로 가운데에 선다. 카드가 길어져도 위로 끌려가지 않는다. */
  
  /* ───────── 구간 막대 — 장면 수만큼 칸을 나눠 진행을 보인다
     지난 칸은 차 있고, 지금 칸은 시간을 따라 차오르며, 앞으로 올 칸은 비어
     있다. 차오르면 재생 중이고 멈춰 있으면 정지 중이다.
     ⚠️ 누를 수 있는 자리를 16px 로 넉넉히 잡고 선은 그 안에 3px 로 둔다.
        3px 짜리를 그대로 단추로 두면 눌리지 않는다. */
  /* ⚠️ 칸은 스크립트가 만든다 — Astro 스코프 속성이 붙지 않아 :global 로 써야
     규칙이 닿는다. 그냥 쓰면 단추가 4x4 로 주저앉는다(한 번 그렇게 났다). */
  /* ⚠️ 흐름에서 뺀다(absolute). 흐름에 두면 막대 높이가 글 묶음에 더해져
     칩 · 제목이 세로 가운데에서 그만큼 위로 밀린다 — 글은 글대로 가운데에
     서고 막대만 데모 아랫변으로 내려간다. */
  .pillar-industrial-ai .ai-demo-cap { position: relative; }
  /* 글 칸(341px)을 다 쓰지 않고 한 단 좁게 둔다 — 칸마다 이름이 붙어 꽉 차면
     글줄처럼 길어 보인다. 왼쪽 선은 글과 맞춘다. */
  .ai-demo-bar {
    /* ⚠️ 폭은 칸 수로 딱 나누어떨어져야 한다 — 280 / 7 = 40. 안 떨어지면 누르는
       칸이 39.42 와 39.44 로 갈린다. */
    position: absolute; left: 0; right: 0; max-width: 280px;
    margin-top: 22px;
  }
  /* 한 줄짜리 진행 막대. 위에 지금 장면 이름과 번호, 아래에 전체가 차오르는 줄.
     ⚠️ 칸은 스크립트가 만든다 — Astro 스코프 속성이 붙지 않아 :global 로 써야
        규칙이 닿는다. 그냥 쓰면 단추가 주저앉는다. */
  .ai-demo-bar :global(.ai-demo-c-head) {
    display: flex; align-items: baseline; margin-bottom: 9px;
  }
  /* 장면 번호만 왼쪽에 둔다. 장면 이름은 바로 위 제목이 이미 말하고 있어 뺐다. */
  .ai-demo-bar :global(.ai-demo-c-no) {
    font-size: 11px; color: #8C98A6; font-variant-numeric: tabular-nums;
  }
  /* 보이는 줄은 하나다 — 끊김 없이 전체가 차오른다. */
  .ai-demo-bar :global(.ai-demo-c-bar) { position: relative; display: block; }
  .ai-demo-bar :global(.ai-demo-c-track) {
    display: block; height: 3px; border-radius: 999px; background: #DDE3EA; overflow: hidden;
  }
  .ai-demo-bar :global(.ai-demo-c-fill) {
    display: block; height: 100%; width: 0; border-radius: 999px; background: #76A6D7;
  }
  /* 누르는 자리만 일곱으로 나눈다. 줄 위에 투명하게 덮고, 위아래로 넓혀
     3px 짜리 줄도 손이 닿게 한다. */
  .ai-demo-bar :global(.ai-demo-c-hits) {
    position: absolute; left: 0; right: 0; top: -9px; bottom: -9px; display: flex;
  }
  .ai-demo-bar :global(.ai-demo-chit) {
    flex: 1 1 0; min-width: 0; padding: 0; border: 0; background: none; cursor: pointer;
  }
  .ai-demo-bar :global(.ai-demo-c-bar:hover .ai-demo-c-track) { background: #C8CED5; }
  .ai-demo-bar :global(.ai-demo-chit:focus-visible) { outline: 2px solid #76A6D7; outline-offset: 2px; border-radius: 4px; }
  /* 여는 글에서는 아직 아무 칸도 차 있지 않다 — 막대만 비어 보인다. */

  .pillar-industrial-ai .ai-demo-cap { align-self: center; }
  /* 글과 막대는 내내 떠 있고 내용만 장면마다 바뀐다. 기본값은 장면이 바뀔
     때마다 사라졌다 뜨는데(opacity 0 <-> 1), 두 번 세 번 반복되니 어색했다.
     ⚠️ 선택자를 한 단 길게 쓴다 — .ai-demo-cap.is-on 과 자릿수가 같으면
        순서에 기대게 된다.
     ⚠️ 막대도 이 안에 있어 같이 사라지고 있었다. */
  .pillar-industrial-ai .ai-hero-stage .ai-demo-cap {
    /* 글은 화면이 꽉 찼을 때만 든다. --grow 에 비례시키면 자라는 내내 반쯤
       비친 글이 따라다닌다.
       ⚠️ 안 보이는 동안에는 막대가 눌리지 않아야 한다 — opacity 로는 못 막는다. */
    opacity: 0;
    pointer-events: none;
    transition: opacity .22s ease;
  }
  .pillar-industrial-ai .ind-container.ai-hero-grown .ai-demo-cap {
    opacity: 1;
    pointer-events: auto;
  }
  /* ⚠️ 다 자라기 전에는 높이를 차지하지 않게 한다. 쉬는 모습에서 글 칸의 폭이
     0 에 가까워 제목이 글자 단위로 감기는데, 그 높이가 카드를 밀어 올린다
     (1440px 에서 데모 기준 937 이어야 할 것이 국문 997 · 영문 1439 였다).
     보이지도 않는 글이 카드 크기를 정하고 있었다. */
  .pillar-industrial-ai .ind-container:not(.ai-hero-grown) .ai-demo-cap {
    height: 0; min-height: 0; overflow: hidden;
  }
  /* 등장 — 아이콘이 먼저, 제목이 한 박자 뒤에 떠오른다.
     ⚠️ 여는 글(.is-opening)에만 건다. 장면 글까지 걸면 일곱 번 들썩여,
        앞서 일부러 없앤 깜빡임이 되살아난다. */
  .pillar-industrial-ai .ai-demo-cap-icon,
  .pillar-industrial-ai .ai-demo-cap.is-opening .ai-demo-cap-title {
    opacity: 0; transform: translateY(12px);
    transition: opacity .44s ease, transform .44s cubic-bezier(.22, 1, .36, 1);
  }
  .pillar-industrial-ai .ai-demo-cap.is-opening .ai-demo-cap-title { transition-delay: .09s; }
  .pillar-industrial-ai .ind-container.ai-hero-grown .ai-demo-cap-icon,
  .pillar-industrial-ai .ind-container.ai-hero-grown .ai-demo-cap.is-opening .ai-demo-cap-title {
    opacity: 1; transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .pillar-industrial-ai .ai-demo-cap-icon,
    .pillar-industrial-ai .ai-demo-cap.is-opening .ai-demo-cap-title {
      opacity: 1; transform: none; transition: none;
    }
  }
  /* 여는 글에는 구간 막대를 두지 않는다 — 아직 아무 장면도 시작되지 않아 빈 칸
     일곱 개만 서 있다. 첫 장면이 뜨면서 함께 든다.
     ⚠️ display:none 으로 지우지 않는다. 막대는 alignBar 가 자리를 재서 데모
        아랫변에 맞추는데, 지워 두면 잴 것이 없어 자리가 어긋난다. */
  .pillar-industrial-ai .ai-demo-cap.is-opening .ai-demo-bar {
    opacity: 0;
    pointer-events: none;
  }
  }

  /* ───────── 스크롤하면 히어로 카드가 화면을 꽉 채운다
     좌우 네 변이 모두 화면 끝에 닿고 모서리가 펴진다. 솔루션 · 제품소개가
     사진으로 하는 것과 같은 방식이다.
     ⚠️ 저쪽은 사진이 .ind-container 밖에 있어 제가 넓어진다. 이 카드는 칸
        안에 있어 칸 자체를 넓힌다 — 대제목과 버튼은 가운데 정렬이라 칸이
        넓어져도 제자리에 선다.
     ⚠️ 100vw 가 아니라 100% 다. 100vw 는 스크롤 막대 폭까지 세어 가로 스크롤을
        만든다. 칸의 담는 상자가 섹션(화면 폭)이라 여기서는 100% 가 보이는
        폭이다.
     ⚠️ 좁은 폭의 칸 여백은 24px 이라 미디어쿼리로 따로 준다. 48px 하나로
        적으면 그 구간에서 여백이 되레 넓어진다. */
  .pillar-industrial-ai .ind-hero .ind-container {
    --grow: 0;
    /* 창이 1600px 보다 넓을 때 칸 바깥에 남는 한쪽 여백. 다 자란 카드가 글을
       내용 너비 선에 세우는 데 쓴다. */
    --out: max(0px, (100% - 1600px) / 2);
    max-width: calc(1600px + (100% - 1600px) * var(--grow));
    padding-left: calc(48px * (1 - var(--grow)));
    padding-right: calc(48px * (1 - var(--grow)));
  }
  @media (max-width: 900px) {
    .pillar-industrial-ai .ind-hero .ind-container {
      padding-left: calc(24px * (1 - var(--grow)));
      padding-right: calc(24px * (1 - var(--grow)));
    }
  }

  .pillar-industrial-ai .ai-hero-stage {
    border: 0;
    /* 점 격자를 걷는다 — 면 하나로 둔다. */
    background-image: none;
    /* 다 자라면 네 모서리가 모두 펴진다 — 저쪽 사진과 같은 식이다. */
    border-radius: calc(var(--radius) * (1 - var(--grow, 0)));
    /* ⚠️ overflow: hidden 이 있어야 한다. 데모가 카드 밖으로 나가면 가로
       스크롤이 생긴다 — 카드가 변에서 잘라 준다. */
    overflow: hidden;
    /* 안여백 40 -> 56px. 좁은 폭은 20 -> 24px 다.
       ⚠️ 901px 위에서는 고정 블록이 네 면을 따로 보간하며 쥔다(그쪽이 뒤에
          오면 덮이므로 여기서는 적지 않는다). 아래 미디어쿼리만 남긴다. */
  }
  @media (max-width: 900px) {
    .pillar-industrial-ai .ai-hero-stage { padding: 24px; }
  }

  /* ───────── 히어로 카드 글 — 메인 운영체제 섹션(#teams)과 같은 값으로 둔다
     저쪽은 .teams-preview-tagline(칩) · .teams-preview-title-wrap h3 한 벌이다.
       칩    13px / 600 / 자간 -0.143px / 하늘색 면 -> 12px / 400 / 0.6px / 면 없음
       제목  32px / 1.4 / -0.02em        -> 30px / 1.3 / -0.4px
     ⚠️ 토큰 이름(--ls-snug · --lh-flat 등)을 쓰지 않고 값을 적는다. 이 페이지는
        industry.css 만 들여와 global.css 의 토큰이 닿지 않는다.
     ⚠️ 칩의 좌우 여백 13.4 / 14px 은 저쪽에서 잉크로 맞춘 값이다. 자간(0.6px)이
        마지막 글자 뒤에 한 번 더 붙어 오른쪽만 0.6px 덜 준다 — 그대로 옮긴다.
     ⚠️ 첫 화면 글(.is-opening)은 장면 글보다 한 단 크게 두던 비율(36/32 = 1.125)
        을 지켜 30 -> 34px 로 내린다. */
  .pillar-industrial-ai .ai-demo-cap-eyebrow {
    font-size: 12px; font-weight: 400; line-height: 1; letter-spacing: 0.6px;
    color: #5A6776; background: transparent; border: 1px solid #C8CED5;
    padding: 7px 13.4px 7px 14px;
    margin-bottom: 16px;
  }
  .pillar-industrial-ai .ai-demo-cap-title {
    font-size: 30px; line-height: 1.3; letter-spacing: -0.4px;
  }
  .pillar-industrial-ai .ai-demo-cap.is-opening .ai-demo-cap-title { font-size: 34px; }
  @media (max-width: 900px) {
    /* 저쪽도 900px 아래에서 제목을 19px 로 내린다. 같은 값을 쓴다. */
    .pillar-industrial-ai .ai-demo-cap-title { font-size: 19px; }
    .pillar-industrial-ai .ai-demo-cap.is-opening .ai-demo-cap-title { font-size: 21px; }
  }

  /* 데모 칸을 한 단 줄인다. 1fr 로 두면 1440px 에서 878px 까지 자라 카드 안에서
     데모가 주인공처럼 커졌다 — 왼쪽 글과 무게를 나눈다.
     ⚠️ 두 칸 배치(1025px 위)에서만 건다. 그 아래는 글이 데모 위로 올라가
        데모가 칸을 통째로 쓰는 구성이라, 거기서 줄이면 안이 안 읽힌다.
     ⚠️ 칸 안에서 가운데에 세운다. 오른쪽에 붙이면 줄어든 만큼 왼쪽 글과의
        사이만 벌어져 카드가 비어 보인다. */
  @media (min-width: 1025px) {
    /* ⚠️ width: 100% 가 있어야 한다. justify-self 를 주는 순간 칸을 꽉 채우는
       stretch 가 풀리는데, 이 칸은 안이 absolute 라 내용 폭이 0 이다 — 폭을
       지정하지 않으면 3x2px 으로 찌그러진다. */
    /* ⚠️ 여기서 width 를 주지 않는다. 이 규칙이 고정 블록보다 뒤에 있어,
       폭을 적으면 다 자란 데모의 폭(창높이 x 1320/840)을 덮어 버린다 —
       1440x900 에서 1414px 이 될 것이 칸 폭 955px 에 묶였다. */
    /* ⚠️ 왼쪽을 붙든다. 가운데로 두면 다 자란 데모(1414px)가 칸(955px)보다
       넓어 좌우로 230px 씩 넘쳐, 왼쪽 글 위로 올라탄다. */
    .pillar-industrial-ai .ai-hero-figure {
      justify-self: start;
      /* 자라는 내내 네 귀가 둥글고 테도 네 면이 다 있다 — 쉬는 모습 그대로다.
         화면을 다 덮은 순간에만 오른쪽 두 귀가 펴지고 오른쪽 테가 사라져,
         저쪽 상자(.teams-preview)처럼 화면 변에서 잘린 꼴이 된다.
         ⚠️ --grow 에 비례시키지 않는다. 그러면 아직 화면이 덜 찼는데도 오른쪽만
            각져서, 허공에서 잘린 것처럼 보인다.
         ⚠️ 테는 두께가 아니라 색의 투명도로 지운다. 크롬이 테 두께를 정수
            픽셀로 내려, 두께를 줄이면 1px 에서 0 으로 한 번에 튄다. */
      border-radius: var(--radius, 12px);
      border-right: 1px solid #E3E7EC;
      /* 그림자는 두지 않는다 — 쉬는 모습에서도 없다. 데모 카드는 테 한 겹으로
         서고, 떠 있는 느낌은 바깥 히어로 카드가 맡는다. */
      box-shadow: none;
      transition: border-radius .22s ease, border-right-color .22s ease;
    }
    .pillar-industrial-ai .ind-container.ai-hero-is-full .ai-hero-figure {
      border-radius: var(--radius, 12px) 0 0 var(--radius, 12px);
      border-right-color: transparent;
    }
  }

  /* ───────── 자주 묻는 질문 — 과제별(.uc-redesigned .uc-faq-*)과 같은 모습
     저쪽은 '제목이 위 · 질문 판이 아래' 한 칸이고, 목록이 옅은 면 판 위에 앉는다.
     여기는 '제목 왼쪽 · 목록 오른쪽' 두 칸에 판이 없었다.
     ⚠️ 마크업은 <details>/<summary> 그대로 둔다. 저쪽은 div + JS 로 여닫는데,
        이 페이지는 답변이 검색 · 답변엔진에 읽히는 것이 목적이라 JS 없이도
        열리고 키보드로 조작되는 <details> 쪽이 맞다. 보이는 값만 옮긴다.
     ⚠️ 질문 · 답변 크기는 저쪽 토큰(--uc-fs-17 · --uc-fs-15)이 내는 값을 그대로
        적는다. 그 토큰은 .uc-page 에만 선언되어 있어 이름으로는 못 가져온다. */
  /* ───────── 활용 카드 — 과제별 '과제 더 살펴보기'(.uc-case)와 같은 모습
     저쪽 규칙은 UseCasePage 의 스코프 스타일이라 클래스를 붙여도 여기까지 오지
     않는다. 같은 값을 옮겨 적는다.
     ⚠️ 크기는 저쪽 토큰(--uc-fs-24 · --uc-fs-20 · --uc-fs-15)이 내는 값을 그대로
        적는다. 그 토큰은 .uc-page 에만 선언되어 있어 이름으로는 못 가져온다.
     ⚠️ 카드가 셋이고 저쪽 격자도 3열이라 한 줄에 딱 맞는다. */
  .pillar-industrial-ai .uc-cases {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .pillar-industrial-ai .uc-case {
    position: relative; overflow: hidden;
    display: flex; align-items: flex-end;
    min-height: 320px;
    color: #16202c;
    background: var(--bg); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 24px 32px 32px;
    transition: border-color .2s, color .2s;
  }
  /* ⚠️ width: 100% 를 준다. .uc-case 가 flex 라 자식이 글 폭만큼만 차지해,
     없으면 화살표가 오른쪽 끝까지 가지 않는다. */
  .pillar-industrial-ai .uc-case-body {
    position: relative; z-index: 3; word-break: keep-all;
    width: 100%;
    display: flex; align-items: flex-end; justify-content: space-between; gap: 16px;
  }
  .pillar-industrial-ai .uc-case-text { min-width: 0; }
  /* 평소에는 이름만 크게 선다. 마우스를 올리면 이름이 줄고 그 아래로 설명과
     화살표가 나온다.
     ⚠️ margin-bottom 을 여기 두지 않는다. 접힌 동안에도 그 여백이 남아 이름
        아래가 떠 보인다 — 설명 쪽의 위 여백으로 옮겼다. */
  .pillar-industrial-ai .uc-case-label {
    display: block; font-size: clamp(19px, 2.2vw, 24px); font-weight: 600; margin-bottom: 0;
    transition: font-size .25s ease;
  }
  .pillar-industrial-ai .uc-case:hover .uc-case-label { font-size: clamp(16px, 1.83vw, 20px); }
  /* 0fr -> 1fr. 높이를 숫자로 재지 않아 글 길이가 달라도 같은 속도로 펴진다. */
  .pillar-industrial-ai .uc-case-fold {
    display: grid; grid-template-rows: 0fr;
    transition: grid-template-rows .25s ease;
  }
  .pillar-industrial-ai .uc-case-fold > span { overflow: hidden; min-height: 0; opacity: 0; transition: opacity .15s; }
  .pillar-industrial-ai .uc-case:hover .uc-case-fold { grid-template-rows: 1fr; }
  .pillar-industrial-ai .uc-case:hover .uc-case-fold > span { opacity: 1; transition: opacity .25s .08s; }
  .pillar-industrial-ai .uc-case-desc {
    margin: 5px 0 0; font-size: clamp(14px, 1.38vw, 15px); line-height: 1.5;
    color: var(--text-muted); text-wrap: pretty;
  }
  /* ⚠️ 마우스가 없는 화면(터치)에서는 호버가 없어 설명과 화살표가 영영 안 나온다.
     그쪽에서는 처음부터 펴 둔다 — 이름만 남으면 카드가 무엇인지 알 수 없다. */
  @media (hover: none) {
    .pillar-industrial-ai .uc-case-label { font-size: clamp(16px, 1.83vw, 20px); }
    .pillar-industrial-ai .uc-case-fold { grid-template-rows: 1fr; }
    .pillar-industrial-ai .uc-case-fold > span { opacity: 1; }
    .pillar-industrial-ai .uc-case-go { opacity: 1; transform: none; }
  }
  /* 글자 없이 화살표만. 카드 전체가 링크라 이름이 제목을 맡고, 이 아이콘은
     '넘어간다' 는 신호만 준다(그래서 aria-hidden). */
  .pillar-industrial-ai .uc-case-go {
    display: inline-flex; align-items: center; justify-content: center;
    width: 28px; height: 28px;
    flex: none;
    border: 1px solid currentColor; border-radius: 50%;
    color: #C8CED5;
    opacity: 0;
    transform: translateX(-6px);
    /* ⚠️ var(--t-quick) 을 쓰지 않는다. 그 값은 global.css 의 :root 에 있고 이
       페이지에는 실리지 않아, 쓰면 선언이 통째로 무효가 된다. */
    transition: opacity .2s ease, transform .2s ease, background-color .2s ease, color .2s ease;
  }
  .pillar-industrial-ai .uc-case-go svg { display: block; }
  .pillar-industrial-ai .uc-case:hover .uc-case-go { opacity: 1; transform: none; color: #F6F8FA; }
  .pillar-industrial-ai .uc-case:hover { border-color: var(--accent); color: #4b86bf; }
  @media (max-width: 860px) {
    .pillar-industrial-ai .uc-cases { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 520px) {
    .pillar-industrial-ai .uc-cases { grid-template-columns: 1fr; }
  }
  /* 사진이 있는 카드 — 사진 -> 어두운 막 -> 아래 그라데이션 -> 글 순으로 쌓아
     사진 위에서도 글자가 읽히게 한다. 테를 없애야 사진이 카드를 끝까지 채운다
     (테가 있으면 inset: 0 이 패딩 박스 기준이라 사방 1px 흰 테가 남는다). */
  .pillar-industrial-ai .uc-case-img {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; pointer-events: none; user-select: none;
    transition: transform .3s ease;
  }
  /* ⚠️ z-index 필수. ::before 는 생성 순서상 사진보다 앞이라, 지정하지 않으면
     사진이 이 막을 덮는다(그리는 순서가 DOM 순서다). */
  .pillar-industrial-ai .uc-case--img::before {
    content: ''; position: absolute; inset: 0; z-index: 1;
    background: rgba(17,19,22,.25);
  }
  .pillar-industrial-ai .uc-case--img::after {
    content: ''; position: absolute; inset: 0; z-index: 2;
    background: linear-gradient(180deg,
      rgba(17,19,22,0) 0%,
      rgba(17,19,22,.12) 28%,
      rgba(17,19,22,.82) 52%,
      rgba(17,19,22,1) 100%);
  }
  .pillar-industrial-ai .uc-case--img { border: none; }
  .pillar-industrial-ai .uc-case--img .uc-case-label { color: #fff; }
  .pillar-industrial-ai .uc-case--img .uc-case-desc { color: rgba(255,255,255,.82); }
  .pillar-industrial-ai .uc-case--img:hover .uc-case-label { color: #fff; }
  .pillar-industrial-ai .uc-case--img:hover .uc-case-img { transform: scale(1.04); }

  /* 문답과 활용 사이 여백 — 과제별(.uc-redesigned .uc-faq-section)과 같은
     값이다. 공통값은 위아래 180px 이라 둘 사이가 360px 이었다.
     저쪽은 90 + 90 으로 좁혀 두 섹션을 한 흐름으로 읽히게 한다. */
  .pillar-industrial-ai .qa-section { padding-bottom: 90px; }
  .pillar-industrial-ai .qa-section + .ind-section { padding-top: 90px; }

  .pillar-industrial-ai .qa-head { grid-template-columns: 1fr; gap: 64px; }
  .pillar-industrial-ai .qa-list {
    background: var(--bg-soft);
    border-radius: var(--radius);
    padding: 32px 48px;
    text-align: left;
  }
  .pillar-industrial-ai .qa-item { overflow: hidden; }
  /* 저쪽 질문 줄은 좌우 4px 안여백을 갖는다(판 안에서 조금 들여 선다). */
  .pillar-industrial-ai .qa-item summary { padding: 20px 4px; gap: 12px; }
  .pillar-industrial-ai .qa-item h3 {
    font-size: clamp(15px, 1.56vw, 17px); font-weight: 500; line-height: 1.5;
  }
  .pillar-industrial-ai .qa-caret {
    font-size: 14px; color: #7E858F;
    /* 저쪽은 ph-bold 를 쓰는데 여기 아이콘은 ph(보통)다. 획을 0.3px 덧대
       같은 굵기로 보이게 한다. */
    -webkit-text-stroke: 0.3px currentColor;
  }
  .pillar-industrial-ai .qa-item p {
    /* ⚠️ 색은 #5A6776 이 아니다. 저쪽은 var(--text-muted, #5A6776) 로 적혀
       있지만 그 페이지에서 토큰이 실제로 내는 값은 #7E8A98 이다 — 예비값만
       보고 옮기면 한 단 어두워진다. */
    font-size: clamp(14px, 1.38vw, 15px); line-height: 1.5; color: #7E8A98;
    padding: 0 4px 20px;
  }
  @media (max-width: 900px) {
    .pillar-industrial-ai .qa-head { gap: 40px; }
    .pillar-industrial-ai .qa-list { padding: 24px; }
  }

  /* ───────── 히어로 버튼 — 메인 CTA(#cta .btn-primary)와 같은 크기로 둔다
     저쪽은 기본값(6/18 · 14px)에서 한 단 키운 11px 26px · 16px 이다. 여기는
     9px 22px · 15px 이라 한 단 작았다.
     ⚠️ 주 버튼의 테는 메인처럼 투명으로 둔다 — 지우지 않는다. border: 0 으로
        없애면 호버에서 면이 생길 때 버튼이 2px 작아진다.
     ⚠️ 보조 버튼('제품 소개')의 테 색과 호버 색은 그대로 둔다. 메인 CTA 는
        어두운 영상 위라 버튼이 하나뿐이고, 여기는 밝은 면 위에 둘이 서므로
        둘을 갈라 주는 것이 저 테다. 크기만 맞춘다. */
  .pillar-industrial-ai .ind-hero-actions .ind-btn-primary,
  .pillar-industrial-ai .ind-hero-actions .ind-btn-ghost {
    /* ⚠️ 행간도 같이 맞춘다. 메인 버튼은 글줄 높이가 24px(1.5)인데 여기는
       .ind 의 본문 행간 1.65 를 물려받아 26.4px 이었다 — 같은 16px · 11/26
       으로 맞춰도 버튼이 50px 으로 2px 더 높았다. */
    padding: 11px 26px; font-size: 16px; line-height: 1.5;
  }
  .pillar-industrial-ai .ind-hero-actions .ind-btn-primary { border-color: transparent; }
  /* 히어로 버튼 — 예지보전 히어로와 같은 형태다(9px 22px · 15px/400 · 반경 6px ·
     테두리 1px · 묶음 margin-top 48px · gap 16px).
     색은 그 페이지의 '밝은 배경용' 규칙을 따른다. 거기 히어로는 어두운 사진 위라
     보조 버튼이 흰 테두리인데, 이 히어로는 밝은 면이라 그대로 쓰면 보이지 않는다.
     주 버튼만 같은 accent 면(#76A6D7)을 유지해 시선이 먼저 닿는 자리를 지킨다. */
  .ind-hero-actions { margin-top: 48px; gap: 16px; justify-content: center; }
  .ind-hero-actions .ind-btn-primary,
  .ind-hero-actions .ind-btn-ghost {
    padding: 9px 22px; font-size: 15px; font-weight: 400;
    border-radius: 6px; border: 1px solid; transition: all .2s;
  }
  .ind-hero-actions .ind-btn-primary {
    background: #76A6D7; color: #fff; border-color: #76A6D7;
  }
  .ind-hero-actions .ind-btn-primary:hover {
    background: #5A8FC5; border-color: #5A8FC5; color: #fff; transform: none;
  }
  /* 색은 디자인시스템 ink 스케일. #191F27·rgba(17,17,17,.6)이던 임의값을 옮겼다 —
     테두리는 흰 배경에 합성하면 #707070이라 가장 가까운 ink-600으로 간다(거리 24.5).
     호버는 면을 채우는 방식 그대로 두고 값만 옮긴다. 옆의 주 버튼이 하늘색 면이라,
     호버까지 하늘색으로 가면 두 버튼이 같아 보인다. */
  .ind-hero-actions .ind-btn-ghost {
    background: transparent; color: #16202C; border-color: #5A6776;
  }
  .ind-hero-actions .ind-btn-ghost:hover {
    background: #16202C; border-color: #16202C; color: #fff;
  }

  /* 그래픽 이미지 자리표시 — 실제 이미지로 교체할 자리다.
     비율(16:6)만 잡아 두면 이미지가 들어와도 아래 섹션이 밀리지 않는다. */
  /* 랜딩 히어로에 쓰는 에이전트 데모를 그대로 얹는다. 무대(.stage)가 1320x840
     고정이라 칸도 같은 비율이어야 위아래에 데모 페이지 배경이 남지 않는다.
     (자리표시자는 16:6이었다 — 칸이 그만큼 세로로 길어진다.) */
  /* 데모를 받치는 판. 랜딩 #integrations의 점 격자를 그대로 쓰되,
     그쪽은 어두운 면 위 흰 점(rgba(255,255,255,.08))이라 밝은 면에 맞춰 뒤집는다.
     background-size가 격자 간격과 같아 어느 크기에서도 이어지고 끊기지 않는다. */
  .ai-hero-stage {
    margin-top: 64px;
    background-color: #F6F8FA;
    background-image: radial-gradient(rgba(22, 32, 44, .10) 1px, transparent 1px);
    background-size: 24px 24px;
    /* 페이지(흰색)와 붙는 밝은 면이라 바깥 테두리로 박스를 남긴다. */
    border: 1px solid #E3E7EC;
    border-radius: 20px;
    padding: 40px;
    /* 좌: 설명 · 우: 데모. 설명을 밖으로 빼서 데모를 가리지 않게 한다.
       열 너비는 제목 두 줄에 실제로 필요한 폭(가장 긴 줄 342px)에 맞춘다.
       남는 폭은 전부 데모로 간다 — 데모가 작으면 안이 안 읽힌다. */
    display: grid;
    grid-template-columns: 352px 1fr;
    gap: 32px;
    align-items: center;
  }
  /* 판 위에 글자만 놓는다(면 없음). */
  .ai-demo-cap {
    /* 히어로가 가운데정렬이라 물려받는다. 왼쪽으로 되돌린다. */
    text-align: left;
    opacity: 0;
    transition: opacity .45s ease;
  }
  .ai-demo-cap.is-on { opacity: 1; }
  /* 첫 화면 글은 머무는 시간이 짧아 빨리 떠야 읽힌다. */
  .ai-demo-cap.is-opening { transition-duration: .18s; }
  /* 첫 화면만 태그라인 없이 제목 하나로, 장면들보다 크게 간다. */
  .ai-demo-cap.is-opening .ai-demo-cap-eyebrow { display: none; }
  .ai-demo-cap.is-opening .ai-demo-cap-title { font-size: 36px; }
  @media (prefers-reduced-motion: reduce) { .ai-demo-cap { transition: none; } }
  /* 태그라인과 대제목 비율은 예지보전 히어로를 따른다.
     그쪽은 태그라인 18px / 대제목 45px = 0.4, 굵기 600, 자간 -0.2px(-0.011em),
     아래 여백 14px이다. 여기 대제목이 32px이므로 13px(0.4)과 여백 10px이 된다. */
  /* 헤더 '예정' 칩(.mm-badge)과 같은 타원 칩. 그쪽은 10px/500이라
     여기 크기(13px/600)에 맞춰 여백만 키웠다. 면은 한 단계 옅게 #EEF4FB. */
  .ai-demo-cap-eyebrow {
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 13px; font-weight: 600; letter-spacing: -0.011em; line-height: 1;
    color: #76A6D7; background: #EEF4FB; border: 1px solid #76A6D7;
    /* 위아래 여백은 '찍힌 픽셀'로 맞춘다. 폰트 지표로 계산하면 어긋난다 —
       계산값은 0.78px 차였는데 실제로는 2.25px였다.
       7/4에서 위 8.25 · 아래 6.0 -> 6/5에서 위 7.25 · 아래 7.0.
       위아래 합(11px)은 그대로라 칩 높이 26px가 유지된다. */
    padding: 6px 11px 5px; border-radius: 999px;
    margin-bottom: 10px;
  }
  /* 아이콘은 96px 짜리를 48px 로 놓는다 — 레티나에서 두 배로 받아 또렷하다.
     ⚠️ 블록으로 둔다. <img> 는 기본이 inline 이라 글줄 바닥선에 앉으면서 아래에
        빈 3px 이 생긴다. */
  /* 아이콘은 여는 글(.is-opening)에만 선다. 장면 글에는 숫자 칩과 제목이 이미
     있어, 거기까지 아이콘이 따라붙으면 같은 자리에 표시가 둘이 된다.
     아이콘은 맨몸이 아니라 정사각 타일 안에 든다 — 모서리는 사이트 공통값
     (--radius)을 그대로 쓰고, 면과 테와 그림자도 다른 카드와 같은 값이다. */
  /* 뒤 정사각. 색은 바탕(--bg-soft)보다 한 단 어두운 면값(--bg-card)이고,
     모서리는 안쪽보다 띄운 만큼(10px) 커져 동심을 이룬다.
     ⚠️ 그림자 번짐(0 0 0 10px)으로 그리지 않는다. 번짐은 제 그림자를 가질 수
        없어 뒤 정사각이 떠 보이지 않는다 — 실제 요소로 둔다.
     ⚠️ ::before + z-index:-1 로도 하지 않는다. 무대 배경 뒤로 숨는다. */
  .ai-demo-cap-icon {
    display: none; width: 76px; height: 76px;
    place-items: center;
    border-radius: calc(var(--radius) + 10px);
    background: var(--bg-card);
    /* 그림자는 두지 않는다. 뒤 정사각은 면 색으로 이미 바탕과 갈리고(--bg-card
       vs --bg-soft), 76px 밖에 안 돼 그림자가 번짐으로만 보인다. 떠 보이는 일은
       앞 타일(흰 면 · 테 · 그림자)이 맡는다. */
    margin: 10px 0 24px;
  }
  .ai-demo-cap.is-opening .ai-demo-cap-icon { display: grid; }
  /* 앞 타일 — 모서리는 사이트 공통값 그대로다. */
  .ai-demo-cap-icon-in {
    display: grid; place-items: center; width: 56px; height: 56px;
    border-radius: var(--radius);
    background: var(--bg);
    border: 1px solid var(--border);
    box-shadow:
      0 1px 2px rgba(16, 32, 44, .05),
      0 6px 16px rgba(16, 32, 44, .06);
  }
  .ai-demo-cap-icon img { display: block; width: 38px; height: 38px; }
  /* 막대 폭은 어느 폭에서나 같다.
     ⚠️ 이 선언을 고정 블록(min-width: 901px) 안에만 두었더니 900 이하에서
        제한이 풀려 글 칸 전체로 벌어졌다(900px 창에서 852px). 공용으로 둔다. */
  .ai-demo-bar { width: 280px; max-width: 100%; margin-top: 22px; }
  @media (max-width: 900px) {
    .ai-demo-cap-icon {
      width: 60px; height: 60px; margin: 8px 0 18px;
      border-radius: calc(var(--radius) + 8px);
    }
    .ai-demo-cap-icon-in { width: 44px; height: 44px; }
    .ai-demo-cap-icon img { width: 29px; height: 29px; }
  }
  .ai-demo-cap-title {
    /* 굵기는 600으로 간다. 이 페이지 h1(48px)과 예지보전 히어로 h1이 모두 600이라,
       더 작은 이 제목만 700이면 큰 제목보다 무겁게 읽힌다. */
    font-size: 32px; font-weight: 600; line-height: 1.4; letter-spacing: -0.02em;
    color: #16202C; margin: 0;
  }
  /* 활용 섹션 소제목은 한 줄로 둔다. industry.css의 .ind-page .ind-head p가
     상한을 400px로 잡고 있어 그보다 긴 문구가 두 줄로 접힌다
     (에너지 페이지 '에너지관리시스템이 실제 현장에서…'가 448px). */
  .ind-soft .ind-head p { max-width: 480px; }

  /* 대제목 아래 한 줄 소개. .ind-lede는 왼쪽 정렬에 60ch 상한이라
     가운데 정렬 히어로에 맞게 되돌린다. */
  .ai-hero-lede {
    margin: 20px auto 0;
    max-width: 68ch;
    text-align: center;
  }

  /* 데모가 없는 판 — 설명 열 없이 한 칸으로 두고 비율만 지킨다. */
  .ai-hero-stage.is-empty { grid-template-columns: 1fr; column-gap: 0; }
  .ai-hero-stage.is-empty .ai-hero-figure {
    border: none;
    box-shadow: none;
    background: none;
    /* 그래픽 높이를 따른다. 데모처럼 비율을 고정하지 않는다. */
    aspect-ratio: auto;
    height: auto;
  }
  /* 그래픽은 배경이 투명해 점 격자가 그대로 비친다. 판 가운데에 둔다.
     정사각(1200x1200)이라 비율을 그대로 잡아 높이를 예약한다(CLS 방지). */
  .ai-hero-graphic {
    display: block;
    width: 100%;
    /* 세로 682px 고정(판 전체 762px — 자리표시자 때와 같다).
       그림이 정사각이라 폭을 키우면 세로도 커진다. 그래서 크게 보여주는 일은
       칸을 키우는 대신 안에서 확대(viewBox)로 한다.
       가로는 820px로 좁힌다 — 판 폭(1104)을 다 쓰면 정사각 그림 좌우로
       여백이 과하게 남아 쉬는 상태에서 그림이 작아 보인다. */
    max-width: 820px;
    aspect-ratio: 820 / 682;
    margin: 0 auto;
    pointer-events: none;
    /* 준비가 끝나기 전에는 감춘다. 안 그러면 완성된 그림이 한 번 스쳤다가
       감춰지면서 회선이 먼저 보인다. 스크립트가 없으면 위 setTimeout이 켜 준다. */
    opacity: 0;
    transition: opacity .25s ease;
  }
  .ai-hero-graphic.is-ready { opacity: 1; }
  @media (prefers-reduced-motion: reduce) { .ai-hero-graphic { transition: none; } }
  /* 그래픽만 있는 판은 테두리까지 그림으로 채운다. 안쪽 여백 40px에 더해
     그림 자체가 820px로 묶여 있어, 1440에서 판 안쪽 1102px 중 좌우로 141px씩
     비었다 — 그림과 박스 선 사이가 그만큼 떠 보였다.
     판 여백을 지우고 그림이 칸을 다 쓰게 하되, 판 높이(764px)는 그대로 둔다.
     정사각 그림이라 폭을 늘리면 세로도 커지므로 비율을 판 크기로 고정한다.
     안에서 보여주는 범위는 카메라(viewBox)가 정하고, 카메라는 이 칸의
     가로세로비를 읽어 따라간다. */
  .ai-hero-stage.has-graphic { padding: 0; overflow: hidden; }
  /* 데스크톱에서는 판 높이를 그대로 지킨다(762 + 테두리 2 = 764).
     좁아지면 고정 높이가 과해지므로 그때부터 비율로 넘긴다. */
  .ai-hero-stage.has-graphic .ai-hero-figure { height: 762px; aspect-ratio: auto; }
  @media (max-width: 1024px) {
    .ai-hero-stage.has-graphic .ai-hero-figure { height: auto; aspect-ratio: 1184 / 762; }
  }
  .ai-hero-stage.has-graphic .ai-hero-graphic {
    width: 100%;
    height: 100%;
    max-width: none;
    aspect-ratio: auto;
    margin: 0;
  }
  /* 그래픽도 데모도 없을 때만 자리를 점선으로 표시한다. */
  .ai-hero-stage.is-empty .ai-hero-figure:empty {
    aspect-ratio: 1320 / 840;
    border: 1px dashed #C8CED5;
    background: #FFFFFF;
  }

  .ai-hero-figure {
    aspect-ratio: 1320 / 840;
    position: relative;
    overflow: hidden;
    /* 데모 바탕(#F7F9FC)이 판(#F6F8FA)과 거의 같아 경계가 흐리다. 선을 되살린다. */
    border: 1px solid #E3E7EC;
    border-radius: 12px;
    /* 한 겹짜리 큰 번짐은 도장 찍은 것처럼 균일해 떠 있는 느낌이 안 난다.
       접지(닿는 면) · 중간 · 주변광 세 겹으로 나눠 아래로 갈수록 옅게 퍼뜨린다. */
    box-shadow:
      0 1px 2px rgba(16, 32, 44, .03),
      0 4px 10px rgba(16, 32, 44, .03),
      0 12px 28px rgba(16, 32, 44, .04);
  }
  @media (max-width: 1024px) {
    /* 좁아지면 설명을 데모 위로 올린다. 나란히 두면 둘 다 못 읽는다.
       폭이 달라졌으니 두 줄 고정도 푼다. */
    .ai-hero-stage { grid-template-columns: 1fr; gap: 24px; }
    .ai-demo-cap-title :global(br) { display: none; }
  }
  @media (max-width: 900px) {
    .ai-hero-stage { margin-top: 48px; padding: 20px; border-radius: 16px; }
    /* 좁은 화면에서는 데모를 통째로 보여준다(따라가기가 꺼진다). */
    .ai-hero-figure { aspect-ratio: 1144 / 900; }
    .ai-demo-cap-title { font-size: 26px; }
    .ai-demo-cap.is-opening .ai-demo-cap-title { font-size: 28px; }
  }

  /* CTA — 예지보전(.uc-cta-bg)과 같은 모습. 그 규칙은 UseCasePage.astro의 스코프
     스타일이라 클래스를 붙여도 여기까지 오지 않는다. 같은 값을 옮겨 적는다.
     사진은 그 페이지가 쓰는 것을 그대로 쓴다(/use-cases/cta-bg.webp). */
  .ind-cta.ai-cta-bg {
    position: relative; overflow: hidden;
    background: #191F27; padding: 95px 0; text-align: left;
  }
  /* 사진이 납작해 폭이 줄면 object-fit이 세로까지 줄인다.
     min-width로 배율을 묶고 모자란 가로는 좌우 균등하게 잘리게 한다. */
  .ai-cta-bg-img {
    position: absolute; top: 0; left: 50%; transform: translateX(-50%);
    width: 100%; min-width: 1440px; height: 100%;
    object-fit: cover; object-position: center 65%;
    pointer-events: none; user-select: none;
  }
  /* 제목 왼쪽 · 버튼 오른쪽으로 한 줄에 나눈다. */
  .ai-cta-bg .ind-container {
    position: relative; z-index: 1;
    display: flex; align-items: center; justify-content: space-between;
    gap: 48px; flex-wrap: wrap;
  }
  .ai-cta-bg .ind-container > * { flex: none; }
  .ind-cta.ai-cta-bg h2 {
    font-size: clamp(26px, 3.6vw, 40px); font-weight: 500;
    letter-spacing: -0.8px; line-height: 1.35; color: #fff;
    margin-bottom: 0; text-wrap: initial;
  }
  .ind-cta.ai-cta-bg .ind-btn-primary {
    margin-top: 0; padding: 9px 22px;
    font-size: 15px; font-weight: 400;
    background: #76A6D7; color: #fff;
    border: 1px solid #76A6D7; border-radius: 6px;
    transition: all .2s;
  }
  .ind-cta.ai-cta-bg .ind-btn-primary:hover {
    background: #5A8FC5; border-color: #5A8FC5; color: #fff; transform: none;
  }
  /* 좁은 폭에서는 여백을 줄인다(사이트 공통 84 → 60px 규칙과 같은 값). */
  @media (max-width: 560px) { .ind-cta.ai-cta-bg { padding: 60px 0; } }

  /* ───────── CTA 규격을 사이트 표준으로 올린다
     제품소개 · 산업별 · 과제별이 이미 한 벌이다 — 면 #151B23 · 위아래 110px ·
     버튼 11px 26px / 16px / 행간 24px(높이 48px). 필러 두 곳만 #191F27 · 95px ·
     9px 22px / 15px(높이 44px) 로 뒤처져 있었다.
     ⚠️ 면색은 배경 그래픽에 들어 있는 색과 같은 값이라야 한다. 지금은 그래픽이
        없지만, 나중에 필러용 영상이 생기면 그 영상의 배경도 #151B23 이다
        (README 가 그렇게 적고 있다) — 미리 맞춰 둔다.
     ⚠️ 좁은 폭 60px 규칙도 건다. 저쪽은 110px 을 그대로 쓰지만(메인 CTA 와 같은
        값), 그 변경은 요청받지 않았다 — 여백만 표준으로 올리고 폭별 조정은 둔다.
     ⚠️ 행간 24px 을 함께 적는다. 이 페이지는 .ind 의 본문 행간 1.65 를 물려받아,
        같은 안여백 · 글자로도 버튼이 2px 더 높았다(히어로 버튼에서 겪은 것과
        같은 자리다).
     ⚠️ 에너지관리는 그대로 둔다 — 그 페이지는 따로 진행한다. */
  .pillar-industrial-ai .ind-cta.ai-cta-bg {
    background: #151B23;
    padding: 110px 0;
  }
  .pillar-industrial-ai .ind-cta.ai-cta-bg .ind-btn-primary {
    padding: 11px 26px;
    font-size: 16px; line-height: 24px;
  }
  /* 안쪽 배치도 같게 둔다 — 문구 위 · 버튼 아래로 왼쪽에 쌓는다. 메인 CTA 와
     같은 배치이고, 사이 40px 도 그쪽 값이다. 여기는 제목 왼쪽 · 버튼 오른쪽
     한 줄(space-between)이었다.
     ⚠️ 공통 규칙이 .ai-cta-bg .ind-container 에 가로 flex 를 걸어 두었다 —
        align-items · justify-content · flex-wrap 까지 되돌려야 한다. 셋 중
        하나라도 남기면 세로로 쌓이면서도 가운데에 서거나 줄이 접힌다. */
  .pillar-industrial-ai .ai-cta-bg .ind-container {
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    flex-wrap: nowrap;
    gap: 40px;
  }

  /* ───────── CTA 그래픽 — 좁은 폭에서 스파클을 가운데에 둔다 ─────────
     industry.css 는 900px 이하에서 object-position 을 69% 로 당긴다. 그 값은
     솔루션 띠 그래픽(마루와 핀이 45~80% 에 몰려 있다)에서 뽑은 것이라, 코어가
     66.0% 한자리에 서 있는 이 그래픽에는 맞지 않는다 — 코어가 화면 55% 에 서서
     글줄 한가운데를 지난다(실측 390px).
     ⚠️ object-position 값만 고쳐서는 못 맞춘다. cover 가 보여 주는 가로 구간이
        화면마다 달라(390px 에서 원본의 21.5% · 900px 에서 46%), 코어를 한가운데
        두는 값이 59% -> 74% 로 움직인다. 제품소개 돔에서 겪은 것과 같다.
     그래서 자르지 않는다 — 제 비율로 높이를 채우게 두고, 그림의 66% 지점을
     섹션 한가운데에 포갠다. translateX 의 % 는 제 폭을 기준으로 재므로 폭이
     달라져도 같은 지점이 가운데에 선다.
     ⚠️ max-width: none 이 필요하다. 전역 규칙이 100% 로 묶어 두면 높이를 채운
