interface Props {
  /** 1 · 2 · 3 … 배지에 찍을 숫자. */
  n: number;
  class?: string;
}
const { n, class: cls } = Astro.props;
const d = PATHS[String(n)];
---

{/* 못 가진 글자(두 자리 등)는 글자로 떨어뜨린다 — 숫자가 사라지지는 않게. */}
{d
  ? <svg class:list={['rf-num', cls]} viewBox="0 0 100 100" aria-hidden="true" focusable="false"><path d={d} /></svg>
  : <span class:list={['rf-num-t', cls]} aria-hidden="true">{n}</span>}

<style>
  /* 배지의 안쪽 상자를 그대로 덮는다 — 원(배경)과 숫자(이 svg)가 같은 상자에서
     나오므로 둘이 같이 반올림되고, 서로 어긋나지 않는다.
     ⚠️ 놓는 쪽 배지에 position(relative 또는 absolute)이 있어야 한다. */
  .rf-num { position: absolute; inset: 0; display: block; fill: currentColor; pointer-events: none; }
  .rf-num-t { font-variant-numeric: tabular-nums; }
</style>
