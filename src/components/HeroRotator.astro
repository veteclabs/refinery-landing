---
/**
 * 대제목 아래 한 줄. 'Refinery for' 는 고정이고 뒤의 산업 이름만 타이핑으로 바뀐다.
 *
 * 산업 이름은 영문 레지스트리(src/data/industries/en.ts)를 그대로 쓴다 — 국문 홈도
 * 영문 이름을 쓰기로 했으므로 ko·en 이 같은 목록을 본다. 산업이 늘거나 순서가 바뀌면
 * 레지스트리만 고치면 된다.
 */
import { industriesEn } from '../data/industries/en';

const names = industriesEn.map((i) => i.name);
// 타이핑으로 글자 수가 오락가락해도 칸 폭이 흔들리지 않게, 가장 긴 이름으로 자리를 잡아 둔다.
const widest = names.reduce((a, b) => (b.length > a.length ? b : a), names[0]);
---

<p class="hero-for" data-hero-for={JSON.stringify(names)}>
  <span class="hero-for__fixed">Refinery for</span>{' '}
  <span class="hero-for__slot">
    {/* 스크린 리더에는 한 줄만 읽힌다 — 일곱 개를 연달아 읽으면 문장이 깨진다.
        눈으로 보는 쪽은 아래 .hero-for__out 이 맡는다. */}
    <span class="hero-for__sr">industrial sites</span>
    {/* 보이지 않지만 자리를 차지해 칸 폭을 정한다 — 글자가 늘고 줄어도 왼쪽 끝이 밀리지 않는다. */}
    <span class="hero-for__ghost" aria-hidden="true">{widest}</span>
    <span class="hero-for__live" aria-hidden="true"><span class="hero-for__out">{names[0]}</span><span
      class="hero-for__caret"></span></span>
  </span>
</p>

<style is:global>
  .hero-for {
    margin: 0;
    font-size: 20px;
    font-weight: 400;
    line-height: 1.5;
    color: var(--text-muted);
    white-space: nowrap;
  }
  .hero-for__slot {
    position: relative;
    display: inline-block;
    vertical-align: bottom;
  }
  .hero-for__ghost { visibility: hidden; }
  .hero-for__live {
    position: absolute;
    left: 0;
    top: 0;
  }
  .hero-for__out {
    color: var(--text);
    font-weight: 500;
  }
  /* 보이지는 않지만 읽히는 글. 줄에서 자리를 차지하지 않아야 뒤의 타이핑과 겹쳐
     보이지 않는다. */
  .hero-for__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  /* 글자 뒤에서 깜빡이는 막대. 글자가 찍히는 동안에는 깜빡임을 멈춰야(.is-typing)
     커서가 글자를 따라가는 것처럼 보인다. */
  .hero-for__caret {
    display: inline-block;
    width: 2px;
    height: 1.05em;
    margin-left: 2px;
    vertical-align: -0.16em;
    background: var(--accent);
    animation: heroCaret 1s steps(1) infinite;
  }
  .hero-for.is-typing .hero-for__caret { animation: none; }
  @keyframes heroCaret { 0%, 50% { opacity: 1; } 50.01%, 100% { opacity: 0; } }
  @media (max-width: 900px) {
    .hero-for { font-size: 17px; }
  }
  /* 움직임을 줄이는 설정에서는 첫 항목에 멈추고 커서도 두지 않는다. */
  @media (prefers-reduced-motion: reduce) {
    .hero-for__caret { display: none; }
  }
</style>

<script is:inline>
  (function () {
    var d = document;

    function start() {
      var line = d.querySelector('.hero-for');
      var out = line && line.querySelector('.hero-for__out');
      if (!line || !out) return;
      if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      var names;
      try { names = JSON.parse(line.getAttribute('data-hero-for')); } catch (e) { return; }
      if (!names || names.length < 2) return;

      var TYPE = 70, ERASE = 34, HOLD = 2000, BREATH = 420;
      var i = 0, pos = names[0].length, timer = null;

      function set(text, typing) {
        out.textContent = text;
        line.classList.toggle('is-typing', !!typing);
      }

      function erase() {
        if (pos > 0) {
          pos -= 1;
          set(names[i].slice(0, pos), true);
          timer = setTimeout(erase, ERASE);
          return;
        }
        i = (i + 1) % names.length;
        timer = setTimeout(type, BREATH);
      }

      function type() {
        if (pos < names[i].length) {
          pos += 1;
          set(names[i].slice(0, pos), true);
          timer = setTimeout(type, TYPE);
          return;
        }
        set(names[i], false);
        timer = setTimeout(erase, HOLD);
      }

      function run() { timer = setTimeout(erase, HOLD); }
      function stop() { if (timer) { clearTimeout(timer); timer = null; } }

      run();
      // 창이 가려져 있는 동안에는 돌리지 않는다.
      d.addEventListener('visibilitychange', function () {
        if (d.hidden) stop();
        else if (!timer) { pos = out.textContent.length; type(); }
      });
    }

    if (d.readyState === 'loading') d.addEventListener('DOMContentLoaded', start);
    else start();
  })();
</script>
