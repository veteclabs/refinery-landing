---
// 언어 스위처. format:'file' 환경에서 URL 파싱이 불안정하므로 Astro.currentLocale로 현재 로케일을 판별하고,
// 각 로케일 홈으로 링크한다. (딥링크 경로 매핑은 로케일/페이지 확장 시 고도화 예정)
type Lang = 'ko' | 'en' | 'ja';
const current = (Astro.currentLocale ?? 'ko') as Lang;

// 현재 게시(존재)하는 로케일만 노출. ja 페이지 생성 후 추가.
const LIVE: { lang: Lang; label: string; home: string }[] = [
  { lang: 'ko', label: 'KO', home: '/' },
  { lang: 'en', label: 'EN', home: '/en' },
];
---
<div class="lang-switcher" role="group" aria-label="언어 선택 / Language">
  {LIVE.map((it) => (
    <a
      href={it.home}
      hreflang={it.lang}
      data-lang={it.lang}
      class={it.lang === current ? 'lang-item is-active' : 'lang-item'}
      aria-current={it.lang === current ? 'true' : undefined}
    >{it.label}</a>
  ))}
</div>

<script is:inline>
  /* 사용자가 언어를 명시 선택하면 쿠키에 저장 → 자동 언어 안내(미들웨어)가 이 선택을 존중한다. */
  (function () {
    document.querySelectorAll('.lang-switcher .lang-item').forEach(function (a) {
      a.addEventListener('click', function () {
        document.cookie = 'lang=' + a.getAttribute('data-lang') + '; path=/; max-age=31536000; samesite=lax';
      });
    });
  })();
</script>

<style>
  /* 알약 토글 — 랜딩 솔루션 섹션의 산업별·과제별 탭과 같은 형태다.
     현재 언어에 흰 알약이 붙어 지금 어느 쪽인지 한눈에 보인다.
     색은 --ink 스케일(nav-footer.css의 :root)에서 가져온다. */
  .lang-switcher {
    display: inline-flex; gap: 2px;
    background: var(--ink-100); border-radius: 999px; padding: 3px;
  }
  .lang-item {
    font-size: 13px; font-weight: 600; color: var(--ink-500);
    padding: 5px 11px; border-radius: 999px; text-decoration: none;
    transition: background .18s ease;
  }
  /* 호버는 헤더 다른 항목과 같은 규칙 — 글자 색은 그대로 두고 면만 옅게 깔린다. */
  .lang-item:not(.is-active):hover { background: rgba(255, 255, 255, .6); }
  .lang-item.is-active {
    background: #ffffff; color: var(--ink-900);
    box-shadow: 0 1px 2px rgba(16, 32, 44, .10);
  }
</style>
