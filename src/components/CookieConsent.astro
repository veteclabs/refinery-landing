---
// 쿠키 동의 배너 + 동의 게이팅. 동의('granted') 시에만 GA·Mixpanel 로드.
// Vercel Analytics(쿠키리스)는 Analytics.astro에서 항상 로드.
const lang = (Astro.currentLocale ?? 'ko') as 'ko' | 'en';
const t =
  lang === 'en'
    ? {
        text: 'We use cookies to enhance site navigation and analyze site usage. If you accept, analytics data may be transferred to the United States (Google, Mixpanel).',
        more: 'For details, see our',
        accept: 'Accept all',
        decline: 'Reject all',
        cookie: 'Cookie Policy',
        privacy: 'Privacy Policy',
        // 약관류는 법적 효력이 있어 전문 번역 전까지 영어판을 만들지 않는다.
        // 영어 로케일에서도 한국어 원문으로 연결한다(없는 /en/* 경로는 404가 된다).
        cookieHref: '/cookie-policy',
        privacyHref: '/privacy',
        aria: 'Cookie consent',
      }
    : {
        text: '저희는 쿠키를 사용하여 사이트 탐색을 개선하고 사이트 사용량을 분석합니다. \'모두 허용\' 시 분석 데이터가 미국(Google·Mixpanel)으로 이전될 수 있습니다.',
        more: '자세한 내용:',
        accept: '모두 허용',
        decline: '모두 거부',
        cookie: '쿠키 정책',
        privacy: '개인정보처리방침',
        cookieHref: '/cookie-policy',
        privacyHref: '/privacy',
        aria: '쿠키 동의',
      };
---
<div id="cookieConsent" class="cc" role="dialog" aria-label={t.aria} aria-live="polite" hidden>
  <div class="cc-inner">
    <div class="cc-copy">
      <p class="cc-text">{t.text}</p>
      <p class="cc-links">{t.more} <a href={t.cookieHref}>{t.cookie}</a> · <a href={t.privacyHref}>{t.privacy}</a></p>
    </div>
    <div class="cc-actions">
      <button type="button" id="ccDecline" class="cc-btn cc-ghost">{t.decline}</button>
      <button type="button" id="ccAccept" class="cc-btn cc-primary">{t.accept}</button>
    </div>
  </div>
</div>

<style>
  /* 화면 아래에 폭을 꽉 채워 붙는 띠. 떠 있는 상자가 아니라 창의 일부처럼 앉는다.
     그래서 좌우·아래 여백과 모서리를 없애고, 그림자 대신 위쪽 선 하나로 본문과
     나눈다 — 떠 있지 않으므로 그림자가 할 일이 없다.
     글은 안쪽 단(.cc-inner)에서 사이트의 다른 단과 같은 1280px 선에 맞춘다.
     띠는 끝까지 가되 글까지 화면 끝에 붙으면 읽기 어렵다. */
  .cc {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 200;
    background: #ffffff; color: #16202c;
    border-top: 1px solid #e3e7ec;
    padding: 32px 0;
    font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, sans-serif;
  }
  /* 안쪽 단은 헤더(.nav-inner)·본문(.container)과 같은 값이다 — 1280 / 좌우 48.
     그래야 배너 글이 헤더 로고와 같은 선에서 시작한다(1440px에서 128px).
     900px 아래에서 24로 좁히는 것도 그쪽 규칙을 그대로 따른다. */
  .cc-inner {
    max-width: 1280px; margin: 0 auto; padding: 0 48px;
    display: flex; align-items: center; gap: 18px; flex-wrap: wrap;
  }
  @media (max-width: 900px) {
    .cc-inner { padding: 0 24px; }
  }
  .cc[hidden] { display: none; }
  .cc-copy { flex: 1 1 320px; }
  /* keep-all: 없으면 좁은 폭에서 한글이 어절 한가운데서 끊긴다
     (320px에서 '개선하/고', 640px에서 '분/석합니다'). 전 페이지 공통 배너다. */
  .cc-text { margin: 0; font-size: 13.5px; line-height: 1.6; color: #47535f; word-break: keep-all; overflow-wrap: break-word; }
  .cc-links { margin: 6px 0 0; font-size: 12.5px; color: #7e8a98; }
  .cc-links a { color: #4b86bf; text-decoration: underline; text-underline-offset: 2px; }
  .cc-actions { display: flex; gap: 8px; margin-left: auto; }
  /* 헤더의 '문의하기'(.btn-primary)와 같은 규격이다 —
     6px 18px · 14px · 400 · 테두리 1px 60% · 모서리 6px.
     ⚠️ 색만 다르다. 헤더는 #111111 / rgba(17,17,17,.6)을 쓰는데 둘 다 디자인
     시스템 ink 스케일에 없는 날것의 검정이다(ink-900은 #16202C). 여기서는
     시스템 값으로 맞춘다 — 글자 ink-900(#16202C), 테두리 ink-500(#7E8A98).
     테두리를 불투명한 단계로 두는 이유: 반투명은 뒤 배경에 따라 색이 달라진다.
     지금은 배너가 흰 면 위에 있지만 값 자체가 배경에 기대지 않게 한다.
     헤더도 같은 문제를 갖고 있지만 전 페이지에 걸리는 값이라 여기서 손대지 않는다.
     line-height는 헤더가 페이지에서 물려받는 값(1.65 = 23.1px)을 그대로 적는다.
     <button>은 기본이 normal이라 이걸 안 적으면 높이가 37px 대신 30px이 된다.
     호버는 두지 않는다(요청) — 그래서 transition도 없다.
     두 버튼은 색으로 갈리지 않는다. '모두 허용'만 굵기를 한 단계 올려
     어느 쪽이 기본인지 알린다. */
  .cc-btn {
    padding: 6px 18px; font-size: 14px; font-weight: 400; line-height: 1.65;
    font-family: inherit;
    background: transparent; color: #16202c;
    border: 1px solid #7e8a98; border-radius: 6px;
    cursor: pointer;
  }
  /* '모두 허용'은 잉크색으로 면을 채운다 — 두 버튼이 같은 모양이라 기본 동작을
     면으로 알린다. 흰 글자가 15.94:1로 또렷하다.
     테두리도 같은 색으로 둔다. 그냥 두면 면과 겹쳐 가장자리만 두 번 칠해진다. */
  .cc-primary {
    font-weight: 600;
    background: #16202c;
    border-color: #16202c;
    color: #ffffff;
  }
  @media (max-width: 560px) {
    .cc { padding: 24px 0; }
    .cc-inner { flex-direction: column; align-items: stretch; gap: 12px; }
    /* 세로 배치에선 flex-basis(320px)가 '높이'로 잡혀 배너가 커지므로 콘텐츠 높이로 되돌린다 */
    .cc-copy { flex: 0 1 auto; }
    .cc-actions { margin-left: 0; }
    .cc-btn { flex: 1; }
  }
</style>

<script is:inline>
  (function () {
    var GA_ID = 'G-26MDX5Q369';
    var MP_TOKEN = '72c823a8ffe370ae7f80c35c3475300b';

    function getCookie(n) { var m = document.cookie.match('(?:^|; )' + n + '=([^;]*)'); return m ? m[1] : null; }
    function setCookie(n, v) { document.cookie = n + '=' + v + '; path=/; max-age=31536000; samesite=lax'; }

    function loadGA() {
      if (window.__gaLoaded) return; window.__gaLoaded = 1;
      var s = document.createElement('script'); s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { dataLayer.push(arguments); };
      gtag('js', new Date());
      gtag('config', GA_ID);
    }
    function loadMixpanel() {
      if (window.__mpLoaded) return; window.__mpLoaded = 1;
      (function (f, b) { if (!b.__SV) { var e, g, i, h; window.mixpanel = b; b._i = []; b.init = function (e, f, c) { function g(a, d) { var b = d.split("."); 2 == b.length && ((a = a[b[0]]), (d = b[1])); a[d] = function () { a.push([d].concat(Array.prototype.slice.call(arguments, 0))); }; } var a = b; "undefined" !== typeof c ? (a = b[c] = []) : (c = "mixpanel"); a.people = a.people || []; a.toString = function (a) { var d = "mixpanel"; "mixpanel" !== c && (d += "." + c); a || (d += " (stub)"); return d; }; a.people.toString = function () { return a.toString(1) + ".people (stub)"; }; i = "disable time_event track track_pageview track_links track_forms track_with_groups add_group set_group remove_group register register_once alias unregister identify name_tag set_config reset opt_in_tracking opt_out_tracking has_opted_in_tracking has_opted_out_tracking clear_opt_in_out_tracking start_batch_senders people.set people.set_once people.unset people.increment people.append people.union people.track_charge people.clear_charges people.delete_user people.remove".split(" "); for (h = 0; h < i.length; h++) g(a, i[h]); var j = "set set_once union unset remove delete".split(" "); a.get_group = function () { function b(c) { d[c] = function () { call2_args = arguments; call2 = [c].concat(Array.prototype.slice.call(call2_args, 0)); a.push([e, call2]); }; } for (var d = {}, e = ["get_group"].concat(Array.prototype.slice.call(arguments, 0)), c = 0; c < j.length; c++) b(j[c]); return d; }; b._i.push([e, f, c]); }; b.__SV = 1.2; e = f.createElement("script"); e.type = "text/javascript"; e.async = !0; e.src = "undefined" !== typeof MIXPANEL_CUSTOM_LIB_URL ? MIXPANEL_CUSTOM_LIB_URL : "file:" === f.location.protocol && "//cdn.mxpnl.com/libs/mixpanel-2-latest.min.js".match(/^\/\//) ? "https://cdn.mxpnl.com/libs/mixpanel-2-latest.min.js" : "//cdn.mxpnl.com/libs/mixpanel-2-latest.min.js"; g = f.getElementsByTagName("script")[0]; g.parentNode.insertBefore(e, g); } })(document, window.mixpanel || []);
      // autocapture: 클릭·폼 상호작용을 자동 수집(.mp-no-track 요소는 제외 → 문의 폼 PII 보호).
      // record_mask_all_inputs: 세션 리플레이에서 입력값 마스킹(email·tel 입력은 설정과 무관하게 항상 마스킹).
      mixpanel.init(MP_TOKEN, { autocapture: true, track_pageview: true, persistence: "localStorage", record_sessions_percent: 100, record_heatmap_data: true, record_mask_all_inputs: true });
    }
    function loadTrackers() { try { loadGA(); loadMixpanel(); } catch (e) {} }

    var el = document.getElementById('cookieConsent');
    function hide() { if (el) el.hidden = true; }
    // 푸터 '쿠키 설정' 등에서 배너를 다시 열어 재선택할 수 있게 한다.
    window.openCookieSettings = function () { if (el) el.hidden = false; };

    var consent = getCookie('cookie_consent');
    if (consent === 'granted') {
      loadTrackers();
    } else if (consent !== 'denied') {
      if (el) el.hidden = false; // 미결정 → 배너 노출
    }

    var a = document.getElementById('ccAccept');
    var d = document.getElementById('ccDecline');
    if (a) a.addEventListener('click', function () { setCookie('cookie_consent', 'granted'); loadTrackers(); hide(); });
    if (d) d.addEventListener('click', function () { setCookie('cookie_consent', 'denied'); hide(); });
  })();
</script>
