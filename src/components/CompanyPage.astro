---
// 회사 소개 본문. 한국어(/company)와 영어(/en/company)가 이 컴포넌트를 공유한다.
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import '../styles/industry.css';

interface Props {
  lang?: 'ko' | 'en';
}
const { lang = 'ko' } = Astro.props;

const SITE = 'https://refinery.kr';

// ⚠️ 회사 세부 사실(설립연도·조직 규모·수상 등)은 실제 정보로 확인·보완 필요.
const T = {
  ko: {
    title: '회사 소개 · 현장을 아는 팀이 만든 산업 AI | Refinery',
    description: 'Refinery는 (주)베텍이 30년 넘게 산업 현장에서 쌓은 경험을 토대로 만들었습니다. 개발자와 현장 엔지니어가 한 팀이 되어, 기존 시스템 위에 얹거나 없으면 새로 구축해 하나의 통합 지능으로 잇습니다.',
    canonical: '/company',
    jsonLdName: '회사 소개 | Refinery',
    h1: 'Hello, we’re Refinery',
    lede: 'Refinery는 (주)베텍이 30년 넘게 산업 현장에서 쌓아 온 경험으로 만들었습니다.<br>개발자도 발전소와 공장을 직접 겪으며, 현장의 언어로 문제를 정의하고 풉니다.',
    cta: '문의하기', contactHref: '/contact',
    storyTag: '회사 소개',
    storyTitle: '현장을 아는 팀이 만든<br>솔루션, 산업 AI',
    storyLede: '화려한 기술 데모는 만들지 않습니다.<br>현장에서 실제로 통하는 방식을 만듭니다.',
    storySig: '30년 현장의 (주)베텍이 만든 제품',
    stats: [
      { num: '30년+', label: '산업 현장에서 쌓은 <span class="cmp-stat-hl">경험</span>', icon: '/company/icon-stat-02.svg' },
      { num: '100+', label: '데이터를 다룬 <span class="cmp-stat-hl">현장 수</span>', icon: '/company/icon-stat-01.svg' },
      { num: '20+', label: '철강 · 반도체 · 식품 등 <span class="cmp-stat-hl">산업군 수</span>', icon: '/company/icon-stat-03.svg' },
    ],
    strengthsTitle: '제품의 세 가지 뿌리',
    strengthsSub: '현장을 겪은 팀과 30년의 경험에서 나왔습니다.',
    strengths: [
      { tag: 'People', illust: '/company/card-illust-01.svg', illustRight: '20px', title: '현장을 겪은 사람들이 <br>제품을 설계합니다.', description: '발전 · 제조 · 에너지 현장을 아는 엔지니어가 개발자와 한 팀입니다.<br>설비가 어떻게 멈추고 운전자가 무엇을 보고 판단하는지 <br>겪어 본 사람들이 제품을 설계합니다.' },
      { tag: 'Experience', illust: '/company/card-illust-02.svg', illustTop: '-65px', illustRight: '24px', title: '30년의 노하우로 <br>두 방식을 지원합니다.', description: '기존 시스템 위에 얹는 것도, 없는 현장을 새로 세우는 것도 가능합니다.<br>신규 구축도 30년 경험으로 만든 템플릿에서 시작합니다.<br>*템플릿 예시 : 에너지경영시스템' },
      { tag: 'Technology', illust: '/company/card-illust-03.svg', illustTop: '-75px', illustRight: '-8px', title: '시계열을 넘어 <br>AI 판단까지 잇습니다.', description: '센서 시계열뿐 아니라 설비 · 문서 · 이력까지 온톨로지로 엮어 <br>산업을 가리지 않는 다양한 활용을 만들고, <br>그 위에서 AI 에이전트가 근거를 들어 의사결정을 돕습니다.' },
    ],
    principlesTitle: '일하는 세 가지 기준',
    principlesSub: '현장에서 확인한 것만 제품에 넣습니다.',
    principles: [
      { title: '현장에서 나온 문제', description: '이론에서 시작하지 않습니다.<br>멈춘 설비 앞에서 시작합니다.' },
      { title: '얹거나, 새로 세우거나', description: '쓰던 시스템을 걷어내지 않습니다.<br>그 위에 얹거나, 없으면 세웁니다.' },
      { title: '숫자에 붙는 맥락', description: '숫자만 보여주지 않습니다.<br>판단까지 잇습니다.' },
    ],
    ctaTitle: '현장의 문제를<br>Refinery 팀과 함께 풀어보세요.',
  },
  en: {
    title: 'About · Industrial AI built by people who know the field | Refinery',
    description: 'Refinery is built on more than thirty years of VETEC’s experience on industrial sites. Software engineers and field engineers work as one team, layering onto existing systems or building from scratch where none exist.',
    canonical: '/en/company',
    jsonLdName: 'About | Refinery',
    h1: 'Hello, we’re Refinery',
    lede: 'Refinery is built on more than thirty years of experience VETEC gathered on industrial sites.<br>Our developers have worked the plants themselves, and we define problems in the language of the site.',
    cta: 'Contact', contactHref: '/en/contact',
    storyTag: 'About us',
    storyTitle: 'Industrial AI,<br>built by a team<br>from the floor.',
    storyLede: 'We do not build impressive demos.<br>We build what actually works on site.',
    storySig: 'Built by VETEC, thirty years in the field – Refinery',
    stats: [
      { num: '30+ years', label: 'on industrial <span class="cmp-stat-hl">sites</span>', icon: '/company/icon-stat-02.svg' },
      { num: '100+', label: '<span class="cmp-stat-hl">sites</span> where we handled data', icon: '/company/icon-stat-01.svg' },
      { num: '20+', label: '<span class="cmp-stat-hl">industries</span>, from steel to food', icon: '/company/icon-stat-03.svg' },
    ],
    strengthsTitle: 'Three roots of the product',
    strengthsSub: 'From a team that has been on the floor, and thirty years of experience.',
    strengths: [
      { tag: 'People', illust: '/company/card-illust-01.svg', illustRight: '20px', title: 'Designed by people <br>who have been on the floor.', description: 'Field engineers who know power, manufacturing and energy sites work alongside developers.<br>People who have seen how equipment fails, and what an operator watches, are the ones designing the product.' },
      { tag: 'Experience', illust: '/company/card-illust-02.svg', illustTop: '-65px', illustRight: '24px', title: 'Thirty years of know-how, <br>both ways supported.', description: 'We can layer onto existing systems, or build from scratch where none exist.<br>Even a new build starts from a template refined over thirty years.<br>*Template example: an energy management system' },
      { tag: 'Technology', illust: '/company/card-illust-03.svg', illustTop: '-75px', illustRight: '-8px', title: 'Beyond time series, <br>through to AI judgment.', description: 'Not only sensor time series but equipment, documents and history<br>are woven together through an ontology, creating applications across industries.<br>On top of that, an AI agent helps decide with evidence.' },
    ],
    principlesTitle: 'Three standards we work by',
    principlesSub: 'Only what we have confirmed on site goes into the product.',
    principles: [
      { title: 'Problems from the field', description: 'We do not start from theory.<br>We start at the machine that stopped.' },
      { title: 'Layer on, or build new', description: 'We do not tear out what you already run.<br>We layer on top, or build from scratch.' },
      { title: 'Meaning in the numbers', description: 'We do not stop at showing numbers.<br>We carry them through to a decision.' },
    ],
    ctaTitle: 'Let’s solve what’s happening on your site,<br>together with the Refinery team.',
  },
}[lang];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: T.jsonLdName,
  url: `${SITE}${T.canonical}`,
  publisher: {
    '@type': 'Organization',
    name: 'Refinery',
    url: `${SITE}/`,
    logo: `${SITE}/logo_Refinery_symbol.svg`,
  },
};

// ko/en 양쪽이 모두 존재하는 페이지라 hreflang을 출력한다.
const alternates = [
  { lang: 'ko', href: '/company' },
  { lang: 'en', href: '/en/company' },
];
---

<BaseLayout
  title={T.title}
  description={T.description}
  canonical={T.canonical}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <Nav />
  <main class="ind cmp-page">
    <!-- HERO -->
    {/* 히어로 구성·값은 메인 랜딩(#hero)과 같다 — 흰 바탕에 큰 제목과
        소제목만 둔다. 태그라인·배경 이미지는 두지 않는다. */}
    <section class="ind-hero cmp-hero">
      <div class="ind-container">
        <h1 set:html={T.h1}></h1>
        <p class="ind-lede" set:html={T.lede}></p>
      </div>
    </section>

    {/* STORY — 히어로 바로 아래라 사진을 깔아 어두운 면으로 이어 받는다.
        사진 위에 어두운 막을 덮고 글자를 흰색 계열로 바꾼다(예지보전 히어로와 같은 방식). */}
    <section class="ind-section cmp-story-bg">
      <img
        class="cmp-story-bg-img"
        src="/img_login-bg.webp"
        alt=""
        aria-hidden="true"
        width="3840"
        height="2160"
        loading="lazy"
        decoding="async"
      />
      <div class="ind-container">
        {/* 수치가 대제목 끝나는 지점에서 시작하도록 제목 묶음(1행)과 본문(2행)을
            그리드 직계 자식으로 나눈다. 수치를 2행에 두면 행 경계 = 대제목 아래선이라
            높이를 재서 맞출 필요가 없다. */}
        <header class="ind-head cmp-story">
          <p class="cmp-story-tag">{T.storyTag}</p>
          <h2 set:html={T.storyTitle}></h2>
          {/* ⚠️ 본문은 제목 묶음 안(1행)에 있어야 한다. 2행에 두면 space-between이
              만드는 남는 높이가 대제목과 본문 사이로 들어가, 화면이 넓어질수록
              간격이 벌어진다(1920px에서 290px). 여기 있으면 항상 20px이다. */}
          <p class="cmp-story-lede" set:html={T.storyLede}></p>
        </header>
        <p class="cmp-story-sig">{T.storySig}</p>

        <!-- 오른쪽 칸 — 사진이 닿지 않아 비어 있던 자리. 수치를 여기로 옮겼다. -->
        <div class="cmp-stats">
          {T.stats.map((st) => (
            <div class="cmp-stat">
              <div class="cmp-stat-num">{st.num}</div>
              <div class="cmp-stat-label">
                {/* 이미지/icon_회사 소개-01~03.svg. 파일이 흰색·하늘색 두 색을 쓰므로
                    마스크로 색을 입히면 한 색으로 뭉개진다 — <img>로 그대로 둔다.
                    파일에서 고친 건 선 굵기뿐(70x70 뷰박스에 선언이 없어 기본 1이면
                    54px에서 실효 0.77px라 2로 올렸다). */}
                <img class="cmp-stat-icon" src={st.icon} alt="" aria-hidden="true" width="54" height="54" />
                <span set:html={st.label}></span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- STRENGTHS -->
    <section class="ind-section ind-soft">
      <div class="ind-container">
        <header class="ind-head cmp-head-row">
          <h2>{T.strengthsTitle}</h2>
          <p>{T.strengthsSub}</p>
        </header>
        {/* 아코디언 — 카드가 섹션 가로폭을 쓰며 세로로 쌓이고 항상 하나만 펼쳐진다.
            처음에는 1번이 펼쳐진 상태. */}
        <div class="cmp-acc">
          {T.strengths.map((it, i) => (
            <div class="cmp-acc-item" data-open={i === 0 ? 'true' : 'false'}>
              <button type="button" class="cmp-acc-head" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`cmp-acc-p${i}`}>
                <span class="cmp-acc-tag">{it.tag}</span>
                <span class="cmp-acc-title" set:html={it.title}></span>
              </button>
              {/* 패널 밖에 둔다. 패널 안에 넣으면 .cmp-acc-inner의 overflow:hidden이
                  절대배치된 그림을 잘라 데스크톱 잘림이 달라진다(아래 잘림 162 -> 300px).
                  좁은 화면에서 본문 아래로 보내는 일은 CSS order가 맡는다. */}
              {it.illust && (
                <img class="cmp-acc-illust" src={it.illust}
                     style={[it.illustTop && `top:${it.illustTop}`, it.illustRight && `right:${it.illustRight}`].filter(Boolean).join(";") || undefined}
                     alt="" aria-hidden="true" width="1020" height="1020" loading="lazy" decoding="async" />
              )}
              <div class="cmp-acc-panel" id={`cmp-acc-p${i}`} role="region">
                <div class="cmp-acc-inner"><p set:html={it.description}></p></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PRINCIPLES -->
    <section class="ind-section">
      <div class="ind-container">
        <header class="ind-head cmp-head-row">
          <h2>{T.principlesTitle}</h2>
          <p>{T.principlesSub}</p>
        </header>
        {/* 랜딩 솔루션 섹션(#industries)의 .industries-grid / .industry-card 규격을 그대로 따른다.
            3열 · gap 18 · 900px에서 2열 · 600px에서 1열. */}
        <ol class="cmp-rule">
          {T.principles.map((p, i) => (
            <li class="cmp-rule-card">
              <span class="cmp-rule-num">{i + 1}</span>
              {/* SVG는 내용의 97%가 내장 base64 래스터라 벡터로 둘 이점이 없었다.
                  표시 크기 160px의 2배인 320px WebP로 대체(778.7KB -> 21.6KB). */}
              <img class="cmp-rule-icon" src={`/company/icon-rule-0${i + 1}.webp`} alt="" aria-hidden="true"
                   width="320" height="320" loading="lazy" decoding="async" />
              <h3>{p.title}</h3>
              <p set:html={p.description}></p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* CTA 구성·값은 /why-refinery(플랫폼 개요)와 같다 — 사진 위 왼쪽 제목 +
        오른쪽 버튼. 사진은 public/에 있어 그대로 공유한다. */}
    <section class="ind-cta cmp-cta-bg">
      <img class="cmp-cta-bg-img" src="/use-cases/cta-bg.webp" alt="" aria-hidden="true" loading="lazy" decoding="async" />
      <div class="ind-container">
        <h2 set:html={T.ctaTitle}></h2>
        <a href={T.contactHref} class="ind-btn-primary ind-btn-lg">{T.cta}</a>
      </div>
    </section>
  </main>
  <Footer />

  <script is:inline>
    // 항상 하나만 펼쳐 둔다. 이미 열린 항목을 다시 눌러도 닫히지 않는다.
    document.querySelectorAll('.cmp-acc').forEach(function (acc) {
      acc.addEventListener('click', function (e) {
        var btn = e.target.closest('.cmp-acc-head');
        if (!btn || !acc.contains(btn)) return;
        var item = btn.closest('.cmp-acc-item');
        if (item.dataset.open === 'true') return;
        acc.querySelectorAll('.cmp-acc-item').forEach(function (x) {
          x.dataset.open = 'false';
          x.querySelector('.cmp-acc-head').setAttribute('aria-expanded', 'false');
        });
        item.dataset.open = 'true';
        btn.setAttribute('aria-expanded', 'true');
      });
    });
  </script>
</BaseLayout>

<style>
  /* 본문 좌우를 헤더(.nav-inner)와 같은 선에 맞춘다 — 로고 왼쪽 = 문의하기 버튼 오른쪽.
     공통 .ind-container는 1120/24라 내용이 헤더보다 49px 안쪽에서 시작했다.
     플랫폼 개요(.wr-page)·예지보전 등이 쓰는 값(1280/48)과 같다.
     .cmp-page 스코프라 .ind-container를 쓰는 다른 페이지에는 영향이 없다. */
  .cmp-page .ind-container { max-width: 1280px; padding: 0 48px; }
  @media (max-width: 900px) {
    .cmp-page .ind-container { padding: 0 24px; }
  }

  /* ───────── 히어로 — 메인 랜딩(#hero)과 같은 값 ─────────
     흰 바탕에 큰 제목과 소제목만 둔다. 랜딩은 아래에 데모 화면이 붙어
     min-height: 100vh를 쓰지만, 여기는 글만 있어 그 값은 가져오지 않는다
     (빈 자리가 화면 하나만큼 생긴다). */
  .cmp-hero {
    padding: 200px 0 100px;
    background: none; border-bottom: none;
  }
  .cmp-hero h1 {
    margin-bottom: 35px;
    /* 제목이 영문이라 랜딩 #hero h1 값을 그대로 쓴다. 크기·굵기를 줄였던 건
       한글일 때 이야기다 — 같은 px에서도 한글은 라틴 대문자보다 크게 찍히고
       (Pretendard 한글 71.9px vs Inter 대문자 61.1px) 획은 얇아서
       0.845배 축소 + 굵기 600으로 보정했었다. 지금은 둘 다 필요 없다.
       Pretendard는 폴백으로만 남긴다(한글이 섞여 들어올 경우 대비). */
    font-size: clamp(48px, 7vw, 84px);
    line-height: 1.15;
    padding: 0.1em 0;
    font-family: 'Inter', 'Pretendard', sans-serif;
    /* .ind-hero h1이 걸어 둔 700/자간을 랜딩과 같은 값으로 되돌린다. */
    font-weight: 500; letter-spacing: normal;
    /* 랜딩 .hero-title-accent와 같은 값을 제목 전체에 건다.
       display:table이라 상자가 가장 긴 줄의 폭으로 줄어든다. 블록 폭(1184px)에
       걸면 글자가 중간 톤에서 멈춰 그라데이션이 거의 보이지 않는다.
       -webkit-text-fill-color가 없으면 웹킷에서 글자색이 그라데이션을 덮는다. */
    display: table;
    background: linear-gradient(90deg, #16202C 0%, #76A6D7 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
  /* background-clip:text를 못 쓰는 브라우저에서 제목이 통째로 사라지지 않게 한다.
     랜딩은 강조 span에만 걸어 일부만 사라지지만 여기는 제목 전체라 위험이 크다. */
  @supports not ((-webkit-background-clip: text) or (background-clip: text)) {
    .cmp-hero h1 { background: none; -webkit-text-fill-color: #16202C; color: #16202C; }
  }
  .cmp-hero .ind-lede {
    font-size: 18px; font-weight: 400; line-height: 1.7;
    color: var(--text-muted); max-width: 960px; margin: 0;
  }
  @media (max-width: 900px) {
    .cmp-hero { padding: 140px 0 72px; }
    .cmp-hero .ind-lede { font-size: 16px; }
  }

  /* ───────── 섹션 여백·제목 — /why-refinery(플랫폼 개요)와 같은 값 ─────────
     공통값은 섹션 84px · 대제목 clamp(26,3.4vw,38)/650/-0.02em/1.25 ·
     소제목 16px이라, 같은 자리에서 한 단계씩 작았다. */
  .cmp-page .ind-section { padding: 130px 0; }
  @media (max-width: 900px) {
    .cmp-page .ind-section { padding: 60px 0; }
  }
  .cmp-page .ind-head { margin-bottom: 64px; }
  .cmp-page .ind-head h2 {
    font-size: clamp(28px, 4vw, 45px); font-weight: 600;
    letter-spacing: -0.8px; line-height: 1.3;
  }
  .cmp-page .ind-head h2 { text-wrap: balance; }
  .cmp-page .ind-head p { text-wrap: pretty; }
  /* 섹션 소제목은 랜딩 .section-header p(18px / 1.7)에 맞춘다 —
     이 페이지 히어로 소제목도 같은 값이라, 16px로 두면 한 페이지 안에서
     두 크기가 섞인다. */
  .cmp-page .ind-head p { font-size: 18px; line-height: 1.7; }
  /* 랜딩 .section-header-row와 같은 값 — 대제목 왼쪽, 소제목 오른쪽 아래 정렬.
     랜딩은 섹션마다 소제목 max-width가 360~680px로 다른데, 기본값 360px을 쓴다. */
  /* ⚠️ max-width: none 필수. industry.css의 .ind-head가 640px로 묶고 있어
     그대로 두면 flex-wrap 때문에 소제목이 아래로 내려간다(랜딩은 1184px 전체). */
  .cmp-head-row { display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; flex-wrap: wrap; max-width: none; }
  .cmp-head-row h2 { margin-bottom: 0; }
  .cmp-head-row p { max-width: 360px; margin: 0; }
  @media (max-width: 900px) {
    .cmp-head-row { display: block; }
    .cmp-head-row p { margin-top: 12px; max-width: none; }
  }

  /* ───────── 원칙 카드 ─────────
     랜딩 솔루션 섹션(#industries)과 같은 규격.
     global.css:428 .industries-grid  → 3열 · gap 18 · 900px 2열 · 600px 1열
     global.css:429 .industry-card    → #fff · 1px border · radius · padding 30
     레이아웃(3열·gap·카드 박스)만 랜딩을 따르고, 글자 크기는 위 뿌리 아코디언과
     동일하게 맞춘다: 라벨 13 · 제목 28 / 1.3 · 본문 16 / 1.7.
     ⚠️ 카드 본문폭이 323px(아코디언 544px)이라 같은 크기여도 줄 수가 다르다.
        02번 제목 2줄, 01번 본문 4줄이 되는 것은 이 폭 차이 때문이지 오류가 아니다. */
  .cmp-rule {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px;
  }
  .cmp-rule-card {
    /* 카드 면은 위 뿌리 섹션(.ind-soft)과 같은 --bg-soft. 섹션 배경이 흰색이라
       회색 카드가 그대로 떠 보인다. */
    background: var(--bg-soft); border: 1px solid var(--border); border-radius: var(--radius);
    padding: 30px; position: relative; overflow: hidden;
    transition: border-color .2s, background .2s;
    text-align: center;
  }
  .cmp-rule-num {
    display: flex; align-items: center; justify-content: center;
    width: 30px; height: 30px; border-radius: 50%;
    /* 원을 --accent로 채우고 숫자는 흰색. 테두리는 같은 색으로 남겨 두면
       border-box 기준 지름 30px이 그대로 유지된다. */
    background: var(--accent); border: 1px solid var(--accent);
    /* 글꼴은 뿌리 태그라인(.cmp-acc-tag)과 같은 본문 글꼴을 그대로 물려받는다. */
    /* 크기·굵기·자간 모두 아코디언 태그라인(.cmp-acc-tag)과 동일하게 맞춘다.
       자간 1.2px은 마지막 글자 뒤에도 붙어 글자가 0.6px 왼쪽으로 치우치지만
       이 크기에서는 눈에 띄지 않는다. */
    font-size: 15px; font-weight: 600; line-height: 1;
    /* 자간은 회사 소개 섹션 태그라인(.cmp-story-tag)과 같은 -0.2px.
       값이 작아 한 글자 뒤에 붙는 여백도 -0.1px 수준이라 되밀 필요가 없다
       (자간 1.2px일 때는 0.6px 밀려 padding-left로 보정했었다). */
    /* 흰색 유지. #3f76ae를 시도했으나 그 4.71:1은 흰 배경 기준 값이었고,
       실제 바탕인 #76A6D7 위에서는 1.86:1로 흰색(2.56:1)보다 낮았다. */
    color: #ffffff; letter-spacing: -0.2px;
    /* 번호는 흐름에서 빼서 카드 왼쪽 위에 고정한다. 흐름에 두면 이 배지가
       아이콘을 아래로 밀어, '카드 윗선 -> 아이콘' 여백만 48px 더 벌어진다.
       위치값(30px)은 카드 패딩과 같아 보이는 자리는 그대로다. */
    position: absolute; top: 30px; left: 30px; margin: 0;
  }
  /* 대제목 위 아이콘. 카드 안쪽 내용 너비(323px) 기준 가운데 정렬. */
  /* 카드 윗선 -> 아이콘 60px, 아이콘 -> 대제목 40px.
     위쪽은 카드 패딩 30px이 이미 깔려 있으므로 마진은 30px만 더한다. */
  .cmp-rule-icon { display: block; width: 160px; height: 160px; margin: 30px auto 40px; }
  .cmp-rule-card h3 {
    /* 제목 28 / 1.3 — .cmp-acc-title과 동일. 20px일 때의 5px 간격은 28px에서 너무
       붙어 보여, 아코디언의 제목-본문 간격(12px)을 함께 가져온다. */
    margin: 0 0 12px; font-size: 26px; font-weight: 600; line-height: 1.3;
    color: var(--text); word-break: keep-all; text-wrap: balance;
  }
  /* 본문 16 / 1.7 — .cmp-acc-inner p와 동일. 아코디언에 모바일 축소가 없으므로
     여기서도 폭이 줄어도 크기를 낮추지 않는다. */
  /* keep-all 필수: 없으면 한글이 어절 한가운데서 잘린다(1024px·375px에서 확인). */
  .cmp-rule-card p { margin: 0; font-size: 16px; line-height: 1.7; color: var(--text-muted); text-wrap: pretty; word-break: keep-all; }
  @media (max-width: 900px) {
    .cmp-rule { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .cmp-rule { grid-template-columns: 1fr; }
  }

  /* ───────── 강점 아코디언 ───────── */
  /* 카드 간격은 기준 섹션(.cmp-rule)과 같은 18px. */
  .cmp-acc { display: grid; gap: 18px; }
  /* 랜딩 솔루션 섹션(#industries)의 .industry-card와 같은 값 —
     흰 배경 · 1px 테두리 · radius 12px · 안쪽 여백 30px,
     제목 20px/600(아래 5px), 설명 15px/1.5. */
  .cmp-acc-item {
    background: #ffffff; border: 1px solid var(--border);
    border-radius: var(--radius); overflow: hidden;
    position: relative;
  }
  /* 카드 오른쪽 일러스트. 접힌 카드(121px)에서는 위아래가 크게 잘려 어색하므로
     펼친 카드에서만 보이게 하고, 열릴 때 함께 서서히 나타난다. */
  .cmp-acc-illust {
    /* SVG 자체를 카드 오른쪽 끝에 붙이고 세로는 카드 위에 맞춘다.
       파일마다 안쪽 여백이 달라(2번은 아래 107px, 왼쪽 84px) 그림이
       내려앉아 보이는 경우가 있어, 필요한 카드만 데이터의 illustTop으로
       위치를 덮어쓴다. */
    position: absolute; right: 0; top: 0; transform: none;
    /* ⚠️ 세로 기준(height 고정 + width auto)이다. width: 50%였을 때는 카드가
       좁아질수록 그림이 같이 줄어 카드 밖으로 잘려 나가는 부분이 폭마다 달랐다.
       높이를 못 박으면 폭이 줄어도 그림 크기가 그대로라 잘리는 부분이 같다.
       값은 1440px에서의 기존 렌더와 같게 뷰박스 비율로 환산했다
       (1번 592 x 1034.16/1020.47 = 600). */
    height: 600px; width: auto; pointer-events: none; user-select: none;
    /* 카드가 좁아지면 크기가 고정된 그림이 본문 자리까지 들어온다.
       줄이면 잘리는 부분이 폭마다 달라지므로, 대신 그림을 글 뒤로 보낸다. */
    z-index: 0;
    opacity: 0; transition: opacity .34s cubic-bezier(.22,1,.36,1);
  }
  .cmp-acc-item[data-open="true"] .cmp-acc-illust { opacity: 1; }
  /* ⚠️ 숨김 기준이 900이 아니라 1150이다. 그림 폭이 592px으로 고정됐으므로
     본문(카드의 46%)과 겹치지 않으려면 카드가 592 / (1 - 0.46) = 1096px 이상
     이어야 하고, 컨테이너 좌우 여백 24를 더하면 뷰포트 1144px이 경계다.
     그 아래에서는 그림을 줄이는 대신 감춘다 — 줄이면 잘리는 부분이 다시
     폭마다 달라져 세로 기준으로 바꾼 이유가 없어진다. */
  /* 카드별 크기. 값은 1440px에서의 기존 렌더와 같게 뷰박스 비율로 환산했다
     (2번 591 정사각 · 3번 621 x 1089.57/1020.47 = 663). */
  .cmp-acc-item:nth-child(2) .cmp-acc-illust { height: 591px; }
  .cmp-acc-item:nth-child(3) .cmp-acc-illust { height: 663px; }
  /* 좁은 화면에서는 감추지 않고 본문 아래로 내린다. 그림은 패널 밖에 있으므로
     (패널 안에 두면 .cmp-acc-inner의 overflow:hidden이 데스크톱 잘림을 바꾼다)
     카드를 flex 열로 만들고 order로 맨 뒤에 보낸다. 접힌 카드는 공간을 차지하지
     않도록 아예 감춘다. 벡터라 확대해도 깨지지 않는다.
     ⚠️ 기준이 900이 아니라 980이다. 980px 아래에서는 본문 상자가 399px까지
     좁아져 3줄짜리 글이 7줄로 감긴다. 그 전에 그림을 내려 본문이 카드 폭을
     쓰게 한다. 카드 나머지(패딩·글자 크기)의 기준은 그대로 900px이다. */
  @media (max-width: 980px) {
    .cmp-acc-item { display: flex; flex-direction: column; }
    /* ⚠️ nth-child 규칙(특정도 0,2,0)을 같이 적으로 잡지 않으면 데스크톱용
       height: 591px/663px가 그대로 남아 그림이 세로로 늘어난다(325x591로 확인). */
    .cmp-acc-illust,
    .cmp-acc-item:nth-child(2) .cmp-acc-illust,
    .cmp-acc-item:nth-child(3) .cmp-acc-illust {
      /* 데스크톱처럼 카드 가장자리까지 채운다. 좌우 여백이나 아래 여백을 두면
         잘린 선과 카드 하단 선 사이가 떠 보인다. 카드에 overflow:hidden과
         radius가 있어 모서리는 그대로 둥글게 잘린다. */
      order: 1; position: static; width: 100%; height: auto;
      margin: 4px 0 0; padding: 0; box-sizing: border-box; display: block;
      /* 폭 상한 420px. 없으면 720px 카드에서 그림이 718x532까지 커져 카드가
         807px이 된다. 상한에 걸리면 카드보다 좁아지므로, 데스크톱처럼
         오른쪽 아래 모서리에 붙여 의도한 배치로 읽히게 한다.
         카드가 420px보다 좁으면(375px 등) 상한이 걸리지 않아 그대로 꽉 찬다. */
      max-width: 420px; align-self: flex-end;
      /* 데스크톱과 같은 부분만 보이게 자른다.
         데스크톱은 그림(592x600 등)을 열린 카드 높이 439px이 잘라내므로,
         상자 비율을 <그림 폭> / 439로 잡고 object-fit: cover로 세로만 자른다.
         object-position의 세로값은 데스크톱 top 오프셋을 비율로 옮긴 값이다
         (2번 65 / (591-439) = 42.8% · 3번 75 / (663-439) = 33.5%). */
      aspect-ratio: 592 / 439; object-fit: cover; object-position: 50% 0%;
    }
    .cmp-acc-item:nth-child(2) .cmp-acc-illust { aspect-ratio: 591 / 439; object-position: 50% 42.8%; }
    .cmp-acc-item:nth-child(3) .cmp-acc-illust { aspect-ratio: 621 / 439; object-position: 50% 33.5%; }
    .cmp-acc-item[data-open="false"] .cmp-acc-illust { display: none; }
  }
  .cmp-acc-head {
    position: relative; z-index: 1;
    width: 100%; display: block;
    padding: 30px; background: none; border: 0; cursor: pointer;
    text-align: left; font: inherit; color: inherit;
    transition: padding-bottom .34s cubic-bezier(.22,1,.36,1);
  }
  /* 펼쳤을 때 제목과 설명 사이를 카드와 같은 5px로 좁힌다. */
  .cmp-acc-item[data-open="true"] .cmp-acc-head { padding-bottom: 8px; }
  /* 랜딩 .industry-name과 같은 값. 행간은 그쪽이 선언 없이 body 1.6을
     물려받는데 여기는 .ind-section 문맥의 1.65가 와서 1px 어긋나 못 박는다. */
  /* 랜딩 #teams는 태그라인 12 / 제목 24 / 설명 15였는데 제목·설명을 각각
     x1.17, x1.2로 키웠다. 태그라인도 같은 비율로 14px에 맞춘다. */
  .cmp-acc-tag { display: block; font-size: 15px; font-weight: 600; letter-spacing: -0.2px; color: var(--accent); margin-bottom: 8px; }
  /* text-wrap balance/pretty: <br>로 잡아 둔 줄이 좁은 폭에서 다시 감길 때
     마지막 줄에 단어 하나만 남는 것을 막는다. 영문에서 특히 눈에 띈다. */
  .cmp-acc-title { display: block; font-size: 26px; font-weight: 600; line-height: 1.3; color: var(--text); word-break: keep-all; text-wrap: balance; }
  /* 접힌 카드는 제목만 보이므로 한 줄로 이어 붙인다. 데이터의 <br> 앞에 공백이
     있어 br을 숨겨도 단어가 붙지 않는다. 펼치면 다시 두 줄이 된다. */
  .cmp-acc-title :global(br) { display: none; }
  /* 크기는 접힘·펼침이 같다. 누를 때 글자만 순간이동하듯 바뀌면
     카드 높이는 부드럽게 열리는데 제목만 튀어 어색하다. */
  .cmp-acc-item[data-open="true"] .cmp-acc-title :global(br) { display: block; }
  /* 높이 애니메이션 — grid-template-rows 0fr→1fr이면 내용 높이를 몰라도 부드럽게 열린다. */
  .cmp-acc-panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .34s cubic-bezier(.22,1,.36,1); }
  .cmp-acc-item[data-open="true"] .cmp-acc-panel { grid-template-rows: 1fr; }
  /* 소제목을 패널 아래쪽에 붙인다. min-height(299px)로 확보한 공간이 본문보다
     176px 커서 그대로 두면 왼쪽 아래가 뚫리는데, 오른쪽 일러스트는 그 아래까지
     내려온다. 하단 정렬하면 본문 마지막 줄이 일러스트 바닥선과 나란해진다. */
  /* 본문을 그림 위에 세운다. static이면 절대배치된 그림이 항상 위에 그려진다. */
  .cmp-acc-inner p { position: relative; z-index: 1; }
  .cmp-acc-inner { overflow: hidden; display: flex; flex-direction: column; justify-content: flex-end; }
  /* 펼친 카드 높이 440px. 일러스트(591px)를 다 담으면 카드가 592px로 커져
     바닥판 아래 빈 여백까지 떠안는다. 그 빈 부분만 잘리게 맞춘 값이다.
     440 = 머리 141 + 패널 299. min-height를 카드가 아니라 패널 안쪽에 걸어야
     grid-template-rows 0fr→1fr 전환이 그대로 살아 있다.
     일러스트가 없는 900px 미만에서는 걸지 않는다. */
  @media (min-width: 901px) {
    .cmp-acc-item[data-open="true"] .cmp-acc-inner { min-height: 299px; }
  }
  /* 펼친 카드가 접힌 카드와 확실히 구분되도록 아래 여백을 키운다. */
  /* 설명을 카드 아래쪽으로 내린다 — 위 여백을 크게 주고 아래는 머리쪽과 같은 30px.
     카드 전체 높이는 그대로 두면서 글만 아래로 밀리는 방식이다. */
  /* 설명을 제목 바로 아래로 올린다(머리쪽 padding-bottom 8 + 여기 12 = 20px).
     카드가 높아진 만큼 아래가 비는데, 그 자리를 일러스트가 온전히 차지한다. */
  .cmp-acc-inner p { margin: 0; padding: 12px 30px 30px; font-size: 16px; line-height: 1.7; color: var(--text-muted); text-wrap: pretty; word-break: keep-all;
    /* 일러스트가 카드 오른쪽 절반을 차지하므로 글 상자를 그 앞에서 끊는다.
       줄바꿈은 <br>로 고정이라 실제 줄 길이는 이 값보다 짧다. */
    max-width: 46%; }
  @media (max-width: 900px) {
    .cmp-acc-head { padding: 22px 20px; }
    .cmp-acc-item[data-open="true"] .cmp-acc-head { padding-bottom: 8px; }
    .cmp-acc-title { font-size: 21px; }
    .cmp-acc-inner p { padding: 48px 20px 22px; font-size: 16px; max-width: none; }
  }
  /* ⚠️ 위 .cmp-acc-inner p(max-width 46%)와 min-width:901 min-height 규칙보다
     반드시 뒤에 와야 한다. 특정도가 같아 순서로 결정된다 — 앞에 뒀을 때는
     980px에서 그림만 내려가고 글은 46%로 묶여 오른쪽이 통째로 비었다. */
  @media (max-width: 980px) {
    /* 그림이 본문 아래로 내려갔으므로 글이 카드 폭을 다 쓰게 푼다. */
    .cmp-acc-inner p { max-width: none; }
    /* 그림 자리를 비워 두던 min-height도 함께 푼다. */
    .cmp-acc-item[data-open="true"] .cmp-acc-inner { min-height: 0; }
  }
  @media (max-width: 900px) { .cmp-page .ind-head p { font-size: 16px; } }

  /* ───────── 스토리 섹션 — 사진 위 흰 글자 ─────────
     사진이 lazy라 도착 전 흰 배경이면 흰 글자가 안 보인다. 어두운 면을 미리 깔아 둔다.
     막은 예지보전 히어로(.uc-hero-bg::after)와 같은 값이다 —
     위 80% -> 아래 50%로, 대제목이 놓인 위쪽을 짙게 덮는다. */
  .cmp-story-bg {
    position: relative; overflow: hidden; background: #111316;
    /* 보여 줄 구간을 파일에 미리 잘라 넣었으므로(아래 사진 주석) 칸 비율에
       높이를 묶지 않는다. 이제 섹션 높이는 내용이 정한다. */
    /* 사진(3840x2160)이 가로에 맞춰 들어가는 높이를 섹션 높이로 삼는다.
       그래야 위쪽에 빈 배경이 남지 않는다. min-height이므로 내용이 더 크면
       섹션이 늘어나고, 그때는 상하 여백 130px이 그대로 지켜진다.
       ⚠️ 100vw로 계산하면 스크롤바 폭(15px)만큼 어긋나 위에 7px이 남는다.
       aspect-ratio는 섹션 자기 폭을 기준으로 잡아 정확히 맞는다. */
    aspect-ratio: 3840 / 2160;
    /* 랜딩 #platform과 같이 내용이 섹션 위 여백(130px) 바로 아래에서 시작한다.
       가운데 정렬이면 같은 padding이어도 시작점이 밀린다. */
    display: flex; flex-direction: column; justify-content: flex-start;
  }
  /* 사진은 왼쪽 절반에만 깐다. 오른쪽 절반은 밑판(#111316)만 남는다. */
  /* ⚠️ 1420px 아래에서는 비율을 풀어야 한다. 내용이 상하 여백 포함 800px을
     차지하는데 16:9로는 그만한 높이가 안 나와(1280px에서 712px) 카드가
     섹션 밖으로 넘친다. 비율을 풀면 높이를 내용이 정하고 여백 130px이
     지켜지는 대신, 사진이 낮은 만큼 위쪽에 배경색이 보인다. */
  @media (max-width: 1420px) {
    .cmp-story-bg { aspect-ratio: auto; }
  }

  .cmp-story-bg-img {
    /* 섹션 가로에 맞추고 오른쪽 아래에 붙인다. width:100%·height:auto라
       비율이 유지되므로 잘리는 곳이 없다. 사진이 섹션보다 낮으면
       위쪽에 섹션 배경색(#111316)이 그대로 보인다. */
    position: absolute; top: auto; bottom: 0; right: 0; left: auto;
    width: 100%; height: auto; max-width: none;
    pointer-events: none; user-select: none;
  }
  /* 막도 사진이 있는 왼쪽 절반에만 덮는다. */
  /* ⚠️ 어둡게 덮는 오버레이는 두지 않는다. 앞서 쓰던 사진은 밝아서 필요했지만
     이 사진은 그 자체가 어두워(사용 영역 평균 rgb(38,51,74)) 덮으면 검정만 남는다.
     흰 글씨 대비는 오버레이 없이도 12.6:1로 AAA를 넘는다. */
  /* 글도 왼쪽 절반 안에 둔다 — 컨테이너를 두 칸으로 나누고 첫 칸만 쓴다.
     오른쪽 여백 48px은 글 끝과 사진 오른쪽 끝 사이의 숨이다. */
  .cmp-story-bg > .ind-container {
    display: grid; grid-template-columns: 1fr 1fr;
  }
  /* ⚠️ margin-bottom: 0 필수. .cmp-page .ind-head의 64px이 1행 높이에 포함돼
     행 경계가 대제목 아래선보다 64px 내려가고, 수치도 그만큼 밀린다.
     본문 사이 간격은 .cmp-story-lede의 margin-top 20px이 담당한다. */
  .cmp-story-bg .cmp-story { grid-column: 1; grid-row: 1; padding-right: 48px; align-self: start; margin-bottom: 0; }
  /* 본문은 플랫폼 개요 히어로처럼 대제목 바로 아래(20px)에 붙는다.
     ⚠️ font-size를 여기서 명시해야 한다. 그리드를 2행으로 나누며 이 문단을
     .ind-head 밖으로 뺐고, 그때 18px을 물려받던 .cmp-page .ind-head p 경로가
     끊겨 body 기본값 16px로 떨어져 있었다. */
  .cmp-story-bg .cmp-story-lede {
    padding-right: 48px;
    font-size: 18px; font-weight: 400; line-height: 1.7;
  }
  /* 한 줄 문구는 본문이 있던 자리 — 오른쪽 카드 아래선에 맞춘다.
     본문과 같은 2행 1열이지만 정렬이 반대라 겹치지 않는다.
     크기·색은 본문과 같은 값(18px / 흰색 72%)을 그대로 쓴다. */
  .cmp-story-bg .cmp-story-sig {
    grid-column: 1; grid-row: 2; padding-right: 48px; align-self: end;
    margin: 0; font-size: 18px; font-weight: 400; line-height: 1.7;
    color: rgba(255, 255, 255, 0.72); word-break: keep-all;
  }
  @media (max-width: 900px) {
    .cmp-story-bg .cmp-story-lede { font-size: 16px; }
    .cmp-story-bg .cmp-story-sig { grid-row: auto; padding-right: 0; align-self: start; font-size: 16px; margin-top: 16px; }
  }
  /* 좁은 화면에서는 반으로 나눌 자리가 없다 — 사진·막·글 모두 폭을 다 쓴다. */
  @media (max-width: 900px) {
    .cmp-story-bg > .ind-container { grid-template-columns: 1fr; }
    .cmp-story-bg .cmp-story { grid-row: auto; padding-right: 0; margin-bottom: 0; }
    .cmp-story-bg .cmp-story-lede { grid-row: auto; padding-right: 0; margin-bottom: 40px; align-self: start; }
    .cmp-story-bg { min-height: 0; }
  }
  /* ⚠️ width:100% 필수. .ind-container는 margin:0 auto라 flex 자식이 되면
     stretch가 풀리고 내용 폭으로 줄어든다. 본문이 있을 땐 티가 안 났지만
     제목 3줄만 남으니 716px로 쪼그라들어 좌측 여백이 페이지 기준을 벗어났다. */
  .cmp-story-bg > .ind-container {
    position: relative; z-index: 1; width: 100%;
    /* ⚠️ align-content: start 필수. 섹션이 사진 비율 때문에 내용보다 훨씬 높은데,
       기본값이면 남는 높이를 행들이 나눠 가져 아래 margin-top이 지켜지지 않는다
       (40px을 걸었는데 실제로는 154px로 벌어졌다). */
    /* 남는 높이를 제목 묶음과 카드 사이로 보낸다 — 상하 여백은 건드리지 않고
       그 사이 간격만 늘었다 줄었다 한다. start면 남는 높이가 아래로 몰려
       바닥 여백이 130px보다 커진다. */
    align-content: space-between;
    /* ⚠️ flex:1 필수. 섹션이 flex column이라 이게 없으면 컨테이너 높이가
       내용(333px)에 머물고, 남는 높이는 컨테이너 '아래'로 빠진다.
       그러면 안쪽 그리드 행도 333px이라 align-self:end가 움직일 자리가 없다. */
    flex: 1;
  }
  /* 칸이 절반으로 좁아져 제목이 두 줄이 된다. 기본값(word-break: normal)은
     음절 사이 어디서나 끊어 '솔루 / 션'처럼 갈렸다 — 어절 단위로만 끊는다. */
  .cmp-story-bg .ind-head h2 { color: #fff; word-break: keep-all; text-wrap: balance; }
  /* 랜딩 .teams-preview-tagline과 같은 값(12px/600/자간 1.2px/아래 8px).
     어두운 배경이라 색만 브랜드 하늘색을 그대로 쓴다. */
  /* 플랫폼 개요 히어로 .wr-tag와 같은 값이다.
     ⚠️ 선택자 앞에 .cmp-page가 필요하다. .ind-head 안의 <p>라서
     .cmp-page .ind-head p(0,2,1)가 크기·행간을 덮는다 — 그 규칙은
     900px 아래에서 16px으로 줄이는데, .wr-tag는 폭과 무관하게 18px 고정이다. */
  .cmp-page .cmp-story-bg .cmp-story-tag {
    font-size: 18px; font-weight: 600; line-height: 1.65;
    letter-spacing: -0.2px; color: #76a6d7;
    margin: 0 0 14px;
  }
  /* 제목의 계단 리듬을 잇도록 두 문장을 <br>로 나눠 각각 한 줄에 세운다.
     max-width를 두지 않는 이유: <br>가 이미 줄을 정해 두었고, 폭을 좁히면
     좁은 화면에서 각 줄이 다시 감겨 4줄이 된다. */
  /* 제목→본문 20px은 플랫폼 개요 히어로(.ind-hero .ind-lede)와 같은 값이다.
     좁은 화면에서도 20px을 유지한다 — 그쪽이 1440·375 모두 20px이다.
     크기·행간은 위 ⚠️대로 .cmp-page .ind-head p가 정한다(18px → 900px 아래 16px). */
  .cmp-story-bg .cmp-story-lede {
    margin: 20px 0 0;
    color: rgba(255,255,255,.72); word-break: keep-all;
  }
  /* 굵게 쓴 부분은 밝은 배경용 색(var(--text))이 걸려 있어 흰색으로 올린다. */

  /* ───────── CTA — /why-refinery(플랫폼 개요)와 같은 값 ─────────
     사진 위 왼쪽 정렬 제목 + 오른쪽 버튼. 이미지가 lazy라 도착 전 흰 배경이면
     글자가 잠깐 보이지 않으므로 어두운 면을 미리 깔아 둔다. */
  .cmp-cta-bg {
    position: relative; overflow: hidden;
    padding: 95px 0; text-align: left; background: #0c1015;
  }
  .cmp-cta-bg-img {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover; object-position: center 65%;
    pointer-events: none; user-select: none;
  }
  .cmp-cta-bg .ind-container {
    position: relative; z-index: 1;
    display: flex; align-items: center; justify-content: space-between;
    gap: 48px; flex-wrap: wrap;
  }
  .cmp-cta-bg .ind-container > * { flex: none; }
  /* CTA만 500 — 랜딩 #cta가 섹션 대제목(600)과 다르게 500을 쓰는 것을 따른다.
     크기도 섹션 대제목(45px)보다 한 단계 작은 40px이다. */
  .cmp-page .ind-cta.cmp-cta-bg h2 {
    font-size: clamp(26px, 3.6vw, 40px); font-weight: 500;
    letter-spacing: -0.8px; line-height: 1.35;
    color: #fff; margin-bottom: 0; text-wrap: initial;
  }
  .ind-cta.cmp-cta-bg .ind-btn-primary {
    margin-top: 0; padding: 9px 22px;
    font-size: 15px; font-weight: 400;
    background: #76a6d7; color: #fff;
    border: 1px solid #76a6d7; border-radius: 6px; transition: all .2s;
  }
  .ind-cta.cmp-cta-bg .ind-btn-primary:hover {
    background: #5a8fc5; border-color: #5a8fc5; color: #fff; transform: none;
  }
  /* 좁아지면 버튼이 아래로 내려온다 — 제목과 붙지 않게 여백을 되살린다. */
  @media (max-width: 900px) {
    .ind-cta.cmp-cta-bg .ind-btn-primary { margin-top: 32px; }
  }

  /* 스토리 섹션 오른쪽 칸에 세로로 쌓고 구분선으로 나눈다.
     칸 폭이 592px라 가로 3열은 들어가지 않는다. */
  /* 가로는 컨테이너 오른쪽 끝(1440에서 1305px)에 붙이고,
     세로는 아래로 내려 랜딩 #platform과 같은 하단 여백 130px만 남긴다. */
  /* 2행에 두면 행 경계가 대제목 아래선이라 수치가 딱 그 지점에서 시작한다.
     본문의 margin-top 20px은 본문 칸 안쪽에만 적용돼 수치에는 영향이 없다. */
  .cmp-stats {
    grid-column: 2; grid-row: 2; align-self: start;
    /* 간격은 space-between이 정한다. 위로 130px을 못 박으면 사진 높이에
       맞춘 섹션에 내용이 안 들어간다. */
    margin-top: 0;
    /* 줄 자체는 지금 모습 그대로(460px, 소제목 왼쪽·수치 오른쪽) 두고
       카드 안에서 가운데로 놓는다. end면 max-width 460px 때문에
       왼쪽 95px / 오른쪽 37px로 치우친다. */
    display: grid; justify-items: center; text-align: right;
    /* 사진 위에 얹히는 네모 박스. 사진이 섹션 전체를 덮게 되면서 수치가
       배경과 섞여 보이던 걸 판으로 띄운다. */
    background: rgba(17, 19, 22, 0.40);   /* 플랫폼 개요 '현장이 먼저입니다' 섹션(.wr-dark #111316) · 40% */
    /* 다른 섹션 카드(.ind-card)와 같은 값 */
    border-radius: var(--radius);
    /* 카드는 내용(440x220)에 상하좌우 50px씩 더한 크기다.
       width: fit-content가 없으면 카드가 칸 폭(592px)까지 늘어난다. */
    padding: 50px;
    width: fit-content;
    justify-self: end;
  }
  /* 내용 전체를 440x220으로 맞춘다.
     세로 220 = 아이콘 54 x 3행 + 줄 사이 여백 14.5 x 4 (첫 줄 위·끝 줄 아래는 0).
     아이콘 크기를 바꾸면 줄 사이 여백으로 높이를 맞춘다. */
  /* ⚠️ 고정 px로 못 박아야 한다. 카드가 fit-content라 %나 min()은 칸 폭에
     기대는데 그 칸 폭이 다시 내용에서 나와 순환이 되고, 결국 내용 자연폭
     360px에 그친다. 440px을 직접 주면 카드가 그 폭으로 잡힌다. */
  .cmp-stat { width: 440px; padding: 14.5px 0; }
  .cmp-stat:first-child { padding-top: 0; }
  .cmp-stat:last-child { padding-bottom: 0; }
  /* 수치와 설명을 한 줄에 나란히 둔다 — 설명은 왼쪽, 수치는 오른쪽 끝.
     row-reverse라 DOM 순서(수치 → 설명)는 그대로 두고 화면 배치만 뒤집는다.
     baseline 정렬이라 36px 수치와 15px 설명이 같은 기준선에 앉는다. */
  .cmp-stats .cmp-stat {
    display: flex; flex-direction: row-reverse;
    /* 아이콘이 수치와 같은 크기라 baseline 대신 가운데로 맞춘다.
       baseline이면 글자 없는 아이콘 상자가 기준이 돼 행이 어긋난다. */
    align-items: center; justify-content: space-between; gap: 28px;
  }
  .cmp-stats .cmp-stat-num { text-align: right; }
  .cmp-stats .cmp-stat-label { margin-top: 0; text-align: left; }
  /* ⚠️ 이 미디어 블록은 위 기본 규칙보다 뒤에 있어야 한다.
     앞쪽 900px 블록에 넣었을 땐 특정도가 같아 뒤의 기본 규칙에 밀려 죽었다. */
  @media (max-width: 900px) {
    /* 좁은 화면은 섹션 상단 여백이 60px이라 같은 값으로 맞춘다.
       패딩 50 -> 24: 카드가 컨테이너 폭을 다 쓰게 되면서 안쪽 글이 본문보다
       50px 더 들어가 왼쪽 선이 어긋났다. 컨테이너 좌우 여백과 같은 24로 맞춘다.
       배경 40% -> 62%: 카드가 사진의 밝고 어두운 경계에 걸쳐 가로 띠가 비쳤다. */
    .cmp-stats { grid-column: 1; grid-row: auto; justify-items: start; text-align: left; margin-top: 60px; width: auto; justify-self: stretch;
      padding: 24px; background: rgba(17, 19, 22, 0.62); }
    .cmp-story-bg > .ind-container { align-content: start; }
    /* 좁은 화면에서는 한 줄에 못 들어가므로 원래대로 위아래로 쌓는다. */
    .cmp-stats .cmp-stat { display: block; width: 100%; }
    .cmp-stats .cmp-stat-num { text-align: left; }
    .cmp-stats .cmp-stat-label { margin-top: 10px; }
  }
  /* ⚠️ 750은 Pretendard에 없는 굵기라 800(ExtraBold)으로 올림돼 그려졌다.
     700(Bold)은 실제 페이스가 있어 선언대로 나온다. */
  .cmp-stat-num { font-size: clamp(26px, 3.6vw, 36px); font-weight: 700; line-height: 1.2; letter-spacing: -0.01em; color: #fff; word-break: keep-all; text-wrap: balance; }
  /* 대제목과 같은 순백. 숫자·소제목의 위계는 크기(36 vs 15)와
     굵기(700 vs 400)가 이미 만들고 있어 색까지 나눌 이유가 없다. */
  /* keep-all: 없으면 '산업군 수'가 '산업군 / 수'로 갈려 마지막 줄에 한 글자만 남는다. */
  .cmp-stat-label { margin-top: 10px; font-size: 15px; line-height: 1.5; color: #fff; word-break: keep-all; }
