---
// 회사 소개 본문. 한국어(/company)와 영어(/en/company)가 이 컴포넌트를 공유한다.
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import '../styles/industry.css';
import RfIcon from './RfIcon.astro';

interface Props {
  lang?: 'ko' | 'en';
}
const { lang = 'ko' } = Astro.props;

// '일하는 세 가지 기준' 카드 아이콘. 순서는 T.principles 와 같다.
const RULE_ICONS = ['rule-field', 'rule-build', 'rule-context'];

const SITE = 'https://refinery.kr';

// 무대 장면 — public/company-story/. 히어로 아래 한 장(0)과 무대 다섯 줄(1~5)이
// 한 벌이다. 그림마다 파란 큐브가 빠져 있고, cube.webp 를 스크롤로 옮겨 끼운다.
//
// ⚠️ 자리값은 손으로 적지 않는다. public/company-story/meta.json 이 정본이고
//    여기서 그대로 읽는다 — 그림을 다시 뽑을 때 meta.json 만 갈면 따라온다.
//    한때 숫자를 베껴 적어 뒀다가 그림이 바뀌자 캔버스 크기부터 어긋났다.
//
//    meta 의 ax · ay 는 그림 원본 픽셀 기준의 큐브 자리, k 는 큐브 원본 폭(350px)에
//    대한 배율이다. 아래에서 폭에 대한 비율로 바꾼다 —
//      cx = ax / w · cy = ay / w · cs = k x 350 / w
//    cy 를 높이가 아니라 폭으로 나누는 건, 그림이 줄어도 비율이 안 틀어지게 하기
//    위해서다(CSS top 은 높이 기준이라 sceneVars 가 --cyh 로 환산한다).
import sceneMeta from '../../public/company-story/meta.json';
import { readFileSync } from 'node:fs';

const CUBE_W = 350;   // cube.webp 원본 폭
const SCENE_FILES = [
  'scene-0-site.webp',
  'scene-1-team.webp',
  'scene-2-30years.webp',
  'scene-3-100sites.webp',
  'scene-4-20industries.webp',
  'scene-5-refinery.webp',
];

/* 파일에 적힌 실제 캔버스 크기를 읽는다(WebP VP8X 헤더).
   meta.json 과 맞는지 보려는 것이다 — 그림을 다시 뽑는 사이에 둘이 어긋나면
   큐브가 엉뚱한 자리에 박힌다. */
function webpSize(name: string) {
  /* ⚠️ import.meta.url 은 빌드 때 dist 안을 가리킨다 — 프로젝트 뿌리에서 찾는다. */
  const buf = readFileSync(process.cwd() + '/public/company-story/' + name);
  if (buf.subarray(0, 4).toString() !== 'RIFF' || buf.subarray(12, 16).toString() !== 'VP8X') return null;
  return { w: buf.readUIntLE(24, 3) + 1, h: buf.readUIntLE(27, 3) + 1 };
}

/* 그림이 바뀌기 전에 눈으로 맞춰 둔 값. meta 와 파일이 어긋날 때만 쓴다. */
const FALLBACK: Record<string, { cx: number; cy: number; cs: number }> = {
  '1': { cx: 0.2939, cy: 0.1153, cs: 0.1117 },
  '2': { cx: 0.6542, cy: 0.1189, cs: 0.1496 },
  '3': { cx: 0.6427, cy: 0.3034, cs: 0.0640 },
  '4': { cx: 0.5360, cy: 0.2523, cs: 0.1047 },
  '5': { cx: 0.4998, cy: 0.0638, cs: 0.1701 },
};

const scene = (i: number) => {
  const key = String(i);
  const m = (sceneMeta as Record<string, { w: number; h: number; ax: number; ay: number; k: number }>)[key];
  const file = SCENE_FILES[i];
  const real = webpSize(file) ?? { w: m.w, h: m.h };
  const fits = real.w === m.w && real.h === m.h;
  const a = fits
    ? { cx: m.ax / m.w, cy: m.ay / m.w, cs: (m.k * CUBE_W) / m.w }
    : (FALLBACK[key] ?? { cx: m.ax / m.w, cy: m.ay / m.w, cs: (m.k * CUBE_W) / m.w });
  if (!fits) {
    console.warn(
      `[company-story] ${file} 는 ${real.w}x${real.h} 인데 meta.json 은 ${m.w}x${m.h} 다 — ` +
      '그림을 meta 크기로 다시 뽑으면 meta 값이 자동으로 쓰인다. 지금은 손으로 맞춰 둔 값을 쓴다.'
    );
  }
  return { file, w: real.w, h: real.h, ...a };
};
/* 모션 레이어. 바탕 그림 위에 같은 크기로 겹쳐 깐다(모두 전체 캔버스다).
   자리값(--ox · --oy)과 움직임은 public/company-story/preview.html 이 정본이고
   그대로 옮겼다.
   ⚠️ 마지막 장면의 떠 있는 도형(5-b0~b3)은 바탕 그림에 없다 — 이 레이어를
      빼면 그래픽 자체가 빈다. 나머지(링 · 그리드 · 공중 연결선 · 업링크)는
      바탕에도 정지 상태로 있어 빠지면 움직임만 없어진다. */
type Layer = { file: string; cls: string; ox: string; oy: string };
const SCENE_LAYERS: Record<number, Layer[]> = {
  3: [
    { file: '3-grid.webp', cls: 'ov-grid', ox: '50.00%', oy: '35.29%' },
    { file: '3-up0.webp', cls: 'ov-up0', ox: '46.34%', oy: '35.14%' },
    { file: '3-up1.webp', cls: 'ov-up1', ox: '43.52%', oy: '33.04%' },
    { file: '3-up2.webp', cls: 'ov-up2', ox: '35.54%', oy: '33.14%' },
  ],
  4: [
    { file: '4-arc.webp', cls: 'ov-arc', ox: '48.95%', oy: '39.15%' },
    { file: '4-up0.webp', cls: 'ov-up0', ox: '47.59%', oy: '17.59%' },
    { file: '4-up1.webp', cls: 'ov-up1', ox: '67.61%', oy: '1.91%' },
    { file: '4-up2.webp', cls: 'ov-up2', ox: '34.95%', oy: '17.55%' },
  ],
  /* 링은 r0 한 장만 쓴다 — 한 겹이 안쪽에서 바깥 링 너머까지 퍼진다.
     5-r1 · 5-r2 는 쓰지 않는다. */
  5: [
    { file: '5-r0.webp', cls: 'ov-r0', ox: '49.97%', oy: '57.64%' },
    { file: '5-b0.webp', cls: 'ov-b0', ox: '69.97%', oy: '16.85%' },
    { file: '5-b1.webp', cls: 'ov-b1', ox: '31.39%', oy: '9.96%' },
    { file: '5-b2.webp', cls: 'ov-b2', ox: '29.96%', oy: '48.98%' },
    { file: '5-b3.webp', cls: 'ov-b3', ox: '68.58%', oy: '55.53%' },
  ],
};
const layersOf = (i: number) => SCENE_LAYERS[i] ?? [];

/* 수치를 숫자 덩이와 나머지로 쪼갠다 — '30년+' -> '' · '30' · '년+'.
   나머지(단위 · 기호)는 숫자보다 작게 둔다. 숫자 덩이는 올라가는 모션이
   글자를 바꿔 끼우는 자리이기도 하다(.cmp-stat-count). */
const statParts = (num: string) => {
  const m = /(\d[\d,]*)/.exec(num);
  if (!m) return { before: num, digits: '', after: '' };
  return {
    before: num.slice(0, m.index),
    digits: m[1],
    after: num.slice(m.index + m[1].length),
  };
};

/* 그려지는 폭. 초안(preview.html)이 1425px 페이지에 놓은 폭을 가장 넓은 줄에
   대한 비율로 옮긴 값이다 — 806 / 802 / 860 / 860 / 707 이므로 860 이 기준이다.
   장면마다 원근이 달라 폭을 따로 쥔다. 바깥 끝은 어차피 띠 끝에 붙으므로
   폭이 달라도 줄마다 바깥선은 한 자리에 선다.
   ⚠️ 기준이 802 에서 860 으로 바뀌었다 — 초안에서 3 · 4 번 장면이 커졌기
      때문이다. 가장 넓은 장면이 칸을 꽉 채우고 나머지는 초안의 비례 그대로
      줄어든다. 2 번은 1 -> 0.9326 으로 한 단 작아진다. */
const SCENE_REL: Record<number, number> = { 1: 0.937, 2: 0.933, 3: 1, 4: 1, 5: 0.822 };

const SCENES = { hero: scene(0), rows: [scene(1), scene(2), scene(3), scene(4), scene(5)] };
const sceneVars = (sc: { w: number; h: number; cx: number; cy: number; cs: number }, rel?: number) =>
  `--cx:${sc.cx.toFixed(4)};--cyh:${((sc.cy * sc.w) / sc.h).toFixed(4)};--cs:${sc.cs.toFixed(4)}` +
  (rel ? `;--rel:${rel}` : '');

// ⚠️ 회사 세부 사실(설립연도·조직 규모·수상 등)은 실제 정보로 확인·보완 필요.
const T = {
  ko: {
    title: '회사 소개 ⁠· 현장을 아는 팀이 만든 산업 AI | Refinery',
    description: 'Refinery는 (주)베텍이 30년 넘게 산업 현장에서 쌓은 경험을 토대로 만들었습니다. 개발자와 현장 엔지니어가 한 팀이 되어, 기존 시스템 위에 얹거나 없으면 새로 구축해 하나의 통합 지능으로 잇습니다.',
    canonical: '/company',
    jsonLdName: '회사 소개 | Refinery',
    /* 한 줄로 둔다. 1440px 에서 613px 짜리 한 줄이다 — 폭이 좁아지면 글자가
       함께 줄어들어(clamp 36~60px) 390px 까지 한 줄을 지킨다. */
    h1: '<span class="cmp-title-l1">From the</span><span class="cmp-title-l2">floor <span class="cmp-title-accent">up</span></span>',
    storyTitle: '현장 바닥에서부터<br>올라온 산업 AI',
    storyLede: '리파이너리는 (주)베텍이 30년 넘게 산업 현장에서 쌓아 온 경험으로 만들었습니다. 개발자도 여러 산업의 현장을 직접 겪으며, 현장의 언어로 문제를 정의하고 풉니다.',
    /* '(주)베텍' 자리에 로고를 넣는다 — 글자 높이에 맞춰 밑선에 앉는다.
       alt 가 'VETEC' 이라 읽어 주는 문장은 '30년 현장의 VETEC이 만든 제품' 이다. */
    storySig: '30년 현장의 <img class="cmp-sig-logo" src="/logo_VETEC.svg" alt="VETEC" width="217" height="57">이 만든 제품',
    stats: [
      // ⚠️ 수치에는 한글을 두지 않는다. Roboto 에 한글 글리프가 없어 '년' 을
      //    넣으면 Pretendard 가 받아 한 수치 안에서 글꼴이 갈린다. 단위는 라벨이 쥔다.
      { num: '30+', label: '산업 현장에서 쌓은 <span class="cmp-stat-hl">경험 연수</span>', icon: 'stat-experience' },
      { num: '100+', label: '데이터를 다룬 <span class="cmp-stat-hl">현장 수</span>', icon: 'stat-sites' },
      { num: '20+', label: '철강 ⁠· 반도체 ⁠· 식품 등 <span class="cmp-stat-hl">산업군 수</span>', icon: 'stat-industries' },
    ],
    principlesTitle: '일하는 세 가지 기준',
    principlesSub: '현장에서 확인한 것만 제품에 넣습니다.',
    outro: '현장의 문제를<br>리파이너리 팀과 함께 풀어보세요.',
    outroCta: '문의하기', contactHref: '/contact',
    principles: [
      { title: '현장에서 나온 문제', description: '이론에서 시작하지 않습니다.<br>멈춘 설비 앞에서 시작합니다.' },
      { title: '얹거나, 새로 세우거나', description: '쓰던 시스템을 걷어내지 않습니다.<br>그 위에 얹거나, 없으면 세웁니다.' },
      { title: '숫자에 붙는 맥락', description: '숫자만 보여주지 않습니다.<br>판단까지 잇습니다.' },
    ],
  },
  en: {
    title: 'About ⁠· Industrial AI built by people who know the field | Refinery',
    description: 'Refinery is built on more than 30 years of VETEC’s experience on industrial sites. Software engineers and field engineers work as one team, layering onto existing systems or building from scratch where none exist.',
    canonical: '/en/company',
    jsonLdName: 'About | Refinery',
    h1: 'Hello, we’re Refinery',
    storyTitle: 'Industrial AI,<br>from the floor up.',
    storyLede: '<span translate="no">Refinery</span> is built on more than 30 years of experience VETEC gathered on industrial sites. Our developers have worked across many industrial sites, and we define and solve problems in the language of the site.',
    storySig: 'A product built by VETEC, 30 years in the field',
    stats: [
      { num: '30+ years', label: 'on industrial <span class="cmp-stat-hl">sites</span>', icon: 'stat-experience' },
      { num: '100+', label: '<span class="cmp-stat-hl">sites</span> where we handled data', icon: 'stat-sites' },
      { num: '20+', label: '<span class="cmp-stat-hl">industries</span>, from steel to food', icon: 'stat-industries' },
    ],
    principlesTitle: 'Three standards we work by',
    principlesSub: 'Only what we have confirmed on site goes into the product.',
    outro: 'Solve what your field faces<br>with the <span translate="no">Refinery</span> team.',
    outroCta: 'Contact', contactHref: '/en/contact',
    principles: [
      { title: 'Problems from the field', description: 'We do not start from theory.<br>We start at the machine that stopped.' },
      { title: 'Layer on, or build new', description: 'We do not tear out what you already run.<br>We layer on top, or build from scratch.' },
      { title: 'Context in the numbers', description: 'We do not stop at showing numbers.<br>We carry them through to a decision.' },
    ],
  },
}[lang];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: T.jsonLdName,
  url: `${SITE}${T.canonical}`,
  publisher: {
    '@type': 'Organization',
    name: 'Refinery',
    url: `${SITE}/`,
    logo: `${SITE}/logo_Refinery_symbol.svg`,
  },
};

// ko/en 양쪽이 모두 존재하는 페이지라 hreflang을 출력한다.
const alternates = [
  { lang: 'ko', href: '/company' },
  { lang: 'en', href: '/en/company' },
];
---

<BaseLayout
  title={T.title}
  description={T.description}
  canonical={T.canonical}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <Nav />
  <main class="ind cmp-page">
    <!-- HERO -->
    {/* 히어로 구성·값은 메인 랜딩(#hero)과 같다 — 흰 바탕에 큰 제목과
        소제목만 둔다. 태그라인·배경 이미지는 두지 않는다. */}
    <section class="ind-hero cmp-hero">
      <div class="ind-container">
        {/* 대제목 한 덩어리만 둔다 — 소제목은 걷고, 그 문구는 무대 첫 글로 내렸다. */}
        <div class="cmp-hero-row">
          <h1 set:html={T.h1}></h1>
        </div>
        {/* 제목 아래 플랜트 현장 — 무대로 이어지는 첫 장면이다. 큐브가 여기서 출발한다. */}
        <div class="cmp-scene cmp-scene-hero" style={sceneVars(SCENES.hero)} aria-hidden="true">
          <img class="cmp-scene-art" src={`/company-story/${SCENES.hero.file}`} alt=""
               width={SCENES.hero.w} height={SCENES.hero.h} decoding="async" />
          <img class="cmp-scene-cube" src="/company-story/cube.webp" alt=""
               width="350" height="385" decoding="async" />
        </div>
      </div>
    </section>

    {/* STAGE — 가운데 칸에 줄마다 제 장면이 서고, 글이 좌 · 우로 번갈아 떠오른다.
        그림 순서는 DOM 순서이기도 하다(큐브가 이 순서로 옮겨 다닌다). */}
    <section class="cmp-stage">
      <div class="ind-container cmp-stage-grid">
        <div class="cmp-scene cmp-scene-r" data-row="1" style={sceneVars(SCENES.rows[0], SCENE_REL[1])} aria-hidden="true">
          <img class="cmp-scene-art" src={`/company-story/${SCENES.rows[0].file}`} alt=""
               width={SCENES.rows[0].w} height={SCENES.rows[0].h} loading="lazy" decoding="async" />
          <img class="cmp-scene-cube" src="/company-story/cube.webp" alt=""
               width="350" height="385" loading="lazy" decoding="async" />
        </div>
        <div class="cmp-stage-item cmp-stage-l" data-row="1">
          <h2 set:html={T.storyTitle}></h2>
          <p class="cmp-story-lede" set:html={T.storyLede}></p>
        </div>

        {T.stats.map((st, i) => (
          <>
            <div class={`cmp-scene ${i % 2 === 0 ? 'cmp-scene-l' : 'cmp-scene-r'}`} data-row={i + 2} style={sceneVars(SCENES.rows[i + 1], SCENE_REL[i + 2])} aria-hidden="true">
              <img class="cmp-scene-art" src={`/company-story/${SCENES.rows[i + 1].file}`} alt=""
                   width={SCENES.rows[i + 1].w} height={SCENES.rows[i + 1].h} loading="lazy" decoding="async" />
              {layersOf(i + 2).map((l) => (
                <img class={`cmp-ov ${l.cls}`} src={`/company-story/${l.file}`} alt="" loading="lazy" decoding="async"
                     style={`--ox:${l.ox};--oy:${l.oy}`} />
              ))}
              <img class="cmp-scene-cube" src="/company-story/cube.webp" alt=""
                   width="350" height="385" loading="lazy" decoding="async" />
            </div>
            <div class={`cmp-stage-item cmp-stage-stat ${i % 2 === 0 ? 'cmp-stage-r' : 'cmp-stage-l'}`} data-row={i + 2}>
              {/* 줄 높이(56vh)는 바깥 칸이 쥐고, 카드는 제 내용만큼만 선다. */}
              {/* 라벨이 좌측 상단, 수치가 우측 하단이다 — 보이는 순서대로 적는다. */}
              <div class="cmp-stat-card">
                <div class="cmp-stat-label"><span set:html={st.label}></span></div>
                <div class="cmp-stat-num">
                  {statParts(st.num).before && <span class="cmp-stat-rest">{statParts(st.num).before}</span>}
                  <span class="cmp-stat-count">{statParts(st.num).digits}</span>
                  {statParts(st.num).after && <span class="cmp-stat-rest">{statParts(st.num).after}</span>}
                </div>
              </div>
            </div>
          </>
        ))}

        <div class="cmp-scene cmp-scene-l" data-row="5" style={sceneVars(SCENES.rows[4], SCENE_REL[5])} aria-hidden="true">
          <img class="cmp-scene-art" src={`/company-story/${SCENES.rows[4].file}`} alt=""
               width={SCENES.rows[4].w} height={SCENES.rows[4].h} loading="lazy" decoding="async" />
          {layersOf(5).map((l) => (
            <img class={`cmp-ov ${l.cls}`} src={`/company-story/${l.file}`} alt="" loading="lazy" decoding="async"
                 style={`--ox:${l.ox};--oy:${l.oy}`} />
          ))}
          <img class="cmp-scene-cube" src="/company-story/cube.webp" alt=""
               width="350" height="385" loading="lazy" decoding="async" />
        </div>
        <p class="cmp-stage-item cmp-stage-r cmp-story-sig" data-row="5">
          {/* ⚠️ 한 겹 감싼다. 바깥 .cmp-stage-item 이 flex 라, 문장을 바로 넣으면
              가운데 로고 <img> 가 flex 아이템이 되어 display 가 block 으로 바뀐다
              (글자 사이에 끼지 못하고 제 줄을 차지한다). */}
          <span set:html={T.storySig}></span>
        </p>
      </div>
    </section>

    <!-- PRINCIPLES -->
    <section class="ind-section">
      <div class="ind-container">
        {/* 머리는 메인 솔루션 섹션(#industries)처럼 가운데에 크게 세운다.
            줄을 span 으로 감싼다 — 먹이 차오르는 처리는 줄 단위로 건다. */}
        <header class="ind-head cmp-head-row cmp-head-big">
          <h2 class="cmp-fill-title"><span class="cmp-fill-line">{T.principlesTitle}</span></h2>
          <p>{T.principlesSub}</p>
        </header>
        {/* 랜딩 솔루션 섹션(#industries)의 .industries-grid / .industry-card 규격을 그대로 따른다.
            3열 · gap 18 · 900px에서 2열 · 600px에서 1열. */}
        {/* cmp-spread — 처음에는 가운데로 뭉쳐 있다가 스크롤하면 제자리로 펼쳐진다. */}
        <ol class="cmp-rule cmp-spread">
          {T.principles.map((p, i) => (
            <li class="cmp-rule-card rf-ic-host">
              <span class="cmp-rule-num">{i + 1}</span>
              {/* 이 카드만 밝은 면(--bg-soft)이라 light 세트를 쓴다. */}
              <RfIcon name={RULE_ICONS[i]} theme="light" class="cmp-rule-icon" />
              <h3>{p.title}</h3>
              <p set:html={p.description}></p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* 푸터 위 맺음 띠 — 바닥에서 올라오는 원형 빛 위에 맺는 말 한 줄을 둔다.
        큰 CTA 판은 두지 않는다 — 회사 이야기를 조용히 닫는 자리다. */}
    <section class="cmp-glow-band">
      <div class="ind-container cmp-outro">
        <p class="cmp-outro-title" set:html={T.outro}></p>
        <a class="btn-primary cmp-outro-cta" href={T.contactHref}>{T.outroCta}</a>
      </div>
    </section>

    {/* 장면 사이를 옮겨 다니는 큐브. 각 그림에는 큐브가 빠져 있고 이 하나가 끼워진다.
        동작 줄이기에서는 이쪽을 숨기고 그림마다 박힌 .cmp-scene-cube 가 대신 선다. */}
    <img class="cmp-cube" src="/company-story/cube.webp" alt="" aria-hidden="true"
         width="350" height="385" decoding="async" />
  </main>
  <Footer />

  <script is:inline>
    // 제목에 먹이 차오른다 — 줄이 화면을 올라오는 만큼 왼쪽부터 채운다.
    // 메인 솔루션 섹션과 같은 처리지만, 그쪽은 핀 구간 진행도를 쓰고 여기는
    // 줄의 화면 위치만 본다(붙는 구간이 없다).
    (function () {
      var lines = document.querySelectorAll('.cmp-fill-line');
      if (!lines.length) return;
      // 동작 줄이기에서는 CSS 가 100% 로 세워 둔다 — 손대지 않는다.
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var ticking = false;
      function upd() {
        ticking = false;
        var vh = window.innerHeight || 800;
        for (var i = 0; i < lines.length; i++) {
          var r = lines[i].getBoundingClientRect();
          // 화면 아래 85% 에 닿을 때 차기 시작해 45% 에서 다 찬다.
          var p = (vh * 0.85 - r.top) / (vh * 0.40) - i * 0.15;
          p = p < 0 ? 0 : (p > 1 ? 1 : p);
          lines[i].style.setProperty('--sol-fill', (p * 100).toFixed(1) + '%');
        }
      }
      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(upd);
      }
      addEventListener('scroll', onScroll, { passive: true });
      addEventListener('resize', onScroll);
      upd();
    })();

    // 무대 — 글과 그림이 화면에 들어오면 떠오른다. 한 번 뜨면 그대로 둔다.
    (function () {
      // 히어로 그림(.cmp-scene-hero)은 첫 화면에 이미 서 있으므로 뺀다.
      var items = document.querySelectorAll('.cmp-stage-item, .cmp-stage .cmp-scene');
      if (!items.length) return;
      if (!('IntersectionObserver' in window) ||
          matchMedia('(prefers-reduced-motion: reduce)').matches) {
        items.forEach(function (el) { el.classList.add('is-in'); });
        return;
      }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          e.target.classList.add('is-in');
          io.unobserve(e.target);
          // 뜨는 순간을 알린다 — 수치 모션이 이 신호에 맞춰 같이 시작한다.
          e.target.dispatchEvent(new CustomEvent('cmp:in'));
        });
      }, { rootMargin: '0px 0px -25% 0px', threshold: 0.2 });
      items.forEach(function (el) { io.observe(el); });
    })();

    // 카드 줄 — 화면에 들어오면 한 번에 펼쳐진다.
    // 스크롤 진행에 묶어 두면 줄이 화면에 머무는 내내 세 장이 서로 걸친
    // 중간 자세로 서 있다(바깥 카드는 갈 거리의 94%를 가야 이웃과 떨어진다).
    // 들어온 순간 한 번만 재생하면 그 중간 자세가 0.75초만 스친다.
    (function () {
      var wrap = document.querySelector('.cmp-spread');
      if (!wrap) return;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      // 세로로 쌓이는 폭에서는 CSS 가 transform 을 끈다 — 여기서도 건드리지 않는다.
      if (matchMedia('(max-width: 900px)').matches) return;
      // ⚠️ 모으는 건 스크립트가 도는 순간부터다. 스크립트가 막히면 --spread 가
      //    없어 1 로 읽혀 처음부터 펼쳐진 모습이 된다 — 내용이 가려지지 않는다.
      wrap.style.setProperty('--spread', '0');
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          wrap.classList.add('cmp-spread-go');
          // 전이가 걸린 뒤에 값을 바꿔야 한다 — 같은 프레임에 둘을 같이 주면
          // 브라우저가 처음 값으로 치고 전이가 생략된다.
          requestAnimationFrame(function () {
            wrap.style.setProperty('--spread', '1');
          });
          io.disconnect();
        });
      }, { rootMargin: '0px 0px -18% 0px', threshold: 0.15 });
      io.observe(wrap);
    })();

    // 수치 — 카드가 뜨는 순간 0 에서 제 값까지 조용히 올라간다.
    // ⚠️ 자릿수가 변하면 글자 폭도 변해 칸이 흔들린다(100+ 는 1 -> 3 자리).
    //    요동치기 전에 끝 모습의 폭을 재서 min-width 로 못 박는다.
    // ⚠️ '30년+' 처럼 숫자 앞뒤에 글자가 붙는다 — 첫 숫자 덩이만 바꾼다.
    (function () {
      var nums = [].slice.call(document.querySelectorAll('.cmp-stat-num'));
      if (!nums.length) return;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if (!('IntersectionObserver' in window)) return;

      var items = [];
      nums.forEach(function (el) {
        // 숫자 덩이는 마크업이 이미 .cmp-stat-count 로 싸 두었다.
        var span = el.querySelector('.cmp-stat-count');
        if (!span) return;
        var target = parseInt(span.textContent.replace(/,/g, ''), 10);
        if (!(target > 0)) return;
        // 끝 모습 그대로일 때의 폭을 먼저 잰다.
        el.style.minWidth = Math.ceil(el.getBoundingClientRect().width) + 'px';
        items.push({ el: el, span: span, target: target, done: false });
      });
      if (!items.length) return;

      /* ⚠️ 한때 값을 무작위로 흔들다 찍히게 했는데 번잡했다 — 숫자가 오르내려
            눈이 따라가다 지친다. 한 방향으로만 올라가고 끝에서 천천히 선다. */
      var DUR = 1100;
      function run(it) {
        var t0 = 0;
        function step(now) {
          if (!t0) t0 = now;
          var p = Math.min(1, (now - t0) / DUR);
          var e = 1 - Math.pow(1 - p, 3);   /* 처음이 빠르고 끝이 느리다 */
          it.span.textContent = String(Math.round(it.target * e));
          if (p < 1) requestAnimationFrame(step);
          else it.span.textContent = String(it.target);
        }
        requestAnimationFrame(step);
      }
      /* 시작 신호는 따로 보지 않는다 — 카드가 뜨는 그 순간에 올라탄다.
         한때 제 관찰자를 따로 뒀는데(-20% · 0.4) 등장 관찰자(-25% · 0.2)와
         기준이 달라 숫자가 카드보다 늦게 올라갔다. */
      items.forEach(function (it) {
        var host = it.el.closest('.cmp-stage-item');
        if (!host) return;
        function go() { if (it.done) return; it.done = true; run(it); }
        // 이미 떠 있으면(동작 줄이기 · IO 없음) 바로 돌린다.
        if (host.classList.contains('is-in')) go();
        else host.addEventListener('cmp:in', go, { once: true });
      });
    })();

    // 큐브 — 장면과 장면 사이를 포물선으로 날아가 다음 자리에 사뿐히 내려앉는다.
    // 끼울 자리는 그림마다 --cx · --cyh · --cs 로 박혀 있다(모두 그림 크기에 대한 비율).
    // 읽는 줄(화면 55%)이 목표 자리를 정하고, 큐브는 그 목표를 관성으로 따라간다.
    // ⚠️ 스크롤 때만 그리면 관성이 살지 않는다 — requestAnimationFrame 으로 계속 그린다.
    (function () {
      var page = document.querySelector('.cmp-page');
      var cube = document.querySelector('.cmp-cube');
      var scenes = [].slice.call(document.querySelectorAll('.cmp-scene'));
      if (!page || !cube || scenes.length < 2) return;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      // 비율은 인라인 style 에 박힌 고정값이다 — 한 번만 읽어 둔다.
      var F = scenes.map(function (el) {
        var cs = getComputedStyle(el);
        return {
          el: el,
          x: parseFloat(cs.getPropertyValue('--cx')) || 0,
          y: parseFloat(cs.getPropertyValue('--cyh')) || 0,
          s: parseFloat(cs.getPropertyValue('--cs')) || 0.1
        };
      });
      var ease = function (t) { return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2; };
      var cur = null, lit = false;

      function target(A, mid) {
        var x = A[0].x, y = A[0].y, s = A[0].s, r = 0, q = 1;
        for (var i = 0; i < A.length - 1; i++) {
          var a = A[i], b = A[i + 1], span = b.y - a.y;
          // 앞 15% 는 제자리에 머물고, 남은 구간 동안 건너간다.
          var t0 = a.y + span * 0.15, t1 = b.y - span * 0.05;
          if (mid <= t0) break;
          var t = Math.min(1, (mid - t0) / Math.max(1, t1 - t0)), e = ease(t);
          x = a.x + (b.x - a.x) * e;
          y = a.y + (b.y - a.y) * e - Math.sin(Math.PI * e) * Math.min(span * 0.12, 90);
          s = a.s + (b.s - a.s) * e;
          r = Math.sin(Math.PI * e) * (i % 2 ? -70 : 70) * (1 - e * 0.2);
          // 착지 순간 살짝 눌린다 — 마지막 10% 구간에서만 q 가 1 아래로 내려간다.
          q = t > 0.9 ? 1 - Math.sin((t - 0.9) / 0.1 * Math.PI) * 0.08 : 1;
          if (t < 1) break;
        }
        return { x: x, y: y, s: s, r: r, q: q };
      }

      function frame() {
        var pr = page.getBoundingClientRect();
        var A = F.map(function (f) {
          var r = f.el.getBoundingClientRect();
          return { x: r.left - pr.left + f.x * r.width,
                   y: r.top - pr.top + f.y * r.height,
                   s: f.s * r.width };
        });
        var T = target(A, (window.innerHeight || 800) * 0.55 - pr.top);
        // 첫 프레임은 목표 자리에서 시작한다 — 관성으로 끌려오는 모습을 보이지 않는다.
        if (!cur) cur = { x: T.x, y: T.y, s: T.s, r: T.r, q: T.q };
        var k = 0.14;
        cur.x += (T.x - cur.x) * k; cur.y += (T.y - cur.y) * k;
        cur.s += (T.s - cur.s) * k; cur.r += (T.r - cur.r) * k;
        cur.q += (T.q - cur.q) * k;
        var s = cur.s;
        cube.style.width = s.toFixed(1) + 'px';
        cube.style.transformOrigin = '50% 90%';
        cube.style.transform =
          'translate(' + (cur.x - s / 2).toFixed(1) + 'px,' + (cur.y - s * 0.54).toFixed(1) + 'px)' +
          ' rotate(' + cur.r.toFixed(2) + 'deg)' +
          ' scale(' + (1 + (1 - cur.q) * 0.6).toFixed(4) + ',' + cur.q.toFixed(4) + ')';
        // 첫 장면(히어로 그림)은 늘 떠 있으므로 큐브도 바로 켠다.
        if (!lit) { lit = true; cube.classList.add('is-on'); }
        requestAnimationFrame(frame);
      }
      requestAnimationFrame(frame);
    })();
  </script>
</BaseLayout>

<style>
  /* ⚠️ 페이지 전체에 keep-all을 건다. 개별 규칙으로 붙이다 보니 히어로 소제목
     (.ind-lede)·섹션 소제목처럼 빠진 곳이 남아, 320~480px에서 '만/들었습니다.'
     '현/장에서'처럼 어절 한가운데가 끊겼다. overflow-wrap: break-word는
     한 어절이 줄보다 길 때만 쓰이는 안전장치다. */
  /* 큐브가 이 상자의 좌표로 움직인다 — 기준을 여기서 못 박는다. */
  .cmp-page { position: relative; }
  .cmp-page, .cmp-page * { word-break: keep-all; overflow-wrap: break-word; }

  /* 본문 좌우를 헤더(.nav-inner)와 같은 선에 맞춘다 — 로고 왼쪽 = 문의하기 버튼 오른쪽.
     공통 .ind-container는 1120/24라 내용이 헤더보다 49px 안쪽에서 시작했다.
     플랫폼 개요(.wr-page)·예지보전 등이 쓰는 값(1280/48)과 같다.
     .cmp-page 스코프라 .ind-container를 쓰는 다른 페이지에는 영향이 없다. */
  .cmp-page .ind-container { max-width: 1600px; padding: 0 48px; }
  /* 무대만 띠를 좁힌다 — 그림 바깥 끝이 이 띠 끝에 붙으므로, 띠가 헤더 내용
     너비와 같으면 그림이 화면 끝까지 닿아 보인다.
     값은 메인 히어로의 기본 모습(--hero-p = 0)에서 카피가 서는 띠와 같다 —
     저쪽 max-width 가 calc(1600 - 48*2 - 200) = 1304px 이고, 1440px 화면에서
     68 ~ 1372 에 선다. 여기서는 패딩 48 을 그대로 쓰므로 1400 이 같은 값이다.
     ⚠️ 저쪽은 스크롤하면 그래픽이 자라며 띠가 바뀐다. 맞추는 건 기본 모습뿐이다. */
  .cmp-page .cmp-stage .ind-container { max-width: 1400px; }
  @media (max-width: 900px) {
    .cmp-page .ind-container { padding: 0 24px; }
  }

  /* ───────── 히어로 — 메인 랜딩(#hero)과 같은 값 ─────────
     흰 바탕에 큰 제목과 소제목만 둔다. 랜딩은 아래에 데모 화면이 붙어
     min-height: 100vh를 쓰지만, 여기는 글만 있어 그 값은 가져오지 않는다
     (빈 자리가 화면 하나만큼 생긴다). */
  .cmp-hero {
    /* 위 244px — 산업별(솔루션) 히어로와 대제목 글자 윗변이 같은 자리에 오도록
       맞춘 값이다. 저쪽은 섹션 위 180px 에 태그라인과 그 아래 여백이 더해져
       대제목 글자가 254px 에서 시작하는데, 이 페이지는 태그라인이 없어 200px
       이면 210px 에서 시작했다.
       ⚠️ 900px 이하도 같은 식으로 맞춘다(저쪽 216px · 여기 140px -> 208px).
       ⚠️ 그래픽이 화면 아래로 잘리는 건 받아들인 결과다 — 화면 높이에 맞춰
          줄이지 않는다. '처음부터 함께 보인다'는 건 스크롤 없이 그림이
          시작된다는 뜻이지, 그림이 통째로 들어온다는 뜻이 아니다. */
    padding: 244px 0 100px;
    background: none; border-bottom: none;
  }
  /* 'up' 에만 브랜드 빛을 둔다 — 메인 히어로의 .hero-title-accent 와 같은 처리다.
     발밑 바깥에서 올라오는 작은 원이라 글자 윗부분은 제 색 그대로이고 아래쪽만
     브랜드색으로 번진다. 가장 바깥 색(#16202C)이 대제목 색과 같아 경계가 없다.
     ⚠️ 순서를 지킨다 — background 단축 속성이 background-clip 을 초기화하므로
        clip 은 반드시 background 뒤에 온다.
     ⚠️ 반지름은 em 이다. 대제목이 clamp 로 36~60px 을 오가므로 px 로 두면 좁은
        화면에서 빛이 글자를 통째로 덮는다.
     ⚠️ line-height 1 로 상자를 글자에 맞추고 아래로 0.25em 을 더한다. 그냥 1 만
        두면 상자가 글자 높이에 딱 맞아 받침 아래가 잘린다(background-clip:text 는
        상자 안에서만 칠한다). 0.25em 이면 대제목 줄 높이(1.25)와 같아진다.
     ⚠️ 가로 중심 50% — 메인은 여섯 글자짜리 낱말이라 60% 였지만 여기는 두 글자라
        가운데가 맞다. 세로 82% 는 메인과 같은 값이다.
     ⚠️ 빛은 'floor' 가 아니라 'up' 에 둔다. 문장이 말하는 것은 바닥이 아니라
        거기서 '올라온' 쪽이고, 마지막 낱말에 빛이 맺혀야 문장이 거기서 닫힌다. */
  /* 영문 줄만 크게 둔다 — 국문 줄(clamp 36~60)의 1.67배다.
     ⚠️ :global — 대제목은 set:html 로 넣어 Astro 스코프 속성이 붙지 않는다.
     ⚠️ line-height 1.1 — h1 의 1.25 를 그대로 받으면 큰 글자만큼 줄 사이가
        벌어져 두 줄이 따로 놀았다.
     ⚠️ 빛의 반지름은 em 이라 글자가 커지면 같이 커진다. 따로 손댈 것이 없다. */
  .cmp-hero h1 :global(.cmp-title-l1),
  .cmp-hero h1 :global(.cmp-title-l2) {
    font-size: clamp(52px, 8vw, 100px);
    line-height: 1.1;
  }
  .cmp-hero h1 :global(.cmp-title-l1) { grid-row: 1; }
  /* ⚠️ 미는 값은 em 이다 — 글자가 clamp 로 52~100px 을 오가므로 px 로 두면
     좁은 화면에서 어긋남이 과해진다. */
  .cmp-hero h1 :global(.cmp-title-l2) { grid-row: 2; margin-left: 2.2em; }
  /* 국문은 'floor up' 오른쪽에 작게 두 줄로 선다. 두 덩이를 inline-block 으로
     두 칸 격자로 두고 아랫변을 맞춘다(align-items: end).
     ⚠️ inline-block + vertical-align: baseline 으로 맞추면 줄상자가 두 덩이의
        밑선 아래 여유를 모두 끌어안아 대제목 상자가 35px 길어진다 — 소제목이
        그만큼 밀린다. 격자는 상자 높이가 더 큰 쪽으로만 잡혀 그 일이 없다.
     ⚠️ 아랫변을 맞추면 두 글의 밑선은 조금 어긋난다. 국문 쪽을 margin-bottom
        으로 끌어올려 맞춘다(아래 값).
     ⚠️ :global — 대제목은 set:html 로 넣어 Astro 스코프 속성이 붙지 않는다. */
  /* ⚠️ :global 이다. set:html 로 넣은 글에는 Astro 스코프 속성이 붙지 않아
     .cmp-title-accent 로만 쓰면 규칙이 통째로 빗나간다(RfIcon 과 같은 건이다). */
  .cmp-hero h1 :global(.cmp-title-accent) {
    display: inline-block;
    line-height: 1;
    padding-bottom: 0.25em;
    background: radial-gradient(
      circle 1.2em at 50% 82%,
      #76A6D7 0%,
      #4A7FA8 38%,
      #22303F 72%,
      #16202C 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* 대제목과 소제목을 한 칸에 세로로 쌓고 둘 다 화면 가운데에 세운다.
     ⚠️ 줄 사이 0 — 소제목은 대제목 줄상자가 남기는 여백만큼 아래에서 시작한다.
        실제 간격은 아래 margin-top 이 맞춘다. */
  .cmp-hero-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    row-gap: 0;
  }
  /* width: fit-content 라 justify-self 가 없으면 왼쪽에 붙는다. */
  .cmp-hero .cmp-hero-row h1 { grid-row: 1; justify-self: center; }
  .cmp-hero h1 {
    /* 아래 0 — 솔루션 히어로는 대제목 글자 아랫변에서 소제목 글자 윗변까지가
       19px 이다(1600 · 1440 · 1280 · 1201px 모두). 35px 이면 54px 이 됐다.
       ⚠️ 1100px 이하는 저쪽이 36px 이라 아래에서 22px 을 준다(저쪽은 소제목의
          위 여백 20px + 줄 상자 여유로 그 값이 된다). */
    margin-bottom: 0;
    /* 메인 히어로(#hero h1)와 같은 값이다 — 크기 · 굵기 · 행간 · 자간 · 글꼴 ·
       색까지 한 벌로 맞춘다. 두 페이지의 첫 글이 같은 규격으로 서야 한다.
       ⚠️ 한때 이 자리는 clamp(48,7vw,84) / 500 / Inter 에 좌→우 그라데이션
          글자(배경을 글자에 물리는 방식)였다. 메인 쪽에는 강조 낱말에만
          쓰는 처리라 제목 전체에 걸지 않는다.
       ⚠️ 그라데이션을 걷으면서 그 폴백(@supports not background-clip)도 함께
          지웠다 — 색을 직접 주므로 사라질 일이 없다.
       ⚠️ display: table 도 걷는다. 그라데이션 상자를 글자 폭에 맞추려던 값이라
          쓸 데가 없어졌다. 메인과 같이 width: fit-content 로 둔다. */
    font-size: clamp(36px, 5vw, 60px);
    font-weight: 600;
    /* ⚠️ 값을 직접 적는다. --lh-display · --ls-display 는 global.css 의 랜딩
       :root 에만 있어 이 페이지에서는 비어 있었다 — 행간이 본문값(1.65)으로
       떨어지고 자간이 normal 이 됐다(1440px 에서 줄 99px · 자간 0). */
    line-height: 1.25;
    letter-spacing: -0.03em;
    font-family: 'Roboto', 'Pretendard', sans-serif;
    color: #16202C;
    padding: 0.1em 0;
    width: fit-content;
    /* 두 줄을 어긋나게 둔다 — 첫 줄은 왼쪽 끝, 둘째 줄은 2.2em 오른쪽으로
       물러난다. 덩이 폭은 둘째 줄 끝까지로 잡히고, 그 덩이가 통째로 화면
       가운데에 선다. */
    display: grid; grid-template-columns: auto;
    justify-content: center; justify-items: start; row-gap: 0;
    text-align: left;
    word-break: keep-all;
    overflow-wrap: break-word;
  }
  @media (max-width: 900px) {
    .cmp-hero { padding: 208px 0 72px; }
  }


  /* ───────── 섹션 여백·제목 — /why-refinery(플랫폼 개요)와 같은 값 ─────────
     공통값은 섹션 84px · 대제목 clamp(26,3.4vw,38)/650/-0.02em/1.25 ·
     소제목 16px이라, 같은 자리에서 한 단계씩 작았다. */
  /* 섹션 사이 구분선을 걷는다 — 공통 .ind-section 이 아래 테두리를 긋는데,
     이 페이지는 면 색이 모두 흰색이라 선만 남아 칸막이처럼 보인다.
     ⚠️ 마지막 섹션의 아래 선은 그대로 둔다 — 그 선이 곧 푸터 위 선이다. */
  .cmp-page .ind-section { padding: 180px 0; border-bottom: none; }
  /* ⚠️ 푸터 위 선은 아래 .cmp-glow-band 가 들고 있다 — 그 띠가 마지막이다.
     여기에 두면 선이 띠 위에 그어져 페이지 한가운데에 금이 간다. */

  /* 푸터 위 맺음 띠 — 유즈케이스 02 섹션(.uc-redesigned .ind-soft)과 같은 빛이되
     자리를 아래(50% 100%)로 뒤집었다. 저쪽은 위(50% 0%)에서 아래로 흐른다.
     정지점 열셋은 저쪽에서 그대로 가져온 것이다 — smootherstep 으로 뽑아
     두 점짜리 그라데이션에서 보이던 테가 없다. */
  .cmp-glow-band {
    /* 띠가 짧으면 빛도 같이 작아진다 — 유즈케이스 쪽은 섹션이 700px 넘어
       세로 반지름이 350px 쯤이었다. 여기서는 띠를 키우고 세로 반지름을
       띠 높이만큼(100%) 줘, 빛이 띠 윗변에서 0 이 되게 한다. */
    /* 위아래 110px — 솔루션(산업별) · 과제별 CTA 섹션(.ind-cta-bg)과 같은 값이다.
       560px 이하에서 60px 으로 줄이는 것도 저쪽과 같다. */
    display: flex; align-items: center;
    padding: 110px 0;
    border-bottom: 1px solid var(--border);
    background: #FFFFFF radial-gradient(62% 100% at 50% 100%,
      rgba(238, 244, 251, 1) 0%,
      rgba(238, 244, 251, 0.995) 8.33%,
      rgba(238, 244, 251, 0.965) 16.67%,
      rgba(238, 244, 251, 0.896) 25%,
      rgba(238, 244, 251, 0.79) 33.33%,
      rgba(238, 244, 251, 0.653) 41.67%,
      rgba(238, 244, 251, 0.5) 50%,
      rgba(238, 244, 251, 0.347) 58.33%,
      rgba(238, 244, 251, 0.21) 66.67%,
      rgba(238, 244, 251, 0.104) 75%,
      rgba(238, 244, 251, 0.035) 83.33%,
      rgba(238, 244, 251, 0.005) 91.67%,
      rgba(238, 244, 251, 0) 100%);
  }
  @media (max-width: 900px) {
    .cmp-page .ind-section { padding: 60px 0; }
  }
  .cmp-page .ind-head { margin-bottom: 64px; }
  .cmp-page .ind-head h2 {
    font-size: clamp(28px, 4vw, 45px); font-weight: 600;
    letter-spacing: -0.8px; line-height: 1.3;
  }
  .cmp-page .ind-head h2 { text-wrap: balance; }
  .cmp-page .ind-head p { text-wrap: pretty; }
  /* 섹션 소제목은 랜딩 .section-header p(18px / 1.7)에 맞춘다 —
     이 페이지 히어로 소제목도 같은 값이라, 16px로 두면 한 페이지 안에서
     두 크기가 섞인다. */
  .cmp-page .ind-head p { font-size: 18px; line-height: 1.7; }
  /* 랜딩 .section-header-row와 같은 값 — 대제목 왼쪽, 소제목 오른쪽 아래 정렬.
     랜딩은 섹션마다 소제목 max-width가 360~680px로 다른데, 기본값 360px을 쓴다. */
  /* ⚠️ max-width: none 필수. industry.css의 .ind-head가 640px로 묶고 있어
     그대로 두면 flex-wrap 때문에 소제목이 아래로 내려간다(랜딩은 1184px 전체). */
  /* 뿌리 섹션 머리 — 메인 솔루션 섹션(#industries .section-header-row)과 같다.
     대제목을 한 단 키우고(45 -> 60px) 소제목을 오른쪽이 아니라 아래에 둔 뒤
     둘 다 가운데에 세운다. 60px 제목 옆에 18px 글이 서면 줄 끝이 서로 멀어
     한 덩어리로 읽히지 않는다는 게 저쪽에 적힌 까닭이다.
     ⚠️ 5.6vw 는 1071px 에서 60px 에 닿는다 — 그 아래로는 폭을 따라 줄어든다. */
  .cmp-page .cmp-head-big {
    flex-direction: column; align-items: center; gap: 16px; text-align: center;
  }
  .cmp-page .cmp-head-big h2 { font-size: clamp(32px, 5.6vw, 60px); }
  .cmp-page .cmp-head-big p { max-width: none; }
  @media (max-width: 900px) {
    .cmp-page .cmp-head-big { display: flex; }
  }
  /* 먹이 차오르는 제목 — 메인 솔루션 섹션(#industries .sol-title .sol-line)과
     같은 방식이다. 띠 하나를 깔고 글자 모양으로만 오려 낸다 —
     왼쪽부터 --sol-fill 까지 먹색, 그 뒤는 아직 안 찬 색(--border)이다.
     ⚠️ 빗금은 쓰지 않는다. 차기 전 글자가 견본지처럼 보여 제목이 미완성으로
        읽혔다. 한 가지 옅은 색으로 두면 글자 모양만 조용히 서 있다.
     ⚠️ background-clip: text 라 글자 자체에는 색이 없다(color: transparent).
        스크립트가 막히면 --sol-fill 이 없어 100% 로 서므로 그냥 먹색 제목이 된다.
     ⚠️ 폭은 글자만큼이다(fit-content). */
  .cmp-fill-title { margin: 0; }
  .cmp-fill-line {
    display: block; width: fit-content; margin-inline: auto;
    background-image:
      linear-gradient(to right,
        #16202C 0 var(--sol-fill, 100%),
        var(--border) var(--sol-fill, 100%) 100%);
    -webkit-background-clip: text;
            background-clip: text;
    color: transparent;
    /* 받침 · 꼬리가 잘리지 않게 칠할 칸을 조금 넓힌다. */
    padding-bottom: .06em;
  }
  @media (prefers-reduced-motion: reduce) {
    .cmp-fill-line { --sol-fill: 100% !important; }
  }
  .cmp-head-row { display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; flex-wrap: wrap; max-width: none; }
  .cmp-head-row h2 { margin-bottom: 0; }
  /* 소제목 칸을 360 -> 565px 으로 올린다. 영문은 두 머리 모두 소제목이 두 줄이었다 —
     'From a team that has been on the floor, and 30 years of experience.' 544px ·
     'Only what we have confirmed on site goes into the product.' 478px.
     가장 긴 544px 에 여유 20px 을 둔 값이다. 제목과 합쳐도 머리 폭 1184px 안에 들어간다
     (527 + 32 + 544 = 1103 · 569 + 32 + 478 = 1079).
     국문은 329 · 272px 이라 360px 에서도 이미 한 줄이었고 변화가 없다. */
  .cmp-head-row p { max-width: 565px; margin: 0; }
  @media (max-width: 900px) {
    .cmp-head-row { display: block; }
    .cmp-head-row p { margin-top: 12px; max-width: none; }
  }
  /* 영문은 소제목이 길어 위 900px 경계보다 한참 위에서 flex-wrap 으로 먼저 내려간다 —
     두 머리가 1180 · 1160px 으로 갈려 그 사이에서 모양이 섞였다(소제목 칸을 565px 으로
     올린 뒤 생긴 일이다). 긴 쪽에 맞춰 1180px 을 공통 경계로 두고 둘을 함께 내린다.
     국문은 소제목이 329 · 272px 이라 900px 까지 버티므로 이 값을 쓰지 않는다.
     (랜딩 .section-header-row 가 쓰는 방식과 같다 — global.css 참고) */
  html[lang="en"] .cmp-head-row { flex-wrap: nowrap; }
  @media (max-width: 1180px) {
    html[lang="en"] .cmp-head-row { display: block; }
    html[lang="en"] .cmp-head-row p { margin-top: 12px; max-width: none; }
  }

  /* ───────── 원칙 카드 ─────────
     랜딩 솔루션 섹션(#industries)과 같은 규격.
     global.css .industries-grid → 4열 · gap 18 · 1500px 3열 · 1280px 2열 · 600px 1열
     (여기 원칙 카드는 셋뿐이라 3열을 그대로 쓴다)
     global.css .industry-card    → #fff · 1px border · radius · padding 30
     레이아웃(3열·gap·카드 박스)만 랜딩을 따르고, 글자 크기는 위 뿌리 아코디언과
     동일하게 맞춘다: 라벨 13 · 제목 28 / 1.3 · 본문 16 / 1.7.
     ⚠️ 카드 본문폭이 323px(아코디언 544px)이라 같은 크기여도 줄 수가 다르다.
        02번 제목 2줄, 01번 본문 4줄이 되는 것은 이 폭 차이 때문이지 오류가 아니다. */
  .cmp-rule {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px;
  }
  .cmp-rule-card {
    /* 카드 면은 --bg-soft 하나로 선다. 섹션 배경이 흰색이라 면만으로 충분히
       떠 보이고, 테두리까지 두르면 선이 한 겹 더 생겨 무거워진다. */
    background: var(--bg-soft); border-radius: var(--radius);
    padding: 30px; position: relative; overflow: hidden;
    transition: background .2s;
    text-align: center;
  }
  .cmp-rule-num {
    display: flex; align-items: center; justify-content: center;
    width: 30px; height: 30px; border-radius: 50%;
    /* 원을 --accent로 채우고 숫자는 흰색. 테두리는 같은 색으로 남겨 두면
       border-box 기준 지름 30px이 그대로 유지된다. */
    background: var(--accent); border: 1px solid var(--accent);
    /* 글꼴은 본문 글꼴을 그대로 물려받는다.
       ⚠️ 양수 자간은 마지막 글자 뒤에도 붙어 원 안에서 글자가 왼쪽으로 치우친다
          (1.2px 일 때 0.6px 밀려 padding-left 로 보정했던 자리다). 숫자 한 글자라
          아래 -0.2px 을 그대로 쓴다. */
    font-size: 15px; font-weight: 600; line-height: 1;
    /* 자간은 -0.2px — 사이트 공통값이다.
       값이 작아 한 글자 뒤에 붙는 여백도 -0.1px 수준이라 되밀 필요가 없다. */
    /* 흰색 유지. #3f76ae를 시도했으나 그 4.71:1은 흰 배경 기준 값이었고,
       실제 바탕인 #76A6D7 위에서는 1.86:1로 흰색(2.56:1)보다 낮았다. */
    color: #ffffff; letter-spacing: -0.2px;
    /* 번호는 흐름에서 빼서 카드 왼쪽 위에 고정한다. 흐름에 두면 이 배지가
       아이콘을 아래로 밀어, '카드 윗선 -> 아이콘' 여백만 48px 더 벌어진다.
       위치값(30px)은 카드 패딩과 같아 보이는 자리는 그대로다. */
    position: absolute; top: 30px; left: 30px; margin: 0;
    /* 글리프를 원 한가운데로 내린다. align-items: center 는 글자 상자를 가운데 두는데,
       숫자 글리프는 그 상자 안에서 baseline 위에 놓여 1.3px 떠 보였다(1·2·3 모두 같은 값).
       border-box 라 padding 을 줘도 원 지름 30px 은 그대로다.
       값은 재서 골랐다 — 0px 에서 -1.27px, 2px 에서 -0.27px, 3px 에서 +0.73px.
       글리프가 정수 픽셀에 스냅돼 1.65~2px 이 같은 자리에 선다. */
    padding-top: 2px;
  }
  /* 대제목 위 아이콘. 카드 안쪽 내용 너비(323px) 기준 가운데 정렬. */
  /* 카드 윗선 -> 아이콘 60px, 아이콘 -> 대제목 40px.
     위쪽은 카드 패딩 30px이 이미 깔려 있으므로 마진은 30px만 더한다. */
  /* ⚠️ :global 필수 — RfIcon 은 set:html 로 넣는 인라인 SVG라 Astro 스코프 속성이 붙지 않는다. */
  /* 이 자리만 160px 이다(다른 둘은 145). 카드가 넓어 160 이 그 안에서 비율을 잡는다.
     크기는 그대로지만 중앙 정렬로 아래 빈칸이 7.6%→12.5% 로 커졌으므로, 처음 모습의
     간격(위 50.6 · 아래 52.2px)을 지키려면 아래 margin 은 40 이 아니라 32 다. */
  :global(.cmp-rule-icon) { display: block; width: 160px; height: 160px; margin: 31px auto 32px; }
  .cmp-rule-card h3 {
    /* 제목 28 / 1.3. 20px일 때의 5px 간격은 28px에서 너무
       붙어 보여, 아코디언의 제목-본문 간격(12px)을 함께 가져온다. */
    margin: 0 0 12px; font-size: 26px; font-weight: 600; line-height: 1.3;
    color: var(--text); word-break: keep-all; text-wrap: balance;
  }
  /* 본문 16 / 1.7. 뿌리 카드에 모바일 축소가 없으므로
     여기서도 폭이 줄어도 크기를 낮추지 않는다. */
  /* keep-all 필수: 없으면 한글이 어절 한가운데서 잘린다(1024px·375px에서 확인). */
  .cmp-rule-card p { margin: 0; font-size: 16px; line-height: 1.7; color: var(--text-muted); text-wrap: pretty; word-break: keep-all; }
  /* ⚠️ 열이 줄어드는 기준이 랜딩(900/600)과 다르다. 랜딩 카드는 제목이 20px인데
     여기는 26px이라 더 일찍 감긴다. 실측으로 카드가 290px 아래로 내려가면
     '얹거나, 새로 세우거나'가 2줄이 되고 본문도 2 -> 4줄로 늘어난다
     (901px에서 카드 251px · 480px 높이). 3열은 1024px(카드 292px)까지,
     2열은 640px(카드 287px)까지만 유지한다. */
  @media (max-width: 1023px) {
    .cmp-rule { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 639px) {
    .cmp-rule { grid-template-columns: 1fr; }
  }

  /* 맺음 — 푸터 위 띠 안, 빛 위에 선다. */
  .cmp-outro {
    /* 문구 → 버튼 40px — 솔루션 CTA 에서 실측한 간격이다(h2 아래 margin 과
       버튼 위 margin 이 합쳐진 값이라 CSS 한 줄로는 안 보인다). 이 값이어야
       내용 높이가 196px 으로 같아지고, 위아래 110px 과 더해 섹션이 416px 이 된다. */
    display: flex; flex-direction: column; align-items: center; gap: 40px;
    text-align: center;
  }
  /* 글자값은 솔루션(산업별) 페이지 CTA 문구(.ind-cta.ind-cta-bg h2)와 같다 —
     clamp(26~40px) / 500 / -0.8px / 행간 1.35. 저쪽은 어두운 면이라 흰색이고
     여기는 흰 면이라 먹색만 다르다. */
  .cmp-outro-title {
    margin: 0;
    font-size: clamp(26px, 3.6vw, 40px); font-weight: 500;
    letter-spacing: -0.8px; line-height: 1.35;
    color: var(--text); word-break: keep-all;
  }
  /* 버튼 — 면 · 테두리 · 모서리는 헤더 CTA(.btn-primary)를 그대로 쓰고,
     크기만 사이트 CTA 규격으로 키운다. industry.css 가 못 박아 둔 값이다 —
     「랜딩 #cta .btn-primary 와 같은 규격: 11px 26px · 16px/400 · 모서리 6px」.
     헤더 값(6px 18px · 14px)은 내비 막대에 맞춘 작은 판이라, 40px 짜리 맺음
     문구 아래에서는 작아 보인다.
     ⚠️ 호버는 따로 준다. nav-footer.css 의 .btn-primary:hover 는 면을 #EFF2F5
        로 바꾸는데(헤더 밖 기본값), 흰 글자가 그 위에서 사라진다. 헤더 안에서
        쓰는 값(nav .btn-primary:hover = #5A8FC5)과 같게 맞춘다. */
  .cmp-outro .cmp-outro-cta {
    /* 규격은 11px 26px 인데 여기서 1px 을 뺀다 — .btn-primary 는 1px 테두리를
       두르고 솔루션 CTA 버튼은 두르지 않아, 같은 안여백이면 2px 더 커진다.
       10 + 10 + 26(행간) + 2(테두리) = 48px 로 저쪽과 같아진다. */
    padding: 10px 25px; font-size: 16px; border-radius: 6px;
    line-height: 26px;
  }
  .cmp-outro .cmp-outro-cta:hover,
  .cmp-outro .cmp-outro-cta:active {
    background: #5A8FC5; color: #ffffff; border-color: #5A8FC5;
  }
  @media (max-width: 900px) {
    .cmp-outro { gap: 28px; }
  }
  @media (max-width: 560px) {
    .cmp-glow-band { padding: 60px 0; }
  }

  /* --spread 0(모임) → 1(펼침). 등록해 두어야 값이 보간된다 — 등록하지 않으면
     값이 한 번에 튀고 그 값을 쓰는 transform 도 같이 튀어 전이가 생략된다.
     초깃값 1 이라 스크립트가 막히면 처음부터 펼쳐진 모습이다. */
  @property --spread { syntax: '<number>'; inherits: true; initial-value: 1; }

  /* ───────── 뭉쳤다 펼쳐지는 줄 (.cmp-spread) ─────────
     한 줄에 선 카드 셋이 처음에는 가운데로 모여 포개져 있다가, 스크롤하면
     제자리로 펼쳐진다(--spread 0→1). 2번은 제자리에서 정면으로 서 있고
     1 · 3번만 좌우로 기운 채 뒤에 깔린다 — 가운데에 중심이 하나 선다.
     ⚠️ 칸이 셋일 때를 전제로 한 값이다(바깥 두 장을 한 칸 폭만큼 당긴다).
        2열 · 1열로 접히는 폭에서는 아래에서 모션을 끈다.
     ⚠️ 스크립트가 막히면 --spread 가 없어 1 로 읽힌다 — 처음부터 펼쳐진
        모습이라 내용이 가려지는 일이 없다. */
  .cmp-spread > * {
    transform: translate(
        calc((var(--dx, 0px) + var(--ox, 0px)) * (1 - var(--spread, 1))),
        calc(var(--oy, 0px) * (1 - var(--spread, 1))))
      rotate(calc(var(--rot, 0deg) * (1 - var(--spread, 1))))
      scale(calc(1 - (1 - var(--sc, 1)) * (1 - var(--spread, 1))));
    will-change: transform;
  }
  /* 2번이 더미 한가운데에 제자리 그대로 · 정면으로 서고(--ox/--oy/--rot 모두 0),
     1 · 3번이 좌우로 −12° · +12° 눕고 0.93배로 물러나 그 뒤에 깔린다.
     2번이 맨 앞이라 z 가 가장 크다. */
  .cmp-spread > *:nth-child(1) { --dx: calc(100% + 18px); --ox: -52px; --oy: -16px; --rot: -12deg; --sc: 0.93; z-index: 1; }
  .cmp-spread > *:nth-child(2) { --ox: 0px; --oy: 0px; z-index: 3; }
  .cmp-spread > *:nth-child(3) { --dx: calc(-100% - 18px); --ox: 50px; --oy: -12px; --rot: 12deg; --sc: 0.93; z-index: 2; }
  /* 겹칠 때만 서는 경계 — 세 장의 면이 같은 --bg-soft 라 포개지면 한 덩어리로
     뭉쳐 보인다. 흰 테두리 1px 과 옅은 그림자를 (1 - spread) 로 넣어, 펼쳐지는
     만큼 저절로 사라지게 한다(펼친 뒤에는 투명도 0 이라 자국이 남지 않는다). */
  .cmp-spread > * {
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, calc(1 - var(--spread, 1))),
      0 18px 40px -16px rgba(22, 32, 44, calc(0.16 * (1 - var(--spread, 1))));
  }
  /* 들어온 순간 한 번 재생한다. 전이는 --spread 하나에 걸고, 자리 · 기울기 ·
     크기 · 경계가 모두 그 값에서 나오므로 넷이 같이 따라온다.
     곡선은 사이트 공통 등장 곡선과 같다. */
  .cmp-spread.cmp-spread-go { transition: --spread .75s cubic-bezier(.2, .7, .2, 1); }
  @media (max-width: 900px) {
    .cmp-spread > * { transform: none; box-shadow: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cmp-spread > * { transform: none; box-shadow: none; }
  }

  /* ───────── 무대(stage) — 가운데 그래픽 + 좌 · 우로 떠오르는 글 ─────────
     세 칸 격자다. 가운데 칸에 그래픽이 붙어 있고(sticky), 글은 양쪽 칸에
     한 줄씩 번갈아 놓인다. 줄마다 높이를 크게 줘서 스크롤하는 동안 하나씩
     화면에 들어온다.
     ⚠️ 그래픽은 아직 회색 판이다. 이미지를 받으면 .cmp-stage-art 안을 바꾼다. */
  /* 아래 여백은 두지 않는다 — 마지막 줄(40vh)이 글 아래로 이미 여유를 남기고,
     다음 섹션이 위로 180px 을 쥔다. 130px 을 더 두면 화면 하나가 비었다. */
  /* 윗여백 60 -> 70px. 히어로 -> 1번 구간은 줄 높이에서 절반(+10px)만 받으므로
     여기서 +10px 을 보태야 다른 구간과 같은 +20px 이 된다. */
  .cmp-stage { padding: 70px 0 0; }
  /* 두 칸이 줄마다 자리를 바꾼다 — 글이 왼쪽이면 그림이 오른쪽, 글이 오른쪽이면
     그림이 왼쪽. 큐브는 그 사이를 가로질러 날아간다. */
  .cmp-stage-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: 80px;
    align-items: center;
  }
  /* 장면 — 글 반대쪽 칸에 한 장.
     ⚠️ 다섯 장이 같은 폭을 쓴다. 그림마다 폭을 달리 주면(초안이 그랬다) 가운데
        정렬이라 줄마다 바깥 끝이 어긋난다 — 실측 바깥여백 76 / 150 / 48 / 48 / 94px.
     ⚠️ 헤더 내용 너비(로고~CTA, 1440px 에서 1344px)보다 안쪽에 둔다. 560px 이면
        1440px 에서 양 끝이 36px 씩 들어온다. */
  .cmp-scene-l { grid-column: 1; }
  .cmp-scene-r { grid-column: 2; }
  /* 바깥 끝을 무대 띠 끝에 붙인다 — 왼쪽 칸이면 왼쪽 끝, 오른쪽 칸이면 오른쪽 끝.
     가운데 정렬로 두면 그림이 칸 안에서 떠 글(.cmp-stage-l/-r 도 바깥에 붙는다)과
     바깥선이 어긋난다(실측 36px). 다섯 장이 같은 폭이고 칸을 꽉 채운다. */
  /* 폭은 장면마다 다르다(--rel) — 바깥 끝은 아래 정렬이 띠 끝에 붙인다. */
  .cmp-stage .cmp-scene { margin-inline: 0; width: calc(var(--rel, 1) * 100%); }
  .cmp-stage .cmp-scene-l { justify-self: start; }
  .cmp-stage .cmp-scene-r { justify-self: end; }
  .cmp-scene {
    position: relative;
    width: 100%;
    margin-inline: auto;
    /* 글과 같은 등장 — 아래에서 떠오른다. */
    opacity: 0; transform: translateY(20px);
    transition: opacity .6s cubic-bezier(.2,.7,.2,1), transform .6s cubic-bezier(.2,.7,.2,1);
  }
  .cmp-scene.is-in { opacity: 1; transform: none; }
  .cmp-scene .cmp-scene-art { display: block; width: 100%; height: auto; }
  /* 모션 레이어 — 바탕 그림 위에 같은 크기로 겹친다. 전부 전체 캔버스 그림이라
     상자를 꽉 채우면 자리가 맞는다. 상자 높이는 바탕 그림이 쥔다. */
  .cmp-ov {
    position: absolute; inset: 0; width: 100%; height: 100%;
    pointer-events: none;
    transform-origin: var(--ox) var(--oy);
  }
  /* 아래 모션은 public/company-story/preview.html 에서 그대로 옮겼다. */

  /* 100+ 그리드 — 데이터 스캔 빛이 대각선으로 지나간다. */
  .cmp-scene .ov-grid {
    -webkit-mask-image: linear-gradient(110deg, transparent 40%, #000 50%, transparent 60%);
            mask-image: linear-gradient(110deg, transparent 40%, #000 50%, transparent 60%);
    -webkit-mask-size: 300% 100%; mask-size: 300% 100%;
    animation: cmp-scan 4.5s linear infinite;
  }
  @keyframes cmp-scan {
    from { -webkit-mask-position: 100% 0; mask-position: 100% 0; }
    to   { -webkit-mask-position: 0 0;    mask-position: 0 0; }
  }
  /* 업링크 · 포트 — 차례로 점멸한다. */
  .cmp-scene .ov-up0, .cmp-scene .ov-up1, .cmp-scene .ov-up2 {
    opacity: 0; animation: cmp-blink 2.4s ease-in-out infinite;
  }
  .cmp-scene .ov-up1 { animation-delay: .8s; }
  .cmp-scene .ov-up2 { animation-delay: 1.6s; }
  @keyframes cmp-blink { 0%, 100% { opacity: 0; } 40%, 55% { opacity: 1; } }

  /* 20+ 공중 연결선 — 빛이 선을 따라 지나간다. 그리드와 같은 스캔이되
     각도와 주기가 다르다(100deg · 3.6s). */
  .cmp-scene .ov-arc {
    -webkit-mask-image: linear-gradient(100deg, transparent 38%, #000 50%, transparent 62%);
            mask-image: linear-gradient(100deg, transparent 38%, #000 50%, transparent 62%);
    -webkit-mask-size: 300% 100%; mask-size: 300% 100%;
    animation: cmp-scan 3.6s linear infinite;
  }

  /* 마지막 장면 — 떠 있는 배지 넷이 천천히 오르내린다.
     ⚠️ 이 도형들도 바탕 그림에 없다. */
  .cmp-scene .ov-b0, .cmp-scene .ov-b1, .cmp-scene .ov-b2, .cmp-scene .ov-b3 {
    animation: cmp-bob 3.4s ease-in-out infinite;
  }
  .cmp-scene .ov-b1 { animation-delay: -.85s; }
  .cmp-scene .ov-b2 { animation-delay: -1.7s; }
  .cmp-scene .ov-b3 { animation-delay: -2.55s; }
  @keyframes cmp-bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-4.5%); } }

  /* 마지막 장면 링 — 한 겹이 안쪽에서 바깥 링 너머까지 퍼지며 흐려진다.
     바탕 그림에 링 셋이 정지 상태로 그려져 있고, 이 한 겹이 그 위를 지나간다. */
  .cmp-scene .ov-r0 {
    opacity: 0; animation: cmp-wave 3.2s cubic-bezier(.3,.55,.4,1) infinite;
  }
  @keyframes cmp-wave {
    0%   { opacity: 0; transform: scale(1); }
    10%  { opacity: 1; }
    80%  { opacity: 0; transform: scale(1.75); }
    100% { opacity: 0; transform: scale(1.75); }
  }

  /* 동작 줄이기 — 움직임만 끈다. 바탕에 없는 레이어(스포크 · 배지)는 그대로 보여야
     그래픽이 빠지지 않으므로 숨기지 않고 제자리에 세운다. */
  @media (prefers-reduced-motion: reduce) {
    /* 그리드 · 공중선 · 네모 · 링은 바탕 그림에도 정지 상태로 그려져 있다 —
       겹쳐 세우면 두 겹이 되므로 아예 숨긴다. */
    .cmp-scene .ov-grid, .cmp-scene .ov-arc, .cmp-scene .ov-up0,
    .cmp-scene .ov-up1, .cmp-scene .ov-up2, .cmp-scene .ov-r0 { display: none; }
    /* 떠 있는 도형 넷은 바탕에 없다 — 숨기면 그래픽이 빈다. 제자리에 세운다. */
    .cmp-scene .ov-b0, .cmp-scene .ov-b1, .cmp-scene .ov-b2, .cmp-scene .ov-b3 {
      animation: none;
    }
  }
  /* 그림에 박아 둔 큐브. 보통은 옮겨 다니는 .cmp-cube 가 대신하므로 숨어 있다.
     ⚠️ top 은 높이 기준이라 --cyh 는 폭 비율을 높이 비율로 환산한 값이다. */
  .cmp-scene .cmp-scene-cube {
    position: absolute;
    left: calc(var(--cx) * 100%);
    top: calc(var(--cyh) * 100%);
    width: calc(var(--cs) * 100%);
    height: auto;
    transform: translate(-50%, -54%);
    opacity: 0;
  }
  /* 히어로 아래 한 장 — 가운데에 두고 폭만 잡는다. */
  /* 초안에서 1425px 페이지에 1100px 로 놓였다(페이지의 77%) — 무대 그림들보다
     눈에 띄게 크다. 900px 이던 것을 새 초안에 맞춰 올렸다.
     다만 대제목과 한 화면에 서야 하므로 남는 높이로 폭을 묶는다. 그림 비율이
     1931:997(=1.93:1)이라 '남는 높이 x 1.93' 이 들어갈 수 있는 최대 폭이다.
     빼는 500px = 내비 70 + 대제목 252 + 위아래 여백. 여유를 40px 남겼다.
     ⚠️ 큐브 자리는 이 상자의 비율로 잡히므로, 상자가 곧 그림이어야 한다 —
        그림에 max-height 를 걸어 상자와 어긋나게 하면 큐브가 빗나간다. */
  .cmp-scene-hero {
    /* 무대 그림들의 상한(680px)은 여기에 걸지 않는다 — 히어로는 더 크다. */
    max-width: 100%;
    width: min(1100px, 100%);
    margin: 44px auto 0;
    /* 스크롤을 기다리지 않고 처음부터 서 있는다 — 등장 모션에서 빼 둔다.
       화면 아래로 잘리는 건 상관없다. 시작이 보이기만 하면 된다. */
    opacity: 1; transform: none;
  }

  /* 옮겨 다니는 큐브. 위치 · 크기는 스크립트가 매 프레임 쓴다. */
  .cmp-cube {
    position: absolute; left: 0; top: 0; width: 72px; height: auto;
    transform-origin: 50% 50%;
    pointer-events: none; z-index: 2;
    opacity: 0; transition: opacity .6s ease;
    will-change: transform;
  }
  .cmp-cube.is-on { opacity: 1; }
  /* 동작 줄이기 — 큐브는 날지 않고, 그림마다 제자리에 박혀 선다. */
  @media (prefers-reduced-motion: reduce) {
    .cmp-cube { display: none; }
    .cmp-scene .cmp-scene-cube { opacity: 1; }
  }
  /* 글 한 줄 — 높이를 화면의 절반쯤으로 줘 스크롤하는 동안 하나씩 들어온다. */
  .cmp-stage-item {
    /* 56vh 는 그림 사이가 97 / 129 / 209px 이라 두 구간이 함께 보였고,
       100vh 는 한 구간만 보이는 대신 빈 자리가 너무 컸고(사이 493~629px),
       76vh 도 넓었다. 그보다 한 단 좁게 잡는다.
       64 -> 66vh 는 구간 사이를 조금만 넓힌 것이다(1000px 화면에서 +20px). */
    min-height: 66vh;
    display: flex; flex-direction: column; justify-content: center;
    /* 등장 — 사이트 공통값(16px · .55s · 같은 베지어)과 같은 결이되, 좌우에서
       들어오므로 가로로도 움직인다. */
    opacity: 0;
    transition: opacity .6s cubic-bezier(.2,.7,.2,1), transform .6s cubic-bezier(.2,.7,.2,1);
  }
  /* 좌 · 우 칸에서 각자 바깥쪽에서 들어온다. */
  .cmp-stage-item { max-width: 460px; }
  .cmp-stage-l { grid-column: 1; justify-self: start; align-items: flex-start; text-align: left; transform: translate(-24px, 16px); }
  .cmp-stage-r { grid-column: 2; justify-self: end;   align-items: flex-start; text-align: left; transform: translate(24px, 16px); }
  .cmp-stage-item.is-in { opacity: 1; transform: none; }
  /* 줄 번호는 마크업이 들고 있다 — 좌우가 같은 줄에 겹치지 않게 한 줄씩 내려간다. */
  .cmp-stage-grid > [data-row="1"] { grid-row: 1; }
  .cmp-stage-grid > [data-row="2"] { grid-row: 2; }
  .cmp-stage-grid > [data-row="3"] { grid-row: 3; }
  .cmp-stage-grid > [data-row="4"] { grid-row: 4; }
  .cmp-stage-grid > [data-row="5"] { grid-row: 5; }
  /* 맺음 줄만 두 칸을 통째로 쓰고 세로로 쌓는다 — 글이 위, 그림이 아래, 둘 다 가운데.
     앞 네 줄의 좌우 교차를 여기서 풀어 이야기를 가운데로 모은다. */
  .cmp-stage-grid > .cmp-stage-item[data-row="5"] {
    grid-column: 1 / -1; grid-row: 5;
    justify-self: center; align-items: center; text-align: center;
    max-width: none;
    /* 맺는 자리라 앞 네 줄보다 넉넉히 — 글 위아래로 화면 삼분의 일이 빈다.
       34 -> 35vh. 이 줄은 4번 그림과 5번 그림 사이에 통째로 끼어 있어 늘린
       만큼이 그대로 틈이 된다 — 앞 줄에서 받는 +10px 에 여기서 +10px 만
       보태면 다른 구간과 같은 +20px 이다(36vh 로 두면 혼자 +30px 이 된다). */
    min-height: 35vh;
    /* 가운데 선 글은 옆이 아니라 아래에서 떠오른다. */
    transform: translateY(20px);
  }
  .cmp-stage-grid > .cmp-scene[data-row="5"] {
    grid-column: 1 / -1; grid-row: 6;
    justify-self: center; margin-inline: auto; margin-top: 8px; margin-bottom: 120px;
    /* 두 칸을 쓰므로 100% 가 띠 전체다 — 제 비율(--rel)도 칸 하나를 기준으로
       다시 센다. 그냥 두면 띠의 72% 가 되어 혼자 커진다(실측 612px 로 상한에 걸렸다). */
    width: calc(var(--rel, 1) * (100% - 80px) / 2);
    max-width: calc((100% - 80px) / 2);
  }

  .cmp-stage h2 {
    margin: 0; color: var(--text);
    font-size: clamp(28px, 4vw, 45px); font-weight: 600;
    letter-spacing: -0.8px; line-height: 1.3;
    word-break: keep-all; text-wrap: balance;
  }
  .cmp-stage .cmp-story-lede {
    margin: 20px 0 0; font-size: 18px; line-height: 1.7;
    color: var(--text-muted); word-break: keep-all;
  }
  /* 맺음 글 — 무대 대제목(.cmp-stage h2)과 같은 값이다. 소제목 크기로 두면
     마지막 줄이 앞 수치들에 눌려 맺는 말로 안 읽혔다. */
  /* 문장 안에 들어가는 베텍 로고 — 대문자 글자 높이에 맞추고 밑선에 앉힌다.
     ⚠️ :global — set:html 로 넣은 글에는 Astro 스코프 속성이 붙지 않는다.
     ⚠️ 높이는 em 이다. 이 줄이 clamp(28~45px)를 오가므로 px 로 두면 좁은
        화면에서 로고만 커 보인다. 0.62em 은 작아 보여 0.74em 으로 올렸다 —
        한글 글자 높이(0.72em 안팎)와 거의 같아진다.
     ⚠️ vertical-align 은 baseline 이 기본이고, 그러면 상자 아랫변이 밑선에
        앉는다 — 워드마크는 그 자리가 맞다. 내림꼴이 없어 더 내릴 것이 없다. */
  .cmp-stage .cmp-story-sig :global(.cmp-sig-logo) {
    display: inline-block;
    height: 0.74em; width: auto;
    /* 왼쪽은 낱말 사이라 넉넉히, 오른쪽은 조사 '이' 가 붙는 자리라 조금만.
       왼쪽에는 글 안의 띄어쓰기(0.25em 안팎)가 이미 있고 거기에 0.3em 을 더한다.
       오른쪽 0.12em 은 글자가 로고에 닿지 않을 만큼만 띄운 값이다 —
       더 주면 'VETEC 이' 로 떨어져 읽힌다. */
    margin: 0 0.12em 0 0.3em;
  }
  .cmp-stage .cmp-story-sig {
    margin: 0; color: var(--text);
    font-size: clamp(28px, 4vw, 45px); font-weight: 600;
    letter-spacing: -0.8px; line-height: 1.3;
    word-break: keep-all; text-wrap: balance;
  }
  @media (max-width: 900px) {
    .cmp-stage .cmp-story-lede,
    .cmp-stage .cmp-stat-label { font-size: 16px; }
  }
  /* 좁은 폭에서는 세 칸을 풀고 그래픽을 맨 위에 한 번만 둔다 — 붙여 두면
     화면 절반을 그래픽이 차지해 글이 들어올 자리가 없다. */
  @media (max-width: 980px) {
    .cmp-stage-grid { grid-template-columns: minmax(0, 1fr); row-gap: 28px; }
    /* 줄 번호 · 칸 지정을 모두 풀면 마크업 순서(그림 → 글)대로 쌓인다. */
    .cmp-stage-grid > [data-row] { grid-column: 1; grid-row: auto; justify-self: start; }
    /* ⚠️ 맺음 줄(5)은 넓은 폭에서 두 칸을 쓰고 자리를 못 박아 둔다. 그 규칙이
       여기까지 따라오면(선택자가 더 세다) 5줄만 2 · 3줄 사이로 끼어든다 —
       실측 y 2015 로 올라가 겹쳤다. 같은 세기로 풀어 준다. */
    .cmp-stage-grid > .cmp-stage-item[data-row="5"] {
      grid-column: 1; grid-row: auto; justify-self: start;
      align-items: flex-start; text-align: left; max-width: none; min-height: 0;
    }
    .cmp-stage-grid > .cmp-scene[data-row="5"] {
      grid-column: 1; grid-row: auto; justify-self: start;
      margin-inline: 0; margin-top: 0; margin-bottom: 0; max-width: min(440px, 100%);
    }
    .cmp-stage-item { min-height: 0; max-width: none; }
    .cmp-stage-l, .cmp-stage-r { transform: translateY(16px); }
    .cmp-stage .cmp-scene { max-width: min(440px, 100%); margin-inline: 0; }
  }

  /* 칸은 글 길이만큼만 넓어진다(shrink-to-fit) — 그대로 두면 카드 셋이
     제각각 넓이가 된다. 폭을 채워 셋을 460px 로 맞춘다. */
  .cmp-stage-stat { justify-content: center; width: 100%; }

  /* 수치 카드 — 흰 면에 바깥 글로우. 바탕도 흰색이라 면으로는 카드가 안 보인다 —
     카드를 세우는 건 둘레의 빛이다.
     ⚠️ 그림자가 아니라 빛이라 먹색이 아니라 브랜드색(#76A6D7)을 쓴다.
     ⚠️ 빛은 위에서 내려온다(y 가 음수). 두 겹이다 — 멀리 번지는 것과 카드에
        바싹 붙는 것. 사방으로 고르게 깔면 카드인지 얼룩인지 흐려지고, 아래로
        떨어뜨리면 그림자처럼 읽힌다.
     모서리 12px 은 과제별 '푸는 방식' 큰 카드(.uc-template)에서 가져온 값이다. */
  .cmp-stat-card {
    /* 카드 상자는 글 칸(460px)보다 좁게 세운다 — 칸을 꽉 채우면 수치 하나를
       담은 판치고 너무 크게 선다. 글줄과 같은 왼쪽 선에 맞춰 선다
       (바깥 칸이 align-items: flex-start 라 좁혀도 자리는 그대로다).
       라벨은 가장 긴 것이 224px 이라 이 폭에서도 한 줄로 선다. */
    width: 100%;
    max-width: 380px;
    background: #FFFFFF;
    border-radius: 12px;
    /* 상하좌우 같은 36px. */
    padding: 36px;
    /* 라벨은 좌측 위, 수치는 우측 아래 — 대각으로 앉힌다. */
    display: flex; flex-direction: column; gap: 16px;
    box-shadow:
      0 -26px 58px -24px rgba(118, 166, 215, 0.55),
      0 -6px 20px -14px rgba(118, 166, 215, 0.30);
  }
  /* 수치 — 크기는 히어로 대제목(.cmp-title-l1 · l2)과 같은 clamp(52~100px)다.
     ⚠️ 그라데이션은 걷었다. 먹색 카드 위에서는 흰색 단색이다 —
        background-clip: text 를 풀어야 하므로 배경을 none 으로 되돌린다. */
  /* 단위 · 기호는 숫자보다 작다. 0.68 은 숫자가 주인공이 되면서도 '년+' 가
     받침으로 읽히는 자리다 — 0.55 까지 내리면 '+' 가 윗첨자처럼 떠 보인다
     (특히 100+ 처럼 기호만 남는 수치에서 그렇다). */
  .cmp-stat-num :global(.cmp-stat-rest) { font-size: 0.68em; }

  .cmp-stat-card .cmp-stat-num {
    align-self: flex-end;
    margin-top: auto;
    font-size: clamp(52px, 8vw, 100px);
    line-height: 1.1;
    background-image: none;
    -webkit-text-fill-color: var(--text); color: var(--text);
  }
  .cmp-stat-card .cmp-stat-label {
    align-self: flex-start;
    margin-top: 0;
  }
  @media (max-width: 900px) {
    .cmp-stat-card { padding: 26px; }
  }

  /* 수치 — 무대 안에서 쓴다. */
  /* 글자가 아래로 갈수록 바탕색에 흡수된다 — 먹색에서 시작해 아랫변에서 흰색이
     되므로 숫자의 발밑이 페이지에 녹아든다.
     ⚠️ background-clip: text 다. 글자색은 color 가 아니라 아래 그라데이션에서
        온다 — color 만 고치면 아무 일도 일어나지 않는다.
     ⚠️ 끝 색은 페이지 바탕과 같은 흰색이어야 한다. 섹션에 색을 깔면 여기도 함께
        바꿔야 흡수되어 보인다. */
  .cmp-stat-num {
    /* 수치는 Roboto 한 벌로 묶는다 — 물려받지 않고 여기서 못 박는다.
       ⚠️ Roboto 에 한글 글리프가 없다. 'Roboto' 만 적으면 '년' 이 시스템
          글꼴(맥 Apple SD Gothic Neo · 윈도우 맑은 고딕)로 떨어져 기계마다
          달라진다 — 실측으로 확인했다. 그래서 한글 자리만 Pretendard 가
          받도록 뒤에 둔다. 숫자와 '+' 는 Roboto 로 그려진다. */
    font-family: 'Roboto', 'Pretendard', sans-serif;
    font-size: clamp(56px, 8vw, 120px);
    font-weight: 400;
    line-height: 1.15; letter-spacing: -0.02em;
    white-space: nowrap; width: fit-content;
    /* 숫자가 요동치는 동안 1 과 7 의 폭이 달라 글자가 떨린다 — 자릿폭을 고정한다. */
    font-variant-numeric: tabular-nums;
    background-image: linear-gradient(180deg, #16202C 0%, #16202C 34%, #FFFFFF 100%);
    -webkit-background-clip: text; background-clip: text;
    color: transparent;
  }
  /* 소제목(.cmp-story-lede · .cmp-story-sig)과 같은 값이다 — 18px / 행간 1.7 /
     --text-muted. 같은 무대 위의 작은 글이라 크기를 따로 둘 이유가 없다.
     ⚠️ 900px 이하도 저쪽과 함께 16px 로 내린다(아래 미디어쿼리). */
  .cmp-stat-label { margin-top: 10px; font-size: 18px; line-height: 1.7; color: var(--text-muted); word-break: keep-all; }
  /* ⚠️ label 은 set:html 로 넣어 span 에 Astro 스코프 속성이 붙지 않는다. :global 필수. */
  .cmp-stat-label :global(.cmp-stat-hl) { color: inherit; }
</style>
