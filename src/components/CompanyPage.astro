---
// 회사 소개 본문. 한국어(/company)와 영어(/en/company)가 이 컴포넌트를 공유한다.
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import '../styles/industry.css';

interface Props {
  lang?: 'ko' | 'en';
}
const { lang = 'ko' } = Astro.props;

const SITE = 'https://refinery.kr';

// ⚠️ 회사 세부 사실(설립연도·조직 규모·수상 등)은 실제 정보로 확인·보완 필요.
const T = {
  ko: {
    title: '회사 소개 · 현장을 아는 팀이 만든 산업 AI | Refinery',
    description: 'Refinery는 (주)베텍이 30년 넘게 산업 현장에서 쌓은 경험을 토대로 만들었습니다. 개발자와 현장 엔지니어가 한 팀이 되어, 기존 시스템 위에 얹거나 없으면 새로 구축해 하나의 통합 지능으로 잇습니다.',
    canonical: '/company',
    jsonLdName: '회사 소개 | Refinery',
    h1: 'Hello, we’re Refinery',
    lede: 'Refinery는 (주)베텍이 30년 넘게 산업 현장에서 쌓아 온 경험으로 만들었습니다.<br>개발자도 발전소와 공장을 직접 겪으며, 현장의 언어로 문제를 정의하고 풉니다.',
    cta: '문의하기', contactHref: '/contact',
    storyTag: '회사 소개',
    storyTitle: '현장을 경험한<br>팀이 만든 솔루션,<br>산업 AI',
    storyLede: '화려한 기술 데모는 만들지 않습니다.<br>현장에서 실제로 통하는 방식을 만듭니다.',
    stats: [
      { num: '30년+', label: '산업 현장에서 쌓은 경험', icon: '/company/icon-stat-02.svg' },
      { num: '100+', label: '데이터를 다룬 현장 수', icon: '/company/icon-stat-01.svg' },
      { num: '20개+', label: '철강 · 반도체 · 식품 등 산업군', icon: '/company/icon-stat-03.svg' },
    ],
    strengthsTitle: '우리가 잘하는 것',
    strengthsSub: '현장을 겪은 팀과 30년+ 경험이 제품의 세 가지 뿌리가 됩니다.',
    strengths: [
      { title: '현장을 겪은 사람들이 만듭니다', description: '개발자뿐 아니라 발전·제조·에너지 산업을 깊이 아는 현장 엔지니어가 한 팀입니다. 설비가 어떻게 멈추고 운전자가 무엇을 보고 판단하는지 아는 사람들이 제품을 설계합니다.' },
      { title: '통합도, 신규 구축도', description: '기존 시스템 위에 통합 지능 레이어를 얹는 것도, 시스템이 없는 현장을 새로 구축하는 것도 가능합니다. 신규 구축도 30년 경험으로 만든 템플릿(예: 에너지경영시스템)에서 시작합니다.' },
      { title: '시계열을 넘어, AI로 판단까지', description: '센서 시계열뿐 아니라 설비·문서·이력까지 온톨로지로 엮어 산업을 가리지 않는 다양한 활용을 만들고, 그 위에서 AI 에이전트가 근거를 들어 의사결정을 돕습니다.' },
    ],
    principlesTitle: '우리가 일하는 원칙',
    principles: [
      { title: '현장에서 출발합니다', description: '이론이 아니라 실제 산업 현장의 문제에서 시작합니다. 30년 넘게 현장에서 확인한 과제가 제품의 기준입니다.' },
      { title: '얹거나, 템플릿으로 시작하거나', description: '이미 SCADA·MES·ERP를 쓰고 있으면 걷어내지 않고 그 위에 통합 지능 레이어를 얹습니다. 시스템이 없는 현장은 30년 경험으로 다져진 템플릿(예: 에너지경영시스템)에서 시작합니다. 어느 쪽이든 하나의 지능으로 이어집니다.' },
      { title: '데이터에 의미를 부여합니다', description: '흩어진 숫자를 온톨로지로 연결해 맥락을 만들고, AI가 근거를 들어 설명하게 합니다.' },
    ],
    ctaTitle: '현장의 문제를<br>Refinery 팀과 함께 풀어보세요.',
  },
  en: {
    title: 'About · Industrial AI built by people who know the field | Refinery',
    description: 'Refinery is built on more than thirty years of VETEC’s experience on industrial sites. Software engineers and field engineers work as one team, layering onto existing systems or building from scratch where none exist.',
    canonical: '/en/company',
    jsonLdName: 'About | Refinery',
    h1: 'Hello, we’re Refinery',
    lede: 'Refinery is built on more than thirty years of experience VETEC gathered on industrial sites.<br>Our developers have worked the plants themselves, and we define problems in the language of the site.',
    cta: 'Contact', contactHref: '/en/contact',
    storyTag: 'About us',
    storyTitle: 'Built by a team<br>that has been on the floor,<br>Industrial AI',
    storyLede: 'We do not build impressive demos.<br>We build what actually works on site.',
    stats: [
      { num: '30+ years', label: 'on industrial sites', icon: '/company/icon-stat-02.svg' },
      { num: '100+', label: 'sites where we handled data', icon: '/company/icon-stat-01.svg' },
      { num: '20+', label: 'industries, from steel to food', icon: '/company/icon-stat-03.svg' },
    ],
    strengthsTitle: 'What we do well',
    strengthsSub: 'A team that has been on the floor, and thirty years of experience — the three roots of the product.',
    strengths: [
      { title: 'Built by people who have been there', description: 'Not just developers. Field engineers who have worked power, manufacturing and energy sites are part of the team. People who know how equipment fails and what an operator watches are the ones designing the product.' },
      { title: 'Integrate, or build new', description: 'We can layer an integrated intelligence layer onto existing systems, or build from scratch where there are none. Even a new build starts from a template refined over thirty years, such as an energy management system.' },
      { title: 'Beyond time series, through to judgment', description: 'Not only sensor time series but equipment, documents and history are woven together through an ontology, creating applications across industries — and on top of that, an AI agent helps decide with evidence.' },
    ],
    principlesTitle: 'How we work',
    principles: [
      { title: 'Start from the site', description: 'We start from real problems on industrial sites, not from theory. The challenges confirmed over thirty years in the field are the product’s benchmark.' },
      { title: 'Layer on, or start from a template', description: 'Where SCADA, MES or ERP is already in use, we layer an integrated intelligence layer on top rather than removing it. Where no system exists, we start from a template refined over thirty years, such as an energy management system. Either path leads to one intelligence.' },
      { title: 'Give the data meaning', description: 'Scattered numbers are connected through an ontology to create context, and AI explains with the evidence behind it.' },
    ],
    ctaTitle: 'Let’s solve what’s happening on your site,<br>together with the Refinery team.',
  },
}[lang];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: T.jsonLdName,
  url: `${SITE}${T.canonical}`,
  publisher: {
    '@type': 'Organization',
    name: 'Refinery',
    url: `${SITE}/`,
    logo: `${SITE}/logo_Refinery_symbol.svg`,
  },
};

// ko/en 양쪽이 모두 존재하는 페이지라 hreflang을 출력한다.
const alternates = [
  { lang: 'ko', href: '/company' },
  { lang: 'en', href: '/en/company' },
];
---

<BaseLayout
  title={T.title}
  description={T.description}
  canonical={T.canonical}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <Nav />
  <main class="ind cmp-page">
    <!-- HERO -->
    {/* 히어로 구성·값은 메인 랜딩(#hero)과 같다 — 흰 바탕에 큰 제목과
        소제목만 둔다. 태그라인·배경 이미지는 두지 않는다. */}
    <section class="ind-hero cmp-hero">
      <div class="ind-container">
        <h1 set:html={T.h1}></h1>
        <p class="ind-lede" set:html={T.lede}></p>
      </div>
    </section>

    {/* STORY — 히어로 바로 아래라 사진을 깔아 어두운 면으로 이어 받는다.
        사진 위에 어두운 막을 덮고 글자를 흰색 계열로 바꾼다(예지보전 히어로와 같은 방식). */}
    <section class="ind-section cmp-story-bg">
      <img
        class="cmp-story-bg-img"
        src="/img_login-bg.webp"
        alt=""
        aria-hidden="true"
        width="3840"
        height="2160"
        loading="lazy"
        decoding="async"
      />
      <div class="ind-container">
        {/* 수치가 대제목 끝나는 지점에서 시작하도록 제목 묶음(1행)과 본문(2행)을
            그리드 직계 자식으로 나눈다. 수치를 2행에 두면 행 경계 = 대제목 아래선이라
            높이를 재서 맞출 필요가 없다. */}
        <header class="ind-head cmp-story">
          <p class="cmp-story-tag">{T.storyTag}</p>
          <h2 set:html={T.storyTitle}></h2>
        </header>
        <p class="cmp-story-lede" set:html={T.storyLede}></p>

        <!-- 오른쪽 칸 — 사진이 닿지 않아 비어 있던 자리. 수치를 여기로 옮겼다. -->
        <div class="cmp-stats">
          {T.stats.map((st) => (
            <div class="cmp-stat">
              <div class="cmp-stat-num">{st.num}</div>
              <div class="cmp-stat-label">
                {/* 이미지/icon_회사 소개-01~03.svg. 파일이 흰색·하늘색 두 색을 쓰므로
                    마스크로 색을 입히면 한 색으로 뭉개진다 — <img>로 그대로 둔다.
                    파일에서 고친 건 선 굵기뿐(70x70 뷰박스에 선언이 없어 기본 1이면
                    54px에서 실효 0.77px라 2로 올렸다). */}
                <img class="cmp-stat-icon" src={st.icon} alt="" aria-hidden="true" width="54" height="54" />
                <span>{st.label}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- STRENGTHS -->
    <section class="ind-section ind-soft">
      <div class="ind-container">
        <header class="ind-head">
          <h2>{T.strengthsTitle}</h2>
          <p>{T.strengthsSub}</p>
        </header>
        <div class="ind-grid ind-grid-3">
          {T.strengths.map((s) => (
            <div class="ind-card"><h3>{s.title}</h3><p>{s.description}</p></div>
          ))}
        </div>
      </div>
    </section>

    <!-- PRINCIPLES -->
    <section class="ind-section">
      <div class="ind-container">
        <header class="ind-head">
          <h2>{T.principlesTitle}</h2>
        </header>
        <div class="ind-grid ind-grid-3">
          {T.principles.map((p) => (
            <div class="ind-card"><h3>{p.title}</h3><p>{p.description}</p></div>
          ))}
        </div>
      </div>
    </section>

    {/* CTA 구성·값은 /why-refinery(플랫폼 개요)와 같다 — 사진 위 왼쪽 제목 +
        오른쪽 버튼. 사진은 public/에 있어 그대로 공유한다. */}
    <section class="ind-cta cmp-cta-bg">
      <img class="cmp-cta-bg-img" src="/use-cases/cta-bg.webp" alt="" aria-hidden="true" loading="lazy" decoding="async" />
      <div class="ind-container">
        <h2 set:html={T.ctaTitle}></h2>
        <a href={T.contactHref} class="ind-btn-primary ind-btn-lg">{T.cta}</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  /* 본문 좌우를 헤더(.nav-inner)와 같은 선에 맞춘다 — 로고 왼쪽 = 문의하기 버튼 오른쪽.
     공통 .ind-container는 1120/24라 내용이 헤더보다 49px 안쪽에서 시작했다.
     플랫폼 개요(.wr-page)·예지보전 등이 쓰는 값(1280/48)과 같다.
     .cmp-page 스코프라 .ind-container를 쓰는 다른 페이지에는 영향이 없다. */
  .cmp-page .ind-container { max-width: 1280px; padding: 0 48px; }
  @media (max-width: 900px) {
    .cmp-page .ind-container { padding: 0 24px; }
  }

  /* ───────── 히어로 — 메인 랜딩(#hero)과 같은 값 ─────────
     흰 바탕에 큰 제목과 소제목만 둔다. 랜딩은 아래에 데모 화면이 붙어
     min-height: 100vh를 쓰지만, 여기는 글만 있어 그 값은 가져오지 않는다
     (빈 자리가 화면 하나만큼 생긴다). */
  .cmp-hero {
    padding: 200px 0 100px;
    background: none; border-bottom: none;
  }
  .cmp-hero h1 {
    margin-bottom: 35px;
    /* 제목이 영문이라 랜딩 #hero h1 값을 그대로 쓴다. 크기·굵기를 줄였던 건
       한글일 때 이야기다 — 같은 px에서도 한글은 라틴 대문자보다 크게 찍히고
       (Pretendard 한글 71.9px vs Inter 대문자 61.1px) 획은 얇아서
       0.845배 축소 + 굵기 600으로 보정했었다. 지금은 둘 다 필요 없다.
       Pretendard는 폴백으로만 남긴다(한글이 섞여 들어올 경우 대비). */
    font-size: clamp(48px, 7vw, 84px);
    line-height: 1.15;
    padding: 0.1em 0;
    font-family: 'Inter', 'Pretendard', sans-serif;
    /* .ind-hero h1이 걸어 둔 700/자간을 랜딩과 같은 값으로 되돌린다. */
    font-weight: 500; letter-spacing: normal;
    /* 랜딩 .hero-title-accent와 같은 값을 제목 전체에 건다.
       display:table이라 상자가 가장 긴 줄의 폭으로 줄어든다. 블록 폭(1184px)에
       걸면 글자가 중간 톤에서 멈춰 그라데이션이 거의 보이지 않는다.
       -webkit-text-fill-color가 없으면 웹킷에서 글자색이 그라데이션을 덮는다. */
    display: table;
    background: linear-gradient(90deg, #16202C 0%, #76A6D7 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
  /* background-clip:text를 못 쓰는 브라우저에서 제목이 통째로 사라지지 않게 한다.
     랜딩은 강조 span에만 걸어 일부만 사라지지만 여기는 제목 전체라 위험이 크다. */
  @supports not ((-webkit-background-clip: text) or (background-clip: text)) {
    .cmp-hero h1 { background: none; -webkit-text-fill-color: #16202C; color: #16202C; }
  }
  .cmp-hero .ind-lede {
    font-size: 18px; font-weight: 400; line-height: 1.7;
    color: var(--text-muted); max-width: 960px; margin: 0;
  }
  @media (max-width: 900px) {
    .cmp-hero { padding: 140px 0 72px; }
    .cmp-hero .ind-lede { font-size: 16px; }
  }

  /* ───────── 섹션 여백·제목 — /why-refinery(플랫폼 개요)와 같은 값 ─────────
     공통값은 섹션 84px · 대제목 clamp(26,3.4vw,38)/650/-0.02em/1.25 ·
     소제목 16px이라, 같은 자리에서 한 단계씩 작았다. */
  .cmp-page .ind-section { padding: 130px 0; }
  @media (max-width: 900px) {
    .cmp-page .ind-section { padding: 60px 0; }
  }
  .cmp-page .ind-head { margin-bottom: 64px; }
  .cmp-page .ind-head h2 {
    font-size: clamp(28px, 4vw, 45px); font-weight: 600;
    letter-spacing: -0.8px; line-height: 1.3;
  }
  /* 섹션 소제목은 랜딩 .section-header p(18px / 1.7)에 맞춘다 —
     이 페이지 히어로 소제목도 같은 값이라, 16px로 두면 한 페이지 안에서
     두 크기가 섞인다. */
  .cmp-page .ind-head p { font-size: 18px; line-height: 1.7; }
  @media (max-width: 900px) { .cmp-page .ind-head p { font-size: 16px; } }

  /* ───────── 스토리 섹션 — 사진 위 흰 글자 ─────────
     사진이 lazy라 도착 전 흰 배경이면 흰 글자가 안 보인다. 어두운 면을 미리 깔아 둔다.
     막은 예지보전 히어로(.uc-hero-bg::after)와 같은 값이다 —
     위 80% -> 아래 50%로, 대제목이 놓인 위쪽을 짙게 덮는다. */
  .cmp-story-bg {
    position: relative; overflow: hidden; background: #111316;
    /* 보여 줄 구간을 파일에 미리 잘라 넣었으므로(아래 사진 주석) 칸 비율에
       높이를 묶지 않는다. 이제 섹션 높이는 내용이 정한다. */
    /* 사진(3840x2160)이 가로에 맞춰 들어가는 높이를 섹션 높이로 삼는다.
       그래야 위쪽에 빈 배경이 남지 않는다. min-height이므로 내용이 더 크면
       섹션이 늘어나고, 그때는 상하 여백 130px이 그대로 지켜진다.
       ⚠️ 100vw로 계산하면 스크롤바 폭(15px)만큼 어긋나 위에 7px이 남는다.
       aspect-ratio는 섹션 자기 폭을 기준으로 잡아 정확히 맞는다. */
    aspect-ratio: 3840 / 2160;
    /* 랜딩 #platform과 같이 내용이 섹션 위 여백(130px) 바로 아래에서 시작한다.
       가운데 정렬이면 같은 padding이어도 시작점이 밀린다. */
    display: flex; flex-direction: column; justify-content: flex-start;
  }
  /* 사진은 왼쪽 절반에만 깐다. 오른쪽 절반은 밑판(#111316)만 남는다. */
  /* ⚠️ 1420px 아래에서는 비율을 풀어야 한다. 내용이 상하 여백 포함 800px을
     차지하는데 16:9로는 그만한 높이가 안 나와(1280px에서 712px) 카드가
     섹션 밖으로 넘친다. 비율을 풀면 높이를 내용이 정하고 여백 130px이
     지켜지는 대신, 사진이 낮은 만큼 위쪽에 배경색이 보인다. */
  @media (max-width: 1420px) {
    .cmp-story-bg { aspect-ratio: auto; }
  }

  .cmp-story-bg-img {
    /* 섹션 가로에 맞추고 오른쪽 아래에 붙인다. width:100%·height:auto라
       비율이 유지되므로 잘리는 곳이 없다. 사진이 섹션보다 낮으면
       위쪽에 섹션 배경색(#111316)이 그대로 보인다. */
    position: absolute; top: auto; bottom: 0; right: 0; left: auto;
    width: 100%; height: auto; max-width: none;
