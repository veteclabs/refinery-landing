---
// 회사 소개 본문. 한국어(/company)와 영어(/en/company)가 이 컴포넌트를 공유한다.
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import '../styles/industry.css';
import RfIcon from './RfIcon.astro';

interface Props {
  lang?: 'ko' | 'en';
}
const { lang = 'ko' } = Astro.props;

// '일하는 세 가지 기준' 카드 아이콘. 순서는 T.principles 와 같다.
const RULE_ICONS = ['rule-field', 'rule-build', 'rule-context'];

const SITE = 'https://refinery.kr';

// ⚠️ 회사 세부 사실(설립연도·조직 규모·수상 등)은 실제 정보로 확인·보완 필요.
const T = {
  ko: {
    title: '회사 소개 ⁠· 현장을 아는 팀이 만든 산업 AI | Refinery',
    description: 'Refinery는 (주)베텍이 30년 넘게 산업 현장에서 쌓은 경험을 토대로 만들었습니다. 개발자와 현장 엔지니어가 한 팀이 되어, 기존 시스템 위에 얹거나 없으면 새로 구축해 하나의 통합 지능으로 잇습니다.',
    canonical: '/company',
    jsonLdName: '회사 소개 | Refinery',
    /* 한 줄로 둔다. 1440px 에서 613px 짜리 한 줄이다 — 폭이 좁아지면 글자가
       함께 줄어들어(clamp 36~60px) 390px 까지 한 줄을 지킨다. */
    h1: '<span class="cmp-title-l1">From the</span><span class="cmp-title-ko">현장 바닥에서<br>올라온 산업 AI</span><span class="cmp-title-l2"><span class="cmp-title-accent">floor</span> up</span>',
    lede: '리파이너리는 (주)베텍이 30년 넘게 산업 현장에서 쌓아 온 경험으로 만들었습니다. 개발자도 여러 산업의 현장을 직접 겪으며, 현장의 언어로 문제를 정의하고 풉니다.',
    storyTag: '회사 소개',
    storyTitle: '현장을 아는 팀이 만든<br>솔루션, 산업 AI',
    storyLede: '화려한 기술 데모는 만들지 않습니다.<br>현장에서 실제로 통하는 방식을 만듭니다.',
    storySig: '30년 현장의 (주)베텍이 만든 제품',
    stats: [
      { num: '30년+', label: '산업 현장에서 쌓은 <span class="cmp-stat-hl">경험</span>', icon: 'stat-experience' },
      { num: '100+', label: '데이터를 다룬 <span class="cmp-stat-hl">현장 수</span>', icon: 'stat-sites' },
      { num: '20+', label: '철강 ⁠· 반도체 ⁠· 식품 등 <span class="cmp-stat-hl">산업군 수</span>', icon: 'stat-industries' },
    ],
    strengthsTitle: '제품의 세 가지 뿌리',
    strengthsSub: '현장을 겪은 팀과 30년의 경험에서 나왔습니다.',
    strengths: [
      { tag: 'People', illust: '/company/card-illust-01.svg', illustRight: '20px', title: '현장을 겪은 사람들이 <br>제품을 설계합니다.', description: '발전 ⁠· 제조 ⁠· 에너지 현장을 아는 엔지니어가 개발자와 한 팀입니다.<br>설비가 어떻게 멈추고 운전자가 무엇을 보고 판단하는지 <br>겪어 본 사람들이 제품을 설계합니다.' },
      { tag: 'Experience', illust: '/company/card-illust-02.svg', illustTop: '-65px', illustRight: '24px', title: '30년의 노하우로 <br>두 방식을 지원합니다.', description: '기존 시스템 위에 얹는 것도, 없는 현장을 새로 세우는 것도 가능합니다.<br>신규 구축도 30년 경험으로 만든 템플릿에서 시작합니다.<br>*템플릿 예시 : 에너지경영시스템' },
      { tag: 'Technology', illust: '/company/card-illust-03.svg', illustTop: '-75px', illustRight: '-8px', title: '시계열을 넘어 <br>AI 판단까지 잇습니다.', description: '센서 시계열뿐 아니라 설비 ⁠· 문서 ⁠· 이력까지 온톨로지로 엮어 <br>산업을 가리지 않는 다양한 활용을 만들고, <br>그 위에서 AI 에이전트가 근거를 들어 의사결정을 돕습니다.' },
    ],
    principlesTitle: '일하는 세 가지 기준',
    principlesSub: '현장에서 확인한 것만 제품에 넣습니다.',
    principles: [
      { title: '현장에서 나온 문제', description: '이론에서 시작하지 않습니다.<br>멈춘 설비 앞에서 시작합니다.' },
      { title: '얹거나, 새로 세우거나', description: '쓰던 시스템을 걷어내지 않습니다.<br>그 위에 얹거나, 없으면 세웁니다.' },
      { title: '숫자에 붙는 맥락', description: '숫자만 보여주지 않습니다.<br>판단까지 잇습니다.' },
    ],
  },
  en: {
    title: 'About ⁠· Industrial AI built by people who know the field | Refinery',
    description: 'Refinery is built on more than 30 years of VETEC’s experience on industrial sites. Software engineers and field engineers work as one team, layering onto existing systems or building from scratch where none exist.',
    canonical: '/en/company',
    jsonLdName: 'About | Refinery',
    h1: 'Hello, we’re Refinery',
    lede: '<span translate="no">Refinery</span> is built on more than 30 years of experience VETEC gathered on industrial sites. Our developers have worked across many industrial sites, and we define and solve problems in the language of the site.',
    storyTag: 'About us',
    storyTitle: 'Industrial AI, built<br>by a team from the floor.',
    storyLede: 'We do not build flashy tech demos.<br>We build what actually works on site.',
    storySig: 'A product built by VETEC, 30 years in the field',
    stats: [
      { num: '30+ years', label: 'on industrial <span class="cmp-stat-hl">sites</span>', icon: 'stat-experience' },
      { num: '100+', label: '<span class="cmp-stat-hl">sites</span> where we handled data', icon: 'stat-sites' },
      { num: '20+', label: '<span class="cmp-stat-hl">industries</span>, from steel to food', icon: 'stat-industries' },
    ],
    strengthsTitle: 'Three roots of the product',
    strengthsSub: 'From a team that has been on the floor, and 30 years of experience.',
    strengths: [
      { tag: 'People', illust: '/company/card-illust-01.svg', illustRight: '20px', title: 'Designed by people <br>who have been on the floor.', description: 'Field engineers who know power, manufacturing and energy sites work alongside developers.<br>People who have seen how equipment stops, and what an operator watches to decide, are the ones designing the product.' },
      { tag: 'Experience', illust: '/company/card-illust-02.svg', illustTop: '-65px', illustRight: '24px', title: 'Thirty years of know-how, <br>both ways supported.', description: 'We can layer onto existing systems, or build from scratch where none exist.<br>Even a new build starts from a template refined over 30 years.<br>*Template example: an energy management system' },
      { tag: 'Technology', illust: '/company/card-illust-03.svg', illustTop: '-75px', illustRight: '-8px', title: 'Beyond time series, <br>through to AI judgment.', description: 'Not only sensor time series but equipment, documents and history<br>are woven together through an ontology, creating applications across industries.<br>On that foundation, an AI agent helps decide with evidence.' },
    ],
    principlesTitle: 'Three standards we work by',
    principlesSub: 'Only what we have confirmed on site goes into the product.',
    principles: [
      { title: 'Problems from the field', description: 'We do not start from theory.<br>We start at the machine that stopped.' },
      { title: 'Layer on, or build new', description: 'We do not tear out what you already run.<br>We layer on top, or build from scratch.' },
      { title: 'Context in the numbers', description: 'We do not stop at showing numbers.<br>We carry them through to a decision.' },
    ],
  },
}[lang];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: T.jsonLdName,
  url: `${SITE}${T.canonical}`,
  publisher: {
    '@type': 'Organization',
    name: 'Refinery',
    url: `${SITE}/`,
    logo: `${SITE}/logo_Refinery_symbol.svg`,
  },
};

// ko/en 양쪽이 모두 존재하는 페이지라 hreflang을 출력한다.
const alternates = [
  { lang: 'ko', href: '/company' },
  { lang: 'en', href: '/en/company' },
];
---

<BaseLayout
  title={T.title}
  description={T.description}
  canonical={T.canonical}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <Nav />
  <main class="ind cmp-page">
    <!-- HERO -->
    {/* 히어로 구성·값은 메인 랜딩(#hero)과 같다 — 흰 바탕에 큰 제목과
        소제목만 둔다. 태그라인·배경 이미지는 두지 않는다. */}
    <section class="ind-hero cmp-hero">
      <div class="ind-container">
        {/* 산업별 히어로(.ind-hero-bg .ind-hero-row)와 같은 격자다 — 대제목이
            두 칸을 쓰고, 소제목은 그 아랫줄 오른쪽 칸에 선다. */}
        <div class="cmp-hero-row">
          <h1 set:html={T.h1}></h1>
          <p class="ind-lede" set:html={T.lede}></p>
        </div>
      </div>
    </section>

    {/* STAGE — 가운데 그래픽은 붙어 있고(sticky), 글이 좌 · 우 번갈아 떠오른다.
        그래픽은 아직 자리만 잡은 회색 판이다. */}
    <section class="cmp-stage">
      <div class="ind-container cmp-stage-grid">
        <div class="cmp-stage-art" aria-hidden="true"><span>그래픽 자리</span></div>

        <div class="cmp-stage-item cmp-stage-l" data-row="1">
          <p class="cmp-story-tag">{T.storyTag}</p>
          <h2 set:html={T.storyTitle}></h2>
          <p class="cmp-story-lede" set:html={T.storyLede}></p>
        </div>

        {T.stats.map((st, i) => (
          <div class={`cmp-stage-item ${i % 2 === 0 ? 'cmp-stage-r' : 'cmp-stage-l'}`} data-row={i + 2}>
            <div class="cmp-stat-num">{st.num}</div>
            <div class="cmp-stat-label"><span set:html={st.label}></span></div>
          </div>
        ))}

        <p class="cmp-stage-item cmp-stage-r cmp-story-sig" data-row="5">{T.storySig}</p>
      </div>
    </section>

    <section class="ind-section">
      <div class="ind-container">
        {/* 머리는 메인 솔루션 섹션(#industries)처럼 가운데에 크게 세운다. */}
        <header class="ind-head cmp-head-row cmp-head-big">
          <h2>{T.strengthsTitle}</h2>
          <p>{T.strengthsSub}</p>
        </header>
        {/* 아코디언 — 카드가 섹션 가로폭을 쓰며 세로로 쌓이고 항상 하나만 펼쳐진다.
            처음에는 1번이 펼쳐진 상태. */}
        <div class="cmp-acc">
          {T.strengths.map((it, i) => (
            <div class="cmp-acc-item" data-open={i === 0 ? 'true' : 'false'}>
              <button type="button" class="cmp-acc-head" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`cmp-acc-p${i}`}>
                <span class="cmp-acc-tag">{it.tag}</span>
                <span class="cmp-acc-title" set:html={it.title}></span>
              </button>
              {/* 패널 밖에 둔다. 패널 안에 넣으면 .cmp-acc-inner의 overflow:hidden이
                  절대배치된 그림을 잘라 데스크톱 잘림이 달라진다(아래 잘림 162 -> 300px).
                  좁은 화면에서 본문 아래로 보내는 일은 CSS order가 맡는다. */}
              {it.illust && (
                <img class="cmp-acc-illust" src={it.illust}
                     style={[it.illustTop && `top:${it.illustTop}`, it.illustRight && `right:${it.illustRight}`].filter(Boolean).join(";") || undefined}
                     alt="" aria-hidden="true" width="1020" height="1020" loading="lazy" decoding="async" />
              )}
              <div class="cmp-acc-panel" id={`cmp-acc-p${i}`} role="region">
                <div class="cmp-acc-inner"><p set:html={it.description}></p></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PRINCIPLES -->
    <section class="ind-section">
      <div class="ind-container">
        <header class="ind-head cmp-head-row">
          <h2>{T.principlesTitle}</h2>
          <p>{T.principlesSub}</p>
        </header>
        {/* 랜딩 솔루션 섹션(#industries)의 .industries-grid / .industry-card 규격을 그대로 따른다.
            3열 · gap 18 · 900px에서 2열 · 600px에서 1열. */}
        <ol class="cmp-rule">
          {T.principles.map((p, i) => (
            <li class="cmp-rule-card rf-ic-host">
              <span class="cmp-rule-num">{i + 1}</span>
              {/* 이 카드만 밝은 면(--bg-soft)이라 light 세트를 쓴다. */}
              <RfIcon name={RULE_ICONS[i]} theme="light" class="cmp-rule-icon" />
              <h3>{p.title}</h3>
              <p set:html={p.description}></p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  </main>
  <Footer />

  <script is:inline>
    // 무대 — 글 한 줄이 화면에 들어오면 떠오른다. 한 번 뜨면 그대로 둔다.
    (function () {
      var items = document.querySelectorAll('.cmp-stage-item');
      if (!items.length) return;
      if (!('IntersectionObserver' in window) ||
          matchMedia('(prefers-reduced-motion: reduce)').matches) {
        items.forEach(function (el) { el.classList.add('is-in'); });
        return;
      }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          e.target.classList.add('is-in');
          io.unobserve(e.target);
        });
      }, { rootMargin: '0px 0px -25% 0px', threshold: 0.2 });
      items.forEach(function (el) { io.observe(el); });
    })();

    // 항상 하나만 펼쳐 둔다. 이미 열린 항목을 다시 눌러도 닫히지 않는다.
    document.querySelectorAll('.cmp-acc').forEach(function (acc) {
      acc.addEventListener('click', function (e) {
        var btn = e.target.closest('.cmp-acc-head');
        if (!btn || !acc.contains(btn)) return;
        var item = btn.closest('.cmp-acc-item');
        if (item.dataset.open === 'true') return;
        acc.querySelectorAll('.cmp-acc-item').forEach(function (x) {
          x.dataset.open = 'false';
          x.querySelector('.cmp-acc-head').setAttribute('aria-expanded', 'false');
        });
        item.dataset.open = 'true';
        btn.setAttribute('aria-expanded', 'true');
      });
    });
  </script>
</BaseLayout>

<style>
  /* ⚠️ 페이지 전체에 keep-all을 건다. 개별 규칙으로 붙이다 보니 히어로 소제목
     (.ind-lede)·섹션 소제목처럼 빠진 곳이 남아, 320~480px에서 '만/들었습니다.'
     '현/장에서'처럼 어절 한가운데가 끊겼다. overflow-wrap: break-word는
     한 어절이 줄보다 길 때만 쓰이는 안전장치다. */
  .cmp-page, .cmp-page * { word-break: keep-all; overflow-wrap: break-word; }

  /* 본문 좌우를 헤더(.nav-inner)와 같은 선에 맞춘다 — 로고 왼쪽 = 문의하기 버튼 오른쪽.
     공통 .ind-container는 1120/24라 내용이 헤더보다 49px 안쪽에서 시작했다.
     플랫폼 개요(.wr-page)·예지보전 등이 쓰는 값(1280/48)과 같다.
     .cmp-page 스코프라 .ind-container를 쓰는 다른 페이지에는 영향이 없다. */
  .cmp-page .ind-container { max-width: 1600px; padding: 0 48px; }
  @media (max-width: 900px) {
    .cmp-page .ind-container { padding: 0 24px; }
  }

  /* ───────── 히어로 — 메인 랜딩(#hero)과 같은 값 ─────────
     흰 바탕에 큰 제목과 소제목만 둔다. 랜딩은 아래에 데모 화면이 붙어
     min-height: 100vh를 쓰지만, 여기는 글만 있어 그 값은 가져오지 않는다
     (빈 자리가 화면 하나만큼 생긴다). */
  .cmp-hero {
    /* 위 244px — 산업별(솔루션) 히어로와 대제목 글자 윗변이 같은 자리에 오도록
       맞춘 값이다. 저쪽은 섹션 위 180px 에 태그라인과 그 아래 여백이 더해져
       대제목 글자가 254px 에서 시작하는데, 이 페이지는 태그라인이 없어 200px
       이면 210px 에서 시작했다.
       ⚠️ 900px 이하도 같은 식으로 맞춘다(저쪽 216px · 여기 140px -> 208px).
       ⚠️ 대제목 크기나 태그라인 자리가 바뀌면 다시 잰다. */
    padding: 244px 0 100px;
    background: none; border-bottom: none;
  }
  /* '현장'에만 브랜드 빛을 둔다 — 메인 히어로의 .hero-title-accent 와 같은 처리다.
     발밑 바깥에서 올라오는 작은 원이라 글자 윗부분은 제 색 그대로이고 아래쪽만
     브랜드색으로 번진다. 가장 바깥 색(#16202C)이 대제목 색과 같아 경계가 없다.
     ⚠️ 순서를 지킨다 — background 단축 속성이 background-clip 을 초기화하므로
        clip 은 반드시 background 뒤에 온다.
     ⚠️ 반지름은 em 이다. 대제목이 clamp 로 36~60px 을 오가므로 px 로 두면 좁은
        화면에서 빛이 글자를 통째로 덮는다.
     ⚠️ line-height 1 로 상자를 글자에 맞추고 아래로 0.25em 을 더한다. 그냥 1 만
        두면 상자가 글자 높이에 딱 맞아 받침 아래가 잘린다(background-clip:text 는
        상자 안에서만 칠한다). 0.25em 이면 대제목 줄 높이(1.25)와 같아진다.
     ⚠️ 가로 중심 50% — 메인은 여섯 글자짜리 낱말이라 60% 였지만 여기는 두 글자라
        가운데가 맞다. 세로 82% 는 메인과 같은 값이다.
     ⚠️ 빛은 '현장'이 아니라 '언어'에 둔다. 메인 첫 줄의 '흩어진 현장을'은 빛 없이
        두고 '하나의 운영체제'에 주므로, 같은 낱말을 여기서 빛내면 규칙이 어긋난다.
        이 문장에서 새로 말하는 것도 '언어' 쪽이다. */
  /* 영문 줄만 크게 둔다 — 국문 줄(clamp 36~60)의 1.67배다.
     ⚠️ :global — 대제목은 set:html 로 넣어 Astro 스코프 속성이 붙지 않는다.
     ⚠️ line-height 1.1 — h1 의 1.25 를 그대로 받으면 큰 글자만큼 줄 사이가
        벌어져 두 줄이 따로 놀았다.
     ⚠️ 빛의 반지름은 em 이라 글자가 커지면 같이 커진다. 따로 손댈 것이 없다. */
  .cmp-hero h1 :global(.cmp-title-l1),
  .cmp-hero h1 :global(.cmp-title-l2) {
    font-size: clamp(52px, 8vw, 100px);
    line-height: 1.1;
  }
  /* 첫 줄은 두 칸에 걸쳐 왼쪽 끝에서 시작한다. */
  .cmp-hero h1 :global(.cmp-title-l1) { grid-column: 1 / -1; grid-row: 1; justify-self: start; }
  .cmp-hero h1 :global(.cmp-title-l2) { grid-column: 2; grid-row: 2; }
  /* 국문은 'floor up' 오른쪽에 작게 두 줄로 선다. 두 덩이를 inline-block 으로
     두 칸 격자로 두고 아랫변을 맞춘다(align-items: end).
     ⚠️ inline-block + vertical-align: baseline 으로 맞추면 줄상자가 두 덩이의
        밑선 아래 여유를 모두 끌어안아 대제목 상자가 35px 길어진다 — 소제목이
        그만큼 밀린다. 격자는 상자 높이가 더 큰 쪽으로만 잡혀 그 일이 없다.
     ⚠️ 아랫변을 맞추면 두 글의 밑선은 조금 어긋난다. 국문 쪽을 margin-bottom
        으로 끌어올려 맞춘다(아래 값).
     ⚠️ :global — 대제목은 set:html 로 넣어 Astro 스코프 속성이 붙지 않는다. */
  .cmp-hero h1 :global(.cmp-title-ko) {
    grid-column: 1; grid-row: 2; align-self: end; justify-self: start;
    font-size: clamp(13px, 1.45vw, 20px);
    line-height: 1.5;
    letter-spacing: -0.02em;
    /* 'floor up' 의 밑선 쯤에 앉힌다 — 아랫변끼리 맞추면 큰 글자의 밑선 아래
       여유만큼 국문이 내려앉는다. */
    margin-bottom: 0.9em;
  }
  /* ⚠️ :global 이다. set:html 로 넣은 글에는 Astro 스코프 속성이 붙지 않아
     .cmp-title-accent 로만 쓰면 규칙이 통째로 빗나간다(RfIcon 과 같은 건이다). */
  .cmp-hero h1 :global(.cmp-title-accent) {
    display: inline-block;
    line-height: 1;
    padding-bottom: 0.25em;
    background: radial-gradient(
      circle 1.2em at 50% 82%,
      #76A6D7 0%,
      #4A7FA8 38%,
      #22303F 72%,
      #16202C 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* 대제목과 소제목을 한 칸에 세로로 쌓고 둘 다 화면 가운데에 세운다.
     ⚠️ 줄 사이 0 — 소제목은 대제목 줄상자가 남기는 여백만큼 아래에서 시작한다.
        실제 간격은 아래 margin-top 이 맞춘다. */
  .cmp-hero-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    row-gap: 0;
  }
  /* width: fit-content 라 justify-self 가 없으면 왼쪽에 붙는다. */
  .cmp-hero .cmp-hero-row h1 { grid-row: 1; justify-self: center; }
  .cmp-hero .cmp-hero-row .ind-lede {
    grid-row: 2; justify-self: center; text-align: center;
    /* 대제목 끝 줄(작은 국문)에서 18px 띄운다 — 줄상자 여유까지 더하면 눈에는
       30px 쯤이다. 산업별 히어로의 7.2px 을 따르던 값(-1.8px)은 소제목이 대제목
       오른쪽 칸에 있을 때 이야기였고, 가운데로 내려온 지금은 너무 붙는다. */
    margin-top: 18px;
  }
  .cmp-hero h1 {
    /* 아래 0 — 솔루션 히어로는 대제목 글자 아랫변에서 소제목 글자 윗변까지가
       19px 이다(1600 · 1440 · 1280 · 1201px 모두). 35px 이면 54px 이 됐다.
       ⚠️ 1100px 이하는 저쪽이 36px 이라 아래에서 22px 을 준다(저쪽은 소제목의
          위 여백 20px + 줄 상자 여유로 그 값이 된다). */
    margin-bottom: 0;
    /* 메인 히어로(#hero h1)와 같은 값이다 — 크기 · 굵기 · 행간 · 자간 · 글꼴 ·
       색까지 한 벌로 맞춘다. 두 페이지의 첫 글이 같은 규격으로 서야 한다.
       ⚠️ 한때 이 자리는 clamp(48,7vw,84) / 500 / Inter 에 좌→우 그라데이션
          글자(배경을 글자에 물리는 방식)였다. 메인 쪽에는 강조 낱말에만
          쓰는 처리라 제목 전체에 걸지 않는다.
       ⚠️ 그라데이션을 걷으면서 그 폴백(@supports not background-clip)도 함께
          지웠다 — 색을 직접 주므로 사라질 일이 없다.
       ⚠️ display: table 도 걷는다. 그라데이션 상자를 글자 폭에 맞추려던 값이라
          쓸 데가 없어졌다. 메인과 같이 width: fit-content 로 둔다. */
    font-size: clamp(36px, 5vw, 60px);
    font-weight: 600;
    /* ⚠️ 값을 직접 적는다. --lh-display · --ls-display 는 global.css 의 랜딩
       :root 에만 있어 이 페이지에서는 비어 있었다 — 행간이 본문값(1.65)으로
       떨어지고 자간이 normal 이 됐다(1440px 에서 줄 99px · 자간 0). */
    line-height: 1.25;
    letter-spacing: -0.03em;
    font-family: 'Roboto', 'Pretendard', sans-serif;
    color: #16202C;
    padding: 0.1em 0;
    width: fit-content;
    /* 두 칸 격자다.
         1줄  From the (두 칸에 걸친다)
         2줄  국문 두 줄 | floor up
       둘째 줄이 오른쪽으로 물러난 만큼 왼쪽에 빈 자리가 생기는데, 그 자리에
       국문을 작게 넣는다. 덩이 전체는 화면 가운데에 선다. */
    display: grid; grid-template-columns: auto auto;
    justify-content: center; column-gap: 40px; row-gap: 0;
    text-align: left;
    word-break: keep-all;
    overflow-wrap: break-word;
  }
  /* 소제목은 솔루션(산업별) 히어로의 .ind-lede 와 같은 값이다 — 18px / 400 /
     행간 1.5 / --text-muted. 대제목을 메인에 맞출 때 메인 소제목 값
     (16 / 300 / #5A6776)으로 갔다가 되돌린 자리다.
     ⚠️ 900px 이하는 저쪽과 같이 16px 로 내린다.
     ⚠️ 칸 폭(960px)은 그대로 둔다. 글자값을 맞추는 것이지 자리를 옮기는
        작업이 아니다(저쪽은 600px 이고 이 페이지는 글이 길다). */
  .cmp-hero .ind-lede {
    font-size: 18px; font-weight: 400; line-height: 1.5;
    color: var(--text-muted); max-width: 620px; margin: 0;
  }
  @media (max-width: 1100px) {
    /* 대제목 아랫변은 영문 줄이 정한다 — 그 밑선 기준으로 저쪽(26px)에 맞춘다. */
    .cmp-hero h1 { margin-bottom: 17px; }
    /* 좁은 폭에서도 가운데 정렬은 그대로다 — 폭만 저쪽과 같은 600px 로 줄인다.
       ⚠️ 소제목에 위 여백을 주지 않는다 — 대제목이 이미 아래 margin 을 쥐고 있다. */
    .cmp-hero .cmp-hero-row .ind-lede { max-width: 600px; margin-top: 0; }
  }
  @media (max-width: 900px) {
    .cmp-hero { padding: 208px 0 72px; }
    /* 대제목이 작아지는 만큼 줄상자 여유도 줄어 1100px 값(17px)이면 좁다. */
    .cmp-hero h1 { margin-bottom: 19px; }
    /* 솔루션 히어로는 900px 이하에서 소제목을 16px 로 내린다 — 같은 값이다. */
    .cmp-hero .ind-lede { font-size: 16px; }
  }

  /* ───────── 섹션 여백·제목 — /why-refinery(플랫폼 개요)와 같은 값 ─────────
     공통값은 섹션 84px · 대제목 clamp(26,3.4vw,38)/650/-0.02em/1.25 ·
     소제목 16px이라, 같은 자리에서 한 단계씩 작았다. */
  .cmp-page .ind-section { padding: 130px 0; }
  @media (max-width: 900px) {
    .cmp-page .ind-section { padding: 60px 0; }
  }
  .cmp-page .ind-head { margin-bottom: 64px; }
  .cmp-page .ind-head h2 {
    font-size: clamp(28px, 4vw, 45px); font-weight: 600;
    letter-spacing: -0.8px; line-height: 1.3;
  }
  .cmp-page .ind-head h2 { text-wrap: balance; }
  .cmp-page .ind-head p { text-wrap: pretty; }
  /* 섹션 소제목은 랜딩 .section-header p(18px / 1.7)에 맞춘다 —
     이 페이지 히어로 소제목도 같은 값이라, 16px로 두면 한 페이지 안에서
     두 크기가 섞인다. */
  .cmp-page .ind-head p { font-size: 18px; line-height: 1.7; }
  /* 랜딩 .section-header-row와 같은 값 — 대제목 왼쪽, 소제목 오른쪽 아래 정렬.
     랜딩은 섹션마다 소제목 max-width가 360~680px로 다른데, 기본값 360px을 쓴다. */
  /* ⚠️ max-width: none 필수. industry.css의 .ind-head가 640px로 묶고 있어
     그대로 두면 flex-wrap 때문에 소제목이 아래로 내려간다(랜딩은 1184px 전체). */
  /* 뿌리 섹션 머리 — 메인 솔루션 섹션(#industries .section-header-row)과 같다.
     대제목을 한 단 키우고(45 -> 60px) 소제목을 오른쪽이 아니라 아래에 둔 뒤
     둘 다 가운데에 세운다. 60px 제목 옆에 18px 글이 서면 줄 끝이 서로 멀어
     한 덩어리로 읽히지 않는다는 게 저쪽에 적힌 까닭이다.
     ⚠️ 5.6vw 는 1071px 에서 60px 에 닿는다 — 그 아래로는 폭을 따라 줄어든다. */
  .cmp-page .cmp-head-big {
    flex-direction: column; align-items: center; gap: 16px; text-align: center;
  }
  .cmp-page .cmp-head-big h2 { font-size: clamp(32px, 5.6vw, 60px); }
  .cmp-page .cmp-head-big p { max-width: none; }
  @media (max-width: 900px) {
    .cmp-page .cmp-head-big { display: flex; }
  }
  .cmp-head-row { display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; flex-wrap: wrap; max-width: none; }
  .cmp-head-row h2 { margin-bottom: 0; }
  /* 소제목 칸을 360 -> 565px 으로 올린다. 영문은 두 머리 모두 소제목이 두 줄이었다 —
     'From a team that has been on the floor, and 30 years of experience.' 544px ·
     'Only what we have confirmed on site goes into the product.' 478px.
     가장 긴 544px 에 여유 20px 을 둔 값이다. 제목과 합쳐도 머리 폭 1184px 안에 들어간다
     (527 + 32 + 544 = 1103 · 569 + 32 + 478 = 1079).
     국문은 329 · 272px 이라 360px 에서도 이미 한 줄이었고 변화가 없다. */
  .cmp-head-row p { max-width: 565px; margin: 0; }
  @media (max-width: 900px) {
    .cmp-head-row { display: block; }
    .cmp-head-row p { margin-top: 12px; max-width: none; }
  }
  /* 영문은 소제목이 길어 위 900px 경계보다 한참 위에서 flex-wrap 으로 먼저 내려간다 —
     두 머리가 1180 · 1160px 으로 갈려 그 사이에서 모양이 섞였다(소제목 칸을 565px 으로
     올린 뒤 생긴 일이다). 긴 쪽에 맞춰 1180px 을 공통 경계로 두고 둘을 함께 내린다.
     국문은 소제목이 329 · 272px 이라 900px 까지 버티므로 이 값을 쓰지 않는다.
     (랜딩 .section-header-row 가 쓰는 방식과 같다 — global.css 참고) */
  html[lang="en"] .cmp-head-row { flex-wrap: nowrap; }
  @media (max-width: 1180px) {
    html[lang="en"] .cmp-head-row { display: block; }
    html[lang="en"] .cmp-head-row p { margin-top: 12px; max-width: none; }
  }

  /* ───────── 원칙 카드 ─────────
     랜딩 솔루션 섹션(#industries)과 같은 규격.
     global.css .industries-grid → 4열 · gap 18 · 1500px 3열 · 1280px 2열 · 600px 1열
     (여기 원칙 카드는 셋뿐이라 3열을 그대로 쓴다)
     global.css .industry-card    → #fff · 1px border · radius · padding 30
     레이아웃(3열·gap·카드 박스)만 랜딩을 따르고, 글자 크기는 위 뿌리 아코디언과
     동일하게 맞춘다: 라벨 13 · 제목 28 / 1.3 · 본문 16 / 1.7.
     ⚠️ 카드 본문폭이 323px(아코디언 544px)이라 같은 크기여도 줄 수가 다르다.
        02번 제목 2줄, 01번 본문 4줄이 되는 것은 이 폭 차이 때문이지 오류가 아니다. */
  .cmp-rule {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px;
  }
  .cmp-rule-card {
    /* 카드 면은 위 뿌리 섹션(.ind-soft)과 같은 --bg-soft. 섹션 배경이 흰색이라
       회색 카드가 그대로 떠 보인다. */
    background: var(--bg-soft); border: 1px solid var(--border); border-radius: var(--radius);
    padding: 30px; position: relative; overflow: hidden;
    transition: border-color .2s, background .2s;
    text-align: center;
  }
  .cmp-rule-num {
    display: flex; align-items: center; justify-content: center;
    width: 30px; height: 30px; border-radius: 50%;
    /* 원을 --accent로 채우고 숫자는 흰색. 테두리는 같은 색으로 남겨 두면
       border-box 기준 지름 30px이 그대로 유지된다. */
    background: var(--accent); border: 1px solid var(--accent);
    /* 글꼴은 뿌리 태그라인(.cmp-acc-tag)과 같은 본문 글꼴을 그대로 물려받는다. */
    /* 크기·굵기는 아코디언 태그라인(.cmp-acc-tag)과 같다. 자간만 다르다 —
       저쪽은 0.4px 이고 여기는 숫자 한 글자라 아래 -0.2px 을 그대로 쓴다.
       양수 자간은 마지막 글자 뒤에도 붙어 원 안에서 글자가 왼쪽으로 치우친다
       (1.2px 일 때 0.6px 밀려 padding-left 로 보정했던 자리다). */
    font-size: 15px; font-weight: 600; line-height: 1;
    /* 자간은 회사 소개 섹션 태그라인(.cmp-story-tag)과 같은 -0.2px.
       값이 작아 한 글자 뒤에 붙는 여백도 -0.1px 수준이라 되밀 필요가 없다. */
    /* 흰색 유지. #3f76ae를 시도했으나 그 4.71:1은 흰 배경 기준 값이었고,
       실제 바탕인 #76A6D7 위에서는 1.86:1로 흰색(2.56:1)보다 낮았다. */
    color: #ffffff; letter-spacing: -0.2px;
    /* 번호는 흐름에서 빼서 카드 왼쪽 위에 고정한다. 흐름에 두면 이 배지가
       아이콘을 아래로 밀어, '카드 윗선 -> 아이콘' 여백만 48px 더 벌어진다.
       위치값(30px)은 카드 패딩과 같아 보이는 자리는 그대로다. */
    position: absolute; top: 30px; left: 30px; margin: 0;
    /* 글리프를 원 한가운데로 내린다. align-items: center 는 글자 상자를 가운데 두는데,
       숫자 글리프는 그 상자 안에서 baseline 위에 놓여 1.3px 떠 보였다(1·2·3 모두 같은 값).
       border-box 라 padding 을 줘도 원 지름 30px 은 그대로다.
       값은 재서 골랐다 — 0px 에서 -1.27px, 2px 에서 -0.27px, 3px 에서 +0.73px.
       글리프가 정수 픽셀에 스냅돼 1.65~2px 이 같은 자리에 선다. */
    padding-top: 2px;
  }
  /* 대제목 위 아이콘. 카드 안쪽 내용 너비(323px) 기준 가운데 정렬. */
  /* 카드 윗선 -> 아이콘 60px, 아이콘 -> 대제목 40px.
     위쪽은 카드 패딩 30px이 이미 깔려 있으므로 마진은 30px만 더한다. */
  /* ⚠️ :global 필수 — RfIcon 은 set:html 로 넣는 인라인 SVG라 Astro 스코프 속성이 붙지 않는다. */
  /* 이 자리만 160px 이다(다른 둘은 145). 카드가 넓어 160 이 그 안에서 비율을 잡는다.
     크기는 그대로지만 중앙 정렬로 아래 빈칸이 7.6%→12.5% 로 커졌으므로, 처음 모습의
     간격(위 50.6 · 아래 52.2px)을 지키려면 아래 margin 은 40 이 아니라 32 다. */
  :global(.cmp-rule-icon) { display: block; width: 160px; height: 160px; margin: 31px auto 32px; }
  .cmp-rule-card h3 {
    /* 제목 28 / 1.3 — .cmp-acc-title과 동일. 20px일 때의 5px 간격은 28px에서 너무
       붙어 보여, 아코디언의 제목-본문 간격(12px)을 함께 가져온다. */
    margin: 0 0 12px; font-size: 26px; font-weight: 600; line-height: 1.3;
    color: var(--text); word-break: keep-all; text-wrap: balance;
  }
  /* 본문 16 / 1.7 — .cmp-acc-inner p와 동일. 아코디언에 모바일 축소가 없으므로
     여기서도 폭이 줄어도 크기를 낮추지 않는다. */
  /* keep-all 필수: 없으면 한글이 어절 한가운데서 잘린다(1024px·375px에서 확인). */
  .cmp-rule-card p { margin: 0; font-size: 16px; line-height: 1.7; color: var(--text-muted); text-wrap: pretty; word-break: keep-all; }
  /* ⚠️ 열이 줄어드는 기준이 랜딩(900/600)과 다르다. 랜딩 카드는 제목이 20px인데
     여기는 26px이라 더 일찍 감긴다. 실측으로 카드가 290px 아래로 내려가면
     '얹거나, 새로 세우거나'가 2줄이 되고 본문도 2 -> 4줄로 늘어난다
     (901px에서 카드 251px · 480px 높이). 3열은 1024px(카드 292px)까지,
     2열은 640px(카드 287px)까지만 유지한다. */
  @media (max-width: 1023px) {
    .cmp-rule { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 639px) {
    .cmp-rule { grid-template-columns: 1fr; }
  }

  /* ───────── 강점 아코디언 ───────── */
  /* 카드 간격은 기준 섹션(.cmp-rule)과 같은 18px. */
  .cmp-acc { display: grid; gap: 18px; }
  /* 랜딩 솔루션 섹션(#industries)의 .industry-card와 같은 값 —
     흰 배경 · 1px 테두리 · radius 12px · 안쪽 여백 30px,
     제목 20px/600(아래 5px), 설명 15px/1.5. */
  .cmp-acc-item {
    background: #ffffff; border: 1px solid var(--border);
    border-radius: var(--radius); overflow: hidden;
    position: relative;
  }
  /* 카드 오른쪽 일러스트. 접힌 카드(121px)에서는 위아래가 크게 잘려 어색하므로
     펼친 카드에서만 보이게 하고, 열릴 때 함께 서서히 나타난다. */
  .cmp-acc-illust {
    /* SVG 자체를 카드 오른쪽 끝에 붙이고 세로는 카드 위에 맞춘다.
       파일마다 안쪽 여백이 달라(2번은 아래 107px, 왼쪽 84px) 그림이
       내려앉아 보이는 경우가 있어, 필요한 카드만 데이터의 illustTop으로
       위치를 덮어쓴다. */
    position: absolute; right: 0; top: 0; transform: none;
    /* ⚠️ 세로 기준(height 고정 + width auto)이다. width: 50%였을 때는 카드가
       좁아질수록 그림이 같이 줄어 카드 밖으로 잘려 나가는 부분이 폭마다 달랐다.
       높이를 못 박으면 폭이 줄어도 그림 크기가 그대로라 잘리는 부분이 같다.
       값은 1440px에서의 기존 렌더와 같게 뷰박스 비율로 환산했다
       (1번 592 x 1034.16/1020.47 = 600). */
    height: 600px; width: auto; pointer-events: none; user-select: none;
    /* 카드가 좁아지면 크기가 고정된 그림이 본문 자리까지 들어온다.
       줄이면 잘리는 부분이 폭마다 달라지므로, 대신 그림을 글 뒤로 보낸다. */
    z-index: 0;
    opacity: 0; transition: opacity .34s cubic-bezier(.22,1,.36,1);
  }
  .cmp-acc-item[data-open="true"] .cmp-acc-illust { opacity: 1; }
  /* ⚠️ 숨김 기준이 900이 아니라 1150이다. 그림 폭이 592px으로 고정됐으므로
     본문(카드의 46%)과 겹치지 않으려면 카드가 592 / (1 - 0.46) = 1096px 이상
     이어야 하고, 컨테이너 좌우 여백 24를 더하면 뷰포트 1144px이 경계다.
     그 아래에서는 그림을 줄이는 대신 감춘다 — 줄이면 잘리는 부분이 다시
     폭마다 달라져 세로 기준으로 바꾼 이유가 없어진다. */
  /* 카드별 크기. 값은 1440px에서의 기존 렌더와 같게 뷰박스 비율로 환산했다
     (2번 591 정사각 · 3번 621 x 1089.57/1020.47 = 663). */
  .cmp-acc-item:nth-child(2) .cmp-acc-illust { height: 591px; }
  .cmp-acc-item:nth-child(3) .cmp-acc-illust { height: 663px; }
  /* 좁은 화면에서는 감추지 않고 본문 아래로 내린다. 그림은 패널 밖에 있으므로
     (패널 안에 두면 .cmp-acc-inner의 overflow:hidden이 데스크톱 잘림을 바꾼다)
     카드를 flex 열로 만들고 order로 맨 뒤에 보낸다. 접힌 카드는 공간을 차지하지
     않도록 아예 감춘다. 벡터라 확대해도 깨지지 않는다.
     ⚠️ 기준이 900이 아니라 980이다. 980px 아래에서는 본문 상자가 399px까지
     좁아져 3줄짜리 글이 7줄로 감긴다. 그 전에 그림을 내려 본문이 카드 폭을
     쓰게 한다. 카드 나머지(패딩·글자 크기)의 기준은 그대로 900px이다. */
  @media (max-width: 980px) {
    .cmp-acc-item { display: flex; flex-direction: column; }
    /* ⚠️ nth-child 규칙(특정도 0,2,0)을 같이 적으로 잡지 않으면 데스크톱용
       height: 591px/663px가 그대로 남아 그림이 세로로 늘어난다(325x591로 확인). */
    .cmp-acc-illust,
    .cmp-acc-item:nth-child(2) .cmp-acc-illust,
    .cmp-acc-item:nth-child(3) .cmp-acc-illust {
      /* 데스크톱처럼 카드 가장자리까지 채운다. 좌우 여백이나 아래 여백을 두면
         잘린 선과 카드 하단 선 사이가 떠 보인다. 카드에 overflow:hidden과
         radius가 있어 모서리는 그대로 둥글게 잘린다. */
      order: 1; position: static; width: 100%; height: auto;
      margin: 4px 0 0; padding: 0; box-sizing: border-box; display: block;
      /* 폭 상한 420px. 없으면 720px 카드에서 그림이 718x532까지 커져 카드가
         807px이 된다. 상한에 걸리면 카드보다 좁아지므로, 데스크톱처럼
         오른쪽 아래 모서리에 붙여 의도한 배치로 읽히게 한다.
         카드가 420px보다 좁으면(375px 등) 상한이 걸리지 않아 그대로 꽉 찬다. */
      max-width: 420px; align-self: flex-end;
      /* 데스크톱과 같은 부분만 보이게 자른다.
         데스크톱은 그림(592x600 등)을 열린 카드 높이 439px이 잘라내므로,
         상자 비율을 <그림 폭> / 439로 잡고 object-fit: cover로 세로만 자른다.
         object-position의 세로값은 데스크톱 top 오프셋을 비율로 옮긴 값이다
         (2번 65 / (591-439) = 42.8% · 3번 75 / (663-439) = 33.5%). */
      aspect-ratio: 592 / 439; object-fit: cover; object-position: 50% 0%;
    }
    .cmp-acc-item:nth-child(2) .cmp-acc-illust { aspect-ratio: 591 / 439; object-position: 50% 42.8%; }
    .cmp-acc-item:nth-child(3) .cmp-acc-illust { aspect-ratio: 621 / 439; object-position: 50% 33.5%; }
    .cmp-acc-item[data-open="false"] .cmp-acc-illust { display: none; }
  }
  .cmp-acc-head {
    position: relative; z-index: 1;
    width: 100%; display: block;
    padding: 30px; background: none; border: 0; cursor: pointer;
    text-align: left; font: inherit; color: inherit;
    transition: padding-bottom .34s cubic-bezier(.22,1,.36,1);
  }
  /* 펼쳤을 때 제목과 설명 사이를 카드와 같은 5px로 좁힌다. */
  .cmp-acc-item[data-open="true"] .cmp-acc-head { padding-bottom: 8px; }
  /* 랜딩 .industry-name과 같은 값. 행간은 그쪽이 선언 없이 body 1.6을
     물려받는데 여기는 .ind-section 문맥의 1.65가 와서 1px 어긋나 못 박는다. */
  /* 랜딩 #teams는 태그라인 12 / 제목 24 / 설명 15였는데 제목·설명을 각각
     x1.17, x1.2로 키웠다. 태그라인도 같은 비율로 14px에 맞춘다. */
  /* 자간 0.4px — 라벨로 읽히되 벌어지지 않는 자리. 메인 랜딩 태그라인
     (#platform .series-tagline)은 1.2px 이지만 거기는 글자가 12px 이라
     같은 값을 15px 인 여기에 주면 더 벌어 보인다. 다섯 값을 렌더해 골랐다. */
  .cmp-acc-tag { display: block; font-size: 15px; font-weight: 600; letter-spacing: 0.4px; color: var(--accent); margin-bottom: 8px; }
  /* text-wrap balance/pretty: <br>로 잡아 둔 줄이 좁은 폭에서 다시 감길 때
     마지막 줄에 단어 하나만 남는 것을 막는다. 영문에서 특히 눈에 띈다. */
  .cmp-acc-title { display: block; font-size: 26px; font-weight: 600; line-height: 1.3; color: var(--text); word-break: keep-all; text-wrap: balance; }
  /* 접힌 카드는 제목만 보이므로 한 줄로 이어 붙인다. 데이터의 <br> 앞에 공백이
     있어 br을 숨겨도 단어가 붙지 않는다. 펼치면 다시 두 줄이 된다. */
  .cmp-acc-title :global(br) { display: none; }
  /* 크기는 접힘·펼침이 같다. 누를 때 글자만 순간이동하듯 바뀌면
     카드 높이는 부드럽게 열리는데 제목만 튀어 어색하다. */
  .cmp-acc-item[data-open="true"] .cmp-acc-title :global(br) { display: block; }
  /* 높이 애니메이션 — grid-template-rows 0fr→1fr이면 내용 높이를 몰라도 부드럽게 열린다. */
  .cmp-acc-panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .34s cubic-bezier(.22,1,.36,1); }
  .cmp-acc-item[data-open="true"] .cmp-acc-panel { grid-template-rows: 1fr; }
  /* 소제목을 패널 아래쪽에 붙인다. min-height(299px)로 확보한 공간이 본문보다
     176px 커서 그대로 두면 왼쪽 아래가 뚫리는데, 오른쪽 일러스트는 그 아래까지
     내려온다. 하단 정렬하면 본문 마지막 줄이 일러스트 바닥선과 나란해진다. */
  /* 본문을 그림 위에 세운다. static이면 절대배치된 그림이 항상 위에 그려진다. */
  .cmp-acc-inner p { position: relative; z-index: 1; }
  .cmp-acc-inner { overflow: hidden; display: flex; flex-direction: column; justify-content: flex-end; }
  /* 펼친 카드 높이 440px. 일러스트(591px)를 다 담으면 카드가 592px로 커져
     바닥판 아래 빈 여백까지 떠안는다. 그 빈 부분만 잘리게 맞춘 값이다.
     440 = 머리 141 + 패널 299. min-height를 카드가 아니라 패널 안쪽에 걸어야
     grid-template-rows 0fr→1fr 전환이 그대로 살아 있다.
     일러스트가 없는 900px 미만에서는 걸지 않는다. */
  @media (min-width: 901px) {
    .cmp-acc-item[data-open="true"] .cmp-acc-inner { min-height: 299px; }
  }
  /* 펼친 카드가 접힌 카드와 확실히 구분되도록 아래 여백을 키운다. */
  /* 설명을 카드 아래쪽으로 내린다 — 위 여백을 크게 주고 아래는 머리쪽과 같은 30px.
     카드 전체 높이는 그대로 두면서 글만 아래로 밀리는 방식이다. */
  /* 설명을 제목 바로 아래로 올린다(머리쪽 padding-bottom 8 + 여기 12 = 20px).
     카드가 높아진 만큼 아래가 비는데, 그 자리를 일러스트가 온전히 차지한다. */
  .cmp-acc-inner p { margin: 0; padding: 12px 30px 30px; font-size: 16px; line-height: 1.7; color: var(--text-muted); text-wrap: pretty; word-break: keep-all;
    /* 일러스트가 카드 오른쪽 절반을 차지하므로 글 상자를 그 앞에서 끊는다.
       줄바꿈은 <br>로 고정이라 실제 줄 길이는 이 값보다 짧다. */
    max-width: 46%; }
  @media (max-width: 900px) {
    .cmp-acc-head { padding: 22px 20px; }
    .cmp-acc-item[data-open="true"] .cmp-acc-head { padding-bottom: 8px; }
    .cmp-acc-title { font-size: 21px; }
    .cmp-acc-inner p { padding: 48px 20px 22px; font-size: 16px; max-width: none; }
  }
  /* ⚠️ 위 .cmp-acc-inner p(max-width 46%)와 min-width:901 min-height 규칙보다
     반드시 뒤에 와야 한다. 특정도가 같아 순서로 결정된다 — 앞에 뒀을 때는
     980px에서 그림만 내려가고 글은 46%로 묶여 오른쪽이 통째로 비었다. */
  @media (max-width: 980px) {
    /* 그림이 본문 아래로 내려갔으므로 글이 카드 폭을 다 쓰게 푼다. */
    .cmp-acc-inner p { max-width: none; }
    /* 그림 자리를 비워 두던 min-height도 함께 푼다. */
    .cmp-acc-item[data-open="true"] .cmp-acc-inner { min-height: 0; }
  }
  @media (max-width: 900px) { .cmp-page .ind-head p { font-size: 16px; } }

  /* ───────── 무대(stage) — 가운데 그래픽 + 좌 · 우로 떠오르는 글 ─────────
     세 칸 격자다. 가운데 칸에 그래픽이 붙어 있고(sticky), 글은 양쪽 칸에
     한 줄씩 번갈아 놓인다. 줄마다 높이를 크게 줘서 스크롤하는 동안 하나씩
     화면에 들어온다.
     ⚠️ 그래픽은 아직 회색 판이다. 이미지를 받으면 .cmp-stage-art 안을 바꾼다. */
  .cmp-stage { padding: 60px 0 130px; }
  .cmp-stage-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) min(40vw, 520px) minmax(0, 1fr);
    column-gap: 64px;
    align-items: center;
  }
  .cmp-stage-art {
    grid-column: 2; grid-row: 1 / -1;
    position: sticky; top: calc(50vh - min(20vw, 260px));
    aspect-ratio: 1 / 1;
    display: flex; align-items: center; justify-content: center;
    background: var(--bg-soft); border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text-dim, #9AA3AE); font-size: 15px; letter-spacing: -0.2px;
  }
  /* 글 한 줄 — 높이를 화면의 절반쯤으로 줘 스크롤하는 동안 하나씩 들어온다. */
  .cmp-stage-item {
    min-height: 56vh;
    display: flex; flex-direction: column; justify-content: center;
    /* 등장 — 사이트 공통값(16px · .55s · 같은 베지어)과 같은 결이되, 좌우에서
       들어오므로 가로로도 움직인다. */
    opacity: 0;
    transition: opacity .6s cubic-bezier(.2,.7,.2,1), transform .6s cubic-bezier(.2,.7,.2,1);
  }
  .cmp-stage-l { grid-column: 1; align-items: flex-start; text-align: left; transform: translate(-24px, 16px); }
  .cmp-stage-r { grid-column: 3; align-items: flex-start; text-align: left; transform: translate(24px, 16px); }
  .cmp-stage-item.is-in { opacity: 1; transform: none; }
  /* 줄 번호는 마크업이 들고 있다 — 좌우가 같은 줄에 겹치지 않게 한 줄씩 내려간다. */
  .cmp-stage-item[data-row="1"] { grid-row: 1; }
  .cmp-stage-item[data-row="2"] { grid-row: 2; }
  .cmp-stage-item[data-row="3"] { grid-row: 3; }
  .cmp-stage-item[data-row="4"] { grid-row: 4; }
  .cmp-stage-item[data-row="5"] { grid-row: 5; }

  .cmp-page .cmp-stage .cmp-story-tag {
    font-size: 18px; font-weight: 600; line-height: 1.65;
    letter-spacing: -0.2px; color: #76a6d7; margin: 0 0 14px;
  }
  .cmp-stage h2 {
    margin: 0; color: var(--text);
    font-size: clamp(28px, 4vw, 45px); font-weight: 600;
    letter-spacing: -0.8px; line-height: 1.3;
    word-break: keep-all; text-wrap: balance;
  }
  .cmp-stage .cmp-story-lede {
    margin: 20px 0 0; font-size: 18px; line-height: 1.7;
    color: var(--text-muted); word-break: keep-all;
  }
  .cmp-stage .cmp-story-sig {
    margin: 0; font-size: 18px; line-height: 1.7;
    color: var(--text-muted); word-break: keep-all;
  }
  @media (max-width: 900px) {
    .cmp-stage .cmp-story-lede, .cmp-stage .cmp-story-sig { font-size: 16px; }
  }
  /* 좁은 폭에서는 세 칸을 풀고 그래픽을 맨 위에 한 번만 둔다 — 붙여 두면
     화면 절반을 그래픽이 차지해 글이 들어올 자리가 없다. */
  @media (max-width: 980px) {
    .cmp-stage-grid { grid-template-columns: minmax(0, 1fr); row-gap: 40px; }
    .cmp-stage-art {
      grid-column: 1; grid-row: 1; position: static; top: auto;
      aspect-ratio: 16 / 10;
    }
    .cmp-stage-item { min-height: 0; }
    .cmp-stage-l, .cmp-stage-r { grid-column: 1; transform: translateY(16px); }
    .cmp-stage-item[data-row="1"] { grid-row: 2; }
    .cmp-stage-item[data-row="2"] { grid-row: 3; }
    .cmp-stage-item[data-row="3"] { grid-row: 4; }
    .cmp-stage-item[data-row="4"] { grid-row: 5; }
    .cmp-stage-item[data-row="5"] { grid-row: 6; }
  }

  /* 수치 — 무대 안에서 쓴다. */
